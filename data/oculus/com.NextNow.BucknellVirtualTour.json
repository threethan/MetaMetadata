599", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYnDuJd8RTYQ7kNvwGL-XVb&_nc_oc=Adp3l8ACmzE1x16ADYuxVQzr5gBZHQPp_y2dcu6MXqDmLUyJZyGocMkpaD9Ca9z4ZWQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIqM9TepCHUojlFW0uQDaZgb5WFpQ9mWOusetdE92zug&oe=6AA16A7E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZgFIKuw1IYQ7kNvwFHhBVl&_nc_oc=AdpKMZcJmaPSpbi3y9h8rjb2fXNbEpB5HHh2uO7ts7inn95pNwzy9Je7ppfFabXI9EA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6KzgL6tZ4FGkw8MbmPiP414SiJApDZt7btLKWV-PX4A&oe=6AA17AA3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKrG08qMxsYQ7kNvwHAdaW4&_nc_oc=Adr-5rthz5Hw6Z93C8IUXNOWqAw9fBqSO79jpGMwpWFxq43Acq6YRSNB3wYVxQLvzz4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsAXMHzZf8YvoMGPzTVNBPyba9VzVqGrUw0kxiqAS-iw&oe=6AA15C19"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuusqPKwyMoQ7kNvwEYMVdt&_nc_oc=AdpfJAkYTodMoZ2lRYPhdtY7G2uV_Ba79QperAmLqqV8s9AJPh20iQhqRbr356Jb33I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7LPkJnHNtKE5t8CCbPBdZwWznRGrW4pG-vuSBVTqm5Q&oe=6AA16B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9b2kfBdD_wQ7kNvwE4nqMM&_nc_oc=AdoBrK033BPEUi1YOKI-fYQfahL5LGb_2yFQ_jPxiisDjT_2oFps3hu1ZSJ4aHAbYic&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqEbiRPflJ4QVLzOztjfXDvfkTMoNHHq5JYfoRlsKeUw&oe=6AA15983"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
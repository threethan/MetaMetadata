38599", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeR_AqNEB1cQ7kNvwF21joU&_nc_oc=AdoacZVWryNW85DX-0RvaaGLP_6hPz2XsqaEqY8xy-PJBvAhoR7rqCh7DfkF7sCnhJM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TsPszJZIvEgFsZk1GsjVdXpdGomwvUy99KdUT_3TPiA&oe=6A4672FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eltj3_BQSDkQ7kNvwGkKnmc&_nc_oc=AdqSpoar_gYWT2K7shMFF362daW9ID05KForVP4KUw13ZOJUq7tzVYcRh-cYycYQdpw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lPS8SHfp_yXvxQP8lI1H4g3-dO5YKOlGpfqwANJxuoA&oe=6A468323"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_f_bMpmM2QQ7kNvwGHT4Tu&_nc_oc=AdoPRwCGzsHj4h0NbXgBLC1_YZS8pj4UobKLnhwA8nD20nGB0D_h7JCN37T5wRGMxhI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KGRyhXV2dX9gOMtjeJ2M8mKAn2JEUikYLY7fU5tQ0aA&oe=6A466499"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FRQ8Qythq8Q7kNvwHsT4YO&_nc_oc=AdrJmcICQU1i4_CiHUkrJWRCND6uEAz0get-4fpdQXtAJe2Jg8y6W2op5ac1WYJUfcc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nGN9uDZz-KSU34ChRY4gC5xG6YwvzEgd0eIsKlwauYw&oe=6A467396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YZwr5y3arkQ7kNvwFak_QR&_nc_oc=Adp3hQ1I0v5lYoFZYnCxjs3PDTmaoF5o3Wq8q2wHVvPl5zRam6u4ti8huCwWkwRsnDI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ax3t1zhGfwKCD9oyAAbUhb7rfOPz9eBc3TzeZEo3nmA&oe=6A466203"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": nu
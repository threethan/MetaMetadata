.com&oh=00_Afsz--2mcUErvODD7_RARFZ0eJ7g9ZDoM3_h3erLqvKYMg&oe=69A42263"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5BiE_UAJ-wQ7kNvwFs_3Qd&_nc_oc=AdlClIjezQw5DfbMsDMKxhjQdnH4uBZRmsvqslzyDTOz6swfFfun63Wy-sFAmEVq6aE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZ7mLS7ZO37uP2p42NFVsMV3qjy5Jys2WLdBOPb_JbAg&oe=69A43C19"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwmO9lTReG0Q7kNvwGO6G_C&_nc_oc=AdlOMW4ZGDksCLHWcbCbm4oKMIb_xWMmDOq2vX7Znu0ooLv1hU-45HR-qMSZivgqlKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftmZOj_PLsdPaU6wpmenAAJNlWZy1lwTA31826IMtv0Cg&oe=69A44B16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I8CXwOSQd8Q7kNvwH4jKiV&_nc_oc=AdkZ1pVEfkJY8sFAYoUmWY6WcjHlsWUnto2ir1HRduVqL40lh3HwqvaIi1tVxpIm88o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZaLonGJEqBsWxKLbxQg65RVHhIS_Pl53HY6MblZl6Gg&oe=69A43983"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1863500963859531"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5098054270245883", "version": "0.9"}, "id": "500079124689821", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
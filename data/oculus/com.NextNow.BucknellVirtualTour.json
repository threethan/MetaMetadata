685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B1fIPSX9OIQ7kNvwHHd6Sr&_nc_oc=Adl8beTCdGrowkNNZfY6FLL6M-XHkg4hUXd6b78rOcxSY0HuINf3qvL2MeZJFhNK7O8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftInb8ZrTVnMR2dQlzc7NNkJpNaHyWPWa2clv0_9A61Kg&oe=699B0FFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOpStMxWryYQ7kNvwHnTncT&_nc_oc=Adn6CsaAHcBxRpJ-Bh9hLyV2Jy9ndG9RM892iGHtxg6k-MnFmf2KOLSzKBd7Ygj7g8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftfraUNl0xVc51oL6ZgrMYsK5VpFyIKIFq2mYU6za6MDw&oe=699AE7E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzuWUfue50oQ7kNvwE3ZnwY&_nc_oc=AdkPomcav1GSih3MfP-O8AGXDnUk5N5_PBy2Vc9iaJDtGRsXJmg8ccFNTh_6V_4sSrQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftMu8FPufjIFFgp0ktPXkkb65SaA4YdEzrotXCIJQrzQQ&oe=699B0199"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or1ozzsWfAUQ7kNvwEiXqYw&_nc_oc=AdkU5NrZGgfqwLkebcrFQkO16yYuU1WUztnb6E2gzg5uH-Fjb3TolJ30ytNaSq_QthQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsfhjXoqx5TSIut-P9AG6tMCwurMUHZwgK_TzGb5Gn_ig&oe=699B1096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eGG85fS7CAQ7kNvwFZHiUm&_nc_oc=AdlLBDx3jmiuUMlE5jt9RhY6s7bR1ekJlj2HAI06IgjDLH-By-YyW3gaMQEqAV_Oimw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv8o99F0g3u8ztXBla0K6dP_tMDkvZG6n545sX5HUvM1g&oe=699AFF03"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "
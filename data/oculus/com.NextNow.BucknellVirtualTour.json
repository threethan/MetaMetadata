599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j-eBPwGzqwQ7kNvwHp3oJj&_nc_oc=Adr9bic7HXPL5Hb7hpf4BpLf3EE292ZBwd2vrnyQbGQyb7epwklfu9jG70VOXcBzLJI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i6AQQl43rVN5EQCL27ikQDrrISjUPQDkKfnQj8QGmeg&oe=69EF6FFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tooYeTkkBNwQ7kNvwFHJ6Ug&_nc_oc=Adr38pJsDXSVffrVn6czNHAKBu-36_p30lybZ-INaB_Vt-tSyMq3z4oLNyvmlTfK2Pk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XLEQLCGeGP30oUKzqW_jITO0tRhow4rzg5mxb_WfNNg&oe=69EF47E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC3aFpgUjuUQ7kNvwFxvLx6&_nc_oc=Adozp9ZztlxqQRWoXOeuRAJPcE_5tSPH4i_FnjiR3j3e2rTquVJdUNNq3LlrRzVXNSA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3BSrt8nI8DtK884q35C8jG-V8DX6DsmBkgx6WlU_ETig&oe=69EF6199"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3zr3qIbRNQQ7kNvwGM4UZd&_nc_oc=AdpbVEOW3tmi0o8Yd184msrYQ9Lk0MoT-BH6Y2blMtJ5lLjYniVJ0Oid6_sSiqrysuI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0shbmMm-N9GZFYe3mPhU4moKz-8tAvzvilMQT6xnL_kQ&oe=69EF7096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mA_DJIRscQQ7kNvwF31jkO&_nc_oc=AdoIUw838xal9rPRzb-7Z8bd9hFRy2nKB4KqKSaPwy7HwL3yiUUYuyYYxaWeqKHOdf0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Li-1fEiPblJnNDy82Os4Kr5VeaAeo9m29gY5KLfKp3A&oe=69EF5F03"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
ad3-2.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcL0FDLPN14Q7kNvwE4-hhe&_nc_oc=AdkhnYsgEnCGv2RmRN4HmGM5wVLjNDLR8xs4CuSwMmq6jtyC6-1NVEoDmEkrpunnQnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_v3hvVfvcQBaF3qVkNZDKRdkIgQkBSRV0lkEQ0i0Y4w&oe=69BFF9FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-pjdvAZXbsQ7kNvwFdSy3U&_nc_oc=AdmuV8Oh0ARJnGbzXgo1AnxEhAmHESMeQZSa8jFGevaQqLCC9c4MLELPF9WTCcOcIko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxuhIGDwgF6K-FEB7McEPDf41vCQDJ2EDjgjMXWia42sA&oe=69BFD1E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCKY7Xp1Fu4Q7kNvwG_AuLd&_nc_oc=Admdl5mewsi-YkE1KecGQYUq7QSxsJiotpm5_oL-DsLf-bLSvbE6BVXaTQseSb9A09k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysQ42fDZTi2X9okQIA_oStCJ0NXm9XFYc7M7ztzp3YKQ&oe=69BFEB99"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R58zy-pMFuIQ7kNvwFintSV&_nc_oc=AdkUmxtJW3Y7ygH4mZgiaKL4Vb4xBbqZP-Hkz7Dl0QyZ_1YIelqG9K_s4zy7EmxZwqw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8yCLTjhXSO666zQTCkdyrOiT94APHFGMpO2eT-MeN0Q&oe=69BFFA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwhADIyq_f8Q7kNvwHriDnI&_nc_oc=AdlFjpQlE3f_C0kxnq6OQw94KZbMUi3mUpbNg8KAPyYQn9lx-6Z9a50XsjFSamPU0II&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2WZU5MvEQf457IIgayDYnruy7VaopnDdMq8Fey2jH1A&oe=69BFE903"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
599", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7J0ABYacTYQ7kNvwEiHjOR&_nc_oc=AdoOW4MEcrEyCwDheKFnqU3wsqm9OwV3OaP0gLYy2NYNv_Ris_3YOPGo_HPj2njaJBc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm5ge2KtWthRlJ2a8wUbULjLtJlk4UDO8022EfE4zccg&oe=6A81C67E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_4VsZWCFEkQ7kNvwGAf0jj&_nc_oc=AdpOJgpyGsR-bCSx-T7T_XL7CqnfQYZspplPZo5tDue7G0BPQx3HmEqWc8u4KfrNgwc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMqdWDvpg6M2yi1oz4TA52Cf3HyhlzEwNEfAIjR7u24w&oe=6A819E63"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bj2gelIK-0UQ7kNvwELaH-C&_nc_oc=AdrdG9aJc_zD9Q2R_gMUKkbVQy7T0fhYM07k6qBlhFhb_CrFAJILIA2Fp2kMfDrNBSc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF89NnPQ5bNvGolKhWJalyNqdNPKWrLYCNNwxi9_G_sA&oe=6A81B819"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNNQJNM6eL8Q7kNvwE5jABg&_nc_oc=AdoEF3wzrwIKdcVcCKW6vmM3SEgUbvShwR-Uy2JyJE6tZLAhwDOqXjQNwFjBDMQNSA8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1UoDJm5MyPi27_HqPPGo0zO_FC_W3GOgKESBvI3lBSw&oe=6A818ED6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji9e5pf397cQ7kNvwHOzkRQ&_nc_oc=AdrPDZr3CiK5CCHCceGlK9n1P3iLp4b5Pyu34uq_0yUg9FmfW_34ixupH4Cyfma7GhE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6Tw_4dNGeppphOFsh2F2uVD_Qg-lBAVUHhU_qaDimJw&oe=6A81B583"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
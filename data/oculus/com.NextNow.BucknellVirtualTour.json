.com&oh=00_AfuhyCxFBuM2-prVV4x5HnUabvwnP1eDTQC768Ka-w8HjQ&oe=69A2D0E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXbUeE_WyHMQ7kNvwG3IlYh&_nc_oc=AdlSrTr_xNc3jk5ALcmr9xE8gjd1d6hzjT4zKQQ09Gd0zteAYnfofsHfjC98d2-2wr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu79qBcaSMYGgcHaMGozGn1zFOkAUP-unpGivOb6dTNXg&oe=69A2EA99"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5iC4wFbRAYQ7kNvwFfdHRq&_nc_oc=AdloROnUhi-2UQ-FmXbmTGEXWaUYf90KRwwi0U_XD77uV-Qvvg8kexlUUyY1QTxMZak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsI_kx1fsPa8FfnOOzO2yGCr7JdCfPbYLgWgrX-KBVRoA&oe=69A2F996"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I8CXwOSQd8Q7kNvwGEg1hl&_nc_oc=Adl01WeTgrZyDDRvegZ8OeJTcg7mvxfGWDVdUohZU6i4wHgq4lvH41GVuTiKHNgXzXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthnxC8zbKpZJdbI9CaHGwZYhQjejMQI3UkrJNMs6puwg&oe=69A2E803"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1863500963859531"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5098054270245883", "version": "0.9"}, "id": "500079124689821", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
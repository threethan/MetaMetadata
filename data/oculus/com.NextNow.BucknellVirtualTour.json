599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-VynxkkkL4Q7kNvwG2yAiG&_nc_oc=AdrQ0rMU_aaXnsP0CYx5OcfQHexiF5Shm7_Xy4-zSfyA_rJ0ydQottlxI-Jc4lsE6js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJb8PFJYs1I6qzLUH0Wc-eMy7CaOD49WhQ8mUUUe_16g&oe=6AB7D3FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1fZi4uOKKMQ7kNvwFCCBb9&_nc_oc=Adr4CIh0OXniR22-gvec472ARDi5v7P4kzPANsceR-l1H23mByCb4knkR7z48FwmOSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN1nHvmIkTRNJTf3RwuQfnLwIraqDY4onz5FbxpL8tuw&oe=6AB7E423"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V-OehKBBpQQ7kNvwF3lzhV&_nc_oc=AdoxgEwwv_p_A6hJIRjZcdmfh1jhapBjFcvrEe0Ve30XIlWIxW45tOr5B7qeOUMEI10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKcPUim-3i6WurDcrMO4_jL_Nd4XK7YXcJiaJVQq3SjA&oe=6AB7C599"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lXNTBpi24EQ7kNvwETWWNC&_nc_oc=Adqa2Ui7skCE4RmcjScrkNtOZqAdpVDtYRxAemcumTevAl9bbWUVrap3FP4E9XoyvcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwZOFhDNvcLZpoVmvaIVMtQNLXl2wtwIKO6k-LtZFY9w&oe=6AB7D496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD1cr7gUn5YQ7kNvwHORJJk&_nc_oc=AdoWheQZg6t75lnoEtFrNvyrsC-8dMdVZ3tTs_k7O3sEAWPk2nJGieiLrhXDLNmS5CI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvUn-77ZDPqEqdftWA2LUUkZISJDWv6lYKZOijJ_ChUQ&oe=6AB7C303"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
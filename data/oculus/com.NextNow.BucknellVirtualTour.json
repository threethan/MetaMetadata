599", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVqM49H2WqkQ7kNvwH6aoXX&_nc_oc=Adrz8fnfB0oIQSMtTddhcnX2F1nbQkPzGbfuokKCxubtxk01l9H5D68W0IM3axo9XTA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpkJ8m60s-JcoyDvAo5M_QWzni_RvLWIR9RayCY3B77Q&oe=6AC7A5FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6oj8Rb8x3oQ7kNvwGvVKt7&_nc_oc=AdoYyu6wwUmkWu56OO11_XC4S0tRaSUJrh7-OgBkPUmNLzqE3kgUrUt-7evy31__1Vk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOVsmaHPE9wiD7k3wDNbCG42WVpSxmO21TPmCIh6gHJg&oe=6AC7B623"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dfskGJhTeEQ7kNvwE4ogCF&_nc_oc=AdqnSlFiG8iiPtHi0WeQln8HbandVQ7MRsx0iGizRZkYgntT8vkom9ijlyPZkbxGMQE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy8o9ft2jNpCkjfXT8XfvLWCzZmHtWF_ArCKDSXexNcA&oe=6AC79799"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOy_kyX7CVQQ7kNvwGe4RsO&_nc_oc=AdqcYGp91Hnq70vYK86bA_Mn2p7d1SGHYx5M99nLh71gwRGLCYQxcpH0qukvbOxBP3I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP00epIdgtHaLEMVmtwna4CKizGTkMGhBicZqBuT_hEqQ&oe=6AC7A696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qECFZ96nEAQ7kNvwGgCkeX&_nc_oc=Adqz6GD6Una_3f35BC-yv1lKCTQLvdbnws-bScxtP-7pz9Kjf4xfY4dMQNXW06aic1A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcOEks3aj1l8Yps4sFeJKpg3Tso4wHuthb5SVQWP6iHQ&oe=6AC7CD43"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
599", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiaSlik9yJkQ7kNvwEtBimA&_nc_oc=AdpUAGD708buvwRu5-rW6xCcpUhz1SZrZODOOmbUx3vu_pw45TgZTv6vUd4MnTuMYO8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1noVRicd6ddqSXDX0aPiJwdEjFJ42I6_7P8HQNam-OAQ&oe=69F6077E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jNnhnaqnAQQ7kNvwFOdHzi&_nc_oc=AdqfivcD8qsAoJfJMGb6qCMQH6fbZN5Jy03eigyVXx2TyY6ZNySnm3E9RimycN08Y2s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0boNPe2xXpE3_l17slxVmcqUJ--3Bp3EYac85IPQ1d6Q&oe=69F617A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2198Zwyy84Q7kNvwHdi5m0&_nc_oc=AdrJV3rfcnh6ALaAeJF8zV62DDEWD_q8LmLPqCfRrbdk_28FNmjECRwv5C0BXJFFqxU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0huHgoO5FMfj5X652d_7avSE4jyAbmmjn5DjYD7gJGIQ&oe=69F5F919"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJsA5cPvYLUQ7kNvwG6mMCx&_nc_oc=Adp4ivDy68HtB5oHHvGYM_aN8ZJqllJBbeTxaY7a9XljDoUDLDN4xAaQIXx4KExgD18&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hYgUlA8FI9UsC2wJmJfmWgaXTATAfBqJd-HWbMEkp1g&oe=69F60816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y52XK6Rmx2oQ7kNvwHyhIM6&_nc_oc=AdrR0s9WwTUg2ftRC84n64aVFZly7lHBTIaF_79OyAaYslhjrSRN4Xtw3FLWZNTZbVI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02P-c0B9Erke3my6Ti0z50OKLlAmu2jLWLO0Dh67GlgA&oe=69F5F683"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
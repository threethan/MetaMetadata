599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLhX8_vOX6QQ7kNvwESA7Jy&_nc_oc=AdoUdgWsN2uPiCR3_mz3qx3v33BeWk1UvGEa6uO41DgQw-Uwuw8OeIx0yFFBoRvTwcc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo7ocwUvo1EaBihUe3KOPCQfKAv__d2yrhpjMsNOzKCw&oe=6AF3277E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnytsRTU0Y4Q7kNvwHjLcGs&_nc_oc=Adp-v7XVfIxykzyuCfb4gz4f4mKKR_yr3Fcqm2yUGW84A3u3FVm2XngfvmG80wbg_Jw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR51PY0wxDdz-nkDu4_1rl5VualUYuSTb7eZB2YcHavrw&oe=6AF337A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svXML_U-M0AQ7kNvwFr8Bf5&_nc_oc=AdoEDnogsGaR81KrsxKHCZ9RuI7Fibcy5Zi0MfTezqaBXrcUoDYfua4aS3nTbMZkOAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKzoYVvmLCeZo7FHR1-nyD6YClMLuLRyIjHo_JUFm_ng&oe=6AF35159"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otu5W0gAMKIQ7kNvwHCafeJ&_nc_oc=AdoFVKL0ea_qNwykaJaEZWZVQbCbUPEbg2W21XpcEEwmdkzp9TzZwQdipGUnNxC2cQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxfDLt_KchkgcjfCJrl00eOotZZFYo_bK1Xu1QzWzxmg&oe=6AF32816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zucV2CinhkQ7kNvwG9axqx&_nc_oc=AdoJTSmOWuFNHZuw5_xDEl9-OiPxNdz27y7Oa1D3YYzaN9FRoW80l_yREt7c39IbOvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu-mvDEANdwwYUJgq6Z6Oxrv9b6JdpbXA8W88XSBMN7A&oe=6AF34EC3"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
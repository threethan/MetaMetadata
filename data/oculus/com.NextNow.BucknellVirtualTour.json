fw6-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcL0FDLPN14Q7kNvwEi3Vxi&_nc_oc=AdlyCVyqhyN6B8VHjaLI_5niDrv4Ai42ltuZN0IGFwdiDVtN4nKr1Aa66DuDPTuM-oI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvrWZzYQ0srn2gB2nlvE8GirOyREttT1byBM0CrN1d7g&oe=69BD56FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-pjdvAZXbsQ7kNvwGpDeCZ&_nc_oc=AdknwCuGh8PIfS614u18unaYY49BZJTmlJ-rXXjUVnsfBKJmYhIgENT9ooRU8lOQAKU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwKpfbWLM9j9SX1lGjimopuJmSiCjBLY1hHlxdQAzDZzw&oe=69BD2EE3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lGunFgTvCMQ7kNvwG9r2-R&_nc_oc=AdlTn-Cx6xU5vsr5CZkSO8ft5I__nHmtXc8pUTLC2iNGYaIDuNUQ-alr3f_QFouJT7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzI2MNgztqllLnXN_7e9jchWZ7E-H5saTNyHoquroBVXQ&oe=69BD4899"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0qkPx7IsrcQ7kNvwEc7SFD&_nc_oc=AdmHGw_T-GxlcUL6DfgL53W8yn6UwiRJ-RK9xvA0VWnGCa-Jn6yJy46re2XJaUv5yzI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5d-NjvxS5sacAFrdhiZMnWEEYbwCtO0Tg1d99zL416Q&oe=69BD5796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WECOnk4lt-EQ7kNvwFqKy1f&_nc_oc=AdnISb9xNfDm_4EkS_UYD0eEy74chs968ks3XlZTIl2RKhvcoO7SLoTY-OBS_3ADJSo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhhJrFsFzbV-w7V3qhxDLtNmkQ5yBDRH1FtbtcjCPl3g&oe=69BD4603"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
jc3-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcL0FDLPN14Q7kNvwHjeXxJ&_nc_oc=AdltosL0YWFX2dUi_O5PWNaRg1gLTLCsX7nQd78Href4KqXsIc4xda5PeCjCQKltYkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS7CZoxRRqj8AzuNUa0EBTpC01jYCfBuLlUK3d2KEXIQ&oe=69BEA87E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-pjdvAZXbsQ7kNvwFJP9mu&_nc_oc=AdlWaVtpUyrCIHzMRWy_4sEuokJf7dQh6Vx3lcaWUuATv0TXC64UkJH3R3aE1A8PmbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFWrtyNAIfHVyPTVY_ZNHEf2_nXceZMbtZUYeMRULB9A&oe=69BE8063"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lGunFgTvCMQ7kNvwFOS8x5&_nc_oc=AdnG5gVMOhj4vJblUEu3Z8uOPWdvJwP4_6-BJlXooevuF59Ek95llwWm7E_KjYWC0YQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhqRjLdA9waoKnZOvMm9C-p0uNwXAf2sT7dafiUExRlQ&oe=69BE9A19"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0qkPx7IsrcQ7kNvwHiBwjc&_nc_oc=AdmgrurhOXDXiKN9Tg20w0xteDTfgGuFM5kutahsCoYf6OYWzNiza01-UFxaIw2LIiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDFduX-o4KjF3JcDdLeuyqyaxOXoj03KDrmjI-mhMrJw&oe=69BEA916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwhADIyq_f8Q7kNvwE27YZk&_nc_oc=AdnbsmCYUGUEZJJYG6OoU48RoQL7iifl0p_4i1JXW0-adcJhxkzd3S3P6LxWRK9Dftg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyca2NL34czE0jOforfXAoksy63wUYKyxlPtfW29WGG0Q&oe=69BE9783"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
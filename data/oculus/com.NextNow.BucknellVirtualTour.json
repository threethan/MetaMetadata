599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVqM49H2WqkQ7kNvwEggedX&_nc_oc=AdrsYIWqTV3StXAGEfsycqC9RGGE9lzPYgSlPrVfwUn4atBG-NIDXLidbaAIJloXXOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFFWv2d-zoqZE708TxnGcpvVzRde1PRHtNVD7TRfo2ZQ&oe=6AC6547E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6oj8Rb8x3oQ7kNvwEle4FL&_nc_oc=Ado70eeaVotkJI3DWB60_6r36_SZTw9Ld8-1aTUjTAabmpQ08_mcn-u6YO9XfHyOi_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyVP0L1zU5tEPBeQYXQ4iZpKbncCukHfCYz8sSUtozbA&oe=6AC664A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVW-WKVGcLoQ7kNvwEduu3m&_nc_oc=AdpOskdIuWVVH2m9kMJfTaN5RtH95-wOeimVwfFnF4d4UPa8gm5ywJT1uVGb5J7nDio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmGggHdM283Qy0FAiSNJ-cztR5tl8oEFa-rmMP95CK-A&oe=6AC64619"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOy_kyX7CVQQ7kNvwGNzoID&_nc_oc=AdoNm6dNVhjqn2YNwVosUn88G90kTPvK8Fl2RTeTHUf4gS-300mMmWMtZQQGfjYkYu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM3A9lpNPlB6TklGCNdqeSQ6J2LPlDvC1XhgT7u4q7NA&oe=6AC65516"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI_7oo9ZO5cQ7kNvwH_Vxwc&_nc_oc=Adoa3ybn_CtECD0HeC8E44WEV1Frelahp_WWWJN_m-2kyzzRaCCyopE6londIder9-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJGZTvNrHWdRBxOyDyUI816_lDeHORsNh-3XL6I-6sSQ&oe=6AC64383"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
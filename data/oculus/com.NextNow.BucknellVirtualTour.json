599", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98zgUsnvUV0Q7kNvwFLlGVn&_nc_oc=AdpXetQy0mSaxKCyNQZxZZtHbyc4zsxbX7oDctX1uWdbh4jvSdxFGay7jeydBDrVTGk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pr0VDoFbdGQZcx23dbfAH1-2kXofAhewHXVZnjN4d0A&oe=6A30097E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2AUAYLB7MsQ7kNvwENIdGl&_nc_oc=AdoljK9Jx0SxezCaQFznPAtcfXSh7c7JndxAWuHCn5QCGHDVwq2UNJPebUQZnZSG7_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WmbzF8G9TDW0bQtdrXYwyOOwjY8Iv7LiKXJs2REx8Yw&oe=6A3019A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_St3r-ent1cQ7kNvwEKQp7e&_nc_oc=AdoKzhqHjjqyZlVr4co0afNQbLyS9AGVmjRqmYB8CkAj6OYvyMSIyrjws6yR7_gm5I0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rfW2AwadsR5E_YvJ_bibSKf2OHadxNGnm7T41hyw1XQ&oe=6A2FFB19"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYlj6CN-fLUQ7kNvwE8uJr_&_nc_oc=Adq0LOqhiUEoZvc-5Xod-pnTL0c28k9e6xSMql1-RBiLylMNs8ELsk0f8BhtlYLsnqM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TvF3PE8CI66KfrVJ6fLmn0fkj-B3Algv98Br2mW8S5A&oe=6A300A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnOEivaR_XQQ7kNvwHnZq4u&_nc_oc=AdqbOwL2s3_D91_TCN_vZpeogpt6tAMuQCYk1Qojv5PVbEsBysEVbcis2jP_a_17cSg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cw_a_z7BIiXH6S8UhCbKZjgzXJQQQz6b4eCta7RyC8A&oe=6A2FF883"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
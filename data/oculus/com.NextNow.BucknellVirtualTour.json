599", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrGsRouSr_IQ7kNvwFJ3fpk&_nc_oc=AdpT2w31WqdRmcdbl0MTtlEWmFuTK62Qz-yzqwyJRZX8OTpvWZXBxwronv-jR37RNlo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fc4lPkbK_nO0jCBMeggXpjzCBdWT_jKmPtasShbJHOA&oe=69E240FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lo63hlOWLAQ7kNvwH8msBX&_nc_oc=AdpmbrNPvNhK7xconlx9RNV8aRxBevY5-Am8HbramHeH6BBdThIixJxeflqArn3ABoo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ETsiO9nbR2SFwnX3lxuVC_dCzi6X5oL-pY13JZ_Yh2Q&oe=69E25123"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM5PjkowcqwQ7kNvwFFzZQd&_nc_oc=AdoxNii2dfQSCJQ_weBEJR4gdYuEWhuPGQ-h4860ZAX54UqjeaR1dzl0Fk6r5rngl9o&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E-_4twS-N7g-jTJL7SJ3uNzspQ9Beeevrp1XIqAJ4oQ&oe=69E23299"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJCsZwvzZZIQ7kNvwGfdQ7b&_nc_oc=AdrZOKH5u64-RJPwpOyBdUZf5CdkGDC81_2LyeS7oIjAVJi1VOmzTlDDbu8h3uWva4M&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tvzhANhBj8pB2Ri3WC399MhdtvTVmRDIdgRHkMFKUUg&oe=69E24196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUA1_3kvI58Q7kNvwFUgz5k&_nc_oc=AdqRSoEq_JjVaQWKw3trjtLmpLyvXOrNiJ7CkJHFuFYBlEhyvG57uxnrfbOqdKUczPE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bjg7Qtgadhn1CxowxQCc7-RySjKyA4b6q5KdU7zho5A&oe=69E23003"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
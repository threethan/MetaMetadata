599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l37whK5UrJAQ7kNvwGxGQP-&_nc_oc=AdqJT3XOXMJ-duQ_uxZc6mH8xDTKNWtZV2yy5MJz4a0iNKLPYWjjLk890kKIuSW8s8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rrk5EkB6Wo0IGridzECuGKrdMXon1mLJ8SwF4t9eYVg&oe=69D6637E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcT5dxMc8cMQ7kNvwERh3Kc&_nc_oc=AdpYgg9aYdeG4kyu2eoFR8pt0CawqTLs5991XqiZ9kT_MD6lHoFeFNJVG8yl3nwzNp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vMcQI69FjvkLsnvrAIhNRcUFul_-Qaffdruaf_NyBmA&oe=69D63B63"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHBJie3mGcoQ7kNvwEpr3PY&_nc_oc=AdqWfsRhtJrRextMAL6NlKB-PjFSCQCySESadXjRLX2AVEsr9cA5f7eQ6cXPn1SWylk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NTsJyWimdocl-cajYPchnFYs5xZV1S0sZKpr0H6liiA&oe=69D65519"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUBvwiJ7_0cQ7kNvwFzPcPX&_nc_oc=AdrPEZJ8CFXJJY_DChMvLWgzFrCN5AsQOs4Cu0QogfAPxlRGrp1mT6qzTChuFwUKQQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F7p8nrkDHle7DCX1aF8d4I6rfKW61ZXtfff_q6wa96Q&oe=69D66416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIfrly-iwyQQ7kNvwF12HfY&_nc_oc=AdptLOJgyTkAgbCaZHE4UGHkFvCjRwS741XhZBELH7kCgh1JVelWAir0Umt4A_bR1wE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c85RvSQ2inaauCZ196dq6XI8Bg5s7tCNFBEvz4X3ddQ&oe=69D65283"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
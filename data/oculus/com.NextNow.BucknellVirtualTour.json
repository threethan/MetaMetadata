599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=werORxUHfQMQ7kNvwG0hc9U&_nc_oc=Adq5Hby-8-LRLbPkTVl94l2biJoJx8cQ0-HooPoSy0boPEUPyzzb3_tLYsly4M6KoNw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfyzrUBICY2awmy2ezUaSysAqLFslf6PmNJJNoRTbYtA&oe=6A68B9FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poaMv0w9VNsQ7kNvwH6VXQl&_nc_oc=AdoRlxuUd8VUJ-NODHnfH15fjP59Lrq4lFolIlDrCfGykYVz5YL3aaUydNkIyFND4Yg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_zTajuVLaj1jWRosd9A-ZGINqCoXqF4tEBLNnjdea2Q&oe=6A6891E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToX8GqNrFzcQ7kNvwEo5YX3&_nc_oc=AdqqaoBJ07qb3ZL4mdLxNOdk-zK-mjjU_msFK4LK9p3uL7nGs1FQQS6uV3ybAhm9QRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAStO8VUxYJtlvwWDrJNSGw753H9wRJ_2sGrMAzbqsFLw&oe=6A68AB99"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6boeo4Z0HsQ7kNvwE2QRig&_nc_oc=AdozCevPF5XieZ6Wa4RRehCrgyDNraCDebWbDk8tEHnYGUYCw-GqPSYolMw54QTz-CI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOFBiawsYIFwxrF7CRLOPm_WWhbEseue_VwyNn0NXCeA&oe=6A68BA96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUkDdr9wj94Q7kNvwG_68H5&_nc_oc=AdqJgRcIRmLpaqVxXmUBaCZuNTLo5vOpYDu99Q1LUgI1xbz8B7_nnH3qSYqcZ4FLNjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIq6dlniDrJxAC05sBJoUQbDgwAK_0YlT_A6D-FhZF8g&oe=6A68A903"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
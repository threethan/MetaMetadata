599", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l37whK5UrJAQ7kNvwEzhxg2&_nc_oc=AdpH16hjAYp6sHvvRJLWH7Di9wCOx6Vp6q9JxpPGN0fU5UBtpdsXF6HGZ7wEnKFgUug&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EZ7kNmGFPiJS1zUku-hgMaXdS5l0rFMlohC2LgzsuEg&oe=69D7B4FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcT5dxMc8cMQ7kNvwHUEVRu&_nc_oc=AdooG6WO4N6W8Qs2eL2Bj7f4d27JUcxKELzkmMGd4Hzu5Nf0j3cDyWAWrBgkeKlDGNs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EDbtvrtJ1LFh7G3Ugi0NazD_T3QzYARGb0UTeXrd4cA&oe=69D78CE3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veiEd0NPo-UQ7kNvwGY_uRT&_nc_oc=Adqv2zpE-fMudW4KQ0DiUf4nRrnpMg7FaWfRAI7suw7vauikWz1bmX_k3mU9I6hxjGc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Qa7her4Py4cHDnlDImf2Hw-BEqRry0LR6dPo1pBxyFQ&oe=69D7A699"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfZoYYvLVOkQ7kNvwFC3qBi&_nc_oc=AdoYOzs95lix-4-l6KZUd-ji4Hu9pmoUuabpwNUECjLRWdOOa4EuKzMZm_3hkN0SB5M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dUl9Axpdyg_1fvu5ec1lFspap1-fVBYLZfaWQ6MCDbw&oe=69D7B596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIfrly-iwyQQ7kNvwFuccoL&_nc_oc=AdorBYeMt9eODWtcWquZolAr8iPbIkTaU0HlkQFfjlhAbftVbVmuCOC4RBfC_1VlYWc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IZqPjcHjxnzJk3enY3GFVE_4mq9hTAKYBXnj6UBTMtA&oe=69D7A403"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
ms2-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhP_dG0tjf0Q7kNvwFudpKq&_nc_oc=AdnsB-TAII_ur442ZzZ7gdgSrz5aKgY-HeYLIRBjj4Mti2U4d3B_bFgVuILQfzwmeQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyptdJRiFKFSHWLrV_EtdOvfUAr_leCP0hMS6Y8xCy6Uw&oe=69AD84FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E87VMWoK1eYQ7kNvwFvhQCT&_nc_oc=AdmCvwYl3sy533hlzYHa1b7lWXtfBVEZ20HhK_hVe25b-D-U96ONUE2wi79uADF3lg4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbqdBKdJ5moJJeY3uNmztPpuVPP4BtwdslMxT0uO2PCw&oe=69AD5CE3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNmCPfzi67oQ7kNvwEaK9f4&_nc_oc=AdlRQlWyDe1wU4UooVtjh8XU9XEhmybxQazjNNehuRtDKasl3xmhRerD8N0H2wgFFZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtRa9iKnt85PucKH6VgFT1TmkViWU-KNyBoBPscvxfgw&oe=69AD7699"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2VZuG2CwIQ7kNvwFE_WOS&_nc_oc=Adm_hT_Kh67QSxNxM3c8rYC7Q_0CvbYJccP3pidV6ooyfNn-RHhXP30olC7jW7EdTeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIxmk2KsOXeexHIRrUJkF8RJsdo4CWL-N-gJcwEuj1eg&oe=69AD8596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQg2Qp8-kIgQ7kNvwGwiXkS&_nc_oc=AdnXNFpbi9Gm9Eb0YF781bCGrekE7ZBXFHR-yiaoF0g8lLWEJurieuxe-_pl8sZYOQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNWqXOZPEhD7AIDZj0Zz9jIjL7xHE5JxoXNRE9vIDHUQ&oe=69AD7403"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
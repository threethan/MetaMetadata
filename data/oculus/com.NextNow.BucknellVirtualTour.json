64", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_91dP7IRH0Q7kNvwFVQ4hQ&_nc_oc=Adr2yut6Ord9v7c64u5aEFuEA73ld7GP6bFFUmwsLplxvyJOflipxey-__t1XHRCojw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoS-h7Lp5KYTuYX_rErMWVS__Tly56GQvjg0dHiwrHrQ&oe=69C7BAE3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ0pTzK4-H4Q7kNvwERq85w&_nc_oc=Adp6hFplGH9pNRBny3v68_S3o4OMUdrJ8CVfHjpMxFiyvELTsp6KHcIQbdoRIUQhy60&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCtGvrO4UPx4nNIDNEw388n_10gCjpxkkTfqG-brUaaQ&oe=69C7D499"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DFjOFPvXwUQ7kNvwEf01M7&_nc_oc=AdpVkcrvvW6g4jKBav2N3hJG7oxyIgp-MqpGy8XGKYRrJlpvh_4GyNaSC7eJjXQc8Kg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBupisyYs41UbMTNdrAhe3GFXOQ3RkquIPAE_mDZvE6Q&oe=69C7E396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O3sRhco6j8Q7kNvwErqI2c&_nc_oc=AdrcEuQtEITvoikxAKt24BdnSDanaGSfGx-NR4KQ_70JvoN7JBDs-wDhqiIqV3KB62Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyta_kp_MxNq8gYCVh4z2-w_AIFIR8g7iPv0N7LuRIelA&oe=69C7D203"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1863500963859531"}}]}, "scheduled_offers": {"count"
599", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFV0hlsQhsQQ7kNvwG8uKmW&_nc_oc=AdrPB6j-HLlN5RBr3n39eUeGStG1ewWRVDrUrdZOBros2rhmuYuDOS6VyBZx_kvorn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyndb-5QEaL5j30CfNfN-IR_wVk0EDSUYdXFkE6w-TLOg&oe=69CA85FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcHTpe2hQ6AQ7kNvwGvG-gi&_nc_oc=AdoH6vsPRip7GN7jsbGYnh5-tXC4ees2H7idbje5C0nv6VtzPUf4iX_R_0yledevub4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIcDxyuu98rHKIIPJWTeQndAR6ousWS41CzchCdtYSgQ&oe=69CA5DE3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ0pTzK4-H4Q7kNvwGrmt3Z&_nc_oc=AdolCluNNI3z2VlZhMuWwPWyGhWFt06tCbTeEkfw6lSr7myE3pGC8KFMHWsmW5AGoFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhhZ-dH_PyYaiSkVXKF3NfsId_G_w-fnBNVwa_pfkLjQ&oe=69CA7799"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DFjOFPvXwUQ7kNvwGfAvJl&_nc_oc=AdowyRNzWtj0SAgUimlQcfOzzTrHjzFK7oomeznTp-oq4kzLg4uz-bLatnJ6t5gKiD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8cRdJ9Ixf2HG7G54-CHFts0XTiCAoZHzU8KSPqgFzxg&oe=69CA8696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xZgwrnfkpEQ7kNvwHVWVE4&_nc_oc=AdrHWr1ogOi8Dh3ywNoxjYf0l-sjfRRs0Cb8gAeNHmqitNxIzDU5ipL8ikXA6gtoVz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQlKK2bGELiRw906qwhgLC6gDs0WmgXGZ7nJjrVmQFUA&oe=69CA7503"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
599", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVqM49H2WqkQ7kNvwGOlSvB&_nc_oc=AdpakB_nZu_8oV7HqkLVXsNF8VokmvB8EhFsR3Gv-y-BX3vyd6MW6U3YRA8S6000Nh8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsYZfQ4LtbQkv5leOf-XHCqwceMBLm5aJQjlJRONlpIQ&oe=6AC8F77E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCeofsbpSm0Q7kNvwEtiRZn&_nc_oc=AdoD71pfwTIKTTUmkQRI2FgzeWPHoqGHsalbWCmrI6YwfwdnKlN7mtmdxFUJF18h8P0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnKtcwwlsm_37ICcf6XVzq5xGoa2Cc2tEdETxwOyduuQ&oe=6AC907A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dfskGJhTeEQ7kNvwFs0ZvX&_nc_oc=Adrmi823TMJY7-lVtje28yXrJL3rdaghwU6RBD6-xg9BMm4X7HrLXQrix2_EtkbQ0ko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtZQ2eyp57B-suAj7trJCSuY_e1o6N-qeB2D-WKbaBPw&oe=6AC8E919"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-kghkXDzKcQ7kNvwEoXfPR&_nc_oc=AdqYuoMWdcwb1ogJn1H-Lrp1C0QRSXoQyfkVfZN-fYsKejaInhd5DA6ATHQj54sE5QE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM60Y95BgasvMk_mdNEQFw8o810C5jYQyB29C_OvMo2Eg&oe=6AC8F816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qECFZ96nEAQ7kNvwGj66w5&_nc_oc=AdoKmLeZsgZWlPaSVrpSRVRBpJuNCI7QnI1ruUobpU6e4xNlliwTJTmGUU-OD-AwbpI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlxT0Mojp58mwBdaw4ZwUP59qPJCVjOyLWUD2Gv6daZA&oe=6AC8E683"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
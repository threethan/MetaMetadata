599", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2EqvczqAHIQ7kNvwEqj7qh&_nc_oc=AdqWZgwWlyuPy0whspvbkPsEhorMiGpjnfsigEZqS-PENN92hvUzXD5kg9SuokQakxI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1IiIH4kAlwL_ojdeik4HnKvtrZ1ZPtfWdHzqFkfkKfQ&oe=6AD3BBBE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10wCHZizoAUQ7kNvwFIt-kU&_nc_oc=AdozdnkaNwK3_bYKk5zIf5MZNZ1QHEwiqRQwvMDlA7KWIvOIquMxG1tbYTFl2wOEyGc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC_l_RTukR7u06y1y7rovCXYPAM9kFuIz_nC2tvKrH6g&oe=6AD393A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mvm7AMopRW8Q7kNvwHGZ3Cm&_nc_oc=Ado66xs7g_-beY-KKhygYIXQSKTlqUNeWcPim7wQSnBlF6tw8xl4TtLnaSGxH3jSFdY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0eEzFb0rVrcHtsvV3R9VJjrAcUsv_jAVJTAmJeD6VsQ&oe=6AD3AD59"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFhErTFWYPkQ7kNvwGPQ27Z&_nc_oc=AdpL0-GISnbhcTYB6mIS--CYnUIB8bGcAFz7lx3195H3MNreMfjdfMhBujRQLf-yXKo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHpOKWVE7NZjyX9xg4loJQedxaLd1IW29uX1xrnNi4OA&oe=6AD3BC56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qfaVhQovggQ7kNvwFYTBTt&_nc_oc=AdpPw_ESOn1_rkI0AzXjW8Gt5IeXCmKrgJWiPMubHB8RSHzpF49MrppWFFUAZX2FtHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0TFsL2RdPz1VTOzbb-9I2MRTJJZbfaJvQCKTl5GhV5w&oe=6AD3AAC3"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
599", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvfgO4B-ejwQ7kNvwFq7neR&_nc_oc=Adrktka1U85jcdwUxNZwBrI5UXOyrvkVjFoqueNryW6bh77AxivUp98rCEB4EW4m8hE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSuphRKDi8Ky2Bdqwe-hLB70OCUg-wnnyR7Qnpbb0IUQ&oe=6AF9BEFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEXJCMMqTckQ7kNvwEd99sL&_nc_oc=Adqsf4ph5HFpYFRqbDljB0ocJZPhuCV3t-I_WLIZMiHi963wzFmZR42IJY8_tcUejb8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb7ZHwMjNg7SMfDHsDwAHkle47wEahWFrhUEAL4B-XTQ&oe=6AF9CF23"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J9sCyitSecQ7kNvwFRCmel&_nc_oc=AdrLyTmeGRlu81LrHR_dqID2ynpttJRkPDSksuTlg_eBoSlBLHjA3vB9fGJq4KcOAwE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmDNi118hEzsI7_UM22qEvo4ftLuqriom6w85gNZ3g0A&oe=6AF9E8D9"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfPmTkSTav4Q7kNvwEN9sOK&_nc_oc=Adobx6glYkVz-26PL1V_3KhKdlulolhQRg0qaNCQhSMUvnhpmLv4Dz1tDrAQhNiRE_4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3m3dc_zlxPIpibIlFYVnw6cu5xmQFWeTG5HMgukxPww&oe=6AF9BF96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlq3RpoLQvEQ7kNvwH3-xSa&_nc_oc=Adpg5O-4gRxy8C4e85NK2IBL6MI7e8ash11Nhf_t8U1hmlCkHX2CSKIvG9seCLc1OtM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOLENeYBC-kzNbBhBFkVLG0uCer22DNFC1qobgFy6y4g&oe=6AF9E643"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
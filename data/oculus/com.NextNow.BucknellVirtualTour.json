599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-f2Su_-ltgQ7kNvwGKEB_z&_nc_oc=AdqdcUZzlFbFXo42PE3MMB2pg0W-fhOcDn3xUTyPAMi1kb08P2xKqsOk8-A4ha15ZSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgQD2YnzuRSxHsQyFjneLsz79wBZQ2k0YgwwTHLC45Ug&oe=6AEF32FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP4Vg9Na1M4Q7kNvwFpZWBe&_nc_oc=AdpSX88eUJLcz9I_zQbCktNyRbC43u3-UH30-2Pv9YMgwHtlLnM3E9bTbgB5KHltrAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA_sRX-a2Wf0ryvxoGi9UJtcXSNLOQonyq8YxIu8-3Vw&oe=6AEF4323"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIthDqIjPEgQ7kNvwHIiVAr&_nc_oc=AdrW7vwtds-txiXbbVEOM8yXhHlyYXvRV29rhxtxvQruUK9WQdsADTKQOGff9jv5Wqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd1oiw75Z8pkNndxoEsLzcqjBHty0WM9w22bycBjTIRQ&oe=6AEF5CD9"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTf-sALujvoQ7kNvwEe8HYz&_nc_oc=AdqoY1QKgr4ri6r4wmrgYJhFPFxjh1IAoKPnYH31iJPFT_yNkkZHhRYH5VWniqTKeIk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlZvWk3mFXgO0hcvm5i-N_awWbSMGsEKNGHzPho4iDSQ&oe=6AEF3396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YEiuPqm_FwQ7kNvwEM_eKx&_nc_oc=AdrKx1TtmWFB7RTJks4c5SMIyn25FjfcZ05lVpWno1pCz9-n8eM-xeDVbTMqzJtttkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPouIdIrVs3CUrVNloYmaMZm5h2_X9k2qWC45vwrAslA&oe=6AEF5A43"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
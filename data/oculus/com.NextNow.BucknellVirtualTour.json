599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GSDstp7Pv8Q7kNvwF0MvNw&_nc_oc=Ado1R_7R_Yv1wXKDR6H3f1ykZshg_wrm1Fem4jwRDF_9sBFxBhAQJokmQbSYen9yuhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArPrDh1FtJQ9arlTEwKpoQhxpBBY3jKEwptknK5jkEjQ&oe=6A50FEFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQSYKWt-Dy4Q7kNvwG-Jvlu&_nc_oc=AdojMuHttzWQs6vAX5aX8FgMEkRCizIOtgXDvWsc1M92HzDQT08uu9rYJQdoeuOIhtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDviSl6bt-kq6lDqxFNoVGl5mdigGiIbBfNeiUPVlix3A&oe=6A510F23"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cpEDMuGNzEQ7kNvwEiUrUI&_nc_oc=AdqCzVPZueIS4FfcdRi433s295hf5lNLplVLpaQd-PiurTKOXKqqYByZe1nRCKvvjjk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlAM7SexNJLbuZAnXuK9oNZPEYrAPyAH7xjdJUSQ8Mlw&oe=6A50F099"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmS4j5SCJB0Q7kNvwF8GlkF&_nc_oc=AdpMjjJ2JMwnNMPqs6HXXvSdTNWNKJlTPR0a_AsmqUmYcDY3jQhi5fPpS9HDhIl2Bpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEPTvsa_kra1HnR-mkztlbfGPRUX3K3zEH2_ojVevplA&oe=6A50FF96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbLwQeSWk0sQ7kNvwHLvc53&_nc_oc=AdqWBAJKiSZrrM2OIGvpfutAjWMajB_Z6FfZYBDQZx0lWc4EVotxiUHRXL2Nbe047P8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTd2SG0vQL724uScy8GcbEqcvAjXyJBwLiR9HDMfe2YA&oe=6A50EE03"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
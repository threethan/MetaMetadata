ms2-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhP_dG0tjf0Q7kNvwHKaJTe&_nc_oc=Adm-_rUY4IaGC06GhLf-2uIhTs4Kwz_Kz335AxC9_vfwXUPnglHhaji5P7w7ov1Y_Ic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYHoraJlFiz6lI2hhOzN4WcEJwmh408ajhr38s077vAg&oe=69AED67E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E87VMWoK1eYQ7kNvwGDCEuw&_nc_oc=Adk0qKr3FqUr8yyLRDNULYtEEDV3kGJhaH-EroKQFYlpcNAbQnlHhh787rW-A7_Hv8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQzTwAr3KCSfTIWRImzmJYPr0_W5LE8neDUjKXshHSkg&oe=69AEAE63"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNmCPfzi67oQ7kNvwGyOd7r&_nc_oc=AdmaRkwF5kOVxxFUVfR2lNmK4YtAF_ELm0C1uYphiEK-AmQndO2Q7JuWbxmFOATRBCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhF3RgzlVWxn8OMNLSmFiz8T7J1lrvAjPbhTFO_cxBFQ&oe=69AEC819"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2VZuG2CwIQ7kNvwEF_rb2&_nc_oc=AdnY_FZA9g2gEwLcVtqe_w3mqAjrt_ciky16AhYIgmRf3NsYSAhgoTItkX2lQZZL8gQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCiv9F4GsRBgoPrUpvU47TaLeIVrdYcPiblvmZy7XE5Q&oe=69AED716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADAu1roWfbAQ7kNvwGxBAr9&_nc_oc=AdlTgfZ8DrGa-Ky2EFyz2Yht_sNH0_d3TYrM-xaRI1UPOhhe8EfzeGX94sw5xQnEDAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhJf4k_TttgtcpuRLTf6LdECFTua6Eob7T7PDQCAPGIQ&oe=69AEC583"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
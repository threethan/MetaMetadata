599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-VynxkkkL4Q7kNvwHB_Xet&_nc_oc=AdoApHg7bGYWrS19DEeNil1veUmty9WJUh6d5_KlPyZJCr4suYvBwVL-aHmI6eNvLKQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf_OsN2IbJCinvGPUduwlEJsv-Bs7FOHE0VC2BlEEPhQ&oe=6AB6827E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1fZi4uOKKMQ7kNvwGMEx91&_nc_oc=AdrPxRKC4A4PlELGjK3sYi3PpmLLkui5kJ-bJH9xOoyEYPkmcQ1m8U0Gpj6Q7s-ufWM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE0KSaaWstR7BNrv_5pql8qiSCtvN7Ioc5i_8XTNPIqQ&oe=6AB692A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tTOAJwaA5sQ7kNvwGBRRBI&_nc_oc=AdoIzuzZincpk1v9aoOPxYBTXHj2X0lu3b9amcAjW1px2wYLwl7cAtfkEHf9pCtpp5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm6ypgLxs-ibaFj98YMwK7VMpYI08yaCzktfoVU-rDyw&oe=6AB67419"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lXNTBpi24EQ7kNvwFr4u2a&_nc_oc=AdoLhyya-p9fn5UYkfakhsppMPdgbRb8Py3wXHDGEE_s-4ELtmS76kryPhTdpOyhCng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2t6PUyWkB6EXrjBMkierIEPhUogDK4VqTYB9DPTYhxA&oe=6AB68316"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Z-dQSlmdAkQ7kNvwFexL0P&_nc_oc=AdrBadouSlHKyViDG9syCt41R_FzoN5lAXSLBX6uW6_enebtAbImXm2kVLgta5VD77U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeqo_n3Yp-TPcjsKYCjztArO0a4doAdJO_Ar2r2ytqXQ&oe=6AB67183"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
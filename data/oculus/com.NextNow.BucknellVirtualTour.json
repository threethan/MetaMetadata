599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qjGHrxVXzEQ7kNvwFRhU0O&_nc_oc=AdrQwnn76JftyXhddh0DkoJNgvRuw7LmJPdrIzJTRKlXNrNc36ney1w-lrqtYXX-dOs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxa8wVPrdhLEbMF6MwLELXzW1JltERyjWDpH8NolCqjLQ&oe=69C29CFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4K6KG24Z-MQ7kNvwGwtYlJ&_nc_oc=AdriJqzRFXiN5ekkCK1WaNFZ4sx-gm_W9E1ddv1TlX2gqlBLFSVaY6X9RutKQDIWgkE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaQBdwzpF6SJe-JluLoa1rbSDLQbX6Dtg2eDyfkxKJjw&oe=69C274E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCKY7Xp1Fu4Q7kNvwFjWwBL&_nc_oc=AdrY-NfAvDdxN9qvlu523om4aWn1NKPGHpUJYdzP06zWKBy5k7wU-ZnE_cXQNFa9mPQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmtVXtyMGH_fiw2oUq3vffu7CCpwpTnpxCYzY2PTJImw&oe=69C28E99"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R58zy-pMFuIQ7kNvwGhWYoa&_nc_oc=Adqby3IVRShpthMwNa6xo0yk-6elUDZtf5lcbH5Hrd32FTjOW0C-9J3v6AY3BcLlm7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySGTfINtTmmIgqBLxIZEeoCV4Kf3O7IpwIsac0bQ9Xew&oe=69C29D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMm1ZsNnDTAQ7kNvwE49LJm&_nc_oc=AdpFZ-0V1Ivr28MurvzAGYEWZ-1QgzjfH3Sa_Fs_7mNm4JSwfVSXdCBZN48x377NKfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycjXyYqQE0-r-rSCSVzN4HBGvMMisK81Fm1o3NhH262A&oe=69C28C03"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
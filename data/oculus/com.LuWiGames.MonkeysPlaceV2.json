.com/v/t64.5771-25/39031503_507168691853308_2517162001731453462_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrVSfdsOPP4Q7kNvwF4_QiH&_nc_oc=AdrxqlptOEmx1mQFN77F0qkkXORIIxCuy5Ili9gd54RJvasI7RVy4Kn2gRm8RP9yr1A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d5mzShGrX0IF9AS9XUf2plS6D3RfkXr1DRTRmOq9s5g&oe=6A11A28F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtQuerformatOfficialStore.png", "id": "542327048142631", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035339_542327051475964_8168011836067841772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az4c0Q1Pp6YQ7kNvwGj3Etk&_nc_oc=Adrw1NErkIiMPJug3iDX7oEQ9siqGWbJ3NAA0agc_rGTFNrkT85XW2Iyt_VIJHiMji4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5de0-2758eq3IToKtScf1Ppe8S9RGP-0id5NYxvMvRCg&oe=6A11AC9F"}, "display_name": "Monkeys Realm", "keywords": ["Action", "Multiplayer", "Monkey", "Social", "Horror"], "long_description": "This game is about Monkeys! the game is really fun to play with friends or your family. you can play minigames or just jump around and have fun in different maps. theres a shop where you can buy items to equip and many other things. you should definitely try it out! the community is really friendly and nice. you can also find hidden cosmetics around the maps and unlock them. have fun!\n\nSpecial thanks to following people who made the Trailer!:\n-Olive-Merks-Slatty-Cozmic-Z3nif-Yippee-Supertaco-SavvyMonkey", "short_description": "This game is about monkeys and is a fun multiplayer game to try out in your free time!"}]}, "developer_name": "Gandalf", "developer_privacy_policy_url": "https://docs.google.com/document/d/1qx3MTpZ_TBsfAo2_MWsGjNevybYp9D2GdGxgy9WBJ6c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LuWi Games", "support_website_url": "https://luwigames.com/contact.html", "website_url": "https://luwigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfo
FE9-5RnxjsgBwfbam5Fii-Dcz5JbaRUk6u0bRsRWl4U6b80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvM5CdD4S45ZCejtXP_2Ia-4mhAMUXiMLI370kH4vwkKw&oe=69A2E48F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtQuerformatOfficialStore.png", "id": "542327048142631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035339_542327051475964_8168011836067841772_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rWfPOS4wZ8Q7kNvwFtUIHi&_nc_oc=Adl7uhpSufPclcEmIuXEiL64q_uebZzz_TC-bQNERtYESdo0vpoyWMQvH1gPiiN274Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7449-1X9zfEJyKsIYm6mE3yD_fZNiIGFxMOoExKRgnQ&oe=69A2EE9F"}, "display_name": "Monkeys Realm", "keywords": ["Action", "Multiplayer", "Monkey", "Social", "Horror"], "long_description": "This game is about Monkeys! the game is really fun to play with friends or your family. you can play minigames or just jump around and have fun in different maps. theres a shop where you can buy items to equip and many other things. you should definitely try it out! the community is really friendly and nice. you can also find hidden cosmetics around the maps and unlock them. have fun!\n\nSpecial thanks to following people who made the Trailer!:\n-Olive-Merks-Slatty-Cozmic-Z3nif-Yippee-Supertaco-SavvyMonkey", "short_description": "This game is about monkeys and is a fun multiplayer game to try out in your free time!"}]}, "developer_name": "Gandalf", "developer_privacy_policy_url": "https://docs.google.com/document/d/1qx3MTpZ_TBsfAo2_MWsGjNevybYp9D2GdGxgy9WBJ6c/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "LuWi Games", "support_website_url": "https://luwigames.com/contact.html", "website_url": "https://luwigames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genre
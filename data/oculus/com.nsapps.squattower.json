c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8y4E-Cme7Csw3lMAz9ABHO1wboIY2U46LYG6AJn_LOA&oe=6A84520D"}, {"file_name": "9.png", "id": "27591035660568993", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619450_27591035670568992_2664829956211727682_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhpiyFu04-gQ7kNvwEgs9Ax&_nc_oc=Adr25nL2Qnj7bTbSJSomtxqDRvW0h5kSkwOR2B19fPfFeNbe7R_o3efo_IOF_U1e_yY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAA9YZIuRYh60rNJbk_T4Nt4cJzL1yLP4-qYX-2oFYVA&oe=6A84448F"}, {"file_name": "10.png", "id": "1394442132534841", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_1394442135868174_411958629125444831_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mEBT3WCnlQQ7kNvwHu3dEd&_nc_oc=Adp6WGyq6AVPHK0Qg5c-D-f9zevv_abu92SneJQU1sq-7zRTwGwYw0GXlqop0VKn7Q4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo03R4appG0qs8A_mYm-xTD9jaVEFodL8HT8-t0w-C8w&oe=6A8466B9"}, {"file_name": "11.png", "id": "2227146384766841", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308050_2227146388100174_181772332220201964_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Enw4DqPu3UQ7kNvwFqa9LJ&_nc_oc=AdqW765B0rhLdB719tVx79jq0X45O8tyjx4P591Ek5PqtoXUGHQCv7wr_PiXip84uB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGovgbXs-68rO0i_41LMGY2Eglm2Nmw8FvRWGLS82POjg&oe=6A843511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "1616217236745765", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312332_1616217240079098_3639541779998347846_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICvr7iy8q6QQ7kNvwFV_PvK&_nc_oc=Ado7Np-DfU5FYSFM5zejhRRMoqOGu9w7e0fYCFmCPgTSdpLtdgmYOCw4WrZxsXhg48c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUm6umT6YUziGOXPDnpCVbwEiKL5zRqC8U_4GpGfZ2Xw&oe=6A8469B9"}, "display_name": "Squat Fit Hopper: Cardio Leg Workout", "keywords": ["Fitness", "Jumping", "Health", "Exercise", "Training"], "long_description": "# Turn Every Squat into an Epic Leap! \u26a1\n\n**Ready to take your leg workout to new heights?**\n\nSquat Fit Hopper transforms the standard squat into a thrilling jumping adventure. By translating your upward movement directly into forward motion, you'll burn calories, raise your heart rate, and build lower-body strength\u2014without it ever feeling like a chore.\n\n# \ud83d\udd25 Key Features\n\n- **\ud83d\udc38 Squat to Jump Mechanics**  \n  The lower you drop, the higher you hop! There is no joystick movement\u2014standing up vigorously from a squat is what propels you forward. Control your squat depth to perfectly land on the next floating island!\n\n- **\ud83d\udcaa Intense Cardio & Leg Workout**  \n  Your real-world squat is your only way to move. Repeating this explosive physical action will naturally boost your heart rate and challenge your glutes, quads, and stamina.\n\n\n- **\u2699\ufe0f Scale Your Challenge**  \n\n  - **EASY:** Offers jump trajectories and checkpoints.\n  - **NORMAL:** Keeps only the checkpoints.\n  - **HARD:** Removes all support for a pure, unforgiving test of skill and leg strength!\n- **\ud83c\udf33 Immersive Jumping Action**  \n  Feel the rush of leaping across floating islands in dynamic environments, where every successful landing brings a satisfying sense of achievement.\n\n- **\ud83d\ude4c Controller-Free Freedom**  \n  Fully supports hand tracking! With your hands completely free, you can forget about the controllers and dive headfirst into an intense, focused leg workout.\n\n# Ready to Bounce? \ud83c\udfc6\n\n**Drop low, jump high, and crush your leg workout today!**", "short_description": "Squat deep, jump high, and conquer the course! \ud83d\udc38 Squat Fit Hopper is a unique VR fitness game where your real-world squats propel you forward. Control your jump height by how deep you squat, leap across floating islands, and bounce your way to stronger legs. Your ultimate jumping leg day starts now! \ud83c\udfc6   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27928902613368361"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310731_1081933254166469_6579204099354067375_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecbS48Y8iKoQ7kNvwFCxpw9&_nc_oc=AdqTrls4XT5SePqmKSCQWwq4LCFbXKH_0YbCpzAy6K6EW2MFRyrEJyvDjnzECVBGhUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0t3KpPC3yO01mz1Yb9SXYhCMJkAVpZEtRMeO2F3LMRg&oe=6A845E26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squat Fit Hopper: Cardio Leg Workout", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1785201840, "lastRevision": {"nodes": [{"id": "27928902650035024", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27928902586701697", "is_first_party
_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ1z4LwunwQQ7kNvwH5pVQT&_nc_oc=Adkz_wtbD6V6zw0xzVYqj2D7qCqT2EvcfZQX31QP6j2YEhVkLqz88VVcRzm2JEuII14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxmp7OAcnuWMLeLyt3GqA2cWAPsH_b7x9qWH0WREg9uNA&oe=69BBF490"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzAvEtlItqEQ7kNvwE9Mczb&_nc_oc=Adk_aWiYgyG-2ETIa-NOrFN1ltlMNV1J0JnUuVSYM-l9zqY64ypiRS4gCsOqa9gvn6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz5xpkiyOZrtzGztsdhKwgFefL0b8eFIE54ReCz6QR_iw&oe=69BBEE95"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saSVpo1ytkkQ7kNvwHR_KIL&_nc_oc=AdlvUzGefRepRidRkBfDkryJ72A-ygPD1yKStNOvK1HzT1gGdtBW7ec_5ld3EOxU1gM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxOMtQ-bTN_BNP0f0ToMRi9QsBCmPrkzVuUkLdF4KsSnw&oe=69BC0314"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N0ZbogE07gQ7kNvwFXFtBv&_nc_oc=AdnLho1p1p4mnTPFk0K_gYAohrQPKY-nCDAnJlz1kn2A0wEJ3cM-1X3epCG4i07A5So&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdaQsIzR_3NhbmPEzIpv7KSeEoRF-I8DHiReAOsS_dbQ&oe=69BBDC8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmL_uqN9OssQ7kNvwEs8P1x&_nc_oc=AdmU2meMCjyeMZ9CtPzDnZQZ8fb6Yyl63aM9ir-0RApdRRDRUgl0jcsFM71GZ3Zo6rI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQT-ns1OrsmYQyEki9fenR1Wz_vQ5zdPEyKZuialjuWw&oe=69BBEBCC"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IOE5iSX9sEQ7kNvwGygSbR&_nc_oc=AdkRLMSCE-DCTy-n8qxtClbLZrdX-dteN04M8l9mn2vwl_7X6pSRflS-HU2GYAUcrcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfukPp2oba7kDjMNSHiAPt9bPSDA_y65TweQhu_zeucioQ&oe=69A97F90"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jm7trTqWxAcQ7kNvwFTG5EU&_nc_oc=Adn_i0-4OkKRJseXZhjin475hoJ-Kh2K59cvkORBr2DO_yL2z5yRRNCvWTlD8BLntvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft2-hGKG0GlEHwhAsZrqkNs_809VAJvZRskNY3JBklTfw&oe=69A97995"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSwqpa3TMxEQ7kNvwGgWBla&_nc_oc=AdnqA1LURiqcipk-VzhIKLTBWbvro1MIWTEYDtq33aICvIsFyNzkAtWFuQRPOCyPGd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftySdR8ruSxbtPfDF-EyOgN3upUEBwZzze4GCOdDo5FKQ&oe=69A98E14"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9G8-haKVAwQ7kNvwGeK88x&_nc_oc=Adnwu7hpMjSkKbFtq2yRZIv7V0gWvL31N54lDP60vB7RyF3B-pxNxpP24SyVEAXkMZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvACHXlIenxtBeukaaZQQeQb7K5NUcO-PCI5Ek-lnPvIQ&oe=69A9678B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIl_3VFhtawQ7kNvwHtdXKO&_nc_oc=Admla8Md9IjOk9GhRWcRxRB4dykTtlzVG48JKzGVXfpWuCIfmcoPGTz1smbeVl5t5sE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu-7zwtaaRInYTBJYueHe1W8OpLKW2_FIxrbavTZRQ5Aw&oe=69A976CC"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
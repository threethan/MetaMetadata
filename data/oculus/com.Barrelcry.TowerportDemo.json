_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WFQl9bfuUAQ7kNvwFk5Qmu&_nc_oc=Adn_kXgmTXdzNq44tLpgs5QlBmN_oLmCijypfU0G1c-jGpS48iarGOkhCaHQgUnFkYk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhhmwYpi1YqtaU5jmY6uJtBw_PTv3odb2wg9K2NEqAFg&oe=69BD4610"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_indkn-Sc6gQ7kNvwHb2Kzv&_nc_oc=Admp76Ie4O4NcmbC76x9hcMASQxIqw_FgPi_zQeBHZc5DRyA_bitveQj-Wyy3bV3pdk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfweNIv1dbeKvE7PIlrcxAfUAQxkCAEb33-rfi21EDfDxg&oe=69BD4015"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saSVpo1ytkkQ7kNvwFCXDGQ&_nc_oc=AdnirB8Z9BtXV2frJnv9q6RrmauZKZYk33eaTWv6kCyJ6Lf0qa7TwQ40OYbJhispQ7s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHRyido8dV5WXbTCeAL8b45I88p27xQmdgmlYTxGlx2w&oe=69BD5494"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N0ZbogE07gQ7kNvwGxzGd-&_nc_oc=AdlQvPNI0Wonra084r4d0tos41HMs7wAH9Hg0G4X9mBosBNreVQ3z5c57HayBe9OWa4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxnEcH4KhKFYbvsrkOQ6yMUj5p1bg7VYAHDdonQpzY1pQ&oe=69BD2E0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmL_uqN9OssQ7kNvwFxLuft&_nc_oc=AdlyUcFpKwyJa-1nMHUIE8aJAXcK3O6RJKeEr_gcx0M9dPN_OjqsMbVYzlnhdV9bh1Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPr33G11Qk2mughJziil5HYsNkbCmMTb0w7wd4mNLqLA&oe=69BD3D4C"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
_sid=6e7a0a&_nc_ohc=HuMCwqEOIK8Q7kNvwF3az1X&_nc_oc=AdnH74Kj7FgeZL5mdg9eeZ5GLGJ-FRP8IsS89NFm2V4Qc6OKQDDMdZjanNEmLkE-dC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs3eH0lMya_oea3NrhbdXGpGd8O5xKdja77fyQw5dDorA&oe=69A44814"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBid-7X9q2YQ7kNvwFOe9Wa&_nc_oc=AdkqvONWE6Dx5ERzVDMq7-mrGtD7Ajcz7cnYIbY87dEBBfjCvU5JFYTl0-KbP9L4E5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftF9Gp2QFS91YhNAKwFiYwCJri0fkys9ybPGovXro13Gg&oe=69A4218B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0N03YAtwDkQ7kNvwExwgOh&_nc_oc=Adl4I1CD5Pxkj5JF_jLOESbYfUtvVKUj0Ozzoq01mVHX73YDlXAc9ZTMMUTSpc66iI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftxMrCGTQRrYOvg4yb3mkVI8uyniIVruXI0Q_HUMhXNaA&oe=69A430CC"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094210291218429"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6691967570835314", "version": "0.2"}, "id": "1954991131365707", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5811635368868543", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6691967570835314"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1954991131365707"}]}, "change_log
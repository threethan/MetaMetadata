_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN85hntpr9MQ7kNvwFdRDIc&_nc_oc=AdnJopFIWcgcyXNLBPtRN4dLJ6uEImfHRTonuaTHgV-qOM5sVXws1rXOSggF3igwPS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ0JImK9csKLmzdj9tM_HCm_vu2Thxn73Goyi89lCTPg&oe=69B6AE90"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWFdC7PR8AgQ7kNvwF1JAd7&_nc_oc=AdnTsbkl5Fm8pHwFzHTmZpHUa60lrOPP8qysJPJdhfMDyCu8merc469YkEb-UQj_C7Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyD0lRsZOrnbH8T_AXYRSRvuK8s3zm4617GbnyR-yGI9Q&oe=69B6A895"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBVdufa6XOUQ7kNvwFdGKEu&_nc_oc=AdmA44EgJM_4FfQ1qzWk7TJPqV23QrcmlhWOmKX3jTOLUKNwOCVrWPV6eyZc7uIpIY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxzETmVSU4WxH8RRE1_OpT4oSPBgz9bRcP7bS3hEnySQ&oe=69B6BD14"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRugfOT5NwkQ7kNvwHkppIZ&_nc_oc=AdmBdph1xycqRAt1d8j2QZQzyLdfPhl1lz5M6-ugiJICLz_frCavySMak3F1mJQU9Ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZcsUlYpz7uVNUZdTy6Xsxq-ZG-1FjKz6UR4SkzdrkLw&oe=69B6968B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vu9embTaH-sQ7kNvwHOE75v&_nc_oc=AdnTuvUrmDf3gwfD72nwXjOh1DlGeUYc1gekuhQT_Se3sJ02MEgng18fRbXjHZaEMmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsNB9jYCSOTIzE8VB9inSjU_YuDTjvtJZmjEcTwx3ntA&oe=69B6A5CC"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
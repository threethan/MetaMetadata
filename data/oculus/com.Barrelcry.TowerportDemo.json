_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdQtzdOlWyEQ7kNvwH94SFt&_nc_oc=Adp1vBKAAZ3e9PQx9vyoX3cboOdw-SZG4SOn-f2Ep3E5hKljoYozvQZ3mKIdd42Ysow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIsA1MzDFSRYaETCxEyg0MJLN1BPEhOu_t0pVjui9LZg&oe=69C13A90"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keOb3KY0o_MQ7kNvwEps2JK&_nc_oc=AdoEAe404ncuBLujJxImfsjpPd7xCoXLlBs-K9SVANatoJ3Ol334Vbcu_VlIqTHH29Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4oQY-4FY8HbhRfV9T4SJgbYnOcWDTcQPjk8Md51Rvqg&oe=69C13495"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKf_iX215XsQ7kNvwHtbfRH&_nc_oc=AdpBE0w7DecZVfjSNbDLJ8dFEXWkvzEYAu2fO_RUqMFSMc63SbaUuTv3U6NGGhbvCpY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWsEHYUEjMWyR0LvCWYt1SkNNeoHKiyAf-FC2A387VQA&oe=69C14914"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIy3x0TqLhsQ7kNvwEnQ6KQ&_nc_oc=AdrNu8iU_L9iOOsK5VIci2Sr7bkGP2wB9o1I8qs3wIx3pWkrin_GgcKWuQqdRwxnkNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxStGj6PWcDQhgZIxObsYs5dolONao2KXZCoC9tx730zA&oe=69C1228B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHFRlrOKQocQ7kNvwExXvAx&_nc_oc=Adpw9SlsIeHbm6VyWprtKu10w72v-evh6ECAAtNScUbtFEa5kH3cCw-LfRGgfQDb8U4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvkMCbfEcQ-YVqKlhD5HcOjGqkstUlmnwlb-47uvNKyA&oe=69C131CC"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
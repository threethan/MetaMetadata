_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXqcPZxO_ksQ7kNvwG7lA9-&_nc_oc=AdlOQ8CrzK5y3fG2A1F_Fm-SH2pHY09Vs5P-p-7-IdeMlHtmcsVbNSIEUtcqyVfHT7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmdUTuIAvcnrwBSvo2UeuZ2yFwmd0sh8LYfV4tXrPGGg&oe=69B2BA10"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34bU-vSD2aQQ7kNvwFSDfKy&_nc_oc=AdngIpzsw65p_f-e1AA_jhQCHL9h72V4qZUPxq0IYV6hZ1lMr3dtSXyFZoK_in--cMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJNrjVA-dEWgoH5OpLeWBtIy9mpTp0xs4c1nf47Tyr2g&oe=69B2B415"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD_2eJqRCfQQ7kNvwGtzrAG&_nc_oc=AdmsgQGCUu3Ze2Iw_EI95O4CrUJ2pWlXkaGclOqIroBiAQzJzi8EDc1jlUSCTpFayns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfxuqHjt4mEAZ9qX5JZtP-sxRj6_CyO2EQcx8A29vGag&oe=69B2C894"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNqooAaKI7MQ7kNvwH_5kf9&_nc_oc=AdlN_Dmd3KLHySB83ixx6d0xOA-Erkwr9Zcz0NNzUK_rnf1mnBJow7jaWngTDjEnlqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9o6kHj5AAD4ix_eWJD_hubEx4xgDr9NNZcUu6UX30PQ&oe=69B2A20B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZskdY1nevgQ7kNvwHIjvVH&_nc_oc=Admj1Np5tFrdGYQ8BziCX7ulxoOLtAFLhzaMFDrdf5VS1f1yiOkBXJtYqPZMkbMKq-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyAf5epXv3-bo5Vbd4XKFFz2fyBFfL0oqXYuolval_SSQ&oe=69B2B14C"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
kyPHVuSzAQ7kNvwHATtAD&_nc_oc=AdnIs9k5i38cQdeTqaKPSBr1gzSaOJ7byt5I2cyzhW-mSifV-omPyiw0h2m5LDjs9-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv4Qo1T7qm9lbHeCkc0zhH62vdd6V59BhhERG0SauP3HA&oe=699AFF10"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNQpoNIftC8Q7kNvwEuOevl&_nc_oc=Adm8zi6R-QDMTB6p6wourw7tvNOQjeDBjNPWv0zsjwtVYCAeimZ7SHGmFLpvXaZeuYg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftDbB1JGW_oZ30d5uoNDGimyedMsZrIHrtqvgHjM-8gPQ&oe=699AF915"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU1cY4FupaIQ7kNvwEww_US&_nc_oc=AdkTNEyJwtPH-sxQik63sVJDzFkyCq_8uV8O-RH6-RxKW5RLwN9IEmmzi9XC0V5w21k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftMV2cx4V7TXC0qjCHcuq16UeA6tVnJVs_BHZRQA7ovmQ&oe=699B0D94"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8kzNZg4pEkQ7kNvwFrUAdw&_nc_oc=Adl4uLr1sBiutxP6m9LseQNZOqnCRGSmORlbtiYrZKdoxAwlB6kuyp_1PztetUVwUbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftEpFDBnAgvR63UdxklLe5t_670e8oFeX6nbq2QeqQJ0w&oe=699AE70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0kvKWent5oQ7kNvwHeUJ5n&_nc_oc=AdlE-XjMu1e9kOrq2liwJEpB2cOi3qU4t8DwS6yG7oqoRiHVCGFLq59Gp_sYIm14wCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvI6YzDORkiCRF8TpcMfrSLO5xsc_Q36HKDcR9kdsL2ig&oe=699AF64C"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10942
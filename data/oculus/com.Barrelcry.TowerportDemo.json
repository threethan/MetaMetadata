_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ1z4LwunwQQ7kNvwHFFcwR&_nc_oc=Admayig_Hu0ml-YjS-uDS2pqSQY8gU4bQeYE520WNfgchsQdrXo_UROKhMwL7Mp4wjU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx0dciHR1kMuzk571W72UAYIpHF_rmcaA11zm4-ZA6HoQ&oe=69BAA310"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzAvEtlItqEQ7kNvwFRTN6_&_nc_oc=AdnwRo9yKseg2dY952wm80ROEgqXoluyAb61Z-QU8sL8T7JaPx6KDXqTEvptoTQn2a4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6N83V5bQQAiNhB8tXY6a8aiVLSuyqqrW0YRlT8GYCcw&oe=69BA9D15"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qyWXQhOM3UQ7kNvwHFtOhH&_nc_oc=Adnocr9o_623OJ0vy4qnSxNNwthU-iwfJq8QYyfoijn_4mPv0cxU15HOckppuZERbxE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpLgd4ltY-1cChYN6FivSlfe0n1yAcaBcd8xR4XniSmw&oe=69BAB194"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSzfpXe7ntsQ7kNvwFC8PaL&_nc_oc=Adl17Tv16Bmdeu54_vqSz4nUWRus4emzJXqJ-FlUzlBouHYTxW96bqu2IZejeeBARTQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLr69J9xRHFOcbF3cnoJaYXSUrwduUHsGCYdqH4N-hVg&oe=69BA8B0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSr-XediyaoQ7kNvwHTkEyq&_nc_oc=Adm9ztoGq0kI-SKejwjpiLupCXP1iB7kIodvDya2D4OrliYzTPVjWYUfqLkPsnZLxDE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfOC8pc_w-edkZf-wqQpB9Dd7PMgqja8hnf84gBGtnVg&oe=69BA9A4C"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
_7189707384372025167_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1Cl-W9ti6kQ7kNvwFavcsm&_nc_oc=Adm_NhnqbQAs19vH8_EedfAZ1v2KzGXIEYu2qBPCJluRbIcvisbVpGPPHyiAyY7M6Uo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvaNjWZbxlBzh-PbH8Bmxcz0NLzEZej2dEpB2YOl6X7Ng&oe=69A82E10"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdT_hl7YqdYQ7kNvwFNaf34&_nc_oc=AdnNRIQnO4m3f2C3A1sTndlN3k_DY8FrdegM6C7F0c-rWmW-yyXIXNckQBNfoVd6UlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft25d2cOI6v1fXsLzXfEHsVylx-3kEqcvkbaxZoCfdsuQ&oe=69A82815"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSwqpa3TMxEQ7kNvwF3CuoD&_nc_oc=AdmhFOfDg-yyYA_itD2s7zj3DOAhszUY9FaldFXwrP-5IP900YnvzfrELe1l09PTgTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfviEIfWHsz30Z5qcsQ2KIhG9MRjEX_A_AW3Ag_KksSGKA&oe=69A83C94"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9G8-haKVAwQ7kNvwH1YDlY&_nc_oc=Adlcb9_jynJbQnQVYhq7DMHBBmORv2-Slv9uFeCTMGdpF2V7Ffe1r-y4XbzOW-F1gbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftWOAoMNnmw03UX9Ah7Cov5unLIqnto_EQvIuniB7EvHA&oe=69A8160B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIl_3VFhtawQ7kNvwEtpf_v&_nc_oc=AdkDRdYkRjINVsNeMDhtVXcWEMuHXxGjnPfB8i2EX_aFtd1FVFvprjZ-8qgtnv0a0rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu2P-u_ZZlg3XdU7ayFQiuBe4B1INgjHuynIHR0sKQJSA&oe=69A8254C"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
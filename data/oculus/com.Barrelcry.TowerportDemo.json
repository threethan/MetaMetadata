ayJZk4YowQ7kNvwEeVxti&_nc_oc=AdnVKOHTMq4QMOWEx89UDvdh04zAmD5pF4HJGWkVi8OOvQ3WxQUOGEf5jS4Z6IbUJu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQNrtyeT0x6xReD7MTbyTiu-2TG-nmk_LUJXlR7cyzJw&oe=69A2E810"}, {"file_name": "3.png", "id": "419966350236659", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035425_419966353569992_8165783761145276890_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4WQ8Wm_j5wQ7kNvwFFXhkO&_nc_oc=AdlsCt31W0Jk91lwlZl4D73gGS07pnBcdR85AGUR5WQke8UaodeKYcAwvzyLRw-eaq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft51_u1jb-QPGOrZ3godyxa5OBUtpGja61AXrDUpU8tjA&oe=69A2E215"}, {"file_name": "4.png", "id": "1046342166063489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974760_1046342169396822_2464903453867216222_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur920-XdPyYQ7kNvwFXghU4&_nc_oc=AdnwkjPm6iUhCfFbxRMj9KRtqDp6XR4iiWCsmo7HS0evk9IKfVfQBL3Y8vz8jJ3uzZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft8a6iiDKLsDj26zRaQJF1334UKruIWqtwKVLeGz8MqfA&oe=69A2F694"}, {"file_name": "2.png", "id": "1758009217870081", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575358_1758009224536747_6093307699415438475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Xf6pekbJZ4Q7kNvwF8v0ka&_nc_oc=AdnuTbb9q_IAhs5EbjyufRzJtWcH3-1m0pmSxCMJEOLImDz9swe7WHrUKUUdyP7STKY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDx4_FhEKGLaNaqMnXJV3zwpTAeuUtUZ_At1NJi1WhwQ&oe=69A2D00B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape.png", "id": "1089995215277965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982532_1089995218611298_2733378075075386054_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVTvoTLa6ZMQ7kNvwFkITPn&_nc_oc=AdmO62s5Vu19chjWadGuh1B_TtLmI8Ti9RASlFkIYf7922XH2FK0-_T9Pd4YjXKg-to&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs535P8CMJ3rxFElyBjfm0gzNb0lC5BUGOuELSQDEdFwg&oe=69A2DF4C"}, "display_name": "Towerport Demo", "keywords": [], "long_description": "STRATEGY AND ACTION\nAs the sole defender of the realm, you will need to be an effective archer as well as a fast-thinking strategist. The enemy is persistent and strong, and will often attack more than one front. Your ability to keep calm, build the right towers on the right spots, freezing a group of enemies with your battle orbs while nailing head-shots with your bow, will be crucial to your success\n\nADAPT AND PREVAIL\nThroughout your missions, you will confront gradually tougher enemies with various skill sets and stats. No single strategy works for them all. You will have to adapt and experiment with alternative tactics to succeed.\n\nLOOKING FOR THE FULL VERSION?\n- https://www.oculus.com/experiences/quest/7805743412834399/", "short_description": "Demo version of Towerport (3 levels available)\n\nA VR tower defense experience where you function as both general and soldier. As the newly appointed Sky Marshall you oversee the defense effort and take on the enemy with bow, zeppelin, and battle orbs! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://barrelcry.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Barrelcry", "support_website_url": null, "website_url": "https://barrelcry.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10942
45692978_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT2J8VYHor0Q7kNvwHokmsE&_nc_oc=Adot3T64BE-bviqGtKJPRksyTIhVGAp8WxJpusZ7nRnZ-a5Mu4JJ9tUZZedsCLPEVtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoHGU1hsiVYHYOf4Dyz0weXqCMHbqHi_EffExUywWnUQ&oe=6AC10B62"}, {"file_name": "screenshot_03_brush_strokes_2560x1440.png", "id": "1357391666377053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654867655_1357391669710386_1839392816663363473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIXdGckioVAQ7kNvwETQe9p&_nc_oc=Ado9f-X6aj0GGGHVnbYq7nr1XJG6DGF6LkzCZq_N--QhYDOAXuFo0JYfBW4pMP3Eqao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfYnttH9rJQpGNFmL9R6naUTQvlJ159yvSoNZnmkNytQ&oe=6AC116C7"}, {"file_name": "screenshot_04_artist_styles_2560x1440.png", "id": "1743390740322997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296123_1743390743656330_5790578209015093013_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFU-rCsgYBoQ7kNvwHfVQDX&_nc_oc=Adp-nNkWE0GE25edfaFf6O1Mn80Mj73UXmLvVgzwnTiwGhcrYXGUgaU8NOAUaaKm9PU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKZJ2lOKXRkW4d9TpXPPD0p_Qi5USgQfc1YTFGyRs_Hw&oe=6AC1067D"}, {"file_name": "screenshot_01_main_menu_2560x1440.png", "id": "1646125106847296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298900_1646125110180629_3437702487713078848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvWaNBJIyGQQ7kNvwHUhoxl&_nc_oc=Adr9NHdeLLdKk9_1L-uBGwv_-zxu2m5g5nVTpjih2FEakUbOXI_DepBvvOpos6XWLcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoLObJgBgT6S4tRVcOS2cuKawEjm4fWtoUEGrFtBYX0w&oe=6AC10691"}, {"file_name": "screenshot_05_grading_results_2560x1440.png", "id": "1609920777180508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298387_1609920783847174_2266714768063639825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePYJaNQrF9wQ7kNvwGHJly_&_nc_oc=Adp0Y3Bk4HhLRRKhbFU0b8izcq_zNkJDECpJCXMBT1SNmWtGVmi_vrzAUY7hypTBWiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWdgq90F6UtPkXKmSt8SJJrvZScOGW5g8J9xh862QF3Q&oe=6AC12B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2009979386356170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_2009979389689503_8642166284990258277_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMt9sd3K4tIQ7kNvwGp6wg9&_nc_oc=AdpzC54_OAoMHdXJybXVsZD56XOFeM9X7QvhEWJDrroYALCMnoC0SNABmP7frc-2SJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDv-_rSV2ZN9XQl4dqluuXSCGmdaO538nzCNfcCWeLgA&oe=6AC11AEC"}, "display_name": "The Painter VR", "keywords": ["painting", "paint", "art", "drawing"], "long_description": "The Painter VR turns your Meta Quest into an art studio in the sky. No experience needed: pick up a brush and start painting.\n\nREAL TOOLS IN YOUR HANDS\nSeven tools, each with its own feel: round, detail, flat, large, filbert and fan brushes, plus a palette knife for thick paint. Load your brush from the paint wells, mix colours and watch the tip take on the colour you are carrying.\n\nTHE ART ACADEMY\n15 classes built around five subjects (ball, star, heart, crescent moon and cube), each in three levels: Basic, In Colour and Master. A reference picture sits beside your easel. When you are done, press GRADE MY PAINTING and get a score from 0 to 10 on shape, composition, colour, technique, creativity and effort, with tips on what to improve. Score above 5 to pass.\n\nPAINT LIKE THE MASTERS\nUnlock nine styles as you progress: pencil, charcoal, watercolour, classic oil, impasto inspired by Van Gogh, pointillism inspired by Seurat, impressionism inspired by Monet, Renaissance inspired by Da Vinci, and Rembrandt. Each one changes how your strokes look on the canvas.\n", "short_description": "Paint in a marble temple floating above the clouds. Pick up real-feeling brushes, load them with colour, mix on your palette and paint stroke by stroke. Take art classes, get your painting graded from 0 to 10 and unlock the styles of the great masters, from watercolour and charcoal to impasto and pointillism. Or switch to Free Paint: choose your canvas, save your work to finish another day, export it as an image and keep every piece in your personal library.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1122168723582563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313069_1093064246589522_3072221509402872129_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRImcEDmACIQ7kNvwHxWgI9&_nc_oc=AdpTX0SgXZQKxjPWJbk-0J1wUZm3bYnanp_j815F0o5F24SKAN4ug2gF7KCuDnTUoSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPagZ2l0hB8mHP4nYkPjz7PXJ2FeeRU6MLfFBG9KrxaDQ&oe=6AC10F08"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Painter VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": 
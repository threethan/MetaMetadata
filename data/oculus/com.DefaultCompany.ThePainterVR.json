masters, from watercolour and charcoal to impasto and pointillism. Or switch to Free Paint: choose your canvas, save your work to finish another day, export it as an image and keep every piece in your personal library.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1122168723582563"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1424296772934420"}]}, "baseline_offer": {"id": "1424296772934420"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789484520, "status": "PUBLISHED", "id": "1424296772934420"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1132387009227401", "version": "1.0"}, "id": "2937564343258225", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1122168720249230", "is_concept": false, "latest_released
tG5-Z_C2bemg4lhTjxZCWZ-UVAOSe8znU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVfWdYVm9AmAZGAwexUJV3LArJuXvtlnJSe6r1KBtk-g&oe=6B09D187"}, {"file_name": "screenshot_04_artist_styles_2560x1440.png", "id": "1743390740322997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296123_1743390743656330_5790578209015093013_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQkt5ZGGrpIQ7kNvwGZcyLH&_nc_oc=AdqY9g4RQeewCJA8PwcjptNqOdGudnwEbSg3leEf6MvWv0_hzN7xsHZJ4mJc2Nlna5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGML8KKPPJQCCwvGWgvTkTpI_85KQMHhgGR9Xv_rKNlw&oe=6B09C13D"}, {"file_name": "screenshot_01_main_menu_2560x1440.png", "id": "1646125106847296", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499298900_1646125110180629_3437702487713078848_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQKUWTfLdsoQ7kNvwH2QKFg&_nc_oc=AdoWj3gmJt8_CV5-FDAoX1PgYLMxWHFHtUxi3BHt64sGKbjwdQR0pAeOxRkQ2WwRpDc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYnjiqo3FuBOP0GgGKp2xbGI5BSIMzdG8dDZODBBaHlQ&oe=6B09C151"}, {"file_name": "screenshot_05_grading_results_2560x1440.png", "id": "1609920777180508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298387_1609920783847174_2266714768063639825_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC6lKfw4OwIQ7kNvwFWx22n&_nc_oc=Adp0FykH6-Q2Amxlp14sXB6Zj0Dwxs5XW3qbIghHUgDh8cPMn628LcqILFpb7SV3JCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFLib8Vq3NAUxzE0XzwloyZBw1u-h4h8XXACBrgzlUYA&oe=6B09ADCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2009979386356170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299715_2009979389689503_8642166284990258277_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH2FJx9dwFsQ7kNvwHLjgII&_nc_oc=AdrSvG1CLs6HDBuGUJ31FsNqt8FgKZPpzuSuogvNqBAipSTIfT46S_mXscxTmhUnDhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaxoYMkijs9gSYYWCQ-sloCjRu-LGbh_w9T-VQ02UuYw&oe=6B099D6C"}, "display_name": "The Painter VR", "keywords": ["painting", "paint", "art", "drawing"], "long_description": "The Painter VR turns your Meta Quest into an art studio in the sky. No experience needed: pick up a brush and start painting.\n\nREAL TOOLS IN YOUR HANDS\nSeven tools, each with its own feel: round, detail, flat, large, filbert and fan brushes, plus a palette knife for thick paint. Load your brush from the paint wells, mix colours and watch the tip take on the colour you are carrying.\n\nTHE ART ACADEMY\n15 classes built around five subjects (ball, star, heart, crescent moon and cube), each in three levels: Basic, In Colour and Master. A reference picture sits beside your easel. When you are done, press GRADE MY PAINTING and get a score from 0 to 10 on shape, composition, colour, technique, creativity and effort, with tips on what to improve. Score above 5 to pass.\n\nPAINT LIKE THE MASTERS\nUnlock nine styles as you progress: pencil, charcoal, watercolour, classic oil, impasto inspired by Van Gogh, pointillism inspired by Seurat, impressionism inspired by Monet, Renaissance inspired by Da Vinci, and Rembrandt. Each one changes how your strokes look on the canvas.\n", "short_description": "Paint in a marble temple floating above the clouds. Pick up real-feeling brushes, load them with colour, mix on your palette and paint stroke by stroke. Take art classes, get your painting graded from 0 to 10 and unlock the styles of the great masters, from watercolour and charcoal to impasto and pointillism. Or switch to Free Paint: choose your canvas, save your work to finish another day, export it as an image and keep every piece in your personal library.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "developer_terms_of
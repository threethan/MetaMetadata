c_sid=6e7a0a&_nc_ohc=E9uygJc7k3gQ7kNvwHbZtP2&_nc_oc=AdqynMuXcrhL4sirAzj4aRgtFq_w3X-bMxsYJl6CJMcowk7vA2rPftiKdRbM0inpDj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzGZcY_qty1q_0ncW9QPHsLPqmz74qgn6ZCr8VlEWhuQ&oe=6AC654D6"}]}, "id": "1358234449669096", "locale": "en_US", "screenshots": [{"file_name": "screenshot_02_reference_and_canvas_2560x1440.png", "id": "2491737811309620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302344_2491737817976286_6130620648145692978_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RsLObwS-IYQ7kNvwGMQlg3&_nc_oc=AdooGHrmRfU_6tLMIuJEQ1mqyfeuhMqofi9zovCqUg7deaFXnODo2Mb-tp_nwtIwOLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh1ivyzJEpfa7jS90SvOA48ROMkCWiao1NpuAu7LmAoA&oe=6AC65162"}, {"file_name": "screenshot_03_brush_strokes_2560x1440.png", "id": "1357391666377053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654867655_1357391669710386_1839392816663363473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWQMvFBCcuEQ7kNvwFaPK17&_nc_oc=AdpVo0WS4P_aH6-mGC5g-aafYyGo0Ej6OzOJFJuaXtmXa9pqtFP3YslWLYTqsepn0eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjd1mXMMPXOMetZ4EzE8zQ5lFcogbSZRqawDg7AXfiag&oe=6AC65CC7"}, {"file_name": "screenshot_04_artist_styles_2560x1440.png", "id": "1743390740322997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296123_1743390743656330_5790578209015093013_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yN-x94-g1vUQ7kNvwFPeLDn&_nc_oc=AdpGusvGcZR2r1yU_HMWcl_yOhTkbzJctPukgVNfmHBcnd8UgY0HilEQjNGmhDtNXJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJBHJDppJdthPF7JIMlyp3VV9bMsp2unrk-wr5kW4XEw&oe=6AC64C7D"}, {"file_name": "screenshot_01_main_menu_2560x1440.png", "id": "1646125106847296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298900_1646125110180629_3437702487713078848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iziq9hpQVhUQ7kNvwHiaaeD&_nc_oc=AdrvSqsDowsriGwvkLzxg70OWy3ADeTYn2TjK8R3wwttT71DGlOg1e1sdYlTbfkuJOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCISHu9s503VFaJ7yjZCyNlxrxRlaYcFMAP4Hti89JFQ&oe=6AC64C91"}, {"file_name": "screenshot_05_grading_results_2560x1440.png", "id": "1609920777180508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298387_1609920783847174_2266714768063639825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLqc1x7RJ3IQ7kNvwG8mlio&_nc_oc=Ado3eyXwIk3OYXM20RBt1Fv1lHH1KQ8z-WX2N15a9GYt9QWiS1dF8YHJXp52b3m7Qfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnP6mIvCKiA0ZtN4aC7sq6GxUH_1neGkG2lTlZPJ0QXA&oe=6AC6714A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2009979386356170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_2009979389689503_8642166284990258277_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVmLdHVK-JAQ7kNvwGvH09_&_nc_oc=AdrQ4CRvsaA9bfRBT9dnH4ewW3i_JW0hagE0fa6ghGMM6QXbRfWpo2mkyD_OY3XKzP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD81Jg73PB2F7OBAJ_3tzRe2iuRXwXqjzPzG1qDjh-jw&oe=6AC660EC"}, "display_name": "The Painter VR", "keywords": ["painting", "paint", "art", "drawing"], "long_description": "The Painter VR turns your Meta Quest into an art studio in the sky. No experience needed: pick up a brush and start painting.\n\nREAL TOOLS IN YOUR HANDS\nSeven tools, each with its own feel: round, detail, flat, large, filbert and fan brushes, plus a palette knife for thick paint. Load your brush from the paint wells, mix colours and watch the tip take on the colour you are carrying.\n\nTHE ART ACADEMY\n15 classes built around five subjects (ball, star, heart, crescent moon and cube), each in three levels: Basic, In Colour and Master. A reference picture sits beside your easel. When you are done, press GRADE MY PAINTING and get a score from 0 to 10 on shape, composition, colour, technique, creativity and effort, with tips on what to improve. Score above 5 to pass.\n\nPAINT LIKE THE MASTERS\nUnlock nine styles as you progress: pencil, charcoal, watercolour, classic oil, impasto inspired by Van Gogh, pointillism inspired by Seurat, impressionism inspired by Monet, Renaissance inspired by Da Vinci, and Rembrandt. Each one changes how your strokes look on the canvas.\n", "short_description": "Paint in a marble temple floating above the clouds. Pick up real-feeling brushes, load them with colour, mix on your palette and paint stroke by stroke. Take art classes, get your painting graded from 0 to 10 and unlock the styles of the great masters, from watercolour and charcoal to impasto and pointillism. Or switch to Free Paint: choose your canvas, save your work to finish another day, export it as an image and keep every piece in your personal library.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1122168723582563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313069_109306
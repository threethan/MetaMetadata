x1440.png", "id": "2491737811309620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302344_2491737817976286_6130620648145692978_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Skesf4V6Y5YQ7kNvwEHfoDU&_nc_oc=AdoC7-l4ud6zSEsKdITpIb28diWH4082gaSB3PUxYbOcuVdE8yI1GUP4h6Y7cuZpRss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2mJoWwTI2419dG4WR-_G1xOTsXg899yWR42tzIi_AdA&oe=6AAFE7E2"}, {"file_name": "screenshot_03_brush_strokes_2560x1440.png", "id": "1357391666377053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654867655_1357391669710386_1839392816663363473_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMzc-O9xJsMQ7kNvwERVRV-&_nc_oc=AdoQvVR0eyOm8q2uQuV4sTCfpYkd0wOF7k5thq5Jr4USb03UvGI1bQ0DTDHomSggLG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcfoYBAon1C0zHzdA86zOT-Kj6R4AlTZU_BwOwgrZLow&oe=6AAFF347"}, {"file_name": "screenshot_04_artist_styles_2560x1440.png", "id": "1743390740322997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296123_1743390743656330_5790578209015093013_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyqa-i4Hpu0Q7kNvwH3kp6r&_nc_oc=AdrE70zfuIG_Hoxh2GH93V2Sh-TmnjgxECkc7et0eqE5maPiYOi4wXel9GYkZ7Ew-4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIldkWGTcPaCG4HPDWUgYfUOakuHBrgUT1z4gfNsY_b7g&oe=6AAFE2FD"}, {"file_name": "screenshot_01_main_menu_2560x1440.png", "id": "1646125106847296", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298900_1646125110180629_3437702487713078848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--QPJUVo5-YQ7kNvwEc4Nf1&_nc_oc=Adp7QntgNKlu9ACrxWxaIHnfqZzoUsTDtkKx-4KDfzS679G56w9ziSyTOiRzjxA0Sis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILQbMRcWMldFEWgBdlkM3BXJvq_imflnVXYAU1qsb8JA&oe=6AAFE311"}, {"file_name": "screenshot_05_grading_results_2560x1440.png", "id": "1609920777180508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298387_1609920783847174_2266714768063639825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vpi3-cghLoQ7kNvwGQ7TZX&_nc_oc=Adphomk7kfR8BFh633YeXUaj5UzXLfYUVj9VSd_Uu0MtDJSsF0ZKcycYOnqRwl116dM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAVablgXGdIopSNYnYlxThR8cRZCsxmE929NpliUUr3g&oe=6AB007CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2009979386356170", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299715_2009979389689503_8642166284990258277_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1nMevrqax4Q7kNvwFC-doP&_nc_oc=AdrVYMT57sKhyEFKzhXKR0_GVX2SU09__TW2pQ3-g7VkqFYCPpLdeThikSye9Bbtlx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkaB04tOu7gWis2Tk83nVrWPimBXy6xdS-deKlyqV5Eg&oe=6AAFF76C"}, "display_name": "The Painter VR", "keywords": ["painting", "paint", "art", "drawing"], "long_description": "The Painter VR turns your Meta Quest into an art studio in the sky. No experience needed: pick up a brush and start painting.\n\nREAL TOOLS IN YOUR HANDS\nSeven tools, each with its own feel: round, detail, flat, large, filbert and fan brushes, plus a palette knife for thick paint. Load your brush from the paint wells, mix colours and watch the tip take on the colour you are carrying.\n\nTHE ART ACADEMY\n15 classes built around five subjects (ball, star, heart, crescent moon and cube), each in three levels: Basic, In Colour and Master. A reference picture sits beside your easel. When you are done, press GRADE MY PAINTING and get a score from 0 to 10 on shape, composition, colour, technique, creativity and effort, with tips on what to improve. Score above 5 to pass.\n\nPAINT LIKE THE MASTERS\nUnlock nine styles as you progress: pencil, charcoal, watercolour, classic oil, impasto inspired by Van Gogh, pointillism inspired by Seurat, impressionism inspired by Monet, Renaissance inspired by Da Vinci, and Rembrandt. Each one changes how your strokes look on the canvas.\n", "short_description": "Paint in a marble temple floating above the clouds. Pick up real-feeling brushes, load them with colour, mix on your palette and paint stroke by stroke. Take art classes, get your painting graded from 0 to 10 and unlock the styles of the great masters, from watercolour and charcoal to impasto and pointillism. Or switch to Free Paint: choose your canvas, save your work to finish another day, export it as an image and keep every piece in your personal library.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1122168723582563"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1424296772934420"}]}, "baseline_offer": {"id": "1424296772934420"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789484520, "status": "PUBLISHED", "id": "1424296772934420"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1132387009227401", "version": "1.0"}, "id": "2937564343258225", "channel_name": "LIVE"}]
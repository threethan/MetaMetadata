n.com/v/t64.5771-25/499296123_1743390743656330_5790578209015093013_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD2NtToBwREQ7kNvwHsiudA&_nc_oc=AdrsgZczT4TstLcCALJ2ZngEeyrfNI5eBisTab2_OVzO2e5KVp_td2jKviOUetNx_f4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5ZPUKzay0b1Be-ms-abhxDljmOVuZJAnmfuPHsDN-HQ&oe=6AEDD97D"}, {"file_name": "screenshot_01_main_menu_2560x1440.png", "id": "1646125106847296", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298900_1646125110180629_3437702487713078848_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34LdluO8CyYQ7kNvwGNkTHL&_nc_oc=AdqdzNlzAp-tvRNOrv85Rb8LO1AUGpv6HPiH6V_bJHbq-ipLyo4Lko-7AurjNPvPMQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxgclC7C1QXJrz_DEC2ldSXbBr7UInNUZkfpGah-JuUA&oe=6AEDD991"}, {"file_name": "screenshot_05_grading_results_2560x1440.png", "id": "1609920777180508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298387_1609920783847174_2266714768063639825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2zGR66QGR4Q7kNvwFjMsu2&_nc_oc=AdpFhHh2QGSefwSaeNJ3V08xZdt7M2rR1pxEVKRrjACL9VFDZI3Czh_Bw42CSQCGWGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ3ehtsvuRI4uMBRtYr4fhpBmZI2gCAF33XH108PEjPA&oe=6AEDFE4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2009979386356170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299715_2009979389689503_8642166284990258277_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8Fy7lm1OskQ7kNvwFvEybX&_nc_oc=AdoVbLMbAeVKG1KihNHRPsdBbfCFL3M3MaUHthrTDLTzWX7j68UK01d4XbbtT0WYQ-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8M0_dVCEDqBQGXWYytQUL8sSVAyrnZpzhHilDxM6Nkg&oe=6AEDEDEC"}, "display_name": "The Painter VR", "keywords": ["painting", "paint", "art", "drawing"], "long_description": "The Painter VR turns your Meta Quest into an art studio in the sky. No experience needed: pick up a brush and start painting.\n\nREAL TOOLS IN YOUR HANDS\nSeven tools, each with its own feel: round, detail, flat, large, filbert and fan brushes, plus a palette knife for thick paint. Load your brush from the paint wells, mix colours and watch the tip take on the colour you are carrying.\n\nTHE ART ACADEMY\n15 classes built around five subjects (ball, star, heart, crescent moon and cube), each in three levels: Basic, In Colour and Master. A reference picture sits beside your easel. When you are done, press GRADE MY PAINTING and get a score from 0 to 10 on shape, composition, colour, technique, creativity and effort, with tips on what to improve. Score above 5 to pass.\n\nPAINT LIKE THE MASTERS\nUnlock nine styles as you progress: pencil, charcoal, watercolour, classic oil, impasto inspired by Van Gogh, pointillism inspired by Seurat, impressionism inspired by Monet, Renaissance inspired by Da Vinci, and Rembrandt. Each one changes how your strokes look on the canvas.\n", "short_description": "Paint in a marble temple floating above the clouds. Pick up real-feeling brushes, load them with colour, mix on your palette and paint stroke by stroke. Take art classes, get your painting graded from 0 to 10 and unlock the styles of the great masters, from watercolour and charcoal to impasto and pointillism. Or switch to Free Paint: choose your canvas, save your work to finish another day, export it as an image and keep every piece in your personal library.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/code/artifact/66569cd9-f94f-4752-84b1-109dea15ddbb", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488
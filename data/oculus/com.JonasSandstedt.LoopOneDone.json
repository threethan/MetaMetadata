=6B0F1EC3"}, {"file_name": "piano.png", "id": "3822591398026140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361350_3822591401359473_4221482193755278134_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DaNtS7hSIcQ7kNvwHJtXnC&_nc_oc=AdpzIPcibXJJpYQV_tj_sjeBMCBVY8yGYgCf_SjJfRitmGbPlicUepc6sOEN7mmW_TE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWcoCYrM86JfTdp_MRqTZlVUOYRcWKGOp9ZvilmK1krjQ&oe=6B0F017E"}, {"file_name": "dog.png", "id": "1584453452279763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031378_1584453455613096_5705078858865949796_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DPqR9oiYYQ7kNvwFDwUDY&_nc_oc=Adpzu_ETqGHQ_3RLb6vuanBUhwciWlj3M_oqhvL0NrNkv3cvzyWazQk2ToPdoNyWXjM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUBqpN_OnyMtgR8Uob9ZHNEriY9bp2W-YBY26A6sd435g&oe=6B0F14BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560 x 1440.png", "id": "1671720933612392", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974448_1671720936945725_3144006406961749223_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUAAxJgLG0AQ7kNvwE_iboY&_nc_oc=AdoGcAZEng0y_n4cOS17xkMd_LJP1zdrGiePd5UI_jtkJDHZxDNyPylcPMwo4p5Uo_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsCT6ClbZs-7tnwS6HDXQUqBQlNzSIDv-pDfuEPcTLoA&oe=6B0EFAE3"}, "display_name": "Loop One: Done", "keywords": ["Automation", "Factory", "Strategy", "Building", "Loop"], "long_description": "**Loop One: Done is a mixed reality automation game where you record loops with drones and robots, turning your play space into an efficient automated factory. Or just make a big mess, it's up to you.**\n\n\ud83d\udd26 Scan your place to find resources\n\n\ud83e\udea8 Place buildings to mine materials\n\n\ud83c\udfed Build factories to convert materials to better and better products\n\n\u267e\ufe0f Record loops using drones and industrial robots to move materials between to automate your factory.\n\nThe game is build for hand-tracking first (but controllers are supported) and room scale mixed reality. You can build up to a thousand buildings in your place space.\n\n# \u267e\ufe0f1\ufe0f\u20e3\u2705\n# Just one. More. Loop.\n", "short_description": "Loop One: Done is a mixed reality automation game where you record loops with drones and robots, turning your play space into an efficient automated factory. Or just make a big mess, it's up to you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://LoopOneDone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jonas Sandstedt", "support_website_url": "https://LoopOneDone.com/faq", "website_url": "https://LoopOneDone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7997634820352503"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PENDING", "id": "29611091581829408"}, {"status": "PUBLISHED", "id": "1489089436054672"}, {"status": "CANCELLED", "id": "2773206686428523"}, {"status": "PUBLISHED", "id": "3610683145753079"}, {"status": "PUBLISHED", "id": "2367604117317118"}, {"status": "PUBLISHED", "id": "2099740870921792"}, {"status": "PUBLISHED", "id": "1924045588295301"}, {"status": "PUBLISHED", "id": "2119642389433779"}, {"status": "PUBLISHED", "id": "95569497
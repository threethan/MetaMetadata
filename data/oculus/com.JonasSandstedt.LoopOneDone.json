eenshots": [{"file_name": "L1D - VR Screenshot - View from the balcony.png", "id": "1462943272325464", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1462943275658797_1927711348748694580_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb_NZoSijWEQ7kNvwFPHiWb&_nc_oc=AdpS7SvPRF9064MvRuiGx4jXx4-4tI-YhfbtMGIevgktOBY-SKMy0sZofbkDlRCwtuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORYu0qrqKj6eUSBv33yz_v2wgfjpJVlmvsRMtXsgY9Jw&oe=6AE495A4"}, {"file_name": "recording-with-controller.png", "id": "672836931851984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393223_672836938518650_3675110409319311716_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gOXgEdCHQMQ7kNvwGmKI0p&_nc_oc=AdowXCfwzhwIlXT0rfqrYNFJKOg-SFzts3Vyw7I2Z0FxZx6Qe18JbLFHCW_kvvBiCC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi8ec54M2lvaj-zKTyo_I9J9J0J7dv4lzaAFOX-4uUXw&oe=6AE4AC81"}, {"file_name": "large-factory.png", "id": "575798702156915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391812_575798705490248_1537399833648658311_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm42O0u_eAIQ7kNvwGaD3RW&_nc_oc=AdoLaPBuKA4yW2pgBRI02KREWNT7tmHH6PQSKecdXEQQ5Wju4sHOn9W_hNbZSzgwBLs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHfHMmQyGQCUJ6bVoi5jOT0dOwQ9GULsRSfMFs7P2VtA&oe=6AE4C091"}, {"file_name": "Screenshot from trailer - conveyor belts adn robots.png", "id": "793827410055392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830822_793827413388725_8947246314947900964_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L747mfyagtwQ7kNvwFK0DNN&_nc_oc=Ado4ALXsvwtdm11kaZpKT56Wf8bb7M1CGQtFqIyP5s1Wy1Vwo7lhGulcIGbD0XufmGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFTX2vGteKeoMu2AwllJvRNqg9oQzl2GQUyq-uBQzhXg&oe=6AE4BF99"}, {"file_name": "com.JonasSandstedt.LoopOneDone-20260312-213953_1440.png", "id": "2340852463102320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_2340852466435653_8195707566995933580_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dVxWAoSOfMQ7kNvwFjtEnP&_nc_oc=AdonLlGP4kH4wYtTlUXMlemaSlt3uPUNa6WJhMrKekVmUUiWIy5LMXvvwGTwHgdfpZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6m1kjMqnsKUD5ieMXZui1-eJpJV7vuLPJIHJAwjbYvQ&oe=6AE4B5C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560 x 1440.png", "id": "4482845695261825", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828008_4482845698595158_1289128034086505093_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNOvlSXQ66sQ7kNvwHIMvYm&_nc_oc=Ado3uXav8Ag95QrCJL5SFhGDQwUDYADcL4f-4hGc3f1S3mV58momBFkT9hJy7ICulYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfYoof1KrFxaJ4Xd6CpRPC3xyRLvKEpiOTGEVZcfryWg&oe=6AE4896E"}, "display_name": "Loop One: Done", "keywords": ["Automation", "Factory", "Building", "Clones"], "long_description": "# Bring a tiny industrial world to life with your own hands\n\nStart with a handful of machines and grow them into a massive industrial empire that fills your room.\n\n\ud83e\udea8 Mine and transport resources\n\n\ud83c\udfed Build production chains to create increasingly valuable products\n\n\ud83e\udd16 Record loops with drones and industrial robots to create an automated workforce\n\n\ud83d\udcc8 Expand, optimize, and scale your factory\n\n\ud83c\udfe0 Play in different VR environments, or mixed reality to transform your real room into an industrial playground\n\n{1499755068415488}\n\nEvery conveyor belt, machine, and robot you create brings your factory one step closer to total automation.\n\nSell products to earn money and research new materials, unlocking more advanced facilities and production lines. Grow from simple resource extraction to a sprawling automated operation capable of constructing an entire server tower, one floor at a time.\n\n{1028801989058974}\n\n# Both Mixed Reality and VR support\nBuild on top of furniture, place virtual tables, or sit down and play in VR in this physics playground.\n\n{1112541567111304}\n\n# Features\n\n\ud83c\udfaf 2h+ campaign mode\n\n\u267e\ufe0f Freeplay and infinite sandbox mode\n\n\ud83c\udfed20 facilities (and growing)\n\n\u23fa\ufe0f 3 recordable items (drones, industrial robots)\n\n\ud83d\udcbe Extensive save system with multiple save slots\n\n\u2194\ufe0f Scaling options to play in all kinds of rooms\n\n\ud83c\udfae Physics-driven gameplay - infinite solutions - very fun!\n\n\ud83d\udd78\ufe0f Play how you like: Options such as grid mode or free placement\n\n ... + much more\n\n**Experimental features:**\n\n- Level Builder\n- Weekly Challenges\n\n\n**Build with \ud83d\udc9c by Jonas Sandstedt**\n{1371660027192271}", "short_description": "Turn your home into an automated factory. Mine resources, build production lines, and record drones to create an automated workforce. Expand your operation, unlock new technologies, and grow a small workshop into a sprawling industrial empire in Mixed Reality or VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://LoopOneDone.com/privacy-policy", "developer_terms_of_service_url": "https://LoopOneDone.com/terms/", "publisher_name": "Ojsan Studio", "support_website_url": "https://LoopOneDone.com/faq", "website_url": "https://LoopOneDone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "SITTI
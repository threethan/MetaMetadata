ay_name": "Loop One: Done", "keywords": ["Automation", "Factory", "Strategy", "Building", "Loop"], "long_description": "**Loop One: Done is a mixed reality automation game where you record loops with drones and robots, turning your play space into an efficient automated factory. Or just make a big mess, it's up to you.**\n\n\ud83d\udd26 Scan your place to find resources\n\n\ud83e\udea8 Place buildings to mine materials\n\n\ud83c\udfed Build factories to convert materials to better and better products\n\n\u267e\ufe0f Record loops using drones and industrial robots to move materials between to automate your factory.\n\nThe game is build for hand-tracking first (but controllers are supported) and room scale mixed reality. You can build up to a thousand buildings in your place space.\n\n# \u267e\ufe0f1\ufe0f\u20e3\u2705\n# Just one. More. Loop.\n", "short_description": "Loop One: Done is a mixed reality automation game where you record loops with drones and robots, turning your play space into an efficient automated factory. Or just make a big mess, it's up to you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://LoopOneDone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jonas Sandstedt", "support_website_url": "https://LoopOneDone.com/faq", "website_url": "https://LoopOneDone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [
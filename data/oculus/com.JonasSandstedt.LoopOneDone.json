7&_nc_sid=6e7a0a&_nc_ohc=mYfJazIiwPEQ7kNvwFCK6xm&_nc_oc=Adpc8w_1tjasBSLUTPBDbVxjU5TZA6jSVrw15RD_jNd73hPDuFJy4Wv_vtGFp14mkVY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQf3PZothxINgZdJd9545QJ9Avz8HoG4znlwRtAse5yA&oe=6A8449D9"}, {"file_name": "com.JonasSandstedt.LoopOneDone-20260312-213953_1440.png", "id": "2340852463102320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_2340852466435653_8195707566995933580_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgPo9knImZAQ7kNvwEUQZme&_nc_oc=AdrzOei2PyQaGXfFFWQXNTNoPSJK21fKBaf_wQeEvIYcGpfgOGdY0hu3QuyOWiBN5Eo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcmC3uMZ39k98TZt0LwwOjdCNcWAFKK79BKgeykywAOg&oe=6A844007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560 x 1440.png", "id": "1804924773856275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825305_1804924777189608_8514379283107533368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1UgwgWxCmoQ7kNvwFymwwU&_nc_oc=AdoBvMzGQsKi8PI9jB6jZ6vgp3e1jLUaxBUlkt2KdqiXiwd0GgS1WPBjfHnKxMB3mj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA606I_O_7aOfwytU5PrRjChSlX3KmXGYgcnG0pjSYgg&oe=6A84327F"}, "display_name": "Loop One: Done", "keywords": ["Automation", "Factory", "Building", "Clones"], "long_description": "# Turn Your Home Into an Automated Factory\n\nStart with a handful of machines and grow them into a massive industrial empire that fills your room.\n\n\ud83e\udea8 Mine and transport resources\n\n\ud83c\udfed Build production chains to create increasingly valuable products\n\n\ud83e\udd16 Record loops with drones and industrial robots to create an automated workforce\n\n\ud83d\udcc8 Expand, optimize, and scale your factory\n\n\ud83c\udfe0 Play in mixed reality and transform your real room into an industrial playground\n\n{1499755068415488}\n\nEvery conveyor belt, machine, and worker you create brings your factory one step closer to total automation.\n\nSell products to earn money and research new materials, unlocking more advanced facilities and production lines. Grow from simple resource extraction to a sprawling automated operation capable of constructing an entire server tower, one floor at a time.\n\n{1028801989058974}\n\n# Just one. More. Loop.\nBuild on top of furniture, place virtual tables, or get comfy and sit down on your floor to play in this physics playground.\n\n{1112541567111304}\n\n# Record loops - automate your factory\n\n**Features**\n\n\ud83c\udfaf 2h+ campaign mode\n\n\u267e\ufe0f Freeplay and infinite sandbox mode\n\n\ud83c\udfed18 facilities (and growing)\n\n\u23fa\ufe0f 3 recordable items (drones and industrial robots)\n\n\ud83d\udcbe Extensive save system with restore tools if your playspace has been removed or changed.\n\n\u2194\ufe0f Scaling options to play in all kind of rooms\n\n\ud83c\udfae Physics-driven gameplay - infinite solutions - very fun!\n\n\ud83d\udd78\ufe0f Play how you like: Options such as grid mode or free placement\n\n**Experimental features:**\n\n- VR mode\n- Level Builder\n- Weekly Challenges\n\n\n**Build with \ud83d\udc9c by Jonas Sandstedt**\n{1371660027192271}", "short_description": "Turn your home into an automated factory. Mine resources, build production lines, and record drones to create an automated workforce. Expand your operation, unlock new technologies, and grow a small workshop into a sprawling industrial empire in Mixed Reality or VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://LoopOneDone.com/privacy-policy", "developer_terms_of_service_url": "https://LoopOneDone.com/terms/", "publisher_name": "Ojsan Studio", "support_website_url": "https://LoopOneDone.com/faq", "website_url": "https://LoopOneDone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "27562
Y3ulpFzlnFE-EvmgaRukgWaZgBk-NmdDNKcJL1l66Q&oe=69B954BE"}, {"file_name": "dog.png", "id": "1584453452279763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031378_1584453455613096_5705078858865949796_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgv1jsXFeI0Q7kNvwEfvW3R&_nc_oc=AdnCSapQwpUW-OO0uMr4DegI-1kDu50EyeSp55sMDIM5W5mDzl5s2H39NiSfk_5KMtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyfy2lyZHupzvMEQYWwYcCgv1YLjColtmkeembOEijqLg&oe=69B92FBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560 x 1440.png", "id": "1671720933612392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974448_1671720936945725_3144006406961749223_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY8zbxY_7D8Q7kNvwFegIwu&_nc_oc=Adl2EhQTKvtWvygJBXdUfeXkDSl5eEJIjyxaHuAWoPgpgRWEiFaniq1y9ALA5tGXts0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyLGDaoBNk8tq9DtNvUaIrGxb5-Hg3wDpz6TYyeGTiKrA&oe=69B94E23"}, "display_name": "Loop One: Done", "keywords": ["Automation", "Factory", "Strategy", "Building", "Loop"], "long_description": "**Loop One: Done is a mixed reality automation game where you record loops with drones and robots, turning your play space into an efficient automated factory. Or just make a big mess, it's up to you.**\n\n\ud83d\udd26 Scan your place to find resources\n\n\ud83e\udea8 Place buildings to mine materials\n\n\ud83c\udfed Build factories to convert materials to better and better products\n\n\u267e\ufe0f Record loops using drones and industrial robots to move materials between to automate your factory.\n\nThe game is build for hand-tracking first (but controllers are supported) and room scale mixed reality. You can build up to a thousand buildings in your place space.\n\n# \u267e\ufe0f1\ufe0f\u20e3\u2705\n# Just one. More. Loop.\n", "short_description": "Loop One: Done is a mixed reality automation game where you record loops with drones and robots, turning your play space into an efficient automated factory. Or just make a big mess, it's up to you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://LoopOneDone.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jonas Sandstedt", "support_website_url": "https://LoopOneDone.com/faq", "website_url": "https://LoopOneDone.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7997634820352503"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "955694977025723"}, {"status": "PUBLISHED", "id": "1443061324023336"}, {"status": "PUBLISHED", "id": "1856608758387606"}, {"status": "PUBLISHED", "id": "1944380136412504"}, {"status": "PUBLISHED", "id": "594120606988311"}, {"status": "PUBLISHED", "id": "568044449322573"}, {"status": "PUBLISHED", "id": "1815366925909254"}]}, "baseline_offer": {"id": "1815366925909254"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "955694977025723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25570224709333576", "version": "0.16.4"}, "id": "1020207089762766", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "A
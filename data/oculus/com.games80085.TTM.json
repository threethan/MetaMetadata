nt-sjc3-1.oculuscdn.com/v/t64.5771-25/39001677_896791361373065_5271694090724842962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-nz-C7-ry0Q7kNvwE3pmA7&_nc_oc=AdqOPSZgHjjZlCAYJSXNvLIkAYYLHZYfPT58WVxml88nFE1oodfpx297WvFPqqMYwg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdEfCwQ_45ng2Bwr_kaTvAXizVhSX4UEyDzWsZiLzYFA&oe=6A62226C"}, {"file_name": "2.png", "id": "3288350821416797", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_3288350824750130_1443495177599960513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-6OHLnPD0UQ7kNvwFrQO8X&_nc_oc=Adonml4T2g2JP5ENpN-3yImb9b0zaxGBL9x0MghNrN8GoiHmNFtVgP-dQUQyNjTUQkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyOuhmgJKxycIWu1VyvAnniwymJCQRadbjydl8Ih_clA&oe=6A62211A"}, {"file_name": "5.png", "id": "768444071282433", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036655_768444077949099_5711881110635611330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAIE-rglBR8Q7kNvwHtTewA&_nc_oc=AdonCSEq0-KUsW2hgvAhWs00_KHuQLMU9ZCbKf6ONQc46Qj44SOCEMA2F_QeA5GIfd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyPgIA2Uju7jubRVnPxuZUmGs46jOL8x15H_-Vl6yb3g&oe=6A62133E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "957388478599418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363518_957388481932751_7457519152663864609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IcdjQXYSQkQ7kNvwH-zG0-&_nc_oc=AdoN5ECRza7LF59go6GdxQlaXHnOa4X9VfolAoE8pAAdM0xKWZaJanMhwuOGSQU-BDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnYvnUtebgQPT3bm8YZelSEChYzU4wXTHYm5D69QPzjg&oe=6A6218B2"}, "display_name": "Touch to Match", "keywords": [], "long_description": "Introducing \"Touch to match\" \u2013 a hilariously addictive VR game that combines the excitement of a match-3 puzzle with the whimsy of a tiny farming simulator. Get ready to embark on a journey through vibrant dream worlds and experience a range of delightful challenges, all at the tip of your fingers!\nIn the match-3 puzzle part of the game, you'll find yourself surrounded by an array of colorful cubes. Swipe, slide, and connect cubes of the same color to form lines and make them disappear, earning you valuable reward points. As you progress through the levels, the puzzles become increasingly challenging, putting your skills and strategic thinking to the test.\nBut that's not all! When you need a break from the mind-bending puzzles, step into the immersive farming simulator. Grow beautiful trees, tend to them with care, and watch as they bear delicious fruits. Harvest your bountiful produce and use them to cook mouthwatering dishes. Once you've indulged in a delectable meal, unleash a mighty burp to collect special reward coins!\nSay goodbye to clunky controllers \u2013 this game supports hand tracking, allowing you to interact with the virtual world using just your hands. Feel the thrill as you dive into the game world with Pass Through mode, seamlessly blending the virtual and real environments.\nAnd let's not forget about our adorable doughnut-shaped cat companion!", "short_description": "Swipe cubes, grow trees, burp with money. Enjoy it! It's a dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D3Lvw7-UApe0BCPURkQIm7uGHxyMSiOG/edit?usp=share_link&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://80085.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "re
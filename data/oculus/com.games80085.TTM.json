nt-sea1-1.oculuscdn.com/v/t64.5771-25/39001677_896791361373065_5271694090724842962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtOCJ1NKBGIQ7kNvwHDZGdb&_nc_oc=AdpThi0hWGW0-i9t8h_UR_SgO58eDdo_CeGusINxqQNlruaFZ1t7YnzOthxz2egISGE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRDYOXh7ngaDqnbgUSYNdGRuPaqIceBTMeYA4kmsMxfw&oe=6AB6826C"}, {"file_name": "2.png", "id": "3288350821416797", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974819_3288350824750130_1443495177599960513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVrg3Fxd8xIQ7kNvwE9hQGA&_nc_oc=AdpEXFkSyC5SWWo4RpNtbFO6ahU8EyKWV7ktJTzlKbJG7au3Ia_GlwHkQ57tnZKQqyg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNrzPVL8Chys-REqCTfc4Fj0HOayuC7fPdWkAKnSfktQ&oe=6AB6811A"}, {"file_name": "5.png", "id": "768444071282433", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036655_768444077949099_5711881110635611330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n17tkoGt9sQ7kNvwGog-Gt&_nc_oc=AdqqFi9gijMtwA9B99y7hsHcqTNntYMh0x42e1RamjURozU05gVInAtCiOjY3ivT5LE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMG4xgiiJfj1m0dZaY1BVHbRmYDw77o-IO2wbsD1qO7A&oe=6AB6733E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "957388478599418", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75363518_957388481932751_7457519152663864609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8wIc3JPELEQ7kNvwHQ7VdZ&_nc_oc=Adq3oPwNR4fGEdi87x5LW2Amau8oyXumr9BUoQyQcKhS94iS8NwC6HlcpHkR6EIdVBA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoOG1BEWg1zM4bIJyCg6pO35jjgEdxf3t3vNBkAUHadw&oe=6AB678B2"}, "display_name": "Touch to Match", "keywords": [], "long_description": "Introducing \"Touch to match\" \u2013 a hilariously addictive VR game that combines the excitement of a match-3 puzzle with the whimsy of a tiny farming simulator. Get ready to embark on a journey through vibrant dream worlds and experience a range of delightful challenges, all at the tip of your fingers!\nIn the match-3 puzzle part of the game, you'll find yourself surrounded by an array of colorful cubes. Swipe, slide, and connect cubes of the same color to form lines and make them disappear, earning you valuable reward points. As you progress through the levels, the puzzles become increasingly challenging, putting your skills and strategic thinking to the test.\nBut that's not all! When you need a break from the mind-bending puzzles, step into the immersive farming simulator. Grow beautiful trees, tend to them with care, and watch as they bear delicious fruits. Harvest your bountiful produce and use them to cook mouthwatering dishes. Once you've indulged in a delectable meal, unleash a mighty burp to collect special reward coins!\nSay goodbye to clunky controllers \u2013 this game supports hand tracking, allowing you to interact with the virtual world using just your hands. Feel the thrill as you dive into the game world with Pass Through mode, seamlessly blending the virtual and real environments.\nAnd let's not forget about our adorable doughnut-shaped cat companion!", "short_description": "Swipe cubes, grow trees, burp with money. Enjoy it! It's a dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D3Lvw7-UApe0BCPURkQIm7uGHxyMSiOG/edit?usp=share_link&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://80085.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "re
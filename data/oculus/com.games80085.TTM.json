https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001677_896791361373065_5271694090724842962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMnVzPGTvngQ7kNvwFsDbEl&_nc_oc=AdpPScoS1Ul6evcUGDKi4YUREQNMFMU1sz0WggprnKz4U1vLB-i-fMAYIJcEFKhrd_Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7ZS_Ti0AF6c2bgT9fh5BhkumIdj4fxYUIXwmlYpYelg&oe=6A8582AC"}, {"file_name": "2.png", "id": "3288350821416797", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974819_3288350824750130_1443495177599960513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUq45GF8-swQ7kNvwHmfiae&_nc_oc=AdqKFIW60RksbhkuYtkrJ2vi72V6EotfXfCUE3w0Z3jUPOTRbfFfkuJpC1lorSsGVus&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExezujeuaGOTvPdOyNBZRarorA20btNJpf5P-5wrFkeg&oe=6A85815A"}, {"file_name": "5.png", "id": "768444071282433", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036655_768444077949099_5711881110635611330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZOG3ttcDfYQ7kNvwFsVs__&_nc_oc=AdqYI1BB9XD1mNvLzWejGMWYs0l8rCg76eKEvEmX3OOPBETxyqVczuGUytieLxu6HdE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU8Wh1CjzjAagPOh6bf9u3G2Y-noDRWH23igu-2lbwMA&oe=6A85ABBE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "957388478599418", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75363518_957388481932751_7457519152663864609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddBb6Yo5od8Q7kNvwFpFfK4&_nc_oc=AdpEHiViXNTQTQXeZU1rKf6EdPptKAAhWsZ-rMwVviYh20tKnEp8PXPyKtWGOrdb9fY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbHJOnR6gMHbofSRtwY-sy_ZRK6_vN-tvd4xykOHt9fA&oe=6A85B132"}, "display_name": "Touch to Match", "keywords": [], "long_description": "Introducing \"Touch to match\" \u2013 a hilariously addictive VR game that combines the excitement of a match-3 puzzle with the whimsy of a tiny farming simulator. Get ready to embark on a journey through vibrant dream worlds and experience a range of delightful challenges, all at the tip of your fingers!\nIn the match-3 puzzle part of the game, you'll find yourself surrounded by an array of colorful cubes. Swipe, slide, and connect cubes of the same color to form lines and make them disappear, earning you valuable reward points. As you progress through the levels, the puzzles become increasingly challenging, putting your skills and strategic thinking to the test.\nBut that's not all! When you need a break from the mind-bending puzzles, step into the immersive farming simulator. Grow beautiful trees, tend to them with care, and watch as they bear delicious fruits. Harvest your bountiful produce and use them to cook mouthwatering dishes. Once you've indulged in a delectable meal, unleash a mighty burp to collect special reward coins!\nSay goodbye to clunky controllers \u2013 this game supports hand tracking, allowing you to interact with the virtual world using just your hands. Feel the thrill as you dive into the game world with Pass Through mode, seamlessly blending the virtual and real environments.\nAnd let's not forget about our adorable doughnut-shaped cat companion!", "short_description": "Swipe cubes, grow trees, burp with money. Enjoy it! It's a dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D3Lvw7-UApe0BCPURkQIm7uGHxyMSiOG/edit?usp=share_link&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://80085.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_are
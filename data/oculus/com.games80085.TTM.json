nt-fra5-2.oculuscdn.com/v/t64.5771-25/39001677_896791361373065_5271694090724842962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC7U3Y3LreQQ7kNvwFQHRCn&_nc_oc=Adr7r4j0vVnX0uh1Gc_lCEgPwNXGPR3k-Q0Ves_Fo_w3ubtuJ7_KSGOmvGtDasaCTB4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5-HSbISt4iqiYjw4lugnZ7PJ3iGuQ5n7V3zUsiJIrHQ&oe=6A5644EC"}, {"file_name": "2.png", "id": "3288350821416797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974819_3288350824750130_1443495177599960513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZrcDQ_x2EYQ7kNvwH4DS6X&_nc_oc=AdrP9Vi_-M7qBTeij8KWMFgZn_WSpTouQzz4RWK1GX5SPXdK4DpDpEIsimYc1x5VZek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCoA0DRoQ7DFDXy5hdtvOfbkK5Yv0mma-E_r_2_wBuRA&oe=6A56439A"}, {"file_name": "5.png", "id": "768444071282433", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39036655_768444077949099_5711881110635611330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EOx60uuEMoQ7kNvwGixJ8S&_nc_oc=AdoPZFVLr4TK51Lc4-CnNkZKCBIx_AucOkBTC76g7F6sQYm5RZh9_HTFeFmaVr-eb1s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbWyI62aJJCsNHttRaEnETmzPMfY686SCrMsEwIdxXYA&oe=6A5635BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "957388478599418", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75363518_957388481932751_7457519152663864609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZiOXmkr7rgQ7kNvwEz0Xty&_nc_oc=AdpsQW7k6n19_klLEnjANAoWJ7di-F1NDHEkfI_gtfLgwyeyICGvFNOD7bvuCTJX_64&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnID7Sba-FJFg4P06FfM8wkoO6BV0_sN6nibTGhOpLVg&oe=6A563B32"}, "display_name": "Touch to Match", "keywords": [], "long_description": "Introducing \"Touch to match\" \u2013 a hilariously addictive VR game that combines the excitement of a match-3 puzzle with the whimsy of a tiny farming simulator. Get ready to embark on a journey through vibrant dream worlds and experience a range of delightful challenges, all at the tip of your fingers!\nIn the match-3 puzzle part of the game, you'll find yourself surrounded by an array of colorful cubes. Swipe, slide, and connect cubes of the same color to form lines and make them disappear, earning you valuable reward points. As you progress through the levels, the puzzles become increasingly challenging, putting your skills and strategic thinking to the test.\nBut that's not all! When you need a break from the mind-bending puzzles, step into the immersive farming simulator. Grow beautiful trees, tend to them with care, and watch as they bear delicious fruits. Harvest your bountiful produce and use them to cook mouthwatering dishes. Once you've indulged in a delectable meal, unleash a mighty burp to collect special reward coins!\nSay goodbye to clunky controllers \u2013 this game supports hand tracking, allowing you to interact with the virtual world using just your hands. Feel the thrill as you dive into the game world with Pass Through mode, seamlessly blending the virtual and real environments.\nAnd let's not forget about our adorable doughnut-shaped cat companion!", "short_description": "Swipe cubes, grow trees, burp with money. Enjoy it! It's a dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D3Lvw7-UApe0BCPURkQIm7uGHxyMSiOG/edit?usp=share_link&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://80085.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "re
nt-lga3-3.oculuscdn.com/v/t64.5771-25/39001677_896791361373065_5271694090724842962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13i-GtnbvVIQ7kNvwF7uLM-&_nc_oc=Adon9lnDKwX50xjE02gCCeD8dtYdeVNhniHyVKxcCeofj7iyM2VDnaGAifFVfV7aHyY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SThHpxgJ3BxJSnO9-Xe9tD33XpzRZ_L0V8wvDoIxfxA&oe=6A13086C"}, {"file_name": "2.png", "id": "3288350821416797", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974819_3288350824750130_1443495177599960513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnVQj7gbCscQ7kNvwGCfGm8&_nc_oc=Adq5CRyibIWIHtAffKoo2Km2tpx9WZzNBeOMnFxO3aHNrHO99xf1Eaq4tLKPAaWSVhI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vwMcmdUBwjXqaW5UEZMb_RPRwIOT-As_qibSaE7VyQg&oe=6A13071A"}, {"file_name": "5.png", "id": "768444071282433", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036655_768444077949099_5711881110635611330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwxQ_yECKygQ7kNvwEHeov0&_nc_oc=AdrlZn7qLnSqca7M0xv9MX9k8WeQO35caPSKbT8gjHVKLvKATJKuXu4vXeMWfg-Flx4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GLJfTqlLgEjFu8Dzae0nk-GG3XGlgJORhsmGSSkfQ5w&oe=6A12F93E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "957388478599418", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75363518_957388481932751_7457519152663864609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EyAS4_5Ph0Q7kNvwGDM2cM&_nc_oc=AdraYwAG6DJKvOl0vSlFCCp9w2AIQzH_8v4pLDrUrzCul36c9PcD2v0j9ArcJCrN7K4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H6ToOU4kkZx3uJJ1NfXczPESUFtxNFlf2JaTXgkYyLw&oe=6A12FEB2"}, "display_name": "Touch to Match", "keywords": [], "long_description": "Introducing \"Touch to match\" \u2013 a hilariously addictive VR game that combines the excitement of a match-3 puzzle with the whimsy of a tiny farming simulator. Get ready to embark on a journey through vibrant dream worlds and experience a range of delightful challenges, all at the tip of your fingers!\nIn the match-3 puzzle part of the game, you'll find yourself surrounded by an array of colorful cubes. Swipe, slide, and connect cubes of the same color to form lines and make them disappear, earning you valuable reward points. As you progress through the levels, the puzzles become increasingly challenging, putting your skills and strategic thinking to the test.\nBut that's not all! When you need a break from the mind-bending puzzles, step into the immersive farming simulator. Grow beautiful trees, tend to them with care, and watch as they bear delicious fruits. Harvest your bountiful produce and use them to cook mouthwatering dishes. Once you've indulged in a delectable meal, unleash a mighty burp to collect special reward coins!\nSay goodbye to clunky controllers \u2013 this game supports hand tracking, allowing you to interact with the virtual world using just your hands. Feel the thrill as you dive into the game world with Pass Through mode, seamlessly blending the virtual and real environments.\nAnd let's not forget about our adorable doughnut-shaped cat companion!", "short_description": "Swipe cubes, grow trees, burp with money. Enjoy it! It's a dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D3Lvw7-UApe0BCPURkQIm7uGHxyMSiOG/edit?usp=share_link&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://80085.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "re
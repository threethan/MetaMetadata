//scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001677_896791361373065_5271694090724842962_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIxkAjMK2QoQ7kNvwExWwPg&_nc_oc=Ado7voWGPysgwOO9V7TZSoUl6YkGz__weqFWdDBpPTWfqi0DwtYym2Nk5iWkZVX_VCc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QtXXPO1dNrBLpDQT2-NWe_C8SHDNpwiv1cjCtwgGgmg&oe=6A4672EC"}, {"file_name": "2.png", "id": "3288350821416797", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974819_3288350824750130_1443495177599960513_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeqUFgBbaqgQ7kNvwEVQpqj&_nc_oc=AdrdNCgKfxugAKU5v57eKH9cFt7bfrL4TbTuOabBoe3OzS-Vq-erg7bnrNDbAVyVgyU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kUKdS8G0A7jm8Czp6fNz7cir-DaV4zP20A6EMzNKzLA&oe=6A46719A"}, {"file_name": "5.png", "id": "768444071282433", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39036655_768444077949099_5711881110635611330_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR8PguTqVOAQ7kNvwEVwcTp&_nc_oc=AdqTvYD_3ena_TqRhz0p7UqTyfS0fdJFZKyeA4AazUcP2a_8ZE9JWwEEZy3AAAtENDg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J5OKVP_cfBDEaS8XAaTO0S7w7nodlTtLyMQCtwdJ3gA&oe=6A4663BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5.png", "id": "957388478599418", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75363518_957388481932751_7457519152663864609_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaBFfRvcr-QQ7kNvwFWYw1z&_nc_oc=AdpwRoHkAjflRXl3QWEiqy0dljNI8h0qd7ka10B5Q_4d9JM9Lkfh4dDM91s10j2eptM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DzQQs5nVAmwnLGWEQF6djqqoLcjbLOLSAxvf6w2KY7g&oe=6A466932"}, "display_name": "Touch to Match", "keywords": [], "long_description": "Introducing \"Touch to match\" \u2013 a hilariously addictive VR game that combines the excitement of a match-3 puzzle with the whimsy of a tiny farming simulator. Get ready to embark on a journey through vibrant dream worlds and experience a range of delightful challenges, all at the tip of your fingers!\nIn the match-3 puzzle part of the game, you'll find yourself surrounded by an array of colorful cubes. Swipe, slide, and connect cubes of the same color to form lines and make them disappear, earning you valuable reward points. As you progress through the levels, the puzzles become increasingly challenging, putting your skills and strategic thinking to the test.\nBut that's not all! When you need a break from the mind-bending puzzles, step into the immersive farming simulator. Grow beautiful trees, tend to them with care, and watch as they bear delicious fruits. Harvest your bountiful produce and use them to cook mouthwatering dishes. Once you've indulged in a delectable meal, unleash a mighty burp to collect special reward coins!\nSay goodbye to clunky controllers \u2013 this game supports hand tracking, allowing you to interact with the virtual world using just your hands. Feel the thrill as you dive into the game world with Pass Through mode, seamlessly blending the virtual and real environments.\nAnd let's not forget about our adorable doughnut-shaped cat companion!", "short_description": "Swipe cubes, grow trees, burp with money. Enjoy it! It's a dream!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D3Lvw7-UApe0BCPURkQIm7uGHxyMSiOG/edit?usp=share_link&ouid=113519274073964453991&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "self", "support_website_url": null, "website_url": "https://80085.games/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVE
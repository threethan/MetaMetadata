EZq2LO&_nc_oc=AdoZKvSygmrMSt16068wnYKYSgOj6dxxucW0VcBINRC43hgEJaqwPeIFOtviyFRekT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlfu5WP6YcKvTwmz-IC3lVsy5irkRasFFso9p-AbV-fQ&oe=6AE6066C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s1.png", "id": "1374921558184846", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628909_1374921561518179_939622408425140561_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhOus_qt-B0Q7kNvwFmbF86&_nc_oc=AdpJeZlCgVaM2RXhMZdbW_cVC_09DIjh9biW-3KnmxW9Uv8sHlzJW9_y9m3XeCjCXs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTM5R2VZf-n6qebobQ0aztbOyWCnX99hYi7WokL3fjcA&oe=6AE5FFF5"}, "display_name": "Sky Boxing", "keywords": ["boxing", "tennis", "fitness", "workout", "relaxing"], "long_description": "SKY BOXING is a penthouse at three hundred metres, and everything in it is yours to use.\n\nTHE GLASS GYM\nWalk through the sliding doors and the balcony closes in around you - a glass box cantilevered off the side of the tower, with a freestanding heavy bag in the middle of it. The gloves go on by themselves the moment you are outside. Punch the green GO button on the wall and a round starts: sixty, ninety, a hundred and twenty or a hundred and eighty seconds. The board behind the bag counts your punches, reads the speed of the last one in miles per hour, and remembers the best round you have ever thrown.\n\nTHE COURT\nBack inside, the lounge is a full practice court. Take one of the two rackets off the wall and the ball machine on the far baseline starts feeding. Speed, feed rate and how many balls are live are all on the panel beside the rackets, and there is bullet time on the controller when you want to watch one arrive.\n\nFIVE SKIES\nThe pedestal by the glass changes the world outside: sunset, daylight, dawn, emerald and neon dusk. Traffic runs past the window at every hour - race pods, lux pods, drone swarms and a ninety-six metre sky liner.\n\nCOMFORT\nSmooth walking with forty-five degree snap turn. No teleport, no forced movement, no enemies, and no way to fail. Music plays throughout and can be changed or switched off from the menu.", "short_description": "Three hundred metres up, behind one unbroken wall of glass. Step out onto a glazed balcony and work a heavy bag over the skyline, or take a racket off the wall and play the practice court in the lounge. Five skies, switched whenever you like. Nothing hits back, and there is no way to lose - just the view, and something to hit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sky-boxing.pages.dev/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://sky-boxing.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1230943050111668"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1620914256347936"}, {"status": "PUBLISHED", "id": "2107638920143952"}]}, "baseline_offer": {"id": "1620914256347936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792201080, "status": "PUBLISHED", "id": "1620914256347936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1231094593429847", "version": "0.3.0"}, "id": "1114305737696400", "channel_name
Qdr5NYR0EQ7kNvwFlYZbn&_nc_oc=AdprVGKE-8CQZwdQbiVAFwmcKT17ZwhaL-f0Bsxj2cthPo5txHZMXh07bqP4O50YrDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtYiH4qvq-IwBEAIKSH1fI2BWCVDNl16LdZK7Puz-Qng&oe=6ACFABCF"}, {"file_name": "s5.png", "id": "1697314348005669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628893_1697314351339002_1184421649847436840_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e05129-PDCUQ7kNvwHyjTGg&_nc_oc=AdqVF2aKmwWsUzCQX0FKTMGFj1CQe9s1NcLpyc0KPDNveVZuHfP4k4oKdWlYCd0a_lU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLswhZXMpBjr3KVXRF05uMPH8b-QGw967Prv75QmV2dw&oe=6ACFA4C4"}, {"file_name": "s2.png", "id": "1735583401029739", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619382_1735583404363072_3602796868728156495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANi4yuTNHAAQ7kNvwGq0obf&_nc_oc=Adr6RWu-UxrjQ-v0_0nwMxuenWf8k19rmCH6Z3rrmwdX5HXUXBqGqs_X9vwZfJpdauM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeZoNkcALB_Cy7ETDz83uyVmShlLT4DOF46WALtMpiGw&oe=6ACF8558"}, {"file_name": "s3.png", "id": "1795693001788835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622162_1795693005122168_4351799412709978565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL1r0B_uCw0Q7kNvwEqrCoT&_nc_oc=AdrdUj4uqBDELEcEplqizDkxnZ5Coamc_LG0SufwownGJn3uw6X1TuHckky5i3lBodM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNzFimR-bmH9RHdi1gCbbFjm5GnNoU_Q2mb4XG58cxaA&oe=6ACF8E54"}, {"file_name": "s4.png", "id": "4651705118485477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622184_4651705121818810_5881752279464022952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1HwNZtgQTMQ7kNvwGpx7Z1&_nc_oc=AdpaZit_mKzxzjjWYS2hGTFDWXklGFI0_HIDIKQ0lWIT5BJLVnvkRwG_E4ngZ37DYXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcB5SUDfomRUb19KSy6quW11i9AtQcBleOb4CDNVxR7A&oe=6ACF9CEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s1.png", "id": "1374921558184846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628909_1374921561518179_939622408425140561_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCRVmcXdZg4Q7kNvwHmJc3w&_nc_oc=AdrRMV0Rv_2Bp8tK5dWAadc2t4cb7Lm65X--4Xva8KP9QHUUCHY0UNTdl2CL31JchFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA35fEr2D399ge4bF-Wo4yjemzDVquS4DFoZAO1Em76g&oe=6ACF9675"}, "display_name": "Sky Boxing", "keywords": ["boxing", "tennis", "fitness", "workout", "relaxing"], "long_description": "SKY BOXING is a penthouse at three hundred metres, and everything in it is yours to use.\n\nTHE GLASS GYM\nWalk through the sliding doors and the balcony closes in around you - a glass box cantilevered off the side of the tower, with a freestanding heavy bag in the middle of it. The gloves go on by themselves the moment you are outside. Punch the green GO button on the wall and a round starts: sixty, ninety, a hundred and twenty or a hundred and eighty seconds. The board behind the bag counts your punches, reads the speed of the last one in miles per hour, and remembers the best round you have ever thrown.\n\nTHE COURT\nBack inside, the lounge is a full practice court. Take one of the two rackets off the wall and the ball machine on the far baseline starts feeding. Speed, feed rate and how many balls are live are all on the panel beside the rackets, and there is bullet time on the controller when you want to watch one arrive.\n\nFIVE SKIES\nThe pedestal by the glass changes the world outside: sunset, daylight, dawn, emerald and neon dusk. Traffic runs past the window at every hour - race pods, lux pods, drone swarms and a ninety-six metre sky liner.\n\nCOMFORT\nSmooth walking with forty-five degree snap turn. No teleport, no forced movement, no enemies, and no way to fail. Music plays throughout and can be changed or switched off from the menu.", "short_description": "Three hundred metres up, behind one unbroken wall of glass. Step out onto a glazed balcony and work a heavy bag over the skyline, or take a racket off the wall and play the practice court in the lounge. Five skies, switched whenever you like. Nothing hits back, and there is no way to lose - just the view, and something to hit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sky-boxing.pages.dev/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://sky-boxing.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1230943050111668"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622192_2038536090854333_2893076761270562038_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvo2XwZOBDYQ7kNvwG5pmqi&_nc_oc=Adr2f9UtOAljTrYtrcl0_eRaNvvqPnKGjscYumeXl2L97h1MmLty9RyCeI0xxywPQeA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuPuvFPKyKGTzlGFMDBzDyAkHWQ2XJ1IXw225uXChdKw&oe=6ACFAE11"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sky Boxing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1789300740, "lastRevision": {"nodes": [{"id
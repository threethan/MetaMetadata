1795693001788835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622162_1795693005122168_4351799412709978565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrpXcE368oUQ7kNvwFh7Q0W&_nc_oc=AdrAes5PUuVKPuw9dseBz6CqzljM-qddRmxGxtiHhTglv69VHycFHFodK8H5cCx7fpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2Bo7DGu6vLzp3mD5aQZTUwO_CioaidoFVrQfNbI65Ew&oe=6AEF3254"}, {"file_name": "s4.png", "id": "4651705118485477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622184_4651705121818810_5881752279464022952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmyTDqRSn5YQ7kNvwH_3VyH&_nc_oc=AdpjDs_ttlKwNwQwDj_xj6SYgWsinak5NQ5cGSJ1wc4mvfgrxC_iyL4RmaTuxFCmpr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwvPZ0UfCox2HeTe6505J9R18UF0KMmRJDTYIim_otlw&oe=6AEF40EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s1.png", "id": "1374921558184846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628909_1374921561518179_939622408425140561_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFGrChV7HusQ7kNvwEHYH31&_nc_oc=Adq9hPLKMBXUNzWhs1kgXJXTuswYuEJvzr7XyCmGI37xMDv7nTaqzHRYEa6OnrxioQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX-wYmr5uN85qV6rkBU5t8JzJYipe0oDt9E30SQ7t33g&oe=6AEF3A75"}, "display_name": "Sky Boxing", "keywords": ["boxing", "tennis", "fitness", "workout", "relaxing"], "long_description": "SKY BOXING is a penthouse at three hundred metres, and everything in it is yours to use.\n\nTHE GLASS GYM\nWalk through the sliding doors and the balcony closes in around you - a glass box cantilevered off the side of the tower, with a freestanding heavy bag in the middle of it. The gloves go on by themselves the moment you are outside. Punch the green GO button on the wall and a round starts: sixty, ninety, a hundred and twenty or a hundred and eighty seconds. The board behind the bag counts your punches, reads the speed of the last one in miles per hour, and remembers the best round you have ever thrown.\n\nTHE COURT\nBack inside, the lounge is a full practice court. Take one of the two rackets off the wall and the ball machine on the far baseline starts feeding. Speed, feed rate and how many balls are live are all on the panel beside the rackets, and there is bullet time on the controller when you want to watch one arrive.\n\nFIVE SKIES\nThe pedestal by the glass changes the world outside: sunset, daylight, dawn, emerald and neon dusk. Traffic runs past the window at every hour - race pods, lux pods, drone swarms and a ninety-six metre sky liner.\n\nCOMFORT\nSmooth walking with forty-five degree snap turn. No teleport, no forced movement, no enemies, and no way to fail. Music plays throughout and can be changed or switched off from the menu.", "short_description": "Three hundred metres up, behind one unbroken wall of glass. Step out onto a glazed balcony and work a heavy bag over the skyline, or take a racket off the wall and play the practice court in the lounge. Five skies, switched whenever you like. Nothing hits back, and there is no way to lose - just the view, and something to hit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sky-boxing.pages.dev/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://sky-boxing.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supporte
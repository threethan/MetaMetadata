5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRWEGVSm9CsQ7kNvwEtPJUh&_nc_oc=Adoix-HpypKM8HeSYdChzyVigKzqJ1-pOu9RePL_GQ3BtUJPvnjNT5OcgkGJZKV80QE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYzL8V6uzfl6ojCbimYCphsBA4RVlNSaz2MgpUKWc7ng&oe=6A50F127"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkQKESmf0eQQ7kNvwE-RT0k&_nc_oc=AdqmLRos6h__qKo_duE6a02VaZ-0L2CZ5V3f6H4F3p_kmE4HsmdTVNZLDvRSC3z6Adc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxZ6Y1JezlmWmHp1Mdf0J5JC8sZ6MV4tzU265L6dpWzA&oe=6A50FCD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mBDtf6ngHsQ7kNvwFO9opg&_nc_oc=AdqeTj-93GoRIrkroho1gGQDrKQX5YozQmfUqymJaXLLNHPWDXI62_kMi-jer9agRAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPQ-gqpa_055ym9cQ1V3Z_TUAjAm2-BpDd4LC0_egrfQ&oe=6A511624"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
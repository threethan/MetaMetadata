5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRzJ3vyAeLEQ7kNvwHk_OUF&_nc_oc=AdqK-G6KEKczmwzYFWt00_rx9kkGo0vLnAFK6i3pNLJOyHx6dF6xbyHxnIbaycgBjpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3yJso_fCXnqWtgqr1OeFYiU_bWrjBcFVV8_4QLFj2pw&oe=6ACD1667"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouUOe-34Q4cQ7kNvwElXYnq&_nc_oc=Adp1sqn5RAcMwGHbhxDo5jKBLJY21GdNjkS9U9WHOHrrIleUVckIFfWTHVpfEhTgaYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgOnQS5rnwdzVRbOlRNe3yztu5GcE6iLascpzjPHRobw&oe=6ACCE9D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zCUrxbpSDEQ7kNvwH3jTvA&_nc_oc=AdrMSJXmiVMXvTOC4MQZYl2O-byalFIBQ3AwfCQAznRIDCOrCiP9ehTRur_rO0e92io&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-I2r3HwCYeIz0tdV-JsG91gqxqUimjcMz4XjyTywL7Q&oe=6ACD0324"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
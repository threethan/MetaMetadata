5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JYlR0zr4g4Q7kNvwGhRnxS&_nc_oc=AdqwjwGKHzKUMUesT7RONBtXZLsJwwE-sMVQeYArArVaf0YTY0S2aYvZevU3cjZRVpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHES9Ax1RcQEMu2HNQtZsLj1_uEf-4gAFsCRFPmu_d12g&oe=6A95B767"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IckF0YKhcZMQ7kNvwGa0_wn&_nc_oc=AdoYexdcQa8JWD5yBSazkxSZQxcIjGL8ApORodthh7DGpJMpJV8gFHB1N0nwxB32On4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8N48F2Yj0GImwFnY6zwnNSUcLHaohZjc4XQT5NZx7ng&oe=6A95C310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ6NcGB7iwIQ7kNvwG74Q_R&_nc_oc=Adpe3v8C10qTM55EpFyulixROJM7fqMZpiX1UZCB_-BU0NtRJQwpuMkQ7a99Ggvh48s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq3J1SCanJCF22chYQClAxoROQj1pGADyUGi7M491crg&oe=6A95DC64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
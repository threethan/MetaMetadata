5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbEJeuBpeKAQ7kNvwH-gOhm&_nc_oc=AdqHKWYPK6uT5Q1YRjL7JyXxbhjFA5lwI6AJbCVMfX2p236XbCCNMU4uj-jkCaLZdTQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFQdX1uiIpXHUzruOYEulRiL7rZ6fm2YCkKQMxkf6FPg&oe=6AA15CA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_KjH-fUo-sQ7kNvwF2ZjAS&_nc_oc=Adr0PmGitT0oU7xmOAGLu8KTShTv0OvmknPMUoWVJcYgMJc3oqNrGYKda_tqnCpDwrs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcmU6xpd16CD4GWktFJriA7raeYxrZkpZwAFGKoa8nyw&oe=6AA16850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5PB1TSx5RUQ7kNvwFz_rkj&_nc_oc=Adpg7FpS7LOasyyLESwI3K45guuZZmDTfObzmvzLqxUoglTYJlZhyJlZ-1aWw7Hv27o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhJZGKw3uL9t-AGws1sLUaOxi4aprXBmH5O1VLTd_Bng&oe=6AA14964"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
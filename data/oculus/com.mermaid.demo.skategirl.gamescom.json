93357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y34ROcBw9ZIQ7kNvwGBK68O&_nc_oc=AdrBzIYfIxETsdCVU3tjL0Hnz36GgKE-BFG5DADLnLUMXrDUWMuutPG_NQeFJiaCe88&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gS5tMko56oagq5F9dOsea6_qNHLAzns03e5cHRRpG6A&oe=6A466527"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxXTozwBKlIQ7kNvwF-IZ0f&_nc_oc=AdrZIpRjjZ-Lq_BlE5JCcsGWGChHe6nTbmW6xZmYXyfyyTDZxVmbgYcITzJjKctdDsE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q9v81K82eYKydAW7m9sNblfptEjsDEZCOOXKXVa6kgg&oe=6A4670D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi5rF9FSPKIQ7kNvwEcu6zT&_nc_oc=AdqvFUhsGXtJhjD0KGhFeky4XihEgX1GKWTUTs6mxT4_sRaSsseBqeyJJpEe1Lk6Kew&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wt-DBAfsmrgFI62y8GH_cOyshdSD1ZD5VRLJb8ARJQg&oe=6A468A24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This ti
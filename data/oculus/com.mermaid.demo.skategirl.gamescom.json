5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5TzVBRqrsMQ7kNvwEshOhf&_nc_oc=Adqv5tP5xuqD7UUEdGooPjzh46NNEut2BhPnhMlJIOl0joIQiofvG7wD98G2qXo4-44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FZN8vMXTHkRFmCPaW8OJuOM7in3ZwQMWi00UnSoo03Q&oe=6A3FCDA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRjHAAkoskkQ7kNvwHHj6xz&_nc_oc=AdrB4N75mTsbKhHWOBNBj-QdgTHMclglWYfs6RmDS8qC0viBrsv1kc4NWMVPThVkM_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-JqNH_8Tn15ZjWZgxDSwN0_0UlKHkL_HYhfTXaOwk2g&oe=6A3FD950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjUxwsVAqvEQ7kNvwF82yNa&_nc_oc=AdrghwHx_drpMW6eiYZqmf3175GR1DgoFXpwXZ9ZZIFk8CCh0cofTUZvB7mAXlfbBro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cB17pqvCi9M-ESaUc9zwM7hu5UKY2yWL7ovOD7edzxQ&oe=6A3FF2A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
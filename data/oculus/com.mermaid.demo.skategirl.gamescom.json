5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMqUqy1JejIQ7kNvwG8b6lp&_nc_oc=AdpMc0fOkl7pV5uejqfZBhRcFkKlPSsBFbw5VewM14W8e2wTaj5eFH0I4-iBcdQoh5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiLLsAEt3oNSA1K8zlVIE5ihBqwm7ZljthM97zw7S07g&oe=6AC100A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrOYpdlrNNcQ7kNvwGs2I1Y&_nc_oc=AdqsIP6p7mcrZwyBJKMYk7N9HzECvPvA8I7fyv8qqcqqD9ijwL8gSupUgtO0G0aWUXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3YEb1pjate0clf7LBLd2RDTXsfgj2P9ZlwqK4RApR3A&oe=6AC10C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sk0x8QwJVP8Q7kNvwE9hlXP&_nc_oc=AdrnIB4cJVaMONQb5_oTwYH6Uo48yV5XXDb2nIGfQR1WZq8dEDFVOPrb79qdb7g7cQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORA2t6Qi4WB8-4OXSrn3COE8elHSZtdMnR_Yr8IhqKyg&oe=6AC125A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
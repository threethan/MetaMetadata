5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqpbiwJ_JzwQ7kNvwHhTj54&_nc_oc=AdrIz1AHujoWrKu3Yzqy-LXB9rO8kd5XTy4Hl5b1SpWt0VKGpqPhPA5ai6BG3CyqfcU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U7uW7GkVgtK0zjRWMmhZnnG4um37FHVp84imXLEtrsw&oe=69E23327"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt3uEGGmzdsQ7kNvwFyE-7P&_nc_oc=AdpWZDy78wwnZhRv6q0XHAOhEw4ltAEhWmjsaCnRe7PXhTtEL3UJL6Y2noK2vyNj2Jw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qy5zsY_KW0T-u280OqLziBlva2an4RI5OCVLCPBL7lA&oe=69E23ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIcJavvLRCMQ7kNvwGrgwL-&_nc_oc=AdqgRBaf2Isy4-yVu-ChkJBa15ZiBQwDW60RoTH71vNXf6qhMSBgPk0wV0uIpVFPpKo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39cHuNIaNnTfzollQlxgIXAIN49sCqVnCPLfCdX3ATxw&oe=69E21FE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
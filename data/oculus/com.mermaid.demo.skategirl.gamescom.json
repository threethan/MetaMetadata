gEp6cNxfS4PB36N0ggjuaEw0lRxjTJVxm-5AaV0d7ItYtmmbcU86zisUBcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjZabE-9HOSpT3pHNvMfw3Xr4gZRZQQFhtli1ahP5_LQ&oe=69A83127"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=246b9BdRpYYQ7kNvwHXuLJN&_nc_oc=AdkJztfQ57tCjKC-NepC_pRBoJxBO4X6Bars1b4a_nLRebrxxc_rDBIwLmeQW7SSGT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftF0TKjoTbabfTvffVakz8lO9aZEtwuF5_TULOXhrjXYg&oe=69A83CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UMWPeYQY0cQ7kNvwG7isYz&_nc_oc=AdkeNN_lXjq3ybeyundAADUKYJ4Jc_CSqDczlGO7kk2crFcE6_tJDhov1q46aZ3Durw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsktnW9jWM3RWu-5NYtthxSPj6Jvi86kSWg7e1O6bMdNA&oe=69A81DE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_pri
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y34ROcBw9ZIQ7kNvwEjTQz9&_nc_oc=AdpccbEwZ5Xhf_Iz3cs-lfqILO4wjn0IT-dRShBfk8BCJhAJHPUY1ZC4KPOdkp3mjQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCU1uo-N4Q9E2o1zSnDsDDsq1-ZsFfXM0z8oiyuYFbiA&oe=6A490827"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDlazwgTX7AQ7kNvwExbUjC&_nc_oc=AdpvZbcFOvxBa3ua3Kv0puO7BAQJNObuWB0OTZaJMVnSSOaZbzQ4svi_rIU7IVp2geg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAr2mhcg62dPOFjM4D8J89JxaEjFEKbX9G7Oyff9BMcVA&oe=6A4913D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi5rF9FSPKIQ7kNvwGVbxG4&_nc_oc=AdpuPQR9rHFNYBk5RvwADQygSvygJvBEZpLLAfhqS-mAHYY4rbK2dj1W7GdEWzEG5Hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZBpZjWtOUqRrRasQsiBET_rjUT_iJtzB9sA0RLiSzDQ&oe=6A492D24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
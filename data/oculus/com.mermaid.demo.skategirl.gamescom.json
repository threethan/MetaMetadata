5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo34Oktp-RAQ7kNvwE4qf0z&_nc_oc=AdpQDmJ-mst_W4wY2GLbldQkhF8ZNH7nQ9TJLje3VFNU71Q0TwnqH43HDRkwKtl97oA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5_0kyVOl0kQjy2eZZ09ZSqaXOJyUyRdCajt0fvldA8w&oe=69CA7827"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5_wC7uJg80Q7kNvwHZvn8r&_nc_oc=AdofBiANDTTFpDGGAGj1rMGeIoNhYbG8wByHJCaTzRm2oDNWKJRuJziYN9zWsXp1RtA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDVjrgDEn1Kcfahw3lzg6th6jeLQ4GojA0JUKP44nSWA&oe=69CA83D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYOPZyLOzsgQ7kNvwFCFhmh&_nc_oc=AdpQzZUVcAsotZjzgo4sgfwzYX7K3Aun45e9Dsj3k9H9ZE3Tai5gpQk8SpzB3h4_iAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybnSJp5kPEAlmLXW0Hux5akp5WviaGFsvX_20SsCh_7A&oe=69CA64E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
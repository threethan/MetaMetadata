5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERLHQ9Po_ooQ7kNvwE7XJWs&_nc_oc=AdpxyMwggy9ms-nOzszE13PVb02rrR89Fjz3DRrx1ouY0G6p5FOzfztWDjMydLU4CWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ3Ta4XGQw3PpIOVs9cYemN6GVs_bZDQyc1hu5WxmpIQ&oe=6AB674A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYhiRaNTDK8Q7kNvwGAYztT&_nc_oc=AdoDHIW7un7JM7yNJfUDgttuf5_IeK6pMkLfmReQ4NCi9mhMauXRxHnp5W38qTq0DVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5zj1DK54XU6gP2n7IvU2vczFlvUIgRMVmuV0MWTBNWw&oe=6AB68050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94620hnpSyUQ7kNvwE7AKUn&_nc_oc=Adoq4jWU39bnbu-0o1EmGZ5-62rbvOMGoWIMIkwEPEwLf98QK06TwSIEnnOk-UfIgdA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYTuN6c8cmqkoNEYUJRf3_tRSGKZI8JLFxcJqdZgMGlQ&oe=6AB699A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
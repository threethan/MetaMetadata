93357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrJw79YataIQ7kNvwFYrXuP&_nc_oc=Adp0znPk2lpDyJbb8UzSxJA2esO1gpbegfIqrKKou_EjmLU_j2k_9_Wit7RG8SlNQrA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gXRovIXw6UdhRahAKUuHZGViATJNsp5KocBMF36IY8Q&oe=6A369327"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlpgInc4OYoQ7kNvwGNIyNC&_nc_oc=Adr6Ozm3zef2gGftG0M_34HOc-sCOGd0LjedkKPeC_jw7Gy4HECFb5OS1VjAMTK1zIo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gVSJx4GMztDCluC4EoSdXxRNWR3yldB_i5lf5A264JA&oe=6A369ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm5ylaPGrAUQ7kNvwHUeMmY&_nc_oc=AdrdXIhTeV4DKwRP2gfka9nOAiSh--RZFKs-6BlIj8-SoOtDYauAd3unlW_AVE-deiY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92EefF9w0y0PszPatnIu_U5IR4MeMSZ-RfS-y2efg_Gw&oe=6A36B824"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This ti
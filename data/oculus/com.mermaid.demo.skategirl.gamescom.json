5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9wUc0i8YUAQ7kNvwGvQ-e0&_nc_oc=Adq8Ic7O9yDMjJNeJ6VRk47FbHgqvM69PEA4F93s4FaBZGCMwdjL9_TMq8pNTW5pTwM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87FdqcqJAsEGvKdLsHFvnk9dw014_KRgmuGr5MH6raEw&oe=6A2FFBA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMz80OXCkiYQ7kNvwFNI6sA&_nc_oc=AdqAa__mKwKQYN7ZCu6RtBvYoHad7ci4c3tQc5_sLArSjNhnD_qgsiTfJABChQht92g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M2Z1o77aWm1p2afSFNPCsYggBblVGOG7Nw28whDInQA&oe=6A300750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zShgn5WvLnIQ7kNvwE8oE6V&_nc_oc=AdoCQMkjIOp4FLgZOIcuRJTczGyvgBI_DPk-fKIXtD89Rke0kSnKgnWOxsUrExDVuAc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4CfjRJOXGk27X32wCmGbt0WRc6rgQgPErtqW8frQEaw&oe=6A3020A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
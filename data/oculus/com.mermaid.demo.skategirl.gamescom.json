5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB7npaWyM-cQ7kNvwFnVve8&_nc_oc=AdqFfeVvZNuhihDGKEIb7-sCkI-hA3O9qdydhJg8BcPOGyUW2W1Cx8hrR5ykgazJUhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAoHdMMRPB8aebv4bj58NQ1U6Q_n7jr-7AUNbiLk3c5g&oe=6ACB8CA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouUOe-34Q4cQ7kNvwECKX7U&_nc_oc=AdpHeXCe8FdGuTLsD-JszLEgRyK34MlhrIiKPrzBDzOAkLMCm5GiOhnGXn_hZb8Cxe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl0NNJBmM2YRlw09RdK8MDOnMzGmXBfVPvbBgjBr5g9g&oe=6ACB9850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDDMgwjazHQQ7kNvwGx58Jg&_nc_oc=AdrlVsftjMRKYwyFv4hLX0bYOaU6UjZz3Zq6ktHRJvYtF8FY6zOvCTNwoGVchaHxSCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu-FRIL7-scm-zfVigCO0E0hR5ScGsAsmUoAhN6wojbQ&oe=6ACBB1A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
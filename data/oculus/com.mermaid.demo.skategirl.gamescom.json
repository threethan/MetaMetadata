5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySxBy07uJGkQ7kNvwH1djg_&_nc_oc=AdpORwEoE3Bta0fjDdd2aOVDCnpPvFOO6xKjjE-9DJ4XPZmfiUs6OSdEOp22_pMNY-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMyrS_zTXP_QoE_kxsvETBOa-AWbCRddY44w3vVA5FvA&oe=6ADE01A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrGe5fVYXqIQ7kNvwEplD3T&_nc_oc=AdqbvQvSE8d8pJonCrfZrnngW9pf0i1B1Yuzj-iiDT1CozJ4-dWuaRknSGax_iEfsnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyuVIA01PsMCJ30Q0sgQqd4PxAsUxnaSqjIU2xfKPh7Q&oe=6ADE0D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Viri8wS9VSsQ7kNvwHkShUV&_nc_oc=Adq_CUz9Z24w1Wkl8tu73hBIm5HvdpZByuy4V_jZnQXHO_EarcwEQO-xM6bE-HDKDhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGZEyfrO-imcWXPiXGYjseRLYTlOZ5N84eQelUyn_r9Q&oe=6ADE26A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
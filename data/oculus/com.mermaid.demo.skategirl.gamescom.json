5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EarNCOUX1QQ7kNvwG-RDjl&_nc_oc=AdppU1pFJwkFjleAblpSsw5Dgn2mAQN5mBQBXxQHyGlj2g_2r6It-ghYK6U7YdGaUd0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WYnLDLr29b8UgrxbnoIv1FgC2GBl7F0n1z4quPSdMdQ&oe=6A12FAA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJWrjkbUCQcQ7kNvwE2m8nB&_nc_oc=Adq7qX8Dx0j4pARSvo6uo7W8Pgj_U1YdhISgbE6yRQKYhWfOu8vP7HaCj_slpUVwAkk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lF19LW9ciuQh5dGV-D1-AKNkG8Bw5LTNHKwuGY_SPWA&oe=6A130650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZYzPIswTKYQ7kNvwET1mrU&_nc_oc=AdpX4HP4fIN4nmXolXqcznFvZDPbNbfZhmrFzo--LZCyyztVxZgNoOB993fOWrphBgI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5365iT0UTILzC80lWItnzN9ye9yTvxOCVNIiLKRxoX5Q&oe=6A131FA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
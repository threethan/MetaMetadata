5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrJw79YataIQ7kNvwF0pJDH&_nc_oc=AdpTzaFzhdakG1NbRYgJfPalZICu3tuwNMSmIWZYbju8z1YHzzFaFdeAbxNTUQVFIPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9juw6lXbMVSrz4YtDikUuUDgcthusZQCv0ngFNMMIIww&oe=6A37E4A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlpgInc4OYoQ7kNvwF9M9FX&_nc_oc=AdqbV1RzU-CojVfyiXFznQQTk-QFdATIfeppz0Rx10jhyXkNX_0MehjyH41plBFwdpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83Zb-KR94eUVazHZsXD0rkrFv_QkOH0YZR3mvzSl0Xaw&oe=6A37F050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm5ylaPGrAUQ7kNvwHpJ8eb&_nc_oc=AdrWCrmPGMdKCL1L0ozkM4uozf4tb2BBWCLJ_NuyZRgmkIm_Ya6kpbAYdfa-jNolUT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OuJECR3v5L_qIpAn0cAOFGS4nI-hSupyDjHcfxzR63Q&oe=6A3809A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
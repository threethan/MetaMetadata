5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-JDaZCQ858Q7kNvwE9Y0Y3&_nc_oc=Adquzt4ASvFOQxrw6N0kKl0afb38IaIHIXG5ZjjZ7Q822pbh9fXWVlzcvxIxDmIPuQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Jx4fpORaUdLAlmnp4E5_ACBJuFpUrtI9Fqu5yONEuA&oe=6A2D58A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMz80OXCkiYQ7kNvwGWR6xr&_nc_oc=AdoGlnTQllqKuDSw1pliUEudUjBo9wvbE8QjUr0Q9MDi9PSPqGA1ev60zmFmsPZqK6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NXqoeLFpBOIIAD4kteG8ZZUVCf07ikoNRZQk0ZsoIMw&oe=6A2D6450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An4jTJiuY30Q7kNvwFQpCJH&_nc_oc=AdqNueu2n1_cSTO1Ke3JWVA9k6OMTyIGIS_0d9MMHikXofZkkfToHk-sngzWUdsFjnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eT_THUj5fkQZFOfmRcj6KKHB6TLIkT9oJO_NY98DlKw&oe=6A2D7DA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
a0FpcWHnVXwWy_PHs62TLCZn31NspU4ZKSkskPv2tmPW-VTO2XWRLtZlawQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfycRmCLxYOtm_-PVYSQYUSXyGSDnwEUU66FnAwInOMggw&oe=69AD7727"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhYy_U6ovrIQ7kNvwH_cWV1&_nc_oc=AdkTaHANDCvjWEWA5RHPG5IRIBILC8WuFKptfrGh_N12FfuhqW2yM9gPGyxZnNk4KHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwR1O5-65YZ64PUcIoBKPVaFQlXAulOsFWkPWtaoXrag&oe=69AD82D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D3LrRELHaMQ7kNvwGFsPlo&_nc_oc=AdkcixMi2ttGEWfhfTj3qwT5sthHeilwqeL5MydTNrqQqruRpHpWe0Mdd4Mk6k5gO9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJlbvjS22Z8pQXY0WyZe6ru3Z_Q4DxJCD9Rjag1OM0fw&oe=69AD63E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_pri
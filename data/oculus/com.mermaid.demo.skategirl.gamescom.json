5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q35N_O7p8KsQ7kNvwFxwfvE&_nc_oc=AdoHtmDWmy2Cq3niNgAgooxa7Fu_mIiyCLzXef15PxgtoUv4RWOGH_iIJXmPFZIGoUI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-E-mgjjtRRZzLwYneCskogZWewuDaF13fRQBPVqk33g&oe=6A918AA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2y9e9qeDD4Q7kNvwGKNoum&_nc_oc=AdoINfMuzdyAQf0mVrCHRmCzBj_GcuLBBRymGA2rfRuCGQCDPNVJYOP5u5QWDi0iBRc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt9_mSGSLqEkQ3YknsCVLyg6vStxcFY3tOaukD8P2pgg&oe=6A915E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlN3vFpYlMEQ7kNvwHy9ShL&_nc_oc=AdofMzKe-EfgwXZXBY8CL_FlPW33Z1azRbWPrA-st9FhKMuS_SqrJ1Z8doVhwsqfJlg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3q81A7Q4pjHbD58bVgrLunpHCdMY96_zXkn7L1fGsow&oe=6A917764"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
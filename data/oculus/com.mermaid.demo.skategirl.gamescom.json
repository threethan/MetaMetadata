5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b20ncqhcOokQ7kNvwFrIYGY&_nc_oc=Ado-0vfoecawSCYOU1em8gXkslBOTecOKLfQXo8zN8EBOFL6kYUyfKJZcUUnRn07vZc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IaOjCRouryqEJmH9yA68t_RZ_jKkZCwoB-1spbYPsdg&oe=6A1C3527"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUt7mAg3uj4Q7kNvwH4DJaK&_nc_oc=AdpgNb7rr4N5lv-4JcgUxoWQDGlQpo6PCgfDm59QS-BTxZEf3nODFQO9hHByhcBkUdo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zP80ICw6EIMGcsm8ak5rUyYmCYs2cFQyuzugta1uiPA&oe=6A1C40D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GjFsaEtZk4Q7kNvwHjEskE&_nc_oc=Adpkyd0AjsQg3nuLajqAIa4kztH2Xy3KXXNDjDAw64Z-jrKn9XWZiyirDcG7UfEp4RU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VwbfCCpnuPpP8jwVeGzu_GJPXz3u78mqQZQ5eUwfJRw&oe=6A1C5A24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
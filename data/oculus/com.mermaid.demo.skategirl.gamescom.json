5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANBsETS7Y7AQ7kNvwGfAEHl&_nc_oc=AdpyNLidsVYg8IrtapLoWQ9CJMsrEcHTJcKSeMfz0yPe-uzv-K6g2uUEx4_EsjsXIao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GeGuwCTgQCTOPbL5UMhknzIG5puhS8UyRCf0IGMtBhg&oe=69FF3427"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUk5DIxjFQAQ7kNvwEAdW_-&_nc_oc=AdqYijJVwqaHPAa0RHXUFy9IzvB5_jf1jGQRUbVei_I04mq4AMHBkfjFz_jcRbSLZwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qG3NkPfIM2ZZlnxVobOweiHggezeCFQXZux7qS47TyA&oe=69FF3FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8ZaHAzPnEwQ7kNvwEFcqM2&_nc_oc=Adqe-e1UMftbKsE3EJ1WlK5tzrA-Y6D3Qj-ozmSHydEcjIvQAG0Io6k5DiNUhi9Nj5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bq1Hr-4n-UxzcA1WJ0tZCMAXaDh67JDokxiIwSRkl0A&oe=69FF20E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ew9S8f1TO4Q7kNvwHR-HOT&_nc_oc=Adp6xk-XdaQZuYPHvNh1y6t2K3B27CNF1n5t7bd97LWvJL7-9QWPLK5mgA3vs1qBxoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhQthAxkk2iSvs88JgCCD6B0n5SSJXbp2QmWym6TDrfw&oe=6AB3D1A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYhiRaNTDK8Q7kNvwFhVnux&_nc_oc=AdqnAlKN1NncLtuq35-zqDSIlrU_nScPa-KtGmMdhReRvjiuITqC3QH0uMGIOaogF6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3mRvnhqTkmVJPcXA0hVelyLTOdC6WHNk8rPxYT4RpvQ&oe=6AB3DD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PaXxHzNs9EQ7kNvwEraF-G&_nc_oc=Ado61d6h6voAieR4Yityzzw2_Xq0yCQ8igat0efc9pj9TJWEieHYLKSM6nWruwrULtU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOUIJNPjqrVp8pPKW5EshkF1MC-Cyjd9OVqC2RBqBt3A&oe=6AB3F6A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
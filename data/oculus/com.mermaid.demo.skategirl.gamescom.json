5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBsXSJkzJEEQ7kNvwFj1VUx&_nc_oc=AdoD_Acg710RMqHofrdaBKxhX_CzP_CIhJzCR0srKqWlNgEbbpwzL1M6Gyvbi8X97Kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Kg1XwbMFZb3qd5TH5iKQKN6DyAR8FOaTyFk0LahbcQ&oe=6AE49927"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqkaaJGKVlUQ7kNvwE85zwL&_nc_oc=AdpDz_UhrSH9kM5T-FR557sKfJRItO_5xteWWvMiVp029F-jeMDLPXi67uaM4s07w0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5EM7YFZ0euo5iqHH210s09-p9iDMjPfsHrAPnVBCbgA&oe=6AE4A4D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH-0GcgmkKIQ7kNvwERSMNt&_nc_oc=AdoE_npaBHy-qB3e7rwhWxkF6m8vgWI1ga5Y0Fo3vfAfSE24dakdvTYqWqfAmyuEhNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSTLbVPijBssDdKSWLsH-UXxjy3boGoEl9u16jUCr0Pg&oe=6AE4BE24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
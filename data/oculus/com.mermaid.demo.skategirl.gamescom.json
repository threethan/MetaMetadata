5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cx6EvPUDL0cQ7kNvwGR2Eem&_nc_oc=AdrH6blxy83YGwJqPuD0SuDNBa0y9Mwg6QIwH-5Z2lhD8dbA6J-PD_4I2eHlmBdzJPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1cJimX1vAjnkIeMYFZh3MJ0YJzediT7TT3_o28gk8qw&oe=69D10FA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVEnY16GghQQ7kNvwEVoiE0&_nc_oc=AdpGSV5oMP8YaLgz5OWK4-KcdFGAnC2aseN2RLAeaCEoTN5xbxH-rnCDQzCuC4OGpC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzruuqiKd7di4hQYSTeRB-aj25tH8JFGts7oUPQNpEpHw&oe=69D11B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ7JB48FDAEQ7kNvwEqcohc&_nc_oc=Adokw_EgaGmJf4LbtgJh8EhAcxW4ll6TOBWfdlhzNjcG41e9Nzvp5B9Lr_xTnLmDVis&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8teW4gTqqfBX61o2SHH8XCMRe-R-0qU7HnW07adAWlw&oe=69D0FC64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
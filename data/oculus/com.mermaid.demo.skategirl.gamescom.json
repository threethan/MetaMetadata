5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvXwv32fKqkQ7kNvwF8uMTu&_nc_oc=AdrghK3-fZDWUQJxKOxozi-ZWXfJ8Mm15PbhilAfXeMJU9r8ofI0OR11RXfAgaszDbE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkhgwu1WbKWoS98hQ7GdMaWUWJl5K3A8so4UFsgjitRQ&oe=6A86FEA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oTA-WTARBAQ7kNvwGd7DrU&_nc_oc=AdrEoI5vWaFjw6dLaRNcdteV3ebxaVkUoJs2UTHl3xC9v-wqvbZ50S6wmZiiTWYBgcw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqtlZVW4BLW9RUoL25BKDa0KSXrIyWlecjX_n0J_-Vig&oe=6A86D210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhZ7XGUF82EQ7kNvwHNYqEu&_nc_oc=Adrsmclg_wb1AI-hInCmJTipzOC0gSNpUTaR6OD5hLieneHa74u7y_avhfuCnat4SV8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbjGhzYkxNArHSCA7mrmHlHpLU9A6jCwH8hz4oPB0gMg&oe=6A86EB64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
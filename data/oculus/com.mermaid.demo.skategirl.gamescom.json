93357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqr0MivNolAQ7kNvwH_mcXi&_nc_oc=AdpEG9bqVlsf3esBN6WxchQ0RSXjeAl5q0Gsg65QxNtHr6Ql4U3d4FHbPJxETcJZpLA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjd8LeBvh5HH0uyaKzBx7aw3ZC-o2UUm4m9roYmiZUkA&oe=6A7DC427"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFjkas29Wd4Q7kNvwHjybUL&_nc_oc=Adqr3ydsmkrMsHNwQ7dSMtVTxVJ8VBAgZEN8gWEkd1mUpXtMdopqHmCJRIAes19RkxM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdOwgVZj6IACxmlbqfjjBDx2274YYC8xwhWJgU9Ylw9A&oe=6A7DCFD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVgQ-ja1aloQ7kNvwHkYe8u&_nc_oc=Adr3Owwjob3HbqLgTLas2sOazZ3Y3n4nF65Coe1AxgYMSIPj5v20gH7GGVpybDoBqPo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGg_NRTKBtLrxgqsu6nhrf0PbzhD_0yHzf8WAvRpfURw&oe=6A7DB0E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This ti
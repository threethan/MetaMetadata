5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JYlR0zr4g4Q7kNvwHi_9Zh&_nc_oc=AdpgfY2TznBqcgksqQsnNyYdOOk7XrAMNCusVIT7zd9K3bNOjmBS1Thun2ym9k_mA60&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIfb08011V8Qjpyg_6K11K252itxqEzc-Kj740MPW2gQ&oe=6A974127"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IckF0YKhcZMQ7kNvwEc6sr_&_nc_oc=AdovCYOf6iUfa9AfEmhNccJZkVDmA4UshBVw6NOaKzEL3gu-yeuYmareTEJsd8cmhhc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvh0Wu4MS8LjBkBY7oIGi9Uf-1DQtMtNIc4HGDSeVT2w&oe=6A974CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ6NcGB7iwIQ7kNvwEB3-ch&_nc_oc=Adpq7z5J39gcqQbBVZqmbLEJb2Dd-A1V6TAIUALwjJY4HVAvsCFO9Mn28iWNUUnkero&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa4YZzhjvWnGazovI_6axZHAdTkxDmz_QFrZ3D3SpqeA&oe=6A972DE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
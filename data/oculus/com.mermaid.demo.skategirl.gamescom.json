5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLjOSV3l3JcQ7kNvwGvhKhs&_nc_oc=AdoK0EpAzHwTNqZCxEi83ZIlmbVhZhm9hzbgIOZFvu_QiTGVE1boHRLgfHhUJsKY31A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARYZ8xaW81gAMh1ED5fIU8xqjboFcRQD4gaE21JbyVsw&oe=6A69FDA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ub-kSgfbK8Q7kNvwGCs_yA&_nc_oc=AdrFUPbRUIFZcSfjgGan1tVr0-B0tWWlgQVYlE66Wdqu0zUR8bSzyPPmh1R6L4BMuHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIUGfr9Z3DeOsIxc6hvtd7zZqDRepG0qERdCkxRjrDTw&oe=6A6A0950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afOxQIpFAs8Q7kNvwGj9u8p&_nc_oc=AdqQWe5D5ts_iWqcGs8QDj3obtlrJ5vp5EFLVKX4zqQO9mQrHI3PwchAmiK3P33sTCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtDcr2JCoxIOwtGB-FEVCICa897ogBOnnj19vmaeYObw&oe=6A69EA64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
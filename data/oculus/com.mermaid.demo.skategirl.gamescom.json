5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJKhIRq5C5oQ7kNvwFUL8mR&_nc_oc=Adrsn9TH0od72RNOgoDpGnSjXpah5DrY-sBFXVs_1rF5_GuKA1HtwHP3EE6eb-HpY3Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdnd9Y21guf46YWLI5Sq8x6HQ-Bx4KTWsog3G_rXkr4Q&oe=6A5A2BA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLO1seLpPF4Q7kNvwFYGEOk&_nc_oc=AdpuxJBbsFvZGwCexiCT1en2kqIGpee3j5wFdgYuWMYXSi73KAt1PEpWc_w3er7suZk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGCkfG_C8cZ8VD3zYWCevTPmskkMzFFXdxnn9BS_nVLA&oe=6A5A3750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HHddZJjeXQQ7kNvwGG21rX&_nc_oc=AdpyhP520t3dqAOg-Ill7Qxnf9mEIr_1b1_VvuRccR69jRbZ1Fbrp6co1j6RPXnZLuI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALEv1hYCyi1_Z4Zeoq21KrF95PRd7LOBQ--9sEiH1sJQ&oe=6A5A1864"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
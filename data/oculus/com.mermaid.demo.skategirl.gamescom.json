5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkPfu6sMiJIQ7kNvwHcbKtk&_nc_oc=AdqGtcXD28uzc54t8iCEpp0itfYIqIzQtvHSVXdx6TVtvjZH3b0r2SytC6CvbCxKoyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFap0AL6zDXzSC-2Y11dtRNRUH3QzsSGkMn0BP0hZ0-g&oe=6A636627"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk0itrWikEIQ7kNvwFX8rHI&_nc_oc=AdpDhQjWYNYCbuxo1pZU1p66foHEeH_QuJFNmJjhZiRZrwTIH5M3bRN4KinEd6MPBag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAriChmfVlplH9yx8_u57En8pd6EWhlpWSUFS65TgvG_w&oe=6A6371D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQrpfGfUIS8Q7kNvwERyMS4&_nc_oc=AdpCMY34A-o99DglsSv1a-51vNxNpeprcdHt6hnM-RKkZHaXhZHFanFoib3wLAiVK78&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwqvzJySYt5ya3L9CstDtgnvlz59RcLiLbRrp3sV4WjQ&oe=6A6352E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLRdPl0a98AQ7kNvwG2Opoo&_nc_oc=AdpTFXR1EQ2FG_QBmWFIf4h94crWv4IQ7cH38T9mNXOm-TGAp9XdVDvvqlMwZ0UNGYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDDgEXuqR9khoP85xi8hZAHj2dFsEsnwNkSK1YmVfscw&oe=6AF5F4E7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOHSlZcgo4AQ7kNvwHQ7ism&_nc_oc=AdoLUm_tLMa1YKeNnFy-fjwgz_gP0ORvnGp9hM4z2ckNriLKhKq2Y4w-KHIwW9I_PE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0ZcqSPpSiBb8iVWTpVaRG9nDfEhrtgTjLqjYB9M80IQ&oe=6AF5C850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f-Y_bep1WMQ7kNvwGMSXjB&_nc_oc=AdqCBkROhFSxJnOCpfNE63cpwgNHKuiQiMkWBwzl1qOuyJ2-di8IiIYGf0XoRgKu7M4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQL5EFY_Jw_dLj85I-9MvkgYp8JA6jOw3o5mTqv3yFPQ&oe=6AF5E1A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
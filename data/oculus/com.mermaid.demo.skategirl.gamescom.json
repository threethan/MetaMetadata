5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo1uaMAMsyMQ7kNvwGu2wer&_nc_oc=AdplfHRh9ztPIcvR7ZvH3uMPV8J0MJRW9gmkivC0ny0WW2pJabkL22q4Y1TN53TsdWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2i4cGuegQDuFifqvpD4V09-EZLFD2wfJcjH6ay0X2fw&oe=6ABE5DA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh2mNfsdSiIQ7kNvwHqsV2W&_nc_oc=AdozJNU2B1mrEmHl0-tB5pdQB5T0jvOP4k_GD5FB0PE-G6OTRBd5ZThNmr3yx-8YicM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID10wXNHn8a7sidc1v35-VUQGBoIdtnCZUsW1HF9-Hpg&oe=6ABE6950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i__m_WpGyUMQ7kNvwG1mNQI&_nc_oc=AdrDhHUCd6PEInt8VjPeYhpVySHKj5AtfB-9CXx8qyc1ZXueSNTWeV7CZ5Wq7-jNzGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEOLwbv89GgnMlGDqC0O49ONEVuEFOPBcxUN6a6Lnz_A&oe=6ABE82A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
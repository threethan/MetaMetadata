5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=didUq6br2UsQ7kNvwHovSJy&_nc_oc=Adp09Yi428ewR1S1uqVam0aAf19H3aUZiJuMrqm6L4d4IzZO1Crw-IRtmTC6QvGuUOE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wTgk8fGTfIOsmGFlXHXUVXwLmfnIjw9v85Uk3YKpXnw&oe=6A1057A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWk1__eH6wUQ7kNvwHL3LTv&_nc_oc=Ado9uYH-tBlx2bAmmcQXIZv4_8P5kmcZjv3NKFArEEiD9bW3E1bYiMJpzKn1C0rSScA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g-iCeoAR6hrpzns0RKIvZCQ78cdMxmRDWfFh0RJ8l5A&oe=6A106350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqoFzhRcQK4Q7kNvwE9kPH5&_nc_oc=AdrFJ97Az0weK_BlBypTrVpKoMF5KA4vYn-Nb8laF8HQKrzmlEUS3a3spqKSHuFfIq8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af711TLjq5stU1We-HgzBTJNQDdGr8cBijO7Y4y0OCBuwQ&oe=6A107CA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
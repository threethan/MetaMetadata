5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqpbiwJ_JzwQ7kNvwH_CnrE&_nc_oc=AdqKr3td3Y-wZCrgOx244LUtmPZf0lvYQfKDQm4s0DcMUxKTfybLr9PPwPfny-PiAfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iKfba_HpWg146r1oyylO7Inp0EisVFFK-FGbCeNvD-A&oe=69DF9027"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CedsDIBzr9IQ7kNvwGa4-O2&_nc_oc=AdpDeP5MqHTMtcLsT7FIkY6lcc6D0Q3O-lNsJ_cgZ07QJeqfo6ZMTPosaHHOmb2wEcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u5oM7C50vFCJi_ZOOhKnklYZNN9aNgAqYXSgBjEDMow&oe=69DF9BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIcJavvLRCMQ7kNvwGnhr_E&_nc_oc=AdprH6MI4-Y2TmXhzHczAkeGuVACmphRWsHQHHjPnWyR5ou79YmA1-q7llls2Lchduo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bnsm07NUaOxUPpJqerIZExeckpnrQcwx9RfMc1tw7ZQ&oe=69DF7CE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
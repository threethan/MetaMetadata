5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkPfu6sMiJIQ7kNvwF3b9eb&_nc_oc=AdoxWwqgfpngKoWwyoPO0RgkjfVdPKD8DsUvG-mVh2OUIBuROp4G_2hDUGqaq41sBpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnD40QkcHWPnNCdX7NUDsW5D95FnCWPM6pZEVvWrJA2Q&oe=6A64B7A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-0GawEduFUQ7kNvwFRUXV-&_nc_oc=Adralrem34nNLuOoI7xY4Z1TeuaIE_e7VRGS1gHBcLjON6OdpDFJ-yrdWyepJYt6P_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfCQLlmCTdid4AkPO2HBi1pMIdv4SUjVdwTw6freGU3A&oe=6A64C350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQrpfGfUIS8Q7kNvwHanc9x&_nc_oc=Adq9vKX1GBbEsrCGyIDMG0apWSW80L6WdiPL1vriXUAmBq88GgrMsahxdNMurrwZaS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-t2GCzaKqRP4JNVcZVcGmR0YgtEYwTU17pjNRoxGjww&oe=6A64A464"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
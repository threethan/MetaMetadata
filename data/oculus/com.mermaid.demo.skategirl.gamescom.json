5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32nk9bscVLIQ7kNvwE-T1re&_nc_oc=Adq78CQCkx4Dn76zR4hAp_SxFM50TapdcyT_tanXatKFMC-sSLh-_Cxm6EMJ3YfYljE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMudq95MqYm2bVmf9oKTltFQU9xs5zVcvYENtjjhuR_ZA&oe=6AE1F627"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSf4vfgYJO0Q7kNvwEtWFhi&_nc_oc=Adr5akhRAf_1IKe6XyPe7hrJFOoY-isrwiJ38U4kvu9-8xGTx8FONbc5cf1oAuxC4O0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs6mjd5H1GcFAMe6Jos92fbH80LIMVYwzXJr7MV5e-aA&oe=6AE201D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3Ejmn3tpyUQ7kNvwFDieUm&_nc_oc=AdpIYPsBPKLpqGX2_unFIl0QmGjWGaodlBb1CGw14hPc0_B89I021MGuHi9IoJ_4GvE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzKGv6AhjN8rl8Wjtj_sWGS2qKspV6mPVCntDtCiNfrQ&oe=6AE21B24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqpbiwJ_JzwQ7kNvwHNnTWa&_nc_oc=Adq6C269-zFVmyjcW0n8kSVEiYouueLpXSTxCwIWBXys4nK4cRQVaGgz354uc56PAOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OyohtWYHjHT-vsliFihE0y7_KQeAkZNgqY9lomryTOQ&oe=69E0E1A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CedsDIBzr9IQ7kNvwEh-CC2&_nc_oc=AdpPXkg6qKk_iEUU0TfVdFGUahsWnX_ctnSvcjMCpJzptksj_E4EGhP__M-vF0FDZrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26IAiN4YwOv5YuJ_owxKRKHyhvU2wxkfKDdGqxDlK1aw&oe=69E0ED50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIcJavvLRCMQ7kNvwH3Ot6l&_nc_oc=AdrBsMrC_Dk6pnwgIYONQE_T0eWgr4CNLVGWIhuSlWQ-MQVrBnMJOlZcRmAVgJL7w3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SpTujFR3o7gEYUrGmsEx9OTw58hk4qqdwk2_DRwG8-Q&oe=69E0CE64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
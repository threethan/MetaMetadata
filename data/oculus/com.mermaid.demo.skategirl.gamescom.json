0kmX7u3rNE9tNl4pkharBMw2sKMT4mfIjoQCG_tlUP8VYxaiTGTWuTjp-KI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxHWGiwKpP19DKTmvQkOjYbFhH_h06yyg7BYmXu0OuenQ&oe=69B954A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrpTlAI7W1IQ7kNvwET0RpA&_nc_oc=Adn4eYkqwQ_t9a6Fn_JW9xn0oSy3aXN29bwKis3LdlfQgCzjEAynG5aNXiGiMP0bvls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwG6wKRFRawBzr2YWdK14IEh7a1l1oRu7P-8C0NRh0D9g&oe=69B96050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K15u6iCn2hwQ7kNvwFL8RPS&_nc_oc=AdldMpgQZDlIa5tM2Qxv1pt6-WtyRP3fbJj6UakcpfYDiKiWqhkhAkhA4nYhkUKQZfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyjLiqK2wuu0uC_bLDcnIHocloWGui7NBWDT-5cTpY0w&oe=69B94164"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_pri
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dUwexPGf_AQ7kNvwE3DJ0V&_nc_oc=AdqGcNj0O3_Dwk9ijdRw1mPy-c7mF39ipKSXHI_CL435hPVmKOASpcgYqQiwHUc8LTw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvUDl2jxsnobN7wBW8fdxGO1o-izX7oCJTPNzEk6bCpA&oe=6AC4F527"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6IhoR75ljIQ7kNvwF2WdBy&_nc_oc=AdpDMDn6Ewp00pVtEuEXIJg_hOZdvG1u5ykalYH1L7BKB55IDqJpREM5-it2cxjjBFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5It9nhfsGi_k77q1nGV6XeikYxNmbRAucd5n17cehmQ&oe=6AC500D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0caLc6wCV5oQ7kNvwGsaoFh&_nc_oc=AdpAK9E3mEep3_P3yd2e35K0LOyhR3jbavGhNtk5JMlx6QukcWRyjHW8qkRpwAOrnLI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoH4-g4_RfO8tb6qyTsQHtfOqfV4tQBdkfJXn3H2CPcw&oe=6AC51A24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
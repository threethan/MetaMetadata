5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEqOUoH5awAQ7kNvwEu7RbR&_nc_oc=AdrjEyzVwU-3TfniQUg9CCiAY0AsfpuT8SXhHuX9xnrgnTl7u8pQLb3euCOWOfyNT3M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af896lBcm1VjyWRcNYdZufppQsPa1gwLXWBjoXebSfrFMA&oe=6A329EA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecrjG0N_5hUQ7kNvwEWRivx&_nc_oc=AdoSMy4zv58o_21tGs2x0IFoGM8VGXqdw9ueMXCajn2HwBvZDAT5g5nQBV5qtIcu-_M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Mz6GWr16r8Ba0Jb1fiVil8UyCmchiAVxWd8lffP2xqQ&oe=6A32AA50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA7J958TpJ4Q7kNvwGHqrHf&_nc_oc=AdqklpBsQSpLjZ3xajQ9cLjq4MIiPBS52WiAN68Cw3cAMNYQh3beviHwQcMq9FrivJA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B8iD9wPiTNIf3Qtp8JvUuze93Gphs3AJLTq3o8MTN1Q&oe=6A32C3A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
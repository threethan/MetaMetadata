5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js0CHn_IEOcQ7kNvwFSy0pH&_nc_oc=Adpzw-WRXKMlmQl6J0O6HopMLZF7XIOLH0fY05BCQxO2YLyCF908UWL48hkcFcAyZDk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlhrcPgDHlbz9AEdZKSP1WgaPF3dEZQbBGjEO7_4ZnEw&oe=6AD0D2A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irHSuMZ3I08Q7kNvwGNetaG&_nc_oc=Adok98NfCMfQ-tnrbVfcoz910rE9rPaWDhYULf4d7jmQFDfWrbtdEMZNikhm8Aolc_c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcfp3uaaZ6EIaUbBOE5F2N0TbJ87ns8lkS2YyODxaVgA&oe=6AD0DE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qAUZZYOR_wQ7kNvwEHsA0n&_nc_oc=Adrvf8MfE6HHN-0Jr7B-G3aPlWCkgBxr1LQnDg96PdMhO2nYHCvdXJUmL8aCeEFHodA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHti7t_GVdVIs0xX0aU2t0sMrRRQmoMCZpTuZAAWD05A&oe=6AD0F7A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbEJeuBpeKAQ7kNvwFjKuYq&_nc_oc=AdohzwR-4CRFL8m3o-VTNugrWWjHOPgkq3jdKFSuWAPp8DnxbiM2zHoSIO5gC0qnJJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvkToxv-RIP2EDMmDXAULQNvMKVsHC3XQk8wPXnIO6ag&oe=6AA2AE27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_KjH-fUo-sQ7kNvwEfJWEz&_nc_oc=AdoKZDidYtt4NuviA3eMvUifESmiVxeKDQkhxWHytgMR0WAzsJ-9cEVJ3NLXZLFCIF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiZHyhAzMqawHT3ApQ7aEu90d01uB-FaEz00qL_HTQAQ&oe=6AA2B9D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5PB1TSx5RUQ7kNvwH7JyJq&_nc_oc=Adp8b_vSoZ-UAZaa3K9umlUFToKTsHbM3tG7BJGNeqvt89Vt1HAnKAwmcx-1kb2cvwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1x5HC_LFzcpt88sr8-JvLWIwv3g0m30AQkKwfHNFRrA&oe=6AA29AE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
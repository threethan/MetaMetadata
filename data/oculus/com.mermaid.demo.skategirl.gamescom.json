5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euGXUz1Zi8gQ7kNvwFc4tZB&_nc_oc=AdpjvIG9KeBnc5nGxs63nBmRGyWJBqjT9JjJ7U-i6MPTSPyVD3uYOJs97oauK-vFcWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBYVyKrVFnqScndv4V3w1mf65YZSLnBVayyEh4HJY8FQ&oe=6A9EB9A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05lcIBRdPNAQ7kNvwHufS-D&_nc_oc=Adq3HNi43ZjiP54AhtAxWT506aBc3kZa-IEIN6f8u-_lKIC_gZqfIVlJb5yMDtdPX1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKyJKUXoQbqXDqjFkTxsIpZFs_nDTL2HyhCyqBh6CCQQ&oe=6A9EC550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJZ6gFA1VAEQ7kNvwGEJvM4&_nc_oc=AdoC8Nfji06ZL1g1PNipaCEBYwve8-ka99pH5oUiqSfZvZCMeaAAEAIbl6L2AQHK-Uo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcuvmh7E9xEvHmF-qANmxCIAybMB8cqjOhob_VjDgIjw&oe=6A9EA664"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
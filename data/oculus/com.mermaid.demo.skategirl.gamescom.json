71359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpWOKVfj8mQQ7kNvwH4qJR3&_nc_oc=AdlKulwIMhZ18lvizJKZQ2HLuoAqI-8oBRNZDoc9JZlIR1b9cHLCe98oClCF5OWDb2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu2CaQgWKaYQEXqKCfRW_LH8LHscL3VvwIRv750yAdL0g&oe=699B0DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acfBYY2jBRwQ7kNvwEpzDF-&_nc_oc=Adnl21nu3xl1ExBQ8ohcv1M3Kz0qSBH-y5RU2lyd3ZyELjGC4OFDT8IhW5f1XrxhF5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuxttAi0QUlmuXJTCBEQBxY2IDaJAP-nOpkdAMonV4BxA&oe=699AEEE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mermaid.industries/page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mermaid Heavy Industries, Ltd", "support_website_url": "https://mermaid.industries/", "website_url": "https://merma
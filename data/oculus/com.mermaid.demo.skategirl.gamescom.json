tl3-3.oculuscdn.com&oh=00_Af1H20xS4Ua4spjl87mZTPGth1rZJuhrFvs2o-Eg_aQfAQ&oe=69F20527"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elZoB43VP2MQ7kNvwGtoOXV&_nc_oc=AdqYU_tv0e9Gnn3cbEei7Tsv2ESpi9bqOq2Gj2DF-41PxPmyRZSpEZytHp1Tgd_QIVE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2IZ6o_wDVYWJUgX8CAbnuELimctZDyYGfgHEkkpgwJ-g&oe=69F210D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1Vl3H7gyqIQ7kNvwHH-CIj&_nc_oc=Adp9wOjawswncyBeWRFcK2z4UVnGIQWNDauFUV69aNiwidDrnmIiliKBikYLWHD7aHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0rYoYgvxDUjxTc20-GqHirJf0WNPwGk6yRUZCFf_F4vg&oe=69F1F1E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mermaid.industries/page/privacy-policy/", "developer_terms_of_service_url": null, "pub
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBsXSJkzJEEQ7kNvwFilrf5&_nc_oc=AdojZSR580b_GK-m63xhh_7hJNw6JkXEIixeEDcbyAdZMH7l7Ue1kkPs6e2ya67SRzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJrPiDLHG7b3E6jjpxnYGkCP5ePdzAR4fNtc--B62t9w&oe=6AE73C27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLQg2_ZJn3MQ7kNvwEQ72ta&_nc_oc=AdqgTzXEyrljZMLc6nJOsfoPFFWM12QH_GBGkQNaZBH9rA13zYI3liX734wh3RfPeWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6gq3mPCPy036Gjz6MPCQBi51QiuVw4Cm8N9pQXcn-tA&oe=6AE747D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH-0GcgmkKIQ7kNvwE7Md0E&_nc_oc=AdpfOfdhyslUwgyg6SILMzvy4ES8TelvP3SLNSVOi2MtohpT69iRINHM7c4jLcq13J8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7Wz1BkolhsMfulzgTQTtaMhl4VHCwqTL92Bqu3bOL7g&oe=6AE76124"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
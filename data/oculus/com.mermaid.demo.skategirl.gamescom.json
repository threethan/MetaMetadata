5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHwC1X9cSuQQ7kNvwF17O-J&_nc_oc=AdqI2UsZLItdN1mRXKTay6V8z8dMOsFM4Dgn4ZzRVj8wwnnlLYUxMUWICpRU5yuMz-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBMQQCt-gsGkU31IpjzvvKLk2CvvZIEwONPs243YHeZg&oe=6A5242A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkQKESmf0eQQ7kNvwG7odGx&_nc_oc=Adr0z1ok4TqN0Tmq1TJ59xDwDy4aO9Bzf7afo4M2k3GBOKHyz3DxrdadAMsamNQ3VwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbEkQ-FPr4QHtdwL3EdcmHB86dbrQJj-DT0ss-Kn5bKw&oe=6A524E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKFUVoXVShEQ7kNvwFocUEe&_nc_oc=AdqBOeQTFmTILuM0OLz6bIOfn1VUvBTdwLFtqxbsLbfWA6vdRE5bAkDnWmUfbmIrSw4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqZ86nlojybzc0F11ljS6rZ9giZLRNsA3cy0fh9r-YSw&oe=6A522F64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfl6lm5gptgQ7kNvwHryFjX&_nc_oc=AdrIbweuUkf3Lvhyv4I5atxeu5jd-gE2PO0Vxnm66MQ4Z-QwnyuPahWrUdosizfvu-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WcHcOHuoP88vrQy9LSACPHvpIY67-aVEHZ8ll_JLQNg&oe=69D655A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuBJPdDDLiMQ7kNvwEDGSQD&_nc_oc=AdrAFx8SexwJLekMwnxfmX-A0BiRRO5sEZrQeIPQD_5IPoDuH_dMObY3Tkorhf-nXsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lbbVMSQBaXNrDebodRLwqfI3pclS2orPxPdO3TzjlmA&oe=69D66150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPEKgfVs_zUQ7kNvwE3F7wu&_nc_oc=Adpl6mMBbjnsNMIaWTx0rXbpg4Io-nLjtUG0hLTIqqx2XclGKr7bKZktbvmmVuOM1RQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15HvIPbVE6ogp3MfUp_8p5oc9vqrz_yj_WTThKOd9vWQ&oe=69D64264"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
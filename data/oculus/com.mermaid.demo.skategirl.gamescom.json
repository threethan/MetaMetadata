5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANBsETS7Y7AQ7kNvwEgkVpe&_nc_oc=Adr6VYBp0Qi3_E1OtaulUyLnQi2FXPm7b5dq4oeIuE1XLmY9MHJSMyO-UsHIhP1V4pw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CCa4gflNU9LfEd4e2E_oi7WcR3725D5-qNXhOYYCeCg&oe=6A01D727"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eEkXrJ8JDMQ7kNvwEVjwb2&_nc_oc=AdpBXu2hKm2wwDMJiai0UjtyEvbkblJO6iH-aUoZEgA0lncr9mDlHpW5ZnbdGSEJ7vQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DVawZPSz3VjNd4fEgTpcTwkmLeTurp8MKjDn5VOH5oQ&oe=6A01E2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8ZaHAzPnEwQ7kNvwGJAtTM&_nc_oc=AdpN8R7lLPIYz9WtDT7sLeAEiwMfTvadOxTiV8ezDhpiYWJn2Qw7x_MlwGkpexKAV3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54kdx3SeWnM17jRn0mj8n2HN9s7AgmrOGDbDWK7jh3mA&oe=6A01C3E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
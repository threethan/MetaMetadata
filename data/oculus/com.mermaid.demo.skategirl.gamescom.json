5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHwC1X9cSuQQ7kNvwE36iZW&_nc_oc=AdoRjpz7b_M4NfttihHJVs438tqgLwjtonw2FEuEjFL3WgNXOs5mwYFkvKPmzW5sDEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkmqHSxXZ2auvrc1B8Jn0i1KiWDdLAp0zLyA6VPbty6w&oe=6A54E5A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Uf0p7x4ZLsQ7kNvwGuzqtb&_nc_oc=Adp86kYOqV7049ELQWlzBNhGbk0dgtI1TOTbK6_llVijVzkbUTeGabQk8EN7VV4M_0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBolu1JcK6F_-EuXrcvgtDBuMRumP4bumMj6d7w0Q-dzg&oe=6A54F150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKFUVoXVShEQ7kNvwG5__z-&_nc_oc=AdrRkAa0woEUkStbjZ31SqJJbIcAnGxWj7-a1M4bWGAFUTeYKpLGGI8olBt2NzRNOu8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3XphgOFy92gFglzzspq9qCx6QQNmHMYAqV8Xj2Qi0LQ&oe=6A54D264"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqr0MivNolAQ7kNvwHec2ao&_nc_oc=Adqokxri2j0zs5LAFqzD0XdBdNTnaniskXJogHQLFhKJpHbRxmKAHPXzErvUw4g5tnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhaXLbJregY6uhPKOy30cqT7zxRJPyLKgNOiUpfVzJgg&oe=6A7B2127"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CBSy9VRYX4Q7kNvwGU3mva&_nc_oc=AdoibXYTwhmcHx4xDeaJGN6C1K8zSHkyKURngqMVRsmPZyr_baA_BvKqXMSI0uuQWg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaCWi_GeKZHdXk0G51dH6I08W8REYHbnkAzebVk7TT1w&oe=6A7B2CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lGaBmofR3YQ7kNvwEU4Cmr&_nc_oc=Adp3tQttXkVCb9aMRrYlwnpOxQhDuPkdPHsxoMeX3lw7UZNxKi0--fe5bv5kniOaMjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK7VyjUJz6EtOy3R5RKfjyJvJqs_VYlasG87o_bpV9jw&oe=6A7B0DE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvkILTUydNEQ7kNvwFdOTFv&_nc_oc=Adryd9zjuTKjf2dkN-DrhsHYgAis-8xlEg-h82apOwfsOWsHlp3TkB7U1hwr-aiqvdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wsfV5A_VRsQ5MCfF21TKuhRMtxTNJCGADX-3zHs9cYQ&oe=6A3BD927"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAJ1Sh__fwwQ7kNvwFMWiG8&_nc_oc=AdohSdueMvOXXgCRd_7Lwa1_2Za5j0cRko6dbtXzRYJmmUyKhL3T-ahlLwAZczfX5EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lW5FDfbYRATxx_qQFAGoHimZZtATpL_1PLtBJyCOLSg&oe=6A3BE4D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd41MJU9M88Q7kNvwHKUg2O&_nc_oc=AdpCurJOYx2cQ4CstDeULQ_mDpPC3XNdvnvHWEM_a1UiJc2pTN--GH2hu45XRagUwz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__5hIiR3t1E1W89jCLE91hKJd69M70iXANuPJjCSLQXQ&oe=6A3BFE24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
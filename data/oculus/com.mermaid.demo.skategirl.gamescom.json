5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB7npaWyM-cQ7kNvwGIZvin&_nc_oc=AdrWnXuarFmRImwFKyh-FayfnD5daNn6qYOnBvwdAcSGTAd8DoCpqMLU0LguEFXg_bE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5DkULlCBrtxAMVXxySqx9izZSPNxi4hsaz1b2AKi0Mw&oe=6AC8E9A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uirwof2nxSoQ7kNvwGKfrfz&_nc_oc=AdqYj2Onfp3Xx3b9u0aREA17BPG9g8-0_NNn_ZBaj3yvWopUdslhvRmJZONmUR2XsHM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA2wnbfFk99f-RlfD88PjpCHfL6_Ulg8kfErtt_AkdHA&oe=6AC8F550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDDMgwjazHQQ7kNvwH2S6O9&_nc_oc=AdpvbtIbL_BuFChEAQhVFNfFa7EKkD20tiwiREST4TB9Og8ucz0OGYFXLmTE7IuaO4I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKLLbr44oXaaiNjeWSlBRx69umVHe1CpCgYGCLQgjp1g&oe=6AC90EA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
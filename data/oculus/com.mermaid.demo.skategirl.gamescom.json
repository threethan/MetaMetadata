5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b20ncqhcOokQ7kNvwH-H-7i&_nc_oc=AdoMiAG172gbpqx1IfM5u5hO2n7-bXGZPaESpjWsc5uOFbBdZcIFChu7k-aL2pjcn10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gmCgXqGWPOfsGVVd1Em1Zps-QmOCf1CX0T7C1fPgQDA&oe=6A1D86A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KMGcX-wCHYQ7kNvwGawfeH&_nc_oc=Adq4vPb-YQMSMkINI0CPBzh_DD7HqSy7xIsPE8cph7CnDCQXcyeeSzzZJC6OpQdZ2ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DaCJK9r4p2Rz2FxtE3D7LBeWYO6Fp-gpYLqtBSglQHw&oe=6A1D9250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GjFsaEtZk4Q7kNvwExtxz_&_nc_oc=AdpKAK1QGVsmd8cXKnW1tj76_Hg9muUbSRzfywt2l4B2K7eIE_96yBFdCTQei8H_3DM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42YKlLkfmHtnxDh7YoNTxyTIiTO7eeaKvkAnMglgFL-g&oe=6A1DABA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
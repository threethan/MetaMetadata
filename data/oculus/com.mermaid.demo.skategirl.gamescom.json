5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJKhIRq5C5oQ7kNvwFEB0Ru&_nc_oc=AdolIMTTs7TgH4boI6A6ckPIpbEO6Y9HA8z-gpdJSv1IRdqz9PmV1_FWoRxJyrJ8hug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8-Vc2l92tdqPpkf4buNr04QZBclOk49blhTIf3laQow&oe=6A5CCEA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXJnGIlbY_sQ7kNvwE8tUX6&_nc_oc=AdoRZNQz0wfKk3YisVxfsn_JZXWQswhMfQ8CuHGGs0vBc4vlUxEUDpzZgjXrWv1TDwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzxhYvm2ZTQubAyTKs7QPANkys4vYq0g4svpucKHJHHw&oe=6A5CDA50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HHddZJjeXQQ7kNvwH7uJIt&_nc_oc=Adq3R5iAMDBC3kvOcmTSB-14ikyXx4S2CNsAapVuV-BUoJqh6yFnSPomIWh-eIVbGm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHLM4UVpBZyPz3iwdc6p8qPL4lDvgmkf-Ymo5MnG61bA&oe=6A5CBB64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
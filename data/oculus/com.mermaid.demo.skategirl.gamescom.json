5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiDPK8cKWK4Q7kNvwHndF3A&_nc_oc=AdrhFgGnWmTW4_wwhpWg9IC2ejFN3XE7XC_ZDKTerj1q3og4lgtIt2dXOs-lQv8hqnY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28QupGlktluMMMzAypF0h58Jm0L5zOuMOR9YrS7-VzOw&oe=69F5F9A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5YpdmESRWUQ7kNvwFH3GQC&_nc_oc=Ado97zXgf4twy6sbdpmu2VdaNoPlnUfyNkdW_6japmUiMeILNUr_cKrJJhvWxF79pXg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SFlj41wdgG-QA1hyB8UPcaiXaXN36w3ZlLBuzrBdDTw&oe=69F60550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCVp8SYHX6YQ7kNvwGtTGri&_nc_oc=Adp3H41Mjq6iQelw99IX094AvdyoawwwXfz0yFX7AGhoRavRH90S2QjPlLZkSTvBY04&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23fztewjliOl2Q4FV27o_jHjqrLHVim_YDbIhLOc2Spw&oe=69F5E664"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XssoKXLrEkUQ7kNvwH9JCbW&_nc_oc=Ado4zLt3Cd4mRf4I_EtGHcULT9NbS3hc_b5KfpYZSdJMRkjmtbuNFE6iIGlmQ6OzL_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFQspbeTpc-bFPTZ--5qRjpSo9_q83Jo4c3C0HckdlGg&oe=6A4CFCA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AASdP1ph0eEQ7kNvwH682I6&_nc_oc=AdrJOXBY1k-dlWQPT3lE4JojRftiax41qaT7kzGN0yCWERDsQTcm7MGSkadhpeCoibw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp226GzbQzot2Xi2Jx58E5fGHMUf9kRfCbkw2kqigqzw&oe=6A4D0850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peK9eD4_wCsQ7kNvwGiOeuk&_nc_oc=AdqYHddWCCiQZZDZpuVNOrSE97f0rict1l4v-BiNk--XJMnB3LNMHxVF7QNlKcTzx9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT_6N0cRmKZomuESQPyuct3fDYsWI3nSIWaUGc5nxXfQ&oe=6A4CE964"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
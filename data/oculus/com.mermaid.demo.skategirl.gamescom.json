5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRzJ3vyAeLEQ7kNvwEIVxAR&_nc_oc=Adp0tX8CImjecYA1CVpYDSkR5ydhtIrtoc8aEqtETha9oCHlYO0Ez5RGoFxq6RRxAlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk1gbHHmZYG7a-46Jt1vY6UJAKGV4JYjvPR1N1mWtcqw&oe=6ACFB967"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irHSuMZ3I08Q7kNvwE4ME4n&_nc_oc=AdouEErq7dRup_pqyeTWoJsE1aMty_GrvE0XJfYkR3xY8CVt7NNwcyubHtblRI5dv30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwv10E5-cUjHmZrEc6jwmOc9ilcfYW2UlTjuhYq4uC6w&oe=6ACF8CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zCUrxbpSDEQ7kNvwGq2rKW&_nc_oc=AdrIJ_TaPLswxZPVNVTIM27Du5rAi2Fy8yVQ2uY6qVrnhm1QjmJsvEBPzlPE4deQgdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpafoggGJKvsIi4BXObaEwt8m2wQAuRXpdw-rqbhxW5Q&oe=6ACFA624"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
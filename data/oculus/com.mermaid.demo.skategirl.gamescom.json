5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaXWDNaSVegQ7kNvwF5RQzb&_nc_oc=Adrx3cGAqP6EPi-lK3eIu1GWSBczAsW2cv9YHsOxT1ZOjH7g3hjbySW_4239EkXXNSM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bmEStUTloaabnImzVNgXHnPtHjoWhwegtF99NozmugA&oe=69F9EE27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lqO-wGmmLgQ7kNvwGQ0wKq&_nc_oc=AdrD03UR9227gjM9usIlRjFcuQG-E3kMKzaZVk5SkKR8Wx4_fViSyjK2Cg_Bodfm2-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oLapDEHHi__wh3EKPTSxMchhdnbDv0YUdReUL6GyAzg&oe=69F9F9D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9a-0wjYPqMQ7kNvwGxpcvN&_nc_oc=Adr0EUB1UFJeIDXbtl6JDYaRWqf9_4BygWc-0ZpxQsUeaoTqdfp1mudQuRKuzZEIFB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DqAIBKLiDmSaMTEDNUbYsz-0ffZfG7-wp8QQ9zuTkrg&oe=69FA1324"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
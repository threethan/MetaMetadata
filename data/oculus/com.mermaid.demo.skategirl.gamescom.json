5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ejKow82DkQ7kNvwHf-Izq&_nc_oc=Adoc8R-2GodbdeO4lJOms6RuYPfcn3RJZfWSQ7z6u5U7poc7OcYzd_X1b4JxdptMpMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bn23ifZaOZ7cKRW4_CUpLOzVzDjkzTcXkwXTjLdhECg&oe=6A1ED827"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KMGcX-wCHYQ7kNvwHo6g23&_nc_oc=AdqBwT-dHAv7T0h77JU4utDgiZgaQQgI7tTml0rKWzMjAY2G4FIIgJtH-GF3aS57JF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qt6xqS0yop-yE0NcImOEGhri6eMk011ZsBloR6y90qw&oe=6A1EE3D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY204tBzUCEQ7kNvwFMHFWV&_nc_oc=Adpn-L3mYKlRAgPm9pTd0wlO6CnOCuSi87kG3lsT-nN1tyldvXicljfRTD3-MDxPHrc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Mkyz8SZZG-LCdaviL3aIGtVKHwAPER-2unB3svxfrNw&oe=6A1EFD24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECyEIlNRat0Q7kNvwHNCzle&_nc_oc=AdonF29_wJfbxJtWAheY0k6g1NpB90Gm3PrVEQoMjHnWKW1H2ELsDJSRdSVihkMb0xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcCY5KfIksrfMXDlyWcOAIN49fzYL3thlSuVVoSh_AIw&oe=6AEB30A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PqjbuLK1NgQ7kNvwGes-bt&_nc_oc=AdqyuL82xB7T2WMvmMEC2gJIy-3DmnY6905bCZmvxstrh8VWhQmQj6JP-wSOTd6QFcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmnLojubeR7rPhqcT0KyZ1_2L95Uua34PjhmuUqilnaQ&oe=6AEB3C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yd0lWTlTQ70Q7kNvwGiH6iT&_nc_oc=AdrugbQtlMJlmUozuufVkbwJ5ritXfTc1E6ZwMx83WUFuuPLZjyBeX8saR1-dubKEeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuiC4zC_fq0qMs_vVeKASy8Ql85NnsTyky7qlSt6dXEA&oe=6AEB55A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
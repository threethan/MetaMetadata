5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ejKow82DkQ7kNvwE5BoI_&_nc_oc=Adpgs6370hTkup6JfwgCQqOacJuN6_uvimzQ1ACKIRApQwBta3xym-QZAR04xyz6auU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bOGSP0sk2u0qyfwfdxszZVYRCkb5SDF6NDFMOpjKhaA&oe=6A2029A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KMGcX-wCHYQ7kNvwGlcdaA&_nc_oc=AdqottbemrK8QefmcHgXbaIMBctvledytTJtVqXh5YOBNs1RH5TGrzQ6rU2qoaZDYkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76T5NsN7ChDIoUzr3tA2snVl2jhClrCd6ZJoQk1TEb4A&oe=6A203550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY204tBzUCEQ7kNvwFqpNda&_nc_oc=AdpUdwi7cbAuJWwUBpq1HgWvoNmE117N-0SmyfNiA-wR-Oup2Q6V2HErr5gMgyKrZzg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DBQpez_FsUOGjfPZ5MnkFGzClctXKzgyOanEzuNJnXg&oe=6A204EA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
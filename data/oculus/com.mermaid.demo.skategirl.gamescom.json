5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ew9S8f1TO4Q7kNvwG-vkZy&_nc_oc=Adp_9NofXv7rJqK4MEQhpsBPxcYEaod8MGdUAc5gcwT0eYa6qC374Ezhf7MKfPLDXsU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAOwdBu-amH9nMG6FjsCWmsaY0X29R1cBYvCLACoxo2Q&oe=6AB28027"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVN-zDz5N1wQ7kNvwGikZeW&_nc_oc=AdouRr-aLpM_HAUyMLinqNPN1M57f_8wgXuLgWmOPoAA421iVYu5as0hhCYKLZ_1imI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICY2UqYq1ANQeWfTo2FB5PiT23x5wKiOQTXzZyGxUcHQ&oe=6AB28BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PaXxHzNs9EQ7kNvwFsJaat&_nc_oc=AdqpRob4PqTadjI62o8w4AQzp5SD5FQC9DFL9gBINZxxL7gM4wdgTjXJLZ2Vbn4nyEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP49z4cS5WX5x39wruprEvk18hOBBYlrugwXmCaMTCIQ&oe=6AB2A524"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
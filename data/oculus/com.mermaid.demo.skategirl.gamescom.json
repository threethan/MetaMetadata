5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMMfTI6IdW8Q7kNvwH-r0PO&_nc_oc=AdqsIUgZAnmyvdjMIFqHl8apXYGHR_n7O_plwbr0HeIW9Fi_-gpF2h_lIXP2MPM9o7k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V9UdugPfO-vjPaLUcxWWeVZijqiWjR7Nbs4LlR93o0g&oe=69D7A727"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuBJPdDDLiMQ7kNvwE7AZ07&_nc_oc=AdqzSPIX3FZlp97_LR3o20EDzppoMI0L8dh8fGFwJBgDNWKojkZeCP23oJkwUpFyNhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12oaNbs1IR_wwcyPnMYHWZ13ocYKBdTewj2oxMSrBFLw&oe=69D7B2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbe7XuKUdIQQ7kNvwFXYx11&_nc_oc=AdrK4tmdw5jKLvD79Krci5TQ6lCdwAuCHdulghOVNZKdyPzDjRCW8bw9Bs0JoAOdioU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bNhFcIJfRFryHHNjEKvKXcjD8n63CDnlIndyXauahzg&oe=69D793E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPoQK3FPYVgQ7kNvwEYt0vp&_nc_oc=AdrZsPWRe-KRNBEU8eRt11hikbHvvd6cDf6gpvrkkt6FmTQ_SCFKno1tsaUeBrLABm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKabwPDDmajs2g8gDkoykor9U2y4ZqBPf9WVkqME5hCA&oe=6A787E27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CBSy9VRYX4Q7kNvwG3LLjz&_nc_oc=AdqcpBLpnQIEzOVHDwILXCBK__bK9kPNX7dAuzXWcy8Elq08GpqoKRlfFoVM6xrOaSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbtRjnuxMU73_6cylRwIQC0okhInQ_ku1c1q1DmjtT9w&oe=6A7889D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfTJ7xBxROIQ7kNvwEDBfbz&_nc_oc=AdonNnnYU0EFd_ZIqSHILxKZ0Eu5lT01VdA60LfOakMfQmyQzSG1V2ehgOoSkgRlpgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo4FZmAZfAC8o_nwQTNtGYXPaTmj5KZC9ewcTG6b-Ang&oe=6A786AE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
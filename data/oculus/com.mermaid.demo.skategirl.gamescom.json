5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrnDTBRlNg0Q7kNvwEF4v-m&_nc_oc=AdrYnjCncvUxlSOhCB0TGRAQrhC5caxYJQIA2u1JUiBSuEx53yEscdXkg5IY5LPcVzk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBe0U1mL7imoZH81Q870_ynJF_itlcIsq_ba9e-conuA&oe=69CE6CA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVEnY16GghQQ7kNvwEOm6lT&_nc_oc=AdoR_Y2-Fga3JK8f3NgVHx3aP6xyefxMYcoRzkIW_9hTX7eoRzRrlRchZ0JuMiqEdxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyb5HAalZif3NxUMLfLHBNFKsBeEj5XC0iPOXCwPOpyvQ&oe=69CE7850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM0yt_fHziAQ7kNvwGrrkJl&_nc_oc=AdrOWMhjdGHIxL2blWqHpY61U4_yXBPaLXH5WCnc0BP_qaQkrINRlLP5c6i2LqsT8-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwH3g12-bKkXq6Qa3w-4uqSD4KXIor-3S66DuGhx8-xKA&oe=69CE5964"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
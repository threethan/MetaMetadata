5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtG4ZEDbBPMQ7kNvwH7HZj3&_nc_oc=AdrpApuZtt6Z2vNi6BbXeVKem7oF9Y0PfLEWuV6uwcP4fGq83kHtRisfNTGNmw7aChk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvFL_mnQqaGKn3YhU0zKYeEhgDeiF_stmYKF0rf0-r3w&oe=6AECBA67"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PqjbuLK1NgQ7kNvwG2fKUi&_nc_oc=Adop9YFj7r_-rN2R2PyDa_w_TtLLqkOY2QK_cujjUicCKXXDjFsWmBF4EuGijWajHXo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ7NYptcx2C7dULtaxRdTD3NZiXwRAHtU-pPfJkrc29w&oe=6AEC8DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTXE9IArDiEQ7kNvwF9FHB7&_nc_oc=AdoiT9Ll269ZmV9g_zPWt0r1eZMl8eYOhBmUbDvsky3sfmXa8klRQiNr0dBDuZD2sjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVTTILsIOtHKUxPXoZIFZvkVrknPqn8-07CBjxjEGVzA&oe=6AECA724"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
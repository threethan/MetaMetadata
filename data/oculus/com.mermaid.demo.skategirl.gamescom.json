08188146670528_1893357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLNhxbsFxOAQ7kNvwEQoa7g&_nc_oc=Adp_PbeAfBdXEQSmGVsxVHob6VAqk7bip2U0Jqjqqle2IsEI0ubgC2RRxSxybS59tgo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZih2tiA99YpsE1hhh5jPwkpS-WKlQW-F8y-W7556J2A&oe=6A8D9627"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P07wN3ZHaycQ7kNvwE4oUX7&_nc_oc=Adp9CVcnxRKGJ96ky-JdKq6_UA-X336EhRFGCh_o5z0HFkpzssCchUsO8xvdTwyVnIM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz4qxNLGA08laHDeqzyku8bSDrhkbde2k_uu8TQkTBWA&oe=6A8D6990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY0GM35i-_YQ7kNvwHn4RB2&_nc_oc=AdoWW61af-zEmz-04yh90r7qMuKdiTumPX_9gsuR9XHe0G1V0Ru5TQJId-m4Gvh6tu4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv9zfgrQxaOJTQn48WLlHDIp_jsby8ZwOKre0bPfZNVQ&oe=6A8D82E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their ha
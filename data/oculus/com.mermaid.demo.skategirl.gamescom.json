5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wHdS9KfZb8Q7kNvwF9kZ0W&_nc_oc=Adq4PQ4BEHXr4GVvkZ7IjMIN3AFnz9Taeedonm9wpis2wFTytuhjH8YHLafzU_sdylM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_xcwYsG5EYl9OIcIO9Qkfv1P1p-LVWku0YzN9j8jXSw&oe=6A675AA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-0GawEduFUQ7kNvwFra1qX&_nc_oc=Adrn9PC0GBpCQ3FM8NwDta5pwiU1iO28U4AoYAgJzhINBYAuAjQohjdLLb-s1vpH12g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOII2Hmy3wg3XNtSwUc2DGHPOP25sVuOyYhcpfrTQh4Q&oe=6A676650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQnlilrRAFEQ7kNvwEKa09a&_nc_oc=AdojlY3Eonbq4UyZb4Tcf4d2Keu0xoAr11D2xOX5mr7XqeB5T_haeqlqfKAqbnsXrJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAflGkW0s97QQ74W3bMSbWBwmMuzYIvTIhz14ZvjeI4xA&oe=6A674764"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
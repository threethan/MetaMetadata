5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=decELmCL4LIQ7kNvwHbw1Ad&_nc_oc=Ado0U08o3ZFu4om3QL1d_QBkNgs34BGy9Panv76QkPgzzn03qkJ6rKW-WVr0BMufmaw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi69WiZYyS_JrYv8Za8l9OZQYjbI-aGtVx2Zeb0v2Eew&oe=69C3E0A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=typkz_GP10sQ7kNvwGCGvSl&_nc_oc=AdqZzpVWESAPCiYNg8MF4bLF8r81sQM6i2zV8IGWuXGZe29v8PexRu8M5LFoBBshQBg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3VDZIT1xjut2MMJoS5REJpWvmW8uPsDz5on-UAD36Zg&oe=69C3EC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HT3KFysi25EQ7kNvwF8jGS1&_nc_oc=AdqtFDA_Ir3-KJF0_T9v1ipLOQsJLBg4DQaWiPMpP4H2vreHOZRxBwsVWDUHunRZSNE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6HIlcqcgJy7RkNA95qsCJts_C753FOGIT3GNuG5RBrw&oe=69C3CD64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
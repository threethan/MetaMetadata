5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-JDaZCQ858Q7kNvwFdmEO6&_nc_oc=AdoQrKKZLbZ3NtMd5wGJKQxeQXnMtxuShAI9T7zwZx4QJq2zYA86kahKOEQ8r_N1wmE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C9W9WqY2kVEdmcSi9tVZBv6XblBG-nNG9FsrqZ_W21g&oe=6A2C0727"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7-dhFTHUlMQ7kNvwEeeSgY&_nc_oc=AdovXYByPVNTSYr_pykB0eztybouHN4EfHwHvJe4dTRyP-1y6mULegDyDLWRgERr9og&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gr3GlzB6ofawe3Q0d8TU3dIjOUgwz1oNt0VDLY4_8KQ&oe=6A2C12D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An4jTJiuY30Q7kNvwGC7G9L&_nc_oc=Ados9Qh5xBSUhNPmS-8PaAavk9-lv49cmelpQtZfhOlApOuVhI7AOAIPZOecqBvSFAo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B20LE5GantEOZ9meP2KqClJ51wS5zOdllzdFsekRhLA&oe=6A2C2C24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaXWDNaSVegQ7kNvwE-5tGp&_nc_oc=AdrQtykSc7U8rWxI3eyyYjgBb5WZWJ9d-0Z3Ch6CbeWfbmvDP8g5ZVK0_6vFfN24IeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2j-hSRc0met7PMqknc2BC46osyx4ib1TMA5h6gjHeiMg&oe=69F74B27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5YpdmESRWUQ7kNvwF-nfhm&_nc_oc=AdpWhH7CAATJdVSxTcTL4GmiLMg1-9zaLOIRtWknDExuOL8mfOMQ3_KmV9pXfum3OjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_yvp5SZ6qQNvXysDR0chboEXlE86Ynna_302nouCx2Q&oe=69F756D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9a-0wjYPqMQ7kNvwHkzyk1&_nc_oc=AdpTH7Bi0t2vX5E2XJfn-Y07xPo-c1zS2kNTZ1UGaqkA4lpdwsrIltPkxEmWpNHrs18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31cgMbk8KUEYnhKHIHSmcGtS2iePgU-mZw3FlxcakYGg&oe=69F737E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ejKow82DkQ7kNvwFpj-ZD&_nc_oc=AdqP4I42VbWyKnKsq2J99iSHuaQpz2djKE1ZGtDUiWrOEYEY7OCaPdOjk44tDlRWF-U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MbI59aHxH2sjlp5uo_3CZQeoArYT6Su-KnyI82gCgIg&oe=6A217B27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqHKjOep1GgQ7kNvwFuuihm&_nc_oc=Adp_FI-mZmEiST0xp-9pemL2ZMzEHcHdxHp2reXId2kZnBLL43C5UtuO9VR5V4bFb1Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gP4tlb1FHVLl2ciM2_1PcwUZh8KAnp72dNQymzsdGlw&oe=6A2186D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY204tBzUCEQ7kNvwGR7t5e&_nc_oc=Adp9YfHxPj8m-miOAuwzxxCwgAwb06obTOAw-6K9cbCX2-wW2e9o9Su9itbKH2ReBw0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VM3hnN0nTAOuFE0jVwUCCC6tePk9i-L7aQKCiPaHqYQ&oe=6A21A024"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
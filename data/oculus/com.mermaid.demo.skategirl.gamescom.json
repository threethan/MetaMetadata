5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqr0MivNolAQ7kNvwG4ajTL&_nc_oc=Adrnb1bCoomxLzrAJOTjdmUloGrS4k1qwbL1jmbR0whgE2lWZrDLCs9ZUpk3ViT26Lc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGBetYVGp3Mm9RaMLg0EGpqz5QIm10hR3J2soSKmcllw&oe=6A79CFA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CBSy9VRYX4Q7kNvwF8xH2H&_nc_oc=Ado_pQIRzJek7x01YR7tRGWYOBirDJmzAyXN-ulpM5Ik8IFhAJsuzgbNARXO92vdVP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWaU6Pfnis7yksxVsZdJuo-vS99OdwNb4V0Vi281DOdw&oe=6A79DB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lGaBmofR3YQ7kNvwGEzzL_&_nc_oc=Adqg6RbcFBJudtDBnZavMsn2_UkslppaqeEx5EBKedw1rR6hkjsgpt72_1GrLxR5wwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYtUMIPbtAhGqiudYQKq934yxPSe7IWfmMtVoFvVGrMw&oe=6A79BC64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
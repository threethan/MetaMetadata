5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbcuYRHjjxMQ7kNvwHlxHlQ&_nc_oc=AdoaY2smBn9iME2YysB6U0jENEmDAlAT6L1Z0onKGCec0zTV3LRx1dJwdafJ9vUdtuo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05F7bfESGG1rNTQutlvclt8EsnPlgSiw5Kc4qKAboryQ&oe=69E8CAA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvbtwqITl7MQ7kNvwHKQsCd&_nc_oc=AdqicEIz6jHLUVKWj2J6Ozdy_W6rLLoLPkRNy5vDHNiUplAhgMBRdaGGjEs_5fMw9oc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-Z83Q9nn2A6jE1mDfdSTu-_iH6OxWnIB_zWCkdd0few&oe=69E8D650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQXG8Y-1WLIQ7kNvwHy-PZ8&_nc_oc=AdoOXP0Zn3LVKSBbmFri3VqH6RQ23fZMdr27dtXFLP0CFdFh8NyOTK51-f76GE44Pbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31R2tKR9UJOaolmD10HhPXBtoEGlvJo4a_bosoAo2r8A&oe=69E8B764"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
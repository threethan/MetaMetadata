5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLRdPl0a98AQ7kNvwGd8FFN&_nc_oc=AdoMGbdILteJLW36UrOOYnugf8lFx0qzRXP_7-Do6aq-Mn4IK0CEf6hB8L4twaWZUZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkaXv0l9C6wGxMCCbGTBN3x6P30IntkPWSCJdjjCs03A&oe=6AF4A367"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOHSlZcgo4AQ7kNvwG_AW2y&_nc_oc=AdrJ_NKmQMBsomtXtVQj_dusLE9DbaeWdcBVT8NmToyOwGiEhr34a0Sdxj_7_l_Tn8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQPq9tUb64xkM4Rt7Wpk8GbquXB5-HHOAFQul-fn48DA&oe=6AF476D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f-Y_bep1WMQ7kNvwEh_xrX&_nc_oc=AdqUC1v5HJitCDrMcNjZkHStm2IHvME_SGAM2PUsaB6V2jjhO0z4_lJkqq_tHjFaB94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGnJKRS1xgcK0Yx7Gg2z6SCPpb8oTms6Q5cBhPzvf3EA&oe=6AF49024"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
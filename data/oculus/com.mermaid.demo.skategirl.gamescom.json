5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdnUL16CB1MQ7kNvwEec1Dt&_nc_oc=Adp3WapRpRREcVKgToTox_juqVu-rY-yvQXdr-XleuGEC3j3-Up7D_Rpz1MkAOSMKh8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TarVJBW7X7Top_siImLDrX9CVGmgIX4183qzgCsPV5w&oe=6A09C027"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyWAVzPNnxwQ7kNvwEjsO_S&_nc_oc=AdoPOl7au4wt2JLgcLOWPMpJEMN29NjGTv7-C794BBzKO3Jrbf4tNXG7X_z2LBS0DfU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af530gyOvRCRljSgNgGvIfL5sGh6o6iBKDjXEQyUFFJ3Ig&oe=6A09CBD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqBfgrSQ02MQ7kNvwH5tHat&_nc_oc=AdrdaRgowOzdzAkv-vFwepJ1ilzPCKcrelNX3KpVsfcf2Jo6llY40ZQ3J6-KbO1nf2Y&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VgjvDbSsdZXZic_HtEBRMwBmJ6JJfSUgybhQR8rGDxg&oe=6A09ACE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
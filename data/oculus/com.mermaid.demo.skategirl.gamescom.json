5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9CNZxgXSjoQ7kNvwFD64xd&_nc_oc=Adpsr5IXTKDsQi3D9D1lziJOAbMrdP7neb1NybiKjf3zGamjduMgk7SHm6NpX5byX8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af037JotlewjVgyk4CiLlpHFRk7-uWxOVa5S_6H-EaYQbw&oe=69DB9BA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEfkeMV25tAQ7kNvwHzJT60&_nc_oc=AdobsKgBVmXH0yB5wva402KRTbXHGHu2sx2iCdWkfAX1b34Tzenl_D4yza4tzlz2DOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HTHPjIvOtBlBlJ7imF6RzRzXFtHd5pY6tWj6N-Dpakg&oe=69DBA750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azlmCBPE6AsQ7kNvwEO4hEP&_nc_oc=Adr_qyc1R9-52-ENwRn362I5h4ms75sijZAjobuLNwWrYI0vwUZBgZy2HaqfhMPt5Iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DidGwjw7cIM2Jc9emN_wUfg1gn-VspdeOIdR6GBtgbQ&oe=69DB8864"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
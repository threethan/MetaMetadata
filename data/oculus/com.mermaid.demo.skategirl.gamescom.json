5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECyEIlNRat0Q7kNvwFrjM3U&_nc_oc=AdrCrbrXnF3_YcNnxZl_e-R_22dy0gCzXthS1XsfFdavefOhXIlX45ar1GWiTSBEtB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjXlfBN7bP5h_Qgf8ljbqf_1BpjcZJiSNIi7cmv0uxlQ&oe=6AE9DF27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLQg2_ZJn3MQ7kNvwHq_2xH&_nc_oc=AdqOHSbgfYKHrOKV1fvb3F-7spfSPVLi9ww7uLmzpoaxVVKxOIVPrZqQY8n0hQzdwyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWBvSH7Je84CT06Y81kGIJqv0nAu0gcGA6EUarG7PF_g&oe=6AE9EAD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yd0lWTlTQ70Q7kNvwFciAMa&_nc_oc=Adp8k5E-YEUY0ib84tbY-3T-vhjoc-UrbDRNFfuLMNvJOJAlo_JUEQSCHOvAJZ2nNDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzoVzn4Msy1fp0uCJzKcLRavf3xI3QVg1TSwgTcx3nLg&oe=6AEA0424"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfsG2GXoNUEQ7kNvwEbNqP1&_nc_oc=AdoG4IzDdg-dwNIiJFaHNFV5Jfz-O2tLY6nIDADIPOI7mChGNXCrdkOCznuNZREusfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TdjuBRkrXSLhLIQ3bUL-88AmYAeFSn_KGr_vm33_q_A&oe=69FB3FA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lqO-wGmmLgQ7kNvwE_dPY7&_nc_oc=AdpeUlUdM6Hc2oN6SVIfiCbvO2UqoJoJ5Kf-0UTHrUAZTUvJM3kmLp8763INkLk1Ps4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dFVXx50lF2TJTetcCUpsdBANr9jcIwyZB7cGAtTjIaQ&oe=69FB4B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1agMm5icQ8Q7kNvwFKvSSC&_nc_oc=AdrT109cbnYYKq6lki5UBOtoJk2fpwjGQeQv6sh2MHrZQavas2QvSppVo5_gTfDPITo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af765V0f16XR5IEnj-iOJLajA1fq_OJ1X4WNpYYcFsTRRw&oe=69FB2C64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
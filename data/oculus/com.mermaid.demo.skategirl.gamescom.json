5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvXwv32fKqkQ7kNvwHDm7np&_nc_oc=AdrJ3DPAfm51urltFJGbFvnKdjG3rWyPrux9EyOZGh5vjaeVTLAoA_i78loSPw4LYdU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_Pe51dQ5B-ySvGfkqC2M3JiGlWMI8yIxcoFOU_hlKOw&oe=6A885027"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-xWnepNhEIQ7kNvwFXuSJd&_nc_oc=Ado_YMYYvnDwt1xHfDaMcmfFh9X4J86yC2HhVZcf_OfrtfgNtubKOTkB7LQHYtRUeck&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxnUJYdp_V9kZiAcfBmNinPhWcIAnHkkbOs5SCHEG5ig&oe=6A882390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhZ7XGUF82EQ7kNvwHxX1lm&_nc_oc=AdpD_CeGaxig9-T_i3p37hhSKWttL9xrDbWZ8zn8pRVLmlG5uaf5hwpyMQQ6gOdh0y8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG69-ao7Dn7KwzBOSvMupMb7EHeBtZdhYanMI0tPq5NhQ&oe=6A883CE4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
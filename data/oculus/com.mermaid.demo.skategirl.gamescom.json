5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbcuYRHjjxMQ7kNvwHM0RfY&_nc_oc=Adrwti84TB35gNZixo67iLv55uZm_61VupM_j9zW79JkesAn_ER2yqUrwoNgiyPOUcQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21XQ6AMJ_M53GdZTLD4vdF7Kzlyv0KchLeyjrLPkDWAw&oe=69EA1C27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-kc3olV3Y4Q7kNvwFU0R18&_nc_oc=Adpsj1UYahKShAW4XTN5r3qzickLTHWQ0QzCPB-YJbcLQ2cr_ECF_HaD5zs5qgs17F4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G5HO0AD0rzqu_sdFgQ5LGjBOxGxTh4BH8TYg25ewlpA&oe=69EA27D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQXG8Y-1WLIQ7kNvwFwaeOr&_nc_oc=Adri0a4yhptsSpLwIQYk1tJlyL5ZvGnyfqbBHW1GPj8-hxhh2haFahT1Dkyjkcx9Y5c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rmQ_b4AAegqC8iJBFrfD1Dw7ks8JWqUByEJHkVmx7ug&oe=69EA08E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
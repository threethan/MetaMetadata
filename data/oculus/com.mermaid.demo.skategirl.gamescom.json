5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySxBy07uJGkQ7kNvwHCnB1V&_nc_oc=AdqHlRNKvlJs_Dinsks2zT7bsI3Jl6Z6hSA5suoWCAn1rmXu2ps2mKaj5tuFAFwpBJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2XIrOyFRrhIVVUM4PQUX-1XKyzgMCJhpSCG55yKBkAg&oe=6ADF5327"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSf4vfgYJO0Q7kNvwHCXDql&_nc_oc=AdqSzbaUwolSHYfqFlfxlSzWW2aCU4MUOIJ5t4bFQWHOAS7VuSD9Cevpmu-zzo-ASbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3swdYxzEbDqVrlTMngFzkl9cWnC6OmBUkmoBARDOzFg&oe=6ADF5ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Viri8wS9VSsQ7kNvwEWhM8h&_nc_oc=AdqlDyyWv0M_HYSxpL44cInvowBDd0g_N5VqRUvhTaOgY7K_WauFsf-eOlGUi2lUVKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkD_ORhLpuFd-uDvAi6y1Mqhiaw5-7sr530qjDKfLVMg&oe=6ADF7824"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
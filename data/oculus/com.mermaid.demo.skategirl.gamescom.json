5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIKRK_oI-pIQ7kNvwEujmt1&_nc_oc=Adqcv0F18f0WIj9n_DgKii5uESvwPFlW87dCWJTBatMlGBNj-EODu8G3UZsutbKId5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FnuNiNOANt9RFDR3tQqPZ-1HyQFUFOI5A1qT6g9roZg&oe=69E4D627"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xt3uEGGmzdsQ7kNvwHDe6qS&_nc_oc=AdogqKeFJvgHVLU7NEJIsZxee5ftwiTqxLSAjmGyC2MGrg2jucRg3tckikk03hS-UkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35stZ7f6_OvJXpxjOk8hX4qyuiW64X7CaCEanEG8t0lA&oe=69E4E1D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgZIpYiKFusQ7kNvwFRtj5F&_nc_oc=AdqozqCXwx4HIS8q1Ifu-VNj8nlWSwQHYMh0Ii0LQD2qv-Wfm390mKjURgo5hjrfqnE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V0EpOlK_HTQlhhVFbxhfJzEoIDOHoCJv3ay5iMZ8_vA&oe=69E4C2E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
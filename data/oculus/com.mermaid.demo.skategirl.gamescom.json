5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MEnGLCtJZIQ7kNvwEA6tei&_nc_oc=AdrHgvRYsZbt_G2ycM3pu3zJJBoS5HzCfvn7HIcceL5hmrPRTnzW0Ioih4B0KmF2zUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NFK-JWNun1ZiReR9sXLU_PgrApYixo8xNnR6gZ9XVGg&oe=69EB6DA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-kc3olV3Y4Q7kNvwHBqT98&_nc_oc=AdpB3uDLGxF-e6rRAa-smlIyzbKKP4A1v672aHpsTFcMlvp8Yn06o-qppSHy68M4Fmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JWw3ifACXw-9KSAiy4ti2J33LHu2eOXbMxNpCQExuYw&oe=69EB7950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rF0oDNHL1OMQ7kNvwHbp32o&_nc_oc=AdquaFeo9YeNykW4Ek6nA_M7ztzXpCNdLOFncW54-lYKgSNvBVHwJTRuHtrKLlMzaPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kLhn2IPNEifvMRd0OWKe4lWhfelxGvBsQN_ghC_l95g&oe=69EB5A64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
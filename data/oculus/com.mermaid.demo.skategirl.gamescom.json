5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfl6lm5gptgQ7kNvwFFY-Cf&_nc_oc=AdoXmzFUrKX7gCo9LolI88j62SqpD_8z-aHbP3xqVoSQfXMZWako63wmb30fDxNKSNA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nfdy9zHE_aZ69I8Jnt8E5U4H8ApGjlh14k-FOCvZW3w&oe=69D3B2A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkmquZL7Cl0Q7kNvwFRbmdK&_nc_oc=Adr7OiGDMm8XlnogX_I2eG_4292junHeBn44OoFN8agV47igVP-vkWHweYDWBXIyoGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27gDqhfvMD1NXTLXYnpG9MLby_fEL2T5GPPp5VIeNXNQ&oe=69D3BE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPEKgfVs_zUQ7kNvwE9B8RS&_nc_oc=AdqZX_Cy4oqTRRN5tVawO7xgYqpEALuxSrk8dgI2blqo-lfolxg_wjBD2RS9Pl_2rm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QbklCZV84RBKIWJ1hKFUi_rQH-9dlp-qtt_fUhSHKlw&oe=69D39F64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
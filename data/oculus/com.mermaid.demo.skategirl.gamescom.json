93357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpFcyMqq8NsQ7kNvwFm65fX&_nc_oc=AdrCeHlNmODrPq48M6EFuvack1-G9ts2GrtuFytrxaWEcztZEARJz4co3mVoZG1nuwo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MOcUA22SpF7REGQGQM3MqSvwoNw2932V33ZRYTZZWZA&oe=6A2304E7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqHKjOep1GgQ7kNvwESdGt0&_nc_oc=Ado_F03D34X1Nts5ynqMe6F60s5WGq00jJS4Duq32y74y24SoKxeHBTOvUf9rlFPTTM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PrapGNLZ4kk0ZQV3RxHcj7oZAOptHHwVe2lkLX1dKDQ&oe=6A22D850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbT_wEk8ExsQ7kNvwH-yCg3&_nc_oc=AdqqhKsXSdrdZGnEmIx3o9mo3SbXj-131iyZGkeQCY8lAmt37GJqFuz5CioM9WTkEhk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cI4c7XIBWsy7aPsSOPs8x8zm7I0T8O3xgstAgb9RcHw&oe=6A22F1A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This ti
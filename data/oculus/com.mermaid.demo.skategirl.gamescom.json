5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHwC1X9cSuQQ7kNvwHi1ll3&_nc_oc=AdqU7h2Lj18nYHc5B29ZEuCIf13YQMn1vSeIxFgvLc6gb3fMySdKrcK3et0cCoVnyik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAGbiilcJKPc8LoYGLlE1dq9aGcaWdgw91t-akHytSXg&oe=6A539427"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkQKESmf0eQQ7kNvwEfuSdF&_nc_oc=Adqu_bM904A2BgUXLMlCgXF-89CSw7j8GcoxacL5HwoxTNWYbktqXxpj0noGloKmESg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb7h8IKQz5VsoI9ozfMOP4GxIcGtrD10xMpJGKNX7qXg&oe=6A539FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKFUVoXVShEQ7kNvwHKPquC&_nc_oc=AdrZH7iRAZJDtdp9JAVjudQIwQYXpw3GyChl49LJA_GvTKR9l9dglWJfmmuiDZAxdx4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-6fBWfMYJph6gi8qWu8dKiook4HBo5lmYyx6rh48Pqw&oe=6A5380E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj9w6ipWyzsQ7kNvwE2ApMV&_nc_oc=AdoNYDD-NT9qo0Qcf3QXoxQHxnYo1-Vl7E_CfAUGJyLWFjL555syLwBCJ2xMwbyYFOY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV3a0fB_f12HD7wdbBdRHb988T_25mBlXqpxHO_uVKgA&oe=6A71E6A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aDMVLGn8cUQ7kNvwHBZgvU&_nc_oc=Ado_ujxEbjAysv6aZJiiY6bb9l6lwruhcunOdUen0B5lVe9jS025TO2CqyhA3-h9eRo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_Wm_s_9MgKNBp0qIenR8aW2SzDw8fQAtftDYnYRvrQg&oe=6A71F250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CHEy-ejjBAQ7kNvwHEwI5w&_nc_oc=Ado3vtUfobWXCawVmuHxA0E_wCFTXQ-e0CaiiQWvTRXo-1BMPaQ8aQlEWLyD2-6VMEg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECUG9uAh7IElJ4Gn_uJmkOvqB3kE2_adxgEnyy6o9KDw&oe=6A71D364"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
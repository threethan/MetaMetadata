5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRzJ3vyAeLEQ7kNvwFoidKa&_nc_oc=AdqNTu0JvGcIJfLeKI1pJQGJ4j3WD0lXGGB9dYeNFrwvucgiZnweGWMyyX9XVsCQLOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxvV6kyZc3uwrQ54WRhawJLSsqcHUITsxKIy1jEHSy9g&oe=6ACE67E7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouUOe-34Q4cQ7kNvwHCuQAA&_nc_oc=Adq2Gemo4iS3tc1CKipjl9GJDLAWpU3y9HEEPlDFQFo_mglYxY_1B63G_KEtFTSXNsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoMyI64h-GSBfItPK1N5WmpezHjGMaIxtiXqxbhLB8eA&oe=6ACE3B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zCUrxbpSDEQ7kNvwHS7dRp&_nc_oc=Adq0EyKF0E8AqE6tLRUYPXereV9xAOzEruE-Nti5PhoTdH0UmbOCCzm3pyUh-5yS0vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND30E5JN0sAoVuFA4txQ-M54N4WOPDn8L8xkAl0FJ8mw&oe=6ACE54A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
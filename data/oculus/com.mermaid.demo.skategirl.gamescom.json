5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVl1bu-xmukQ7kNvwE_s6lt&_nc_oc=AdpLX-5YTMBuljburB_3hzYpITaO4y9DMnVDh-EOXc4AGC0RPE-B39Ca4qwbf6EsCcE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCnDXJx1rVpdJSzM13KFshPcoQlDTLGc6-6mCoKd82wg&oe=6A806727"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe2qel9rVlgQ7kNvwHVtAS7&_nc_oc=Adqwq0NcYksBLeDBG5P0olVIeAnFyBEZIT0zMomA-I9E-ZwjqCDvdu39golShQBEBWI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSeQGYw4UpL8A1QGX2Nejj7OB1KBJRsBUqHgsJHO5bzQ&oe=6A803A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVgQ-ja1aloQ7kNvwEMHQ6Q&_nc_oc=Adria-7GmdAMs5KDdTN6q4KZv9kdb6V3vHhiu96SMtfhLyTwc6qUIxBZHk4oKRm7xxI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO4sSRq1slBKrc53U6oN_1KDtnEtxqzMjpWcjdBSsedw&oe=6A8053E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
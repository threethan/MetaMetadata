5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=457eo3liVoIQ7kNvwEt_-hP&_nc_oc=Adoc-hNsADL5CMHX7T0FX57trPj9LrEKIA7kDQfh4pBY3muRP_dSVZVYkkb2DRalhMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLits-s6VQ4jMQch8Wym7eiDgmNjVqvgwtIiklx0eljgw&oe=6ABBBAA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh2mNfsdSiIQ7kNvwGwJbLe&_nc_oc=AdoJ0JSTsi3YBQOswI7S5mGbTqiYIefnOjgyxoHGNh2SQAQgZpaPlgQt-zU__KOw534&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3BZMSWPcaf4uyWRXw3R4SGJcG3OS_2Ei8Q-FQynT2dw&oe=6ABBC650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_-0W-KmtOMQ7kNvwExCbZC&_nc_oc=AdoQ3OdSgPRh0xMm-SBle0RLbw8wNTKMcM08OIs71KNWNU9yWC9PL__c5OJs-2qIe_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsgfOXV6uXVtpLvOMxXzA-U4aq0omSN6pIFAugxZW8SQ&oe=6ABBDFA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
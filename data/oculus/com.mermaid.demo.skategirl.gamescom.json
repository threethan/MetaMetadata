5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiDPK8cKWK4Q7kNvwEPU4SD&_nc_oc=Adq08CFtT82MVQAInklhTdDH0lDXfcITtWQZCymW1ARZiXiIpCFIzBlRYnkLebylsDQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UHa_lt2AXfqKuJsAGhUQZYrUzioCsKqWGlSHrL_VcBQ&oe=69F4A827"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elZoB43VP2MQ7kNvwFHsfk-&_nc_oc=AdpCfowtaZ49F-c2fAstc1XtaU9jw9RQANYrCyV3X7gG7oayeUfU6fBXqAnX788iTlE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IKTdCGBLSimgMRvsaoE_mhHpg08i2XglYkHbtjGCg9A&oe=69F4B3D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCVp8SYHX6YQ7kNvwFs15_f&_nc_oc=AdrZ37R4O1RI1XDuxVTolonAdmbU7oxtiirFPppi1Riwb8aiH12e2dBBVroTSZV0zlA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pcpKC3wHgP8vbFBesvqf16CxXHPq52cbNtzrwkyTI2g&oe=69F494E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
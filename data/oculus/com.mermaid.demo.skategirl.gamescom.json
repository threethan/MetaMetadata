5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpFcyMqq8NsQ7kNvwHnIJ1y&_nc_oc=AdrJkn-7DIOC6m292rhbYny5St22IQ4ugMj7Ng2rGYwNPO3lzUaj79wFP2hHoFB3Wqo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lyXJfGDh5YPxr6-8aibHg8YL8Ropdz58sb3U9s23Z-Q&oe=6A241E27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqHKjOep1GgQ7kNvwEVX3_A&_nc_oc=AdpBsSwfd0t9YSkG7YVvVtiFriTKmZs8Yz6cVRA6GupGqqDGlGyrUDqi3iEDThq8hpQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fvLKQT5Md1fCyEp_oouPa4nty4H-jqDrG5WwBImAOPw&oe=6A2429D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbT_wEk8ExsQ7kNvwFL9mu-&_nc_oc=AdqOOl88XNB4Tu23dDsjBpgE3ooZ1aN5YYPB05yMLtTMbUgCBgsewUhsoT-RsaXY96w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JSYw6V7z58ISiMkZtVJZ8ZPJpoBjOrtmvEudZO_mJ_g&oe=6A244324"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
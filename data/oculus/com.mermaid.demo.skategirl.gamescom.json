5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLNhxbsFxOAQ7kNvwFnCwa2&_nc_oc=AdrgGsd5Va_wSVEes1I17-xuspQyxBoXNZ0OAHYDYmq-y2bNS5O1Y63RXGZLkEQU1lQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU-FKroM5oZuvDoNfeaFY7gROKG4ALODatJPdFiHThkQ&oe=6A8C44A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P07wN3ZHaycQ7kNvwG3HT9z&_nc_oc=AdoFagOVk8JrUrZmSGdkZQCzFcgMCKoYGKKXP11DcL4dKEscHScPGulCLOMueTjgQfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoXwn8ceyyUWK9MCHYHO29Ee--IanK4Qja94OiwOd1kw&oe=6A8C1810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRLtov541OsQ7kNvwEXKw3h&_nc_oc=Adpk4WqpFFWypqOGyil7W63jmAh2MSFK8nR1JvtvU8T-j1203IuC44rZfIvVfUFSzLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0j10wa3t2MYKSXRVSPS5vhj24xedyZ_KUDGppyqN9lw&oe=6A8C3164"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EarNCOUX1QQ7kNvwE5hIPT&_nc_oc=AdrjZb7eiysCO1Cp8tVtRmv-nnQGQw450YAMGTKsy-fPm-nforuaibO7bOaFB1ZMJbo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af622nbURPNxdFuPzEN2w72lrFS5HulqhyMsHdAwNP_1hg&oe=6A144C27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJWrjkbUCQcQ7kNvwEXYori&_nc_oc=AdoxdVMwI8ffnpK99ClFzPMLS4MStwq8VksSPC2GT2JnRl9iKhjyiNai791DA1RsKDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f9U5i24D_1qEJk0se7x0xoLGjkrv7lgKl8UV6GRgtqg&oe=6A1457D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZYzPIswTKYQ7kNvwEQUbRH&_nc_oc=AdrEXIyfkp6KN_MiILTyFHWybOPR1NITsYjarvFzx4RaenhZIZty7XUtfR2JtEQmrys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-SfMB_PbOXCtVEVRQlnzAnZTnkGwpUI3O_UC8vD4ENQ&oe=6A147124"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
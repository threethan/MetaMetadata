08188146670528_1893357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q35N_O7p8KsQ7kNvwGXbbc7&_nc_oc=AdrTQF_S_DeoRdfx7q3kotydRF36qRMTJWv7B0L77I2BYd3lPk1JHC0uuFdfIKu4wok&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3u8UiHPT8M8bnc7g93aqjZOcbPPjEN0LuTweDDSpIsw&oe=6A8EE7A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P07wN3ZHaycQ7kNvwEIFFiA&_nc_oc=Adqe4kL5UA5InkJASi79Nu0YTXpUQlNcEgS7LbBzJB525QaEobOEITsbsmsKCpLQm-4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR1uHeEB-NNn--moUo9LOvb4Z9yN71VqlKiPogOG8C-g&oe=6A8EF350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY0GM35i-_YQ7kNvwEX62Ah&_nc_oc=AdoEl6aOiJAW_FwGgR8s7uwfiUqmcmelgPawkHciun5mN__9_XFwnVkOVCmfNX2tMvQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyHZPB0U6Jx04xlk3mexvtqCLWAPKJNxDv28xW_L_hUg&oe=6A8ED464"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their ha
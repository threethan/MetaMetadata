5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euGXUz1Zi8gQ7kNvwHbUZYg&_nc_oc=AdpS2gDuAiOYVQot1SJreDFACLs6k4IOyCfmRAj46AD7a_S9r-rm4e1XzrpnLxN7dm0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImYxJ5x8BFF1hLyLX7xsoy_8rZRaeXtYgd6mDZ_ERiNQ&oe=6A9D6827"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05lcIBRdPNAQ7kNvwGmS2uQ&_nc_oc=Adp2pRdk_RRhNgSbmJvyUgB5jcynuv07m9eprp_t1r4QJX9IOPc2kN1hd8f0VkPlgxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBfCCLpgrPTTKkDs5U7mn5zrQQRJpV_nIK7MlDBu0LXA&oe=6A9D73D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJZ6gFA1VAEQ7kNvwFJVwFe&_nc_oc=AdrkECVLQuywKqzmG_m9fvSWRS2idNdsdt5P8lGoUSQlFdxHqk7c_AqvsKPVhiVtcYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGrYz_bd_nWvhFc9di7Hr7ctmPKQaeGjSwZIDVBpTC8w&oe=6A9D8D24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euGXUz1Zi8gQ7kNvwG8MUzX&_nc_oc=Ado1Hu1Ntnuv5OzX4Cd3aFkcjBEitBaHvhtCmW5LPKvS4TbmxLS0z8XCeAKGTXfY1cM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJWMBDC_ceQw_Z-loR04e8zks7UWsm-T5IvZlMXj55VA&oe=6AA00B27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_KjH-fUo-sQ7kNvwE2PwNl&_nc_oc=AdpijWuNumm86iHijNoo2UbOQ7F3Uj-Hs9dUnejlj0kmuPJU5VyVQyyotiFgIGierPQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTinmwIAAt3yr4PeFJwwYHYaItxmod2cEI0ZUN254BJQ&oe=6AA016D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJZ6gFA1VAEQ7kNvwEOTfe9&_nc_oc=Adq7iw638Pjfdf_uLqlpd768PhP96WrzmxpEK1YvilnJDbAerAS6BlXJq67TKp5zbuU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGAzo1xqj9wrih-XxKZ4eXzIGnl6ngKqe0OJnKUz4YYg&oe=6A9FF7E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBsXSJkzJEEQ7kNvwH2ClM8&_nc_oc=AdqiGtEW97uGT-C3WSKGXbNdGAYF6474U_9GPDVEt-CtV556CTkPTcw2ILXrdpkzSCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG-pR29tHj_E01gZKOENQcPaVpqSt-pCqhBv1pwSlh2g&oe=6AE5EAA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqkaaJGKVlUQ7kNvwH8fg4N&_nc_oc=AdoCGT2ZX_juVZ7dPG5GMD2IljIRLuOuUhVUtBVQsSA3yPbit-DLH0NQkbzeOnXT93o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqlgNx64pcZwKAylEpN91nh_sXzl5YkBkQ9DZc28n7lQ&oe=6AE5F650"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH-0GcgmkKIQ7kNvwHiX6w4&_nc_oc=AdpLAqN7Z3quYoYgnNZIACLFh_he5qMJbpVPlVfu_ne1_AzOdvKW1_-u77Nj6n-2Nsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvN9pQ7V90qP8gBafdG-3-1BQkISaNat3BrEKbYNkpqg&oe=6AE60FA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
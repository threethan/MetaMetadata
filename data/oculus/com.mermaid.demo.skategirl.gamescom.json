5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hIgtA-hEgQQ7kNvwHWBX1o&_nc_oc=AdrOKqTH6lRUd1Z5tiFe6nVtSA_jxzgGp9RyKez3XuWZGcp9SuGKQbfalbLT6sxPeRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MRSkuU_7nFACPzU-ZFuqEaZBOwiPzFnkLHpoxAHbc4A&oe=6A047A27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eEkXrJ8JDMQ7kNvwGizB-0&_nc_oc=AdqkU2ol2DbGdBkc9apG-vaOKyKMGdfhXZRj1bRCmdthcnQ694QAoCFc5OSNWmvX7h4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gQW2Qa6uXPi1DPOujagzZ5OS1K2mnJZTagp6DvXkkZA&oe=6A0485D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV-h-YMSOYMQ7kNvwHbynZ4&_nc_oc=Ado1HgZ7xdSXfV4OTE108kMCq73mwzAY_Usy19Nhr3xzNxElNBXiOUXpSocbj0A4pp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ydNAqMm1PZMuPsUrIohoxn6Gyqe8U9lBnGMox5Y9-hg&oe=6A0466E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
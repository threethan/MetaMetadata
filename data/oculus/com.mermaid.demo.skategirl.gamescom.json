5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y34ROcBw9ZIQ7kNvwFNthDd&_nc_oc=AdoBIz219wUW6rkipKwOZ_iRPUoKRR8MFvthhDxNdvqLstBSo6NGxkmiHDr0ijpdcbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k6mFlwmCdlSgJeojdHV376BIXvC478QO-R3wb_o4KMQ&oe=6A47B6A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxXTozwBKlIQ7kNvwG45mEn&_nc_oc=AdpQbC1wsbsmo14JR3sHBuoQnCuy-jlO74NOu1Pz2hBRCnBaBRhQvQyDlNtcOfgOny0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qAlbMWxC6k55_uNuYrFPIeHaJuNyO_BEeA2Y2uKQ8Ww&oe=6A47C250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi5rF9FSPKIQ7kNvwE6WlEx&_nc_oc=Adqb6FTfI2oXBwAtY8JpZFzpbid_r7n44HS_y6oj1MxHny7hNJk0wiDjlhP8uXH62Yk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XIEKNlytgID49ZMYF6RX-AEE3p6tNosNXQUHkYY53Gw&oe=6A47DBA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsUrqTeEUnQQ7kNvwE_yv1s&_nc_oc=Adrw6EUhe6sHdjA4oISClfWr-CmqB-VBNinQ44KIkXJBuUasIk4LBocPozrtRVa5Scc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TZoRbHBX9nBhFsIi_Li30Cee9slivRrkde94BqWbeOw&oe=6A0B11A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyWAVzPNnxwQ7kNvwHmfNBY&_nc_oc=Ado_Br3gviTvssdJBNARIaVKJBbOhLEZiuGtKRs_tFLR9TBZc-WP_t8rYV5t83bhjCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40p8436pcG7MmW8rxgRUP0d9b7dUYtL11GLjMaSUSsHw&oe=6A0B1D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g0F0Hdy4d0Q7kNvwG6WtEB&_nc_oc=AdoH0apkXKrxNcqjEV7DprcZ_JcF-y1qvayw5R1AYP1z3alRPGsziXKGfTUWzGMMEcw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vmdnqR-JR8X8p0dYvPAjRw3WODMAyMphwL6TKJUResg&oe=6A0B36A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
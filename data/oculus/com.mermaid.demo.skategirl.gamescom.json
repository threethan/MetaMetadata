5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=457eo3liVoIQ7kNvwEj8Fo1&_nc_oc=AdpdgoN5zGdIPIn5IRWylE7lDofuoQzrLAGE64Y02EgNzscQUazLFa4WQSOnKedqEwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoy20xKFMz4OxGac-m9RvRswfhjJNlgeeQ8jSlQsi0Ow&oe=6AB917A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHpMH3kLbrEQ7kNvwGrBqoJ&_nc_oc=AdqBLW8B-3-zDeYLRaOV2nncrf-vdggW-RyyT0ulNyPbGKXMFAMHVC1XhKXf81R5DiQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHHpOjGxA2gjDXLrbKOe1cBQ0Lh3uuad7EytVbrw9ZOA&oe=6AB92350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_-0W-KmtOMQ7kNvwHW3LGD&_nc_oc=Adrf4BLN-UKVF-MdQEfq9MQheN6rQgmwxKvsENoBUL_PtTl9ExtL0iLXABBiMXVyEys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMpummWpKXsg3iiHHVoPTpzDgIpHrYB6xntThWZ2tBwQ&oe=6AB93CA4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
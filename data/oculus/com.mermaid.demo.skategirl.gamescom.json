5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRWEGVSm9CsQ7kNvwEAKWAl&_nc_oc=AdqcDXrAYsiuyFOY6z15zJfSho65boXdp3CDQIfjroatsHxE1AlZco1odVKk6c0y1KY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj5TvNmRK0ENlW4nyNW-TRYfCOvmpxDzk6SB6PFEO_9g&oe=6A4F9FA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AASdP1ph0eEQ7kNvwFecKBX&_nc_oc=AdpE3_hboJxFpf-RAc2csRFboyrV0Zf2dNQT1CsKPwXTwtjAs7tFw6KaBG9DsA1_r30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEqA6tBt3HQxU5Ib4jIcp3LkGZI7pmMh-sW3oWU8vavQ&oe=6A4FAB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mBDtf6ngHsQ7kNvwEtdt2N&_nc_oc=AdrYDOzmHpv_CKQTFo2A2hRh3OrZzqSPbFEjBUp96wakI1452eyAwkVsa4NyUKun6E8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyC7haV7nN7cMheEALHDCfYq9RvupTec4CXIl2LaX9yw&oe=6A4FC4A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeJsIUCZFzQQ7kNvwHqNkQt&_nc_oc=Adong-2q6QVUNNmHR0ybE5obzEzpM4R_Gb2q-PXhNe6HQ302KC2KNAbaqWE-FFn3wHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Km9dy4wI6Nx7zzZhEutaEuxXCpwVt4GjNShxOn9C2xg&oe=6A2812A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB-z7gnzPZEQ7kNvwH_A6P2&_nc_oc=AdrEDOk14BZMVq4IpJeIL9_AJloZIQCp95-DLbHO7L7sr2KdPpk7LrXt_1V2PLM-rFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c8Py3YPWLXF9g79AjqQRNGp5o-mGHKzWq_YFmKxtc_A&oe=6A281E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8WnnKdg11YQ7kNvwFWdqex&_nc_oc=Adq8rLeD4eCJoP9G6E0xvBcCSxqgnq2Yc3-AX8cL_h2aQLOS2iWfOXeQdSbzTOvpV4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IuD2gKkdanbxZtwuGRHgbRW0XfFWHXSlEdZkGjNWlsA&oe=6A2837A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=decELmCL4LIQ7kNvwHWfqxE&_nc_oc=AdrzMsDDxRDv8G1R86XJsu0DhVDB49EbhJ641YuPYBSfmn36m5GFyoMAJc7YQiNElvQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcE2942bHdjFd5XtoAwYLTkEFrJBc7QCCnOuFPB2lejA&oe=69C683A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZuf8iL2S4YQ7kNvwHprXd2&_nc_oc=AdrR3ry3OU-2ydL_LqU6uMl0dm_1myZJqh8LVqSqvj_-PTwdJtRVZmUliAAMsoHEBMQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb7uEcJHB5LlzIRlzBP3QDJswhpJobdVx1RZ6i72EVug&oe=69C68F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HT3KFysi25EQ7kNvwE5zOo2&_nc_oc=AdqKiFLBAg2La1GrrDHrCJW7lGFPBdTiV3xMACrLGv-zwAUhp7VNCCwPARDBYaM2-W4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAB01ZdhT_vn6QXqQ_XEZA1Ejh2yg_jXP8sWuX7CqsHg&oe=69C67064"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
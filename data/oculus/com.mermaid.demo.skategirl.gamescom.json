5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMX6MsT-WV4Q7kNvwENp8yX&_nc_oc=AdqKWPTDizPiAJEbUKZhB2LeyBSJ55gbTN1Fvjy7Ae0ADqAodGw7WWiALZ8miMjNcSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvSRqb1tvLHt_2l5Bpreg4ZjTd6EQFQAizlZbeq2uj3Q&oe=6AAFDD27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVN-zDz5N1wQ7kNvwGFjtmq&_nc_oc=Adro5SGmTrps3R6lCMQa4fbBUhgJn2HBQq_wjrqzfIOoI6CXZDHWhGYJeim43OLM4pM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKridlHhEr0snv0FCt3gxld_MLfi0saHbft6FuQEiqA4A&oe=6AAFE8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tQ196nYOtYQ7kNvwGrYb0F&_nc_oc=AdoPTY87GAQ3uQfK_LaH5_jXYfBR8bKojCK8HOaZehWPmnnpWJeJE8r0ZAv1MBis1Ts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINkGnbCIQwH2wYv25BDsIV_UenbFlSIiFx6VDom0h-FA&oe=6AB00224"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
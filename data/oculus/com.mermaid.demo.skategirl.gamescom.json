5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRfhESlWPccQ7kNvwFEe8u-&_nc_oc=AdquCCfrtM2Ja8leLiQY01y-iGtj8Tpf4GWWSJpTvBKp2JQ4IfUV_Ez0WJsD-ie0MY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBrqor_UJc344bmd7d21x9RPalWdNj_HvShH-OMpCZig&oe=6A92DC27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2y9e9qeDD4Q7kNvwHoPHPf&_nc_oc=AdpdUcMcEadBhYArpcRnNsZP6yydVk0lrHnuI0bx5BozpV_O0Js8iQKFjfDpzjEJkrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtEsSJ_8i-a8F5qhnlvRyr7PJ1eei8Ierk63-zDPa9Yg&oe=6A92AF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlN3vFpYlMEQ7kNvwFdsccB&_nc_oc=AdoupoN-ZWkMiKqTKOq5CQbyZgFs4w5trcJPC6iZgIauHfKlHp502LDqZvFfoK2ht48&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW6fnTV13wfbw1R8PTIisDdP7z9nhDnrdszcOIA4VAZA&oe=6A92C8E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
93357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrJw79YataIQ7kNvwHMnUaD&_nc_oc=Adq2ziXE7dnx-iwnAkQB7hsfVWql17qJ_oviFfQU_bBozFIUDAjO1Gpx4CDVjAWz1m0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3po5osz-pBKTv58F7cPo7nPZiheLjYRwnuo325JixhA&oe=6A393627"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAJ1Sh__fwwQ7kNvwGs7AmK&_nc_oc=AdpdQRB1iG60t7cKzZ4-42054ODhCBuYJkVXhod1UcTmhP5-thrAR1ZhBEGpHdAn0L4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WPbMv3tJdSbRWBnHIRF7wvT1_6KDyOna1_fYNVlo4Xw&oe=6A3941D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm5ylaPGrAUQ7kNvwHTONF0&_nc_oc=Adol7x4Y6QcVHCRKPzdueZj2HTQ520Pxck-_cvzlp1A22YWjjCN9qtxhNBFn0qz1qMU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JWgfIwMZWA-o3mMRbiVLVn_B7Ot68gePZ5tBXmS8azg&oe=6A395B24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This ti
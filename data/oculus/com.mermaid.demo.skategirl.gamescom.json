uluscdn.com&oh=00_Af1J31SsvZe0nPY5T3XMx3LX5-stDmOsoKDFIg5PSlTpBg&oe=69F09E6C"}, {"file_name": "screenshot-3-full.png", "id": "539950163790511", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974568_539950170457177_5692279739160946007_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umMo7RwpZdwQ7kNvwEbe-nM&_nc_oc=Adp1wMCEyU2-g3J5E-mbEOVHuh3MXWR4WaOfgEvWnrI3ODvBuGMaIibslOgi7v-vXsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3oINonH0U3MSewwVmvJyY8JH5AjOmuWpIS5ymqs8RFDA&oe=69F0A146"}, {"file_name": "screenshot-4.png", "id": "1008188143337195", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_1008188146670528_1893357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iND0xISvXvUQ7kNvwFxwy38&_nc_oc=AdqlIkNvn8uwE-mhQxnUtXvtjnccJVNYaz3NAfE1Z8IR80hLp1ys6YYLVUwf2mG0Lko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0HnW05uVSAfTzIxdlyYKCUnbGNdoMDQ0eFNZ9xgJhYxg&oe=69F0B3A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckZVlk7zEOMQ7kNvwFO-SrJ&_nc_oc=Adr7ufM4ZzCDBXwOMw_BpQAa7dbBVw_jvChyhpavo7RSmHPuEt2ck4-o8y0st2q60EU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1aFf9MWIax_KiqyLRdtS2YDkYaPE8IVG0aFJvbsx2pgQ&oe=69F0BF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1Vl3H7gyqIQ7kNvwGzAA6I&_nc_oc=Ado3PmCPYpKdqY64bt1aCuFzw3y0kPptgtFhH0YD57CCPPTYDwR8UWBqBVpx8_RMh7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0uQ7w__lky7Hn0YXqJqo0DS_fzBtdSI3cto5szBeysPw&oe=69F0A064"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mermaid.industries/page/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mermaid Heavy Industries, Ltd", "support_website_url": "https://mermaid.industries/", "website_url": "https://mermaid.industries/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "701108337714089"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982567_3131171493807249_5478075745087579409_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJroeDDTAukQ7kNvwH6KBIe&_nc_oc=AdpEO8soJpkyT7H9d0JVXTASkcQfP0dpvqMpD19ijN8ziicohHXJyh6jmvlSVFoxLlM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculus
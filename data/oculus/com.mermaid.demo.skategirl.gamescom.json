5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfsG2GXoNUEQ7kNvwGlwK_d&_nc_oc=AdprqOlyV3lBdX0wnj-b5ge7GyuaJud7sMnD0ZwSSeDUWNec0WB3PyLFLSV7mdVRyeM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dVT4cFv2ZOVepbsY_B9Eevha9ZJnyOWL56UuEfwGT7g&oe=69FDE2A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUk5DIxjFQAQ7kNvwHYizn2&_nc_oc=Adr9XKiHdQC5mYA2mBF1Zej-BGYQz0pHXFBRIN6dZlUpgA-Sn3DgRp5k0QwPJ5ogMKI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MEnAuYRfM2THtQ2B1fi0oo4swmUuTSP-nsZJ69KPhfA&oe=69FDEE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1agMm5icQ8Q7kNvwE9foH8&_nc_oc=AdrBviTiG6Qqu9kNRhFUU6FaMkEarrLfauWvrm0Ly_Ga14FQE3jGQLVQU9-yO20PjhY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69mlrSNmG4Clr7gqXIubgKrNQjAAIHXAZW5a_Dnt87Sw&oe=69FDCF64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
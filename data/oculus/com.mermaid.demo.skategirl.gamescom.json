5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMMfTI6IdW8Q7kNvwF86QM6&_nc_oc=Adr-76pyKlXqxVQd3ea5QcWiVSN9Wcuxe0QTx0g6JGTB4YTm9uLTJmpl8frlwrnnqbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28tZgpIfCztgxTYLOIFj19TQWFYwsk0Sb4jP-vAvildw&oe=69D8F8A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuBJPdDDLiMQ7kNvwHzKjUS&_nc_oc=AdqfEQvPuDwM0ar-zrfLEh_ZK7_DEUVbVfLEsCAsqlVxd5bobbIzDP7uHrWCNOzk3aY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28c7OK1G5OuquMbkegPAOrWpplt1TvdORqoGfXQMlt7g&oe=69D90450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbe7XuKUdIQQ7kNvwFqE1Jl&_nc_oc=AdqTvZHBzaVznjV9Z65OftTkwBEDfQnTNhd3uWHWIU8v8NFkvSohja3jBbgH1qOH7GY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n_Fqcac7Z3cGxyFDao2KzY5oEv9v3bMAdcgAdiBkJ7g&oe=69D8E564"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfhuWiKmVtgQ7kNvwH_bBzQ&_nc_oc=AdodGFskx7Dw76AX9BCh-LC8DcnQjYy5ZfJNV6I_hVtgiJxv-wn0DE7vRptLrgmBJ-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y-bPNFlZMujpyhguGxiieqYdQi-gwRGdmnqOUXtjYJA&oe=6A4270A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tchZ6pNCnRkQ7kNvwFce3II&_nc_oc=AdpcedmYiMY2-gJP4C485oKwcEo-V-Ca968FDlAmulKv0C9GEfWAdz_d4TaT6TuroPE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3Ex57YkHMhQddZ94Ak1bHkIpTt8-TzhpK9e7CZJbekw&oe=6A427C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16dPDU6HSSYQ7kNvwE2ntHw&_nc_oc=AdofWodZsDcGB9z5-aZ3beDMU-B2ztCJWDJQ38ZXOxdjOyhBeWGn4uM8nD0MIkFN_XQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9Sbp1NMGOxRg5xCbZaPXRxrTIie0Y40YRDqyqvHX8aw&oe=6A4295A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
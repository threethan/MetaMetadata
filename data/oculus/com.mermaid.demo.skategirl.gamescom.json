5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96B1vSWuRl4Q7kNvwF7HJQA&_nc_oc=Ado3S_6_PCsLqPOQ7zXNaE8V59Kb38dy3bj_Oj1DZhIEFPmRIQKvNHAEDyPzbl8lZu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoAxcw9OPQEO5LO6oQSfhlGJY_cfGimvx4cm93Qsk95Q&oe=6AF20067"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oixXZzgnKk0Q7kNvwGS6GSS&_nc_oc=AdoWR1pCtNjocFBA0kD3JDlTaqLGUlNMDPA343U0rTYJlh7ZPASDVRAamHnXN1At8jA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkvMmcls6l-npXVIw45lmpWqvBSEiYnluSL_kzSbJuuQ&oe=6AF1D3D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnF2ukRQsDoQ7kNvwGNLFrv&_nc_oc=Adqi56djBD5nwxc9LFUlbn4lBhYzOWOssboXOD2nf0-bAzk-Sm-1mJPPMmN6N6YvIts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7jsxe6Hx6dyklpzWdT_3mYD4Cxx_pvc6dj_76FRlzuQ&oe=6AF1ED24"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9wUc0i8YUAQ7kNvwGSCb55&_nc_oc=AdonbxRWdOKNCzJgggl5QWrbJ0tx7pneNbIJzcUyqJQqeOjkFlULEWtVlCINy8bB2P4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-oKY2HTzyAk1carXiRIe1Q4xvbwTzHntwyR2CXYmJ0w&oe=6A314D27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecrjG0N_5hUQ7kNvwFRGnYB&_nc_oc=AdrY5zwFmNRzgO1-zGTu1YfuUliUg7DS-1A5L7B0fhIJLgbyddcDUPZN9NkMnYdl22I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kIKmUpX3L0huxfiPJjY2McQTFVzZbj6ABW8-qyoAN0g&oe=6A3158D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zShgn5WvLnIQ7kNvwHS-p1f&_nc_oc=AdrcYsWQi0esybrvKD8bfOrUNrz1J93s3ai_k-47uCRzB7vYj0uxZxPZ6pKSlHcfQf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gagS1TL74QC7Fh9iObMq8kEL-STMljQ0HwlPcnhBCQA&oe=6A317224"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
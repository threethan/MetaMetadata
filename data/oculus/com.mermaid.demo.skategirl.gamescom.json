93357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbEJeuBpeKAQ7kNvwGLnGwi&_nc_oc=Adq8ud3-zChnvH6d4bZA1k0_ef-v_-gW0ftjLircMmCvMaxiQwSa-iV1lI3nzrE8B2g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPr4V7KPmzHkUy8fagDpEY-rRVh-JfYNBnv_A7pyZ5fw&oe=6AA3FFA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaojHy5flQ4Q7kNvwGYpkGi&_nc_oc=AdqGto85dVSnzEgbHET-FihTZ8PcJO3T2d82x_i01LyzG-L2kh0MDtezsOFGuqQhdgY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKPWtSqEoUbB5ApWYVLeUq__GejjxYoIh8y6JAZxgPxg&oe=6AA40B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5PB1TSx5RUQ7kNvwEMska_&_nc_oc=Adot6nRwOq9Ypl-QEflGBsMHXF0YQ6Wi6aaIQkfeux2k05i6AzC2xWO4scavrtZbUEk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXZ7fHq-BSnRAUKOrjZXmtqcHl8fQWPdLwJjMdS8ZXRg&oe=6AA424A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This ti
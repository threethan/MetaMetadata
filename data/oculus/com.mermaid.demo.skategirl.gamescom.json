5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtG4ZEDbBPMQ7kNvwGCda2d&_nc_oc=Adr5vOFVeparorgHFarCX8wDyhsDzqyGI6ABLehe_l-2-oisTbwMZSIRvbG9QQFGVvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ-ZqfgGi4Wi-Du26WgToY2TZIAYq6qhAFqOD0XfzOmw&oe=6AEE0BE7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PqjbuLK1NgQ7kNvwHWn6Il&_nc_oc=Adr6hrLqi2awA4kpAmm7pLYryhd9B7FqzcAqAQtUdazKeJWVcvOltYlQWqG9H_dQpMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkVeB04hSI9Uf0iVMClEzK14xbQkxfm8CNiXTF6yJBEw&oe=6AEDDF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTXE9IArDiEQ7kNvwGY0AtW&_nc_oc=AdrYeJkk6BgWvFL960O_z9wObHB8Peev0V7fz_jGrgPSy7XUiips2RgGPgUi2K3P2os&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDR66mSLxFbwTekeH2s295CzyyF3Ng-Sjrg5KU_UdREw&oe=6AEDF8A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
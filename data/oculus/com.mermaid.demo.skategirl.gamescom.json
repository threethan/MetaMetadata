5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkPfu6sMiJIQ7kNvwFfbIi6&_nc_oc=Adr2mQI6n705NZzhkuW72kxcmlTnZxfXn-8pEvyQLzOOGbr0LFWoIXE3tB-rgzLwV9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgfHwwKMs49fbKu8jSume2L1YdtmFRnzpECfmjL4LU4Q&oe=6A6214A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk0itrWikEIQ7kNvwFGF2eh&_nc_oc=Adreuk4bku4HwhmtXmfZpzaZNAq2Eb0oHbCPy46GL5GCQXk2UAnnzG8NkVSFtKOYjf4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVoozXunJ9G-Vt-H2j1uEqKAPxg9u6itdYOBlW4gGyMg&oe=6A622050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQrpfGfUIS8Q7kNvwE-sGbD&_nc_oc=AdrRPrzI73nWY10EOxEXP_nt-Jbx_LwLMvY_7DoXVsikwuTGnxe-SvQ0i4rT0ZvEAJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxKnEjZwFrbxt85bq9AJwfkNS9dzzAibUDfIxcgBiiSQ&oe=6A620164"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hIgtA-hEgQQ7kNvwGD1eVV&_nc_oc=Adr2s5ZLDUXGiaA_Fh5vFE-CEyFkVwE3XD0-Cc5tgDC0mOuJGN8ZpKKMFTROytJmwBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68IhWfc4S8DXu6H-SgD03b6KG5bJgH7pUYh2WJ20Z31g&oe=6A0328A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eEkXrJ8JDMQ7kNvwH3pOex&_nc_oc=AdregAqiEFPZjsauv_ZQ-G3JhlqgwXyJ_gtUwTbNFkF3nHaTdKDlfleiC4BRxiPvKM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79jf0E2biRhDXBdvKR3gypGRqRilgTQ3j0U8L3oKTEiQ&oe=6A033450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iV-h-YMSOYMQ7kNvwHK8OU5&_nc_oc=AdrgmXdk6e-sZEfiVx8EmZMKPeTS2maQXRlCnqwezbW_ZPXgJXkv-6gcC9V8-Q6h124&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af732QUdHZKQWACYpN9iMBchtYby0VlMld_fuz0x-Ohdxg&oe=6A031564"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
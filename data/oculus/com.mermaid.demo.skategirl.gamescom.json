5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oeqNXAnbZkQ7kNvwGzgP9K&_nc_oc=AdoMHhdoUgbwVZhWNznO6HIoqUZ-6hwVQeY0WPqxeZ2ETag4R9O893_SYDV9J9IasAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxFklrimerFwd93trOK-XztTYkjoNU2Dz9CwUkqcJDQw&oe=6A9973A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_8UOk1b5DAQ7kNvwGpAHqB&_nc_oc=AdpKEWk4UUBsnsLWL7aIv6Dz9O-ArB6aFqyUXbd3fcfAt5WlHC0zPWCpzTFAyRm-U5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ__WZbUNYIDn6D72sBf6zPR9LUBU6_LP6ESJFg0DZRCw&oe=6A997F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osX7U6XSUQYQ7kNvwEyJVVw&_nc_oc=Adp8U59lTDJPUur9ZBvIeT1-H5cFX4esUt0sKsRHvZaN4Uv4bJ4MBwYvUkTM5Fveprg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFpZjuNB5361zNsUQ7f4lsgB8SO_TaETptb0PR6B2lNQ&oe=6A9998A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPoQK3FPYVgQ7kNvwGuA4CY&_nc_oc=AdqDEc0W1bv8CdT3NzYZcsxVcXblFhDVwvf1mcfgYoVyI59ZiqR2G7XljIS-OWgm8jA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsXRiJCoytMRjAU6WXl7NnYD-5xmydpmsjcuVM6DNYfA&oe=6A772CA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmvXuDB0PTQQ7kNvwFKFBZO&_nc_oc=AdqEQRg4yKnSj5oncJaHvGZHhsE38IErJuJVT-sESxyrL7Kj14oCVqPMPOnBrqVC9lQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzRPGsUa27sSeTbACeY2uHht4EZrSak6XaGysFmfRmtQ&oe=6A773850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfTJ7xBxROIQ7kNvwFHi3-h&_nc_oc=AdqDhJr_EvQzhHr4AuNhGRDOx-rSnABdhtTru_Z5Nvn0ymn7EMotBhLpBMofPv6F3Tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt53W2aRbaIfAfF-CiQtUAMwqSyZDWpbJ-Bf3cltQ6mg&oe=6A771964"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
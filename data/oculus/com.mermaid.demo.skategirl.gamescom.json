5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECyEIlNRat0Q7kNvwH2I0vR&_nc_oc=AdoIhYcRsqCpRGXQ7zPOhjua-2qBvnvtJUPhw9qKHXiRBVIob8adgsUxPHavaOqptj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJiUL6okIPOBEEj8PYPm9LrvsYz8r1K8mKMkb9EZPikA&oe=6AE88DA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLQg2_ZJn3MQ7kNvwHMqe7n&_nc_oc=AdrLT1shL2LBRTuSryvkB4_zOqF9Y4H-VfqILul4pLcmhj3g_u3bC3yB3RChMfYnyi8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfHqppO1jA_bJc6E_oJA5IX0dQ-RcHTuU-blKrNEBuhg&oe=6AE89950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yd0lWTlTQ70Q7kNvwGuzgdD&_nc_oc=AdqpBz8hVoZsssdoR58UZXXK33b0RQsdoGbSGWMYn--SQYYM9LrzOi9_xm8JZARI4AU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJH1e-a7FpWZkU_udAem6CsYtg90TtGj63Pc4E8HJh_w&oe=6AE8B2A4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
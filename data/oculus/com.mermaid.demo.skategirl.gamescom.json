qEWD88jxDT1bd83TJPJ2DZuRBkgxrUns95pn25hpGx6ejeH1Kr3LqBRJZWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtD2hEE_G4qElTF4jWZ8mcoX2SISAu4SzLNqUHGVX6aw&oe=69B2BD27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYsBGRMPS-AQ7kNvwEcLi4y&_nc_oc=AdmoP7eGFBJygvvr5Gzv3qujkI1YG3K0jqogOfAFnikKrI2EkmTincEYqCULybXPVVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWKXMESt9adhJHtD0CluWegfgiipy_wA7ezxjermc4-A&oe=69B2C8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94HVyP7jt7IQ7kNvwGwCP8X&_nc_oc=AdkCh5kBwtFYffzNltNiGtnUw_IqtJg7ygG7mkm9pPuSxSq2eO8GCJj8YgrKGDVgFD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuP4WgmQXDTVsmbypJcpySxIe0s-c05_uM9PurztchxQ&oe=69B2A9E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).\n"}]}, "developer_name": null, "developer_pri
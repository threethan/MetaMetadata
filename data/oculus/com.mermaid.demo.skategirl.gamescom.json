5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJKhIRq5C5oQ7kNvwHTCFWc&_nc_oc=AdpF-Wp0cxmGEN_enWet9axuhtrw4GV8QI8Z27Ve3G7FC0Bd22UUHZ_OkyPrS6kOd5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgFysoGdEuq1Jk6lyUQzGHlW93emMLbU5Q-lF_s-w3ww&oe=6A5B7D27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLO1seLpPF4Q7kNvwFxJ49M&_nc_oc=AdpphKlXMnGFuWruf4LoNrKJ_oRsdkRLMpAC8u8qGOgwnpfnVAkgxulQQBDz6Z4wuuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVIeaBLfVGtHqQ56wYZnEHXs64YylSsaYPqg5zYLY0Jg&oe=6A5B88D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HHddZJjeXQQ7kNvwHNssxO&_nc_oc=Adra238PhHU93tF_nOPgrET38v2Dzk0tZTYHQJKZiQWHpmNAIesX2tKn3zzM5ArBcAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsZm_FqLUAHQ1n3XbnOvrznP_hxyF-6wFclvymzbsYSA&oe=6A5B69E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
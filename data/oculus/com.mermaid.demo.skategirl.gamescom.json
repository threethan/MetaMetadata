5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVl1bu-xmukQ7kNvwF6GSfG&_nc_oc=AdoNkQzvMtAeZlmwObFg9sIpS9TF5jKRMNJ8_rjydzQFTtQ-0g4VeTvszZD-_ExlPPg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqnFfVGs0sHIps8aQBaEk7-FLnnCavvexKIJagvRaHUg&oe=6A81B8A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe2qel9rVlgQ7kNvwFFS0Sm&_nc_oc=AdqEdHsNnJNR9BwzKAo1BSVc2tTxbXGk9vk9nzp5K3AIy7YfP2V5-iKDW_1ZorwrX70&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmj0W2DqQjeqmrF2Ynxrfv8CGlOcHh7cER_lNPkjTO9g&oe=6A81C450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-RYz0CvrOMQ7kNvwHrZYUc&_nc_oc=AdpfEI_RLxwhXQSbOS3RS8JlJVxOvm43To0Bq4DBBLhKT66wxNF-TtQWrYU22cE0FJM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgFEvagLZ0k7CNkQlTuRvq0hvBshYXqFf1wZosvUQxBg&oe=6A81A564"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
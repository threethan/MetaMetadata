08188146670528_1893357280775331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC2x8hLLAd8Q7kNvwFzdtXJ&_nc_oc=AdoaBxyp-pcQ_fGpV1BGmA5fOoHfA1VjZREx3F4Tx5oGV15WXyl1NaBL7LO7qachnfA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf0z5dXXytXNVKcgkQeC_sYcdYkw0Do_34lE4MwlyQCg&oe=6A85AD27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oTA-WTARBAQ7kNvwG6U235&_nc_oc=AdpBU_8h0TK_8FIVZUBro04ZHB2xz79VkvfIAItHHCqtDLBVwTWBAi7FyAzwqqsIcmY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwZQFXCJPOPwXiIqCpel7pPl_ZOVNZ2R7DZN4tRYLn3A&oe=6A858090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhZ7XGUF82EQ7kNvwEezbVC&_nc_oc=AdqAghb6eHjbM1lyk065Dmfu0ZbXhgpu9dE5Ot3nQTclIS65f18E4hw9esDdqBCCYTA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmPt1YzKXZAC7YkkaYK3TlH0dxCsXJCw47A9Wq35L9GA&oe=6A8599E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their ha
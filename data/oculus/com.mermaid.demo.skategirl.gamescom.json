5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLjOSV3l3JcQ7kNvwFJQnXn&_nc_oc=Adp6JSrUdN048G1AdXxoxZqfEbP5VHh3mb1_4OO2e8YGpXmpteIyjZCEwsISbuXSBx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWkHF81iMG1gGEXaUwRiIKrXYC61a6mKRM0C8NgUGUAw&oe=6A6CA0A7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqJmQcWTzzQQ7kNvwFV9Tom&_nc_oc=AdqKrSSymjVqDauwNilw8o2aEdDhLGq8bGoK1VZqwsH8uD_ytUhQrOmBb_tfTLIghIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoRGe4hKL-bsbPEDc3PlBtX7sZE1d9MTRC61obLcdHjg&oe=6A6CAC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afOxQIpFAs8Q7kNvwEYfM3f&_nc_oc=Adogw4FvTL30PC2PnJFNuwQ9KdIP1MBj-qu-L29fBGe5QjtqG3U_1QIXdprXjT1Qzik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApovtJM9kkRx9GOLAythHBlCRYsi-u96AJfusHb3oETQ&oe=6A6C8D64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
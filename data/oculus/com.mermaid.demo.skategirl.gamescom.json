5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEqOUoH5awAQ7kNvwHa4KwL&_nc_oc=AdogHo2VBjT2RCVNWRcA80t5XKiYVDt6Pp8wuZ6AWmDZeIX4yMdhNBwzEezbqChyvbs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MR9BgqTCKjQpjlpyqW49yItCetyiRQVmbT5c37SLRHg&oe=6A33F027"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecrjG0N_5hUQ7kNvwEb4mFL&_nc_oc=Ado_172tmfuaZtS-Myd-WqzeiTSo-lfkmrx0_YpT8l_5CvPPHQkUDq1955YMkWX2ClM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RPnwkd8fxGnv1CdMLfaCTqRhp3hYWpJZEoTd0lElogw&oe=6A33FBD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA7J958TpJ4Q7kNvwHSHhLR&_nc_oc=AdqHfdUlnpumDYi0Yr-6xlwxr7LhWUBn37cih9gbTSXRMwQUvxNDxJ-j8dwogpeok-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0UArwONPqTpdvq84nJWmHX-HMRLYE3t26hxBzpcB1ZA&oe=6A341524"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
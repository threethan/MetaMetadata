5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9CNZxgXSjoQ7kNvwF9v34T&_nc_oc=AdpUSLCcqVO9JqSjD6vsBQDsNRJzC33m3kmyXHVJvlWIXU4n8kBe47rxA7vhfincmzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Tatj44ZT4rY7ELPG7rYDjxqK2q7vJ3ts9AR9F3NQqow&oe=69DE3EA7"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CedsDIBzr9IQ7kNvwHwsLTP&_nc_oc=AdoRbuPjAZXl7IfUDT04BtPSBtJW3PhBa3L7Z2Tc8XHpyulVYk3FjaSGU0XGUX9_zDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DltJ4hfKACXogDn4jO9pmoeizF_rfaIRGRY5-C6VADQ&oe=69DE4A50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azlmCBPE6AsQ7kNvwFa4ldk&_nc_oc=AdosKdg1b3rsbojylOslme7qHiTmjVzTFbFSNXADHBJ_SrT4I49HvR1_KzoDL0DsB9Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hVtRse2EGShgFAeOAyqTdaobJ5tm_0vHn43MFzHtR5A&oe=69DE2B64"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
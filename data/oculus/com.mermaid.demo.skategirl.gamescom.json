5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzV-9Xho-uUQ7kNvwGGAHdc&_nc_oc=AdqR27GS8IsqbVOvtJoYrD3QpSy2JGh_uzWz0M4y2SfKbrufKS6Ff3IHFdC2djbKZ9I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71Ye7l_70HaVoYM9cBVwk_50mvxoXsJ7x7T8CGN_x3uA&oe=6A199227"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUt7mAg3uj4Q7kNvwFXLGVa&_nc_oc=AdozzEIt8GNeGxZtf3wjvxCA8pM3n9PcrXp6R_oRH7qepy0AdH-Dj0g9c5OARpreacI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6S1rXlhCetrNVIF3S1ZglWQ9WvRiU2rNKr8eM4AWkumw&oe=6A199DD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVEDM01I744Q7kNvwGmiFO-&_nc_oc=AdoIIxB3-BAVwzZNBQquJeLWLk7xaddOcz_XzVB-mUA5w-cwWG_E0guKmzF3nsnIEJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YWhbn6JIcruEX35aM5u04GZgATyJy8Fs5GvIERIhjag&oe=6A19B724"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9CNZxgXSjoQ7kNvwFy1h9E&_nc_oc=Ado6C3iVraCKuOV48FNRQT2iEQ3uMD-Z-DxZmdQzDZZElaSgQIzcfGEl3cRVb3buqf0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oIId2Zoijwf8CWFkh2F_YXGORY1ULHME0Y5Ytx6q6TQ&oe=69DCED27"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEfkeMV25tAQ7kNvwFZnwwy&_nc_oc=AdoLQYek8V5i8JTTpCxjfBUT7bNPWTmwTOgFfA8K2TTh5Gr8lLuB3IldFixnqEUISHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Aq0uBuet_opZuviWijn5UAf2KQ9IqwCf08vBYU7h3Tw&oe=69DCF8D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azlmCBPE6AsQ7kNvwEoFkCi&_nc_oc=AdorS2y-dB37AWveC2ffHvqcsb9SN9Kg59WLfFIIOfU3LEvtPgWk5eKDAAUzghMqsUM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dHEH0LApFiKZlJK2TxZ6_GojZX-9tg7jfMVt6tUHfVg&oe=69DCD9E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
5331342_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo34Oktp-RAQ7kNvwG79pvR&_nc_oc=AdqRByr12RvbglL2Fcw2ayyj_DrI_CCWKyOWjptiU9PcHobIdmosXLtgjGWili1Z_jI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8xNrX1otEPA-Hif5uv7CRA5W4kFzm4_llEWtiwJH0xQ&oe=69C7D527"}, {"file_name": "screenshot-5.png", "id": "971359553716042", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031466_971359557049375_4687916655952102229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZuf8iL2S4YQ7kNvwFyN1Bd&_nc_oc=Adoj6h-YOoMgQEi8HE-f_3aIpXNYBgKcJen-i8S_1mCRZA8FjkjePg-tqcjQ2iKNdIc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzU0tBQp4GoSjRIY7vzq67ufDjilmPe_eKuoYxbJlsJA&oe=69C7E0D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumb.png", "id": "421382299121723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_421382302455056_1973832185226838256_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYOPZyLOzsgQ7kNvwFMO-hU&_nc_oc=AdpirBcXi9e-7Bm2siyGFKeoYiGB7y2Se_fpgB8AuNb2XenMlLOOgfDlg9hLDbmQ6w0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtKIOE6ndW2KSI5w6t9DPODv_w8tONQDO4RCc6BaZiJQ&oe=69C7C1E4"}, "display_name": "Skategirl Destroys the Universe (timed demo)", "keywords": [], "long_description": "SKATEGIRL DESTROYS THE UNIVERSE is a game played on TV screens floating in a surreal 3D VR space. On the screens the player controls Skategirl, who just destroyed the universe. The player in VR must grab, move and fit together the TV screens like jigsaw pieces to create a path Skategirl can move through to escape the horrible consequences of her own actions.\n\nSKATEGIRL will be available for sale in 2022. In the meantime, this time-limited demo will be available during Gamescom (Aug 23 - Aug 29, 2021).", "short_description": "SKATEGIRL DESTROYS THE UNIVERSE is an upcoming VR game where the player can grab and rearrange the game world with their hands in VR. This time-limited d
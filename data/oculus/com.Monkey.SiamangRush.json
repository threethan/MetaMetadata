wHw2k-s&_nc_oc=Adpq3CBGmIbQvlwaxmUcDWI0lZBqkh7_8K2SesSEErbw5FJpHAuLT1rt1XUxQIDbYNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FmQrHf4YTr5F-TMaeDfiopi_kHyf4_jaGwAR6cCuwvg&oe=6A47B385"}, {"file_name": "SiamangRushPostTitle_1_1.png", "id": "197087846752327", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035412_197087850085660_3612425513244504746_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ehe-fk8M6YQ7kNvwHLSFBi&_nc_oc=AdozlE051i7igYc__fL1d-btRrQ5vH0bfd2WpuDGqJ5f5GGVgPJQPJ_3B-HipKxXSlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I7gC7_Odioyae51VCnGUeZeaXAPGsD4BXtRSoRAPJcA&oe=6A47DCA7"}]}, "id": "299536126168626", "locale": "en_US", "screenshots": [{"file_name": "image_12_1.png", "id": "859573752546641", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974914_859573755879974_2517602432329925354_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUMMZJnguDsQ7kNvwFbkFBH&_nc_oc=AdovDhUm9qVR_EmPFM54n0dVBPVb7rAuL84_Om465vExiPe2jDZGyatCvBZmHKQl6y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dVndBZ5NDv6NLmqDNmuu4w9plE4_kU-QQmSRnJl0V7A&oe=6A47B1A2"}, {"file_name": "image_8_1.png", "id": "695493759295240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404383_695493762628573_4410140639041432207_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfJdB8UYReoQ7kNvwFfGcpe&_nc_oc=Adq60A48ssQClc44MDee281gHSJwCGqD9VObnhu91D_EFCnTHiXYn3u_umxlEr8QVuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CoErUYEyxjmmdzZDBv2GC1gOEy8wyOTiwKs8geH9Nrg&oe=6A47AF26"}, {"file_name": "image_13_1.png", "id": "4030172967210392", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031388_4030172970543725_8521180306965399545_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KP6UbFgotmIQ7kNvwGv0uyO&_nc_oc=Adq7A-MzntDQgQwrgDkTALg-Wj8RpipHI3gNUOS6FdyUOBJ7tVIQgatu0aOXbRw9_Zc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_73O300fLW8Jg_BKWNrTN7h_FG0GkNc5vGr3rjyx-BYw&oe=6A47DB6E"}, {"file_name": "image_11_1.png", "id": "2561140940710914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_2561140944044247_3928530101694004533_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8exKS8MTaKsQ7kNvwFEQ_sR&_nc_oc=AdpDdL4znIf7os95gKj4ej71N68B6QUe-pJZEN1RxousfIMmKtLMzKVGpRie_9DwX0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V32BO7JsGi1oxkq6bNYhdQyUH37rchFZ1ph8QXsvHhA&oe=6A47BF8E"}, {"file_name": "image_14_1.png", "id": "926081278947810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031593_926081282281143_6858027154766028008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5zj0etVw1gQ7kNvwHYg9zt&_nc_oc=Adp16aCvsI1ODwAF9Or28g_S9GhLDSPqHrAZ1Jn8ike1o7I_7fmGIjEOhgN9pvEE6vU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZWhYmCFeurQY3xJf0VN9lQIk7RpMG4cpTmiZ3Kp5eDw&oe=6A47C21E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "siamang rush", "keywords": [], "long_description": "Siamang Rush continues to be a beacon of gaming excitement, offering not just a game, but an entire universe of thrilling experiences. One of the most eagerly anticipated features is the brand-new \"Ice Paradise,\" a snow-covered map that promises exhilaration like no other.\n\nIce Paradise: The Slippery Spectacle\n\nThe Ice Paradise map is a winter wonderland where you'll find yourself navigating through glistening, snow-covered terrain. But what makes it truly exceptional is the ingenious slippery mechanic. It's like stepping onto an icy slope, and once you're in, you'll find it impossible to stop grinning. Glide and slide your way through the frozen landscape, racing your friends or eluding your pursuers in a slippery dance that's bound to bring on laughter and excitement.\n\nThis map is designed for maximum fun. Imagine the hilarity of trying to make sharp turns on the slippery ice or executing intricate maneuvers to outwit your friends. Ice Paradise is where you'll create those unforgettable moments as you enjoy the playful chaos.\n\nDiamond Delight: A Visual Marvel\n\nWhile Ice Paradise offers icy thrills, Siamang Rush has something special for those with an artistic eye \u2013 the \"Diamond\" map. Diamond is a visual marvel, a spectacular feast for your senses. It's a map designed to make your jaw drop, with its stunning blend of colors and creative aesthetics.\n\nAs you explore the Diamond map, you'll be immersed in a world of vibrant, breathtaking hues.", "short_description": "Get ready for the ride of your life with Siamang Rush! It's not just another fan-made game - it's a heart-pounding journey that's been crafted with passion and precision, designed to give you an experience you won't forget."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/siamangrush-monkeygame/home", "developer_terms_of_service_url": null, "publisher_name": "Siamang", "support_website_url": null, "website_url": "https://sites.google.com/view/siamangrush-monkeygame/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6713415842028329"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "286264264296617"}]}, "baseline_offer": {"id": "286264264296617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1698788169, "statu
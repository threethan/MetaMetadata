f20f&oh=00_Af8nBcxqROprDIemxcBH4wzEhgX3Y_GI3Wa6iuUftCfidw&oe=6A35666E"}, {"file_name": "image_11_1.png", "id": "2561140940710914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974824_2561140944044247_3928530101694004533_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgUCY6_7X-EQ7kNvwFkfjb5&_nc_oc=AdpMdDZI08r7DmPqGaeRTk8s6ikp2Ep0RoM13FBvHJGEkm2RSbdr9zZNNX_D3B_UOsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VwHZiMmL2PEL0XtWArlUpEJ3dVR2LtPNADO7ak6_9jw&oe=6A354A8E"}, {"file_name": "image_14_1.png", "id": "926081278947810", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031593_926081282281143_6858027154766028008_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJfV6oCEN4UQ7kNvwFNDX_D&_nc_oc=Adoo9lcfQIVUFbhMnyVKgbqyv7e1VxlotK9cZAzxYxAMugD9rsSlb374hLVtFs5kxz4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zanMlhqvbQDxPWU7jdHC0q-VxOynmuaNE9pemvc9buQ&oe=6A354D1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "siamang rush", "keywords": [], "long_description": "Siamang Rush continues to be a beacon of gaming excitement, offering not just a game, but an entire universe of thrilling experiences. One of the most eagerly anticipated features is the brand-new \"Ice Paradise,\" a snow-covered map that promises exhilaration like no other.\n\nIce Paradise: The Slippery Spectacle\n\nThe Ice Paradise map is a winter wonderland where you'll find yourself navigating through glistening, snow-covered terrain. But what makes it truly exceptional is the ingenious slippery mechanic. It's like stepping onto an icy slope, and once you're in, you'll find it impossible to stop grinning. Glide and slide your way through the frozen landscape, racing your friends or eluding your pursuers in a slippery dance that's bound to bring on laughter and excitement.\n\nThis map is designed for maximum fun. Imagine the hilarity of trying to make sharp turns on the slippery ice or executing intricate maneuvers to outwit your friends. Ice Paradise is where you'll create those unforgettable moments as you enjoy the playful chaos.\n\nDiamond Delight: A Visual Marvel\n\nWhile Ice Paradise offers icy thrills, Siamang Rush has something special for those with an artistic eye \u2013 the \"Diamond\" map. Diamond is a visual marvel, a spectacular feast for your senses. It's a map designed to make your jaw drop, with its stunning blend of colors and creative aesthetics.\n\nAs you explore the Diamond map, you'll be immersed in a world of vibrant, breathtaking hues.", "short_description": "Get ready for the ride of your life with Siamang Rush! It's not just another fan-made game - it's a heart-pounding journey that's been crafted with passion and precision, designed to give you an experience you won't forget."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/siamangrush-monkeygame/home", "developer_terms_of_service_url": null, "publisher_name": "Siamang", "support_website_url": null, "website_url": "https://sites.google.com/view/siamangrush-monkeygame/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6713415842028329"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "286264264296617"}]}, "baseline_offer": {"id": "286264264296617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1698788169, "statu
ry shadow brings a new challenge. Explore dynamic maps, test your agility, and see how long you can keep moving as you master the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillashadow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Reece_C", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillashadow/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24404865029208573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820648_816738057412610_2733518141041626913_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_2LzUDaz_oQ7kNvwHl_Lhf&_nc_oc=AdqF-ign9C_GT-_IcbZB18RT28W8U2gt89waFbttZeANKc7jRPwSwTA_fxYC9-E3MFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6Fi_cLOwZuDjeunwAZuvdjDMNUtL9aUsUTSx6Rasi2A&oe=6B004FB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Shadow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer",
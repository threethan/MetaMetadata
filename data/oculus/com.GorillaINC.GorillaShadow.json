rk are key to staying ahead. Feel the thrill as you leap, swing, and strategize your next move to outplay others and master every environment. Whether you play solo or with friends, Gorilla Shadow challenges your reflexes, coordination, and skill. Can you conquer the shadows and become the ultimate tag champion?", "short_description": "Step into the world of Gorilla Shadow, a Gorilla Tag-inspired adventure where every shadow brings a new challenge. Explore dynamic maps, test your agility, and see how long you can keep moving as you master the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillashadow/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Reece_C", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillashadow/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24404865029208573"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "717001020799768"}]}, "baseline_offer": {"id": "717001020799768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768331700, "status": "PUBLISHED", "id": "717001020799768"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27438827512478961", "v
lxhq3wMW14p7D_mJX5iLttO-fiGLfwNZ94Tak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTd3r1I2rmbF-5p4QpNrgxM0dzZTZwi6iOUMBtRe5Ujg&oe=6AFDE2CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horseshoe Bend", "keywords": [], "long_description": "Horseshoe Bend is a dramatic and iconic example of the American southwestern landscape.  The sheer cliff walls were carved over millions of years as the Colorado river cut down through ancient sandstone - eventually becoming entrenched and creating the horseshoe shape.  The river continues this process today, on its path towards the Grand Canyon nearly 60 miles downstream.  Enjoy this and many other breathtaking locations in the BRINK Traveler app.", "short_description": "Horseshoe Bend is a dramatic and iconic example of the American southwestern landscape.  The sheer cliff walls were carved over millions of years as the Colorado river cut down through ancient sandstone - eventually becoming entrenched and creating the horseshoe shape.  The river continues this process today, on its path towards the Grand Canyon nearly 60 miles downstream.  Enjoy this and many other breathtaking locations in the BRINK Traveler app."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "http://www.oculus.com/", "developer_terms_of_service_url": "http://www.oculus.com/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "http://www.oculus.com/", "category": "ENVIRONMENTS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": 
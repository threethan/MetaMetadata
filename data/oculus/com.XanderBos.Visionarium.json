f_nf-ThFSdb4si3Mu0Fgfped6QPCCaDgrpmFA1SPYsF8Q&oe=6A3418E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89zr-h3KhegQ7kNvwFScrYW&_nc_oc=Adq2zE_EDwenQL64VD9aDiFirpLZ6lHCjfFPFAjSsqZ9xv-6HJr_u5BS1JUiGIYvZbU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kvl-21ejhFvb1015WNZOGYJ00vYw-lKNJi-s7RyMwFQ&oe=6A34109B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUcfh4NrGZQQ7kNvwGCtSrT&_nc_oc=AdoQ5hkz1IgjLe_RB7jYEKOnHCY_Sd0PcpIWSB3yZy0LCzF_jqTEUb7JPBws89iZS3k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QydYnW_Ipw54Jwi85LWGld8wMbkvUdyArnGzdmpMqgw&oe=6A3408A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
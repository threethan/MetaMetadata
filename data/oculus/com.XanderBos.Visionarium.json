4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX8A5IFuR5YQ7kNvwGoOKgb&_nc_oc=Adqsd0Ibyt4jtcLLvuFjM425Mh3b_gcD1qZULuA7__tg0Ne3lTMY2iSohYnv8l8oR4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx1qtGkDAduQtzcde4QAFT8pr7xZ8NqRG_gmZJEXuWgg&oe=6AF5D465"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkUsiyrpi7gQ7kNvwHULZu3&_nc_oc=AdoxpqFuX38dJDnusWomlbE336VeYOxVjQ3vA9B6GObhuB8ueVBjyojwL6ncfKJW90E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRadfFxoSV6TuAqdaFV59p7akLRKVMvzL1m8gvD-uPOEw&oe=6AF5F2A7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlUsrsaleMEQ7kNvwHgunUp&_nc_oc=AdoINkYDZV80X01PAKQvyI0qglp-KYpK2uV8Ql8B0NqPGZ7TGKCnJ-DCDgv6eSDNnOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDvU6ZqwyIIj7fU2YxadIh6GOPgi5_dbaFQxMSqDRC2Q&oe=6AF5E560"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J8W_9_hUTIQ7kNvwGz9mRr&_nc_oc=AdoZuZPT8rkcpEr-kbyHPTK7xrIVS7q_g7b49VnHB2rNLe9Ra3I2RRvchnSQIcbn888&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWXFK8XMoTVWV90pgsBEzZElb0g0rcwxvd1kjkCpCOzQ&oe=6AF5DD1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkLY8M-VFDIQ7kNvwF0uYz1&_nc_oc=Adpdf8O4JfHVanfDkB9zt_dU50g9hc8BpTlhpXRSdKLttYnlqwnDCq2JmvCeBpPeMjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1V_tLCi9amAiwduIT-QoROAaMH41Kxwj0Cb-iYtkJPQ&oe=6AF5D521"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
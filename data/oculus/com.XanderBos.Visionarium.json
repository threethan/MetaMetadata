f6sOZPn4e6k529UHs7KUU-a8xV6oiEqlD5MzUKz-ECd9Q&oe=6A19BAE0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xut1BmWB-ygQ7kNvwGZpmak&_nc_oc=AdqcMRUUSbAxaTktlk4rdHuYIbvGI2Ppf170rol_VtYFBTp1DZi7SrCgcE0won5lU44&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dvucf4Bc5t7PSateOiswm2JL5kEeF2it18eXeUUXmYQ&oe=6A19B29B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ouwnv8k-qAQ7kNvwFRaZId&_nc_oc=AdoRqof40wAL3aXdY8FJi_Xgtaae0FrcxvKrQeM_3okZ9ubZrZzwHnk-DD57C-un39M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XXPdJ_OlUo2VKHmZvLQnzEf_ZGrkzJpUbs0blVIH1mA&oe=6A19AAA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
46484682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNtYOs3h-g4Q7kNvwE0L1_y&_nc_oc=AdpPZmVQm-NBpwEYqDk48CRmU379cKYEpxC-lA_v8hfP1VO0I9OESM433-4-8JKYb2w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbK1Aqs7DUmkawjj-XZAQ7Udz3gN6IZCcEiTBTCVEmRQ&oe=6AA41765"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTQAW-Xyok0Q7kNvwEaNXYK&_nc_oc=Adrs0Eu_ADPmqLOekQ9vOJAqLIqyUdY3pMJC1EEbl4168DkkVfJHPCbnFpZQCuWu6j8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA7xdHIQJISdzHpx9qj_ySiX19lSS4LolpPQs80DwnCQ&oe=6AA3FD67"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E2_TIi3VZYQ7kNvwHzNi4m&_nc_oc=AdqArPvCDCJSOX50zvIHfLzJUivdcnO8HJ4GzTxl9jen0rQdqOC_sfFh8J7cwn007So&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWv7CXUKemI92_8xcvV0yUMHZVYAK_0Kl0t4ZYb-vn5A&oe=6AA3F020"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYpaVk9GOPcQ7kNvwGUm5kM&_nc_oc=AdpBHwrAvYIOXrLbGtHraI7uWzbrBcHKr6VoFJzTAHeuRGvJ_m7AISx43jjMDdalpEU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI60BLwlFGc5zPgI3Jfg6Kb3-fyD3WVN7XfY0QM4oQwrQ&oe=6AA4201B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3wwGwA24XYQ7kNvwGkWRoW&_nc_oc=Adq-sfSYOW6bx03D7rvVX7uzWOb5H9yYBzpOQF04Yvu0E7AL7AoaZEwwWr2MKqVO5B4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUo8KtNQoDbIGcZ8rH5B_aZGCnPLD8Oz2AqjTU0gneLA&oe=6AA41821"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
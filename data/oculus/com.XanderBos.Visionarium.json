4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNM1qqTJBy0Q7kNvwHknsqN&_nc_oc=AdrRO1RQ8Xcul1fjRRdUeNbohXoWY4dYTaVqpmFyjetA5ROu3Cpya7TdZ2X54htUYc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5VCN32efrw1B-GmGoEahY6EqA-13Fl-_rz2zkhKYUrw&oe=6A9C2E65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv6AKau0lPEQ7kNvwEn7KtN&_nc_oc=Ado-Bix3eGwK1_lAH-mnmOSRcT-p94BGqObohHSlIyCAOjP3tDczrZfx2MA7dAnGnPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxsxH4tYkJTEgwPthqhENLTvxTSlEQUOjGSpZwF0UV1w&oe=6A9C1467"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIxy6uI09dcQ7kNvwFHoyS1&_nc_oc=AdoiQzpkJ_TLSMIDo7lFkhuaClbiA-JMishHDOSqtyDMrMsDQQwJ9hMyYdHynohJzBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtz5iBlJp4CwkrQmU6pCmtNtX0YwNfyoQuQWeUCCC5BQ&oe=6A9C3F60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mgFJB9hNWwQ7kNvwEcmYFe&_nc_oc=AdrngKWtBy41tjuccbyXsvB5PxNmpW6kePmbyOg-3mElgSFZPnIoMNS-hp1Vbz6Rnbg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmXgE93ZRmgl0Doeq6YxBY6JSHe0uck-ewjVeCm9ty1g&oe=6A9C371B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo6W1Frpda8Q7kNvwFhFh2m&_nc_oc=AdrvdNw_nQtkPp2dsjyrbcIQuIkt3tOhZ-we_FOI1FHVB3yB1j2OSzJYWDS2aXsEu9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJer9IRmCIxKwxEnLjnvWATcVnPwnfd5TBttQMq8xvajg&oe=6A9C2F21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
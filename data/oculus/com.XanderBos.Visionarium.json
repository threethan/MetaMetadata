1532goyLnMEvTev0Zr4wOYJpKX1Bmp7V5GR_UX5DjtYA&oe=69EB5E20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gg43NejP3IQ7kNvwH-cMx_&_nc_oc=AdqEmS80tPFxNUa9dKH7NfNKn_X9jMBKwGlc-fN92QVv_bckGxcvkWA5IJNs4Vl45Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Rtbwe38eQm3EpokdFWdhsOibQ-DwNyRLaz2wDRRfyrg&oe=69EB8E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ40zAyJAucQ7kNvwHo7yjS&_nc_oc=Ador-FaHqSf_aCP3AbKQo3Q1fi_H03Mx-VQfz4SkiWMibj6VwuojDUbAkub1O6mZAqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cig-DQuVWrYLLfgchTzAkXGftJUYInJasTY7WGZSp8g&oe=69EB8621"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
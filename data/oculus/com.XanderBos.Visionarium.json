4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLbny0TBK7wQ7kNvwEbK8Vp&_nc_oc=AdoHwK_Niarwr_w4T-JANFs56-jA7au6NFz63qdUxDaW9To4EPTA9zY4ExfroykvzYk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL813BUGrYW22shnEaN72GUlWnIM4w0Pg3igs98cxJZ2Q&oe=6ABD23E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCyJ6hRj_LQQ7kNvwEP5XLz&_nc_oc=AdpxyQ5UkIf7V7NItZCLh8GRI9knMA4u_rL7MmIFD8u7Ges6PVex7t8dloI989hcrr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8PtB2eI13ozH0GiX5y8twpC7DIyhGBh1z1_VQWaCSjw&oe=6ABD09E7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAakYraQEb4Q7kNvwEe46Ub&_nc_oc=AdoICFGL4GFHp9z2T5OE7IAK1LEZf_HJa-UGZF56DzKoutOpuZDLCvU8GhrlL0pVUgE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb6jc4vLzqZ23lI9GLEdY_MyXgUdXY7r1O4HwB4kzmaA&oe=6ABD34E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZT3I33HzywQ7kNvwFVQFJg&_nc_oc=Adokl7k1jYVvudq2eRTVk8lGxtCYJrmAK9yNYxpGNTEQzu_rL1SA3WWqgmJ40IYG2_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmArp7Er3MEP8texbB4kiPq8LMTV7KXViajQ9iblYqPA&oe=6ABD2C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ccW2BGB7PwQ7kNvwHcLCRV&_nc_oc=Adq0ogdJddp12HCPCfuUehiXksP9jyy9IB5lHx97ftLOc7vxWNviEZsEo9aHnLzLvrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlfNQbAnUXohfho-FbYyCHhW-h9DxB9r5dTi2bNlNYGA&oe=6ABD24A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
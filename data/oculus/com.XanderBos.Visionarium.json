4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmJZO_fvQ90Q7kNvwFFn-Xf&_nc_oc=AdpYrsYdEK8iwHrWSMFXvmbOy-u8dDiK2drUQE9H84zgk42vnjB2FrqmdxIsOSQZjh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCnzEi4PbE3A-4xeXf3VazfXpnio8Y1WmsmMSYme5jbA&oe=6AF482E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkUsiyrpi7gQ7kNvwFYLdWx&_nc_oc=AdqTqGsXcX9A5RIY4Oo1myVS9INuFpT_vNZwhCmvfiDAuGjFmF_wVfZtpM_lo5cvCmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7KJBT5cSzHQTz-Si4op9_8emIxchg9y9sSIqbhxzhIg&oe=6AF4A127"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlUsrsaleMEQ7kNvwFrzeWS&_nc_oc=AdphRVtaVwUeIJoBeWyoSgyUZ9Mk36aCSVzyzYFHMG2-Zja0SoDs189QHLg5RwPwi58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjB9JrsOvYk9zMZjLZsIiu7u_CikI5gK9PhmT1XtUWcQ&oe=6AF493E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J8W_9_hUTIQ7kNvwHXePTK&_nc_oc=Adrl-mjZZln33sdUBXm_lzBmeG8NM8N2AhPz3f-M4F1xWBVpoyynfiOXpy071mgd5iY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlEU2_Z1vGrSkJ2nRzWofgKCUwTMB9tMFkASvKAFAicg&oe=6AF48B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkLY8M-VFDIQ7kNvwFSaFPr&_nc_oc=Adq0Tm1vIYNOlY0x3Zrzo7I4I_GhmJbj1P5tckaq3x1breBf5APnTutbgAuKzWcE2Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_CxEtSvVFlOOdYX0Ou58E6Rwa5ihO_kQmLAet2_uGjA&oe=6AF483A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
QErFC2kpw9YAkH6GT3imEMU1ga3zkXBw_n3V_29GVTa4Q&oe=6A79C020"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4qCRxC_UY8Q7kNvwFM9lwM&_nc_oc=AdrUHaH2UL-s2FonC1pT38LTTu9KSwIkEyrlJtcBKWg27-KAoHBGE23G_SU86Axl92w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQHEaolmANuomjqL1jIN3Tmvpa-yHDUiuscTPx-7CDLQ&oe=6A79B7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eaSn3quZxsQ7kNvwFXGCkB&_nc_oc=AdpBR3dMUhn-DELEaVNkm3KfsXiciAV-QRb1CpjKUKDguXiEGxjEgBZBEK6nJq9sAbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvEVgXPKw5CE_1VrEEapIZg_BdiioKK1vI1UGJtPXUtw&oe=6A79E821"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
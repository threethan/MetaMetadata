f_JdwuwCbEHlED_AEHKtTQl1RMGASg4j76Vac5U6TTzbA&oe=6A3D5360"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YuR4zw8k4UQ7kNvwET8FsU&_nc_oc=AdpEUAWCFwSolFngIU42ULNlALcLUg3jJ7QKI1HQu2BXaxzXoJaWUz-xYVpCYoOD6MU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cdOX5T-5MKgVIsJJuGQ8B8wpTr3BEEDOB9t1y7WvaPA&oe=6A3D4B1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvVjiZfs4QIQ7kNvwGPHHDS&_nc_oc=AdqcJCs1daA9V_FEAPstn83-ISwuZ2Aai-J7L0qLJoaNzMABKwoJkdKOR6qIPC2NJAY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--ITEbL7jlIMavVfx_Gobn6CsIAvNwPEOpmWsnLjTYNg&oe=6A3D4321"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
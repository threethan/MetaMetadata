3ER01thi-C5N58UBGwvHtyS0r1OyYVApUQvrAk_YlIug&oe=69DB8C20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOOlJRkNxpYQ7kNvwEtPGp6&_nc_oc=AdoHy-j5Y1A4OHBxjdLCAfYDzc55kSX0-u-_gwL3-QElGY6M8T34PTw8rCcbqFn5vhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35QMniz81PneyrDzCm894nMzd7Ia2YYY_7n31Qpd-3IQ&oe=69DB83DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrwH9bPDOZYQ7kNvwFIqY__&_nc_oc=AdrjYWVe2L0IltE2URdJgRVdNwSn0Q5XVN_Ba1vUf0vCS1dk3vSV7DogRgX_7_75uqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dka8617_IrL6fwQnvDxJK3YgErLbk_QuVOlBmy2QLHA&oe=69DB7BE1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
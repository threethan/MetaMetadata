4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3huHHcn5boQ7kNvwG2Hzt4&_nc_oc=AdrY4eBFHHX5KDaHkIXTwXDiP2WBUj5_JA9qsfScjW4ppwS1dxuS2dZ1xXmw0JcyW0A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2j7v_qGDBjq8_uOKIZB1LmBWEF39bzCa5THQMH4tjYA&oe=6ADCC7E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOfHaj5Wy-0Q7kNvwFckyMM&_nc_oc=Adp18JlQRZRHd8q-vekl-FQFwOAOKJ41a8qgKAWZO9_m6F1XhjkBSrwDKVw4zh-LRCY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNjCbl-rhup8YMaUiO4c5BxPu05ssk48QscbjSCIWsDw&oe=6ADCADE7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8uiIWFZHFUQ7kNvwFr0Ww2&_nc_oc=Adp33Iocr3x3uUGqqJF3hJVlyg_uRXhYibojSQW6j6TKXJTWcUkmEZJ4pX42uzd4nSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlmCprdPDuJ6CHrkyv0oFyGUxYS7m10_NKoLNKM3iYUg&oe=6ADCD8E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXQgvSQOH28Q7kNvwEmfhoK&_nc_oc=AdpxwjkuBri9RlTqKU8ySmFSIEWZ3V5PtMwGuXrgOzjAwXfpeRHr-41qq2ecVK_2ElQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcHj3aaCiey-XaaCNkyNtCXNWZnbO5tCqPILGTFC9JEg&oe=6ADCD09B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Hg0ueKwl4Q7kNvwG50D5M&_nc_oc=AdpkUhg5OzepMQXjQphPYz7SROFYVZo8h5nchYU1mtr6x-nS3x9z0NwxRbM52OCpJ28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnXWf0uLCwZj41pLnqRJXGedoJcp1p0_UOMjs05CRVfQ&oe=6ADCC8A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
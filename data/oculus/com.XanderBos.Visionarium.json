4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3q6hrSL74kQ7kNvwEzGqNa&_nc_oc=AdoCQYK_NMHAbQs8jJ08H37DikNnw9siD8sRMteYEtHEkICqOBkhJpg7f0CzatGxEVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlK4vqwbO-_4TAquK4qGXTUA_rzQlE4ia8nysKGa6Djg&oe=6ACE4765"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbDuRxVFuo0Q7kNvwGvcR4H&_nc_oc=Adp3TiZnwDmZ1BCszco9HEa_vLwH_GeGY1IRZqqyBkm-A9eFd_kHWPuP1owBiJ3OK_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzUrmPS9OpIGoT8Y3R8paF0CVuymdh7hCqYBCJyVbmVg&oe=6ACE65A7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwACoRycHxUQ7kNvwGs4NlZ&_nc_oc=Adr1Y9PAmkrurkvzcTdHn4T2s7y7dmAYZVqJelHQ37soloSwUslHHi-cgZ9mUNSvPL0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmeFwnmDBVY2dBFr2PSgh4bP-OxSYetC6seGwVDNk_Uw&oe=6ACE5860"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn83wUjWmscQ7kNvwEG3H2K&_nc_oc=Adq66avuthBGnA9Dl8zevGA0zPuV4xvsO6YHJ7MztUMM8n-A1H49gdh28kpB4brhHVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZ6PS5tQcj6T31ZoyFQsXOO8jSsWf9KqrabUcfW98f7A&oe=6ACE501B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yjhF52KnNsQ7kNvwFkGA0x&_nc_oc=AdqzyZu8x_xhm36Ak-2awQSc0fXqeqPfdOL5sn0ScAT-0RWvHpLiXxH2iwFZE3Y5AOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIXFcSnUT4HOX8FJxjF9ELSfZAyYlGVTkp42aIJ8U38Q&oe=6ACE4821"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
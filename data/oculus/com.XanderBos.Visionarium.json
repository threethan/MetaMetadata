_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8WKIMnXkGQQ7kNvwH9NXDj&_nc_oc=AdmL1WJ1aI_LE8-rFtJnujQlgaSPS_mVaoEAMqh2GCBxQWyFu5i2UVI2vvJr9TvqThI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afytj3Xx1okWbUtoy0BN2yyAvHZS22a7qB8iWn2GLIAedQ&oe=69B550A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyNS1RmvYkgQ7kNvwELEXxk&_nc_oc=AdmZwJyDdLyAdb45BEZql2a2Ez_4baqOWeDGcYxwPyYs_OKFUT2xdxNDIhtLWwYH73M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmtAtVtrNwfKkn3IH8NNBLr4wq1SBCD48w-l_hPJHcVw&oe=69B5485B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYTv4cQI6xQQ7kNvwGo5CxW&_nc_oc=Adm5b4Nyv6t26jxGuNTnoq8f_O9gtHfYIAH_Kmf89B1Bd6wWc1rN5q9Q2rlQlErCMLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDlkD-vUc2FMEOVsqYsFupikiEProUTVV3_v5ttWP2uw&oe=69B54061"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "821316815620740"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "3067911930074703"}, {"status": "PUBLISHED", "id": "2262536724239898"}, {"status": "PUBLISHED", "id": "1086604060162127"}, {"status": "PUBLISHED", "id": "665351429921031"}, {"status": "PUBLISHED", "id": "3070764899765260"}, {"status": "PUBLISHED", "id": "686179403831139"}, {"status": "PUBLISHED", "id": "438926609302463"}, {"status": "PUBLISHED", "id": "1078343597418335"}, {"status": "PUBLISHED", "id": "1197375077651555"}]}, "baseline_offer": {"id": "1197375077651555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "3067911930074703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9600940486584961", "version": "21"}, "id": "3396212103958754", "channel_name": "LIVE"}]}, "is_
RcdW2KuXn-67mOgdPeu3g&oe=69A18A20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk_5jV7AqmQQ7kNvwGex4I0&_nc_oc=AdkXtBRRra0legUA54IzikVgd41nMNs1xPxECoJf-NtoTduznPXmMxevvWp_W9eRxjg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftiyCA8fYD_jVHznKzM6LFVDs_cFSwQGDAEA9TqFewsgw&oe=69A181DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxMEc8wqUFYQ7kNvwHlx58-&_nc_oc=AdnHvnKAR75RaSNSiHFcnh_7DguljsoS1LAJlmB1w-A6O9kYBsq2UEpLbTJU4iOQiLY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuEucp4TSDOY9x8-FV2APQD_KkEgclygzHC3Iz64UnB8A&oe=69A179E1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_p
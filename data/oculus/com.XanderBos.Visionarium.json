QG-idqvwTawxaZRQYRQ98944EfigjqZJt3kIShbd8Zt0Q&oe=6A7B11A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4qCRxC_UY8Q7kNvwH_xZUM&_nc_oc=Ado4DmwpT3kTyhnmbW0dD_M1DZBVjVarV2fdpekCb2zW-vD5T2ke0HU_UhKa4MiFJGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgbi1OkFAPmAxB8w0HvSpJLRqugs_29nswvwfgRipwoQ&oe=6A7B095B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eaSn3quZxsQ7kNvwGqizFH&_nc_oc=AdoXVA-33ex76NuzmDEziMCojgJr6Vh9AtPQfsXxjDvUYKUi9UNNTG0U0Wi9ezM4McM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2LavqeD_NI5aujGtUeRuxkfkk7CxZpk31YHyiEDTDkQ&oe=6A7B0161"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
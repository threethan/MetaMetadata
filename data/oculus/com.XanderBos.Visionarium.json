4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsTGT-Pk9DQQ7kNvwGnPvB9&_nc_oc=AdqS6z4feSiXy6o-wfxGUUXuissBUvKuT6qdpCesz_GSt79zcOKL4_6bzeASm45WeoI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkIWNpBBx6RPQbSIqPxNMZGxKhL5kCTo_Z6wbADGmO5A&oe=6AA022E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnvJKke-41IQ7kNvwHQxRoc&_nc_oc=Adpu-0RfWfmjq2hy1YPNN29rXlD1umQWP9QophriMvQS2jwQNQ0scPqdcH7RppHn3ZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhwV9Tsx3pCIiFonvDnhw3DxvKoqJ-tuB6212K4jQ2_g&oe=6AA008E7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gim1WKzFwxYQ7kNvwE8V8ns&_nc_oc=AdqX1eUCuVkU2FryaB1H5kTsbOB7CPJRlMt5gZ_NCwcWrbGryyUJxCekFO92Ye34mXU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbjex384oJ2EDz4pQxfq_UgdlAwkdm_voNqZlyU6pFUw&oe=6A9FFBA0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIwI3IgLXDYQ7kNvwHprgzJ&_nc_oc=AdpMlxehzQfzWKXKL9Tnal7yepC7HkGASP6dv3cxTy0EkN23K9pW6-cttbQUgQMCsxM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL60B-iC5jphHjPYSjFpOCGC_F1CoRWgRKLcoJiIReBA&oe=6AA02B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1swW1obz0IQ7kNvwHCpE6a&_nc_oc=AdpVRc3rKiaNbacKAJKJj1eM9jrrmoH2LMaxJYb7BWwz70HCGhnAVzak7ssjULFLRRw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrJXlUGuNkLGUiapWAWJxZ5Nk-rABQw95TtfjqeqgWug&oe=6AA023A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
1jSK4mjg82XGxZ4frrKTtG2rkNIL44SnBsvApSU7H_9w&oe=69F73BA0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O3ypicbJ-0Q7kNvwGCuxgG&_nc_oc=AdogVRai1_oCrdC8WVeneRK2AutfbRqENv8OfZV_xQ7kyShgh7o-750FcPzVMWP0dHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3R0lnpI0jm10xSObkg2MtCb984Ylj1ANhYz2RSbvT5sw&oe=69F76B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20kuMhl78KYQ7kNvwFgspwz&_nc_oc=AdoTFAS_ICXh6MYdcA_BNApFQi-930u37v-245wsXIxvqCfH9Nn-TLd7k9lnX-ZRYEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ALltOQXXsgX353RYT7soNlSz3ra9vqZqgnpTFGT0L6w&oe=69F763A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
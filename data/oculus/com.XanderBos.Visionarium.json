QHVCAKXfmIexoHa89IGXCIHFz_gmWD91wPbxCO-ok7PVg&oe=6A7328A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWV7Wzn-o2oQ7kNvwFAUfQx&_nc_oc=Adq14tWc5sU-7-godMlmtDsZrakZWpaFY79uJYvJ4-CFw35w-TW-8ocsyv_7dOhcV4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIyOLeoqPSc6iPtNfXK9LHPWsSnNHWtZp2ygMgLNlvFg&oe=6A73205B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFSjLTMVsWIQ7kNvwHU-t3-&_nc_oc=Adp4heI5cCZG6IJgNpmwS38cYIgKkdEfrekbd_oiWSuXvDgKZZZao6_vPw9aAqA-qE8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHBuwCm_xU4ZBmPmwc_9-kQWWfiQTTLdCkYg4-g3yVlQ&oe=6A7350A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
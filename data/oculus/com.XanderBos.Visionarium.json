4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3q6hrSL74kQ7kNvwHnGswh&_nc_oc=Adp29gkeogVNxc4elZmPMXDs_UinltqU80aB3SsSruY18FCE82tI3tB4G3iHDv8s_bA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTj2guB5NLBclgtOG8ues4DpOPHTvB_6Rwf7Zu97B8CQ&oe=6AD0EA65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNcaz31f6vcQ7kNvwEM7ix8&_nc_oc=Adpp9L5Z-CS7xo9NJYNIM8OMvf-vsH1VkuKRcBt2uE1Tp2zfI9P4eXZOPjT7RQOIVpM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzgPIt8SBEI3MYP7Z2Chk5X3E6N2AqnAdGeBR3y55rTw&oe=6AD0D067"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2NbinRGXIoQ7kNvwFsaRTA&_nc_oc=Ado4p-f8iSjekSqybPtGYtB_ybOMThq4P_PFBx-0J7-4zYEMJ-gIQk60LPr599Imfrk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM75Kkr0vGdJmH-mkkS3QMgg8WYiwJfyJOfHCODdaO16Q&oe=6AD0FB60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMD6UlRIu84Q7kNvwHENOkR&_nc_oc=AdpHejpWXbNAKRwK_L0luKtVyQex6ri84WQKH_5_3IQUVx_W1sUnIkgp-HmXdi-QyF4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF72MAMwXJHNzbEIr7furCFlJ11-P6m6QuJySmbIoirA&oe=6AD0F31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0a7Bg9uH34Q7kNvwH7isj3&_nc_oc=Adpa8MeXb8HZ7_X0tsomzK3OvVjKZewSsE8AwE9Yt6zv6yF2c04K-aG9yfMazjb8h3U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4IdwN08OP_W1PsxyddxltrgKTyjc8pIJ237aF2wnhVg&oe=6AD0EB21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
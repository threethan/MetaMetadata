4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCJPQGoDWPQQ7kNvwFqVqa4&_nc_oc=Adq9O0OmyfffzXuiK4ZTl7mYYwuvsbCJuKcbQ-cjgs2iADlwzLAqzpFlCY0MZG7vsts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_18liGPMoBd7Ynp3q0QBvJyo-FLbT5m3zo6PomB8D6A&oe=6AEDEB65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFmGGoIJ8KMQ7kNvwESuOny&_nc_oc=AdpsbN_ECrUJwzmkMtyjrEQ8jRuTmz01YLnWf82PQm5-WEc4rlm2nNbasO1Is25nZdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbvhpHwifq8_oWOiHhgvCEzLcG6JLizNbnDy78GpH1ow&oe=6AEE09A7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pipc_GBfmMQ7kNvwEn74Op&_nc_oc=AdrcHIWKFltd7w3jh-5r3tyzXiDWKLUzR9os7hKv5CnW5qYz1j9YXqjpBD1zbICX5u0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSckJ3QyKRat4qqpNAKLoPe70qxttd6280heHxdvZqfLQ&oe=6AEDFC60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMgzUsjuQWkQ7kNvwGXQvTD&_nc_oc=Adp6KgSYUhlCVok8BcLDP60KkKd_B1ZkTi9xCFRCyuBdQ50T9RKZiLsqwOOvWx_arEs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7P3qH7VpmuQOOCM3QQTmJ7l5yp0RMHVvUGPcTd2e_Gg&oe=6AEDF41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHHTXNdXKzgQ7kNvwHILjUn&_nc_oc=AdqVxZlgIFq3KMgYPchYGC8xdnjjs_QTU4gDioWp28kQo3RDlWNtYSIgTuiZVn6HgXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYVqYWZRt9orQXBlyS7gxLan7bxAySsZ95U3jrSweAzQ&oe=6AEDEC21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
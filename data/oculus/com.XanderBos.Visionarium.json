QCULXSQLtFzGNyYaIJOxuebm_AzX2F_wb2_bJ_itlmcMA&oe=6A5119E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G60fwcqorZEQ7kNvwFxxIEj&_nc_oc=Adp0MwsbFL84xfBeRlYfpou6sWyuhiZv5zyVdPkggKa_UAuy_4ttgqWaS-Jr_HOIQ8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4mCc37fnVSRAdIPwZbrtxZl3rIXZ9WSNfIJA7yKkpcA&oe=6A51119B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTAOxCuiT9MQ7kNvwGLMpQk&_nc_oc=Ado-h6a4ISvwrX_hooBxsn9AoH096_XZW-7FtZbaA4DIy5w3VQDgWnJZDamnAEeb72Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt-lrLO5zgz4aSGmwdXKUCGM3e846DZndJzynzv41AqA&oe=6A5109A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
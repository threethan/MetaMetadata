46484682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZuT8GfKtf4Q7kNvwHHgIoR&_nc_oc=Adr1iozZGQ9ynWvpDsA0fz9muawvWa8IetTntDFB-HRxjwlPrCvdYzrBbGuBpZps8Go&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA6mEmjfVh0kipH4hHfsto4ePYA_QJMH98UrrTcxbJ-w&oe=6AAEA365"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-PNwwpSvHsQ7kNvwGhrj2M&_nc_oc=AdqktOUS2x4kApuCDpTr5lMsGFhqpmzMP2EmabMThvgCNEfLsZ_b92hYshLUYj6vj8w&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8BgKLQ2MgZfMEXM9lkR-xftpa4vqqGe-g6JKMuY0U6A&oe=6AAE8967"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfTCwXWaoboQ7kNvwFXEctV&_nc_oc=AdpRk_cAnMgKVYzp5UsrBUSQeQy3HWbb6f5yerIkSaq1vhRgxAbOoOe8nHRle6WI-Bc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7gWp9pnQ4cz32Tf6y5b-Og2rtoTmIsiehjl2UgGf8hg&oe=6AAEB460"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYdYChpIGb0Q7kNvwE38iOV&_nc_oc=AdqqmvieJROwu22i9JI36WcUV57i0ouDNLKNaT1IENKhGGEaRp5IB1ZzOlWd6O3lzXE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwNLp7EnQdsYiDs936pghWs4QLE3Tyjyqb4kl8a4btTw&oe=6AAEAC1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7K8DKPPJ20Q7kNvwH8Wjne&_nc_oc=AdqtKkKQayNoMSBxYty8M8ViSfhjO3NnHycyRhLI2X2q39OtvuSg1aNJIvxx9S3T2Ws&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtllh2f1p3obSreMe_3nw_1NOMQKZmh3s9njvyyybPXQ&oe=6AAEA421"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes
h=00_Af5UKMLx12YoIokd7PWYHHK5zUk8tnc_8CYXhKkOtg1GuQ&oe=6A1199A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKM8CyM4NWoQ7kNvwE1p334&_nc_oc=Ado01M3SBUQmx5WpG4ouwrnay5EJYXomsfRV1IOu43zktJz2Unts76bjmBlxG4FCckk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wjYdsvo-D9j9qjhqAHoTrd4aMk3IPea2S366kPYJODw&oe=6A11C99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZX6tBNnBUUQ7kNvwEjKWbo&_nc_oc=AdrMdZDx1qqtWKKoSNu90l8yYkpqJomOkM_vrBHUAdSmV6q4qxOhHGN4MGDAnY0SmGA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CC9Jq7ZiCXw0g1c3rWI8Qsjss284SYlif1wMC_82J6Q&oe=6A11C1A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}
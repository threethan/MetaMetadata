f822sZBGqwQhMfCojfA7E_T7FDFYXjV9w1TrlP0f0wZ8w&oe=6A450420"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giCTa4D6OmEQ7kNvwGd68qq&_nc_oc=AdpMs3ppVyVHIVCc5FhhAnwmqv3QF4xwGDF5w-dFy6rHapoNj6S3DCOAxq0G9CSbr6U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gxBqIFHXdKwRxdVayFELE37B4SoUoqdGppeRRsgeHpw&oe=6A45341B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6gUMrkwyEcQ7kNvwF2Godk&_nc_oc=AdqRbLw0p2MUlynpEGNOPUK9ReC0UG5QyY1Zl7-fzkJhdYlhu_w1SvHRMVCETMjh-tE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wQ230Vz4-rZUPeDYHo9o9LLH5fPgs-nGrSbGSeoGirw&oe=6A452C21"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
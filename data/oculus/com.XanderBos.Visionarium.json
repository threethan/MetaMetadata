4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfYfUNS0B-EQ7kNvwFYUTcb&_nc_oc=Ado3eAs-JNXJNfJ2EgAjU3s_5NY_MvTDvtTPkadVifTiwjBilTkUYfdwkm0s4Y5ESqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj-ZWbAoXHk0YqQmB8rPWGB3Lym7h1IWi6EWsHgYnaRg&oe=6AA80BE5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsuA3F6sQboQ7kNvwHKzQoa&_nc_oc=AdqaGQyVIfzLB2Pqpg_ndvM8pi4fYjyxGmXn_mp7Mg_2s-ya5Xx5Brm2jBunszapsdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCuj5gbJUAikMLomjplEBEjXQRMeuaQDQMzpijL1_zTg&oe=6AA7F1E7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qFDXRm9XKcQ7kNvwHPxckC&_nc_oc=AdprkpdSsoq-KTQNoVrv_6dYO7XK2vIoLJk1IfOUqdZFYOUgbYa02JQj9qQD0fU9Y9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBf_-8JOKseUOrg9obad58BAsQ6g7CVZMvWNfXRIFkTQ&oe=6AA7E4A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOkbzL-HLdAQ7kNvwGS_xtL&_nc_oc=AdrNVx83-AcaUkl_a4UMVEyTuOVj-jaFRvug7a0U8FCRvHU2kaG0k8UBSJt45vEexhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJWTmUCU_auIrK_3olaJzvB2R9u7IrfIgTfjWAlqP_Aw&oe=6AA8149B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26IVXcXS0TIQ7kNvwF-6Yf4&_nc_oc=Adoqml-jqkLlgaH3naCh3SylDGhp0TQpJUTYWNUJQTBaolIt6gaXL12X4K6XnLx1iWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfLjhGp1uIrg7Wj0GJQJ_IF_9MBgZ2sOew3FaLfRwL9Q&oe=6AA80CA1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
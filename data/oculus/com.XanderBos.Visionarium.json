1aUC6WD-GuIX1zB8gWliO-l5p3a1YFUv7cdQ-Zu4RRow&oe=69DE2F20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOOlJRkNxpYQ7kNvwGpRFca&_nc_oc=AdpR9Q-7Ja5MZPGhZl7z4OqJ58mZSx3p9E7RHOLDpaHx6m-hBs7wMnye5YQ8X88yTGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uxZj4603QYyo1FdK9-9byNqidPE4HgvGaPZNtR6PQOQ&oe=69DE26DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWmtxYrC3awQ7kNvwHqvCW6&_nc_oc=AdpIR69haij-YTs_yhshzpFaaS4ktTpWZMB78UnSdhgUg-MdD0t0Kj53YAhBXSAxjZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lDV56Jqb4OXCmDzJeRNqHi71yQ2R2V9REvG1eQ1no_g&oe=69DE5721"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
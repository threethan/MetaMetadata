5V-dYBOMgqxTUWrwyvW7tQHd2NkPbOQxJOMdYVARWm0A&oe=6A01C7A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9spHbPYziMUQ7kNvwHk1Bf6&_nc_oc=AdpXvNUhWUi0rTlQEdDEiCgLTJD6Oevd2vNn3wndtbAL0KTU0eTNCgugyIV-urF679I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hZ8n4fJiHn2rdBqUuhVemwXz6FZzp0p5-CvisH_IAcg&oe=6A01F79B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axhZsI--UygQ7kNvwFDQF8M&_nc_oc=AdqFDzz2-3CVlAb2kqLSHa6FZGigMuESIKkVFgMZFcS7Nth503S8KzAAc5PRwFi-Txg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64Qi2pbgjSmVbcwe3UezBQg8vKwAzasJnrd_fMkRa2Uw&oe=6A01EFA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
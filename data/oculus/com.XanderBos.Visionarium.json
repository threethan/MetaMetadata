4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCJPQGoDWPQQ7kNvwGXxGuP&_nc_oc=Adqy4kguIRcmdxIn4t_cbzsaHx4Sz8Wma5i-x87hDZ4a_YbGiThk8gaKRkbTM8prC3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqmNivv8K1Bv2CqjlNlN99ZjuQR4Ey6WBO0QngNi0V0g&oe=6AEF3CE5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2TXpgXEL28Q7kNvwFwK86w&_nc_oc=AdqguQauSvi2CxfVUKu2Zxz861mqggC2DCfjZFJOpspI70TLQffXDIA0DGExo-M5qFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvX5sI4f1s5iHUWDU-svlWdJHr2rhQaF_6nC9Lq3U-Cg&oe=6AEF5B27"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONFMesHfpPMQ7kNvwHt4LBo&_nc_oc=AdrOFttpiWFgdsNMWMmBjaqX0vAz5Sendug85PdW95NgRlqpYTijxMHov4jpy_z7Z7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtGs4Cy6ZlwjFlCZOk-rfTfXgHcXEZ4jvxm0xHmN_G-Q&oe=6AEF4DE0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMgzUsjuQWkQ7kNvwGYSdNC&_nc_oc=Adq1E8wb2w9c5iEDc7y3ZB05DadddcwaJne76x0w7h32fMmMyJIVJgBwPLyWlyqd1yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSEehmmvV7CNSaPSxtKrDh2ryTO03gAuA-rDxJdJUW-A&oe=6AEF459B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiUb65JTyiAQ7kNvwGKS9TY&_nc_oc=AdqHmz8wqNfk8ePKSeOqIrQvbwRAEnRAHeODeeljN2ebwYK9IyIJTsm8x8cpEjyiNu0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaj_EG3zfg27i3V7TsmqvKBLcXN0nHT9wwvQa04sqZyw&oe=6AEF3DA1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
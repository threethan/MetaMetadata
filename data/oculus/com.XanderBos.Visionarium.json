0-VEq2bJgWmAV45yL-2Z70xbZv6jrQN2KTpzKfVfO8Iw&oe=69E8BB20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1pDorYAO7cQ7kNvwGYnZhz&_nc_oc=AdppgL7z4YSskjn-9NBLP2uAyLBK257QQITymYFKw_R_7c0QzUfIAVhSZ5Sw9jTwUFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16skZ_loKXv7hGccTzbJnTMx8UUcFNVfK5LaoWSazMjA&oe=69E8B2DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNZF4wouCNoQ7kNvwGmp2RE&_nc_oc=AdoEbYkAH1ysNYkd_GegGrEWQ2ProOGhNGwQx-lJ-OFGgtBpMeYvk-ErkPc_1Vu64EY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kHEyWPF2ObtqgxGBLQmkQO3CDGnxfQ7RzDV43eIicdA&oe=69E8AAE1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
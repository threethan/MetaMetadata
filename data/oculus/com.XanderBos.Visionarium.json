h=00_Af_54Uk5e603F-_Cw4c6sEeJGL8Hj0MrRQLw8o59JqiHpw&oe=6A36BBE0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44Z5evuuSGkQ7kNvwH4var5&_nc_oc=AdpXir0aWS1W6skLZYmP1BZYjQhTDH4QSXbr0AX7VUPja6NeCTGzoRZYNRqIFNj1dYo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PIqQAQu4I0Fea4qs77dtCTDMJIFiEHmwv-2JM23YBQA&oe=6A36B39B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvocVy8stvwQ7kNvwE5X72o&_nc_oc=AdqTDan_CLxVaB_y0Htm-lBbZbsFT9kScyobpwLy3gWeRemVVQ8_p6t1yIQKC5kWBL0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NDlgHmYQ8nwrKw1XHOTujlnASlOyx2uhr7EQ0hYF3ww&oe=6A36ABA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}
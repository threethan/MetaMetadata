ontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8uiIWFZHFUQ7kNvwFr0Ww2&_nc_oc=Adp33Iocr3x3uUGqqJF3hJVlyg_uRXhYibojSQW6j6TKXJTWcUkmEZJ4pX42uzd4nSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlmCprdPDuJ6CHrkyv0oFyGUxYS7m10_NKoLNKM3iYUg&oe=6ADCD8E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXQgvSQOH28Q7kNvwEmfhoK&_nc_oc=AdpxwjkuBri9RlTqKU8ySmFSIEWZ3V5PtMwGuXrgOzjAwXfpeRHr-41qq2ecVK_2ElQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcHj3aaCiey-XaaCNkyNtCXNWZnbO5tCqPILGTFC9JEg&oe=6ADCD09B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8Hg0ueKwl4Q7kNvwG50D5M&_nc_oc=AdpkUhg5OzepMQXjQphPYz7SROFYVZo8h5nchYU1mtr6x-nS3x9z0NwxRbM52OCpJ28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnXWf0uLCwZj41pLnqRJXGedoJcp1p0_UOMjs05CRVfQ&oe=6ADCC8A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "821316815620740"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1707799430651213"}, {"status": "PUBLISHED", "id": "3067911930074703"}, {"status": "PUBLISHED", "id": "2262536724239898"}, {"status": "PUBLISHED", "id": "1086604060162127"}, {"status": "PUBLISHED", "id": "665351429921031"}, {"status": "PUBLISHED", "id": "3070764899765260"}, {"status": "PUBLISHED", "id": "686179403831139"}, {"status": "PUBLISHED", "id": "438926609302463"}, {"status": "PUBLISHED", "id": "1078343597418335"}, {"status": "PUBLISHED", "id": "1197375077651555"}]}, "baseline_offer": {"id": "1197375077651555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1707799430651213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typena
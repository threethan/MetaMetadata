QCBfjtJK_vLVrzOYVF3Znnah1XT3YnHyB2Ntjv-Dq9fXw&oe=6A620520"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ioqQJOYrUcQ7kNvwEwdupy&_nc_oc=Ado5XumoZ8wCwCb2n35wJH9zkY05oIs4xJQNPYVqJCCVNUrZWOuR_rQbP2-HKdfJ5Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkPEeHKOMtrKzbdlpCba1SOkfh5phWJy5S5s7JmwxYBQ&oe=6A61FCDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWoIlJVghcoQ7kNvwFDiak0&_nc_oc=Adq_y58ruJEX4VngX4pVr8hMwewlDMSIOdyf93CIu5k-l43im6vmPUZWBqydNbvD4F4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvroOPf1Mx5IHR37WDpUP6mWXVVNcXg1Vv_htDz6W3NA&oe=6A622D21"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
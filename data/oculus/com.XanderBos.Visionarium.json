4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqmXHKriBTIQ7kNvwGrVC_Z&_nc_oc=Adp035IKbQ2xR6W1lhU3eYnRu0fvDbUwUUbjpcg6xu1o1nEf_Nawq37UjJifXWR4QKw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKToDyXPOBs4qdF1ncXG6CgoN-qDreLub8o3xHl5evjg&oe=6AB3E965"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPQdWutnfg0Q7kNvwFgojmB&_nc_oc=AdqUCbHo0BExe_6gvitUUUjKr3GWZ8Z0uq5rJBZOIM_qgGch41hbQAQ8hdI1lKyBLM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7llW94i5cTcY9T-MsdKB7z31Ha51lZgvPzhNX99u9Hg&oe=6AB3CF67"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21aItqFgNiAQ7kNvwFa5mhv&_nc_oc=Adp5j-XjmSpmqQF0t--Wf0e2l-nxDZC7sYTMMuwMKPIS0oepDqKsrEjJv_mmr8XVbK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXirJRWrgiCBzfaQt7Rs_5oKp93vFh8wFkItjx__OVqQ&oe=6AB3C220"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qATJLwawz5AQ7kNvwG20SC3&_nc_oc=Adphm4U000WApR6-8zTKzmKaffeSS71i3sRNLLloM6yfNcbNgrQSjGHz96oFdn9NN0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeJ6AJjnzC_ZdhDn3Q-0Iw0i1jptSGi2y2VY7WFZKYJg&oe=6AB3F21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okqI3vzNIhkQ7kNvwG8A7Nl&_nc_oc=AdrPtf2s6idQvqRQAW5_RigpYG28DQBVpiT_vhBH8TKzFmzOh1eIoSHQ3jPl92Uz_uM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeT7ADSmjpySd15O5xioeGLejktut2fbK9yD82XXqicw&oe=6AB3EA21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
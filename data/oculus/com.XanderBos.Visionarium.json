f69G29V_wn9qH0XZCkHguUu7imf_qaN688b_cCUXwbY_g&oe=6A201A20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C6_GZBGds0Q7kNvwGzbFTc&_nc_oc=Adp1VWDSuVFDW725Cz0FjDSRrUKrSnAnavYnMMDfGiKNypIbtraOBZCDHUzLEitNeHA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IPDD6oImosnBMeFnBPuQQnhTkebH5HC-sBbEeayqfYw&oe=6A204A1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7touofu_7JQQ7kNvwGj2dNL&_nc_oc=AdpKdAUHxj79qSs4_yrA7YB2drT_1-tLJ51dLVLPMIhnGGsk0ncvZly_1kYoCcf7mY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tjxFZH0U27lu6TZCRg0gG0Y2o3DYMeox-X3FmCAyHKA&oe=6A204221"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
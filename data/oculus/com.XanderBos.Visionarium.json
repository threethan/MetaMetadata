RxYO86wB00EJTlk8Zy-ABpa2hKeNFuGwtTzSLqlT4m00ljPbCLeRw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsWBCYzIzFOdr77VPJOc7NPiepSnv3n0a628paazOxKHA&oe=69A17925"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE7GoBoaGJMQ7kNvwEQRlJT&_nc_oc=Adkm4CqsowcqKjBj6FGYm_l7q1dT316KPOQ_qZhzsg1KnzIuxmC1Z0I1Iy-wJ1LdedY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuRs7JbGrTIMcse7E8VnpKNdTTK9njNSTbExewdxru62w&oe=69A19767"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf21I05yStYQ7kNvwH19gpZ&_nc_oc=Adm0bgXrVEoZKj-UjbSVgk04QxLE0AUNPImoUEkxZoBKZ7vDATDla-FG_H6ybvXQodE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfudyTGMnKA9f49AacKfpz9l3RcdW2KuXn-67mOgdPeu3g&oe=69A18A20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk_5jV7AqmQQ7kNvwGex4I0&_nc_oc=AdkXtBRRra0legUA54IzikVgd41nMNs1xPxECoJf-NtoTduznPXmMxevvWp_W9eRxjg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftiyCA8fYD_jVHznKzM6LFVDs_cFSwQGDAEA9TqFewsgw&oe=69A181DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxMEc8wqUFYQ7kNvwHlx58-&_nc_oc=AdnHvnKAR75RaSNSiHFcnh_7DguljsoS1LAJlmB1w-A6O9kYBsq2UEpLbTJU4iOQiLY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuEucp4TSDOY9x8-FV2APQD_KkEgclygzHC3Iz64UnB8A&oe=69A179E1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9601184959893847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t6
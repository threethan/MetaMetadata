4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HR2d-1FjmEQ7kNvwGA10r5&_nc_oc=AdqfSx004FNMznI7MjLESNLvgzJ77nY2KVtnEZICw5X-AOa_p8J6DFXV15dae5DET0o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxYIlgDBvtbpzMbcio6a6yGbZfliceXCzEYEqf5k9LdQ&oe=6A998B65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I7SQoEZc34Q7kNvwF4vI-t&_nc_oc=AdoOWu_gFDP7r4Ph6b39yxb4mm59Yo7-orAnYrPV2LRjPXZC1aPodTO5jOnlx27vuSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgdgmv2lJ8RJmCloLuO_xU3t9pXzymQ1pQt3wORH3Iqg&oe=6A997167"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub-yy4Xi8ccQ7kNvwFEi20C&_nc_oc=Adog-xjFaLTmnggpBPWC_OMlN4FOeFmmoSGsvh793JbZ7zOVpqRHeRgay3Z6-QdbsG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK91eALforA3nhjLtkemz3utpv2Eg3_lMsV1uUKOipTPA&oe=6A999C60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mgFJB9hNWwQ7kNvwHtoBkQ&_nc_oc=Adot_1UrGub0rhIx5sMmEBtfvdlpXSDCzo2nRnBFpZYf1dhJTUuja40VlH2V9UpY9GA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkD9sus5unYQ2WhOx5gT5pkEUl69V26Rl61Bt8amfIvA&oe=6A99941B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEr5F6dvbQwQ7kNvwF1DB81&_nc_oc=AdpdFmjospJvQDZ9zEFGPxvqjXRHpBD-A2vY9FogpB2wXtxOGQTjQA7MeuNTdirYnfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuwGkLC5al_7rDLajrwxwV5kgY0NRzErmbTkTM-oYADw&oe=6A998C21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
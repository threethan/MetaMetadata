4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpXmMJKrpMcQ7kNvwFx4tJx&_nc_oc=Adrtb42LXJcAVCa8DNHheykpX4npeqHOqgtYFbuXl9VM9fiy9yHFe1iv8vQZvhj_V8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPNRwl5Q7vWLvfWG3tOh3XINafu3OQXTpKA02jxVHMUA&oe=6AC7AFE5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D_choT0wHYQ7kNvwGdu6yC&_nc_oc=AdqTvCcEyZWtIjjOq9oh6R16FYAOOa9-4UOMBRIByuxXVnqeGml3L1r_1H4cfEhfD8g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoV6s6_4bYmxenkOrLvBRh-qpY5SfhE46QKHKdpxQNVQ&oe=6AC7CE27"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t3ORobWgaoQ7kNvwEPxqCl&_nc_oc=AdoxQ1hE585b6IjdFXoyIU6gb9bIv1JEdESaivnUm9FA_qYBAvPKYoUSC3mUQjX_6lY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYWIGRHgArGglMBhOS2_CE_Ou7rWUWRj10hWABOSpcMQ&oe=6AC7C0E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U16jmpw-4e8Q7kNvwEHB6Wp&_nc_oc=AdplPfPtf18_G1xlTTgoUqexQw0l3yFCwO6PHqaxezwTpRqFws4-i4Edv9qf-apaBuI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4KVj0IIfKFcoknMm14a_Sd2W600KZoZ59BYPxDOBMuA&oe=6AC7B89B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErVDnk5xo8AQ7kNvwGYyKv0&_nc_oc=AdoakDScnq-tO3kpFOyyuQwFsyosb-IphzKiACMWd1wMA_5buZt0ZhP7YS8j_1bO1qo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnT65lVeb-w9iR6W7DCJr2dLZHGaJTrRlJlpLzuQx4zQ&oe=6AC7B0A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
7LtXihNxbCQirf6YamJwgyXzoi78o1PiIiqN8xb15cYA&oe=6A085F20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBgWzXnflQwQ7kNvwHLBK6D&_nc_oc=AdryYqxUKeMJC0XT0BAaS1J7wDjYEqaMp08V5WUDKp7A3mG3VA6mSSHFhJ5GWVsHeqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dHjbUeqpRTy0t-Ee20RjAeX3ZRlz286k3Zb_5RcwOFA&oe=6A088F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5FVAUd_OLQQ7kNvwG6ceR5&_nc_oc=Ado7ieZMmgwla6SBxl8XQhEntfiCJ5WOciRe7IMu6s6Z357A2izo5RQgySlMCtakeFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z7n91eXjdZunJ-UmmJLSSgRW5DMEPzQo1c-TT71od1g&oe=6A088721"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
1KfESOMzMDmGnTw2TGKttyV84gvD03Y91ecdI9aF1YOw&oe=69EE0120"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gg43NejP3IQ7kNvwHeZdHG&_nc_oc=Adpo8JU5zbmeT9rqWIlOPHd3f_I66jrTnBKEfUZyfU7ll4XqqPnY0b4FdpsrXmz3IWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a30Bt_s4WVdJQTXhJ65aXwSpJB_G1qDFBDi3n4oTltQ&oe=69EDF8DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I29TUAwke74Q7kNvwEzXN_A&_nc_oc=AdqmprVjJH6rUPJlbeZ2MjzJsXNSQ5u-1bSJZttf58xGb3mMRbRbugNQ7TRsKclBz1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IljzJpOJK2FqdwJmQP-IotwHLxh87etwZsGfIZj1Qzg&oe=69EE2921"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
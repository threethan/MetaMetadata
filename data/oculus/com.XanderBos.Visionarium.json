pCicZGsbosC8DP8QarvTwyr245qwoE07gRRrRrTNi3GSKUs-wsYd4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftj0Ae9v62L2-zypCsYB_k7oKE9OlfuEl0T99ZNiV50YA&oe=699AE1A5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxHuZvpZ_wUQ7kNvwHbeukX&_nc_oc=AdnRcYkeD0UqdHpPLt0jOgXTAbJlEwnoaM3Yhn_gkG0Qz7uNeT9iQhGakhv7nScKBmc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfubxEouRB6Fx-FGo9Z5eVV511A41zaxnSeivsdsPmRMnQ&oe=699AFFE7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkMBQ5LPiSMQ7kNvwH6RSdI&_nc_oc=AdkTJYLcPnwzYfejxR9jUjdvFjwSBDTnnUu4869y3zjkN6yhD_O9oCCR80Gg7lBmwRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu2SFirduDKnNpTViTJpZIY8Xyrdoq2zft0Z0QqXozuyg&oe=699AF2A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOm-VcGz4tUQ7kNvwEidjFC&_nc_oc=Adkgbi9f6xfJw7x7s8gFsTkb-CyA_pg66zwqE5L8-Muv2xyE4by8b81Yx_Utpy3tw3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuG4QCn4gVOv1_O7cuNYC6lvYloUl3lKOxx5onRiKGXDQ&oe=699AEA5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T-SKLiO7nkQ7kNvwHAGGH3&_nc_oc=AdmDu4XSWZsRKa2aKe4pLlcnhXmjw3htxNzrVGa9e1efRQltu6La4U4kgQZpHSfuuAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmgVOkbDT3kbUw_Ennh9TaGDLO0qjDFxn1CCfKjb9gUQ&oe=699AE261"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9601184959893847"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t6
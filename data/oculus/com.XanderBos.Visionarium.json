QERiKVe5UWMfJfmooe-3tn6cUar9I2DMH4JtuGXtw9MYQ&oe=6A7F0620"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcjWFUKQWq4Q7kNvwG1ttLp&_nc_oc=Adq-nyN-spvxmQgrkaBhjy1ynrEv9UPkdp2VmHBgZ7OUKJ3m_BoBJOLPXAqKR_L7eII&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF89smL_Vb5MeGqPhRWOxNSTD6M2scb4ysKORZ4Dm1jBw&oe=6A7EFDDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ENVAhCS0mgQ7kNvwGVGhJN&_nc_oc=Adpnsn_VBkgXuM37MwVino4AS48Hf_laHfq2iCN53PHkdAvCHlaKTMKXVm_W4fWDyyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx3SYU28O8vxspTJi2CU_7mMciuQkd8mYTahA0FPi-eA&oe=6A7EF5E1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
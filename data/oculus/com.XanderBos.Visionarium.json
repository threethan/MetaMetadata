f6tb8dWhvVfDRJ0N6Hj7CDPQAQ5qeEvmiXJ-nh5Gpjf8Q&oe=6A0C53A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWOGX419LIUQ7kNvwGGFuSi&_nc_oc=AdrcCFC5YSfkDFtXPwUvdHg9jJ9LA1nkGrvUa_JLmxvEFiM_Rh7cx-bhwLZR1R27B98&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z8ZdehR9tuPYtkPLuL4KiyfzLsX0xkVVIRSq3Gg1hBQ&oe=6A0C839B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KZjo9t3AXkQ7kNvwEfE7Wc&_nc_oc=AdrK_fGxWgL0SiMKcami94CVCafVWbnap4kwKdprh7iH_SfydRJCzRqvqUlVW5ByJHc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67cF0BpOd8Txs7ZUpIYGZKZuTgXmeE5Oz9dmYjwXmJtw&oe=6A0C7BA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
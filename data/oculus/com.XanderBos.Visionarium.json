f91dw7VIAvMlhr0wZbFWgJvr-3ONF3NSlP7JonIuwsmiA&oe=6A47DF60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYzSg_s5rRIQ7kNvwFmoQ5r&_nc_oc=AdoZIMfnohUcK4u_ZHlbZgmxzUuctVLdPQhykTRfGRLc-X40bqM_b4mNiH-FSygYZi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zPIm7XVT9vVAC36HTo7VnMv4qB8LZqsgT3Vpt8vlMgA&oe=6A47D71B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6gUMrkwyEcQ7kNvwGjxrPr&_nc_oc=Adpd91BkdVi7PengUYGCrowJKT3FwfQXo7G228FpAzYg9tYj4zM-7GDYgKGWqppIGrM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BjuBJbWfCq6Ai59LpUbt3j-83b-ZdoFYLuGPnz2dKsw&oe=6A47CF21"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HR2d-1FjmEQ7kNvwGyKTMO&_nc_oc=Adp4gpVPYvlIPv6hlOjxLKx5sihALtMpl0VZlqVM2iERnRsryT5jalIQX60tbNqrQJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfoSgXbESVddF21jTUPuAI3cGMxHpQc1hD74TRF469EQ&oe=6A9839E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3I7SQoEZc34Q7kNvwE6NcPO&_nc_oc=Adrieot4UGX-aAiV3xqL3ysQVqB-1OEki8g7awbBLb9D9fs15DB6byUz7E7V-9UIDZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKLlRzVEQ-RDVmvvwqgvBDD5uvp66alMFyQIDFj8oPyQ&oe=6A985827"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub-yy4Xi8ccQ7kNvwEq1nYl&_nc_oc=AdqG3z9f7DSPUZfNDN0TNg3r8ouZEWPkEMiZnfLCS-61zSi7jxtytU-QUO7XLRBPuIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcJ85sv4RjFwher7Q_GqB8ZxcVXrFNfkR0KgFOB4aeyA&oe=6A984AE0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWMzPKQ6yA8Q7kNvwER8gAo&_nc_oc=AdokCdK5tJ8NKIDW3cnt6JSSHny95u-tLueiGcxxUJ82qsklxTCDxh5HwsSC8jn73Qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA3dFEXmL0MuLOVTd8C-ARHBorEbszTfD18FUepJXlJw&oe=6A98429B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEr5F6dvbQwQ7kNvwHGWMPc&_nc_oc=AdplnqEiFTM4FqU7_WubK9sxSIFxQ1J5pJ2qHMHINQWeFkkLuazVvVieIGzJ-g0xbas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy0aGsqEQ0xNDEGYxUFCKVLnfWE_dqjhrOhUORdaN1wA&oe=6A983AA1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
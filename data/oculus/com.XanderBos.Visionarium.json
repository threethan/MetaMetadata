4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc2WO3ozOMcQ7kNvwESJfIk&_nc_oc=AdqJOJdBZneSXSxlzHrKkr1uEhdYd72U8Tvn7upRl68B1bJZGKs_7EGOgDRJu8AFr80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJA39QmGzfx5TLayfsuLZ7YaTqXDjwcHdn1fbfOno3kA&oe=6AE9F6E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pztk5ZDledcQ7kNvwEl93b-&_nc_oc=Adr_lfH5VDoeCjZRw6xFAeibFlv4O2vyaWFFiqZxEWzu0I7xcNcmjd4LVK5TFY2f4xQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ__jKRUCOgtBor-ZiQyPSB6GdgjKbuE-x1fqbN6SC1g&oe=6AEA1527"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8P9UcWHTGwYQ7kNvwGi-E-A&_nc_oc=AdpqtvekO2PNfm1gwMxXPHRS7c801IlIqDvmq7FmNzwrlE7fbrQi4sOtyY_vtflsMYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI1R2PjSgC3f1fs7ltgSAYgQcdH6droPTkKOomez52fg&oe=6AEA07E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-5N3bzzY4AQ7kNvwEQyb7S&_nc_oc=AdpCc9uW2fJ6G8q8LChLHuqGTJfXYtt2ra_DwU7SjWuNtZdxkfOVz4m7CfZ22YlYd2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwnvorWb_zKIPXGXuZGAe0rgf4H-AGgEqZfQo4baAn4w&oe=6AE9FF9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Nvaxrq6LQQ7kNvwGpzayo&_nc_oc=AdqdWUHbFGv0Aj1ruw3Dp0wcMdDKJOdTZOcIpL55jebE-AH_dLMS8p7C4FN-lcGDh3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8tas1fhHkaZ2VVwgXgZHRzeJjJxaP1hMx_rkFxZf5xw&oe=6AE9F7A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
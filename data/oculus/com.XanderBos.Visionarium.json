f80aXOITcazT_fggeOORjAiKR6NjG8fjqpzWgbG6gpOOA&oe=6A2954A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL-l1F9dk_kQ7kNvwF5GRRj&_nc_oc=AdrpMFx88Tz01WhSEQ_JrGeAZtkVHRtTJsdrziFCcQTosns2BXUOsIfTf9-RRvbyUJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94sUBdNLfVG-bqKLxL6BuVwTalEj-61YcV9_7zstk3Bg&oe=6A29849B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzHDQgCisw0Q7kNvwHnD8nU&_nc_oc=Adr5ssyjBwfojBy5ZMUDukX7NQjmVhOQ7mImzmqq34_8O7uaIkHZroGlGSKjHxeeaYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ulxnhgc33D8tbk6e7JYZIDGl2TOpwOWSCBkEuGOhtbA&oe=6A297CA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
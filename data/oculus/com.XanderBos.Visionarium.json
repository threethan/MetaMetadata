QA6DLTJYtg6Ei0Pj4ZUpYqRN5Bt7X6TaOOaL0_nwqJveA&oe=6A5E10A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8fOTMjod9gQ7kNvwFlxbSZ&_nc_oc=AdoXQL08vNdMN3kYy3maGX-DgkUP2o4HC4jKqArPUieIA_C2JqL-mo1vKwutKAXpIwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa6brvePgvbnXh2Vv3z7pW4b304sclgL9rSK4dTbbVfg&oe=6A5E085B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCxlo85BjG0Q7kNvwGTPD3j&_nc_oc=Adprx27k2rdNQlVVPGBk9QjTzJyWAN-V6dYPan_qKCeVjJ15xm_fLH5OvVj1N4yxjEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-G_WpS1rbbA90KId_upCaU6Nru_V0M8avy7rJGzvlsA&oe=6A5E38A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIHZR8EcKwgQ7kNvwGHYClc&_nc_oc=AdrIFCmye5MjFJ0m_9i4QmBCK7iLzZ02hkCtRco3Onxb0Hna0iiJJU2mRL-Xzj0fsls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAmTcxpb_7ITqQMYKElrPVEPR1u5cksPNLbz_w-90lwg&oe=6AC3BB65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kumtr3TIKgcQ7kNvwHCHrvT&_nc_oc=AdrLF3eeEI1787O2NmtaVEY0z8pQp0OciuCkA4_6IuEHGThOEtU4LjpDgXxqnlmLGfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON2nhovfaoKdHa3OVa9nToChuXV8ej_V1tamooUAnHCQ&oe=6AC3D9A7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCAH98GVqIEQ7kNvwEBc2Mx&_nc_oc=Adq7s7TzI3ydTzL4WdINPerOt1zfrf7Ef10wEugpTaT-wQualY8e-PiTXYCbDm5j8ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB_zjx1dbMtFmZU29wWU9pV4wrftto3Xw3Xsze25aztQ&oe=6AC3CC60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxv86RNDljoQ7kNvwEs5d3g&_nc_oc=AdpIDi5CLI81_2DDM79QGFVDW3D-rvD1ze27M_DHRX26vDLH-CLs7ZGdtXADcLP-Q8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxNvp-Rm6EBQO9BSGqLCVYP5ETv_wpOw6p4U6qcLhA7A&oe=6AC3C41B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guEQR0GZEokQ7kNvwFPGAj4&_nc_oc=AdooK-CIQ0i3PL0gWerpAxlYeTbcZpggPGKMnaDrwNYMhDnAsdYr9fYBfjo1U_k-PeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvnW6d2FPJMWT5bRdgZiIHLqgcpiLLM2ra-FsRYAdA7Q&oe=6AC3BC21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
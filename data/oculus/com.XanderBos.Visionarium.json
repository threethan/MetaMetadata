4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3q6hrSL74kQ7kNvwHz490r&_nc_oc=AdpdmnggrwuCEXusO-IYMZbh8iIjn70keW6nI5bjLzu7CGK2LcddCz-9n8EaZmWn_Io&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi4KxTv5U2_Hk_uDf9bgdD4hsazza5mUbkSu4G0mlBLA&oe=6ACF98E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNcaz31f6vcQ7kNvwHlAKL1&_nc_oc=AdoL8h7YUc7iYMJzB6lb712t18RJbauTWmoUFfKgzNEODlZk6jM8JfIHWKdW0LynzD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM273txF0DCxLNkthIPp2CNFEXCpZzevO3WRFBg7OfyOg&oe=6ACFB727"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2NbinRGXIoQ7kNvwHzzSgQ&_nc_oc=AdoRE7io5ns33gP6hZDiZ5GtiIQHDtA3KhFVfG8VsEEpSvoIXVmNUG-qdbqGAthRFas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1skMt02IHd_98Ziu-8rppztv_rlQnS55z7d2hss7CNw&oe=6ACFA9E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wn83wUjWmscQ7kNvwHL-dyL&_nc_oc=AdrF1V1lxrMF69vmCFuBrA6U-Bi2rJPMfrazMGQfTPgyr72yELozCjyMKSLoYJ09gyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxnGAg3hURzBu396LgxEW0V4cY53Rm3u39B5aEXLwIQg&oe=6ACFA19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0a7Bg9uH34Q7kNvwEjNvye&_nc_oc=AdpN7iyfZArfrMQAzUPxFa1tuZnoduiMw-QoKDcXx8KxdG-twaUDTMOSDAZ74cYcuog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq0ixkk-w2m5eRxfUmPgoyJ1htSCE02JHL2hrZNfQzyA&oe=6ACF99A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
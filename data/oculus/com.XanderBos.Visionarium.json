4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmvcpl_snLUQ7kNvwFZ5k85&_nc_oc=AdoxlzWiKlzeJyFvHMV8Cp84nHc7RLqhB8r6Khn0xY-8wVrg6Y5o_UpyzRhV_kmFHTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_IggPbDpVEoZe9M5IFvqQTTrKNzHLTLkw_zwztdYrPg&oe=6ABFC6E5"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUBv7igtPOIQ7kNvwGsl-m6&_nc_oc=AdoTYpCeyp24fbD6NF0hrJ1rZPINAibdaxn8wMirVVipIpFHt7P9VriTLf5IBY0gD7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM69MUbEOUMn0_pufwLGZOsK3dYDShvqTV94g3B5JeULA&oe=6ABFACE7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV-pVJyLDFwQ7kNvwFjfAok&_nc_oc=Adrgu8JaYvdZdGUh5XcvthUJ6_FAwJ25tMZLHmm1adFwfGLcDFR4KMAxUlli_fQY9Rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCdzuynzmnoFXqt_SMVq7D6izm-wKMl32hNmC7-ty5oQ&oe=6ABFD7E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZT3I33HzywQ7kNvwHsu6v0&_nc_oc=AdpYAKOH6Y3fv9cy8pIS-PYSRuoxndP3NiKH0jvsNZTlyfM-86JOacasgQZxpLgZut4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjupZcDzNVWLXcRqKb4GsUxtRqlkHgdFCrUTK_RUvTfw&oe=6ABFCF9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDExioK0KVkQ7kNvwG6W0tF&_nc_oc=AdoFC6kcxHnoLGnVHBmH-4AVb68Tx7EDqTPygp3mk4JSc8vPhmD9CeKPjHNrukbOZtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU5uMRHYaSIKghcmRskcIZJ9fOpP35u_WJceCgac77KQ&oe=6ABFC7A1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
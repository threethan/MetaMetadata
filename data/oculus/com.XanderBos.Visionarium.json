Xyrdoq2zft0Z0QqXozuyg&oe=699AF2A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOm-VcGz4tUQ7kNvwEidjFC&_nc_oc=Adkgbi9f6xfJw7x7s8gFsTkb-CyA_pg66zwqE5L8-Muv2xyE4by8b81Yx_Utpy3tw3U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuG4QCn4gVOv1_O7cuNYC6lvYloUl3lKOxx5onRiKGXDQ&oe=699AEA5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T-SKLiO7nkQ7kNvwHAGGH3&_nc_oc=AdmDu4XSWZsRKa2aKe4pLlcnhXmjw3htxNzrVGa9e1efRQltu6La4U4kgQZpHSfuuAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmgVOkbDT3kbUw_Ennh9TaGDLO0qjDFxn1CCfKjb9gUQ&oe=699AE261"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_p
4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Csp2qLFfkQ7kNvwEVEm-d&_nc_oc=AdoeYJ7UrCDHg_0PQ037wNoQ55YqyyxXbufno8yXvL9g-CbvAkyc3I_O6c2xCTo5wl8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbCJtjYxHwmE4bgRXAVOwqH6tSOdQ5XqngQywq39nguw&oe=6AB68C65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPQdWutnfg0Q7kNvwGknbWw&_nc_oc=Ado3_FvFUswruurjY24XwYQoB_bC05P4yplvrcvKtsYjazB_NR5uT5MF26Dn87ZI4vg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRBB1TmKOQ6L8mq3PCijl1RO4MvoYQqEnR83PePhJ0DQ&oe=6AB67267"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21aItqFgNiAQ7kNvwEmnt_G&_nc_oc=AdploJSrTk1T5FPdY3zp534vH58H3osfeZ-Scs8vtBYSUdks5g7C0J1ntcx6ytBHBd0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF2GrhJo065pp8lGU7QfMsPM5d04v8VuXFZ2Jiqkr6lQ&oe=6AB69D60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbTEYNFhXRsQ7kNvwG-Ikrw&_nc_oc=AdoTBN6SV8UL_Z7W2_nQkkLVQ97obNNlt_484wuN22bIZLY5wiBVh83qBvhXwEe3a7I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO7lKfj_1rPNH3LoNs8Jc_S_o_7raEbFuFWrMPXfTYtw&oe=6AB6951B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okqI3vzNIhkQ7kNvwFCbz9C&_nc_oc=AdrKgpqg-xJpqFzJlKTHgi7U0JneO2YZv2wHoqFTH_Pgvm1tvtXaiUOKw5Aw61qkm6A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsHM-yNe-aVCW--sTy-S8lRVMsLKdGGOW1UAS_cBMLig&oe=6AB68D21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
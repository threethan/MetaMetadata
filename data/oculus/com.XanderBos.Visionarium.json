6YTji3zEsDpSAXT3p0vRZhFOXv2kdsq4IY2xQYEWLYTw&oe=69F9DEA0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O3ypicbJ-0Q7kNvwHIlCFi&_nc_oc=Adqxkb1nwfcHrKlfZKSwedfoh4Y-d0nAsUlgaJplaZsXVXHHzVwuQ7FZ1gEEMopA-co&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EVhGJPgKxF2Nh2QbmiP-IMDTIsgfZKVANOjYt6HkjkQ&oe=69FA0E9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Sflzg_FnM8Q7kNvwEMYYwh&_nc_oc=AdqoJWp_zLVRUerYKsuW4OYd1vYvHcd4TZ2c5LkooHfZTLnTaXAyu2zKBcS9N8Nkw2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UOhJN94vnCR6obGxTqt_uE_HRvdY_Sp0PTnLISqSfgg&oe=69FA06A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
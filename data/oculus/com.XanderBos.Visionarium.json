f_IPEvec0FNXEw5lo3hcMdYwkhqcSP673ogeuK9ZTA7tQ&oe=6A259860"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9P4CVgAXuAQ7kNvwF_omEN&_nc_oc=Adq3YYQ36TWEzaFPGOZiWSKfnEsb8wYiTrj-O3T4KdNlRZ2TT8Izf2NoiyWoJsRP_mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KpmCxA7q6bzIgXB9WXmk1u9uzSygiHg-FRHFAgZxNBA&oe=6A25901B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wXqX5RqYKgQ7kNvwEg4b_D&_nc_oc=AdpNYWHlYHJzjNaiVFZOhK0Y1G6vtRYnGrhNpddGp_kf3g0jRrbbfE0cNsdAuktx7Sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g6z4W1_xBQl-RChp8135OgEnr02JBjS2gnrdl7bZ4dQ&oe=6A258821"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxNOKrvejEMQ7kNvwFaUWiF&_nc_oc=AdoUrCLSuB9f2nBsBe7-_MzwTqzV3Uh7y7xyfWhQUAvTPS_iuWOqRyerokhdI2e-W24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKCDZwTgKnX6HFj6zx-YQu4uFk4jHXDap_qjjLkaiwrg&oe=6AD38D65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEugd1tmqnoQ7kNvwGF9YWP&_nc_oc=AdrzrxF16Wggdr_fs1445_9hmT37w5rXyS9V62jHPDtIUQqgq2EPQiaIgnNPVNrFw4A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNXwxPPGDLdPwvaUIJdQu1ByZ5aOM7rTX9enqShqn55g&oe=6AD3ABA7"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS59LRkuaNMQ7kNvwFaL_xt&_nc_oc=Adqn-oVqXTqFHzeCuo0p_ES785F31sOfCytIKaw8FF3gU2T2ApNxRr1A3lgRcNvLvTQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnkz_o4E9SsN7Uio4lDRZl2AJq9NtgbSEaZZPkWTNzBQ&oe=6AD39E60"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMD6UlRIu84Q7kNvwH3Tnwp&_nc_oc=AdqJ5HA2iBx64qs0JMFMX_KvunhL14qgocxtd2VIROKUDAbY001X2hpFx4v0s21aWAA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_gDrAAek1PePgQJ4T74z1L4xq9S-Vcg2_pEq3_t3_lg&oe=6AD3961B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUPMXRmJ_EwQ7kNvwFDoDNM&_nc_oc=AdoeqU6go4EXgSkrtd2xD6dWXQf9pOb140aa0pSMcTIq94s4XAtxYcCOIVGYxuq4aWU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiqZwWx0kVdU84DJsLPbDN5hO_kAZoom1BWshTPFELkQ&oe=6AD38E21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
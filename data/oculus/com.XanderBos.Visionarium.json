h=00_AQFsLTqYhdGBaE8emBXPHcQNDQjQ4Gkt2vRgej7ZRPzdXw&oe=6A7DB4A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcjWFUKQWq4Q7kNvwELfV5B&_nc_oc=Adr3ONPPG81C8AVVIf6POOZGnPbPlH16_I9uFFAO73uQ7Ar9_VnVbVtvT7yRdrEZRrw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYFcb-hRo9JRPRfYKtHJzN6wteA-v1RQG08rzPgundYg&oe=6A7DAC5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ENVAhCS0mgQ7kNvwFv-8yb&_nc_oc=AdoS_7uDhc-5rjz5tI7RLbRYJbwR4QfojRWtg-Qzw0n_2UI1BbBuYQ4_O1HBYfJfDow&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGua0tmFr22la59ZcDQZwPbP1rrj5PjwXXseLF340njPw&oe=6A7DA461"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}
f_ddiQSh5QL8tFKPMfyngOq-QI5m6F7v-8uiwJ8ob8SMQ&oe=6A2ED2E0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXeTW9-ZnDIQ7kNvwFYLxUQ&_nc_oc=AdouZf2TLwNkiCU5WbiGmUtmBKJGYBbSQ44oQvE6O4YW9fgqVlUYaayu0qmPLMAoB0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J7wERgyYP8zbxQHzLN6ROCDmwHXUW07DJWJEUUTAXsg&oe=6A2ECA9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4CSze-auBsQ7kNvwEJWTbd&_nc_oc=AdoU0iWXbbJABkshTr4GcmAfgr_pNOnUG-FNRk44X6fTmoqLO_i5VtagWdNf4Zb88rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9DIb8NJBm9Ak6-wJU8xRFEo2bnZ3nuhewcHRkXh5Isg&oe=6A2EC2A1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
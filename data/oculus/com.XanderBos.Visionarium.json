scdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8pnskhh69kQ7kNvwH1JYT5&_nc_oc=Adp8eTS2A1ydzrdgLlqGFzIzXIjAch3o9ThIB9nX9r2IxpasOqw7Np2eC2iBmX9_klc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af15-NqwtPC7Vvn1YwT8p9w8Y_ut3t56QRLxcDsquOjkIw&oe=69F09BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I29TUAwke74Q7kNvwGOkB36&_nc_oc=Adq8DyHwzV0IHFF7ptONIc-iXQ0jyWCZj9M6g0zqj3nnVuG9s3UswAbZRJtWPo9VAvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0a1-hZw1B_Z5Hgt-yp3tBmdPuJY7koJ-9H4mzCro7emA&oe=69F0CC21"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_web
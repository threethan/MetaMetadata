4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsTGT-Pk9DQQ7kNvwFER9AF&_nc_oc=AdrFTKfBdliQtyCrofJ14_wmMy5lcAyLHOVxreSHf_EhVVhAnnpx_qLJegVInqzWs3g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5hj2f-PuecI_3akZ2e5-4UR-Jdq9cc5zssgLetGah3g&oe=6AA17465"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnvJKke-41IQ7kNvwEZkp03&_nc_oc=AdrswXVJGdvDZlEcCiJTvoj5nBHQ5E2G78QOFhzNW7RcX4wfHtH2WygDrcmMyPJ50k4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBMkKpJkX0L3Zgswrih66cafRNC3DJlTOTqFulrFYaig&oe=6AA15A67"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gim1WKzFwxYQ7kNvwFK3G1z&_nc_oc=Adr7r_RwIhctSY7CW0YgkW1lqHpIIRy7MOgsYc_SbczaBcJ0jKwqHeuqq70r_6B6uB8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPiT4UhHU97YeUvdWuDdrZcfagtaGawjsqu4Q2ps3IgA&oe=6AA14D20"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYpaVk9GOPcQ7kNvwF1YcYj&_nc_oc=AdpWg5lOlHL8K2qsKfABUUncWFjq1K_SIzLQeQvkcYw0LoTqBEtvBIKpUx4-xEyMn1I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcOkNFHpuwjCyeceKJpZwerQ5xuEEeHvYmRkAS1o1dRQ&oe=6AA17D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1swW1obz0IQ7kNvwGaw5Gb&_nc_oc=Ado2iJRxvokpIsDXZ-82TsFRK-m7P88C9poKUGZjxYZrImLZFeRNmb1-TOVWJ4Gk6jk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn3oPaBQYVzZNyUpCqWiHh-GvA934yzqlcJIXqLWzWJQ&oe=6AA17521"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
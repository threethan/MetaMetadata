1kbYbEJzLMWqPQoySPhB5ilLaGILVU3DlRK6gHMLZNCQ&oe=69D797A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CQzci_iy3sQ7kNvwEblWCZ&_nc_oc=AdrrRSI11LWe24yXNj9Rt55K7f9fXqEiEZmtXI0SkOjqiCJHmyLRYixWUXx5Jm4md1A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12AJR7DYX6ipT0PtV_bLezWexqiaHHtFAKAXcLxpqc6g&oe=69D78F5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Di3X3QqjA0Q7kNvwFnKu2f&_nc_oc=AdpEY53WnUjesRyGuCz1tn_E2VgD2-2bVbgjv1kn8VyVp8LKdrsBeNZOACaZfn96-y0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OLO7qiA8ikKdOmKaN0di1j02kY-Wz4MrpMwX6UI7h5g&oe=69D78761"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "de
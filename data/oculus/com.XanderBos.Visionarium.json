f_KE2F4QsGNKG9jFtU93SQUDXgiEXcDXZJOVHc2jkUV_A&oe=6A3AB060"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YuR4zw8k4UQ7kNvwFV8aX5&_nc_oc=Adr_R64igz9zD7G7Y5cbCaA0vNwU43_8ZN5Zm-wAOZ7dy0HJJRLgYMGzM2HoexsSxKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eDnBeHrVn14eGnNuCLyG2pCyGHpJXY6KrNg0uSNRbjQ&oe=6A3AA81B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4Oheaoif3kQ7kNvwH9WU0i&_nc_oc=AdoOkNa0C9HUdWAA7bbaXaKmjU8MjgvghtCngRQR4C4PerfL3SKPZpzabNDy3ot-7O0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wx-QICARCeUmoj31ML3ZRECPhagLLy59vmw-MXq8ppA&oe=6A3AA021"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
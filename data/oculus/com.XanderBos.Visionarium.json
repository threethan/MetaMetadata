f5widCfvzl9XuBuss92MOSqjyx9ZTSs2iDTqJ4FxkXNxA&oe=6A0EF6A0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKM8CyM4NWoQ7kNvwHAdM6R&_nc_oc=AdqMK2bO1UZl2y4_6kGYvFx9W-GjIdUBWIgznJPkFM28RPchBijl14g14gIJ4_Bj3f8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52mJCiLYkyKYF87VKOIrpCAECTHs4dbS6gbuAL36daZQ&oe=6A0F269B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vkNXe8H1WgQ7kNvwEICs-z&_nc_oc=Adqd_pW6KfBSwOC4SaxR_c4PlnX28yqOb4q0hJk851qRj6cSUuJEDsSUjokgJWebxY0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZLXKH8i7MYLxgayNDBaTcFI7yCHs0FPBI8IGt4gpW5w&oe=6A0F1EA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "d
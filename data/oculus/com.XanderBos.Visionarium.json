h=00_Af_ZPICZ18jEd-BggN6Vub41hnPgfcvnETJaRzqb4RwT8A&oe=6A468DE0"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYzSg_s5rRIQ7kNvwHv_CZn&_nc_oc=Adpg1aTm-NuX_JIWYGV9yLd1aoKGHyOq3Oh9qBhyihtA_ZUmomg7w5WQ5SOxu40SXBE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g2rVNi_0wEY7tm9UE-f7ByHSAiNUcy12Br3DGn3QrQw&oe=6A46859B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6gUMrkwyEcQ7kNvwFsbdzX&_nc_oc=AdpzZ8leYoYIcEw7sFdh3FrIctHO7rbd8PrOqTKyBXPl5SFCTsZhZ6ZEij1MoT5zAXU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bgwMga3FFyCdwrIq8BS6k07fN1EhMGrpxP-pqSZcXUQ&oe=6A467DA1"}, "display_name": "Visionarium", "keywords": [], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features an archetypal mystical experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}
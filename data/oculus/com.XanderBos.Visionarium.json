4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfYfUNS0B-EQ7kNvwE9FtWi&_nc_oc=Adrfd4qa0Iq67Qt-8YQ512a3iHGDBFROsrCKM4lywDaQcfanLputFtG6H4Q0jsKNCvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhU6uzCD_3QMByiMFGgc0K2Qd6hEWNshvE2wOPKfT8TQ&oe=6AA6BA65"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTQAW-Xyok0Q7kNvwHjC52Z&_nc_oc=AdrgWFvyOsyUDQKCdKlQVaWO22PHlZ5k0TTEp7grrZBow3Pyr0bbInqvWvHe-i4FLHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILaAucir0jSvm7mGlK3KgFMC4sKDDUkRBb8847E5vmAA&oe=6AA6A067"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E2_TIi3VZYQ7kNvwFaYtsj&_nc_oc=AdrA2NnUzXrU77h6JFnj-2FkK96XwYrQTnUF6xViGs1g37CvifBxSa2Kvx_vM3ryx_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpKBw4fMhHAB9gVloKrv4-r2EOzmYXEJPlo8yHV25Jqw&oe=6AA69320"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOkbzL-HLdAQ7kNvwEH86vx&_nc_oc=AdrQX5LwxTBsig7b2kN8Jcd4hBSqevaMl0m8wdkiHbM0WOCVG2w_Y5Rpj37MdCTCYPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcCulH795siAC4M5_GMP4_VUPn1xpk5oVorYtUTZEmAQ&oe=6AA6C31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3wwGwA24XYQ7kNvwF3jJUq&_nc_oc=Adr3zl25KIZFXRVFSNN4i6oZY9hhxYyFnjM2rNCD96n9IaS33TpAsPwL0X5GNUDiNRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjqqK3WrIj1n5EmPkn303FQ-wEMZQI-QU9HPy3cy0HoA&oe=6AA6BB21"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
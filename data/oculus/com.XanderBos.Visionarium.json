4682909297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeaJRx93ln8Q7kNvwGeWTEN&_nc_oc=AdqaXqbXW0v9C0wpbnSQtx8TIytrmeVgMufOI4iXyeQcYM1kwgBcdMLU52GjtR8c6fc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLX7zWxj49874v6oZdI9vBhKm-W3FfcMiY9KEETpsyhg&oe=6A95CF25"}, {"file_name": "screenshots5.png", "id": "1445900829270998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1445900832604331_5313193947964666136_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFySddDUK9EQ7kNvwFaigMS&_nc_oc=AdoXzFJjHbBhSvmz1y_Obg5FPApaNv9iEPRUheVEOTkZoSXGAFmF0Pnvq8ImYe1oCyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_8RHWRimKBAbrZeO3xQf8LXibls55-5xIymBo_vliKg&oe=6A95B527"}, {"file_name": "screenshots7.png", "id": "1339271396924647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974775_1339271400257980_4419565644083298477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVMP6oXDAPAQ7kNvwGJ27UH&_nc_oc=AdrxttHGfhUeJRQEilmOqcKSeLX2Eu6qJ0k6OueLl5TRN6HCckIhjQTOO6S_I6U_NtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSdvjxHRJg-HyC2hj5Yr1Ox66TFlBUZ133z4ki4tNsKA&oe=6A95E020"}, {"file_name": "screenshots4.png", "id": "742815200175052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982685_742815203508385_4141576407430143694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWMzPKQ6yA8Q7kNvwH1TD2g&_nc_oc=Ado19tJuHTvGeoYpGLKY6QudioO0cfxAks6a7i0whxSneeO9sKRyQq8Q7pqQd5DDbpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm9yko3c62BLhnduJZvUDp-EJvjv_c5u0DGYtEd1sEwA&oe=6A95D7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshots4.png", "id": "899765744797476", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_899765748130809_6083189611760282390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI6AIS-JCkwQ7kNvwG5J1Ez&_nc_oc=AdpWrnLkYP8x5SfeBA7e8ROBF9McQz9XpMLh_ywUQt4sWDrQOckYCDdh6eOGV2-bLcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEX-w464vMDucJFaUGq6ZVcSt-iH1ptYyI89BNPlcXUg&oe=6A95CFE1"}, "display_name": "Visionarium", "keywords": ["VR", "psychedelic", "visualizer", "trippy", "surreal"], "long_description": "The visionary journey continues! Visionarium  is a follow up VR experience by multimedia artist and solo indie developer Sander Bos Now available for quest.\n\nThis audio driven journey features a surreal and meditative experience, inviting the player to surrender to the darkness as a way to break through and enter visionary states.\n\nMost of the artwork is painted in Tiltbrush and other VR creation tools, trying to make the most out of VR as a new artform.\n\nPlease note that this release of Visionarium is developed for quest 2 and is a different experience then its previous release for other headsets. \n\nFeaturing music tracks from  Kaminanda, Kalya Scintilla and Dreamstate Logic.", "short_description": "Visionarium for quest 2 is a psychedelic audio-driven visual spectacle. Enter this artistic VR experience that takes you on an immersive journey through mystical realms. Come out on the other side, transformed, in awe."}]}, "developer_name": "Sander Bos", "developer_privacy_policy_url": "https://www.sander-bos.nl/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sander Bos", "support_website_url": null, "website_url": "https://sander-bos.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
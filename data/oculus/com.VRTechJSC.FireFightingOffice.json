20668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9rmVBDGJkgQ7kNvwFN9eTA&_nc_oc=Adr52ewk_5DHi7LY1CHFbEGUghO0_YA-SxmLQFHb7O_Q2FcbANM3f6r98nm9MsocCg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUn4p9nJbPdt6W7a_2dZD2XY_18WQHui8L9fELdIef9Q&oe=6B0EF169"}, {"file_name": "Screenshots_4.png", "id": "2784730135044778", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_2784730138378111_5164697415136378077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMx7iw770CYQ7kNvwGO8c-A&_nc_oc=AdrF3cTYsYnlTAE-ehbIbNupetlbqTad7k7Do25Vf4AOrTTPgiV8XAVZt_Mj6wljwME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUySZbBAH0YJzGaxrlGaD1A9M_UxxWarAG03GV_dWhpoQ&oe=6B0EF7D4"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je0vhT5F2lkQ7kNvwE3FdV-&_nc_oc=AdquvcuoxszN4sNoxr-0D-ZVup_-E6mVk80crB7pQhxRScj1UBAJmKhcXbRhW_ivM10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmuGqlbXznVptnTRwyBtpEXDJl7wBIeigmFOxhOJ4DHQ&oe=6B0EF136"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeoW2MK1W6EQ7kNvwF7UNAl&_nc_oc=Adog7H08GNP8i9-8BgGHe-koZTxAiJ3mqMuoUjZe8jNB4jUU1YCGCjU-D0wMvNfYxCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVG0g9AVlXWNJII8c1grolqUZhOn8hjy59wS5DUlsXspg&oe=6B0F11DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topi
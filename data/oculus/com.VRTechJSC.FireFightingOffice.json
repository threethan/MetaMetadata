fu-pA4ftG74WP9hU-vxwXZXfQqtIRtijpfule7xKoQA&oe=6B0313E9"}, {"file_name": "Screenshots_4.png", "id": "2784730135044778", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391901_2784730138378111_5164697415136378077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFHyjSoBcqgQ7kNvwEPBDOG&_nc_oc=AdpQTYjQy0M-OPEIwN7FozRJMjWh-KSzUAQlBtKNmKWaHWbMR0DxOjF87BM9RPJbvso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFgL_DJ8JoGaxiPaqtBA9MaOfqRosfsmNMMpQMcN-1yg&oe=6B031A54"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6nJSVSFhV4Q7kNvwHNBnoG&_nc_oc=Adpx4v_zonZofAf7NOvml-IEX_capDjxq3lipyfXT04rGXgLberlqDTgdZDdTlpzNOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2xgvlIUfjj_yiH5qkDTCZy_1eniVE_lcomiDiGYqUrw&oe=6B0313B6"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sir6jt8nIUEQ7kNvwGZqQBS&_nc_oc=AdrI5HRTwuf2ALP3v8xfD3Wid-wbF9yhDVD-CczOlE3C_39TvLtnL5xMdT-0fKg7t2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7PfFSW5fjqY3RSFNYrowjN4PZEE9XifT8OkwnnZ6HsA&oe=6B03345B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
20668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9rmVBDGJkgQ7kNvwGUAwkh&_nc_oc=Adp9oFDB8C6DG9KNonkBjo7w4fKeM_2KFQW3Z0MV3v2MImR-oHBl2axWGkqnrHRlS5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGg1hsja6X11MKADUoqygOz673E4hypUTP1ZYYe20jPA&oe=6B1042E9"}, {"file_name": "Screenshots_4.png", "id": "2784730135044778", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_2784730138378111_5164697415136378077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMx7iw770CYQ7kNvwF21IKu&_nc_oc=AdoXcKaoqnCzbgGnnfODfSoLFiJQNxC3QO5VWB4E81z3a5JK5I-euu6JXqrM8jpOe_8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFzeBm5vYgU--50jzqwDUvptxTvIVKgGqoRoveUWOBvA&oe=6B104954"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed0RP9HB7I8Q7kNvwGN2inh&_nc_oc=Adrb8lffUlbkBiZZLOFuyFIv1MwBVckesrRcRsfeB6qdjTWDdXc01g8KdvPHRGlIde4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVADy-7k5fvUIiQDd1jPtKnT13lvi4F7T-Wu4ltorbGIA&oe=6B1042B6"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeoW2MK1W6EQ7kNvwHAT09Y&_nc_oc=Adoxd4yxDAZ1rqHcO_HZGSEcDgA2PipF3sn_lhBkaSl0F_wIIpBTICRApv1SvxpO5fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZMnSDVLIyZUJV7F4yMCqO0MwV_-NGgt2ro_tcdQH9vg&oe=6B10635B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topi
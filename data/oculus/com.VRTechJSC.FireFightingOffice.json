20668_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bteiVh831VsQ7kNvwFJ6dPL&_nc_oc=AdptPCHa6vOIbOnunfApUmMjLRtHKbPTICnb9rm_JT_l78zmJy95kmtbWw1kkgegTqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgw87GkECwYFbCvCKlzCrqQjsU4rJadbN_ThX8B2gxoA&oe=6B0C4E69"}, {"file_name": "Screenshots_4.png", "id": "2784730135044778", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_2784730138378111_5164697415136378077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXP0NGJciX0Q7kNvwFenIqi&_nc_oc=AdqlFth733QJ5bM6Gnnk6BP7zB289GCxci_Kll3TNguurYGq0UPlP2deBsT9b5DkO64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRExECM584tEQLVO74NaiT5VFheID5eAioVtUmy3EKgbg&oe=6B0C54D4"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=je0vhT5F2lkQ7kNvwF8eCaJ&_nc_oc=Adomy0vOLvaB-fWbiOzrdL8Hydu87DB6jRGBxAMj5ArY0TrB2Iryo10_NwSyB9U6EWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGzJcGd-f8JtBUzc3vCMtxnikOgwMHAWjADVt6VeHCWA&oe=6B0C4E36"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WprgwIxwj14Q7kNvwHktLC8&_nc_oc=AdpIOYQtLjG7hu3KmCpQ1ru6TfvUEQWqtxj0gpoPMfMr5h6B9cke5cP2l9nqWJuYl9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5sRYDHUvYpbuG00qd-HvANsJ_D1Q7DlZrw5ZXkt_52A&oe=6B0C6EDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topi
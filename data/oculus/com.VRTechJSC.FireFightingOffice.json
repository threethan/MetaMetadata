=6e7a0a&_nc_ohc=Bs5RiUnelJ4Q7kNvwHsNvsO&_nc_oc=Adr96_1sgd7FvMy1JKAix3Vt6FncL0LbRXfBnCjPV6V8-zzUSBe1eb51oCoaacLUhKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPmEYJI_CRiwg7nhwbJfon1ZKZ7vlQ1kp69-FpEwNA6A&oe=6ACD0CD4"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND3kz9fC3ukQ7kNvwFDxGZF&_nc_oc=AdrcDNmdbKndQOfhq1_rYMY_VvZIq8RdWRZKS5130VdIUkM0P9luNo-kGGs6jH_fTOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo4B8lpR0mxIBeaYshSrAoDqx0BxZFzrlOsjMxemSTmg&oe=6ACD0636"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDFYIVZewdcQ7kNvwHdyIqt&_nc_oc=Adq9EQ3DXnN9ARwm5aavQCkAPiAH_2b2Ta4hm9xbjCjGAB0ldIv3wpf_e1kllZphjAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ1RFvDe6VMvvLsj_rrV_p_owq46Xg0821kklsSKzgIQ&oe=6ACCEE9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9462742203780489"}}]}, "scheduled_offers": {"count"
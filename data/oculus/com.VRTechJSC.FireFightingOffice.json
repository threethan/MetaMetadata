nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af121KIO7_73feazytomPZIKiT6_n7IlJmV3YprUPQgErA&oe=69E61E14"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw0dlPd6xlgQ7kNvwEWEIok&_nc_oc=AdrphFrtdPtSkPFssEtHDsB2g6OQQ1kfi85ZyHTZF9obnN4NlG_QcGr-btfCEjKi1z4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18v4ZKU0PLToXi9pImLL9tH5m-AbvT4cQk0dYBKulsMw&oe=69E61776"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2wzlgyyz4Q7kNvwGx4vTT&_nc_oc=AdqL89wpZ_FvWbOCMQNkKPivEdcJ-rpvGqBQsX-VIk6swhGp8fze4ga9BBpr6oWCCrQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05VuEZ_r7uG646i4_SoEM9VRAzvcH17hS5Y7oIxlbp2A&oe=69E6381B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9462742203780489"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2598264860569105"}, {"status": "PUBLISHED", "id": "2627510214336025"}, {"status
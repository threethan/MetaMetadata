pnWx0vqFAz8q9wy3Z-7Wog1py9JE2np3qzXcq96KLFQ&oe=6AFC7C69"}, {"file_name": "Screenshots_4.png", "id": "2784730135044778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391901_2784730138378111_5164697415136378077_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfyJAt-3snIQ7kNvwF-_C9Y&_nc_oc=AdpMG7QYRrMZWQbm9xlYPxIBwnZwtXVbrOAGOrvEIzp-olQxCz7wUDGZ6dsG3oRtkL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK2ej8RATt6Q5T-RO6gJ9hvN77saxB4Bd7OmYctRTG3g&oe=6AFC82D4"}, {"file_name": "Screenshots_5.png", "id": "430089026862815", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393796_430089030196148_1662249604024398535_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fniH0ey-hcQ7kNvwE99ZRv&_nc_oc=AdqwSygxkG3ZzzENMpCuKtGuXfIBhA--gh7hHpjsRBvLncoSYuLQkmEclkYg8vBss5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg1k6KH0hU0I9K6htsbuLuNQdkaf8PYf1XE2nxuDwMGA&oe=6AFC7C36"}, {"file_name": "Screenshots_1.png", "id": "873428961576263", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391935_873428964909596_7221005104502538944_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uidHbC6gi20Q7kNvwFZpoAk&_nc_oc=AdoW0dFJ7GDsg5sTfPYArlxBW4f_I2nye4MLHCRrT9kgHHSi7OuIud7uY0CvsSR2awQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYHR8pHmmAu9Qb-0hIKssmWBAOk7aANIwxa6X5FajAeQ&oe=6AFC649B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fire Fighting: Office", "keywords": ["Training", "fire", "rescue", "firefighting"], "long_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Office is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjoyOweadQUQ7kNvwEFW9Gr&_nc_oc=AdqLBxQqRZUS6ThY4KIFQQAw5xi6VGpWv09rr7IHhNoyO7Nhqch_l-kRd_axA12qOQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bS4AromM8ICZmcmNCQoRD-J0_XlNtMX2_1K93HvtJJQ&oe=69DA5469"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIMV30YjOocQ7kNvwFK1Ilx&_nc_oc=AdqOmtsgnuSD7qZITpk2jk6_pZ6wnbE5XFhu4Ldw82ymZ8FNee-SMrU559C75aTT1Os&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vlpz-aa5sGDtCs6MbSjRs-8LjPPAhdEZz-X0NAytsZw&oe=69DA5E02"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzxwO_q8hXkQ7kNvwGdj5al&_nc_oc=AdqNhrVsxqu6mgHBw9mgwiNRBv_R6-Bz5lONXwhpru6qC5BcTBm1mQQBSVvX9QN7Cp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZBhJg7x-N05euHgJqEmQd6wOMh78BqmKTJbhiATuxxQ&oe=69DA5EAE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okkCLG06WikQ7kNvwHgEpB6&_nc_oc=AdpHB9xuByuoOuKzJR5B6Iun47-ZuscduJ_0vv990FG2JFNRccKGnHdoTnO0b_DdoDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X-J6vu6lRsHrioUBD_oGjc4jpMugNuG6xOjJiDY9Vlw&oe=69DA4203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg6WHnS2xe4Q7kNvwFP8LtG&_nc_oc=AdpeoX1oBhIePF5X-aGLP5amG5SEwwUY8XvbMWUuCy-Fi0c0QEogCowxsl3piW0MxnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02B85xuV-dMwoFH3upsT8n4w-oe2yqZ-y2_gbG5fBstA&oe=69DA33BE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
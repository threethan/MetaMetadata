/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kYdVwEsEdUQ7kNvwEVT5Mn&_nc_oc=Adr-_2A1cSk8X4lCwA2g0Kkwws4Y8MpgFggm1Hds11efDhpKAjoA-43EBM2NUIRBVZI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tXSBN-E0KV170sSN3Kbyb6MveBAbR81gI6k1igBcDyA&oe=69D50E69"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBotdruYG8MQ7kNvwG49qlg&_nc_oc=Adre2PntsfiOaFpkQHcmXqxA2OVknQtd0rDtRjoBnTP_cNO-bCZXrtnULbWclpH_NEA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_sIGKm-bcS3ugUDRE9G4sq1HmT7y7rVDApHPtEWFNWg&oe=69D51802"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6-9pdLgvSoQ7kNvwFWExAd&_nc_oc=AdqnFdINJofN9xHTqZceKgI9lDG-SkKqTWTdB5ICxYgOE1-8yWB1AjQTm0xFZ-SElUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e0eWohALF-cMTrcLrln2F_4le_9eCKndFmOSBSNfJIQ&oe=69D518AE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIuMtzRRMQoQ7kNvwHqJyX4&_nc_oc=AdoPoAhEhY3j4oFxz-G1Hgfqe7T5Q46Eaez6I1NnxUpxC6fZUqvrgxEHIDRdtihIZwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L13SRfhEua5Fhqhi3O1SszEXBQV9RYXCIQULi7TtS5Q&oe=69D4FC03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFnmp_gwLmsQ7kNvwFjHURo&_nc_oc=AdrPZlPVGajMzX_EArFVPv_lDD-wjES8mi5Z9Buc1OOlGKuftuW0qFSFkovm7vBo-4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VNlUSllTgWU56m8xVzIQiiHYelGvD52NCZt_oI0lvzg&oe=69D4EDBE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
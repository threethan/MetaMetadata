/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc4eWvkJjnoQ7kNvwGsgMGf&_nc_oc=Adru_fjnFP_wh6dxkhkICK6quEaGAAxnWeQ3F7lIlKVt63lE5f0DkDVEMLT3E1A11IE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d-uaFFXWGqFJJF5rRUTitiNAZJrXPM6Qn0VuKc3DbLg&oe=69EF6C69"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fklUrk8KIxUQ7kNvwFiMMwn&_nc_oc=AdoOuktHRJ8sSAA8K7DDGx2O8FVcKQY1va5y0qR1aQyMpcQY9y9mbZs5JUliFB0hTs0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HYMjTNEN3wSjcsWxOc_5GEV17BAgdQcSZgESCa2YS6w&oe=69EF7602"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDbwUlEyTqQQ7kNvwE8UzL1&_nc_oc=Adq-DiARBe51VbeMU0a4lxyJO2VHhjBZTBWPMPktqRSMJvH9uZ5PLTc70g5uCA0Tzgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1yz5J8EjoNktKiyeNNfWhjBU0X8psUbux5dn24BlUfww&oe=69EF76AE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsB3Tj2_PS4Q7kNvwGQikml&_nc_oc=AdpnHfTD21cBHvQlKk_weO0uw-yAmTl6MsxPd4tW7ObZdPfZz2kG8d4zyEgimeXW2SE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SFEeePzLkU-5NLH-VsuN4N19x4u40IbdTSBvxjYmceg&oe=69EF5A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YYq2PBGP2oQ7kNvwFauoWV&_nc_oc=Adr6jiPOM5TBTnYYF8nGQzwVUtUS-PDZkqZ-D2fDbiubRtUmlDngp0KJLT8-vOU93hI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06iGMZx4ts8BRwWFhH2IXsD22qZAoqDlreAAI_JBiyGg&oe=69EF4BBE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
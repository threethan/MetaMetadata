/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n48ukH97K0EQ7kNvwGjuBvl&_nc_oc=AdrmL0YmNlavLd4LF7Cg83RcAZNqFtAMIOllRiZo-dglKw0g7Y6A_BR5i8_dpNT46mU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYNPSq3XVJyKdd7tZgUSfDJ3Dr-wOUF40zx4XXyAsMsw&oe=6A7F1FE9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbhYdq_K9VIQ7kNvwH39iMy&_nc_oc=AdqN7KYpM0cRNTVlnRWRvJ6RzupD1qQ64gw-V07nc4As4J8fEgqDjYOyRCFFzfaxr48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEza0py9TWtGOq9XWPuDHnAuLjTmUwwb0EAvaR3eenDKg&oe=6A7F2982"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xLqsU8I_CMQ7kNvwGS6Nqg&_nc_oc=AdoflCJ6hzwu4llB7npN4rq8z5lqsIsOhIx6rDPfMT3AwA86DKP6V_T-ALEiGo3yaPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFodPz_tcaQ26cjyuNdFrUQOyIMalsJpOSNTmmSo-EV-A&oe=6A7F2A2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTitRNMxm-oQ7kNvwFSDaC5&_nc_oc=AdocnL6t5lOry94Syu5Y_DRmM_AhRBulFVb-nSTRt2rHWRb6LrxfFa37Ir3vpK-0iRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERlRoXtu4qcdCuMTyjz1q4hYAWsrkH6rb6FhTQZ_-HKQ&oe=6A7F0D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNyrzjH24J4Q7kNvwF31OvI&_nc_oc=Adrcu3CMFDqhcF764ZyQIIZmYtoQaRRpetN1__UakmhTZcUzXi6uAtB7sDABC4f68hE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLs9n1pdlvKpua4SN-QQUD8F1KWYFsORgmrk76m-VC5g&oe=6A7EFF3E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
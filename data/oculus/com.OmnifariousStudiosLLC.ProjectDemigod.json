/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM7m4o0ZfXkQ7kNvwH-7deZ&_nc_oc=Adqh7r4hcQRx0J14BmgGnIf5dE4Z9TQj6IcvgCJloan2u5Ij_GK1nDnFmdqYrV2Evic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A5SqFj_-WiICa-d5LpnpTr_Ea8lOMabbW2k8SbjEBXA&oe=69D65FE9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBotdruYG8MQ7kNvwGqsRNb&_nc_oc=Adp0nyOy2XA-t3IZMUDh7EllPOWmpE1ApsDwn47mxO6LYA84ZNXE0x-pFd0K7Uioxd8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tu8MYyEJ9f9ZziMVtxekNgmS442NXEgRMR4fdCS5DwQ&oe=69D63142"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6-9pdLgvSoQ7kNvwFhZziH&_nc_oc=AdqhTtd5sd1fBJvMRD-VT4u0AVnoHiySIlUvc4ewDCOFO88r1rSA6EcviqMksnRv4dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j_vzLgL3uwz0hlRs6p2pJ3ZXuHLm3UiBWHDyAYbuq9w&oe=69D631EE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIuMtzRRMQoQ7kNvwFMhIQA&_nc_oc=AdoGSnNx2TZ2D_VnrzU08cz2MjIbjSdPNMstno0L_mod9PkSinX-sV_lSVc_W6nKc6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LBggfxzj8HiUQU2MgViEU0jah4H8rTsPXmvb8E1Ev_g&oe=69D64D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIsRK2SmbzYQ7kNvwEGyBSF&_nc_oc=AdoFqgou4fU0dD9RB_zInANPhlN2yHHhOEcXFbRuy7Q8B7HlQKOrGRKA8yKUF2atvcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bGJLX8yqtGJh2m_Mv0Gjo1oAl6MLFKwzt9TAdiczf2w&oe=69D63F3E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
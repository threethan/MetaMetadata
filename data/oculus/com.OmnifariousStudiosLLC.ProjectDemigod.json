/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCH667TAhu0Q7kNvwFlmuv3&_nc_oc=Adqtd99NUzO7AARcoC9bvFgL7tIrLAA134jp5vZ8Okl2TfQA101bDuZAqCjqtsll5xQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYlK7yn6n35IfvoqKI9JN6c6UlXQrebYN9WrAloix14w&oe=6A564169"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrjhE9AhEEoQ7kNvwEfx_GV&_nc_oc=AdojWiRggDQBeU974rz2Ev-wTaA8brHb-XnIB7hkLgpuDoudHraYGVP3Kfvt1W2iYCY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6djbwV83WozN43i5oPf1QqcL_Ga2jDaP-vnHHm7kjGA&oe=6A564B02"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0DjJYA4oBUQ7kNvwGYHPuE&_nc_oc=AdpyoFawe4I7OP9e0JLO7YAXIMCUoFpRa3d_M10UAMaYIKcXr3t8YX0ib0ytx-PTmX8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlk5PXWI6RIa_mGYT9RaaPPTGNh0ozAOSe82lNbeqg7A&oe=6A564BAE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKi-GbFyk-QQ7kNvwH7zgir&_nc_oc=Adq_Q7lOgFWFlYjJ8CKK7TF7FFCdIV0APZJ3-EmDYG1eqTvu0-SvNzKQRKZDqUDIutU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRpnuYOeNwM0WqHqZEsMWV144lqlyCr_vndxbR0WoVtQ&oe=6A562F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0tqZIEUmPsQ7kNvwFCNEOL&_nc_oc=AdoUdvD4dpYceWCsvxZYA9cGvgVncRHFEljLa8RL66JGld6kXHmjYIIEAwKWktflqxc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClf-PgBT8a5S3nZyOBTpSObx94Vrh1YwtPpDJkMbZg2w&oe=6A5658FE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
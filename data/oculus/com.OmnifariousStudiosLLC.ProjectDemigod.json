/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8HQCrMDWZIQ7kNvwFNDfci&_nc_oc=AdqZNHfv0SSoy0iGEPy4zBH758pPVqupCPAIYI14hUWUpcQt19X6Y7NljTwK75Cidyw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HY-g3o_55p5CPbWbnizgmetZTm07LkXkpupX0k7XEZg&oe=6A0332E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCNFXvwVvH8Q7kNvwHLanWK&_nc_oc=Adr7CdOWNmmJjR5DVmRyqz320DR8u6kXshHNB0vVVYarhGZPCF12dQzMgT4veYn1eS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-itGbuX4Zr7CZzm-PQh_bnJR_Yi4ThYwLtxvhdKYHJQ&oe=6A033C82"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7ReHhshwCIQ7kNvwGbX9aa&_nc_oc=AdpHF1u0I1cPdSTy5i6CuqHVecSEqmzTWZO3qvaZB-2ncaWZHXIHB-tzzXgRAMV8W0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Yvqi7ac7Ml1pl9hgVx95XJll1KurPwnvMmlgdXVWj8Q&oe=6A033D2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF3Hlr6rZUoQ7kNvwHH67k8&_nc_oc=AdpTwslVQtMPU5X5NPSvQ2aKUCdc-QYy26EkB0nSXBk3K8EqnNiMdLet4KOXCULpJ0w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51aVeX6lK9MAwitDsHpDTAO9YKrCPDAUGB0q1xtYaEXg&oe=6A032083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0MDIttF0ScQ7kNvwF6N-ZV&_nc_oc=AdqARjJ3Qk7DyKmg1tWKqm2tzDTlUaKo-MqTEbMMaFEE_FaOeKUKUy2oI4GN_silNc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ExOtmzYFRL9s44rVrdwzXHOEDZ0_GX0xq6lk8PwjHw&oe=6A03123E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
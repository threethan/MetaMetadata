/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLksBL-x5SMQ7kNvwFNW6XF&_nc_oc=Adq5pJM6J0AB-nxGFbzO6FrwYml2_WPOvy5I-M-h3lLc89hvNzvn9NJ48KRFatqBh5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G7oMXvA-957J3iATEpLeHu1_-jCPkgUnPB5Yl9djAsg&oe=69FF3E69"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN0LFKIG0icQ7kNvwGbldvd&_nc_oc=AdqtAJiG1H3F2lv6Phvrz-nACW-qpF0wMd-_6_545vMqMBMIomzECr_BzC6mYwRjuWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79Ot816F55QtbiWw9iwXAYC_yapqi3-DMSqOMutY9AjQ&oe=69FF4802"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiN7K2_jyesQ7kNvwHVXJ24&_nc_oc=AdpT5DIQnNOxud-AtQClKsCSnfnbrbpcbNWVwY66nZVRg58KyfPztcwyN32sC62zwE8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jdyxCEVkBKWwRa9jVxjCN4RnrPnYhnXwQ797KDUGrDA&oe=69FF48AE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpxNE0T0oN8Q7kNvwHto8Mt&_nc_oc=AdpkHWbluPJVfxXOkNDtJwmjUh9gLozjyiioUlWhW7DxPpN__l5hP14YZX2Nk5ii_lI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T1nix0b12cf7055atYgZ1_WKd7hA0iSglJJAF_fL4WA&oe=69FF2C03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rttRV1ZFs0IQ7kNvwFIX9Wi&_nc_oc=Adqo2d9txOme4w5W1d_LGWKzQCcWI9Lh388sybrx7EYEi2hLNdiv7ApgL1H-yamBHNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6urg5o41BQV9AaUZteQ7t9jwP9ENKCmLHEVAK3cTGcbg&oe=69FF1DBE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
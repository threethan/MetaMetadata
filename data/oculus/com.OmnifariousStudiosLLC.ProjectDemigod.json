/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5UC1I_B9doQ7kNvwHvnCLw&_nc_oc=AdotnBuQ5wa9O6BDdvZzkzxsvpJmGg-gRZWOzwKwSEqYFKfrk-V4dpkD2CDU8scUQRs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16CE_TZ-47lYOcZZmO2RY76Ie7YDthOs8Lw8Bj0jGvuQ&oe=69E78369"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaPLJIywU54Q7kNvwFiJrCR&_nc_oc=Adrih7aBaUUeW2gTeTmby4n3O8QdKBSlJfaogPSdGNzFEU0hzxid2XymgUnLNkSFjpQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-T3pYwzryqBvYyKqJ79vgfqEvqarxjf3jf9nRCiSFzw&oe=69E78D02"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfw6tlv81wkQ7kNvwGhQl67&_nc_oc=Adr0g87ybt-vHwC9Mij48axbpNMlbJ299HBGDWY1ZC3VRoRD9qvuxhStiFJRMTMydA0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0piipuVRfHRF3qSQ2f1lNHv-DQrAI2FQH3w_pECYoczg&oe=69E78DAE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAfbgsjr9GgQ7kNvwGb9eid&_nc_oc=AdqwfuMT7P5Q_vSLjXIgI67bM9HVvIkGRIRebhuS_f4bnMUdz6b2Fsd0R8hllCmeU2s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vZD4LWKf-QG5Wncjvb63zr-SmsNd2wE6Gv-QS_3Q4IQ&oe=69E77103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zus1N3jc-dYQ7kNvwF5a3vv&_nc_oc=AdrotaoQ537gsXOXJk1JSrSGnDEfLlxYEFuNUBW55mbh2PBu65Yr9BxdtnP3l8Lu4V8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af396T4NaMMLoTFVSQAE5C9EF5unq_-en3QLAql2uhj8JQ&oe=69E762BE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw_JFTEYA6IQ7kNvwEDUTEL&_nc_oc=Adptfn-0FkqRCfwEJjU8Rd_nT7aAUGymG5OYgDItx2cJRSj4UuERzeanagGLOsB4n-s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLGg0_MYSUivXALAtj7dDjvqbFPIL8EHcLHKuYN6DU1w&oe=6A71F0E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrBVJYVlpLMQ7kNvwEfHJMN&_nc_oc=Adp1z8y6IMLO2CQWqWBEq2W_XvKn4O2FM9CBDjHek-7Lg9KKwNKivLerhwVPqxjb2ZE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRVucqmJo90ZQhXzJHf0NEmkq8R0F83zzHKhinRUzTjQ&oe=6A71FA82"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iej_nC4J7CgQ7kNvwGf6Xdb&_nc_oc=AdrBcRrdvvUu7YZ7HwFMXyMI56pgEwl4vfHYsuAtcqzov-HG88rAkStZflGyMmUjBMw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9eksCZromJ4MsCupspBWVLOtICmyYQtqom4bIZWuOOA&oe=6A71FB2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HikMfJJfsQMQ7kNvwF19x9y&_nc_oc=AdpHdF4gHPnobVeu_8fv1pi3B9cskK2JfnnIIz1-4s2Z_OEE5TEAdnIVnYGjzHSUaTs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFw_HubH4_z0hoQrjxCohExuargoT-gjQwwueJZiwCow&oe=6A71DE83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLC-bYyr0M8Q7kNvwFTEHX_&_nc_oc=Ado736rfw6Vw_W_qXicH_9vIp4Kvb67bMrWbI4TswIwdOhTo2G2RHZg2jjomrV4Z9Lc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3xNVilKVLTcXzJEybvcgDsX-rZpDoZKn_gKzQKmLYyQ&oe=6A71D03E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
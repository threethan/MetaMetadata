/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2_vjRltJUEQ7kNvwHYAwhm&_nc_oc=AdpsOIWpmUG9_OSiEC0huprcCwpmkV5mEhicTJbTfn72DXcoCM9uvxILcnPerV-R-qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hQ8kd-KaWqcHzM_de2bxtSUB-4i3EajjEzRehWXdQvA&oe=69ECC969"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCxNdtOG17UQ7kNvwGlwqrV&_nc_oc=Ado3tS1i32VyuVPuNiEOyC7T5GrSCF7nY-foE7GA3JsEKTkRxmzSqI1FqZnG0LHIqgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03TVonffeFi3KFIhVM-L3C_7Q1ztsTUetQrG2XJTXECg&oe=69ECD302"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKQHcudZtAIQ7kNvwHRi3fH&_nc_oc=AdplBPc6y0s_rF_sE6Ep6rnjSPpEBrlHOUBqZl_MimlcWwajl26nTz2JWxjnU_IkJXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jzckJxfE8ZO4e-cvWaOhXeUNvKqDQ8OWJ4a4jdUXWXQ&oe=69ECD3AE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsB3Tj2_PS4Q7kNvwEF_dse&_nc_oc=AdqhEGm0oohEPYxn8UUF0XynerrAmmECte8CuxAoDN7lLiRfC1e8D_3Lm8K-q5UIR3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c85XLtC15wG66BSBTAlt8tZBy--kOqGzSKGhTXlzzGQ&oe=69ECB703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9WFatfKsW4Q7kNvwGGxlPM&_nc_oc=AdrAjK5YS6Su10QAIj2onlBfyCln6gOVex6H6d2RNf8WTrZksa1OWfpTLA1tVsDHO5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mJ0OGeSkGJzc1OE721SYQy5hRnUy4gmpmKFU_6hHwJA&oe=69ECA8BE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
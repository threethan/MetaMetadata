/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mWr1KZUrfkQ7kNvwGrDSbA&_nc_oc=AdpoUTYwICKu0DEOnBhUYDbJsPIjqutlPEqrBvmaqXVhy9BAWzIzG8H9-vQMVI9wArE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyZjSncWjWkwi4fwaC4uM6Ni-3ok7On7dcI3YTf1Vozw&oe=6A5CD8E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asTXeUG6gMkQ7kNvwF05LRx&_nc_oc=AdoNA33Q7eWkSU0VYYC3FjxRd8zN4he5MkjoEvXQqOdZ6pPhnsPH4q9zep4WBHChZXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLIRcEx21B36HOK9INAK42whSp3Bwu_EsGNfFIWPWakA&oe=6A5CE282"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuu7RsWH-GkQ7kNvwH85hom&_nc_oc=AdpjRizG8uT8WfUcoNIkCshPN-lene2XeCX57zL-wfhgLlt_vQsVrL6QMjeYXo0XeNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACuLWOvW3bTw7ZDAVYgYJgmV4HwsWlcAOeESNJzbb3yA&oe=6A5CE32E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OivH2JNkpk8Q7kNvwG5NtsP&_nc_oc=Adrh6fX22-Lz7ZI2QtAOsqaAkCUqfaeiVPY93XfHWKdJ9D4oLKphpg2Q2nBwlD07Zf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0LZN1hXIwJUe75F-5ICSyo9cjArIzjje9YN0bB1SyYg&oe=6A5CC683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_FmCrCOAwkQ7kNvwG7tQcb&_nc_oc=AdqnM9Y8Sp8CpF_Dqy7u7OTfUB4Pt6FJ3PzlMaBJCnxDERjsH7d9xpRMkqkEYZLi1uI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkEmDz0xbXwfpTbQRGgYQhcTAPNlaUHiNv89AlusxgUg&oe=6A5CB83E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mWr1KZUrfkQ7kNvwGzU5Ql&_nc_oc=Adovibm8FTRaTRqFMHwz7h_Rjd_bkmuf9boRcD51XoHO2iEJHjUMq5YeB-bZVFB0LFk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZJacmYko7I8n80aMTUx0833TUD4LdUC0_svyB5JI3Fg&oe=6A5F7BE9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qWUPUwC78IQ7kNvwHIDTQr&_nc_oc=AdqLeyP2gqYy0WHyqnxt3xKFa-BKb1pX53syF4aw9_Iozvzow5grS5vP2zhIOhUerfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr56fn8nUudaB0HEukNvipCgrYjOnDXPSvmCXp014jWw&oe=6A5F8582"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1Ui5yy2qTEQ7kNvwFOM0UG&_nc_oc=Adp2YeZGI4LfaJGwFMpYC-amx3gdDvI0MSEJ30NnC9zjDXw9_Z0ZrPCBGiQ4XMqpdgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr6fhVuhHEM4q4c-8eFywBXq3v-dAEXIk1iAMgXbEHfA&oe=6A5F862E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GKBS-7XIAwQ7kNvwE9wpnB&_nc_oc=AdobdO1OplY4NxwiODKDU1mc-WLjVp6Y9912PihK1t2266py1pJi211VjrQLoR9ppyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd4H-Ps7L2d7inslHx5kGgwkvPbEAeUIaRr6U2PMyYjw&oe=6A5F6983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_FmCrCOAwkQ7kNvwFQYLTg&_nc_oc=AdpU5kni2-DQoh5zRqwl1rkg54I0lrkSgRWmF_c46kYDomKVng0IKIfbaT10EWjTfi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnUgaYCcl_5rUssvdLmLbN5sNI3jLSl6QQ-VnMWiCmiA&oe=6A5F5B3E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
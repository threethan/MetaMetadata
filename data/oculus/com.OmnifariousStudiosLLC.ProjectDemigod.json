/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhbUwcZvQNAQ7kNvwGZvP6G&_nc_oc=Adr8HDa66LxxjCa8OLADttoTpWhzFbWo2IMTJ9rqmf9TdOXXvZGj9NqmB6p-0_RBj58&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qT8o-TlwUhIpXVB6gDIRBb0vfXB3Jr1r5LM9ReDFRWg&oe=69F4B269"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWxR-UHm7fgQ7kNvwEEIwXy&_nc_oc=Adpz50IqIBuHtvMJXpYbVYChPRGL-WzibNbdUm6_dqn7dMCKn9MC_vw452Q_Dci2h8o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31GpTA8LeZKzrdsGKhYAPVQImWHctax_O0Sr-9XjAgdQ&oe=69F4BC02"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-F8fgte9sMQ7kNvwFsxOra&_nc_oc=Adq-tBtlqlcAiFv4lK3PCSB3bXzvnv4uGnlcHK9Doud8VdELvFdwareabRAG1ZBte-k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZzNcDbOG45zWXp9bWEN-dYbs6AYGXn4ojEWZ0sUH3IQ&oe=69F4BCAE"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyoXaQdqHAQQ7kNvwGjfSpJ&_nc_oc=AdqLZNPqlDsBrROcm-0A1fwRYNIr14o3QTt7tfF3mmsSl6nUgTiGN-H4CZFiwD2G0DU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VjUnP5aipUFWH83H0AehjXc0cVmIJXJURf0YEpwZvfg&oe=69F4A003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns5e_3OY9d4Q7kNvwFK2Zbt&_nc_oc=AdpiAJw5YqKrX96bFT-ytjxUyz9eksO9YUFZeZAV0b6LAMN1VveLvG1J__BgX8lV0U8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MtbcgjMvvZl9usLvoaIK17Y39gNOvs4M90lXBlZQDvQ&oe=69F491BE"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
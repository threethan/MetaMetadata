/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM7m4o0ZfXkQ7kNvwFpgnnL&_nc_oc=AdqzV4-fIkXr_mZVbpklU_R9IYom6l81YyRMLYDPtuTMttbevkLaV5DokZbOXFls8o0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xBDVXNb7Hq_nDmWyDHez1q1-mtwHLMG7bnAGOSP5N8g&oe=69D902E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIMV30YjOocQ7kNvwEuzeSu&_nc_oc=AdpYRh-9LXacPpTa0J33rXLT0VfkItbvCI4fJJJ5YMzB-_5AoNnjlXjsH2DtVQMBSvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nd7hBbCdLmfIOftb5YaZb4sSYO4gBTh9VrzqqupPk1Q&oe=69D90C82"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzxwO_q8hXkQ7kNvwE0PgSM&_nc_oc=AdpiES6YXA_ah6_RDSSpBqUaiv5JhTdGEJck01EpZ94d7-G08oIQvdk_8jeFKnD0MsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bIYj9tx_UkpCXx_cBKhKuttqf8f7-CgTxoFxw1dQ6XQ&oe=69D90D2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okkCLG06WikQ7kNvwEoKa_Z&_nc_oc=Adr6hlsFjT9Op_dS28_ZrdOO9W0N9MyqJ2oOTJLBoE7e1ZEefs6KDayfhRRN1qImLT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fCv3DDdPCAtjQuUPto5mMSD8RTcW6YQb_GETZmxE5EA&oe=69D8F083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIsRK2SmbzYQ7kNvwHe1pa3&_nc_oc=Adqx8OPl1xoxIDMUZNvusBRYR5XN27sHV4mOF7_1Cg_JQyK9sQ-cktZP-LeIx9XbnP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tjEHPib62Mp-u9y7DeYFgbspEumdG4V1peXA82KDoaA&oe=69D8E23E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
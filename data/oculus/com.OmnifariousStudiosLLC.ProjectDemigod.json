/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moAYmgcflj8Q7kNvwFMTPCE&_nc_oc=AdorxvoSEwL0jh9DSLjQgr_6mHfkUC6rDJiidT6F8hEp90K76WTSwyjIz7VfLB1noko&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HSOBtHG8xmsgAVKpBnUSdHDSZUnQ14_oi0BImn0ptZQ&oe=6A1061E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNnzpnVA2TQQ7kNvwGDfiyP&_nc_oc=AdqAWsTPkVHurnv91W0thH3xw6CLIZb91OWRrAbZs8VqsMT1fyC7Nf55QGQRWm_m1lk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o_ff7leO0dpLofBbTGKjlCKHb-uFIld5kNfZRYjx1tQ&oe=6A106B82"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iQ99xI0V9QQ7kNvwGlKcfK&_nc_oc=AdpF85MK74WjLdYIIQQ-TeEX2wVdxCM_u5FwbWzbcuVPEa6CyCcjgYz_3ONGV5E3lw0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gpt5xk8loNpXXziJkV7i_U8Ie5DCHnOUxCggy6AVd-g&oe=6A106C2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnSuF4vXF84Q7kNvwGgB0Lz&_nc_oc=AdpiprWc8a-oDMO81DkJurdpHag2SHpzBhEEHbM1BzH1J1HR4D47Al4u4CZHDRlhnFs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_1dq8qV49hvqeLDC_TE4maS9l5sY4zf6HMg2kpmcppA&oe=6A104F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTPgvZxDjpUQ7kNvwF2kv6r&_nc_oc=AdoEkQ1gR3hUfB40LVnF3y3XY9LC50KjcYzUFfVU8b8-qgPOTpGA1J2jU5ON68p0VBc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IuXA0Li36fUWN48oI_v807uXk40AzzH5pt0bzqxMLIQ&oe=6A10797E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
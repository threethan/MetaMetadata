/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciY-uPu-zS8Q7kNvwGK44Ys&_nc_oc=AdoGunR0nE1MNNbSK9M8FX1s-p9KAZ2eYuYyF-YJgZVbB4Rq8-4kxJxS-ZZyupt0Bog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTXYSeUG3aIX_D6y6IpovDijl0Bt-DzfG_nIf32z-x_w&oe=6A621EE9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74RHyRD2vPoQ7kNvwGJFR3n&_nc_oc=AdoIoVClnoNhM00dYYK1KabMefg1YDC6EthExu-ahc-gWsHG1RTcpDeMN9WCajg16Rg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFo8fo4uUIto99g8Ii34zs9S3gGLBjAullil6UPl5jaA&oe=6A622882"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKuKu0zFJRUQ7kNvwEVN3OT&_nc_oc=AdpNhZ92HNu3-O4soMWFfNF8g_qsO7Px429E0Py8hO53bL27UjEGOR6kliLyl-5OqTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWx6oSpETjSG7IEuIsflBGQ8JGVKqlR-hH599pbwuyDw&oe=6A62292E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GKBS-7XIAwQ7kNvwGIFs5D&_nc_oc=Ado-ZgO8mgPnmM_hwCEU9D8uaxO_o0hQgOiiByCQAOvWvX27ZKZpIiivoEXkEZvCrOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjK-Arbq2bcLwhj2twA6yEtukiK7Z7k4Yv5Ty_fzXTbg&oe=6A620C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rayJPViYFv4Q7kNvwGHet3z&_nc_oc=Adr1Jl8FOllleuLlsdUL0j9fRhfooeZrDBe5Dn6F4RuvXKZROuEYXA2gP7Aqz74fFD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBExatHi6yy3lE9T-298SUgFQ9o9bVKemy35PnJaCVckg&oe=6A61FE3E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
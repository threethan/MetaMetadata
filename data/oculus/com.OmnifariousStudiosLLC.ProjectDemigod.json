/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2_vjRltJUEQ7kNvwEj74b4&_nc_oc=AdrqBSUWIK61b5iV2uPvnQS8HnWpY3-ptgzC2UkGNhs9mD_vut8qwIUv0_q1XPW_XAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r0q4UKYuR96A4lzvTEyZIibpl9yGsgA053qapy7YUzA&oe=69EB77E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCxNdtOG17UQ7kNvwHeIqVZ&_nc_oc=Adqnv6V7SvJ0bVbHWPitq-1LU4XL9FVkEFRr5bcO0IN8Ep8CMiHtQdzpz4Z0YFJp9Ik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-BNUU_agnSyKKRhBkhDfYVUnoTMEJGR06QyoNvn4dsw&oe=69EB8182"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKQHcudZtAIQ7kNvwHtldV0&_nc_oc=AdqzYRdB17AYOngxXg_NzyKe-EJVvqXgqeGBlqhV6HxWjvPongPiInlWbsu8QI-ibxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hE_QYK2dhJLSmtY4-anQnuVXSMMksJISN5Z-HgTSo4A&oe=69EB822E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o9HSo7fh20Q7kNvwFUDnlR&_nc_oc=Adpx1UQW7SH8A--S0PozbbK8Dc4967ssMPPtZYMJpadBeC4BzKzteHERnV7YjLJmqyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lQK_VhNBsdFYNy1Vkq_VrMlSgV1gJW5qEHQvC990NYg&oe=69EB6583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9WFatfKsW4Q7kNvwH0JsRe&_nc_oc=AdoxMS5N7AXsDjyBd9q3sQJiw-kRllfDD49Wo87YFYqul7B_npq5kARyRMbyDQb_5qA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mirxm8Cmsf2JUhHawDgpJf6IFTFeX1JksAscZgqXN8g&oe=69EB573E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
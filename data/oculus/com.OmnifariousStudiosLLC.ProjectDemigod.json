/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJLXuTVXRD0Q7kNvwE35elO&_nc_oc=AdrgsdVQ3pfkQthLnMUGRPuDZndSCLv_NR8W1OYRaHT--251Ob1CX2PAb5-kwd5cQjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA5pGTxbMllV-u81IogOz3MTzlje7DLq8XpRe8QkA7Ig&oe=6A7736E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYCUdD7NOokQ7kNvwGa1wFp&_nc_oc=AdoTNshR6iQb7MdIBDlFYiuRJcVvYarKUJBuQge64bpSUROeqre7g5m_6jp1zaPe_-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVoOfHHwigvNn8NANU-F4HyD5_AFGTA8ohXI0dbS92KQ&oe=6A774082"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYP5t0NYLp8Q7kNvwHdj8Wf&_nc_oc=AdriIGUtOdGs0kiK3YBLQ7UzjExTSVM1QtV5fKdo8dnOUi_C8eL_0btYTLrCMWTNmnc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH76cxfssqPENeugq730aHyRAEqXyvKQJsbu_qTfc0SJQ&oe=6A77412E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbhU92-rNGoQ7kNvwECvwz5&_nc_oc=AdpI_uZdgyLl66jiBjOBm-HHvZaCxbayI6QJUVC5kRrMNVwi4-JCxqcPo89gum9BepU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnmOsNC38P2DIlvqssFoCzM4iZhKiQ1iqVsMx8veuxjw&oe=6A772483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLVK3qaaNm8Q7kNvwFyrZXq&_nc_oc=AdoYe2eQk8eB554zLcs06t46KxrdNeawuuFuCUouy1j3LjM4bCsP4IDm3JAZKY1OqUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER0wfz_xxJJ0sa65sxLodWNSpOous58ziDi41Si886Eg&oe=6A77163E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zhbUwcZvQNAQ7kNvwEINBbQ&_nc_oc=AdqmoGZp7VDt3yCny9YE-1Y30Az8beWBth1-j77wE74snlZZnMCKMtHzhlOhwVHeTtc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0o1Rj0aOW8IqmFuI8viOn9QDZTTD1iMKzirRUpWlcJ9w&oe=69F360E9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWxR-UHm7fgQ7kNvwFDRlsd&_nc_oc=AdqUxuQ-Jw1geRfeo-u9tXtqRikQpgoPJGbtbXm1I7kutxAmVNobs7B5nWkkLIKOe6o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kLIgYACEVmO_PRJJMDasKAHvnGBHb7TERjVdP_6ZyYQ&oe=69F36A82"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-F8fgte9sMQ7kNvwFSnFXj&_nc_oc=AdoQ2fqW36ZBnjleN3oCsAkeyOXwIjUBjM1-aH7Z0j0Wkl6KhpLOpCk0DJY0Ca5YtAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3i954pzny7WpBbIkTTd631VEnz-LeqjJyClNBDbDfPDg&oe=69F36B2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN8k5jOmErsQ7kNvwFdpAtK&_nc_oc=AdrOzaIJgFkDhXoovmzlhc7CmwZ-hVSF2KedceHFtT8cEIT_94f6jnj1UTgCslIgWMA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af024ZPeZCw5NcLElsoTTd2j2Lryhv1z3LTDDdRfE1A0IA&oe=69F34E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns5e_3OY9d4Q7kNvwHRQ-ut&_nc_oc=AdrSvTKlvz0FCNdQXM8JrOfAHsU_CVLDYIjZX7p15hzhq-0p46S8RNZJjPwuFvn80NI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af360pXEPmrzxf1o6Lg6LBdiKKBzDgEuakNlWxUZ5rkWjg&oe=69F3403E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
/75295892_1898413017013891_4660130567463282723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLksBL-x5SMQ7kNvwHfnCtq&_nc_oc=AdrdyRjlaEKdUCtJR9F9Sgyt21MJHKA1EggntnHkj6S8eOkslTFGzvJgAtQ_wGc-sys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DsHi-TorKLcOVhgJIr2hWL-xVnz8M8OoAC6FYCy7y6Q&oe=6A008FE9"}, {"file_name": "Screenshot 5 - 2560x1440.png", "id": "1340133476462138", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75644993_1340133483128804_1996324614234135544_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN0LFKIG0icQ7kNvwE5JJB6&_nc_oc=AdoimD0Q6I2Ufc0irfO3LEU5626HvjC122AxF9W12HW8yDO8gGETcsgXCFT0dzL2zp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oALHEeY7T60xru3WzX5gCVf3XHd33gKR48URd48qkVw&oe=6A009982"}, {"file_name": "Screenshot 6 - 2560x1440.png", "id": "1269765050222783", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003276_1269765053556116_388526223020720213_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiN7K2_jyesQ7kNvwGbDv_s&_nc_oc=AdpiH1RyedlPK_oT2tr-1uW97Hemk2gFGhbP2IC7VEXySnrwcE1caho4a47lqwD6G8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j93kfxXGciUFaNpsZURkUSDoWRDWt3IktuSVdjHkxHA&oe=6A009A2E"}, {"file_name": "Screenshot 1 - 2560x1440.png", "id": "708026223983820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_708026227317153_6235191163790820908_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF3Hlr6rZUoQ7kNvwGLa4Va&_nc_oc=AdpGvaH5q5cNTF2OZ4qhQcSF16rgObuIXRW-DoO0ZzXVaTvwP45GknhE4G-9-gFQ-I4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6meD8d9XM4p23Zwcx-ijVXV8-W0COWMhP_BsHbsSBn9Q&oe=6A007D83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Project Demigod Art - 2560x1440.png", "id": "1424577327984168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569423_1424577331317501_5878905771002281500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rttRV1ZFs0IQ7kNvwE72p64&_nc_oc=AdoATaa4chC7c77xwD0IQHmxL0zdZ_vWzP7559VjnfSJh8NU_8YCaMZUPZFh48zfHpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44UIEHSNTftFz0qxBjIOn0_KSikV2n8oB35ZDT-0qd3Q&oe=6A006F3E"}, "display_name": "Project Demigod", "keywords": [], "long_description": "Become the Hero of your dreams, as you combine multiple fantastic superpowers in unique ways and take on Ninjas, Robots, Agents, and more!\n\nFight, fly, swing, shoot, and smash your way through physics-based ragdoll enemies! Physical weapons with full stabbing physics! Collect new abilities, weapons, and items to develop your own personal combat style! Switch power sets on the fly to create an infinite number of unique combos! Grab an enemy Robot, throw it into the air, jet boost after him, and then punch him through a wall, before grappling him back to you for another round! Destructible Objects! Use the environment to smash your enemies through walls, floors, and a ton of breakable items. Future updates will include additional powers, enemies, levels, challenges, storylines, events, and more!\n\nProject Demigod is currently in Early Access, and will continue to receive constant updates.", "short_description": "Project Demigod is a Physics-Based, Superpower, Combat-Heavy, VR Game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.omnifariousstudios.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Omnifarious Studios LLC", "support_website_url": null, "website_url": "https://www.omnifariousstudios.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
akes VR adventure. Swing over massive drops, dodge deadly traps, and outrun the evil Kryon in a race to the top.\n\n\ud83c\udfc6 Endless Mode: How high can you go? Compete for the best run and unlock powerful upgrades.\n\n\ud83d\udc3e Rescue & Evolve: Save trapped magical creatures and turn them into powerful pets\n\n\ud83c\udfd4 Adventure Mode: Master unique obstacle courses across vibrant, dangerous worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/endless-climber", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/endless-climber", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26693969490203748"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491831382_1352879243119072_8457101621697088770_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iK6avS7FA4Q7kNvwGf79eo&_nc_oc=Ado5K5OJvCQ2v3EpXS-8bNtIx-lem7v_XD-6ri90O7vEqtnIwmMcQZmc0qDXyM0bgEU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ilrykl6NGK3yr5CqkvzrWJCPOS8JnI861pOMFVsiILw&oe=6A36C41A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Endles
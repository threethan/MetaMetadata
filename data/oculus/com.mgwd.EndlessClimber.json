71-25/491825503_1409242710641194_6183906082100107424_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQBGkiQ39UMQ7kNvwFpfrk2&_nc_oc=AdoPU5X8Iro-FwDWzZTmAVr0RjR3le0T-awrmpgs6p-aiWPwTCZxubNdrpo9hm0bRJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHmBerxKZkZawvRoSyp5WTwIHQyQPVoPEmiC2aU_CnXQ&oe=6AFDC309"}, {"file_name": "03_Endless_AboveTheClouds.png", "id": "951836244206690", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_951836250873356_6610828544254200856_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKMEtDL3e9oQ7kNvwE4OH6D&_nc_oc=AdpNx3cy7a56L0RaO-DvT170t8WewlhSUpUEP8BDYpBimbyD-kuC4fqfCPHHE_WhN4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBPoW-jnoDVj9OfSrt23Jnu2Cs3_4RHvQYX3QitsDhQA&oe=6AFDDD97"}, {"file_name": "05_Adventure_Galaxy.png", "id": "1779690783280572", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1779690786613905_6243510663312883407_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlNcBrPG9t0Q7kNvwGNpX2x&_nc_oc=AdqXNXLpotZObJOcmLQWRIk0HhB4eltbJ7R1KxqOQRmDJZyX-hwyS3ZlBoOwlu3KgeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS03Z7-Lzz6WAffYl7D_azA2L4tmkBAzx3_-U6a2JG6Xg&oe=6AFDD795"}, {"file_name": "01_Endless_Space.png", "id": "856762027458928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_856762030792261_1874239182962298113_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxlUX0sb03oQ7kNvwFvCJV9&_nc_oc=Adoh2MxR0qXVMP-8kWy5GK1jYf1oEsBljfgx6lgqfnkvae7ukBS2xlxl2qVJe442ebw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZBIWknetqs9gGxCf9COIdPjKJUNoxYc_tmodISfVjqA&oe=6AFDBEA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "06_Kryon_Boss.png", "id": "4882952745273988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_4882952751940654_4770352917109921287_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiiZyfG64gEQ7kNvwEI46ZX&_nc_oc=AdqcAGyM6Cp2Zz3ecMrkRpB1xWuFeKRlIuO_G5B8UTfC7Rcot94GulW3GL4QOUYCGIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSog_l39Z1sQX2TI3v9T7-L6Dv20sZrwZwcLJyG0neZ3Q&oe=6AFDBFB7"}, "display_name": "Endless Climber", "keywords": ["climbing", "climb", "climber", "endless"], "long_description": "Can you handle the height?\n\nGrab, swing and climb your way up in this colorful VR climbing adventure. Dodge deadly traps, outsmart the evil Kryon, free the magical animals he stole \u2013 and find out how high you can really go.\n\n\ud83c\udfd4 Adventure Mode: Climb through vibrant worlds packed with traps and surprises, from lava caves to a neon galaxy city and the Wild West. Then face Kryon himself in an epic, fully voiced final showdown.\n\n\ud83d\udc3e Rescue the Animals: Kryon has locked magical creatures in cages. Climb to them and set them free, and collect pets that ride along on your hand.\n\n\ud83c\udfb2 Surprise Minigames: Get shrunk by magic for a game of Red Light, Green Light, play the magic drums, take a ride in a flying space car and more.\n\n\u267e\ufe0f Endless Mode: How high can you go? Climb above the clouds and into space, beat your best run and chase the top of the leaderboard.\n\n\ud83d\udc65 Multiplayer: Climb with up to 6 players in Endless and talk with voice chat. See each other's avatars, hands and pets on the wall.\n\n\ud83c\udfc1 NEW \u2013 Climb Rush: Race your friends across procedurally generated obstacle courses full of saws, smashers, swinging axes and crumbling holds. First through the portal wins!\n\n\ud83c\udfa8 Make It Yours: Avatar heads, hand skins and pets to show off in multiplayer.\n\n\ud83c\udf0d 10 languages with voice-overs and subtitles. Comfortable for all ages: no walking, holds within easy reach and smart respawns.\n\nThe Kryon finale, extra worlds and many cosmetics are part of the optional Supporter Pack.", "short_description": "Can you handle the height?\n\nGrab, swing and climb your way up in this colorful VR climbing adventure. Dodge deadly traps, outsmart the evil Kryon, free the magical animals he stole \u2013 and find out how high you can really go.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/endless-climber", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/endless-climber", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "fr_BE", "fr_CA", "fr", "es", "pt_BR", "it", "pl", "ja", "ko", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "30031893296411334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1119842797334112_3095697969855720750_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBPKKLX6vcEQ7kNvwEBp22Q&_nc_oc=AdoVtOU3GhSUFhzK891XQJ16rd8utisMBzx1WBi_uyTCMTmEBaJJ8Twbjo3ejhaZoD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoiZKdxD-_LEQYcbMFMPCPHREovU-tX1dbn5a2EiAqfw&oe=6AFDB07B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
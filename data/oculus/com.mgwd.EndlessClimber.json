lers, start climbing, and let's see how high you can reach!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/climbervr/endless-climber", "developer_terms_of_service_url": null, "publisher_name": "MGWD", "support_website_url": null, "website_url": "https://sites.google.com/view/climbervr/endless-climber", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24033565636244160"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "958582906343706"}]}, "baseline_offer": {"id": "958582906343706"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742559420, "status": "PUBLISHED", "id": "958582906343706"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27252275581039800", "version": "3.1"}, "id": "1329746188262326", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23998983969702327", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27252275581039800"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1776497483, "id": "27467575012843188
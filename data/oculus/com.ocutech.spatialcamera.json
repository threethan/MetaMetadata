282917647935_5699105796805964117_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8QmVIg67doQ7kNvwFKbLtA&_nc_oc=AdqWMuIS-4BxKZJi8KzvCWsroPPPryHvucj52ycJSV638yNA6Zz35Vv22zmDKVzaGps&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNQH0f9liyOLvJlrxRQD94QfRjpJZ9vVlnbBE8y16acw&oe=6AE8AB88"}, {"file_name": "Skybox_CenterEyeAnchor_20251006_173459.png", "id": "1306521733858660", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307466_1306521737191993_6137309811360860216_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyVCyreWwAcQ7kNvwE6sKRR&_nc_oc=AdrXO_kflwhfw6mnaqQ_-GwrIZnelBG4q8Slk8w1wVvob2x2Vdo9OJbSoL8_U96mvzo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR63uZvQIuFY7HNnj3JzhPs9caKUu6FYQm7_6-bV9_eRA&oe=6AE8B687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1 (0;00;00;00).png", "id": "804240075882628", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307311_804240079215961_7631205312557712740_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMPbGuTEP60Q7kNvwEPCekf&_nc_oc=Adp3SFBC3QO7tuTICIj8pxRsswOHDkV-DNv8MmX1GEYOJ1WWIjtuLZ-48sKSwoGvhZA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmUJ70mLHDWubH97tF7iPdN3deSADt_96-acS3pbsBjg&oe=6AE88F22"}, "display_name": "Spatial Camera: Capture in Immersive 3D", "keywords": ["camera", "recorder", "immersive", "stereoscopic", "video"], "long_description": "# Spatial Camera\n## JOIN OUR DISCORD COMMUNITY\ud83d\udd17\n<https://discord.gg/wDVr6SZgUw>\n# Experience your memories in a whole new dimension.\n\nWith Spatial Camera, you can capture, save, and relive your moments in stunning 3D stereo. Using your Meta Quest, the app records both stereoscopic videos and stereo photos, bringing depth and realism that standard cameras cannot achieve.\n\nNow capture your moments with richer colors, smoother motion, and  stunning **60 FPS video recording** .\n\n## Key Features\n\n* \ud83c\udfa5 **Capture in  SBS 3D** \u2013 Capture videos and photos that feel alive with depth.\n* \u25b6\ufe0f **Direct Upload to DeoVR**  - Upload your 3D videos straight from the app to the DeoVR platform.\n* \u2601\ufe0f **Upload to Google Drive** \u2013 Upload captured photos and videos directly to your Google Drive. Files are organized inside a dedicated Spatial Camera folder.\n* \u25b6\ufe0f **Direct Upload to YouTube**  - Upload your 3D videos straight from the app to your YouTube channel.\n* \u25b6\ufe0f **YouTube Export (3D Ready)** \u2013 Export videos as YouTube-ready stereoscopic 3D.\n* \ud83c\udf9e\ufe0f **60 FPS Recording** \u2013 Record smoother and more natural videos at 60 frames per second.\n* \ud83c\udfac **Video Stabilization** \u2013 Reduce unwanted camera movement with **horizontal and vertical stabilization**.\n* \u2702\ufe0f **Photo & Video Editing** \u2013 Trim captured videos, adjust **brightness**, **contrast**, and **saturation** for both photos and videos, and apply **LUT effects** after capture to achieve the look you want.\n{1221744230098041}\n* \u2728 **Effects** \u2013 Apply real-time visual filters to photos and videos.\n{1177879637059615}\n* \ud83e\udded **Level Indicator**\n{1386089979616462}\n\n* \ud83d\udccf **Depth Indicator** \n{943060188871182}\n", "short_description": "Spatial Camera lets you capture your world in true 3D. Record stereoscopic photos and videos with depth, save them to your native gallery, or explore them inside the built-in immersive viewer. Relive memories like never before, whether it\u2019s daily moments or special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sc.ocutech.dev/privacy.html", "developer_terms_of_service_url": "https://sc.ocutech.dev/terms.html", "publisher_name": "OcuTech LLC", "support_website_url": "https://discord.gg/wDVr6SZgUw", "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cate
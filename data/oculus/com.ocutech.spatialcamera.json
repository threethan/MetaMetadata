3880251_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9p51IlB2m8Q7kNvwEp_p5W&_nc_oc=Ado7WaNf7X4tDTpTmQ4LAXq70b27Z6QojoyYnQaQXO9T01Ww1It9Jit42pjvP-Bmj9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ocGEvfV_VFRviUgHiDNmDI3AxHyFSKspWDnSEKg0bA&oe=6B070B78"}, {"file_name": "Spatialcamera.png", "id": "655282910981269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_655282917647935_5699105796805964117_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUopBOhDmHMQ7kNvwH1m3_G&_nc_oc=AdrT-C5Hq1vdzg_HV2fVnwelOlTK6dV-j-dIXmj9SDbn8_PId0bzF1_v0BlYIDBbuOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ClneCYVkSWWYKGaBFgJReRU8oylDD1uGAV2USccMKA&oe=6B06FE08"}, {"file_name": "Skybox_CenterEyeAnchor_20251006_173459.png", "id": "1306521733858660", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307466_1306521737191993_6137309811360860216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMHOYUTJIxgQ7kNvwHnLrM7&_nc_oc=AdrTOR5LRBSruW7WWGZ4gRURbks_a9YzSYWMivZE-AsEpRQON3MRpDDiLyfofEJw05Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbwYQEaBDZQVr-Xkg2FaLTnuebyNJTsBwYT16_x-EBLg&oe=6B070907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Comp 1 (0;00;00;00).png", "id": "804240075882628", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307311_804240079215961_7631205312557712740_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzJuTja58jAQ7kNvwF-MqMh&_nc_oc=AdoxZCcST-nT16K2jfncPFLJYWv8BjbPK-a9kvca6akldulLdY_rBbp4PEDXC96COcw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHTTdqv11PTdr7D7j11P0KKSlnRAdjJ0RNsfaJMWA70A&oe=6B0719E2"}, "display_name": "Spatial Camera: Capture in Immersive 3D", "keywords": ["camera", "recorder", "immersive", "stereoscopic", "video"], "long_description": "# Spatial Camera\n## JOIN OUR DISCORD COMMUNITY\ud83d\udd17\n<https://discord.gg/wDVr6SZgUw>\n# Experience your memories in a whole new dimension.\n\nWith Spatial Camera, you can capture, save, and relive your moments in stunning 3D stereo. Using your Meta Quest, the app records both stereoscopic videos and stereo photos, bringing depth and realism that standard cameras cannot achieve.\n\nNow capture your moments with richer colors, smoother motion, and  stunning **60 FPS video recording** .\n\n## Key Features\n\n* \ud83c\udfa5 **Capture in  SBS 3D** \u2013 Capture videos and photos that feel alive with depth.\n* \u25b6\ufe0f **Direct Upload to DeoVR**  - Upload your 3D videos straight from the app to the DeoVR platform.\n* \u2601\ufe0f **Upload to Google Drive** \u2013 Upload captured photos and videos directly to your Google Drive. Files are organized inside a dedicated Spatial Camera folder.\n* \u25b6\ufe0f **Direct Upload to YouTube**  - Upload your 3D videos straight from the app to your YouTube channel.\n* \u25b6\ufe0f **YouTube Export (3D Ready)** \u2013 Export videos as YouTube-ready stereoscopic 3D.\n* \ud83c\udf9e\ufe0f **60 FPS Recording** \u2013 Record smoother and more natural videos at 60 frames per second.\n* \ud83c\udfac **Video Stabilization** \u2013 Reduce unwanted camera movement with **horizontal and vertical stabilization**.\n* \u2702\ufe0f **Photo & Video Editing** \u2013 Trim captured videos, adjust **brightness**, **contrast**, and **saturation** for both photos and videos, and apply **LUT effects** after capture to achieve the look you want.\n{1221744230098041}\n* \u2728 **Effects** \u2013 Apply real-time visual filters to photos and videos.\n{1177879637059615}\n* \ud83e\udded **Level Indicator**\n{1386089979616462}\n\n* \ud83d\udccf **Depth Indicator** \n{943060188871182}\n", "short_description": "Spatial Camera lets you capture your world in true 3D. Record stereoscopic photos and videos with depth, save them to your native gallery, or explore them inside the built-in immersive viewer. Relive memories like never before, whether it\u2019s daily moments or special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sc.ocutech.dev/privacy.html", "developer_terms_of_service_url": "https://sc.ocutech.dev/terms.html", "publisher_name": "OcuTech LLC", "support_website_url": "https://discord.gg/wDVr6SZgUw", "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29733877622880074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_4198684447070104_2861891936271857489_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty6B9W6zDQUQ7kNvwFdmjBU&_nc_oc=AdrwRB0zRn6QNZiAx2FQSZvCyt4cQkCZSOdgz6Qv9597AfEoZal9kp2-VoCSM9Sm-MM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4yAjz_orfNy1xU_3Ytx8yNqoidPQTdBQAjTshxG3aGA&oe=6B06FAD0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spatial Camera: Capture in Immersive 3D", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Cr
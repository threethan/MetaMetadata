_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z9ZH3kv_8svluS7CG9EEn47jo6OEXk6J-GdfaRJTCwg&oe=69E8BB47"}, {"file_name": "skscreen.png", "id": "1235742984978130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819464_1235742988311463_7505437730432176820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyiFyBhP4u8Q7kNvwGFY7V3&_nc_oc=AdrloSmrBSmquvVdEUzusaK7LOnU2HhTutNLKJqoBG5hv28zyQ_wsJLZ2rzSnwp41lU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af078rSPR0ofH26mxO3y1xv1-lyUVpcpiOEmda6GA__eCg&oe=69E8D472"}, {"file_name": "1.png", "id": "1303682761237775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821972_1303682764571108_6329760543969433774_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wez_9At44skQ7kNvwHL2cjH&_nc_oc=AdqbmbSz1cQMf9MNrBgXm6BOQ7m4bUAWkPSStRST-I0S9_zf_GBI6oCpPpFYSzZO6zQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RRFpfkKe4aHsrm5OuF37neB5E-vn-uwGMo_hcH0l-TA&oe=69E8CE44"}, {"file_name": "Skybox_CenterEyeAnchor_20251006_173631.png", "id": "1998090971035287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819396_1998090974368620_5744477503662598625_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njUi3fdthYQ7kNvwHhMG31&_nc_oc=Adpae59cRz6K8GTUke71lEdaUQAdQnJW73SsxidnTr5ekAJhW66gS-3FuMBMjTMZpP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qKDQE0ysv65uuRVi284wz7mvh7mGRtU_w1PnE0VOJ8Q&oe=69E8D106"}, {"file_name": "Skybox_CenterEyeAnchor_20251006_174318.png", "id": "1498609384515982", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820648_1498609391182648_5688435926984826421_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsABHjXa7k0Q7kNvwG-OCkI&_nc_oc=AdqXHAVm0OmpUmXAnr-k90-VMOasKgzzgccQugJXwXGU_SXCwu_p-0SKVc5fjMl3nq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rG2--f_bDbA0Z8ZA9qUmmBtT0dRgCYqp3aUnBF1zAeg&oe=69E8C028"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spatial Camera: Capture in Immersive 3D", "keywords": ["camera", "recorder", "3d", "immersive", "stereoscopic"], "long_description": "# Spatial Camera\n\nExperience your memories in a whole new dimension.\n\nWith **Spatial Camera**, you can capture, save, and relive your moments in stunning 3D stereo. Using your Meta Quest, the app records both **stereoscopic videos** and **stereo photos**, bringing depth and realism that standard cameras simply can\u2019t achieve.\n\n## Key Features\n\n* \ud83c\udfa5 **Record in 3D** \u2013 Capture videos that feel alive with depth.\n* \ud83d\udcf8 **Take 3D Photos** \u2013 Preserve stills in true stereoscopic form.\n* \ud83d\udcc2 **Save to Gallery** \u2013 Export photos and videos directly to your native gallery.\n* \ud83d\uddbc\ufe0f **Built-in Viewer** \u2013 Watch your captures instantly in immersive 3D.\n* \ud83d\udd04 **Simple & Intuitive** \u2013 Designed for easy recording, browsing, and sharing.\n\nWhether you\u2019re recording everyday memories, documenting travel adventures, or saving once-in-a-lifetime experiences, Spatial Camera gives you the power to relive them with a sense of presence that 2D media cannot match.\n\nStep into your memories. With Spatial Camera, your moments aren\u2019t just captured\u2014they\u2019re *experienced*.\n\n---\n", "short_description": "Spatial Camera lets you capture your world in true 3D. Record stereoscopic photos and videos with depth, save them to your native gallery, or explore them inside the built-in immersive viewer. Relive memories like never before, whether it\u2019s daily moments or special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ocutech.dev/sptcpp.html", "developer_terms_of_service_url": "https://ocutech.dev/sptcpp.html", "publisher_name": "OcuTech LLC", "support_website_url": null, "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221
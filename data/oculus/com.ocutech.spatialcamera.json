_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17Er8XMD3OewkBNwEjM31k146T67JVmHYPzlIyDjrOsw&oe=69EA0CC7"}, {"file_name": "skscreen.png", "id": "1235742984978130", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819464_1235742988311463_7505437730432176820_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSveRw9FhJMQ7kNvwE4MDlD&_nc_oc=AdqgckQ0XKGvtNJlWQJLfCKc73ZBJB_P93QBrhrqdz59JTDrYaL03VhJJ2xo5vbTN-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JRnrGPYz3hIdXHhMTJZDeWHpuwWhOJD9VVd_AoBZUlg&oe=69EA25F2"}, {"file_name": "1.png", "id": "1303682761237775", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821972_1303682764571108_6329760543969433774_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KTk96aDjNQQ7kNvwF5f-TZ&_nc_oc=AdoBMJ0l1fmJ3Fmm4GrMgL45NBh6D6l8bNRL1yu5jObRbrw4I2I4tuN3a-BoEMZnmbo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xR_m9MggcWTlLZ5g3zujA6CBgCISrEXhIEQNhY223xg&oe=69EA1FC4"}, {"file_name": "Skybox_CenterEyeAnchor_20251006_173631.png", "id": "1998090971035287", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819396_1998090974368620_5744477503662598625_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njUi3fdthYQ7kNvwEs7Rxb&_nc_oc=AdpohnCqA6XzQCP-yzpPb5raVSLTuXpTlMVkW4ynIPlXdZj8-naaXPQJ9rRdZF5kQ_s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B6blay7ZqoXCDtj-lyP-3wT47kntusFLnEKlP2gb88g&oe=69EA2286"}, {"file_name": "Skybox_CenterEyeAnchor_20251006_174318.png", "id": "1498609384515982", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820648_1498609391182648_5688435926984826421_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnfzbIcwdRQQ7kNvwEz-J1N&_nc_oc=Ado3hzAntAVStWijJW22K_cLs_EqNE-tsSpo-OI03skqfrCCVX3vePwIELKLymxTPqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pZusF_gjC0_w3JWi8289pqFNnpMNv3Fy6IK_euG8cug&oe=69EA11A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spatial Camera: Capture in Immersive 3D", "keywords": ["camera", "recorder", "3d", "immersive", "stereoscopic"], "long_description": "# Spatial Camera\n\nExperience your memories in a whole new dimension.\n\nWith **Spatial Camera**, you can capture, save, and relive your moments in stunning 3D stereo. Using your Meta Quest, the app records both **stereoscopic videos** and **stereo photos**, bringing depth and realism that standard cameras simply can\u2019t achieve.\n\n## Key Features\n\n* \ud83c\udfa5 **Record in 3D** \u2013 Capture videos that feel alive with depth.\n* \ud83d\udcf8 **Take 3D Photos** \u2013 Preserve stills in true stereoscopic form.\n* \ud83d\udcc2 **Save to Gallery** \u2013 Export photos and videos directly to your native gallery.\n* \ud83d\uddbc\ufe0f **Built-in Viewer** \u2013 Watch your captures instantly in immersive 3D.\n* \ud83d\udd04 **Simple & Intuitive** \u2013 Designed for easy recording, browsing, and sharing.\n\nWhether you\u2019re recording everyday memories, documenting travel adventures, or saving once-in-a-lifetime experiences, Spatial Camera gives you the power to relive them with a sense of presence that 2D media cannot match.\n\nStep into your memories. With Spatial Camera, your moments aren\u2019t just captured\u2014they\u2019re *experienced*.\n\n---\n", "short_description": "Spatial Camera lets you capture your world in true 3D. Record stereoscopic photos and videos with depth, save them to your native gallery, or explore them inside the built-in immersive viewer. Relive memories like never before, whether it\u2019s daily moments or special events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ocutech.dev/sptcpp.html", "developer_terms_of_service_url": "https://ocutech.dev/sptcpp.html", "publisher_name": "OcuTech LLC", "support_website_url": null, "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "36269221
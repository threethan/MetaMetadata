uyOo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaZ3Ci0iqm2AP8Hyn_MrVNj6-3BEfIQs-BSmujkcf4hA&oe=6AFC86D1"}, {"file_name": "4-panneau-menu.png", "id": "4555507768099694", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_4555507771433027_5245265479018135463_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puEBtj-f90AQ7kNvwFxyAYj&_nc_oc=Adp_sjiXJUGO17p8_qQmU2PKUot2GgG_H_cpieafb2FXV1sWGIWYYkG6gWfRCwFAJVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi5vujQ-JI7UpxK0XV1iV2meu2LnD-n6airbsOr6D97A&oe=6AFC6DB7"}, {"file_name": "5-panneau-jeu.png", "id": "1449435267144431", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1449435270477764_2147206622837112508_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCX0E8uc7EsQ7kNvwF3pF43&_nc_oc=Ado2xxq3vshZ6haKGQOmpG0Wi74-xZLVze3H_H7BNM6PlhPeWW9RLmzReLqQACzFV5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYPWNO-NSGIOcN1Qbg7vP48qfxL1NcakzA8HibZKW0jw&oe=6AFC6C29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RetroHub VR", "keywords": ["retro", "nostalgia", "television", "arcade", "1990s"], "long_description": "Before the web, a box sat on top of the television and turned it into something you could answer back to. You pressed arrows on a small keypad and the screen filled with blocky coloured characters: games, information pages, little services. People gathered in front of it.\n\nRetroHub VR puts that terminal back where it belongs - on a television set, in a wood-panelled basement, seen from a couch.\n\nTWO WAYS TO USE IT\nThe app opens as a flat panel, so the terminal can sit beside your other windows while you do something else. Press IMMERSION and you are standing in the basement, facing the television, with the terminal live on its screen.\n\nTHE LOOK IS THE POINT\nEverything is drawn the way that hardware drew it: the same palette, the same blocky characters, the same unhurried pace. Retro games in the style of the era, and the kind of pages the terminal served.\n\nONE PURCHASE\nNo advertising and no subscription.", "short_description": "Step into a 1990s basement and switch on the television. RetroHub VR brings back the interactive TV terminal of that era - its games, its pages, its small services - live on a screen you sit in front of, the way it was actually watched. Or keep it in a flat window beside your other apps when you just want to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://retrohub.ca/politique-confidentialite.php", "developer_terms_of_service_url": null, "publisher_name": "Reseau Inter-Systeme inc", "support_website_url": null, "website_url": "https://retrohub.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_BE", "fr_CA", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1483674261485213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831279_1075791291940166_5984741424515013316_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asLpEn3QfCIQ7kNvwFhV8-h&_nc_oc=AdqNA3eGT0fWRkRnna0yPry9RoFnFWJzj00PYcXNsWjmIiB2Wze3FOQw4pvQKn7RP0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2orYNZazVmDjWL-VhfP9ro-yQ6O0BBmKgD9qz
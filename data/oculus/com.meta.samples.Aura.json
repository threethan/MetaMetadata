00_47_11.Still008.png", "id": "712373860170576", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982453_712373863503909_231819569972928859_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR5wJ8I8aPQQ7kNvwEfx28Y&_nc_oc=AdojgulbJhua3EzQEc46GNIRq99bcGAIlA7hL7gF6b2VMdaEhOE532VqQ61m1GX-WYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NvdM4oFoK0fsg2ig0JKyWjiKY6y5YiRshKE4Gv9fCgA&oe=69D504CD"}, {"file_name": "2560x1440__0005_Sequence-02.00_00_04_08.Still002.png", "id": "653635109842069", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984471_653635113175402_7462661112844804830_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elks6ExtIb4Q7kNvwEULGT6&_nc_oc=Adq9B2t_y4gW7RDvnA5Sl7iK0uynKj5RGEZwF3T3UaRvXvrqMw5aNeljrfjkp5th3lw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PTfGUtcVBmt1-tUvoJ8xEtvGnX4Z7Ibwnq6qnoImcdQ&oe=69D4F216"}, {"file_name": "2560x1440__0002_Sequence-01.00_00_07_21.Still013.png", "id": "3538875033024738", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210898_3538875036358071_9012355897527905566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-HJ7lbChOoQ7kNvwHnWnn9&_nc_oc=AdrbCxWUc-XBBdnXUOMzafsYO-Yw2xxVV4zK_bpptpLSvU9XX-kuWRN_KzQXU0JGFB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27aEbhLq0pZWwQlZCViYa8aeYRhh7BkDh26Q4WL8GElA&oe=69D4EAEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aura_movement_sdk_CoverArtLandscape copy.png", "id": "1209281816348406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031644_1209281819681739_3548753699648609585_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gofJ0_IBvB4Q7kNvwEhf1UN&_nc_oc=Adp6v4IOmAjlBMNW1FeYm2vrrjZpwIH9PJY6aPOo9xwI3jBOol1bOvSUsxAJLasxZ3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NywPRS1yAXkACeMsV-kuWSfCLcQaZl-F_DTZrr5_wHg&oe=69D51716"}, "display_name": "Aura", "keywords": [], "long_description": "Artists or game developers who would like to get a view of what is possible using Meta Quest Pro's eye tracking and face tracking capabilities can see them implemented in this app.  A fantastical character representing an alien will mirror your facial movements including smiles, eye winks, eye brows, etc.  \n\nFace tracking is encoded using blendshapes that are based on the Facial Action Coding System (FACS).  You can see these blendshape activations in a histogram displayed to the left of the mirrored avatar.  By observing how these blendshapes activate, you can get a good feel for how the blendshapes combine to represent natural facial expressions.. \n\nOnce the movements are detected, the designer can choose to modify the strength of the activation so that it meets the creative intent for the character. For instance, if you have a character with a very large mouth, you might not want to fully activate the mouth blendshapes as it might make the character look menacing.  Using a control slider on the right side of the application,  the user of this app can change the strength of the activations to see their impact on the retargeted alien character.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities.  The code and asset models that are the basis for this application are available for download at: https://github.com/oculus-samples/", "short_description": "This app allows game developers to experience the capabilities of Meta Quest Pro's eye tracking and face tracking sensors as embodied in a fantastical alien.  A mirrored view will allow you to appear as an alien and see your facial movements automatically transformed into this new embodiment and will give artists and game developers the ability to see what is possible."}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/quest/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/quest/terms-of-service/", "publisher_name": "Meta", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "709670653591898"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1254558908813918"}]}, "baseline_offer": {"id": "1254558908813918"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1677142800, "status": "PUBLISHED", "id": "1254558908813918"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6668232319953216", "version": "0.1"}, "id": "5607144082738742", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5367350470041414", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6668232319953216"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "5607144082738742"}]}, "change_log": null, "created_date": 1703092672, "id": "6668232319953216", "version": "0.1", "version_code": 298, "release_status": "RELEASED", "status": "APPROVED", "binary_tes
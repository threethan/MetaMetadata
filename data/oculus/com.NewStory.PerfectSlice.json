le_name": "Landscape_2560x1440.png", "id": "2623046964555612", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391978_2623046967888945_3001453414897299494_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTfy_okA4L4Q7kNvwGQzsdM&_nc_oc=AdoU4iOwu2aS4IAkuKF2o5tAfl9Z3ovauyDYrjriQWHh3Y61miQdaIuEmJVpLvS7j0w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1QLSopBTh0msYG5Z5nHdVEhPCqgYVWeoWbpEfq0OL7Q&oe=6A8AC42D"}, "display_name": "Crazy Fruit Factory", "keywords": ["fruit", "factory", "Slice", "Simulation", "Sweets"], "long_description": "Get ready for some crazy fruit slicing action in VR! Step into the wacky world of the Crazy Fruit Factory and become a fruit-slicing master! Turn sad fruits into delicious desserts in this fun and addictive VR game.\n\n**What are you waiting for? Grab your virtual knife and:**\n\n- **Slice & Dice:** Experience satisfyingly realistic fruit slicing with intuitive VR controls.\n- **Go Crazy:** Unleash your inner chef in a hilarious and over-the-top fruit factory.\n- **Become a dessert master:** Fulfill endless orders and whip up delicious treats!\n\n**Download Crazy Fruit Factory now and become the ultimate fruit slicing ninja!**\n", "short_description": "Slice and dice fruits and turn them into delicious desserts! Enjoy a crazy fruit cutting game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "reco
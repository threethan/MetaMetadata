-1.oculuscdn.com/v/t64.5771-25/673716021_29606468328977207_3839712532906561242_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUOVNLC1YXQQ7kNvwH_-3SW&_nc_oc=AdrkH01rPyaBUIfqlcgbstJ76aVzSB7ZuJxzQCkHThup15SylYeRX2drEN4Abkhrqwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvispJVKvK-wna7JGhaf16k_r7MJ4j-8XNYFSsEky6RQ&oe=6B0D9E54"}, {"file_name": "2.png", "id": "1832876464688387", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1832876468021720_1161583515434551390_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g7xr0JXahUQ7kNvwHjQ5UK&_nc_oc=AdrDxPrEAOJeO654KADsGFXwMdUY6i4486DbMbtLzo2Rdv26PE6OVSc1CGMeNWRDnLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLq-_VMFhfNHqD1FzsMIr9axFo2cnbY6vKvI62VmfieQ&oe=6B0DA858"}, {"file_name": "1.png", "id": "3063555223991265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604328314_3063555227324598_4987559632358851539_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X98fqB-ZBEQ7kNvwEl8niB&_nc_oc=AdpCa4zEw3fz_a-9TuLxAYxQcohX1R_HUWISTcUJjCyvUiVorrzESfL41w51qS5XwzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQe5Haib8SBmupvcm8PrQumYcm0bXfSHQK-RPRlSiFr4g&oe=6B0DA71B"}, {"file_name": "5.png", "id": "885280041296855", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596106838_885280044630188_3205795086146616425_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuoYAQ04fngQ7kNvwENSSCx&_nc_oc=AdotDEPwJy4kl0ur7jS-RzBK4Q0OX0bES48w3vgie1pdi-g3Dx0TBgmD6QgVb4wbOF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQL0w83yk0qOdPhMhmnpvIFv4XZSQhmIAjtSIRPoOFphg&oe=6B0DBFBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Trailer-Cover_2560x1440.png", "id": "29069298189391809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_29069298202725141_6281101157488634272_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVpwIwKLDf0Q7kNvwGD6uop&_nc_oc=AdrFisV56C7mk80Ld4Cm7kI3oxNRSiEKTML0RscLwdHsHvAWy3_Qjd6SwPcbxr_dLI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8NX1ZlW6I0GZDS1x6VRNKIJLOl8OgMTuH4ogiRnV03g&oe=6B0DB4B4"}, "display_name": "Neon Breach VR", "keywords": ["FPS", "retro", "shooter", "aliens", "scifi"], "long_description": "The invasion picked the wrong planet.\n\nWake inside a frost-covered cryostasis capsule. Shoot your way out. Then take the fight through 47 sectors across five episodes: abandoned cinemas, arcades, industrial compounds, orbital facilities and alien-infested strongholds.\n\nNeon Breach VR brings the spirit of 2.5D shooters into a fully explorable VR world. Face illustrated alien enemies while aiming detailed, three-dimensional weapons with your controller.\n\nMAKE AN IMPACT\n\nCrack screens with gunfire, shatter glass and turn cars into wrecks with rockets. Use explosive and chemical barrels to turn the battlefield against the invaders.\n\nPICK YOUR FIREPOWER\n\nSwitch from pistol, shotgun and rotary gun to freezing crystals, shrinking shots and searing energy. Find upgrade machines and choose which weapon gets the improvement.\n\nEXPECT RESISTANCE\n\nFight armed aliens, charging beasts, flying threats and bosses. A fallen enemy may get back into the fight. Discover secrets and free captives along the way.\n\nYOUR INVASION, YOUR RULES\n\nChoose from four difficulty levels. Adjust seated or standing play, turning, dominant hand, HUD height, graphics and audio. Save your progress and return for another sector.\n\nSingle-player. English text and dialogue. Designed for Meta Quest 3 with tracked controllers. Contains stylized violence, blood, dismemberment, strong language and suggestive character designs.", "short_description": "A dark retro shooter built for VR. Take back 47 alien-held sectors with 3D weapons, destructive firepower and a seriously bad attitude."}]}, "developer_n
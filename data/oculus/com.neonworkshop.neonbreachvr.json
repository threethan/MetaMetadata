a0a&_nc_ohc=YuoYAQ04fngQ7kNvwENSSCx&_nc_oc=AdotDEPwJy4kl0ur7jS-RzBK4Q0OX0bES48w3vgie1pdi-g3Dx0TBgmD6QgVb4wbOF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQL0w83yk0qOdPhMhmnpvIFv4XZSQhmIAjtSIRPoOFphg&oe=6B0DBFBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "08_Trailer-Cover_2560x1440.png", "id": "29069298189391809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_29069298202725141_6281101157488634272_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVpwIwKLDf0Q7kNvwGD6uop&_nc_oc=AdrFisV56C7mk80Ld4Cm7kI3oxNRSiEKTML0RscLwdHsHvAWy3_Qjd6SwPcbxr_dLI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8NX1ZlW6I0GZDS1x6VRNKIJLOl8OgMTuH4ogiRnV03g&oe=6B0DB4B4"}, "display_name": "Neon Breach VR", "keywords": ["FPS", "retro", "shooter", "aliens", "scifi"], "long_description": "The invasion picked the wrong planet.\n\nWake inside a frost-covered cryostasis capsule. Shoot your way out. Then take the fight through 47 sectors across five episodes: abandoned cinemas, arcades, industrial compounds, orbital facilities and alien-infested strongholds.\n\nNeon Breach VR brings the spirit of 2.5D shooters into a fully explorable VR world. Face illustrated alien enemies while aiming detailed, three-dimensional weapons with your controller.\n\nMAKE AN IMPACT\n\nCrack screens with gunfire, shatter glass and turn cars into wrecks with rockets. Use explosive and chemical barrels to turn the battlefield against the invaders.\n\nPICK YOUR FIREPOWER\n\nSwitch from pistol, shotgun and rotary gun to freezing crystals, shrinking shots and searing energy. Find upgrade machines and choose which weapon gets the improvement.\n\nEXPECT RESISTANCE\n\nFight armed aliens, charging beasts, flying threats and bosses. A fallen enemy may get back into the fight. Discover secrets and free captives along the way.\n\nYOUR INVASION, YOUR RULES\n\nChoose from four difficulty levels. Adjust seated or standing play, turning, dominant hand, HUD height, graphics and audio. Save your progress and return for another sector.\n\nSingle-player. English text and dialogue. Designed for Meta Quest 3 with tracked controllers. Contains stylized violence, blood, dismemberment, strong language and suggestive character designs.", "short_description": "A dark retro shooter built for VR. Take back 47 alien-held sectors with 3D weapons, destructive firepower and a seriously bad attitude."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/neon-breach-vr/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/neon-breach-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401898529677725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1146002328021719_4146227471037142017_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x5kVRb9OzcQ7kNvwFDQiyQ&_nc_oc=AdqF7xlZBHBfuQz0Ff-RTVx9VwIt6dA3jAWzYhuPMIQmTng6aioNFnZLu3lXTqMCGvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMiZMW312YxWa3V-b-HB6RxjZgQVUw9lTqZbYln8soGw&oe=6B0DA91C"}, "is_concept": false, "is
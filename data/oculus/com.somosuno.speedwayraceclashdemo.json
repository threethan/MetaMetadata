ng?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_ndA5-da4gQ7kNvwETCceT&_nc_oc=Adpj6V89TRbJOZGgrXeuKAZHPw2bet0_D-yZyhk6vBvkV47WEcunbn51DymdkD08vOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-9LAKvQ773EBOJvNaU9kJTtx-yMXScfq7BmgN2GCnDQ&oe=6A676E3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "830206969419035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_830206972752368_6340838414052752440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joU4p7sYKa0Q7kNvwEbkIXj&_nc_oc=Adpzdd78RuaoWxIwZWSS3hcmAIS8A183j-M_WBLQ2Qv-i-QC92HSJ5K5FopDz8K0vTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR4IsdQtO8jRLPOPwYZSunFEUIqReYb9-WE1c4WwTNJg&oe=6A675BA3"}, "display_name": "Speedway Race Clash: Ultimate \u2013 Demo", "keywords": ["Racing", "Formula1", "Cars", "Drive", "Simulator"], "long_description": " **Step into the race in VR \u2014 Demo Version**\n\n*Speedway Race Clash* is a fast-paced arcade racing experience built for Meta Quest. Jump into the driver\u2019s seat and compete in quick, intense races designed for VR.\n\n**Play the Demo**\n\u2022 2 playable tracks\n\u2022 1 Adrenaline car\n\u2022 7 AI opponents per race\n\u2022 Short races (20\u201330 seconds)\n\nExperience the core gameplay, handling, and speed of the game.\n\n **Preview the Full Experience**\nThe demo lets you see additional content available in the full version:\n\u2022 More tracks (up to 9 total)\n\u2022 GT and F1 car classes\n\u2022 Additional vehicles to unlock\n\nExplore what\u2019s waiting as you progress.\n\n **Built for VR Gameplay**\n\u2022 Fast, accessible racing\n\u2022 Smooth controls and responsive handling\n\u2022 Designed for quick sessions\n\n **Continue the Race**\nFinish the demo and jump into the full version to unlock all tracks, cars, and progression.\n\n **Start racing now and push for the lead.**\n", "short_description": "Try the  FREE VR racing demo!!\n\nPlay 2 tracks and feel the speed, experience fast-paced races, and get a taste of Classic, GT, and F1 progression. Unlock the full game for all tracks and cars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://somosuno.jp/srcprivacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Somosuno Games", "support_website_url": null, "website_url": "https://somosuno.jp/somosunogames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27437055679234419"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1865607287684696_3141735286846157631_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNW7GTg1yDgQ7kNvwEEDcAS&_nc_oc=AdrJ28U0v2rQ3bOYU04evjZRlzEyzw7UOXpszYyL-n_PJhJ9oQrMSSt-dGqxuI3PRWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp89h_wM-QBpr8L2v9tGEMx4SKxUeE6klF8VV7XGtvKw&oe=6A676A6E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Speedway Race Clash: Ultimate \u2013 Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], 
ad3-1.oculuscdn.com/v/t64.5771-25/499618288_1336942607925137_6136079541553753779_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1YIuKI_qxkQ7kNvwE6wkDS&_nc_oc=AdrqnE1qXR6RijfI5NlvBkzuGAcmiMqz2haMDF6HZiLNw-1HqCSZozcuO1DljX1uofI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K6Ef4x9PgxExo5aOVAiOAgo2L2wWgkPuQ-lkptWjbyw&oe=69ECC5CD"}, {"file_name": "Scr_05.png", "id": "793728060155515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617749_793728063488848_6203950435168369218_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdIA0JFyh2wQ7kNvwHX6FeV&_nc_oc=AdrpBVNfLE9FwjeETMAygTBPXtJ6JMVVeKN2xQNwNzSj4J6vZTpvbpbH3dQMlkQRdFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PDnd1XZ75nsrX0d6KmXI454cddAtZmQCsNLXUCfvVUg&oe=69ECB571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "830206969419035", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_830206972752368_6340838414052752440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnOzkOdK7A0Q7kNvwEx8B-w&_nc_oc=AdoVKtzHGAuhFQrRfVMsStCPEgIvv4QWPP-gn4U1qIuhsPz0n6ndSSAlJMfmxdBKxuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35NJyqK648aq0KqHcLdlptowoWvNGdFaeKEu_bCMuuQA&oe=69ECC023"}, "display_name": "Speedway Race Clash: Ultimate \u2013 Demo", "keywords": ["Racing", "Formula1", "Cars", "Drive", "Simulator"], "long_description": "Speedway Race Clash delivers fast, precise, and immersive VR racing built for the Meta Quest platform. This demo lets you test the core handling, cockpit view, and high\u2011speed racing across a selection of tracks.\n\nUpgrade Call\u2011to\u2011Action\nEnjoying the demo?\nGet the full version for more cars, more tracks, and expanded gameplay!!!\n\nThe full version expands the experience with more cars, more tracks, improved AI, and ongoing updates.\nUpgrade to the full game on the Meta Quest Store \u2192 https://www.meta.com/experiences/speedway-race-clash-ultimate-showdown/31709214785360154\n\nKey Features\n- Fast and immersive VR racing\n- Smooth cockpit\u2011view driving\n- Responsive controls\n- Challenging track layout\n- Optimized for Meta Quest\n- Developed by Somosuno Games\n\nVersion Notes (What\u2019s Included in the Demo)\n- Core racing experience\n- Cockpit driving\n- 3 Tracks selection\n- Base vehicle handling\n- Preview of the full game\u2019s gameplay style\n", "short_description": "Fast, immersive VR racing for Meta Quest. Experience the core gameplay of Speedway Race Clash in this demo."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/somosunogames/inicio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Somosuno Games", "support_website_url": null, "website_url": "https://sites.google.com/view/somosunogames/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26619681854305143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1865607287684696_3141735286846157631_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PodsJrJ5_EQ7kNvwF8dKc5&_nc_oc=Adqu_Lv5YwLlcAOu5S5x0XEWgDGxqtDHg3DWw8bEeiuveY35aKETFh0xt7ozZNREonM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Cmo-eEwzF80pNqJXyF5
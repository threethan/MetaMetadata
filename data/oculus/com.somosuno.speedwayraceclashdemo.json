lgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjwBAB6a6oIQ7kNvwGTd1Pv&_nc_oc=Adqu9xvDvmxZIX2Cf0uIWBaX7Y_HG9g0AwaDUocFtMJ8VLFrgfOZvvAUeLAxNNb1mAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7BdaB1qGkYmoecn-QSjHo6OW57SIaliLw5ArpIiK5Dw&oe=6AFDD431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "830206969419035", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_830206972752368_6340838414052752440_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuW8s9g__osQ7kNvwH0DM2Z&_nc_oc=Adq-Yjk7b7DEST5HqX_n8oOaocGLklkg5PSI8nBGPJxUIuY804-jrFUPBD46Cc_rZ1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAHtplWT7IMLMD9rE2_RDkoptAZsoR9mUdcsiIHKH3jg&oe=6AFDDEE3"}, "display_name": "Speedway Race Clash: Ultimate \u2013 Demo", "keywords": ["Racing", "Formula1", "Cars", "Drive", "Simulator"], "long_description": "The engine growls....The lights count down.... You\u2019re alone in the cockpit\u2014seconds from glory!!\n\nSpeedway Race Clash: Ultimate \u2013 Demo drops you into the heart of elite F1 racing. Precision machines, iconic tracks, and the roar of competition surround you in this immersive VR experience.\n\nGrip the wheel. Feel the tension. Every lap is a battle for control, speed, and legacy.\n\nThis demo gives you exclusive access to the F1 class, with three high-speed circuits designed to test your reflexes and ignite your passion for racing.\nBut this is just the beginning. The full version unlocks:\n- Muscle Cars \u2013 brute force and drifting chaos\n- Nostalgic Classics , vintage legends and golden-age circuits\n- Expanded tracks, unlockable vehicles, and progression rewards\nYour journey starts here...\n\nRace the demo. Feel the thrill. Then unlock the full garage and write your name in racing history!!!", "short_description": "Feel  the adrenaline F1 racing in this high-speed VR demo.\nPrecision, power, pure speed and cockpit immersion unlock the full garage to master Muscle, Classics, and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/somosunogames/inicio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Somosuno Games", "support_website_url": null, "website_url": "https://sites.google.com/view/somosunogames/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26408172065456124"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1317478326493340"}]}, "baseline_offer": {"id": "1317478326493340"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771261560, "status": "PUBLISHED", "id": "1317478326493340"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27257873797152609", "version": " 0.1.0.04"}, "id": "24436513369378692", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25332288369711171", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27257873797152609"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": 
jRGcJNcQ7kNvwGjmT0-&_nc_oc=Adr9PQSt_I2jZPYc95p71AQcdZQsuOQbPDlpY413ag-0YZJEerQYRAvXnL4m650olnI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k5ofWmsQEqHTSRjrHGHwK-8VdNZHgyMrjf5Pgc1GHgg&oe=6A0C63DD"}, {"file_name": "Scr_01.png", "id": "737959869374900", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618432_737959872708233_4066193812315764032_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I0dVmSDtxoQ7kNvwF84QgU&_nc_oc=AdploUZXvGvHKIIu-fOBiw-eTgaF48yP31n12wwkC7Gc-c1-hGM01I3oqq0Jbda18oc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N3zTBkbXQEO0v3acVY-VlPqWTEu3xE6HibM1suELz-w&oe=6A0C528F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "830206969419035", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_830206972752368_6340838414052752440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvtNBRU5ENgQ7kNvwGZ38DO&_nc_oc=Adr7QAIoEdGRjDxGqEoaFn5hCmd7PF-WXOuy7KowfKI8OEqQ3m7ZLR5rlPLi7Up81k8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vJl3jJ0RO_m3HDQNXG3IqbTljU30qwzvaWaulWHAdqg&oe=6A0C6423"}, "display_name": "Speedway Race Clash: Ultimate \u2013 Demo", "keywords": ["Racing", "Formula1", "Cars", "Drive", "Simulator"], "long_description": " **Step into the race in VR \u2014 Demo Version**\n\n*Speedway Race Clash* is a fast-paced arcade racing experience built for Meta Quest. Jump into the driver\u2019s seat and compete in quick, intense races designed for VR.\n\n**Play the Demo**\n\u2022 2 playable tracks\n\u2022 1 Adrenaline car\n\u2022 7 AI opponents per race\n\u2022 Short races (20\u201330 seconds)\n\nExperience the core gameplay, handling, and speed of the game.\n\n **Preview the Full Experience**\nThe demo lets you see additional content available in the full version:\n\u2022 More tracks (up to 9 total)\n\u2022 GT and F1 car classes\n\u2022 Additional vehicles to unlock\n\nExplore what\u2019s waiting as you progress.\n\n **Built for VR Gameplay**\n\u2022 Fast, accessible racing\n\u2022 Smooth controls and responsive handling\n\u2022 Designed for quick sessions\n\n **Continue the Race**\nFinish the demo and jump into the full version to unlock all tracks, cars, and progression.\n\n **Start racing now and push for the lead.**\n", "short_description": "Try the  FREE VR racing demo!!\n\nPlay 2 tracks and feel the speed, experience fast-paced races, and get a taste of Classic, GT, and F1 progression. Unlock the full game for all tracks and cars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/somosunogames/inicio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Somosuno Games", "support_website_url": null, "website_url": "https://sites.google.com/view/somosunogames/inicio", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27257945430478779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617850_1865607287684696_3141735286846157631_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnR5xjdmk_EQ7kNvwHon6_U&_nc_oc=AdovPOXnAjTp9YYWXRo2GxY8eOqdCPoNvCWD3Ej2kz8aw-A5TIcsnD468OfGUG8dnAI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ltiba6oR3ta1cbFrOkp0joRQndnMK0oHOPbc0fchYzA&o
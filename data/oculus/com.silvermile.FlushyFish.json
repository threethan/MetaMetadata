cv-9vLwvln0m1Nk2R2JNbYadt2AJ81ThLGb4A4II&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZEr9bdkw8veRGXneNG5Br9T0al6L_n2T_m7fDdXdV2g&oe=6AA95B52"}, {"file_name": "migrated_image.png", "id": "746033089261601", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12602331_650747621754948_675402682_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jIJqR-B2PkQ7kNvwEluUh9&_nc_oc=Adq3THKUbq8RfLzqpBePCDMRHrv_IosagI7egRlwg2A838DAzfmgQtcxXXlqqbONkfM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK3XIznsxXIbJGKhWcmDMlHQiCJTi-T3Iwg8txRJxeYg&oe=6AA95B48"}, {"file_name": "migrated_image.png", "id": "350378635860408", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12504630_1158967070809093_1141083258_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg-OVqPy-NwQ7kNvwHb2t1J&_nc_oc=AdrIMEHrhXWJE1ARUNBl9M5Q4v0-Qgg9lGBPPl0Q4lJ1gmwzi3s1kGHuA_DQ16flceU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE82kyo5ILPw21Wk3Tn8GWSdbQnTXkC4Zl_TNhTTmg2Q&oe=6AA958E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUSHY FISH VR", "keywords": ["Casual", "game", "Cartoon", "Fun", "Adventure"], "long_description": "FLUSHY FISH VR is a action-adventure VR puzzle game from Silvermile Entertainment. (www.silvermile.net)\n\n4.5 / 5    Oculus Store\n4.5 / 5    VR Bank\n5 / 5       WEARVR\n9 / 10     AVR 17\n\nFly with Flushy through 30 amazing VR game worlds on a journey through the colourful worlds collecting stars and challenge the legendary Red Dragon.\n\nExclusively designed for VR, Flushy Fish takes puzzle gaming to a whole new level. Use the different colored jelly cannons to travel across beautiful landscapes, solve unique puzzles, and take flushy to freedom!\n\nFLUSHY FISH VR makes virtual reality accessible to everybody with addictive and unique gameplay, beautiful graphics and comical characters, the best entry level entertainment for VR, optimised for comfort.\n\nThe main thing is to have fun but beware, not all worlds are threat-free... \n\nCompete with other players to reach the highest scores!", "short_description": "FLUSHY FISH VR is a action-adventure VR puzzle game from Silvermile Entertainment.\n\n4.5 / 5    Oculus Store\n4.5 / 5    VR Bank\n5 / 5       WEARVR\n9 / 10     AVR 17\n\nFly with Flushy through 30 amazing VR game worlds on a journey through the colourful worlds collecting stars and challenge the legendary Red Dragon.\n\nUse the different colored jelly cannons to shoot Flushy through beautiful puzzles and reach the Water Well and freedom!\n\nwww.Silvermile.net\nwww.facebook.com/FlushyFishVR"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.silvermile.net/", "developer_terms_of_service_url": "http://www.silvermile.net/", "publisher_name": "Silvermile", "support_website_url": null, "website_url": "http://www.silvermile.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "CASUAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "404366501486300"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410201_552857298172726_813068248_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isMBF0Ob1LUQ7kNvwGgdYhT&_nc_oc=AdqomP4_o1jGk1p48nyGun7Tn8lGwWNwp58MO2Gx3tOwhFUeCb-yEHf2OQs6a8shN1I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmDjKH44m-L5hCPgOofDjB5JcD3_Kc8cE0q1JdW0XxdA&oe=6AA95BF2"}, "is_concept": false, "is_test": false, "is_trial_offer_val
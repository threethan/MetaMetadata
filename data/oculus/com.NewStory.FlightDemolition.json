uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391960_481817154641638_311128695820365121_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ASfxYnwJNYQ7kNvwEV7_IQ&_nc_oc=Adrjsd1Xbu0NA6e33en7T-VSondTMObLmcrgckOa9RUi43IbGtHebspwfK9HijlAGzA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af34X7lDexoI68Tflfpo8P0FVJb6mAftr2S0WvY1dLk3vg&oe=69F20F3F"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\u2464.png", "id": "436234326120579", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391960_436234329453912_4420274682509282107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjzwam6cS64Q7kNvwG6AF3T&_nc_oc=AdpksNSWwqygZU38mI-TXx_tlmSomEG8n0gKEOwtG0Zd9xIOOH7tVOVi6qBl3QZ5Sek&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kIzX-dgSQLnpwnJrDcE92IgwQmYonQRU4r67WZwxLWw&oe=69F1FCC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "2034309333736308", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391923_2034309337069641_2048634559904590340_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqrF1F6WAgQQ7kNvwFQWH9Y&_nc_oc=AdrpXPb93D3RT3HHIvor6c6ekx4Q8nfyXwtIWZaLh312mEWM3JSi1nTgjoacHLk3Bls&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2PZbB_jz1NPBwuhxUsUMJjz-1i3bSYnI9BsxDzYf3F_Q&oe=69F1F155"}, "display_name": "Flight Demolition", "keywords": ["Flight", "Demolition", "simulator", "action", "Demolish"], "long_description": "Flight Demolition is a super exhilarating destruction action game set in the VR space. Players control a helicopter and use powerful weapons such as dynamite, cannons, and missiles to destroy famous landmarks around the world. Destroy buildings to collect coins, unlock new weapons, and unleash even more destruction.\n\nWhat you can do:\n- Experience a thrilling immersion: Feel the adrenaline as you wreak havoc from a helicopter with the unique presence that only VR can provide.\n- Enjoy simple and intuitive controls: Easy-to-learn controls allow anyone to enjoy high-octane destruction.\n- Destroy famous landmarks around the world: Experience the exhilarating satisfaction of destroying iconic structures.\n- Destroy buildings using a variety of weapons: Destroy targets using a variety of weapons such as dynamite, cannons, and missiles.\n- Orbit around famous buildings in your helicopter. You are free to choose how you want to destroy each building.", "short_description": "Are you ready for an incredible destruction experience? \nEnjoy the thrill of seeing the city collapse just by pulling the trigger! This is the ultimate destructive experience. Now, you too can enter the world of destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8976138372434045"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393411_592062623537282_7972782403316510278_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ns_bvBVXz8Q7kNvwFmlu_Z&_nc_oc=Adq9-ZpwCRdm0MgZ_pRK0hw57wIRcMNMef6KB8woHp06-WLMixxT4qnt-xIDCX3GZRI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculusc
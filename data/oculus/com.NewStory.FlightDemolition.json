id": "481817151308305", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391960_481817154641638_311128695820365121_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ9IwAKhZ7EQ7kNvwF_oxPz&_nc_oc=AdqACk2dv12ugZkbiA6oEZCknHQihhIl0YJxykz3r5XFbplu3ZwAbfAGlXTNDNGXkfY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRmSH7-BLVurjFUzS2pUcp9Aw8U_4t9MomIPmQ9L56jw&oe=69C147BF"}, {"file_name": "\u30b9\u30af\u30b7\u30e7\u2464.png", "id": "436234326120579", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391960_436234329453912_4420274682509282107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0BUhBDjLpgQ7kNvwEofsxm&_nc_oc=AdrYzCwQAXPt-xUZDmIhHwPGYsoOZdAyC3HaAXzyf0I9r-z7p_CxaKoqnpD7LFxlHgA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9znAbwpjmwr1olwLjyqqnVB6D_HBlMazGQYwq-KuO6g&oe=69C13547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "2034309333736308", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391923_2034309337069641_2048634559904590340_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9whwL4Oc80Q7kNvwGwbq77&_nc_oc=AdoiZZg7qNdET6xZ9EfM3p3OoLqSQTHuu7YXsfQrJQlr_XodQTJpmpa5paTjEiyx4Rs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfylO_HkDuN0-1se5EvB8E-xHp56kMZLSZIZqG3cGnJYxg&oe=69C129D5"}, "display_name": "Flight Demolition", "keywords": ["Flight", "Demolition", "simulator", "action", "Demolish"], "long_description": "Flight Demolition is a super exhilarating destruction action game set in the VR space. Players control a helicopter and use powerful weapons such as dynamite, cannons, and missiles to destroy famous landmarks around the world. Destroy buildings to collect coins, unlock new weapons, and unleash even more destruction.\n\nWhat you can do:\n- Experience a thrilling immersion: Feel the adrenaline as you wreak havoc from a helicopter with the unique presence that only VR can provide.\n- Enjoy simple and intuitive controls: Easy-to-learn controls allow anyone to enjoy high-octane destruction.\n- Destroy famous landmarks around the world: Experience the exhilarating satisfaction of destroying iconic structures.\n- Destroy buildings using a variety of weapons: Destroy targets using a variety of weapons such as dynamite, cannons, and missiles.\n- Orbit around famous buildings in your helicopter. You are free to choose how you want to destroy each building.", "short_description": "Are you ready for an incredible destruction experience? \nEnjoy the thrill of seeing the city collapse just by pulling the trigger! This is the ultimate destructive experience. Now, you too can enter the world of destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8976138372434045"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393411_592062623537282_7972782403316510278_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r2wpe90tpYQ7kNvwFdqiY6&_nc_oc=AdoL_iyAnzNgY9fTQ-8fzJxMRrU_EmWQWeqzxJsnKLmPw7MgK_7GeIPu5mYL2GqXCTQ&
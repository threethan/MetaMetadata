682509282107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUCiKkW56WEQ7kNvwESxgOz&_nc_oc=AdpzfWkvUuExrvwPPblE7MNdG3w6a-JSQXu99uP0VzczrHA-kg9TjHQSuNQ4vUqa4wg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAHFqG4Dn21VX8IdIvOxUZ-WJ0AneFa7qt753huagwyg&oe=6AAD31C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "2034309333736308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391923_2034309337069641_2048634559904590340_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8ghel-twwwQ7kNvwG1eHtD&_nc_oc=Adq0chL6dYqIfPzkQWXh_EBzC9QJJKezlXwb8kcft-d8T3wXejiYlpJeRTSxzAlCwSA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhvSRzLz_Wf2G-_vI-zvFZ9zfrL8Z4yXaciTU6IBKWhw&oe=6AAD5E95"}, "display_name": "Flight Demolition", "keywords": ["Flight", "Demolition", "simulator", "action", "Demolish"], "long_description": "Flight Demolition is a super exhilarating destruction action game set in the VR space. Players control a helicopter and use powerful weapons such as dynamite, cannons, and missiles to destroy famous landmarks around the world. Destroy buildings to collect coins, unlock new weapons, and unleash even more destruction.\n\nWhat you can do:\n- Experience a thrilling immersion: Feel the adrenaline as you wreak havoc from a helicopter with the unique presence that only VR can provide.\n- Enjoy simple and intuitive controls: Easy-to-learn controls allow anyone to enjoy high-octane destruction.\n- Destroy famous landmarks around the world: Experience the exhilarating satisfaction of destroying iconic structures.\n- Destroy buildings using a variety of weapons: Destroy targets using a variety of weapons such as dynamite, cannons, and missiles.\n- Orbit around famous buildings in your helicopter. You are free to choose how you want to destroy each building.", "short_description": "Are you ready for an incredible destruction experience? \nEnjoy the thrill of seeing the city collapse just by pulling the trigger! This is the ultimate destructive experience. Now, you too can enter the world of destruction!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8976138372434045"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393411_592062623537282_7972782403316510278_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLMT6S4cjzcQ7kNvwFjGO0e&_nc_oc=AdrRuTbkspUfVnKZOdVGqjPrs2K1EZNZmcJxGv8OlfB6GEqc3A96x4JVepI2J9yI2SM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWvhyw90siz4AUJp8b1Nh5JuyBtr5RO0ISN-rPJ17D-A&oe=6AAD3EF9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flight Demolition", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1737167340, "lastRevision": {"nodes": [{"id": "8976138395767376", "release_type":
rformance and stability.\n\nOg Gtag is designed to provide a smooth and enjoyable VR experience, with ongoing improvements to gameplay, optimization, and overall quality.", "short_description": "Og Gtag is a fast-paced multiplayer VR experience featuring immersive movement, interactive environments, and social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rY-11awb_6RfQIf9ylFskshk9lPI7JR9JhYTtSFCcDk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "desk", "support_website_url": null, "website_url": "https://og-gtag-privacy.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "34606118789032054"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303679_25521899137485859_4085827499333699427_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrOJat4uQ2cQ7kNvwEY145k&_nc_oc=Adql_zG_YkaaESgCt2ENLWTidMzqmBGR82-3wxlAbWX4V2iQ9rwteS4INPr49qcKpZg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eNFrIdGNref9_mhPtUZsusyCGovpThAZG-HNGsrWauA&oe=69F49395"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Og Gtag", "platform": "ANDROID_6DOF", "co
, "keywords": ["og", "gtag", "free", "tag", "ogtag"], "long_description": "Og Gtag is a multiplayer virtual reality experience built around fluid, physics-based movement and immersive player interaction. Players navigate environments using intuitive locomotion, allowing for dynamic exploration and engaging gameplay moments.\n\nThe game focuses on social interaction, environmental awareness, and responsive controls, creating a unique and accessible experience for a wide range of players. Carefully designed maps and systems encourage replay ability while maintaining performance and stability.\n\nOg Gtag is designed to provide a smooth and enjoyable VR experience, with ongoing improvements to gameplay, optimization, and overall quality.", "short_description": "Og Gtag is a fast-paced multiplayer VR experience featuring immersive movement, interactive environments, and social gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rY-11awb_6RfQIf9ylFskshk9lPI7JR9JhYTtSFCcDk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "desk", "support_website_url": null, "website_url": "https://og-gtag-privacy.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "34606118789032054"}}]}, "sche
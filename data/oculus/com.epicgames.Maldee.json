22672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqFJXwt0mtAQ7kNvwGWOafN&_nc_oc=AdrXLvDraqgFGynDGyLMzm4JeHAUtKGLGFfVQAxN5ka5POR0H0w9FzSGI8bTjYm5VNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu3ZCOkAtodPQ2YwLQsM8BB7Lh-brAHRwnNj087LO06g&oe=6A5E0FB5"}, "display_name": "Island Resort Master DEMO", "keywords": [], "long_description": "Build your own colorful island resort kingdom with Island Resort Master! Unlock a variety of buildings, recruit service staff of all abilities, welcome a variety of visitors, earn money, and improve the star rating and attractiveness of your resort!\n\nFrom passenger and cargo terminals, to helipads, welcome entrances, pools, badminton courts, beach volleyball courts, water clubs, to various condominiums, beach villas, water villas and more. Recruit attendants with a range of characteristics to help you handle all kinds of events, on their own is obviously not enough. Of course, while welcoming visitors, don't forget to deal with incoming sharks and giant seagulls with coastal cannons, etc. Your visitors don't want to be harassed by them!", "short_description": "Build your own colorful island resort kingdom with Island Resort Master! Unlock a variety of buildings, recruit service staff of all abilities, welcome a variety of visitors, earn money, and improve the star rating and attractiveness of your resort!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.monduz.com/irmPrivacy.html", "developer_terms_of_service_url": null, "publisher_name": "Monduz Games", "support_website_url": null, "website_url": "https://www.facebook.com/Island-Resort-Master-111611168270190", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFy1YArpiREQ7kNvwHor_OI&_nc_oc=AdrGpLje3rmKwW3t0DEqbOcAAP9wPHduz46iKiD7cK04tixyfGnMmrb-7XHHNL5xUDI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2kS3elcXNcoCOmwrR5zdVTvfj97wMDmk10DFYI1yCeOQ&oe=69EF8171"}, {"file_name": "CloseRight_6.png", "id": "1586221956031029", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820923_1586221959364362_4116262841910761849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdkaVgYc1_wQ7kNvwGjFENv&_nc_oc=Adq17QWien71TRX3lliJTlSVnoAqoeo6f3DIlEDr6rC0j4gvyN627As4MVHznZMjuc4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0L0AxMBiGuX8O8lNVdW3mCdppbXXf44KKDNitmTF6poA&oe=69EF7B9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Naughty Kid - Snowball Edition", "keywords": ["snowball", "winter", "christmas", "snow"], "long_description": "Become the ultimate winter troublemaker in this fun, fast-paced VR snowball experience! You play as the pampered child of wealthy parents\u2014bored, unsupervised, and ready to stir up a bit of mischief. Armed with an endless supply of perfectly packed snowballs, your mission is simple: aim, throw, and see how many unsuspecting pedestrians you can hit before time runs out.\n\nExplore a cozy winter neighborhood filled with animated characters, humorous reactions, and satisfying snowball physics. Perfect for quick sessions, parties, or stress-relief, this game captures the joy of childhood antics without any real-world consequences.\n\nEasy to pick up, silly by design, and endlessly replayable\u2014your snowy reign of mischief awaits!", "short_description": "Step into the spoiled boots of a rich family\u2019s mischievous kid and unleash snowy chaos! In this lighthearted VR snowball game, pelt unsuspecting pedestrians, rack up points, and enjoy the thrill of harmless winter troublemaking."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/naugh
ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxw7CAkiYQwQ7kNvwEvOZb5&_nc_oc=AdphP8htfzvkJbzWWg88oysh-Bn5_-z_AzSpDNagon4oxWkNvsGS-fZEWV9bMWhmS7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADBkLTMaTFqWmZ2Wo5QnWYAmDxbCTrW5YBiZHmCteeZA&oe=6A5504F1"}, {"file_name": "CloseRight_6.png", "id": "1586221956031029", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820923_1586221959364362_4116262841910761849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_iqIg_0tFgQ7kNvwFEQ8Cm&_nc_oc=AdpnsvGSMffvgJDzWdTcKA6xxuGGwnz6UR7jEp0Ew5MDn9W_D4p9Q2E0r0VZ5JoMr8g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHLYBW9CWMjixsmBNV7m8fvLeY-uzXC28zneEpvUqrTA&oe=6A54FF1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Naughty Kid - Snowball Edition", "keywords": ["snowball", "winter", "christmas", "snow"], "long_description": "Become the ultimate winter troublemaker in this fun, fast-paced VR snowball experience! You play as the pampered child of wealthy parents\u2014bored, unsupervised, and ready to stir up a bit of mischief. Armed with an endless supply of perfectly packed snowballs, your mission is simple: aim, throw, and see how many unsuspecting pedestrians you can hit before time runs out.\n\nExplore a cozy winter neighborhood filled with animated characters, humorous reactions, and satisfying snowball physics. Perfect for quick sessions, parties, or stress-relief, this game captures the joy of childhood antics without any real-world consequences.\n\nEasy to pick up, silly by design, and endlessly replayable\u2014your snowy reign of mischief awaits!", "short_description": "Step into the spoiled boots of a rich family\u2019s mischievous kid and unleash snowy chaos! In this lighthearted VR snowball game, pelt unsuspecting pedestrians, rack up points, and enjoy the thrill of harmless winter troublemaking."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/naugh
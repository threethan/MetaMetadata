QQ7kNvwFm93nr&_nc_oc=AdqOy-Z1Q2kmtQabOA8CNNNtnIfjcaTi14L9Jw5usgQOZ8Q-2-Ta0CcCCcfq2VtXf40&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHOfdiBAyswBW4_yLF3Tw_zseheDlTGTwFlipS0M_JUg&oe=6AFB28AA"}, {"file_name": "CloseRight_7.png", "id": "2256288811525402", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820887_2256288814858735_7320429344109646544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeJ5b352r2QQ7kNvwEZyMbq&_nc_oc=AdoHQPoGseujewzxusFsTJ75l78pyTFSvs9U8mp1xhSh87CMDv_kGB4PbuWO7a7nn8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw97RdtyIjXciS-5DBFb7aZ_wsBvNV6Eqcm6VggCM8SQ&oe=6AFB21F1"}, {"file_name": "CloseRight_6.png", "id": "1586221956031029", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820923_1586221959364362_4116262841910761849_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhiXmmF1CNkQ7kNvwHvxQkT&_nc_oc=AdpTvxWQhdp6uKghY-HQBTHS77KtonZEyqUzs1BmcMdIiRGfNAU6gg3m2J41YuZRxQY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ44JXv9WaffWPjf1HNFqdJBWKsKOBcmAb5bTMYYkc8iA&oe=6AFB1C1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Naughty Kid - Snowball Edition", "keywords": ["snowball", "winter", "christmas", "snow"], "long_description": "Become the ultimate winter troublemaker in this fun, fast-paced VR snowball experience! You play as the pampered child of wealthy parents\u2014bored, unsupervised, and ready to stir up a bit of mischief. Armed with an endless supply of perfectly packed snowballs, your mission is simple: aim, throw, and see how many unsuspecting pedestrians you can hit before time runs out.\n\nExplore a cozy winter neighborhood filled with animated characters, humorous reactions, and satisfying snowball physics. Perfect for quick sessions, parties, or stress-relief, this game captures the joy of childhood antics without any real-world consequences.\n\nEasy to pick up, silly by design, and endlessly replayable\u2014your snowy reign of mischief awaits!", "short_description": "Step into the spoiled boots of a rich family\u2019s mischievous kid and unleash snowy chaos! In this lighthearted VR snowball game, pelt unsuspecting pedestrians, rack up points, and enjoy the thrill of harmless winter troublemaking."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/naughty-kid-snowball-pp", "developer_terms_of_service_url": null, "publisher_name": "Pixel Works", "support_website_url": null, "website_url": "https://www.pxlworks.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25077180041905098"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25118413204448448", "version": "1.0_7"}, "id": "1403210511308834", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25032733503016419", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25118413204
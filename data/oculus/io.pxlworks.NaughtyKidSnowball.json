ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae_vgIXDnHIQ7kNvwFyFdeQ&_nc_oc=AdoRtgyaSnu0hrDeW8N66nayKo2l5g9PrUcsfRs4zoabaCDW1JZT7_OzxmwjNlYJz7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyz7nxHLww0SpCAR6X2LEW4HJaxea7kAAbvOoD6Q8Hw7Q&oe=69C66AB1"}, {"file_name": "CloseRight_6.png", "id": "1586221956031029", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820923_1586221959364362_4116262841910761849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96x41OZ4X8UQ7kNvwGmYRhp&_nc_oc=Adqh51weBkMRkMckckYQb0KVUm4b2JihSAWRYMzSyWKZvUdp3l7g1WjElM6dPNpk0uA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6m7RZYuRaFTWSJ720UU-aGnl_tQOHDPbjzHzrQV9OYA&oe=69C664DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Naughty Kid - Snowball Edition", "keywords": ["snowball", "winter", "christmas", "snow"], "long_description": "Become the ultimate winter troublemaker in this fun, fast-paced VR snowball experience! You play as the pampered child of wealthy parents\u2014bored, unsupervised, and ready to stir up a bit of mischief. Armed with an endless supply of perfectly packed snowballs, your mission is simple: aim, throw, and see how many unsuspecting pedestrians you can hit before time runs out.\n\nExplore a cozy winter neighborhood filled with animated characters, humorous reactions, and satisfying snowball physics. Perfect for quick sessions, parties, or stress-relief, this game captures the joy of childhood antics without any real-world consequences.\n\nEasy to pick up, silly by design, and endlessly replayable\u2014your snowy reign of mischief awaits!", "short_description": "Step into the spoiled boots of a rich family\u2019s mischievous kid and unleash snowy chaos! In this lighthearted VR snowball game, pelt unsuspecting pedestrians, rack up points, and enjoy the thrill of harmless winter troublemaking."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/naugh
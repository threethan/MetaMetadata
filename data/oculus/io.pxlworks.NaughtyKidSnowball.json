c_ohc=nLztlLNFfb4Q7kNvwGrxpXC&_nc_oc=AdnYB-mt4Skz0clkbEN4UlU-erPA5nNpKYVGTUdt5L0TYqGbYSS4UsXsp-XmNZsjPsk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afznx3-zDShk5ZAcpKDiGTDGE252y53XaKcEB8P4bcuGLg&oe=69BA8D31"}, {"file_name": "CloseRight_6.png", "id": "1586221956031029", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820923_1586221959364362_4116262841910761849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIQA6V2PTSAQ7kNvwGdyGKu&_nc_oc=Adk--ykf4d5nptYgI983H73dDq0Mvb7qIWcigP14UeINd-Xl4zZ7D3Igk8-Bi9pHaHU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX5g_yAyRCHxryDcwZF_9AI8hfhckzdSmD92bK2HMlJg&oe=69BA875E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Naughty Kid - Snowball Edition", "keywords": ["snowball", "winter", "christmas", "snow"], "long_description": "Become the ultimate winter troublemaker in this fun, fast-paced VR snowball experience! You play as the pampered child of wealthy parents\u2014bored, unsupervised, and ready to stir up a bit of mischief. Armed with an endless supply of perfectly packed snowballs, your mission is simple: aim, throw, and see how many unsuspecting pedestrians you can hit before time runs out.\n\nExplore a cozy winter neighborhood filled with animated characters, humorous reactions, and satisfying snowball physics. Perfect for quick sessions, parties, or stress-relief, this game captures the joy of childhood antics without any real-world consequences.\n\nEasy to pick up, silly by design, and endlessly replayable\u2014your snowy reign of mischief awaits!", "short_description": "Step into the spoiled boots of a rich family\u2019s mischievous kid and unleash snowy chaos! In this lighthearted VR snowball game, pelt unsuspecting pedestrians, rack up points, and enjoy the thrill of harmless winter troublemaking."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/naughty-kid-snowball-pp", "developer_terms_of_service
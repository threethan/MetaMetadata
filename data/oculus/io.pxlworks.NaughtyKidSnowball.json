ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnOM7OPL8asQ7kNvwF-Y0jj&_nc_oc=AdpgSo3u_Dxo4BDsJhj9yS8VN8EB6InYl4s45sQrn4XFN5Xjt519ou7hq0p5VPKbPZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LOC3o7xG2JN3C-_BX0x-1e9fyctbdEuYG6DVNsaH6ZA&oe=6A47D5F1"}, {"file_name": "CloseRight_6.png", "id": "1586221956031029", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1586221959364362_4116262841910761849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vb3kpOJwjUQ7kNvwEbjT_8&_nc_oc=AdordM7mrUNCqmWjEGrjq805MXoCAR6mfZogK6gyUyJiN25TQzcEMO6523xSRM9orXg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d7jWghrdaoGQI9vSnBmQOgzzJItntKoMgKX0SxAy4zA&oe=6A47D01E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Naughty Kid - Snowball Edition", "keywords": ["snowball", "winter", "christmas", "snow"], "long_description": "Become the ultimate winter troublemaker in this fun, fast-paced VR snowball experience! You play as the pampered child of wealthy parents\u2014bored, unsupervised, and ready to stir up a bit of mischief. Armed with an endless supply of perfectly packed snowballs, your mission is simple: aim, throw, and see how many unsuspecting pedestrians you can hit before time runs out.\n\nExplore a cozy winter neighborhood filled with animated characters, humorous reactions, and satisfying snowball physics. Perfect for quick sessions, parties, or stress-relief, this game captures the joy of childhood antics without any real-world consequences.\n\nEasy to pick up, silly by design, and endlessly replayable\u2014your snowy reign of mischief awaits!", "short_description": "Step into the spoiled boots of a rich family\u2019s mischievous kid and unleash snowy chaos! In this lighthearted VR snowball game, pelt unsuspecting pedestrians, rack up points, and enjoy the thrill of harmless winter troublemaking."}]}, "developer_name": "Pixel Works", "developer_privacy_policy_url": "https://www.pxlworks.io/naugh
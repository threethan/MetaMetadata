/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823790_2668604603499315_3644679203517113023_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M-2uj97QFAQ7kNvwHo2oqN&_nc_oc=AdrXWyBq295sWuHEtJoerVTjdmHNJZ3t6GMnotU5GJr_ZoxOTz1ha5feI9hphBfaLUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR82u6KmuC6CGyf1zqsoSHkkYjruRL2hXCkBqP6QJwAIw&oe=6AFDD184"}, {"file_name": "VrisChallengeScreenShots5.png", "id": "1697933857836090", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_1697933864502756_9031594593226263053_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXLu2wbYdscQ7kNvwFFr5qT&_nc_oc=AdrSGy6jEG8Ot33Ugt3jqsZFa7h5O8KTK4QIqNjuN_ntKknViI8YmVU-ZYdQKs2A_f4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRMN1DEGYQOAs8oYcajYhP4FgjRg-uxFi_f8l_8MQ-xw&oe=6AFDB0AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrisChallengeLandscape.png", "id": "1977736883122244", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1977736886455577_4168397671315074285_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3rs68dMcAgQ7kNvwEXtOKn&_nc_oc=AdqOvb7esJ7A4vM9GFZ4oHNfl68nChZt5TJ58nuDyRhVrx_NzlRKsIKTx5Y93jlojmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyvCEXg3IXfAUZb1KYVHzfx0u5oNO10WnZmzEgPokEzw&oe=6AFDD235"}, "display_name": "Vris Challenge", "keywords": ["VRIS", "vris", "challenge", "CHALLENGE", "arcade"], "long_description": "This is a pure arcade VR game focused on skill and score.\nNo waiting, no social pressure \u2014 just you, the game, and your performance.\nAs the difficulty increases, the gameplay becomes faster and more intense, demanding precision, reflexes, and full concentration.\nThis experience is only possible in VR, where physical movement and immersion are at the core of the gameplay.\nBuilt for high replayability, every run is an opportunity to improve, push further, and beat your own score.\nUnlike many VR games that rely heavily on social or multiplayer mechanics, this game is designed to be fun even when playing alone.\nIt\u2019s quick to start, easy to understand, and challenging to master.\nEarly Access\nThe game is already fully playable, and this Early Access release is about shaping its future together with the community.\nPlanned updates include:\n    \u2022 New maps\n    \u2022 Multiplayer modes\n    \u2022 Additional features based on player feedback", "short_description": "An intense VR arcade experience where skill, speed, and focus matter.\nJump in instantly, push your limits, and replay every run to beat your own score in a game built exclusively for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrischallenge/accueil", "developer_terms_of_service_url": null, "publisher_name": "Mock Interactive Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/vrisschallenge/accueil", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25921236094138680"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1202297995411635"}]}, "baseline_offer": {"id": "1202297995411635"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770595200, "status": "PUBLISHED
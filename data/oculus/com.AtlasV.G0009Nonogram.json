9CBB715"}, {"file_name": "Screen 5.png", "id": "939187645358334", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820387_939187648691667_1575358729170097685_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rl3aGiIwt8Q7kNvwHuFVTG&_nc_oc=AdqRA0_Qv1PQDHlY0sfU4p8fMwLRGpY8GyD5hslIsyGSZRzWZXsJnMn-DURrJ27jBzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDN2cMHujbZo2OggbR_hs1TALPxMAJu_ZmDXlEURny_Q&oe=69CBBF2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NONOGRAM VR: A PUZZLE GAME", "keywords": ["puzzle", "nonogram", "picross", "relax", "level"], "long_description": "# A relaxing VR puzzle experience built around classic nonogram/picross gameplay.\n\nSolve grid-based logic puzzles using number clues. Take out the correct cubes, mark the correct ones, and complete each level. No timers. No pressure. Just you and the puzzle.\n\n{1476761960480083}\n\n**Features**\n\n\n- Classic nonogram / picross puzzle gameplay in a relaxing environment\n\n{906991035252676}\n\n- Multiple levels with increasing difficulty\n\n{2342576209543915}\n\n- Infinite replayability\n\n# Take your time, think it through. Relax and enjoy the puzzle.", "short_description": "A relaxing VR puzzle experience inspired by classic nonogram and picross gameplay. Solve grid-based logic puzzles using number clues: remove the right cubes, mark the correct ones, and complete each level at your own pace. No timers, no pressure, just you and the puzzle, with increasing difficulty and endless replayability."}]}, "developer_name": "Atlab 5 ", "developer_privacy_policy_url": "http://docs.google.com/document/d/1UIqwy37qhzirnU-EkhGlqHQCyNqIm4sQlTO57XMJFt4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category":
, "keywords": ["puzzle", "nonogram", "picross", "relax", "level"], "long_description": "# A relaxing VR puzzle experience built around classic nonogram/picross gameplay.\n\nSolve grid-based logic puzzles using number clues. Take out the correct cubes, mark the correct ones, and complete each level. No timers. No pressure. Just you and the puzzle.\n\n{1476761960480083}\n\n**Features**\n\n\n- Classic nonogram / picross puzzle gameplay in a relaxing environment\n\n{906991035252676}\n\n- Multiple levels with increasing difficulty\n\n{2342576209543915}\n\n- Infinite replayability\n\n# Take your time, think it through. Relax and enjoy the puzzle.", "short_description": "A relaxing VR puzzle experience inspired by classic nonogram and picross gameplay. Solve grid-based logic puzzles using number clues: remove the right cubes, mark the correct ones, and complete each level at your own pace. No timers, no pressure, just you and the puzzle, with increasing difficulty and endless replayability."}]}, "developer_name": "Atlab 5 ", "developer_privacy_policy_url": "http://docs.google.com/document/d/1UIqwy37qhzirnU-EkhGlqHQCyNqIm4sQlTO57XMJFt4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25309254355415416"}}]}, "schedu
-25/491825575_1099152796029648_4664078724268726990_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOV6lTlGiyAQ7kNvwE_A2KC&_nc_oc=Adqdv7LEByAZ8iv01dAamW2mjcbJsEqMDplqnMyHc4LlKGNpdPJEP8oZVCoFnMc-kog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBGuwFl3FgpaGa06u2cN4woNcy4sq924qiUjDqcERMfw&oe=6AF8A27A"}, {"file_name": "screenshot-2-2560x1440.png", "id": "1482448977175494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_1482448983842160_5488654252322503744_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoCW_lXrMbEQ7kNvwGPw3_K&_nc_oc=Adrhcqapt50aXFMKDxn_0kNEMY3GlDryjXxfmCPmXswCrwnegnWPfO1bUC0uHd5JGa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTYgX60tGsPodLuUVPRZjG2WkUTBoB4q4mx-mpodU-8w&oe=6AF8831B"}, {"file_name": "screenshot-3-2560x1440.png", "id": "2093214121284451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_2093214124617784_7258874364597024929_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2u4sUKVM8QQ7kNvwE2ddOr&_nc_oc=Adr9Ce_4qUNlhL43lic9R73hQkysZ2sF3cB52T8mJ0aktXNAeTN1T9YcJQ_B1t6JogE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYL-lL_qqemj9idcI4YjrFCDTM-bIUMYIZnNVBlQu8zg&oe=6AF88BFB"}, {"file_name": "screenshot-4-2560x1440.png", "id": "1127695162926616", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1127695166259949_96531931874484890_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71Jy3gmunU0Q7kNvwHW9tYK&_nc_oc=Adrd5d7GMFPRy9L3TNwxcqvXSafStJlnb0gMl0IF8hXYGZXATUi9vaQ9pum21x-ljts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7YiEnGNPt2apct3FnZ5b1cH_UGPl5D13GB0ndDOECaQ&oe=6AF888DE"}, {"file_name": "screenshot-5-2560x1440.png", "id": "2170012513549229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2170012516882562_4661529064457613762_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNJ4sd_AzvYQ7kNvwGwc0gX&_nc_oc=AdoKPCWzK_4v96dm69vo8TD-SJjtNhnxMOuCh6TL73aAPmigB3w3xXJvEBJVV5tKK2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2O0sMPA81h-9Wofw1tG56l6yJbLdwTuxgcqgp7KjEng&oe=6AF888FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Billiards", "keywords": ["billiards", "pool", "8ball", "cue", "sports"], "long_description": "Billiards puts a full-size pool table in a glass penthouse high above a living city. The sun sets through the floor-to-ceiling window, pods and drones drift past, and a sky liner crosses the skyline while you line up your shot.\n\nTHE CUE FEELS REAL\nHold the cue in your right hand. Put your left hand out in front and it becomes your bridge: the cue slides through it and your aim is the line between your two hands. Squeeze the left trigger to lock that line, then stroke straight through the cue ball. Hit low for draw, high for follow, off-centre for side. A guide line shows where the cue ball will go, where the object ball will travel, and where the cue ball goes after contact.\n\nTHREE WAYS TO PLAY\n- PRACTICE: sink what you like, pick the cue ball up any time, re-rack from the menu.\n- 8-BALL: two players passing one headset. Open table, solids and stripes, fouls and ball in hand, and the 8 to finish. The scoreboard over the table keeps track.\n- SPEED POOL: sink all fifteen against the clock. Your best time is remembered.\n\nTHE PENTHOUSE\nSixteen balls with real rolling friction and recorded ball, cushion, pocket and break sounds. Five skies on the pedestal by the glass: sunset, daylight, dawn, emerald and neon dusk. A lounge to sit in, a gallery wall, a cue rack, and a balcony 300 metres up. Six original music tracks on the menu.\n\nNo account, no internet, nothing collected. Just you, the table and the view.", "short_description": "VR pool in a glass penthouse 300 metres above a sunset city. A real two-handed cue, real ball physics, 8-ball for two players, speed pool for one, and five skies to play under. Step out on the balcony between shots."}]}, "developer_name":
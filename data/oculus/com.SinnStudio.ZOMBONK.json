ntent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312332_1351956655900359_8949870088813458623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riDEJygJ7xEQ7kNvwGBxuvP&_nc_oc=AdoowvcYhXInVfC9CBCcS7WJStw2s5lgfQ6uQVVSo6_hpyvuIC9uPj4606s46UEybC8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZtQ40M4w1QdeN1lS_0zk1LVxyjZt6mLZCDzz-LXt3ww&oe=6A5A1DB1"}, {"file_name": "Screenshot_05.png", "id": "2243724646111632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299891_2243724649444965_5793770744051649463_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA4iGxkrVzAQ7kNvwHZw7DN&_nc_oc=AdpWzrnf3xE17TlTrru7rgzoh1KDRuOMwXBJ_FAOwIafdSMCIh6XePlP5STF_q39q74&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA10gi3xLVwO_U59XQldepZwFJ6BQG3Lt3kOVkswdgDBQ&oe=6A5A2F9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZOMBONK", "keywords": ["gorilla", "zombie", "gun", "shooting", "multiplayer"], "long_description": "# Bonker wake up. World gone. Zombies everywhere.\n\nBonker no cry. Bonker scavenge. Bonker survive. Bonker help friends.\n\nFind loot, grab guns, carry junk back to base. Sell Stuff to get Bonk$.\n\nBonk$ make Bonker rich. Bonker buy shiny hats, better guns, cooler fits. \nExplore new maps, weird places, scary noises. One day city. Next day forest.\n\nAlways different. Always danger. Always Bonktastic.\n\nBonker share loot. Bonker help friends. \n\nSometimes Bonker steal food by accident (oops). Still friends. Still fun.\n\nWorld change all the time. New zombies, new stuff, new adventure. \nBonker never bored. Bonker always Bonk.\n\n# \u2014 Why Bonkers Love Zombonk \u2014\n\nBonk Together = Strong Together\n\nSurvive world with friends. More Bonker = more loot. Easy math.\n\nLoot. Stash. Repeat.\n\nEvery can, gun, and sock matter. Bring junk to base. Show off to other Bonker.\n\nWorld Always Change.\n\nNew places. New monsters. New shiny stuff. Bonker never know what next day bring.\n\nBonk$ Money\n\nFind loot. Sell loot. Make Bonk$. Spend Bonk$ on a Bonkerful hat. Very smart.\n\nBonker Look Cool\n\nChange fit. Change vibe. Same Bonker, more style.\n\n# \u2014 Join the BonkCrew at discord.gg/Zombonk \u2014\nBonker talk. Bonker laugh. Bonker playtest. World safer with more Bonkers.\n", "short_description": "Survive the zombie apocalypse, loot for guns and items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": "https://www.sinnstudio.com/contact", "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25273311615672869"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1614126979553771"}]}, "baseline_offer": {"id": "1614126979553771"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765389900, "status": "PUBLISHED", "id": "1614126979553771"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27535083486162326", "version": "1.0-97471"}, "id": "2237005476811397", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andr
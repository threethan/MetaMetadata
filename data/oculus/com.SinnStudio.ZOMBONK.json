ent-ord5-1.oculuscdn.com/v/t64.5771-25/499304305_1327505932765311_5286460740341237931_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCV_urt79BUQ7kNvwEUTdfB&_nc_oc=AdpSpI7gAEvho_Kj9zNCSnz8ahR6o7PNoH-_nand4X0j9vA4Tk_oOpNFr5M1SP1sLvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJdHD-PE1X_xYf_S2hZhrTeI0Hd8bFSqcE6CCtQLHH-g&oe=6AAA8864"}, {"file_name": "Untitled (33).png", "id": "2076724189787348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304938_2076724193120681_4871879008737988130_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK-Eou1gikEQ7kNvwH5osY2&_nc_oc=AdrZfsIyEq7N6Q6_pBocKXFQF4Pgn3FfyDbuJ-ZMyV0CmriCOCeYR2YvADL3tnYPYWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuaUT5mc9YAjaSlwN67JTNwO-zIwwkzOjTt6xUVdgxUQ&oe=6AAA9BD7"}, {"file_name": "HighresScreenshot00033.png", "id": "3932380693732122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_3932380697065455_5087597325838508038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mES3Jf5xDNYQ7kNvwGqtPdb&_nc_oc=AdqHRigOVpauq9kbxaAPhy9kntQBEaimtSbqk_-ZbGr0I0jpdSnsOgQXUgsiBUU8DKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ_8OjFW-SPKR5FAx1foqW1FEHBv-X0Ztyihbc66DqQQ&oe=6AAAB2E2"}, {"file_name": "Untitled (34).png", "id": "890620570035576", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303140_890620573368909_3665044860292886222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mtPOtYMGfMQ7kNvwGsQQ1Y&_nc_oc=AdoyOuNyTQ2bzsH9PRyx_CStu8P45gb_Iss2xFpPHnZ3p-83y_LEHUwuu4GiaNclXq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuvoyS-VDyq-K3rufCKnZ07jd2-HTm8OXemYj9ISQmow&oe=6AAAADDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombonk_MiB-1_Update_2560x1440.png", "id": "1613544100324720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1613544103658053_3925064411389532973_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR--QZcyg4cQ7kNvwFSsrb1&_nc_oc=Adr5t4yDfeJ0Fsh2_IDo9YvI4n_doPLYMle0oYHnYWg1_N3zAnQic5EcIj8k19YD6Fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcJmdDTva6vR5_6vLoXC_P95rD6fiXG13RGKKAPaPa8w&oe=6AAA9B55"}, "display_name": "ZOMBONK", "keywords": ["zombie", "gun", "shooting", "multiplayer", "monke"], "long_description": "# Bonker wake up. World gone. Whatever.\n\nZombies and monsters everywhere. Bonker still vibing. \ud83d\ude0e\ud83e\udddf\u200d\u2642\ufe0f\n\nExplore maps, crack open boxes, hunt for gear, survive long enough to flex it.\n\nLoot stuff \u2192 Sell stuff \u2192 Get Bonk$ \u2192 Buy drip. \n\n# Multiple maps to choose from:\n- \ud83c\udfd9\ufe0f Bonktopia City - open, quiet, and NOT SAFE\n- \ud83e\udddf Zombie Survival - relentless waves, COD zombies vibes\n- \ud83c\udfeb School - three levels. too many footsteps.\n- \ud83d\udef0\ufe0f Space - out it the orbit, something broke into the station\n- \ud83d\udca3 War - they started it, you end it\n- \ud83d\udc1bNest - what lies underground will shock you\n- \ud83c\udffaTemple - explore the secrets of the civilizations before bonkers\n- \ud83c\udfaa Bonkland - horror carnival with dark rooms, laser pathways, & targets everywhere.\n- \ud83c\udd99 Skybonk - an Only Up inspired parkour map, with zombies of course\n\nPro Tip: Bonk with friends for more loot and more BONK$. \n\nPlay in private servers or chill in the Social Hub safe zone to hang with fellow Bonkers.\n\n**\ud83e\udd1d Come hang in discord, and meet our bonker community \ud83d\udc49 discord.gg/zbvr**\n", "short_description": "Survive the zombie apocalypse, loot for guns and items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": "https://www.sinnstudio.com/contact", "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COM
b=1-7&_nc_sid=6e7a0a&_nc_ohc=djf2V_N3F0AQ7kNvwG46XQO&_nc_oc=Adq7p-y2ReQUynt1BmkUagtpq-5NRUnWK0HO5OuY4P9HREIDHAE_6Lj7v-p95d3zOt0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYJdwirw7Yk2-9RfkAuxgGKq4jaZOJzfobtkTtM7cI7Q&oe=6AE351FE"}, {"file_name": "Screenshot_04.png", "id": "1351956649233693", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499312332_1351956655900359_8949870088813458623_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7QIEo1EWiIQ7kNvwFHLkhI&_nc_oc=AdqvwHGnybLSMcaciSRmcXYgfXiOsl4MrhEa7cl-t2ErU_wxyVne8gJf2mMVYPExr0A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4BLcFkqOWwK7Ptr8ZiXqpdfedmifPdV1k-EjfTQuoAw&oe=6AE339B1"}, {"file_name": "Screenshot_05.png", "id": "2243724646111632", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299891_2243724649444965_5793770744051649463_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQKXCv5h2y4Q7kNvwEL8e9U&_nc_oc=AdqeKcnGN8IQ6HspQKOYzFBBbmCWpEeDFAwPPjxcKKhUxz_8uX6UjvXh3XEUBvElpfY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrc7mpu1DNPIT-HyJqHkP7Y0GGqJdW07aDCk4EwvXIMg&oe=6AE34B9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ZOMBONK", "keywords": ["gorilla", "zombie", "gun", "shooting", "multiplayer"], "long_description": "# Bonker wake up. World gone. Zombies everywhere.\n\nBonker no cry. Bonker scavenge. Bonker survive. Bonker help friends.\n\nFind loot, grab guns, carry junk back to base. Sell Stuff to get Bonk$.\n\nBonk$ make Bonker rich. Bonker buy shiny hats, better guns, cooler fits. \nExplore new maps, weird places, scary noises. One day city. Next day forest.\n\nAlways different. Always danger. Always Bonktastic.\n\nBonker share loot. Bonker help friends. \n\nSometimes Bonker steal food by accident (oops). Still friends. Still fun.\n\nWorld change all the time. New zombies, new stuff, new adventure. \nBonker never bored. Bonker always Bonk.\n\n# \u2014 Why Bonkers Love Zombonk \u2014\n\nBonk Together = Strong Together\n\nSurvive world with friends. More Bonker = more loot. Easy math.\n\nLoot. Stash. Repeat.\n\nEvery can, gun, and sock matter. Bring junk to base. Show off to other Bonker.\n\nWorld Always Change.\n\nNew places. New monsters. New shiny stuff. Bonker never know what next day bring.\n\nBonk$ Money\n\nFind loot. Sell loot. Make Bonk$. Spend Bonk$ on a Bonkerful hat. Very smart.\n\nBonker Look Cool\n\nChange fit. Change vibe. Same Bonker, more style.\n\n# \u2014 Join the BonkCrew at discord.gg/Zombonk \u2014\nBonker talk. Bonker laugh. Bonker playtest. World safer with more Bonkers.\n", "short_description": "Survive the zombie apocalypse, loot for guns and items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": "https://www.sinnstudio.com/contact", "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25273311615672869"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1614126979553771"}]}, "baseline_offer": {"id": "1614126979553771"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765389900, "status": "PUBLISHED", "id": "1
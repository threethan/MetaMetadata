ent-iad6-1.oculuscdn.com/v/t64.5771-25/499304305_1327505932765311_5286460740341237931_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCV_urt79BUQ7kNvwGkh3_m&_nc_oc=AdrfRqWXMiIVj6Flb9Ct4FnfhJHY1W-KMzGXlrh0iZ2F5a6MiyXZK_WW2IRRAvi9qXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd43AjOhqLAjum9JpgfkwZ7Ri1DXYDnUihXsMu0Plovg&oe=6AABD9E4"}, {"file_name": "Untitled (33).png", "id": "2076724189787348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304938_2076724193120681_4871879008737988130_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RK-Eou1gikEQ7kNvwHTf-Uk&_nc_oc=Adp5UW7Y9Ro28aiUMspqwD3boOOwATFefHAXx_8FrWhR-fQY6jAZcK7hwMxxhfVMtYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH-gJ4cu9ppySn0P39dPRrz4Yx4e6HdLIlPUl2dqE70g&oe=6AABED57"}, {"file_name": "HighresScreenshot00033.png", "id": "3932380693732122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_3932380697065455_5087597325838508038_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mES3Jf5xDNYQ7kNvwHnOsjF&_nc_oc=AdrXjXawbO2p7sCMDG4H8U5MDWroQ8xMd6holeAoSRNJYhD4hsJaCW5OF_YWCrVFfo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRP8IuQ6wZaMvJkcmn_RO_xNKNoSj7GC2vIOmoSwasQ&oe=6AAC0462"}, {"file_name": "Untitled (34).png", "id": "890620570035576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_890620573368909_3665044860292886222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mtPOtYMGfMQ7kNvwGsPRcn&_nc_oc=AdpIeZmmQe3iazMmMKnu_7nrgJSDtMpWCwOiGrUTmYlkmmvRMG7kJknF-E-c0VAvc_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs0QQaP66eNMohO1jgEBZvVgXfbphQsWV2CiifC2j4xQ&oe=6AABFF5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombonk_MiB-1_Update_2560x1440.png", "id": "1613544100324720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1613544103658053_3925064411389532973_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR--QZcyg4cQ7kNvwGG6pSz&_nc_oc=AdppuRnbf7LiTMoMm_7pB9lMuc_mbS2PcAHCf049vaGgt9MRm5KgCDJjiAPht_hr_4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuUz1jnBpO6MrpGVvr2ph3C5FQ61nn3_alUxEVDbgiSA&oe=6AABECD5"}, "display_name": "ZOMBONK", "keywords": ["zombie", "gun", "shooting", "multiplayer", "monke"], "long_description": "# Bonker wake up. World gone. Whatever.\n\nZombies and monsters everywhere. Bonker still vibing. \ud83d\ude0e\ud83e\udddf\u200d\u2642\ufe0f\n\nExplore maps, crack open boxes, hunt for gear, survive long enough to flex it.\n\nLoot stuff \u2192 Sell stuff \u2192 Get Bonk$ \u2192 Buy drip. \n\n# Multiple maps to choose from:\n- \ud83c\udfd9\ufe0f Bonktopia City - open, quiet, and NOT SAFE\n- \ud83e\udddf Zombie Survival - relentless waves, COD zombies vibes\n- \ud83c\udfeb School - three levels. too many footsteps.\n- \ud83d\udef0\ufe0f Space - out it the orbit, something broke into the station\n- \ud83d\udca3 War - they started it, you end it\n- \ud83d\udc1bNest - what lies underground will shock you\n- \ud83c\udffaTemple - explore the secrets of the civilizations before bonkers\n- \ud83c\udfaa Bonkland - horror carnival with dark rooms, laser pathways, & targets everywhere.\n- \ud83c\udd99 Skybonk - an Only Up inspired parkour map, with zombies of course\n\nPro Tip: Bonk with friends for more loot and more BONK$. \n\nPlay in private servers or chill in the Social Hub safe zone to hang with fellow Bonkers.\n\n**\ud83e\udd1d Come hang in discord, and meet our bonker community \ud83d\udc49 discord.gg/zbvr**\n", "short_description": "Survive the zombie apocalypse, loot for guns and items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": "https://www.sinnstudio.com/contact", "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COM
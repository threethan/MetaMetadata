oc=AdrbnnMQD7MM9zBffAME8G8OvKDs3bf_-qDoewa4qHSEM0OjHgxz67l9fKadWXjCld8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE-dJfk5MeeRC4pzyb2JrnenXfPHC9E_9c8Nn3PE0o-g&oe=6AFDBC5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zbonk_TheBank_2560x1440.png", "id": "1918794549534083", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_1918794552867416_256006958428957276_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4KgY7_W2VwQ7kNvwFFHqWb&_nc_oc=Adov7mBA0iq_kIFsybWD4K_b_IS_4ollm-8_hYO9XR1bJKZ2-Rx4PRKxRhRWOoyRFEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOzLq2hGcOzLBMq8UZnmca78FWU0mgBBWIn29X16y5Rg&oe=6AFDB2D2"}, "display_name": "ZOMBONK", "keywords": ["zombie", "gun", "shooting", "multiplayer", "monke"], "long_description": "# Bonker wake up. World gone. Whatever.\n\nZombies and monsters everywhere. Bonker still vibing. \ud83d\ude0e\ud83e\udddf\u200d\u2642\ufe0f\n\nExplore maps, crack open boxes, hunt for gear, survive long enough to flex it.\n\nLoot stuff \u2192 Sell stuff \u2192 Get Bonk$ \u2192 Buy drip. \n\n# Multiple maps to choose from:\n- \ud83c\udfd9\ufe0f Bonktopia City - open, quiet, and NOT SAFE\n- \ud83e\udddf Zombie Survival - relentless waves, COD zombies vibes\n- \ud83c\udfeb School - three levels. too many footsteps.\n- \ud83d\udef0\ufe0f Space - out it the orbit, something broke into the station\n- \ud83d\udca3 War - they started it, you end it\n- \ud83d\udc1bNest - what lies underground will shock you\n- \ud83c\udffaTemple - explore the secrets of the civilizations before bonkers\n- \ud83c\udfaa Bonkland - horror carnival with dark rooms, laser pathways, & targets everywhere.\n- \ud83c\udd99 Skybonk - an Only Up inspired parkour map, with zombies of course\n\nPro Tip: Bonk with friends for more loot and more BONK$. \n\nPlay in private servers or chill in the Social Hub safe zone to hang with fellow Bonkers.\n\n**\ud83e\udd1d Come hang in discord, and meet our bonker community \ud83d\udc49 discord.gg/zombonkvr**\n", "short_description": "Survive the zombie apocalypse, loot for guns and items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sinnstudio.com/privacy-policy", "developer_terms_of_service_url": "https://www.sinnstudio.com/terms-of-service", "publisher_name": "Sinn Studio Inc.", "support_website_url": "https://www.sinnstudio.com/contact", "website_url": "https://www.sinnstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29126513597019299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_1138571811866487_5949530303351102580_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJb6szILC1kQ7kNvwGEVsIO&_nc_oc=AdoU726rv5F0D7RRq6OJwmtiXlp-5d7E2iT9y6Up7iFC_n6jYtDtk4qWHY_lHPkxADI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1LOt11nXzLO4sGfwdfi-sDfa73Wyl75I4h6qm_DJh9g&oe=6AFDC9DC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ZOMBONK", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164
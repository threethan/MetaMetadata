701_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBSDxDrwxrEQ7kNvwGDOwt_&_nc_oc=AdpTU2AhuLAKbv1Ypynsk6x0wekBGZT23rlVP2a-X9zMQRxlMb0rH2Oqyp_7yoEf8OY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcWpl2sHBnmhmVblLVb3F4AokEG5b_5VtnTfSZ3kn5bw&oe=6B00654F"}, {"file_name": "PSMSS_04.png", "id": "718477030112869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001687_718477033446202_5493872504861220414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M7FAwTj1RsQ7kNvwEM5Mzb&_nc_oc=Adq_jKqzi9CWoEPieUYZybnWdMnNzU_IFVqUDWtze7m0wKeRkYE-L12w2JYMfh5zwuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR096gsIvKmwLZkqdAhaeJmY0Ruex97gqzWVHEYXSNxoA&oe=6B0057CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "2225728501141539", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974593_2225728504474872_294281975595554366_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tc9TKEk-EQEQ7kNvwFa9ofU&_nc_oc=AdreTYXL-zJoChGe2dTSEVja7M4CPJDrhUqOZKjDpHYHJHOQykxOOKxg9la84IGiCCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTltFJSYYXKriWWNobQoNAam_XWVTDmWxNDZ8_5KQrlcQ&oe=6B0073DA"}, "display_name": "Physical Space Management", "keywords": [], "long_description": "Physical Space Management (PSM) by UnboxVR is an innovative VR system designed to revolutionize user interaction within virtual environments. Our cutting-edge system specifically targets the locomotion challenges in VR, providing a solution that encourages natural walking movements, thereby significantly reducing the common issue of motion sickness. This advancement not only enhances user immersion but also extends the duration users can comfortably spend in VR.\n\nPSM is built around the concept of dynamic physical space management, enabling the user to walk around the virtual environment in real time, using the physical space available. This allows for natural movement within a room-scale setup or even in more confined standing areas. Our system is compatible with the latest touch controllers and offers seamless hand tracking support, ensuring a wide range of interactive possibilities.\n\nThe system is perfect for users seeking a deeper level of immersion in VR experiences, from gaming to educational and training simulations. PSM's intuitive design is focused on simplicity, making it accessible to users of all skill levels. By addressing the core issue of locomotion in VR, Physical Space Management sets a new standard for virtual reality applications, offering a glimpse into the future of VR interaction.\n", "short_description": "Physical Space Management (PSM) revolutionizes VR locomotion by enabling natural walking movements, eliminating motion sickness, and enhancing user immersion. Our solution addresses the core issue of VR locomotion, transforming user interaction within virtual environments for an unparalleled experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.unbox-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "UnboxVR", "support_website_url": null, "website_url": "https://www.unbox-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25680572701533621"}}]}, "scheduled_offers": {"count": 0, "node
95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvmgUNp4LiAQ7kNvwHE5dM_&_nc_oc=AdpLLA_0sOyNzGXGiuVnRf2k43-RhbGTuGwDs5OxvT36S5hxPrXcB_NleaQ_lxd3xvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCsnz_Cv_GO_8CSRLfS5G_d0NOrTkDrH9FNWwLv27SlA&oe=6AEB47D1"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub0mU49OIQgQ7kNvwG2xhmn&_nc_oc=AdoJl-pyl_p7TP9RWL4_VIIvF5V_O8bJB4XBUDwraFfnX32cNZjRx8MhXEzEAY84DOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6KOOVSHtc1q4nxMUynQjLASXGEXQh6OWgUqw7zyItpA&oe=6AEB3DA3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf0ean1YJ6kQ7kNvwH2aXaE&_nc_oc=Adq2R0CDxZGPfB2yNBbBwqXX1kyHu_uydRHdzhBL7Ys_xToLvqbuQe7yNb97oewpVaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWwR7F-XfAKJgcnfJ4YggVRftfy9t3WxT-VXUlqGAoUg&oe=6AEB4FC5"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l7ITObx-38Q7kNvwHDkybf&_nc_oc=AdrWhnjmHYidGk5nNfFc5QIHTowRMhx8DhTpXZeG9Nd_7QhkXRGaSFxgpcBBjUSkSTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjrwUIUs-Twg3lRcJXwkfsdeMScZ4fkXx-oeCG9W0PEw&oe=6AEB59A6"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOsitEF6oJAQ7kNvwHJsxnq&_nc_oc=AdrSlwpoZ27opjPuxUsL3MBMF6PEWBuQ9LgzrEZjUaT0pBSOwDrW5fT1rqefOU0jz5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4cX1vYdGjhIG_vCK7uu9ZnndZ0fVXRDnAZP8mz1S3QQ&oe=6AEB3A39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
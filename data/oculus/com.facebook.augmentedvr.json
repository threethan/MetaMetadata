95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecyL2dAAQ0sQ7kNvwFF-Kf5&_nc_oc=Adq-wTsMG_Ph9gaUAH48IYXzkZoz-xJfpPuDZ24XgMK3U7Xa0ZET8qMmmtzQEwoJP24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJm3iyecr6Gsn-kG7xki_iRCZWCAzgscRu6Cv91tNqvA&oe=6AE601D1"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfExDCjZrcsQ7kNvwGj9_lP&_nc_oc=AdoDhEj7zC-nV2iqQSqt-BJ3tSMTI_p3yUXXjM5N7NwOIyjRvmmSXxRB4fTHFg5KqHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYdByfFZ4-gbmZgZDXMoW2kDzuohj79k6dfL5RDZtuJA&oe=6AE5F7A3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moytAxmsAOsQ7kNvwH6v5Dd&_nc_oc=AdoGbj8E8yc9clOKY_rj1sNzNuJ7K0PucKTvafsnXWPin2LShevidra6oEO7zXQciZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH_pdC-pTCgpdiS8ETP1hnlWqkk_90RC8b63Gffw4SZw&oe=6AE609C5"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edTduv3UYE0Q7kNvwEAgcz0&_nc_oc=AdpwkLgDIJlyMzSjgfRFtAkN50x1mt8Gi7CkE0HjcFpNyOaP74ArBZrpsnM-cNudpJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv0KD4Ti_TBwvWRQKt5YXYksR93oWK1Mk_eufzPTtfoQ&oe=6AE613A6"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpWPHog7xXYQ7kNvwF_tDNM&_nc_oc=Adr9tFWsyy9kg6QI_8Tr-NCjNQy0cOYw2Jg1cLnHSxDJE5y5mutsXktqnfCdphbgoL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIxauBrVqO0BAlzXWKNnG6EIEbeIrG0esoVeaKMsf_4g&oe=6AE5F439"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
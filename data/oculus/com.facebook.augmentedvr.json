95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvmgUNp4LiAQ7kNvwHLjOSM&_nc_oc=AdrWayRl3l_dW292qpEW7Anp8L7zYSZeD5KQqK6e-58234K__i2r93CWwc8Z0bJRghk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGNyMS5fm8MgRdftRLSrStSKI2ZegacV-gujMZ-6MTg&oe=6AE9F651"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub0mU49OIQgQ7kNvwHONBx1&_nc_oc=Adp8Z98tTMY9Gr5JGvGYCQgA_4jJstl8-9PHXtPgVX4QPiuPQvZCNZqFcG04bjgI0Yc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJj58Ewb7MRavX2BOlK7xtxhvED2c9YYsGEXskTo2vkQ&oe=6AE9EC23"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nP8rzMX3WAQ7kNvwHJGYyY&_nc_oc=AdqDJAXGNBv2A1Jyx3_5f-Rba956r0MYA8gZ9W4hwbLtfo_S87d4_1M6eKvuyfCQBjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDV-ghFJWPOykHL5aznuHjqwLuIEL8ufQjhVNcT5pvHw&oe=6AE9FE45"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l7ITObx-38Q7kNvwE3y1tg&_nc_oc=Adop19200ZOIzvJCyufDuOrfiPTWMLQn8vBI2B1A45btOBZGSPRMR702iBgbRvK0deI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkbPwsmcqu1qaRHA9OFu5o221nTnkOJM4Zi9gAPFdv0w&oe=6AEA0826"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOsitEF6oJAQ7kNvwEVmeQo&_nc_oc=AdpIVzdpL-8tNKspoBxdcnufXYGIsd1T08THZPhiuMGZWTK-G-WeeX0Vz9ZYG5nGEi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ygIx7b_6BcB_EpCSLcxg-YZzPN8XcpDLmeIvkugHMg&oe=6AE9E8B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
187_3313807595859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxTeI1tI8EUQ7kNvwHvU6CY&_nc_oc=Adrbj2nZ1wQpI7N7d_Sw7G_s0owkf3EA-cd0RHJicosGriDjYpMLNj_-wOmUGZUrBVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I4q2B4K8RpKqmafKwUVzgZlXvpsXDuGMoUnqB4juaVA&oe=69EE27D1"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiOFim-DzxIQ7kNvwGCET5Y&_nc_oc=Adq7SXOm1pd9O_hvGHbyVmUXgWHZ775j6GyYQxTXCldElU5fSrel2qavneH1d3-jEy4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TpG1awMT7Y_rKBF17_ibSs34vBhoPq9zMGEyTRsq9Lg&oe=69EE1DA3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Okp_hHP0VOkQ7kNvwFiJPsE&_nc_oc=Adr9mWrHQVmZ1tJIOxaohWuvm1Vwl04ds_hfjYYP_ux2Z5siBdN2PPIjz21Zv3Cd93g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-Ki-50yDTb7cugN2Or5kymCwEDl1pI-qP0geAeqmewQ&oe=69EDF785"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7ZMw9QPoHAQ7kNvwF6iS8W&_nc_oc=Adqcruz8P87plalQdIKpB7k1phx-tPGVK1d3HPGrKOK0qNHat8YEfJJsc-HBUI11tJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FzBP177JqAg7aXopGtb55sGtHbrR1gMRKjCWlWsVzsg&oe=69EE0166"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuE8qMOzV3IQ7kNvwHRTQR1&_nc_oc=AdplkScNLpqoXmsmvqGmsrWsDEnczGaEoGkHDu5zL_dCEEmx_cKxYeooNhuObkvf5EY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1h0ll_mJjyliYhWQ4fWnv2cEHydtH4BB0T7ztTbKL7VQ&oe=69EE1A39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "s
187_3313807595859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrc4F1SC5mwQ7kNvwEPFvRu&_nc_oc=Adrgni5q3NTixUGqWiAej2uyIm2DwQDGIIr2rr12zAnc7hu9EFyOGzsnBxCJf9m05C4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tV0Ky6chNV0kZk46nIzIBP7Oz5iPmHsxRZsCSF96EEg&oe=69FB56D1"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzq8c8IfvsAQ7kNvwE7V4Xp&_nc_oc=AdqLazQ9HJKF_bdL8G-p-3H_LjFjAHy5XuPZm6iJ45vmWisQiWWmqkdHpgp_kV_ML14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j8eOCgxczTzo0js10PGBH6NVkU72Dv-N-jTSxqJLbOA&oe=69FB4CA3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEghMeStP_IQ7kNvwF7bt8u&_nc_oc=AdqVQsLnmugj-pLZX-z6drlMCpGcKdxGlGz9BeSgGXoUPS-FL5tkvynZOLBI8D4sggU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5akpwJQcQk4HpN-DyeFPMdF-Nrps2bKtLdIIOkCTYm_A&oe=69FB5EC5"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xar0JGC6uscQ7kNvwHYy_RS&_nc_oc=AdqAEUPW79XYqV3aENph1YmMvX6IiqFvbtIm2D68JnCnLYYMlC1CSMjxabrHKubHHxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tk6_g5CnZs6qHuop_hdrg0YQL8Ldsu4r-TaMxBXaByA&oe=69FB3066"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nef1mfWzWeIQ7kNvwHNgjm9&_nc_oc=Adqtb5WKOoWPO0wM9irHv9yvnOwocOx03HXdX2-UJ-C1YoH8zpixwdSjzSAN4bhFh6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hBdUobQU-4WvsVrA5TVYiRcBybawdc8rYK2jM8c2o6w&oe=69FB4939"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "s
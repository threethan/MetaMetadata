95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecyL2dAAQ0sQ7kNvwHfQFnx&_nc_oc=Adpt9_oeirJuJfWwG90EAagtB1K49SjjhETxvHRnWNGxLsxzNylNzMs-qXki2sr0KTk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz7qZ_OSYcE67o1baj0dJCtK0jwlBaO7i0GYLtFjn6Rw&oe=6AE8A4D1"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub0mU49OIQgQ7kNvwHtMWWm&_nc_oc=AdoHc29J3Xm4oVguHQ_cxf_ZPhBardDEL5dBplJYiZpt6RKXij_47iljImwKwyOBHEI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_NINZaAXUJ2MAxEdTw8srNEHj2TuTI8NHrRc69zMWtA&oe=6AE89AA3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nP8rzMX3WAQ7kNvwEK5NP1&_nc_oc=Adrlp2N-J63utuf2mnw_DvJbgWtFYwFdq-DMwoFCvMFrqzEVFkcIAr5SKnH8at9uV7g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5ux19T-9eAJVA823CbPDBSHTkhtaeEvYbpE6gnUZY-w&oe=6AE8ACC5"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edTduv3UYE0Q7kNvwELtQUH&_nc_oc=Adqby6ZSx-1X7fFDyo7ulbqc7B16ioNaadgY8VUsb4H1xALUsBCjopoaMTVWzFZ2Vmk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyVq6WdFX6m-iRP71M0DDg1bfmJOe9OTybQSueu6v1Fg&oe=6AE8B6A6"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpWPHog7xXYQ7kNvwHnYLj9&_nc_oc=AdrImMgoF1IAIOU6M_8ShpIxpr-9kpGxRu3Ftjs4mbrefNboubZ8Q7Mh7s-AyZaeXgE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR46xSmHdRs7T4GNVx6_CE1ozIUdXxiNjb4sujpiQMpUw&oe=6AE89739"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cMOdjdDbxPBvbXTSBL83-_iUjMu36k2zCQJb4eLhHrg&oe=6A43CF23"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO8Y3Ystd1UQ7kNvwHqlDnJ&_nc_oc=Adrv71ZTKsT7DaVBZJ0jFLLmKIEmoNMMLOXRlXUTBo-rmIZHfpHGMlfXzxaKTkHJXAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dML_oEMIa1HVxQ_n2uCzKtGKEV5EDvwr4yFCAoiaMzA&oe=6A43E145"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QVrzlBDk7gQ7kNvwGDhYEd&_nc_oc=AdodZJrHXVPATclJXdErpy5pko2IPbwc0TgxS9NnBZwC1KpC4kuFXFjM8X9_ktcz71Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uznlAQzjoZ0mOHgVLKN1EebJU8EYHLfo7s7p0gLNwCg&oe=6A43EB26"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5m6lQ5Cl1FcQ7kNvwFlMEfG&_nc_oc=Adq-XBzv_9MgydNpmp_9keAUjXSFj5rCFMy8P_i5W4VB9WGqg4YHJNhsOqzZcbSWiak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dODfArNVmuLdPHhmjg5YfzkSjaGHECmg0s3LtC3HSpQ&oe=6A43CBB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "783066696356143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295751_952423296149544_6248543502049458911_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxwE8uW318MQ7kNvwG_IBPo&_nc_oc=Adqk5fWDSLgigUMxABQryBrRlXP8BNyZY9LCImn7tM6I-XpZkzm8OLjmb_NEz-yom_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GDKVVSYCeRni5iS7V6f5aNw0zRIiyt644COyXM6yDng&oe=6A43DD56"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Me
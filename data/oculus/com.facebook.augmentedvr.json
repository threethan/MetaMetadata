95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4oKg0RPCA8Q7kNvwEtGpLe&_nc_oc=AdoVNDM3wQ8x5wXnO6hQJmifjHk192_jNUnC7OXAFYbjDHMQYVMVr3PRsYJuc8-nuas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBpCOVBkY8vJSE3rVpB5y5gUBjw14KcTI7Y6H-ud_biw&oe=6AEDEAD1"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OdZ13HLMoNgQ7kNvwEcetgI&_nc_oc=Ado0SD9olyPRd7AjHKsN6qZoJS8f2PUHYi-aEyoIKs_wit0RWyzx5RDB0E3XgFeoJuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Uq1d30Ifc0-6LcxxVe7vojbAh9_dvMX0zf-8izdcog&oe=6AEDE0A3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf0ean1YJ6kQ7kNvwGWpT43&_nc_oc=AdpPuLEDpWDXVR-xBulTUzetVVfzphk73uJIb8ZACpCOgN-qLEkqoxaQX5NRYmgx1Xg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4bcp0OUnATa1_8BnwNRizH230bwD1sYXMmOY37flz0g&oe=6AEDF2C5"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bX_fmO6oVwQ7kNvwGd53KY&_nc_oc=AdoJchAl8sPDvTk5UGocAhVbQbPoRVf3VMGUpcBn6lpYutL4q1KzKpCZNQharc3ktXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSxtM_0B76H-iShv0PGPwiXadLr8FcF5sOXbkUwupihw&oe=6AEDFCA6"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Vb4FoJpcwsQ7kNvwEXtL1L&_nc_oc=AdoyOoKg48HL3rsxvpVkUynElgRi1HA4ehRM9q4qPaGYpiIVEcJkQWovhbOLw4z31Bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR15sXNzPxJJuzDiHDWmZ43fKeMFbWBTT6BXphyWZi0oA&oe=6AEDDD39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
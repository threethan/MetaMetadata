oe=6A244726"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiM7ifK_oxkQ7kNvwHUwyt2&_nc_oc=AdrhlOAgBK8hHrzDd0Rd0a76_Nd3a8v7cR1-h_0oboc4fW9eqZRyaw59ISRuGo_X-Xg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Dpnmg-JtmnBmoU0zr58Q8btBq0jTgrBmpS_suTh1uxQ&oe=6A2427B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres"
scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pj358oZ4HK5XQrH_ZTnOE1JmnYUwzohGWcMs09fCVBQ&oe=6A3A94A3"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyYBi0FwyjYQ7kNvwHKKO_p&_nc_oc=AdrCYBdou4_kYkZ0F9kuWDK56lxR7zkv86h9qIWctGib8Yh2QD4aLg9DdO8jK6PYyCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e6pcaU6zfCGErSz41n50rrLqXpn3WYU4BPl9SmlVkuQ&oe=6A3AA6C5"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr9omFf2XpcQ7kNvwH9Xm2o&_nc_oc=AdpdNEpyD-6mGj1Tsg9WMYQq7SUC6AJE2UKr18fP6GHuCuXh4WtaeIC_ro5H8xpj7Hw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Co6VcrfMn5xo4LSLIYrCayV6bLayDZGota_G9WGrukg&oe=6A3AB0A6"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szczz7sFzJoQ7kNvwFwcYEP&_nc_oc=Adpy6ygB9mn0XttpdfovhhaCaF1bGzraqbt7RL5sFJS3oxBlaIY-xX40RH68gv9-s4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bvy6r2xmBVnKC3JdXIo4sSQpHZCDTeYzkTdCzo6xcNQ&oe=6A3A9139"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "783066696356143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295751_952423296149544_6248543502049458911_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKe0dlbwYGgQ7kNvwHv5ipc&_nc_oc=AdrGeYuH3AaGF10EAwxV7bv79kDWNXtibrCPMsM-19-IUUbkxx7MclEK1EH_pl3w0Q0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8khknuGudGIaj3CmU05KesY9DPXIKNSPIiKYEUdchRcw&oe=6A3AA2D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Me
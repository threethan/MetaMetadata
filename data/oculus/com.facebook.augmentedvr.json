95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IU7IuWzFckQ7kNvwHNdyzR&_nc_oc=Adp3KC6aJwroa_4RWie6ISO0lb6cP0gN5ZrplI1XZCKHahwcu0ugZOpTRaXz6BQDDxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtc6aDumbl7he8HPksNfeQhc2UIq_SoopvjGFsC_NGcw&oe=6AE4B051"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfExDCjZrcsQ7kNvwHiXlmH&_nc_oc=Adr6NyCjTWHdQSpcgYpO7VrAjEz8xJZijvJYMFzcy36OngK7qISatX1EFCd3kOxdAWM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWEls3qUHZcoTU9RXBEwqvWAK01PHFsBjxGLQpydAc0w&oe=6AE4A623"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moytAxmsAOsQ7kNvwH7hCQU&_nc_oc=AdqaehefNClsp0A6DBOV9K3WCmbrgjHMffxM3dvaeFqlFqCNwUvAD99lwt95ZEHBOx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOspfNijwAro0L97ltF8eMXUj-Zow_MSPntIBTU7czw0g&oe=6AE4B845"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0zQKaFWx7AQ7kNvwGdstz_&_nc_oc=Adqtds829jHypQ4yDEBkOf9WITSW_EDbuFtCHsv9vfAqBrHfbfOxvreYnscrYVThWZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo4si6Cp0I_7nxwEsEtsmdgT3f4m5w3CtV2TsHnaURzw&oe=6AE4C226"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqOmndbceCIQ7kNvwGD6T6u&_nc_oc=AdrWY9BRtg3gDrx501b67PgFRRVK1u05pyCjGfh7BQPCi3EaJTEmYtO0wwq9yRNTaDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLKSpK3_suqr_GzY5FdZrE3T-XDvfk9YqsjaaFQuBWMg&oe=6AE4A2B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r7On7kwvVHKBKsU8DzV97OCsKKXdsc1P0t-vmvOsqUQ&oe=6A3BE623"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyYBi0FwyjYQ7kNvwH3dJgy&_nc_oc=Adq-QroGJGhSqZgkBBJhjyRKWqS2RF4qC2wS7SktkQUm9M3Ys3fagCC4Dqe8mVQvbak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Mvz9mVcmpq2S1nsohcJPZ779EXXI4E7FkZvPxZyuu0A&oe=6A3BF845"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjq3EOtNLVMQ7kNvwHc_gJ8&_nc_oc=AdoTee46e8wQIYt2Pf_TQodtl6Z-WZr_kJXYvm6zBmM-V8l9R-KCs7hYtodQGmLQdTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OPI3V_NAHxIBJphQ-Hm2WxjG_YrN2r0q5pk6I_R05Lw&oe=6A3BC9E6"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c55VOaPIQuEQ7kNvwFShprS&_nc_oc=AdobpmdB9GLBCjZXg-PcsULaT2-mWEgM-zBWS5g-vux6DTBZrNJItjjI5_PAy1ffVsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90tTupqjWqlTminUUX_-00e3CcHvmGT8jKR-x8KDUkbg&oe=6A3BE2B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "783066696356143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_952423296149544_6248543502049458911_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbQd2idEiMgQ7kNvwHXh1L5&_nc_oc=AdrVd5eWo9r2SQ7afwDGJ5HA6PBuVQCczIyYaAaYVf4Fl29GWU1FqHID28Dxo6UR2sk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lcJ_Z98GDkla1Cb743c5R7N6IEK1RcbNuf_JRELKBIw&oe=6A3BF456"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Me
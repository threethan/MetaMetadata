95859592104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecyL2dAAQ0sQ7kNvwGoMet7&_nc_oc=AdqE6jm3k6bnwMbd7B9Q2R58Dwivwb4RsvMlT_TYNzMyDcTgHQQvX1r-d2ikLz6XYOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIaZOmlFfJpGeKUYZ1kCLRqgmSuXzexV_dPZh49IF5Ug&oe=6AE75351"}, {"file_name": "02_Meta_spark_ar_player.png", "id": "619647519647179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221314_619647522980512_7164856577200147710_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfExDCjZrcsQ7kNvwEgp90L&_nc_oc=Adqyv297C3EBHcLhiGOw_3afdYp6RcstYab7ZvIt1qyAWduHFs-hoJKgyrYwYAYdX3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjsoeG1FaFh87pbUGkU3b6jjtcZU07mRxl2Lf80CVfjA&oe=6AE74923"}, {"file_name": "03_Meta_spark_ar_player.png", "id": "662141478759999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75416838_662141482093332_4013439942271365489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nP8rzMX3WAQ7kNvwFAR2L9&_nc_oc=AdqKXFXOp0WjoJ0dMON0I1UgMsgSFVT5FSm_e3vUS6aZHY4SZTBzhnO5-kuZYUAGjoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDT0epeArDx4r5d_ZtkR5PJzvfIX-ttHG1-mWrSznKrQ&oe=6AE75B45"}, {"file_name": "04_Meta_spark_ar_player.png", "id": "615660286962606", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031327_615660290295939_4208192044245677522_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edTduv3UYE0Q7kNvwGUALn6&_nc_oc=Adpnqk1hSKsdbd0hs3-XfVHwyNXgJ8F1Zi-U4sopv6D5y7DblS0cDB4Z8AzVlBb8fzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYxpCstPlVSHWrQ2ZG6kOuo9DSGibkevlOI1V83gvmqA&oe=6AE76526"}, {"file_name": "05_Meta_spark_ar_player.png", "id": "398227562497805", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210893_398227565831138_8716680436825151186_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpWPHog7xXYQ7kNvwGuoTG6&_nc_oc=Adol_puZuzeIInwTfsk4f4hv8Kl8Rnjhocwjqy8i6o6FMmU-eyq4z-WAEx0qqM2SH9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4vwuxvrlp9e018HIw_3n2ICCAGljqoyNKyk-7Ciwoow&oe=6AE745B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Spark Player", "keywords": ["spark", "ar"], "long_description": "Meta Spark Player is a testing ground for virtual objects, a type of interactive, world-facing AR experience. Use the app to interact with ready-made demo objects or send your own virtual objects directly from Meta Spark Studio. \n\n- Connect to Meta Spark Studio and send virtual objects directly to the app. \n- Take a tutorial to understand how to control virtual objects with your Meta Quest device controllers.\n- Manipulate virtual object position, scale and rotation.  \n- Test inputs to see virtual objects in different states.\n- Use demo objects to explore what\u2019s possible. ", "short_description": "Use Meta Spark Player to see your virtual objects come to life.\n\nThe virtual objects you create in Meta Spark Studio can be sent directly to Meta Spark Player. See and interact with your virtual objects in your surroundings using Passthrough on your Meta Quest device.  "}]}, "developer_name": "Meta Platforms, Inc", "developer_privacy_policy_url": "https://www.facebook.com/about/privacy", "developer_terms_of_service_url": "https://sparkar.facebook.com/ar-studio/terms/", "publisher_name": "Meta Platforms, Inc", "support_website_url": null, "website_url": "https://sparkar.facebook.com/ar-studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tra
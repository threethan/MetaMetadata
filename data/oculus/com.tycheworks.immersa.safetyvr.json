FJBaCU&_nc_oc=AdowOGZTi8H2Z94TCjSOwaIRYA2N117j8Rb8WQ387npcnliI_L65UY-MfrkqFkKDT_w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0fBP1fUnpjch134el-Ym0TcrwlOLpG9q8cwrhRyB_Sg&oe=6AFC67FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metahorizon_title_v2_2560x1440.png", "id": "1856158878698338", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593815290_1856158882031671_1517083794079399891_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSawhusex_gQ7kNvwHaeta5&_nc_oc=AdpXVgCclpRaQROihpBfrPFLQmKsgCZAYMZuYQBAbguJ1hr26GAnPfhRJYHb0BkC1AE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7P3Ff5u-vLpWGx4CdR2iUYV4Yj_JbDgkkKvgJuLKTSQ&oe=6AFC81F0"}, "display_name": "\ud654\ud559\ubb3c\uc9c8 \uc548\uc804\ud6c8\ub828 VR", "keywords": ["safety", "PPE", "\uac1c\uc778\ubcf4\ud638\uad6c", "\uc548\uc804\uad50\uc721", "VR\ud6c8\ub828"], "long_description": "\ud654\ud559\ubb3c\uc9c8 \uc548\uc804\uad50\uc721 VR\uc740 \ud654\ud559\ubb3c\uc9c8 \ucde8\uae09 \ud604\uc7a5\uc5d0 \ub4e4\uc5b4\uac00\uae30 \uc804, \uac1c\uc778\ubcf4\ud638\uad6c(PPE)\ub97c \uc62c\ubc14\ub974\uac8c \uc810\uac80\ud558\uace0 \uc120\ud0dd\ud574 \ucc29\uc6a9\ud558\ub294 1\uc778\uc6a9 \uc2e4\uc2b5\ud615 VR \uc548\uc804\uad50\uc721\uc785\ub2c8\ub2e4. \ubcf8 \uc571\uc740 \ud55c\uad6d\uc5b4\ub9cc \uc9c0\uc6d0\ud569\ub2c8\ub2e4.\n\n\ub450 \uac00\uc9c0 \uc2dc\ub098\ub9ac\uc624\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n  - \ubc00\ud3d0\uacf5\uac04 \uc9c4\uc785 \uc804 PPE\n  - \ud654\ud559\ubb3c\uc9c8 \ub204\ucd9c \ub300\uc751 PPE\n\n\ubc29\ud638\ubcf5, \uc548\uc804\ubaa8, \ud638\ud761\ubcf4\ud638\uad6c, \uc7a5\uac11, \uc7a5\ud654, \uc548\uc804\ub300, \ud654\ud559\ubcf4\uc548\uacbd\uacfc \uc548\uba74\ubcf4\ud638\uad6c \ub4f1\uc744 \uc9c1\uc811 \uc7a1\uc544 \uc0c1\ud0dc\ub97c \ud655\uc778\ud558\uace0 \ucc29\uc6a9\ud569\ub2c8\ub2e4. \n\uc815\uc0c1\ud488\uacfc \uc624\uc5fc\ub418\uac70\ub098 \ud558\uc790\uac00 \uc788\ub294 \uc7a5\ube44\uac00 \ud568\uaed8 \ubc30\uce58\ub418\uc5b4 \uc788\uc5b4 \uc791\uc5c5 \uc0c1\ud669\uc5d0 \ub9de\ub294 \ubcf4\ud638\uad6c\ub97c \uc2a4\uc2a4\ub85c \ud310\ub2e8\ud574\uc57c \ud569\ub2c8\ub2e4.\n\n\ud559\uc2b5 \ubc29\uc2dd\uc740 \uc138 \uac00\uc9c0\uc785\ub2c8\ub2e4.\n\n  - \uad50\uc721: \ud55c\uad6d\uc5b4 \uc74c\uc131 \uc548\ub0b4\uc640 \ub2e8\uacc4\ubcc4 \uc124\uba85\uc744 \ub530\ub77c \uc810\uac80\u00b7\ucc29\uc6a9 \uc21c\uc11c\ub97c \uc775\ud799\ub2c8\ub2e4.\n  - \ud6c8\ub828: \ucd5c\uc18c\ud55c\uc758 \ubbf8\uc158 \uc548\ub0b4\ub85c \uc9c4\ud589\ud558\uba70 \uc798\ubabb \uc120\ud0dd\ud558\uba74 \ub2e4\uc2dc \uc2dc\ub3c4\ud569\ub2c8\ub2e4.\n  - \ud14c\uc2a4\ud2b8: \ud78c\ud2b8 \uc5c6\uc774 \uc218\ud589\ud55c \ub4a4 \uc18c\uc694 \uc2dc\uac04, \ud034\uc988 \uc810\uc218\uc640 PPE \uc624\uc120\ud0dd \uacb0\uacfc\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.\n\nTouch \ub610\ub294 Touch Plus \ucee8\ud2b8\ub864\ub7ec\ub85c \ubcf4\ud638\uad6c\ub97c \uc7a1\uace0 \ud154\ub808\ud3ec\ud2b8 \ubc29\uc2dd\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. \n\ucc29\uc6a9 \uacb0\uacfc\ub294 \uac70\uc6b8\uc5d0\uc11c \ud655\uc778\ud558\uace0 \ub9c8\uc9c0\ub9c9 \ud034\uc988\ub85c \ud575\uc2ec \uc548\uc804 \ud310\ub2e8\uc744 \uc810\uac80\ud569\ub2c8\ub2e4.\n\n* \ubcf8 \ucf58\ud150\uce20\ub294 \uccb4\ud5d8\ud615 \uc548\uc804\uad50\uc721 \uc2dc\ubbac\ub808\uc774\uc158\uc774\uba70 \ubc95\uc815 \uc790\uaca9\uad50\uc721, \ud604\uc7a5\ubcc4 \uc548\uc804 \uc808\ucc28, \uc704\ud5d8\uc131 \ud3c9\uac00 \ub610\ub294 \uc2e4\uc81c \uc791\uc5c5 \ud5c8\uac00\ub97c \ub300\uccb4\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.", "short_description": "\ud604\uc7ac \ud55c\uad6d\uc5b4\ub9cc \uc9c0\uc6d0\ub429\ub2c8\ub2e4. (only KOREAN) \n\n\ud654\ud559\ubb3c\uc9c8 \ucde8\uae09 \ud604\uc7a5\uc5d0 \ub4e4\uc5b4\uac00\uae30 \uc804, \uac1c\uc778\ubcf4\ud638\uad6c(PPE)\ub97c \uc9c1\uc811 \uc810\uac80\ud558\uace0 \uc120\ud0dd\ud574 \uc62c\ubc14\ub978 \uc21c\uc11c\ub85c \ucc29\uc6a9\ud558\ub294  VR \uc548\uc804\uad50\uc721\uc785\ub2c8\ub2e4. \n\ubc00\ud3d0\uacf5\uac04 \uc9c4\uc785 \uc804 PPE\uc640 \ud654\ud559\ubb3c\uc9c8 \ub204\ucd9c \ub300\uc751 PPE \ub450 \uc2dc\ub098\ub9ac\uc624\ub97c \uad50\uc721\u00b7\ud6c8\ub828\u00b7\ud14c\uc2a4\ud2b8 \uc138 \ubaa8\ub4dc\ub85c \uc5f0\uc2b5\ud558\uace0, \uc624\uc5fc\u00b7\ud558\uc790\ud488 \ud310\ubcc4\uacfc \ud034\uc988\ub85c \uacb0\uacfc\ub97c \ud655\uc778\ud569\ub2c8\ub2e4."}]}, "developer_name": "Tyche works", "developer_privacy_policy_url": "https://softcastella.github.io/tycheworks-safetytrainingvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche works", "support_website_url": null, "website_url": "https://immersa.tycheworks.com/chemical-safety-training", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1400989156430074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620414_989938404110669_3741349036008242070_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TotfsqJEtrUQ7kNvwH2sQPR&_nc_oc=Adr3uDe1UcVWMN3nSid8sc2wEWhVI3m8bQnxi-cK3kRFYSnOgMWW1Dmc_P2Er9hW_Zs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRc4R_3MjdAUSNPi0uclFghmhgURyjNiLCV4sihT47fQ&oe=6AFC780A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chemical Safety training VR", "platform": "ANDROID_6DOF", "cont
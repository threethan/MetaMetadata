": [{"file_name": "2_2_metahorizon_screenshot_1_2560x1440.png", "id": "1083709534134942", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620414_1083709537468275_2441649278228338624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMI_A7EG6UIQ7kNvwFM0Ni8&_nc_oc=Adp4wrt1cR7LcJU842D5eD81BZCXkfWESOfE5NnhJbQ1avInbvhHN_Cxh4J_IhpQ76c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkDcY5RK6qXRhpJYLlfHRXWH1YF-WETYlqRM6ajYyZfQ&oe=6AE769A0"}, {"file_name": "2_3_metahorizon_screenshot_2_2560x1440 (1).png", "id": "26191675467196116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628456_26191675487196114_1596314658694087447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vHlaeFHryUQ7kNvwG0_cfK&_nc_oc=AdrSzpCuP6WzVupP_0Z0DIGm6tnHOKhgXnwkm6FD4M6zTGepllol72ZSozJMOjbVy-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR_0tY2z-S6LAoIVvIJpFz7ZHwoKhvZLSUulmUeVXnZg&oe=6AE76335"}, {"file_name": "safety_training_vr_1_2560x1440_v2.png", "id": "1853300652322154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_1853300658988820_6983748852199597292_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcIwqpgBl58Q7kNvwG_6IR_&_nc_oc=AdrnE26dID2QwvwQbS8B8Jp2P1d4CIFGgbugzm8wrIDyJJx9VoaiMwUBVTdJFrXrmcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCAJoxKFE0MmgQ3P8lAvPYZsm2BbNV7FZy3Eswb6qDuA&oe=6AE740A5"}, {"file_name": "2_4_metahorizon_screenshot_3_2560x1440 (1).png", "id": "918117044280005", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623565_918117047613338_5091628188827766506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd9v5_lWY84Q7kNvwHXzRdV&_nc_oc=Adr0ycKvtz7zxXEJZ1FmLhBkn8NY-H_ZXOyT4Xy7bRS17GZFF3f4BUdTyr1vqeu2YSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdxWG-guCm3BLZzxLUJVEJSUFr38Pzc1Y0LWaKlWp-8A&oe=6AE73AF6"}, {"file_name": "2_5_metahorizon_screenshot_4_2560x1440 (1).png", "id": "4635492616725408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619602_4635492620058741_766692454696963882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY51THiXhLwQ7kNvwFdCxCk&_nc_oc=AdqD8cLybIHbtU-r-dFRjf2CCBAB7OuOmGgw5bIbn4-rNFmXLg_ZV-rz_3CtT1qGsP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_IHro8AWw5aWgktufRzjIvcai5ILEZKPzF9Cw_3DRAQ&oe=6AE758EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metahorizon_title_v2_2560x1440.png", "id": "981548534977923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622184_981548538311256_7685533152200964089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNgdzlf2dZwQ7kNvwHgspfh&_nc_oc=AdpOPHNT-E7p0CXmsq4tNkr5bIQf1tkoBK7PG1Fkuauynop22tRwnEkDfOQyh8mzS0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnDSH-FIRWgUCI6cOJ213p4rfX91ots3Ooko-piIgSbw&oe=6AE76D68"}, "display_name": "Chemical Safety training VR", "keywords": ["PPE", "ChemicalSafety", "VRTraining", "Safety", "Chemical"], "long_description": "Chemical Safety Training VR is a hands-on, single-user VR safety training program designed to help users properly inspect, select, and wear personal protective equipment (PPE) before entering a chemical handling site. This app supports Korean only.\n\nIt offers two scenarios:\n  - PPE before entering a confined space\n  - PPE for responding to a chemical spill\n\nUsers physically handle protective suits, hard hats, respiratory protection, gloves, boots, safety harnesses, chemical-resistant goggles, and face shields to check their condition and put them on. Since both undamaged and contaminated or defective equipment are displayed together, users must independently determine which protective gear is appropriate for the work situation.\n\nThere are three learning modes:\n  - Education: Follow Korean voice prompts and step-by-step instructions to learn the inspection and donning procedures.\n  - Training: Proceed with minimal mission guidance; if you make a wrong choice, you must retry.\n  - Test: Complete the task without hints, then review your completion time, quiz score, and any incorrect PPE selections.\n\nUse the Touch or Touch Plus controller to pick up the protective gear and move via teleportation. \nCheck the results of your gear fit in the mirror, and review key safety decisions in the final quiz.\n\nThis content is an experiential safety training simulation and does not replace mandatory certification training, site-specific safety procedures, risk assessments, or actual work permit", "short_description": " This VR safety training program allows participants to personally inspect and select personal protective equipment (PPE) and put it on in the correct order before entering a chemical handling site. \nParticipants practice two scenarios\u2014PPE for entering confined spaces and PPE for responding to chemical leaks\u2014in three modes (education, training, and testing), and verify their results through contamination and defective product identification exercises and quizzes.\nCurrently, only KOREAN supported"}]}, "developer_name": "Tyche works", "developer_privacy_policy_url": "https://softcastella.github.io/tycheworks-safetytrainingvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche works", "support_website_url": null, "website_url": "https://immersa.tycheworks.com/chemical-safety-training", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SI
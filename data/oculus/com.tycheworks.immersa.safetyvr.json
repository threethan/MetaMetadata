jsRN7EfJjaG0GkkyA9N7qVXcpDD24U8Um7gs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVkTssPHXiEkIY1m68yF_-VGAPbyWI7E4syFxUhsVrcw&oe=6B0B43F6"}, {"file_name": "2_5_metahorizon_screenshot_4_2560x1440 (1).png", "id": "4635492616725408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619602_4635492620058741_766692454696963882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AKlDLMylCUQ7kNvwFGqhwl&_nc_oc=AdrMbk0C3kod1AvbcoQzw14xNSDoActIRnyw1m_Zn--0dGy43wfqiB8e2gr3lE-jpu4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSD7rSCb6jqnb8NdEw0ZDQwqxD2Gty1DJTMM7WLqOtq7g&oe=6B0B29AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metahorizon_title_v2_2560x1440.png", "id": "981548534977923", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622184_981548538311256_7685533152200964089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw5qLobUWn4Q7kNvwHgBeWY&_nc_oc=AdrI9a6YxYDHUo3QyqtYIIXXZB0vIUSsQtW-OpGOsFQ21bwBm-Pow8OBSrME9Xgi3kI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8wYh9MTDPwD-qd5IeTR6-tmLgtb498lsg78fVcQDZqA&oe=6B0B3E28"}, "display_name": "Chemical Safety training VR", "keywords": ["PPE", "ChemicalSafety", "VRTraining", "Safety", "Chemical"], "long_description": "KOREAN ONLY\nAll training instructions, audio, and work documents are currently provided in Korean. English support is planned; a release date has not been set. Tell us your preferred language in a review to help us prioritize future support.\n\nChemical Safety Training VR is a hands-on, single-user simulation for inspecting, selecting, and putting on personal protective equipment (PPE).\n\nScenarios:\n- PPE for confined-space entry\n- PPE for chemical spill response\n\nHandle protective suits, helmets, respirators, gloves, boots, safety harnesses, chemical goggles, and face shields. Identify contaminated or defective equipment and choose suitable PPE.\n\nLearning modes:\n- Education: Learn inspection and donning procedures with Korean voice prompts and step-by-step instructions.\n- Training: Practice with minimal guidance and retry incorrect choices.\n- Test: Complete tasks without hints, then review your time, quiz score, and incorrect PPE selections.\n\nUse Touch or Touch Plus controllers to pick up equipment and teleport. Check your appearance in the mirror and review key safety decisions in the final quiz.\n\nWe are aware of stability issues and plan an update to improve stability.\n\nThis simulation does not replace mandatory certification training, site-specific safety procedures, risk assessments, or actual work permits.", "short_description": "KOREAN ONLY: All training instructions, audio, and work documents are in Korean.\n\nInspect, select, and put on personal protective equipment (PPE) in the correct order for confined-space entry and chemical spill response. Practice in Education, Training, and Test modes, identify contaminated or defective equipment, and review your results through quizzes."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "2505093480014019", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623115_2505093500014017_3842055484903606712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePzXf-BRiEsQ7kNvwHiGOV7&_nc_oc=Adru-zU0AXCNhKSdNljWtrJr-BIRnCqMXVIqozsvoiScPYQWp_TK8gi-7wYQWMAublI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQ2RuF3_n5L_S1-2aAW0ZApQf_0B57dQ7CNo10AaBICw&oe=6B0B43BC"}, {"file_name": "metahorizon_hero_v3.png", "id": "2277980306327051", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623131_2277980309660384_4768469568517676093_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXgdnta-q48Q7kNvwFAKENQ&_nc_oc=Adr6sSgzJ12AuNHdiY9uvBOdgl_xZn59Rm8iUhmgrOZQ9Z2Jsf_xoo3I0Wd20EpPTiU&
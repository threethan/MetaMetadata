3xxsirBn0-FNPvHJx8SxHp3lpoQ04Aurou-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb469RyJr4i6bPhWaCLSKSvh-HAfplI90bdzOM6SFTdw&oe=6B047436"}, {"file_name": "2_5_metahorizon_screenshot_4_2560x1440 (1).png", "id": "4635492616725408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619602_4635492620058741_766692454696963882_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk6xnyyf748Q7kNvwEzYCn3&_nc_oc=AdqGb1Qpo7UgoXkXHspLGanKDmkvWkxJ0w47QVLgJSqZ_RJKJ60QUYCS-7rwqRsofR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8NhglCLLvEjOF1_RITImpZuebOwLpviXMkrSBbKy6Ag&oe=6B0459EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metahorizon_title_v2_2560x1440.png", "id": "981548534977923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622184_981548538311256_7685533152200964089_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDn-M659Ul4Q7kNvwGptpIt&_nc_oc=Ado1c2HyFBQ3ZYXZOYR7xVxb-ezUhFyNB0rmlX7HcfqM6IfVRSUt1AlYO3numeiDnyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCbF3FiSWNP6KOf-HvM8QdtSPBuqTiMv5BWc1znbslQQ&oe=6B046E68"}, "display_name": "Chemical Safety training VR", "keywords": ["PPE", "ChemicalSafety", "VRTraining", "Safety", "Chemical"], "long_description": "KOREAN ONLY\nAll training instructions, audio, and work documents are currently provided in Korean. English support is planned; a release date has not been set. Tell us your preferred language in a review to help us prioritize future support.\n\nChemical Safety Training VR is a hands-on, single-user simulation for inspecting, selecting, and putting on personal protective equipment (PPE).\n\nScenarios:\n- PPE for confined-space entry\n- PPE for chemical spill response\n\nHandle protective suits, helmets, respirators, gloves, boots, safety harnesses, chemical goggles, and face shields. Identify contaminated or defective equipment and choose suitable PPE.\n\nLearning modes:\n- Education: Learn inspection and donning procedures with Korean voice prompts and step-by-step instructions.\n- Training: Practice with minimal guidance and retry incorrect choices.\n- Test: Complete tasks without hints, then review your time, quiz score, and incorrect PPE selections.\n\nUse Touch or Touch Plus controllers to pick up equipment and teleport. Check your appearance in the mirror and review key safety decisions in the final quiz.\n\nWe are aware of stability issues and plan an update to improve stability.\n\nThis simulation does not replace mandatory certification training, site-specific safety procedures, risk assessments, or actual work permits.", "short_description": "KOREAN ONLY: All training instructions, audio, and work documents are in Korean.\n\nInspect, select, and put on personal protective equipment (PPE) in the correct order for confined-space entry and chemical spill response. Practice in Education, Training, and Test modes, identify contaminated or defective equipment, and review your results through quizzes."}, {"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "2505093480014019", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623115_2505093500014017_3842055484903606712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsCiIrCaBN8Q7kNvwEXK2kO&_nc_oc=Adop4eJqb_efq042A-HLzz2mv7FdEcVTRsyLTIF7_XiWuNXx00xjRKHbKDCo85CZx3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyEMwQFsgeyIPlvPQNNf45L5Wn_SJCTIr0LLdUQXZ89w&oe=6B0473FC"}, {"file_name": "metahorizon_hero_v3.png", "id": "2277980306327051", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_2277980309660384_4768469568517676093_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhfrKS11pR4Q7kNvwFuxoF5&_nc_oc=AdoPI_WwQOT_is6jsiRzd2h0CRy9h1_Daxmo-BfYl9wMnWGJgRyWPPH4tKWapJitcm4&
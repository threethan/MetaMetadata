ng", "id": "26191675467196116", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628456_26191675487196114_1596314658694087447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7bJzyh1KKcQ7kNvwHX2UgY&_nc_oc=AdqWjDOFMTkCSw9yCF4xOPJEmECTe87AGIL3R1y-5-okzBRqjfS_uqTp03aMecJwJE8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn2985XHf4nkmfAovXc444EXPbFuWa4_sgabx6aqVVtA&oe=6AC910B5"}, {"file_name": "safety_training_vr_1_2560x1440_v2.png", "id": "1853300652322154", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623131_1853300658988820_6983748852199597292_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUCGCko9Cr4Q7kNvwGZDWQZ&_nc_oc=Adpxjg-4xINzXgzn205OSVqdkyPudt_gt71SbKX_VHEJZp-25ud6Ao1YJy4-tXWV_7Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4m5GW71P1moMahE_zO3G9PE1eZVoCIRrsqeFxTCVi9w&oe=6AC8EE25"}, {"file_name": "2_4_metahorizon_screenshot_3_2560x1440 (1).png", "id": "918117044280005", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623565_918117047613338_5091628188827766506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EreocT9OscsQ7kNvwHQI6d8&_nc_oc=AdrVKCpm5Mbm_mplzhWXa8ehjUkFxDc0Kj1FUUBDcpXX1lhRr6X8EMCKAM1JmjCdDPQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsXD3eYoAST4VSsARcRrSP_1EO9F4IRltvUP7Uu-C5fw&oe=6AC8E876"}, {"file_name": "2_5_metahorizon_screenshot_4_2560x1440 (1).png", "id": "4635492616725408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619602_4635492620058741_766692454696963882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FzcvGL4wSoQ7kNvwGmoQjT&_nc_oc=AdrhuE2SJr88e6KxFoK3Edt_Pvk7vqw6CtvV1_zs4HiUM26Wp2Oe_EQRC9FldUwFhG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfo9Npk1CzYKkWzl7IArz6VX21lCkUF9tl-JjH9q5CMA&oe=6AC9066C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metahorizon_title_v2_2560x1440.png", "id": "981548534977923", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622184_981548538311256_7685533152200964089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX9wb3OntGcQ7kNvwG-BZZS&_nc_oc=AdqLbX7Uq8dyOmthmEIVegWryS6fazv5CD6iRetWD9V3NA_Ijr9A4fZ5p8pofWJM6PU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo0VJn2MxLUSvTh3fb48TTfZ5yVJiKinVSUebifotvYA&oe=6AC91AE8"}, "display_name": "Chemical Safety training VR", "keywords": ["PPE", "ChemicalSafety", "VRTraining", "Safety", "Chemical"], "long_description": "Chemical Safety Training VR is a hands-on, single-user VR safety training program designed to help users properly inspect, select, and wear personal protective equipment (PPE) before entering a chemical handling site. This app supports Korean only.\n\nIt offers two scenarios:\n  - PPE before entering a confined space\n  - PPE for responding to a chemical spill\n\nUsers physically handle protective suits, hard hats, respiratory protection, gloves, boots, safety harnesses, chemical-resistant goggles, and face shields to check their condition and put them on. Since both undamaged and contaminated or defective equipment are displayed together, users must independently determine which protective gear is appropriate for the work situation.\n\nThere are three learning modes:\n  - Education: Follow Korean voice prompts and step-by-step instructions to learn the inspection and donning procedures.\n  - Training: Proceed with minimal mission guidance; if you make a wrong choice, you must retry.\n  - Test: Complete the task without hints, then review your completion time, quiz score, and any incorrect PPE selections.\n\nUse the Touch or Touch Plus controller to pick up the protective gear and move via teleportation. \nCheck the results of your gear fit in the mirror, and review key safety decisions in the final quiz.\n\nThis content is an experiential safety training simulation and does not replace mandatory certification training, site-specific safety procedures, risk assessments, or actual work permit", "short_description": " This VR safety training program allows participants to personally inspect and select personal protective equipment (PPE) and put it on in the correct order before entering a chemical handling site. \nParticipants practice two scenarios\u2014PPE for entering confined spaces and PPE for responding to chemical leaks\u2014in three modes (education, training, and testing), and verify their results through contamination and defective product identification exercises and quizzes.\nCurrently, only KOREAN supported"}]}, "developer_name": "Tyche works", "developer_privacy_policy_url": "https://softcastella.github.io/tycheworks-safetytrainingvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche works", "support_website_url": null, "website_url": "https://immersa.tycheworks.com/chemical-safety-training", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1312884738573850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620414_989938404110669_3741349036008242070_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8ay454VZ5YQ7kNvwE4bhnS&_nc_oc=AdoLHv0qi28OpjUwy-_2-ZirgjBBk8YEJJeoZlmGBKxK-hjD5B0HNeFvxhxQMon7ufk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmpsORfY6GVcejuT0eW_hPpTnPCEt96v_DhqDspeslzA&oe=6AC90D8A"}, "is_concept": false, "is_test": false, "
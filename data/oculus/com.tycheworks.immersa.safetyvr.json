ng", "id": "26191675467196116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628456_26191675487196114_1596314658694087447_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz_PhvcWnMQQ7kNvwHfMnzk&_nc_oc=AdrCwoDCrhuJ9N3can5CvSgXLcDNai4iS1dQoxTpR1pYmUwwNg8O0FpQQEcaM8a-Nl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZxU8sm65YWaYryA6hU--s_-sAHQP7NfUl7IGotuqdRw&oe=6AB155B5"}, {"file_name": "safety_training_vr_1_2560x1440_v2.png", "id": "1853300652322154", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623131_1853300658988820_6983748852199597292_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObCqnOSlaZYQ7kNvwFeLE7G&_nc_oc=AdqwV9mVwFQmSiRu1xAIQixO7aCG4KG6gbdvObsCnnSXZuCsNfxoXO9zBji0ysYiH0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLszEEcQK3k0_4TQZg8oIVnM_f586hH80Qi7KQW-MJ2Jw&oe=6AB13325"}, {"file_name": "2_4_metahorizon_screenshot_3_2560x1440 (1).png", "id": "918117044280005", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623565_918117047613338_5091628188827766506_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoJBOxRofKsQ7kNvwEqHqt-&_nc_oc=AdqBm35EZTSFANB4MfChpxjPgjQ7Xi4Xx3mK7a8O0i8PZx2XxqiKRMomfV2t3IFq6Jo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6L3hqyldgAxRS0PTq7pNIhLd3jof2NHXi9nIN5CJhNQ&oe=6AB12D76"}, {"file_name": "2_5_metahorizon_screenshot_4_2560x1440 (1).png", "id": "4635492616725408", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619602_4635492620058741_766692454696963882_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ePPrTwuI1sQ7kNvwExIOnf&_nc_oc=AdoPoHReyvUc5g466l_aH3HkKKp__1AXco_5s8mpOIx-dBmwsZAnU8C4xFP3RSseffs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCjwd8ZowNyKuGgreZUqhJqu0L4YHTWHAKeNNn4E3G-g&oe=6AB14B6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "metahorizon_title_v2_2560x1440.png", "id": "981548534977923", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622184_981548538311256_7685533152200964089_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWhXcoDbIC4Q7kNvwHhkGQa&_nc_oc=AdrXL8PmgoQeWVvyfFajdNSqHa4Y6Sr4HMF7ANy8cU-wOvwJsg6hkjXsZTz1VQWxysY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAoFys3tTRmHP8b3YwF28IUdrfvFbUZGl8u2Aa4p5mFQ&oe=6AB127A8"}, "display_name": "Chemical Safety training VR", "keywords": ["PPE", "ChemicalSafety", "VRTraining", "Safety", "Chemical"], "long_description": "Chemical Safety Training VR is a hands-on, single-user VR safety training program designed to help users properly inspect, select, and wear personal protective equipment (PPE) before entering a chemical handling site. This app supports Korean only.\n\nIt offers two scenarios:\n  - PPE before entering a confined space\n  - PPE for responding to a chemical spill\n\nUsers physically handle protective suits, hard hats, respiratory protection, gloves, boots, safety harnesses, chemical-resistant goggles, and face shields to check their condition and put them on. Since both undamaged and contaminated or defective equipment are displayed together, users must independently determine which protective gear is appropriate for the work situation.\n\nThere are three learning modes:\n  - Education: Follow Korean voice prompts and step-by-step instructions to learn the inspection and donning procedures.\n  - Training: Proceed with minimal mission guidance; if you make a wrong choice, you must retry.\n  - Test: Complete the task without hints, then review your completion time, quiz score, and any incorrect PPE selections.\n\nUse the Touch or Touch Plus controller to pick up the protective gear and move via teleportation. \nCheck the results of your gear fit in the mirror, and review key safety decisions in the final quiz.\n\nThis content is an experiential safety training simulation and does not replace mandatory certification training, site-specific safety procedures, risk assessments, or actual work permit", "short_description": " This VR safety training program allows participants to personally inspect and select personal protective equipment (PPE) and put it on in the correct order before entering a chemical handling site. \nParticipants practice two scenarios\u2014PPE for entering confined spaces and PPE for responding to chemical leaks\u2014in three modes (education, training, and testing), and verify their results through contamination and defective product identification exercises and quizzes.\nCurrently, only KOREAN supported"}]}, "developer_name": "Tyche works", "developer_privacy_policy_url": "https://softcastella.github.io/tycheworks-safetytrainingvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tyche works", "support_website_url": null, "website_url": "https://immersa.tycheworks.com/chemical-safety-training", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1312884738573850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620414_989938404110669_3741349036008242070_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONobW6L1pQYQ7kNvwE3qGf3&_nc_oc=AdrHaRbWQfVUXgWX19XIX1oV79k8Ur6ruAhY5Hdmrqq1HwaLDXf9VVd5zTSNdrMcsv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp7g3rcjKml5B-hhJq0966H_8Z_pcChVOmXf3o4rFGOA&oe=6AB1528A"}, "is_concept": false, "is_test": false, "
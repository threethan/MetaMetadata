eeiZeIYQ&oe=6A3410D8"}, {"file_name": "HighresScreenshot00001.png", "id": "984184114008481", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_984184124008480_6914954123544594438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-WPEr7lltIQ7kNvwEvhh2w&_nc_oc=Adrp1YPAhqZRGSzc41q-VcystpffpIGoQZ5nraK1b4IpDT0SGl2FwPo5Ofrn-BqmI7c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NJ9GLuGXaNlHV8S6BgknI6IoSQp5CBycgIScMx_EomQ&oe=6A33FEBB"}, {"file_name": "HighresScreenshot00004.png", "id": "1664175971182052", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/604328314_1664175974515385_6754779820263262580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQuyb1r0kHAQ7kNvwHYj-dO&_nc_oc=AdpzqsJwd2z7jfWf3t3iHUrHt0nWDx9wPRNvzqqdl1W-TDGE4EBugzWKTdPYh8OYusE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3QcHJuMBJ1inDR5rY6oEA0fCdk-Gye7m9YCWNU7ZZFA&oe=6A33F3FE"}, {"file_name": "HighresScreenshot00003.png", "id": "2980406862295700", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622285_2980406865629033_7800056063099286803_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lAdRD983x4Q7kNvwFCQJfa&_nc_oc=AdpvqtlG8yRDTcJK-B1JtYF4Q9euByfjYwHNH4JG3aOf0x5WyWycaGn_RisCOdvunr4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kzbDXR0SxlVvMUnHWOtl2adCf_tdaXn10-v6vca1HOQ&oe=6A33F904"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Conditioner Maintenance", "keywords": [], "long_description": "Air Conditioner Maintenance is an immersive VR training application developed to simulate real-world AC servicing and maintenance procedures. Through interactive scenarios, learners gain practical experience in inspection, troubleshooting, cleaning, and system handling\u2014helping build confidence and job-ready skills in a safe virtual setting.\n\nThis application is an integral component of the Immerse Learn Air Conditioner Maintenance micro-credential program. It is not a standalone product\u2014only individuals officially enrolled in the program will have access. The VR experience is designed to complement structured learning, allowing users to apply theoretical knowledge through guided, hands-on practice.\n\nIdeal for workforce training and skill development, this application helps bridge the gap between learning and real-world performance using advanced immersive technology.", "short_description": "Air Conditioner Maintenance is a VR training application designed for immersive, hands-on skill development. This app is part of the Immerse Learn Air Conditioner Maintenance micro-credential program. Access is exclusively available to learners enrolled in the program, enabling them to practice real-world maintenance tasks in a safe, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35127387673543625"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619668_1662660051651033_866252238308686590_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apQc1JEU_CIQ7kNvwEdz0gM&_nc_oc=AdpWA
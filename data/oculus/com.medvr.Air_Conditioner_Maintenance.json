=6e7a0a&_nc_ohc=kKnxoCx71wEQ7kNvwFt8GCx&_nc_oc=AdozVEq4Ayac13vdA82EUeCcgZCE4LHJEov4aFpYbsMAuA_xJCdXYBsScJjvVEiDKpo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Pd6uEGvzEJtAx_j5zcxxxeZQJRJ5zn9L6cFw8yzDhg&oe=6AAE9A3B"}, {"file_name": "HighresScreenshot00004.png", "id": "1664175971182052", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/604328314_1664175974515385_6754779820263262580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpV6_gUfs-sQ7kNvwGRJksN&_nc_oc=Adp79ELGQcyW2nO90n7xGWydSsghuIImGmhy0dTRGzm7kIhQgBFYUKoq1NHpSBqrlII&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw9wUHTSVQiPWFRFq7rM3M3vWYrrDdUFxZRRo43lBNag&oe=6AAE8F7E"}, {"file_name": "HighresScreenshot00003.png", "id": "2980406862295700", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622285_2980406865629033_7800056063099286803_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boFjSNVsK2UQ7kNvwFmPHbB&_nc_oc=AdpGtQVavnKXFZe51Cc8C2V2_M1GFx0Lt_deuDv5bQi_cspNSGdCpDfAB8G-lLqLH9Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8-191FtR13y7BjO1mxgzPsFnHP4epQp0Oq0MZRuJXBA&oe=6AAE9484"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Conditioner Maintenance", "keywords": [], "long_description": "Air Conditioner Maintenance is an immersive VR training application developed to simulate real-world AC servicing and maintenance procedures. Through interactive scenarios, learners gain practical experience in inspection, troubleshooting, cleaning, and system handling\u2014helping build confidence and job-ready skills in a safe virtual setting.\n\nThis application is an integral component of the Immerse Learn Air Conditioner Maintenance micro-credential program. It is not a standalone product\u2014only individuals officially enrolled in the program will have access. The VR experience is designed to complement structured learning, allowing users to apply theoretical knowledge through guided, hands-on practice.\n\nIdeal for workforce training and skill development, this application helps bridge the gap between learning and real-world performance using advanced immersive technology.", "short_description": "Air Conditioner Maintenance is a VR training application designed for immersive, hands-on skill development. This app is part of the Immerse Learn Air Conditioner Maintenance micro-credential program. Access is exclusively available to learners enrolled in the program, enabling them to practice real-world maintenance tasks in a safe, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35127387673543625"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1729144165133264"}]}, "baseline_offer": {"id": "1729144165133264"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779175560, "status": "PUBLISHED", "id": "1729144165133264"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35604100839205637", "version": "1.3"}, "id": "1700553400938181", "channel_name": "LIVE"}]}
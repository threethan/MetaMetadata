uluscdn.com/v/t64.5771-25/499618102_984184124008480_6914954123544594438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejA0Z4UNAQ8Q7kNvwG-Ox9G&_nc_oc=Adpjdbj70Xkmz7C6Tg4G406fDC5mKDzlAeQ33ThDlCkdKtxajeK2v54uKHhEztgnaag&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkvWbsLpPUeino6Vx_cYJpB57nwO6Stp_8h9GMnTJ1PA&oe=6AC503BB"}, {"file_name": "HighresScreenshot00004.png", "id": "1664175971182052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604328314_1664175974515385_6754779820263262580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfCDMcek9vMQ7kNvwFiQqX1&_nc_oc=Adq6v7HpT74kkFiTgHn-Zvm89KwGjLn-d_fR_2Fjb0W0dgBADCBFBb9IXH7eMvMvyY0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4NPZLMpV41nbomH9JaDeJTdZjpHQma-vJ5gess7eu5g&oe=6AC4F8FE"}, {"file_name": "HighresScreenshot00003.png", "id": "2980406862295700", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622285_2980406865629033_7800056063099286803_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wv2Ye78u6UQ7kNvwE5TgFR&_nc_oc=AdryWtNeR04OZTVXMxGmxxYTUWMbueHjXEIsfA6cjCOgZOLBRsphgZpaRsU2uI0N26I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9VbZHMdGBeqY5slV3BTUKiPgtm3PpqgKpqS71HYbkdQ&oe=6AC4FE04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Conditioner Maintenance", "keywords": [], "long_description": "Air Conditioner Maintenance is an immersive VR training application developed to simulate real-world AC servicing and maintenance procedures. Through interactive scenarios, learners gain practical experience in inspection, troubleshooting, cleaning, and system handling\u2014helping build confidence and job-ready skills in a safe virtual setting.\n\nThis application is an integral component of the Immerse Learn Air Conditioner Maintenance micro-credential program. It is not a standalone product\u2014only individuals officially enrolled in the program will have access. The VR experience is designed to complement structured learning, allowing users to apply theoretical knowledge through guided, hands-on practice.\n\nIdeal for workforce training and skill development, this application helps bridge the gap between learning and real-world performance using advanced immersive technology.", "short_description": "Air Conditioner Maintenance is a VR training application designed for immersive, hands-on skill development. This app is part of the Immerse Learn Air Conditioner Maintenance micro-credential program. Access is exclusively available to learners enrolled in the program, enabling them to practice real-world maintenance tasks in a safe, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35127387673543625"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1729144165133264"}]}, "baseline_offer": {"id": "1729144165133264"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779175560, "status": "PUBLISHED", "id": "1729144165133264"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
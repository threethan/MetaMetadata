cMrk3WxGMkoj1REP0nJ6ex7-M-0Ny7OJA&oe=6A18447E"}, {"file_name": "HighresScreenshot00003.png", "id": "2980406862295700", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_2980406865629033_7800056063099286803_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0koxeSe7HsQ7kNvwF9MWTc&_nc_oc=Adq8YeD_ubIOnrVzMLe46a47HrvmTSSoc6f89kqMTfSW1Ip4xqpHppm0UeedAb9-WSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58h6hswMDAup13hvBzS9uydgN1OxLpgUj99zVJzqKPLw&oe=6A184984"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Conditioner Maintenance", "keywords": [], "long_description": "Air Conditioner Maintenance is an immersive VR training application developed to simulate real-world AC servicing and maintenance procedures. Through interactive scenarios, learners gain practical experience in inspection, troubleshooting, cleaning, and system handling\u2014helping build confidence and job-ready skills in a safe virtual setting.\n\nThis application is an integral component of the Immerse Learn Air Conditioner Maintenance micro-credential program. It is not a standalone product\u2014only individuals officially enrolled in the program will have access. The VR experience is designed to complement structured learning, allowing users to apply theoretical knowledge through guided, hands-on practice.\n\nIdeal for workforce training and skill development, this application helps bridge the gap between learning and real-world performance using advanced immersive technology.", "short_description": "Air Conditioner Maintenance is a VR training application designed for immersive, hands-on skill development. This app is part of the Immerse Learn Air Conditioner Maintenance micro-credential program. Access is exclusively available to learners enrolled in the program, enabling them to practice real-world maintenance tasks in a safe, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://i
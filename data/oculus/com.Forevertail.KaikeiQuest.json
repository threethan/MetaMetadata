5460_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPTviKStAakQ7kNvwH2-29u&_nc_oc=AdoONHNt37Qh33OkvmXF9_H6K-n25v3lkaJ848gW57dSCnmiXK4dzVQJNc-VB6kv8fs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE6nLcAjziqexV7BK_Q0AdGX3_TXvhNG9YgSr0kQuVaw&oe=6A9AC77B"}, {"file_name": "Drama_1.png", "id": "1081009286627224", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984474_1081009289960557_6090390529264337564_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmpsqXg31dAQ7kNvwHz8OO9&_nc_oc=AdpDNKW0xCib2VMPWd9EFsUqp_RFI1ULx3qkn7lfKAJCUsmbxC067Auhm7g6UhE2CK0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-vHi5aQ_76Lwu9ZfCCXbpDIY6vKMb4uMrOZKxBv76Lg&oe=6A9AC30F"}, {"file_name": "Sorting.png", "id": "535186151929828", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974575_535186155263161_5266481990815003196_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKbrHo5KmnMQ7kNvwE3yRp5&_nc_oc=AdoKOg7EDcSLsmi7R8_ig4RkD86OOXa1I0Qf8IacX6aLdQeVOLzfwo1Uj8ZNRTuBvvo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEoINj6z8CMdFThpHxlWmF53IgpabS-CKWkHAWeK_gaQ&oe=6A9AE2DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Accounting Adventure", "keywords": [], "long_description": "Travel back in time to 15th century Italy, where bookkeeping was invented. Raise money and buy pepper in India. Sell it back in Italy and you'll be a millionaire.\n\nThrough a series of adventures, you will experience a simulated business and acquire the relevant accounting knowledge.\n\nSuitable for beginners and relearners:\n  - Business managers who need to be able to read at least a balance sheet and income statement.\n  - Freelancers who leave their tax returns to tax accountants\n  - System engineers\n  - Students\n\nLearning objectives:\n  - Acquire important and basic journal entries.\n  - Students will be able to understand the structure of balance sheets and income statements and their basic meanings.\n\nWhat you will learn in Accounting Quest: 1.\n1. understand the structure of the balance sheet\n2. understand the structure of the income statement\n3. understand the relationship between the balance sheet and the income statement\n4. to understand how to write journal entries, which are accounting records of transactions\n5. to understand how to make journal entries\n6. compile records (journal entries) and prepare financial statements", "short_description": "Go on an adventure, and learn basic accounting!\nYou are transported back in time to the Age of Discovery. You will experience a simulated series of business activities such as fundraising, purchasing, and sales, and learn accounting while having an adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.accounting-adventure.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Forevertail Co Ltd", "support_website_url": null, "website_url": "https://www.accounting-adventure.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1207823920110008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572932_1360722378060946_5171859374882779927_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZxQkGdJroYQ7kNvwGChaiD&_nc_oc=AdpieE3E_yv-RDxJSSATEeZ_h8cZT7exKT92sy6bOwEVMENhHDKtRsfx93yfh5MnwIA&_n
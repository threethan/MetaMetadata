c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=votX77uFFnUQ7kNvwG9iXwc&_nc_oc=AdqLj167MA-GHrAdxet27m79kqX2kBHEwQc6d7TuL9vBUyImtDYJJ5J_18GIOMFJR8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4qfRZtiN6yeygy-6F9OP0gFx_wpKYRZpyalojFvEKyg&oe=6B0B430F"}, {"file_name": "Sorting.png", "id": "535186151929828", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974575_535186155263161_5266481990815003196_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WiOpMfJTrYQ7kNvwGbE8ll&_nc_oc=AdpeBaizUDXjGaNkJqt7sN71ifEAJgUKSnJ5fSdU_9WkeixLijin59pkJw0Poiq0HCE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpkSmXxK-R4GGZYGcxE_GKiwmWafIThPicWuFros4lGA&oe=6B0B2A9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Accounting Adventure", "keywords": [], "long_description": "Travel back in time to 15th century Italy, where bookkeeping was invented. Raise money and buy pepper in India. Sell it back in Italy and you'll be a millionaire.\n\nThrough a series of adventures, you will experience a simulated business and acquire the relevant accounting knowledge.\n\nSuitable for beginners and relearners:\n  - Business managers who need to be able to read at least a balance sheet and income statement.\n  - Freelancers who leave their tax returns to tax accountants\n  - System engineers\n  - Students\n\nLearning objectives:\n  - Acquire important and basic journal entries.\n  - Students will be able to understand the structure of balance sheets and income statements and their basic meanings.\n\nWhat you will learn in Accounting Quest: 1.\n1. understand the structure of the balance sheet\n2. understand the structure of the income statement\n3. understand the relationship between the balance sheet and the income statement\n4. to understand how to write journal entries, which are accounting records of transactions\n5. to understand how to make journal entries\n6. compile records (journal entries) and prepare financial statements", "short_description": "Go on an adventure, and learn basic accounting!\nYou are transported back in time to the Age of Discovery. You will experience a simulated series of business activities such as fundraising, purchasing, and sales, and learn accounting while having an adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.accounting-adventure.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Forevertail Co Ltd", "support_website_url": null, "website_url": "https://www.accounting-adventure.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1207823920110008"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5952193918162934", "version": "1.0.5"}, "id": "937814927234381", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5850703324978661", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5952193918162934"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, 
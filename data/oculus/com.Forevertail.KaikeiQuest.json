5460_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hFoXyrcDaIQ7kNvwF3Nr_G&_nc_oc=Adr66AUdcCb0G4W6sSWRROUAba4jdQ2AY_Z0n44EbkSpQ08v2hK7bBJdjDAGsHD2-h4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FUavV_qjpp02Oujr6KAhyzNQC6hJcVGnj0HddO1ZPgQ&oe=69F4AA7B"}, {"file_name": "Drama_1.png", "id": "1081009286627224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984474_1081009289960557_6090390529264337564_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGPPdOJjpwIQ7kNvwG9uq-7&_nc_oc=AdrE5S3xIYMaRJWR2hMS5ePizO1pFSR09DAwaPNLfKQ__yfSMyYmo8SMJ0_b4rB32AU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25D05RUJ4BiBv-zp3BAVXtvXqU-QrHYVhTyEi5luOu5g&oe=69F4A60F"}, {"file_name": "Sorting.png", "id": "535186151929828", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974575_535186155263161_5266481990815003196_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45FN9zfkqH8Q7kNvwFxWnSq&_nc_oc=Adpg7JgnKgkG1zkQAzkdbppjoZqnfZqf5qdmTA0QGz-RCc62J253UqcDsTzinC4u5M0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af360Dg4JuobdJ8-q4GyKBUhJXZGWf0ElJ4OVqrc6zlgSA&oe=69F4C5DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Accounting Adventure", "keywords": [], "long_description": "Travel back in time to 15th century Italy, where bookkeeping was invented. Raise money and buy pepper in India. Sell it back in Italy and you'll be a millionaire.\n\nThrough a series of adventures, you will experience a simulated business and acquire the relevant accounting knowledge.\n\nSuitable for beginners and relearners:\n  - Business managers who need to be able to read at least a balance sheet and income statement.\n  - Freelancers who leave their tax returns to tax accountants\n  - System engineers\n  - Students\n\nLearning objectives:\n  - Acquire important and basic journal entries.\n  - Students will be able to understand the structure of balance sheets and income statements and their basic meanings.\n\nWhat you will learn in Accounting Quest: 1.\n1. understand the structure of the balance sheet\n2. understand the structure of the income statement\n3. understand the relationship between the balance sheet and the income statement\n4. to understand how to write journal entries, which are accounting records of transactions\n5. to understand how to make journal entries\n6. compile records (journal entries) and prepare financial statements", "short_description": "Go on an adventure, and learn basic accounting!\nYou are transported back in time to the Age of Discovery. You will experience a simulated series of business activities such as fundraising, purchasing, and sales, and learn accounting while having an adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.accounting-adventure.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Forevertail Co Ltd", "support_website_url": null, "website_url": "https://www.accounting-adventure.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1207823920110008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572932_1360722378060946_5171859374882779927_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GsAoTaHU28Q7kNvwGd3XcG&_nc_oc=AdrQOKuMs20031dVgK0mD22WWHgb5S8CsonXUsmjZr7bRmiOQw3nm44wfOTGww2tuxs&_n
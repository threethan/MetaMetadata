ppilxwt4GHRwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh9wrbvGgFj6io9LvJQNhU6Z_WQqbvwYoIFDkr9RfWyQ&oe=6AC3B771"}, {"file_name": "Main_2026-02-06_19-24-56.png", "id": "899242262844121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298291_899242266177454_9004520265771759165_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcw1VY7ztRAQ7kNvwHFB7OI&_nc_oc=AdqrfBSACqUccFUGH9DFAvMlG5pLCdhGPf4DCKiIGN78A1Bzxx5R7AxVTegsMoXk48I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjgyDq8KRWlbq7xL-3UYUVV-8av49VOnO-I8xSYs_TDQ&oe=6AC3B44B"}, {"file_name": "Main_2026-02-06_19-24-40.png", "id": "1230288975190171", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295661_1230288978523504_2134925139984771443_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA1RjPOgorUQ7kNvwGQrHwT&_nc_oc=AdrynyA3e106Oz2zFYIiYLZAIqoyV5hqFEqrqvZ9hiGvIZR01qO-3wuc58Vf1NWn6KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvfCD7Owi-lM_n5_f6b-2QW81pDJxZ0ftT3jnOuTfW2w&oe=6AC3D4F6"}, {"file_name": "Main_2026-02-06_19-24-44.png", "id": "3814291545373587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304764_3814291548706920_975669667093917577_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfuYcRzp2YkQ7kNvwGw8TEu&_nc_oc=AdpbEDrI29LWj6kok4tKUYKMc4ut_YcTK93t5_SrdwHDu7AzZbQEYD5KmFtGXqBfsLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLutm1FxP8E_eC4fOsz4xfV0sef6bOhOGowgHAjZzWaQ&oe=6AC3B7F0"}, {"file_name": "Main_2026-02-06_19-24-52.png", "id": "2127047004720627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307505_2127047008053960_3291574996981476696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfnJ21Zn9v8Q7kNvwF2H-s7&_nc_oc=AdqWzIdgaj0gyNEeSwSa3fgDg1Cbe_kulng5avQdz9Q6ZXDUg0z8tocK0gXMkwjuniU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFIBQmrOLkEKRf0rEiaCv0eOaG-NHriQW9dULOM5V6pQ&oe=6AC3B2AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capmantle V2", "keywords": [], "long_description": "Dive into a high\u2011energy VR experience where movement is everything. This Gorilla Tag fan game brings the same iconic locomotion you love \u2014 hand\u2011powered running, wall\u2011climbing, and momentum\u2011based parkour \u2014 and expands it with fresh maps, unique mechanics, and a community\u2011driven twist.\n\nWhether you're dodging lava monkeys, racing through obstacle courses, or just hanging out with friends, every match feels different thanks to physics\u2011based movement and skill\u2011driven gameplay. No joysticks, no teleporting \u2014 just pure VR locomotion that rewards speed, creativity, and chaos.\n\nExplore new environments, unlock cosmetics, master advanced routes, and discover secrets hidden throughout the world. With regular updates, new modes, and a growing community, this fan-made project aims to capture the spirit of Gorilla Tag while adding its own personality and style.", "short_description": "A fast\u2011paced, movement\u2011based VR tag game inspired by Gorilla Tag. Run, climb, and launch yourself through immersive maps using only your hands. Play tag, explore, and compete with friends in a chaotic, energetic world built for pure fun."}]}, "developer_name": "Eddy", "developer_privacy_policy_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended
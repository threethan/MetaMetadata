&oe=6A774071"}, {"file_name": "Main_2026-02-06_19-24-56.png", "id": "899242262844121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298291_899242266177454_9004520265771759165_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaTGcVIuKK0Q7kNvwGvLEBk&_nc_oc=AdqAk4Y-HXNfMQDpbId1eLGIIwoT2Wy78g5-9IfcmVdwoW9nZiq-Sd9XmYrwbsFXBvA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0zGl3g7ZBiMlrExgrSiYno-ougjUAxehwhe0mrnlZjw&oe=6A773D4B"}, {"file_name": "Main_2026-02-06_19-24-40.png", "id": "1230288975190171", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295661_1230288978523504_2134925139984771443_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XISP8rvBaoUQ7kNvwGh707j&_nc_oc=AdrfehnqX5MUwaVaeDjyIBs7bf6Okl2B8DFgQ8FSkwB3xoyDy4o5SopARkH1al4B2j4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN0v7NOLmraCyAmuSmf7cVuxpgFzuY6ywTQOEFP7jXhg&oe=6A7725B6"}, {"file_name": "Main_2026-02-06_19-24-44.png", "id": "3814291545373587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_3814291548706920_975669667093917577_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lkJGAHHa2sQ7kNvwGBzmnv&_nc_oc=Ado1W9Uott-2GMGY5kuF0ci-tOLYJjgVqM5rVChn4vLlUhM4BOI0D49l1IalRIfGUdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGud6LeW6iSqpj2r4g4VrXMinaE2RrgLgVhUo1sC-a7pw&oe=6A7740F0"}, {"file_name": "Main_2026-02-06_19-24-52.png", "id": "2127047004720627", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307505_2127047008053960_3291574996981476696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd3QH0gcZfkQ7kNvwGTS6o4&_nc_oc=AdrrU1egHMvkdFroxI6I8f_OeBiQwtXailRcF9oJ1RpwZmqeWEsf12mBwnGfBnjz_K4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwxSCKn8N5ECL8FFGl7XNqv__YGG3JPXx3j-bM3Xrhlg&oe=6A773BAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capmantle V2", "keywords": [], "long_description": "Dive into a high\u2011energy VR experience where movement is everything. This Gorilla Tag fan game brings the same iconic locomotion you love \u2014 hand\u2011powered running, wall\u2011climbing, and momentum\u2011based parkour \u2014 and expands it with fresh maps, unique mechanics, and a community\u2011driven twist.\n\nWhether you're dodging lava monkeys, racing through obstacle courses, or just hanging out with friends, every match feels different thanks to physics\u2011based movement and skill\u2011driven gameplay. No joysticks, no teleporting \u2014 just pure VR locomotion that rewards speed, creativity, and chaos.\n\nExplore new environments, unlock cosmetics, master advanced routes, and discover secrets hidden throughout the world. With regular updates, new modes, and a growing community, this fan-made project aims to capture the spirit of Gorilla Tag while adding its own personality and style.", "short_description": "A fast\u2011paced, movement\u2011based VR tag game inspired by Gorilla Tag. Run, climb, and launch yourself through immersive maps using only your hands. Play tag, explore, and compete with friends in a chaotic, energetic world built for pure fun."}]}, "developer_name": "Eddy", "developer_privacy_policy_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
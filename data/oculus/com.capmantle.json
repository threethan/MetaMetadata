&oe=6A661CF1"}, {"file_name": "Main_2026-02-06_19-24-56.png", "id": "899242262844121", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499298291_899242266177454_9004520265771759165_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aF8vl182IYQ7kNvwGFm4Gq&_nc_oc=AdoYzrDYrcQ3yk-4AyxwloS00TxPU3tOWTcnps_erkjA5-zjgE4HI7VSUzRzgnSS9O4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq__68UFc2BfcGZBKzQFNRK-3bY5kbeDjEJ2lSk0YCyA&oe=6A6619CB"}, {"file_name": "Main_2026-02-06_19-24-40.png", "id": "1230288975190171", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295661_1230288978523504_2134925139984771443_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVBpOjxFHQ8Q7kNvwH18Um7&_nc_oc=AdrCaO2VXhurkcPdyocjx6KYGpf2B_9p2cb5H3cRDxJ87jFn62dPUUq1xIz7LSPzgIg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiier2b76aAbw1GdOiLclCawDJ-R6JQqlESel_E5ErIg&oe=6A660236"}, {"file_name": "Main_2026-02-06_19-24-44.png", "id": "3814291545373587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304764_3814291548706920_975669667093917577_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gbhN_-Ti-YQ7kNvwGuiGEJ&_nc_oc=Adpm04PdJ97JyjB435-P3KuAmsHvRv_9oxCd1R3YJmHzlzqf4TurD7lIBq1sNpnrJtk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLxDks-r6DKTYyKuRVoLa6UKcQ-oKKkGXG8HWo7m3EGA&oe=6A661D70"}, {"file_name": "Main_2026-02-06_19-24-52.png", "id": "2127047004720627", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307505_2127047008053960_3291574996981476696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3viDD2Ni4UQ7kNvwHNeHBh&_nc_oc=AdpcIbD4Fipaadn5snDwrv_ohBB2Tn8lWQkp5vuhMYi2usaLLFqEl7H2ObFFmdFks0U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFlYzW_6X6NH29woI5kNdYCVstivfhdU9kI5oeleRuFw&oe=6A66182C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capmantle V2", "keywords": [], "long_description": "Dive into a high\u2011energy VR experience where movement is everything. This Gorilla Tag fan game brings the same iconic locomotion you love \u2014 hand\u2011powered running, wall\u2011climbing, and momentum\u2011based parkour \u2014 and expands it with fresh maps, unique mechanics, and a community\u2011driven twist.\n\nWhether you're dodging lava monkeys, racing through obstacle courses, or just hanging out with friends, every match feels different thanks to physics\u2011based movement and skill\u2011driven gameplay. No joysticks, no teleporting \u2014 just pure VR locomotion that rewards speed, creativity, and chaos.\n\nExplore new environments, unlock cosmetics, master advanced routes, and discover secrets hidden throughout the world. With regular updates, new modes, and a growing community, this fan-made project aims to capture the spirit of Gorilla Tag while adding its own personality and style.", "short_description": "A fast\u2011paced, movement\u2011based VR tag game inspired by Gorilla Tag. Run, climb, and launch yourself through immersive maps using only your hands. Play tag, explore, and compete with friends in a chaotic, energetic world built for pure fun."}]}, "developer_name": "Eddy", "developer_privacy_policy_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
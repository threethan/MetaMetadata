uluscdn.com&_nc_ss=7f20f&oh=00_Af1lvojUf8VqIs754xUKFGQPFT8191HvBCTpfdzTfIpoZw&oe=69EF72CB"}, {"file_name": "Main_2026-02-06_19-24-40.png", "id": "1230288975190171", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499295661_1230288978523504_2134925139984771443_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiUBpJZmLvUQ7kNvwHAgjbg&_nc_oc=AdoPWtwL0lDPTfg9z-E87mqn2vTvY1P3SXG-gYL76usGGaci_LqICigvkuM2IzZTh7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2q_etLywy1u8dUQ8Lg9kPl5CHxEAZvGiZv8t42fG9AOg&oe=69EF5B36"}, {"file_name": "Main_2026-02-06_19-24-44.png", "id": "3814291545373587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304764_3814291548706920_975669667093917577_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VsufG6fySsQ7kNvwHYgWV9&_nc_oc=AdrxQ00Sfd-RJl-Q3uX_59dfwchwK9n9rcTRuv2iEPVIah5l-IKNJgDltTZk7j9UeCs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SBDQ9d5vrJ4ugzB8BYi7FV7_G0mu_PBwdozQDPENoEg&oe=69EF7670"}, {"file_name": "Main_2026-02-06_19-24-52.png", "id": "2127047004720627", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307505_2127047008053960_3291574996981476696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64YlLkUz3NIQ7kNvwERP-_h&_nc_oc=AdpEIB-Ll7e3Pot6PY8irUjTlCPWSrj1nJ1EK2QSxv3hV4vo-ndBb_Y_CrUHVJrHuKA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pKNtvsvLBC4C3s_ZCkEnc5Mb3_uy7l3HrPswwSBjCWw&oe=69EF712C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Capmantle V2", "keywords": [], "long_description": "Dive into a high\u2011energy VR experience where movement is everything. This Gorilla Tag fan game brings the same iconic locomotion you love \u2014 hand\u2011powered running, wall\u2011climbing, and momentum\u2011based parkour \u2014 and expands it with fresh maps, unique mechanics, and a community\u2011driven twist.\n\nWhether you're dodging lava monkeys, racing through obstacle courses, or just hanging out with friends, every match feels different thanks to physics\u2011based movement and skill\u2011driven gameplay. No joysticks, no teleporting \u2014 just pure VR locomotion that rewards speed, creativity, and chaos.\n\nExplore new environments, unlock cosmetics, master advanced routes, and discover secrets hidden throughout the world. With regular updates, new modes, and a growing community, this fan-made project aims to capture the spirit of Gorilla Tag while adding its own personality and style.", "short_description": "A fast\u2011paced, movement\u2011based VR tag game inspired by Gorilla Tag. Run, climb, and launch yourself through immersive maps using only your hands. Play tag, explore, and compete with friends in a chaotic, energetic world built for pure fun."}]}, "developer_name": "Eddy", "developer_privacy_policy_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1tt-E9mhat7THPRzP5Av1ThIE3-19pksfyRJKpzfuFmc/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26025665483724361"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307435_1426504572361304_5830233891326798887_n.png?stp=dst-png_s360x36
JFNqNlyrmMOQdUSwlg&oe=6ACCE8F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2364171927425059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618251_2364171930758392_2946094908866237392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXTeAMAH0_wQ7kNvwHvJ9Zv&_nc_oc=Adoz85Fd7M_po51tCidjEJxWgiyK_juYIbIo3gQV_M4DQ_WpSMUHaKXJ3jmw3mcb20k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSdEb18XxAgkOidL6yV4xamlvp2Oh9GjgmdCBQ9gd0RQ&oe=6ACD0402"}, "display_name": "Fishing In VR", "keywords": ["sport", "fishing", "boat", "sailor", "simulator"], "long_description": "Fishing in VR is a serene virtual reality experience where players find themselves on a peaceful sea, seated in a fishing boat. The game focuses on immersing players in a calming and realistic ocean environment, offering a tranquil escape that captures the beauty of being out at sea.\n\n{3345129192345508}\n\n Whether it's the gentle rocking of the boat, the sound of waves, or the vast horizon, Fishing in VR delivers a simple yet immersive showcase of a stunning maritime world.\n\n{1417975270288139}", "short_description": "Minimal fishing, just you, the water, the music and whatever is down there."}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrfishing/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrfishing/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "sup
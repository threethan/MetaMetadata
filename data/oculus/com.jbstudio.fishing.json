 rocking of the boat, the sound of waves, or the vast horizon, Fishing in VR delivers a simple yet immersive showcase of a stunning maritime world.", "short_description": "Minimal fishing, just you, the water, the music and whatever is down there."}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrfishing/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrfishing/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28032850963065739"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821117_820837644407270_6006652114139992568_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIOlgSQK0-sQ7kNvwFMfxG5&_nc_oc=Adpa9nLdL1xw5-Gqm02Eh3cfaVgsC_yKKMbbEiLw1BfxSXGUrC3qOos7s5zZWIQob70&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjc4I3ktEa8iMk1s8NbmK0iwF0y3CZ9kvoarh9PmRvqw&oe=6A9AE23D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fishing In VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation",
/499618293_1264868698892141_542107838214032877_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27SqT9cf3nwQ7kNvwGyoAdq&_nc_oc=Adr7HqlmIOAbXHqhjKal3iYCT3mKXVdKVLR2wjA08l5qW7gjuISK3ngykUjw7DU2_Hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi9gR0KFFrtiFUYsAAItFoxhWSIuTuR6RuziGaxfh4AQ&oe=6AA7F911"}, {"file_name": "Image Sequence_002_0000.png", "id": "1948360249106650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_1948360252439983_4202377856266749514_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phem-XQ-8g8Q7kNvwH56U68&_nc_oc=AdoGJeZK0webiOoOvYuXB0IYxdLvaPg3rqtiqeS2njRNTMSLMMVdZ5BO1ctg3Le2MzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE2LaObYqj-nHAPJvPJUTYWt-8Gd18_fmL2DBz7ROIhQ&oe=6AA7E82C"}, {"file_name": "Image Sequence_003_0000.png", "id": "952981443996240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622325_952981447329573_24214925089938252_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeDB8Lcu858Q7kNvwEu951Z&_nc_oc=AdrAIfL-HxXs5I8qX_rU_PujVbWUxn0DyrPlJMaJutIcRPvcssokBuFy96VbRtnKyI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1lJBXLjurJ_SVeVZ6ZwKAU4r3dcQp-znPbWGF4UADIQ&oe=6AA80544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2364171927425059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_2364171930758392_2946094908866237392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHEEkJmpRGkQ7kNvwGflg9U&_nc_oc=AdqidHB4J3th7t9JxuJMMGcRNLF2ydS7UjEnwipNlntX7Xy0nSs-KtElddgL7pPD-eE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7vJlt29YSOdPmk00bgkthReBW2D8D81He0E1z9vq-2w&oe=6AA7E1C2"}, "display_name": "Fishing In VR", "keywords": ["sport", "fishing", "boat", "sailor", "simulator"], "long_description": "Fishing in VR is a serene virtual reality experience where players find themselves on a peaceful sea, seated in a fishing boat. The game focuses on immersing players in a calming and realistic ocean environment, offering a tranquil escape that captures the beauty of being out at sea. Whether it's the gentle rocking of the boat, the sound of waves, or the vast horizon, Fishing in VR delivers a simple yet immersive showcase of a stunning maritime world.", "short_description": "Minimal fishing, just you, the water, the music and whatever is down there."}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrfishing/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrfishing/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28034710052879830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_29370701819185330_6119008816343819446_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBTulJOqNLUQ7kNvwFaL_wx&_nc_oc=AdrAOxBY9o05EAfzTJ3pIA-QklLJJnG1phqANSu5hWjWuEV05Q148knDEjzVtnQPhh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN8YVVlC2806ASIBAU5XvAHmmpqdwFEUI5Xwh7yKBCsg&oe=6AA7FE22"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fishing In VR", "platform": "ANDROID_6DOF", "context_category": {"context_category
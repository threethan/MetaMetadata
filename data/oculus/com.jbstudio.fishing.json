7118001231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xe3XhImvZbYQ7kNvwHmPhiY&_nc_oc=AdqDoirsnQ6SlTx7eK6HdNWYLyQ7XWxyaaLC3nnZ4O3UYoQj9wg_1hWzUygxWiYked0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAIyySdaO_y_vob77Q-VY7oafxmxYddQDab9QJ-6Tedw&oe=6AC10B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2364171927425059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_2364171930758392_2946094908866237392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6WShGwfLTwQ7kNvwFIIF7h&_nc_oc=AdrrQtHkYksZTx5qOoWxGRHLscyxCMDWCxzcc_sHmfTkCZDbRCvXLYmmmQXJpM2mIaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCHvFkjFcYC5S7aF_q74Xbopz4FhkrB2E1ioxIHNPHxw&oe=6AC12682"}, "display_name": "Fishing In VR", "keywords": ["sport", "fishing", "boat", "sailor", "simulator"], "long_description": "Fishing in VR is a serene virtual reality experience where players find themselves on a peaceful sea, seated in a fishing boat. The game focuses on immersing players in a calming and realistic ocean environment, offering a tranquil escape that captures the beauty of being out at sea.\n\n{3345129192345508}\n\n Whether it's the gentle rocking of the boat, the sound of waves, or the vast horizon, Fishing in VR delivers a simple yet immersive showcase of a stunning maritime world.\n\n{1417975270288139}", "short_description": "Minimal fishing, just you, the water, the music and whatever is down there."}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrfishing/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrfishing/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278
VR", "keywords": ["sport", "fishing", "boat", "sailor", "simulator"], "long_description": "Fishing in VR is a serene virtual reality experience where players find themselves on a peaceful sea, seated in a fishing boat. The game focuses on immersing players in a calming and realistic ocean environment, offering a tranquil escape that captures the beauty of being out at sea.\n\n{3345129192345508}\n\n Whether it's the gentle rocking of the boat, the sound of waves, or the vast horizon, Fishing in VR delivers a simple yet immersive showcase of a stunning maritime world.\n\n{1417975270288139}", "short_description": "Cozy Minimal fishing, just you, the water, the music and whatever is down there."}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29274773658873457"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/595119480_1794559671854218_6602721678642033538_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8QtGuw0CV4Q7kNvwGEMfo5&_nc_oc=AdoS9L8iw4JfvrPMbGy48Tj
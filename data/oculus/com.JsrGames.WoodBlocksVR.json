Rqk&_nc_oc=AdoWEA93jb1R1JkurdG3wVB_O_BHvfkC-2ZsnIY_fl57pl40ikXpPh2JCKB-6JckD6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eWjKB3LcyIOlbVLOpNwMRbBhZPPsMs9e6lSofq6dkiQ&oe=6A3FC45B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKPxgdli_isQ7kNvwFxCVvi&_nc_oc=AdrFojCc8GT_kt11umNT9ePJmLEf5Ck4Z2U4LvxqRN5WU_K-Jbrbm1AHVcE4eQTOkNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o8zPUzRw2Bx1XIH4DBMs5l-pCJ7PcOOtdBobrDRAGhw&oe=6A3FC678"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNxQpUGPhcwQ7kNvwHW3_ky&_nc_oc=Ado9WoA2iPZMpFlD1x5ywHnWDNUMc8cQwkGUAHehHwPvucwcm6NGNxi2ywC59X3qNAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RAr2tJC9-o4XJ0WA_c_g9dFbQ5tKNdKFE9k-JvAH-bQ&oe=6A3FE965"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SosQU9fNJGQQ7kNvwHs8Vzq&_nc_oc=AdoP2so0utNU3gZiLGpelI8_WXQeDdBu6F7uHYlkCULfoPngl1XcIen0V_ULTVm3mZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af___dyOpa9LPtC3m47ZJSWlsnvQEhFgnu1dH4d3Ewswig&oe=6A3FDA1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e31w9EXw3o0Q7kNvwE_GdRU&_nc_oc=AdrXGIFgOb04zNlPStv8HxYuoUAiRpt5eTJP_GSsH_Btk3qQJ0eBxaX6k-v_AX8gkPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a9ng4ctgruS5sVBbt9johRI4898c8hX1NieQXcLNSWA&oe=6A3FC5BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
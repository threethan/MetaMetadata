8-m&_nc_oc=AdoXmhJNx1c3r2ICAkTqasVTDZgbukooYn9t3Qeuac3erQhUQ9fJ-gm10WlvpCxih-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HHKaqh8C0CCB3dphRnd04hOOITueKDriEdjk0BOa3Ig&oe=6A42675B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFviuCp8yt8Q7kNvwGN953J&_nc_oc=AdqLmygxkXSwyz7J669cVPxE2AsuXyUKrnIzgM3_D7xMB09fJESlhaSEHFD4DSbcMEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xLQOXHp4nedOSL3X-UiuK_naZqfzV3cX814iaEyvRLw&oe=6A426978"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H48vexRCIhMQ7kNvwHMr0PO&_nc_oc=Adp8jSXPDbCaEf7qwB7p427jWghnvOtNyGNbAkLiMbAT07g2kwYTLqbPV_68i6A8CaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dPlj028ahaNyZoLfHBr9aeJrV_EuiV2M5316Yksa9Ew&oe=6A428C65"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQWU8f8VKl0Q7kNvwHCfkeY&_nc_oc=Adp50K8ygtiG5Y6w4QdRJixl9mtusieg8wyfGMAnOWOCmHw5xnmRCjL00Dc-y3zaUK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BP2Z1ybGkpt4WvtckfDWjrO3_AEzfY5JH7fXLB3PH6w&oe=6A427D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VcJtBBhV5UQ7kNvwGToJed&_nc_oc=AdorZEemo5NNzfybM1InEGtAfTGBlkKEr5eGUDEsgiIdIDSOSOzY805Cb4Pfdi4h5tM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EZRt4t9F7Qd3rBDsRePxM7YS0xoxyNjOyMphbUa6buw&oe=6A4268BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
bp4&_nc_oc=AdqD77eNgRL3I1NxzDA_juFKU-9CY_A-sJfQfJ2ghvNpyXdoTnSZ9xiCgqB_ljbSP00&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP4AsmbYHuZBAsXQQs34t0p3ctluqG5Kq_S_z1l5pxAg&oe=6A65FFDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_FCNsmwvuQQ7kNvwEsJbxc&_nc_oc=Adp7eWRo8lVsYWY_LRtYu2f5hHNcpV9Wv9sSmACQpQ_BfmJpmfgWmJGrF_BnW4ghRZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBDqG_Bhv1xgQVCetsqfo1vTatS4IM30OaUciY4jnK9A&oe=6A6601F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A_5mS7_FJ4Q7kNvwGGm9L2&_nc_oc=AdpL_IfK3GIt24BEGTkzkmG2mi3oKwHWEwZaNoqOe0CTYsbqNvi3UoivKE02q7tGUus&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ72A-vP-9h1PL1yGKEQrqikCDfcocqbKjdacLiNHngQ&oe=6A65ECA5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v01tWLmzRMQ7kNvwFuPR9T&_nc_oc=AdqAQpDFf1cLwaMT5ljN7hBV_SFWfi6wwck7O8b_pgrREkj8Kx8u_eVvCSF7O1zuGiw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUvCWetC_hhyRTp_tbn5fVwJQqhwbldu8Q9-yZJfBT0g&oe=6A66159E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el3hAsTzDR0Q7kNvwEEKI02&_nc_oc=Adon8H6dxu4jI3bDq1jcLZVnS2oJrA77ly728gDBQcNGXBhdlh_H1ieS162gOFNFtn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkfgPDq4WSDE0Vq-E3g_8uPnsziPfUT9B77tRQwjD7kw&oe=6A66013C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
zWd&_nc_oc=AdpFNlevnK9aazctuhxnytJEnQweuAQzLhx_FACb4n49gn0DYURuuwfJ8aKFnZkSy8w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-79oz3oNQ6YM8MB4-pPyIm15xwED-SWauCXRjPfPgCg&oe=69FDD95B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWAfJkmHkogQ7kNvwGM6p_Y&_nc_oc=AdpfmcpRY3IBodQXK4aM9v__6Jduh5SMURNslxzUVabbH1OhhFRrJcu_ndASjSLeWHA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yaUrEkMEzobjTFyJGmQgxmYFP9Cilxm_-U2XCuqjIYQ&oe=69FDDB78"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4gmO-PHfmoQ7kNvwEynKWY&_nc_oc=AdpDM2_-o1s12mU0C91QCGRHhwu-iJGdDBLnp-d7AsuQCeELEH5w71KvfmIU0qWkxN4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EmE_sjUD1huAYSRkytwZ0DpArr7RGXrBL7MNx5l9JxA&oe=69FDFE65"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xn8Cdni-8UQ7kNvwE6zcHF&_nc_oc=AdoN3FM4cJSXbpNzIRIWkIwexbrEmPKZMcWqvZSU36FXW_8RjNiwM8MjhZOftZqxs0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YuATZLwObclRw8R-utpsz3uiWdF0bLZu4z9iWWDyaFQ&oe=69FDEF1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOJsx2Iqde4Q7kNvwH5mI69&_nc_oc=Adr2FDt5P014Q1WbMlFn55UAyWgOJmSVsiZQSBq6sM_ATI9Z-a_c8iCvEDl5OJpXebk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jPul7CQDkmKpU7bgoYV-_qg_ld2R8-UP9p4zHVoUoFQ&oe=69FDDABC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
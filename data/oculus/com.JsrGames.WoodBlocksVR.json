o3aKcuNhfPaH2CCXIltzheiu_oY1ygQICSlf7k5FHZhA6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs9TNUHIwDc1CXPHzt19uznvnuM1yAFZKe45O0hnEO98A&oe=69A9795B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq78gpBXjYgQ7kNvwFXSCqn&_nc_oc=AdnrsoJlqpt3debXNCZ4JVslE_FbOQRkETz1h4ShKDx3QwwvgHUjuP3BiQ0eNNZHbv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfveuFy4Bn2wsNQJBOHdNYfEk7C9OO-lXg8Q-JuKyDr1Hg&oe=69A97B78"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzkIlO09o7cQ7kNvwEZtbGX&_nc_oc=AdmTLnC0v7EXHwHeTS9n_LH8gXcfHNr_xqIHKwpQAk7yQI8oETo5-nI12-waUKBnXXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfulAlAweG3Bgxb8AK2gAhVGW7t4Tm2LU2aX4WRz1yDG1Q&oe=69A96625"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE9PD_yLIQUQ7kNvwEt5DAz&_nc_oc=AdneBzoYcHxISckAM9_ggVwGfJTX5aooi3Ps4ISxMOPtWO89j11sIJO9OcymhrKdIrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv0bLjt83SPGq0xDgsdcfqagZkEBvVSX-4JIq2kUSK5Pg&oe=69A98F1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p--sl06m2YQ7kNvwFkriyH&_nc_oc=AdnGFO26bPHwQV-pyHXbMqO4rlJJWziJgyK1L2Dztm_UBbAHepPX_YtSRPI7LDsE_mo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsqEdLs1SOR0Dy672N-mQtTCfKWHybacfzYoQu9CK0baA&oe=69A97ABC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_
FKf&_nc_oc=AdoCGkURwLrLZCraPTLOtXCH0mMl5qf_0kflEpajaLINpTMmiiIu7YCA6u-SSw-U0wA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13S7UudV1C2xjFT1VeNu1BREma0WBdrEy9y6Lt21P0Pg&oe=69F5F05B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21E3vBxOJwgQ7kNvwFJxhRe&_nc_oc=Ado23OlwaHKfw8OtvvV-2URFo0zhtYvPQTnvJH8_7fqRVgJzX7KUGKJ-POY4YUvrxNM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AF21Xh5Drhz0fzcH06W1xfKIkgO0huU_OVQc2QOCcSg&oe=69F5F278"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54RH6r4xWooQ7kNvwFewxDV&_nc_oc=Adrb2URGwC5gdLlBHQT9JnREXIkQwMViNwYG7J27jZmKWLNM-rVorZcqnxnSEt74BPs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1szAr0AsOSOr-IhE55IW8A2GJhyIBftwqU-qV-uM5m9Q&oe=69F61565"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCos4m4dIIAQ7kNvwHPXj5_&_nc_oc=AdqKt6IQpJJtWazpT47Dz4Z72NYVTBdas4G87OGWR2FuU1qiygPVEzua3dD2G6KAGEs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Cj_PkefKQmulRAapnl_cAGo4RLsvTr41ZjDIQamFsDg&oe=69F6061E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ER-blai2TYQ7kNvwELOSaK&_nc_oc=AdrqDmqmsmVMRtQdGstnwMebBEsq0hAnIC4aEYfOh5tBRwb4EbsZrOUi0UGtzEbPoOc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mwC3ORCDizGI4ZU2N1yx3BBHvIHcY-_0fspf3ztA4mw&oe=69F5F1BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
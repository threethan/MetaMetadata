pnK&_nc_oc=Adqjq577Ve9f2-F4ofH2mw0xZtSQAm6tPJPX1xWNYQyB2XHE_yCeGzpVOONub8Ii92g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2fUDp_pECqk9Tc7kDMJXUhizNOn6rvwUYF94maAe1Sg&oe=6A69F45B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW3DUo1zwjIQ7kNvwG6Gg0K&_nc_oc=AdqMPtEoiUNadsynl64vEn2VWv0aEwZ-hh-jJ69M0P3zTBpprFDRW4HvBlsTpE_nCT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC-_zTayJIodSx0qrWAUlW1-n2G-MlZTykhi55vnmQ0w&oe=6A69F678"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVxZr9AzGfcQ7kNvwFBDet6&_nc_oc=AdpUGZr1k43GqZI9OQM9KEhVKzE9qC1HP4tsKt0ATjIBoh2TMXerun4CC-1FLd90LW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVTwdA7uFrwObAz_2-tE-B6Yb9iAnDuJIgEJBQmq78ng&oe=6A69E125"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g-Zce8U2gIQ7kNvwG4AmkC&_nc_oc=AdqfEbz1ZqOw6jS3Fyo2VVjxFWwxK7FRP9qNPeFFcgxRNih7VFwLHyMic0yEj0psCvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ6cG1KXiKfDOTV6gQADJ6fK0DndngjyEgKDMqYfT-rw&oe=6A6A0A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdmFMefnhpcQ7kNvwGe2XeY&_nc_oc=AdrP-Uq7nYBxX4AAD5PfbY-bU4bNj2T251iH0qyXu1n-zHT59PwbVlKCRPw3xmOEMXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMn4DQzzfSo8Xl0O8W0-Mxwg0hG5u9dolzeRvc-C4NOQ&oe=6A69F5BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
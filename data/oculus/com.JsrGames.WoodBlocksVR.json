mWL&_nc_oc=Adp8-SQciag1YtRcNlLmxe_mIJb4lBzWt0DGkceJkaJ-3-75oddMhkSByB-K7qpWKlg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_lE-lECMyR8JsS6iKYMJEIFshnU5Lcb8l_mZyqhsASw&oe=69C7CBDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsbxTLnHzQUQ7kNvwGTgQw6&_nc_oc=AdoNbHP3-Hv2l4v6-UjX9_fu7JUbrW9zIs_LjJl_u-QBnUnvAjF_XckejmLjtyEaTu4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmvbUaP63LLSKCsNVbeylwGCEURhnFx8KaotqUT-JjBg&oe=69C7CDF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GR2sVsxGFoQ7kNvwHAWSFW&_nc_oc=AdrWa-VXtRwCtTXNAmWSIaZr2KODl9BbBCREUAPAOf4V4k_As_H2p5RdD80eOizwAKI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3ISesIoLaP4j75JzBSqK-s53CPs9dMzwpevMRqfEDZA&oe=69C7B8A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPMiH6he2KIQ7kNvwHW5v0h&_nc_oc=AdoF7qsC3IQPL9qb5BW2y3axOgoS_7NwRclqtZyNBIF_KU4em4nE01JqhRvSUpechdY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfEU0Ib_ry7E6baB532g9ehNlWJ1zXONhcsfScA623xQ&oe=69C7E19E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOnNRai0_2oQ7kNvwHVAQDx&_nc_oc=Ado778x6Zvz52-vUsNO27FvfL1VesPRneBoG-K1yYZ7a4ZwiShQTY7RNVVtobFEEsuE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOG2Hn0J33Q1OMmQ6njLQso3D9kGYaFSU28y6rftH89Q&oe=69C7CD3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
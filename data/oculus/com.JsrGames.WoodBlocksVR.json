B4qL&_nc_oc=Adpv32jJEjyWX6QwcW68WNMIQBUYltKT7PVaGnKDYflGSOVF4x1YtcBXxlW9iTcc7BE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYQ7ILp7KQ0tV4ByFrWrTtwO9uwzqIQ6vSynkbfQ0NpA&oe=6AAE825B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuqjC1jVpgUQ7kNvwGZ9jfE&_nc_oc=AdpDRQvGxSKz9T5Uqf5aCy5CI5kZ4kXGs3cYFl-FEIzUbZNWv1-iQJ271FaSPLESc0k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9bpEoDreR7fOmkNzh00GTgGlh8rZWEFQ6U4-qtVCjWg&oe=6AAE8478"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHIjkRWaHdwQ7kNvwHfIj9e&_nc_oc=Ado2RIeZ2_P5loKCAITqyHnRdTRVN_kROe79lFnBMBSGGTD61lxOdw6y5yuJqnCz_RE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX36B5wfW-BIGFn16SHsHeg7na3zeziEcjDZSR1Js_BQ&oe=6AAEA765"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v82BywNbpz8Q7kNvwFc1gjj&_nc_oc=Adr_pJP43fv5Nm0kWM7VlogaD0qc5efc2QbjDLKaOt933z9kXjS_nBsa6RHUO1WNuGc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0M6CArfY5gxjgvCDULqT1OTBQ4vEY_4sU_c2fEvmKxA&oe=6AAE981E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsLle755b9cQ7kNvwHJw-4G&_nc_oc=Adog4GyGtu905hPbvbI-drlDcjELqI-VHZGTIKLLk1FtqjDnKchEEqUvTWXPll8NqkI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWbNCMwctJcxZ3kLXzhbbeagNrCvgTUE-yHhUHraFuYA&oe=6AAE83BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.p
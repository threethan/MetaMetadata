kwh&_nc_oc=AdqVvguAoEmAnMywHFaA-KS7Dw5gKKvp5bZYhreNmt0sGtU1kiY3koSZtCtfH4LeZKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9R63raBjrfMhs5Lp-lrcKe_stlI8e0IOmIFi25sFcQg&oe=6A6B45DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW3DUo1zwjIQ7kNvwHhr763&_nc_oc=AdpKxP-0kvcpFPij_lnDnk0448H9ZBjNXvnOaJsfqaeS8915ZNBvKa7zLYvUw-BcHyo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8U0hVWv7o30FBQLOUYESiWyUTDSt5GxbqZiEzpQX2nA&oe=6A6B47F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVxZr9AzGfcQ7kNvwEnxodw&_nc_oc=Adq4ZZ7oLnmUF8EYL09Iba21AJXuLkP5yi8IRo_IkCQpA39r3ciXBv35fqyvr79jFQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfwhSZ1KX5ibOK9FFRnu0mAFM0pmrp7hpoIzWCGpzsZQ&oe=6A6B6AE5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g-Zce8U2gIQ7kNvwGhOFBL&_nc_oc=AdrIMLlbxA5MqHjXeQUbWHuPoXgyyUhupfA-loyZcLF8H2Ckh-EMHjdAH57GuEfaGwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyWhqnj-Ajsig2ytJU7ZUtndoIMCmJ9umTAtAW1yUwZQ&oe=6A6B5B9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdmFMefnhpcQ7kNvwHlVLfr&_nc_oc=AdoscTykz5QRR6ZKG_Q8e-IdS-u1_x4TE84NjQXN5LJ9ca11eqn305LjnNxv2kBuzNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeXKKeuDcOo0d9yU_NjSELMM6_PXsZt9E_NC8oSIhvbQ&oe=6A6B473C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
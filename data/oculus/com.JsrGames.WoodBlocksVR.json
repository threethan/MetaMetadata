wVF&_nc_oc=AdrdRgRvBIJgjCH2n-Za-Rc3pLMUbJX9SF6oI73Xo0TDwopX8AtwanD8Iz8CV5sZ4QM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56MTlgYBFfrb_U0BoVWtpy8Q8PoTw25ZdOB_LOsYs1HA&oe=6A0B085B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raJK3OGsSr8Q7kNvwH47MQJ&_nc_oc=AdpIuLBG81xQOLqxtaaHcV9SZFaczG-4nKdlnRGjTw3tX8HZWYSo12KG7IKaiOHYauk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6emqjdRvyc2c5rToH5ilgKQB3iXOWoxOp4grOUCXA9fw&oe=6A0B0A78"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aD5_AbwwFVgQ7kNvwGAT1xq&_nc_oc=AdoMoDC3SFs99aoR6efynBO2wAJf563u4GUbMka8vEFSLlszMgy9vt1M_yfMQqx81ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b0qgdi2xdCYTG-03AgtaMJDwKvxYB55kHv7OQ9UG1jA&oe=6A0B2D65"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om8DbOtpZvIQ7kNvwGrpEao&_nc_oc=AdqF6A2qoNxg8JdyMzv6Nsp3vViKkm5sjhRMTXxRln470u16JX0POOZroWVTiC07GP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62HE483EdDvJvETSjZQUTRIQkQHeoSemTWeHl2SD8avA&oe=6A0B1E1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qu69OcTAQPQQ7kNvwHnXz20&_nc_oc=Adr_7SOtcB5AtVdPphb8sLzOnEgmpzvLhEgo_kvkuP3FKLNGlL1LDAp7zcAGD86f3ys&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ov6iz6FRAjieEFcZbRjZUXn5TQZqX3U_u2BnglMA7cA&oe=6A0B09BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
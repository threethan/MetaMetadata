-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5QEG_ws1wTsRY9Fi35puvp-AipXwNDIg-Vlej3zcmkg&oe=69AC0925"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDXe6Ewk-BkQ7kNvwG5ffNE&_nc_oc=AdnoFq2-pMifoyprK_8gm5J61b5EN_4hF6SPs6WfvZh3Q2jUMeJWK78XedJiPbwflG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyD2MkUgHq171IYldIXJj5W8N7-E-o76InHg0TPnFv11w&oe=69AC321E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E703iBHai74Q7kNvwFKASgm&_nc_oc=AdmRCuFQFVpC5nSEG_lz7f1rsBgPs7aBCJG_Qi9jjdJw88aNWYlVxtsPvngPpeQB-Ew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwjU-xu2KQRCSxr53LQRbN6L8eQ83snH89jotQ8ikoRw&oe=69AC1DBC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr
wFjny-F&_nc_oc=AdqiyGSGBCtA7F-l-xkmyvZ2JK3z0QxzNgG3BmOykKLOhUHD21-qC5oEYcyTdKts8SI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ5mVG_2xdsWuVyVP6hlLDsytJB_maiaWbHRt9ThY0SA&oe=6A8D8CDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFRbUCtm2uMQ7kNvwFNxitX&_nc_oc=AdqAWtoJLjxdKGvGzbVmQ9jVGIzSl8AqbUKMFeze-5qOb7_INwhvIuNU5MUl0kq3uLo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsX0D_Xom_w3aIYlGTdvK9_xenfSE53uYasBnLZmLang&oe=6A8D8EF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOtVPlCvigQQ7kNvwE1puyc&_nc_oc=Adrav-KQFzzOsqgVt3id5D4Q2q6weHpURv2e7PW0kkgIlMyrfBcfYqthlPnv2mWhqw0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFle0belRv5H-j88hmaU_BoDA2zhyN_OwoTQ3wckT8Ug&oe=6A8D79A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cZk1OQRQ2sQ7kNvwFmxxmZ&_nc_oc=Adolt_LuGdOdqRBXkSLnWvmsQ0iavfIaYOc_nbcICu5eypGwTA3C7TFaHOcGOC7tjno&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAHIZw50vrn4W497SxHTbI-LTo-I5ulLtHgi9eiCyX_g&oe=6A8D6A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwXi2u0XpmAQ7kNvwGNKfo5&_nc_oc=Ado41EdJgqZ4mhTfWWdW1muGxhst-9l-GvnYx4FK_qB4nY1Zgec40vLvgDrM3I--ogc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJxxSf1S6ATfYU1lS82n6HRY1mdU9gDGH4VCJVEJBhUg&oe=6A8D8E3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.p
cQ3&_nc_oc=AdrpZ_Ao1bBt753cQ96xoV4eKto-iMqzCXr75qCnf8iAJo46TU3A1SFfCNQpoP2x_Bo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Al-72uQuBHcjc71cwEWnBHR46kqzlElGiZE8b55g81A&oe=6A32955B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fim8ykLT9m8Q7kNvwHNqLLO&_nc_oc=Adoh7DiOt6NZuzUjGLhkWt6AUfPL8U3ld5NGMlAojGI7EUEZz6pauZLfJ9MNio5Aqrs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tjAACm-HaxSgNNvGgF176PXQ6J6O6h-Af2eI-CzIcCw&oe=6A329778"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBTu-HOHX_cQ7kNvwFZ8jDT&_nc_oc=AdqFYrHxYqjUnro0OeXPRuWIgxYUYKzSWApmBkX-PpQsSgBQXDGGigXpa-b_2eB-J3k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bWahoGCgVsZbTclRZRpBgBFZ_bvN01b9Bj4qSHa_YkQ&oe=6A32BA65"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5OQpih7i-kQ7kNvwHSpoBq&_nc_oc=AdqCwsfbXjhqoZPbiyAacZszaQwAewzbuZus7Jzz0ZDXGxCcv39rvgD_INVJQp-ln9Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91ILFw5AVn0b9xl8LNmC6XuFJnsRb2uHBH0obNhNlgQg&oe=6A32AB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cop3jSq_AP0Q7kNvwGaoi8e&_nc_oc=Adrn03kpK6gQ64Pb459KiPs-lONPVMb7fVc_LFss3rbD-J9Q0G37zdS_1RfLzi2ztQ0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-thhiScaOEA_RN6beI-1wAX-Pqp2hTDQ7XzF-f8CL4Cw&oe=6A3296BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
ezD&_nc_oc=AdqJYvucFgMPnPgUtAUC05y3UhtsOZ2-GkpkYLdWjcLftZqe2GetwiVxlUDVOmN2F_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_Y1fKgnA3QhnD2M75q8YuEtHXzZQy6SK-k4tPxKsgMg&oe=69C3D75B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApivNMNPb5kQ7kNvwGi5KPq&_nc_oc=Ado8giAaVyyxEVngB0803arlUfhv12mmoFvFLRa-zPndoE-J3QQ8ptD7Lh5FKdKMMIc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhgXJ6e_wt1cVkABYDKFidBeY1pZDZ1SosneYEG-NPqw&oe=69C3D978"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlqZh9jXZGEQ7kNvwFNG3Zr&_nc_oc=AdoxDG4Lh-zFq1s-V__FeOZ9sAfoveZ8uZY-mKA-jnGC8KoZTcFmvf7oSqDJqbJeogQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2eOQREaMZn0rsDtjeXDVFOn5L1zcbZMAvs-m_p6ikKg&oe=69C3C425"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMlxS79ONmQQ7kNvwE45s3V&_nc_oc=AdrZR3Cn3wUvflTLfftwJpf7B8QIeeKWFfjBGaj4MTkXdV0S4ZzKuDs2rXQYh66TBcI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoazNvVgOONgBkZE4ZKjUomOjTLLTWzj3gbolX01pT5g&oe=69C3ED1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRGV8k74ebwQ7kNvwEEk_W0&_nc_oc=AdpJ5_4EA6k4JFyBWezeGf-EK1o-EfhjRc1nIzCj3WnskpTQVgHnM8FCTQyLwYQQ7ss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9YFhmPno_DBQSYafW45Hxg-3y4F2kbEyOVjehZXuDmg&oe=69C3D8BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
zbE&_nc_oc=Adrs12v9LzhajWJPcJzrYoxhqSa5Oqj70UiC_yU0MfNpWyRH-cLrAOExohG4IiypbU8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fzovBFS6ntkRYjM2Wq2KhZOCXHNBM0alcuOuEWaD2Nw&oe=6A104E5B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RANrYBbUI9wQ7kNvwE0FMlB&_nc_oc=Adp_KdlQEWt4WoFB-piVtijTOli_ChWMEsA-oJF4ScoVXIg8XbGyj3O0FM653fgHiE8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-qfbbZikSWZW9A5G0yXMU9VQ89Nk64ScXjIU-ZM7gJQ&oe=6A105078"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QlMLu9856UQ7kNvwGyH5lE&_nc_oc=AdorCgSdc90vlH0sRx7pOyR6qyfxtTUFSiWZWaDAkcYkk8ojof0x_NxvEyE1lHp2n5k&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lf_aLQwPq3TI7ic4jvf7qS85vOlvRAtwwxqMm5D_htw&oe=6A107365"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNALpxyTcIYQ7kNvwHSqAOm&_nc_oc=Adpdi7aqfOmFmxbcUpS26jM100vVhZo3N5eRYuSMB6Vi-PZxCeWF8GgE7nkjDydWd14&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ucs2v-Al0mYhfVhhZCnCnz3Znzsz1neGucp1ND4vqUg&oe=6A10641E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YBDzcMd2YQQ7kNvwGZ8IGM&_nc_oc=AdpvjRDzT0O_QYSczMrSMdXEewPFaKV-q2STdk-hUHrCz7RZemCxqe3xLX3HOo972zM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fOMb86Av5sJ7fAD8e5pN8jx0qAA5ZoO3rZf45dFXD6Q&oe=6A104FBC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
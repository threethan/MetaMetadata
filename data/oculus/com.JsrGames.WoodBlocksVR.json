-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzX_59cCaV9ju5k1KkjbG6hSZ1PHLxf45locy8bm9sqDw&oe=69B2A0A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYGKIn_B91EQ7kNvwG2w_SC&_nc_oc=Adl36gVEFOc2zSlQ6gpgs0MDqJPv2bF-LH08HCH6FLpVZIn4yD7i9Ev58oNCTPAlico&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzmd-zi6y2_MGNiUYJXm4Y4vYTsK8mE9S-DQUlfj__oxw&oe=69B2C99E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDpEbMLsTPkQ7kNvwF0Imw6&_nc_oc=Adl2Tj5CHc9puV3AORhNKxmr8cPAOB2Hgl-x8LEYhc-GOqq7ypEXraX90BAmDpivrZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afys__djJoQ29EMhiL-SGM0g-rVg_GROrCvar15Mq81PcQ&oe=69B2B53C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr
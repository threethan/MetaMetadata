bNe&_nc_oc=AdpeSwp_y1uIvE1E8jbIeOocneRWjpflBZ6-Qown-XtiZXoeQaygu_ICCfdTRv6MOeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1btkfHkyNrIHCKg4XiZqQHHAHmtaek-0EeMhagOrilow&oe=69E4CCDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hu73jkMWU4Q7kNvwEUPtTz&_nc_oc=AdoLA-b3i8ffFIsmcqE8en_Esvve19Pz__5CBWiVjWdmPHXW4kC4DvPRlx1xp74gvUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Pjp5lpTYzMTs0Zy58L6fD98QlH-Ihbl6bhEJktrGxPw&oe=69E4CEF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kj_65Tqz3AQ7kNvwHBf1lG&_nc_oc=Adr8zCsKfaTDSh6fjchP4kn48LB927RpJfg-QqPqnrDKNLAXloHFacYrMe3_59YgetU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K1Pme1MhOzxmsbwIE8QMS1lgJQsXN6kpSj2wrA2Bl8w&oe=69E4B9A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT5tGc2YPRwQ7kNvwEggqDm&_nc_oc=Adq8x2dx0T04zp_sjl-LMEBGsSg0UoIyCimEoq3Jg8IULJ_Agis11K1zWN_8iLwx764&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MAd3npcHfJ0-7eEsuU1V2VzNolmrrqHgXMTIFjzSjFw&oe=69E4E29E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07udVNbfbHQQ7kNvwEWgq0t&_nc_oc=Adq4AwCApYQ_w3RSHPhEq_21Cm_kDdm63nHHBS02Wjt9SQ5Dmfl-WK9ZsqPlq-ciEEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VD_xzPF3cK2efpg8Bsw8tcdEj7YwPzJooxZLbQEYgew&oe=69E4CE3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
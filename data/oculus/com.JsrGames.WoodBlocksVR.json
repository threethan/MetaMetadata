l9A&_nc_oc=Adpsf2fawxvd079rixw534VKGDh-1H119HRNS9XP5vCMnY_PMRl2XmYPpy7zb0Nvu3E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd4xwBDXCubUckrIAJyt25vS2stS-BmLTizlprhLEmiA&oe=6A58D0DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RttT0tnA970Q7kNvwFddCoc&_nc_oc=AdpW0U7kiQlwgkk1nYiI1oMLI92dfZQu7sZFBzNYLlZoobzfKlcMyJ4NGcDR2QUDoeU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSfSzydVRDYc1rCqHYNIZlgseLkr6VrHR71cEiECRXmQ&oe=6A58D2F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg5M2W-PmEgQ7kNvwHvwxw1&_nc_oc=AdrrMfaXJnpGngM2LUl9uEa8DZL_Vc0Tk_VucO8Lv1M_zZ2uM4IiWzqnQaXNyZoqwqg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5pVyGoPhfH3Z2pYo9AxAQhJvFHMqC2qXXGn4G66KmZQ&oe=6A58F5E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGyg_ideqU4Q7kNvwGVe7Xu&_nc_oc=AdqcazjJ8lCPPMQVlSEymtAH5FD4hCyHC4Z5-TEKM0oG7VQID9zLfButXuJWPoSigfA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS36UFOKSupVrSJ7oxMAr9SaLZcR7Le5NvLRFlh1W68w&oe=6A58E69E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiYJK7nygtoQ7kNvwEPIrK0&_nc_oc=AdorsF415Owg8y-_gtxh2Z1E6SF48qgSKXlGOrGqbADPxgwEsHsSVXJh0YflaZiEW2s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRao-BByY2ZSnje0NsdcQ-aBcpnNmfXM3xFLPjkcUYUg&oe=6A58D23C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
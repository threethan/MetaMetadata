-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwomvt0KFx3boSIHZwcA0KD_jkhyd_ZZm_pa5NkwBfmBw&oe=69B7E6A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilUjJrlSsLsQ7kNvwEntXeg&_nc_oc=AdmcMbrY2y2vNKRk9sQXpCQwhzLZLh1XQedHKN1PAlIqZJ5LsJeHjcSloWoItxKgh1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYXbRHfD9zaS5s-syNvLfwDfeWt3-ya-z_QECuJwE53Q&oe=69B80F9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ai2WQYCN1BMQ7kNvwEApgwl&_nc_oc=AdkZy7fcfxhjzNxfKwuZxKNRCy6VyOhLAa7wkcPufWuQ-NwPNK25GHFCWYSCuNs_Ly0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIZWzcAxp6V-1JwjEW2_nLv9cC6kXWSBU2ZJsLnhER6A&oe=69B7FB3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr
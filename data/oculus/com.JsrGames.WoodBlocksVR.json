MMV&_nc_oc=AdpfGY1vX3XVM_CSrUkB_qA5vNcpdhnM4oah3-Ho58f73t8OgkF9XoHHiT7HIiyJDfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bj00KPX3JSqREDK960uum8lU56x72HSAcLHeInlk-EA&oe=6A2FF25B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li9xp_QL8PQQ7kNvwGupRgJ&_nc_oc=AdofNB98ZpJz9pWBPisbsOtY4H1wOmtTeC5EBO996gJv0qugVBrOiw4iQExZsK9ROhk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8r-wYx4YaGDBV1Uzn_bi7gCbs1vJg3AexmDG04ntuUQ&oe=6A2FF478"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AU6fypjVWIwQ7kNvwFFDmLU&_nc_oc=AdrXUkmB2wwedlDq158b-YXu20snMeGXFtuaZ92V71a_u8NuQnRapR7FI8jV2Xs5uYk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t5GrQ1DsWLW0INSdiKaYCcZSvZVWr01-O5E97SuaObg&oe=6A301765"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K14SMGQff0YQ7kNvwEzPJCD&_nc_oc=AdpEmHk2asJ8uwYeOjUM978kBMoWNjmo5UHlBArr4nVNHVKXhlX2VjHFkYQMayar9dQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m3vsyW8tv9Afh9cFS4odj-7Q_jvmBrX82pj74BLX9Fw&oe=6A30081E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucbjNRJbL5gQ7kNvwHTcYql&_nc_oc=Adr8RFRVcwjpUgLe1JRFzc4_jVxJ2TWZKLDYdOYTOsOMhxwLdNflruFcfuLgieduCzY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81IOo2mnCSCUYrnxiNXKN_86a-HZ5WYIoqPhUTtj8VGw&oe=6A2FF3BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
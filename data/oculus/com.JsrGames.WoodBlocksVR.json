z8X&_nc_oc=Ado9ZJmJnvfVwtdzXbPzIb7WAGouaVD3STeuuUeiPJFSWJqfQV9k5h-txhhZJgjKp_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ShX6MQ6KqWtvjUcrwvEfEwosi0r4wda2x4JFPhlP5Cg&oe=69F9E4DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaKyKtEYcAcQ7kNvwEKlyL1&_nc_oc=AdqT_kNNXU9HDn3tOVp7-Q3i-ErGQgJwEhXLgqC6hfosMOJx9G5hGjnQpJpO4-zHbRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67Rr_63__ltFbH2EfXXwnrXURolp_e5r-BJz95Bybfyw&oe=69F9E6F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYBn3tBto1QQ7kNvwFb7oqR&_nc_oc=AdrXqrlvaCEcroRFqE04-Zn3CNfVb7IboWHwTF8l4Qk-yizyUz-CU6incVTcCONo7OQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vOYESN2rQ4eS2hO9eXwTcxJvapdjOqpxj-uFIGsxCAQ&oe=69FA09E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLJ2iQq8nggQ7kNvwGlq6p2&_nc_oc=AdrpliPRuuCAtLpKP7GHzdo93PWHJ06NSIb3uMc4GYX83yVgrhXmUTJqnzODLBjjNAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tNK_wiAE558ovvARLMBTHMQeaownjZv14DNwpuUk4Vg&oe=69F9FA9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0f6saXOnlCoQ7kNvwEJ8WMI&_nc_oc=AdqNjl40R1aL_dbQFCwny7D_yPvUN2QhJbhuh0vz836Cqs_rm1wOKX160Bl6H_IRR8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cRVXDuhTICTnkSgHbQdehH273W76FWtrZ3HQM2MY4yQ&oe=69F9E63C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
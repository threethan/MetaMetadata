-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsZLdzPj4gBLQQEjL45Ok_PMa7bn9Gf2NMPGG2wxLUrWQ&oe=69A814A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE9PD_yLIQUQ7kNvwF9D41c&_nc_oc=Adl_qMQyDQ4bBIqYncA19rN9x83xHQGzA6PpBQgdBYX1hsPu8DRp_EaCcT7xEdFw-hU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvS_MwgIT0XzPhY7pV_rxvTloXlWu3K5Kk7JIJPKBJgoQ&oe=69A83D9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9p--sl06m2YQ7kNvwF873Kr&_nc_oc=Adk-ZKLDp0zBLOtRa5EnrVfMINAxxR3jfX8jJClQhDmP8mAbDxQG_rAEE21NX0YgfXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfubooC8_nSkvL_td4MZUHsVEBkoRRuReZ9Vujrj2HrG0w&oe=69A8293C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr
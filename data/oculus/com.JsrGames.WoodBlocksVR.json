2jL&_nc_oc=AdpKIGeFE2K030n-HeC8D24xmitZyyGbwL5nnw4JNwiGKe0Zs4iekxcH_4tQ3uAoW9I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa-f0VSfyl1se1DvwW0feUE9jm06CXsd0YfD23gOgiqg&oe=6AC5241B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-EaTE56dxYQ7kNvwF8Oqs6&_nc_oc=AdpCXG9rAvqxUoOll8gwPruTBIw6GnV4m7WFk9kWbVS7BAPV3JITj7nCLdxUz0uVe8c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNFWKbl3hmRoCcswv7mGmeMbaf_8FZ0HI5fmB2_BYdMQ&oe=6AC52638"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJZ0ybNarZ8Q7kNvwE1yrTE&_nc_oc=AdoWnZw88IkKslc4V8X2FmQL4iassjsU5n-Dbf1EU7x_Xs3QQxD9wju6CcEKJGB0_bI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJesabpogHbkEge0cw_Nf8mIBmgkOXCRaYvP9dxQCOPQ&oe=6AC510E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob1TdcdPosYQ7kNvwHSHl_9&_nc_oc=AdqAKLFB5UvfEmvEUAXt62VMoGItMDJ6tWtt3HBW5qMmg1mEVLk3DGrKS9Z2Sk-hQ58&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5FXkTz9zvPi5SjNoYXNBdNGIOp7lI9pHgxxCRR8QVYw&oe=6AC5019E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJp8guT5v74Q7kNvwHpzVU4&_nc_oc=AdqI1Vst-S1oO-kMDrW22BVZfzr2TC7TfyXpSGJxNc469w_3o19hAHkslSOdPJUOQxs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUihX_6bhh1_1GHF4aAC7Z80ePLpaji4b6o0A2tLtzzw&oe=6AC5257C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
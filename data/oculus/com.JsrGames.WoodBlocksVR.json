K60&_nc_oc=AdqNiue0LneujFDi01NRifmxPHOHvxUvTToZ-fcNCaVZNlwFZbjIR06tAsE6I3urGNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq_O0lul3iqyNNuNJLKLCxYv_-pQzndEFwxAktHR16Ag&oe=6AA547DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61F3RyeB9GgQ7kNvwG1CpMq&_nc_oc=Adpi-nwVONSORx-FcL4YkV66NTUufTONsNk9qKbVCnK8Tdv7sOo4R9dS47GUx43D6lY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYfgzeSCRXfl-Eo4SPLMv1DVa6DzmGsNSXNejxESSX8w&oe=6AA549F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axEuKTN_T54Q7kNvwFnUtjf&_nc_oc=Adr5GxKhSIXWSMBKIu-D1qkOmAm0QSsOochaQ7Pf15UXhryOuJrCFK92-zhJ1I05EYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6yLEuDqw_Yz5O6iRGKOixfM4I_BdiqEhsxwtkCsK8xg&oe=6AA56CE5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2DE-Y4d0doQ7kNvwEhcRkV&_nc_oc=Adq2yY4CX48QKkdf1DSRJ3fP38v2v9HYrZzv3Tf33l4uSfUJkCIjuWCOMINrA9tUZdI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK--hNjok-oHIKxtzyu7RjARi_XSZz2-Vy0ZXHQGxTt8A&oe=6AA55D9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVXws4SI85kQ7kNvwGjkMNY&_nc_oc=AdoXgEsj_jfnA6BX_jMVCxVcNfyjlD7wJzj7SEM-FcJxv1PIEOfRcyHCiWiq4nf4Qro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI6czjzfhd4pKX17N-l_hTVcVgu8_fqvQD29pCf1U_7g&oe=6AA5493C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
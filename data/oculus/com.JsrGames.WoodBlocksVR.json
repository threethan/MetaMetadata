wGoSsGx&_nc_oc=AdoefSu2cRcoFNWB-SbkbjwU2cuJ3wSCDqgVFAiRAiIFNU12n-qzTcHcGDvv8dAS85M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHctZ_6-NhbzcIbXrVzqzkYvCtXoSUXGGTvLItpY-z7zQ&oe=6A85A3DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzTu8FJXq8UQ7kNvwEvykEH&_nc_oc=AdqdNpIbFgZ9pHarO17DgSGm2m6LUhW1tX3Sv-aXR34VDjoNKVcwxFynBpbT6DlyHeM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOtqfC7E0afueniUH0ZgxE37tzNGGwjvHE9DA_-YPz-Q&oe=6A85A5F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6GdLMbcvPkQ7kNvwEW1LxZ&_nc_oc=AdoAPoFFzrXiYgivWI_ni2aYum-KQifVoaM-8qL17zXpxLzT60uhdpndyqZWsDURy0E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH39OxjQE4MDSor6MCup7Jfe2y2vwnbOo8yr9C99ghCoA&oe=6A8590A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG1J-lBQprgQ7kNvwGQWmth&_nc_oc=Adp3AUIlAFfYNmKd5C-bm83fsxvfXiyY4eFREzZMSArlt9LweQu7PayLO7p_jhWD4wI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcOr2qHPbIzMm12GKxJLn0bkTQrkKBKNKynmlyhtcrIA&oe=6A85815E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMRKH2E4otYQ7kNvwF_YLgq&_nc_oc=Adp7eJm0d7fhVHS4EGHdQp4mvETPJL4QXl62xvjpP-dEvv11jXm5EqWDW3UDNlFNBZE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHltqan47Gx4AWf2A1p4jvOh5CSNGmp6biDSA5ebarTyA&oe=6A85A53C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.p
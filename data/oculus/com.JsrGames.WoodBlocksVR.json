e0A&_nc_oc=AdqqPmvx-y9gsu3KSC7kpWC-v48QAAcPpb9Fm-QnWCAJk4uMOXn2URwqwMfZxDIEWpc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l7z8Geb0Cb2NoH1tHx7jWDRanEPyDcWpI3AjA4pwkcw&oe=6A2414DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UilA5kLDF30Q7kNvwHcuqtO&_nc_oc=Adq8il2cdEiWVM-q3LmAvMy0jwrJB_b-dWmCVm58vYoe0ubddP3mx4OD5obesJLjXZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q9IsGYDfPNYMP91j4IUUubwNe1mYdF771Z7M1c8nk8w&oe=6A2416F8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfc_0zAZOSYQ7kNvwHmIZcK&_nc_oc=Adq5qzS9uPZBfzhNCCWACpkS9CCc67mER-wG2B1wBPhBR65xMEQjWTVrsLFs8y1CEfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cZ4gLj8fqmmeasYzoBJ4OXtShPwFct9Wejna8kl01jQ&oe=6A2439E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALtjTqokM5kQ7kNvwEjHL7l&_nc_oc=Adpc26QzLG2YmCMCJyQO1MAaUHciKBvhiEFyosbOLXIy3ySwuHp4RkDpH3-ak9HKbDc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HXccKhzumbtJO_qndcVPyIvM6lqljb98fZZOwYweYdQ&oe=6A242A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX50yaKF5gAQ7kNvwFZBY8z&_nc_oc=Adost9JvyJLUfAB6dH9XO2Gq8SWZdkFS64sOganuJ3vcSGqQQTqXKfPET2877IRI-r8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pAO_p3FwX6wx5sKYNfnkhLJ_gmQ5QhadA_wo3dgQhGQ&oe=6A24163C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
hmR&_nc_oc=AdpMh8sy6wP2mRY9Fwl8qtwN15GHSY-VS4jPLY9KjtjIUf5uDnmbvCdA_6CWSBVGEHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvWxNV_luhGuucGm2eZi0lHOvorLiEwyKkdoMs9kTp1A&oe=6AF9E01B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iwa7oYu-BskQ7kNvwGJqiY0&_nc_oc=Ado_UXZ6VqOXDX7Q1VuItkOxFa_2LmwDc3NRCiST7XQ_bc4X9PIG6teaa8JO2yBNStA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiTvgFKg4DtieFtfd_i0JgebvF8Y-gtmYoN7VVMprNgw&oe=6AF9E238"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpU3NMOGepAQ7kNvwHekvKo&_nc_oc=AdrtReYy4VZJVVst-Bs-bbKubSo7sghb1xFIJltWtnMNr9C67ql3QzcCkZ7ZTzyrmQI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9UWpI-0kMAfw0UfBHe0eDi-FTtPKSnOIr6ixJ6uucjg&oe=6AF9CCE5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZM8xARduWUQ7kNvwHep5J1&_nc_oc=AdpnKXxLepb4nNk2Q3uERbCl3NhP11YzQoL9C50JgoPeGyPvnC7BSq_yVP_3UV0NYdc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpZ2vnNc89iLic0Kht0975cPDTScIPNTPF19DqNkt2WQ&oe=6AF9BD9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEcnt-6X6fsQ7kNvwECAGA8&_nc_oc=Adrph5zjrn-kt8EqkI6J2288nM0xh42VUWz7VFEPvnnzMGtUxWJSE-GlRmsfwO5s97A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMGnHzy8Lukjh5eU7DHB0d0MOmN5YIohF29e5lfx3oow&oe=6AF9E17C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
aA0&_nc_oc=AdpSXSeoMnwFWH-S_772BB8o1OzT0vpWuqUSpXra5TBbO_U48mLWEah-ADXOZXULqjM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ElVSowRlRyGeYGZJJ6el9KVDcgJzorNb83FDIIpWIIQ&oe=69FF2ADB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWi5bBjaVxIQ7kNvwGmW_q-&_nc_oc=AdqCtM7WR2ED4IJ7RWPi7oRkPqDPrmmrua8hY-IuyPDpXEGBYogbMiUUedn6d9quSjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qMjaTWysalGl-re-zo6YAnnsNM0xVbS7s_Qte5O54bw&oe=69FF2CF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4gmO-PHfmoQ7kNvwHNcPsW&_nc_oc=Adpgw_JT9rSJozBMCYdaz04cNJl1FbGl1iv3z3Kvrs3RSElQu02VQFDsuXuZbZPfQ9A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XhQPVZskP4M50ebEbx5PshKiWGviz1KFvn1gh66b6ig&oe=69FF4FE5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxthQxhqWbUQ7kNvwHmZA1w&_nc_oc=AdocD7zIG7IlyGPc3thLCgGjQ7yFX3hVSZXovwtZnQXAbBepQXvvY2Qys7sxH-e5lEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bINeqhw9kXGyBE1yBjGLku7_fr_ku7gkbHf2tgKymnw&oe=69FF409E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9ajvZ7IEH8Q7kNvwFvSXOJ&_nc_oc=Adrgi87j_eLwxgQ3B8JFsxzixoW0YdEeTnzpzsMX-8Um-FxuZUx3NSFi1TgjMc9oqNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oq7HUBHGH_eYLZwISww4qWZ_pAO28U_E3Tc1D4LbIcw&oe=69FF2C3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
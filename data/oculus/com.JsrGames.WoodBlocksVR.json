KKe&_nc_oc=AdoNDgDHbOO34D3Jajb8sudQwJzlahBPmqCJ_Ge_eWo212lV_kXIVXnMnzKyFZdd-tI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoh9WA1Im7xYzCAvV4PcdzmErPuMPW_yjbg3YX3OPM7Q&oe=6A6DE8DB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pl3IlQH2MMUQ7kNvwGpfs_P&_nc_oc=AdoBWou7CdqaGMdr_Ty_HlrAx6keEIYn8PQfJVxG8wpEZpQI5qIq_Gsqpj0iAnhVY3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjp0DtCcfg9Do-xFGM3gEMNOAW3vloQAUdkMb3ZXUN1A&oe=6A6DEAF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZR_V-SzpH8Q7kNvwFyQfoV&_nc_oc=AdoM2ojiJqGD_Eow6Honwh4FQqHhnPT-YoiQPLr6xG2alD369undB-le86U_EwomeRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD45l1FKDnVwDLmU8e7K5BS2NYt21TJkIJYSZTMIyK2QQ&oe=6A6DD5A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MTbyyFsBkUQ7kNvwEoKZv0&_nc_oc=AdotgtQ99IpL03MtFSmPCycAXMn0ga6zu41plUq-seWm45Sq9zRz-0uwtEBWZai57mc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWXwbLhYBHFNLSK26Gv8SgMsBR87uxduKLFPUj27lCAQ&oe=6A6DFE9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDk9F06JY4UQ7kNvwF88vEx&_nc_oc=AdoTt_TJExZAnL7ulIA5Iwg3pLgjsAoQDbHgJxPbkW-cJpNtV0a6iQEmdyuRfdR3Imw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0kRWZje6RcOF9jafV-Ha0R4Fg5Nrqo4RvxiXJKd48Zg&oe=6A6DEA3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
9qtO&_nc_oc=AdrLUCo2bTkESegBsYeMjC_n8FHxfRIVvu81MIOn6v5K_XoQpJMn-Cf7YSg0bU53Yto&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YmrOCEYLkxpfagon7ZYfxhXJi4W-rTGw3F1oQwfcdYQ&oe=6A392CDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvQ6xn2dDDAQ7kNvwF6xvUq&_nc_oc=AdqB-b-IoS5_ZyRDbs_1dlmMxP7NzBZSi3OhvEp6SEa2xVfkjpZBvUHSeMy-IJD1Zbs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lI5JoEBl2FuidZXItOZd2ycNQOq268YnIQLr5IfG5Ew&oe=6A392EF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77uyKSIvauAQ7kNvwFalsBb&_nc_oc=AdqxX19siBYe9Y9BuLzUWTlEPPtfna5Bnyl_Sxkd0lv1Ds1rk0h6zvHKncej_z4jI30&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_nPXQQAdMCpkRyg1i5OoYyOuJJrXVra1ziSqnavuJ3g&oe=6A3951E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dycF5Eh7WAwQ7kNvwF6ETyz&_nc_oc=AdrH3-PTFenl7eKM_-umRMah6FyHlwJUzS_Cc8GvbNnocH030slv4XMSt5gWAlSbGk0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S4PlWh3AxaWKQ2yy9DHX23VT1MWtvKgtHysRxiJkPyQ&oe=6A39429E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1HlDnSlF00Q7kNvwFIYR0B&_nc_oc=Adq8qUtdHMkZhpjYj2-xPLYwy0lGCSIq1xjYkWc1BoyId-7S9F8yZeh_V5nUP8_woNc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sTLvLnnEs9xUaazyw_DZhVYpi5QuGK16L0fB-YHpUkA&oe=6A392E3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.p
IFf&_nc_oc=Adp6HNQJGl1epcc63-YIcERiImawR51cqRcuTz9gewLKfAdPFU1ExC8OgV5BZMyEg6A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56Lv539-tAye1B84TOO8NnRVdD-MrbjwRJQmN87NNS1g&oe=6A1C2BDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYr-oOebuZgQ7kNvwGQfvD_&_nc_oc=AdqcQKfcqwL448v8Yfi0MmxyeItjY6N3qnj-0Dlk7edsMlqhYxokF4JspsaapUYQHDM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KaI7MmNzjqflzo6Eo16Qj__FsWDN4wRfuFCpxX5j6ng&oe=6A1C2DF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMQM3yopWVkQ7kNvwG7Inl6&_nc_oc=Adpc8PBg3XOjw5SEznQRO0JFNiUeEwqGpiil1FOBgriASlSiUpHBktIIZVyJETcqnyU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56YK3tA61hTKHSNYJA1n5GerucAk918LibZqvTUWqmCw&oe=6A1C50E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zp-WEXe5M7YQ7kNvwFWES2g&_nc_oc=AdoGPFOmZ1jJk2uyKm2w1fWPTaAO2DNOI5CegxWT7v4PeHpxy1s8yxsS5EYjVNoLiMk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BPMzocQa8wkcs6boZEVbC7bi2ikLWRVwSqB-v0YZBCw&oe=6A1C419E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn8QeV-8tq0Q7kNvwFx-Q67&_nc_oc=AdoE4IWt6qhM_BT_rmT4zu0ZqR-yfTL2z2Ag7XUTIASzVPLn8DEVxhri7lUjMLjkAzY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59YcMGI8JwukRr6fRXV6ODsnq2W8D84Z595X0QDh1DHQ&oe=6A1C2D3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfynP-WQtG67MdYmmL6uo7sjtX3mYSNeVmmN4IFaS-GdqQ&oe=69B3F225"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOJcXKQxuSYQ7kNvwFjLejd&_nc_oc=AdkkMiwblx_ZIC6b7nYKino60Zt8imGaZzfMc8LavciB9jtlYJzkprEB5O7IkOr5qbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEMfLl6SOwZRPFMGmYPx_8aD85__pk1-dsdY0lB6rMcg&oe=69B41B1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh9FUTi2f0QQ7kNvwElG74g&_nc_oc=AdnhWvwlJ4lnBHH4qA3hMOqM8fJfsGWwqsoiqBg2zjcVEoR5gjDlX-7FjueLhT4dhdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfytE_D-Ax8bqiFui23UGMNCNEDdqSm984LYxOf0-GQfNw&oe=69B406BC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr
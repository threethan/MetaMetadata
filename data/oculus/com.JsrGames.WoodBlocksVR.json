CXp&_nc_oc=Adpk_OjB30_ZUDdHiJsRKllJZEUIvJwDdXEUG1FU-fZ3upC3kADofPxtl8-wXmkCX-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNylW_jLZXIBwg09VItev9lmMKmrdkbB-6pIKpa77cXOg&oe=6AE1ECDB"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xfwwYjVCpwQ7kNvwEJ23R_&_nc_oc=Adp0M01fDAvCRrhbCJM_sde3JuHG8QacA-eO3g5IKDnfog6XifRN15iAlYj5lYgrN4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWCWcJTlMpAMiuAwXIGrK8RFCXiOW8zxdkOisFE87XYw&oe=6AE1EEF8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gkUnh4Bm-YQ7kNvwHYrIXw&_nc_oc=AdrR02z5X7t8MnFWhhHTEwCPpbvayV0AdZ3yIO2RdPovDgksPDN3j1NoT8rjRtHsnQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmMBgOJ8nVSsP3-mYVO8WEC2iVpyhsrt3Jy5oC9jaewA&oe=6AE211E5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6DAT6UdeXUQ7kNvwHLl23b&_nc_oc=AdrU6gt0fdbnQzYJjZR4YUI8xbqNCraRxqlwWKUqaoncm6jMmZP6OFLHG6UBOC5gj0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXEwGWbddt7Z_9kcdT9t74_wud3q4FCxVOc8Ggz9rOOw&oe=6AE2029E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4yy0UUZd6kQ7kNvwH9f47q&_nc_oc=Adpx84glGasc9iMx3Se2SOILHSOg5X947t-mFEeDRdHPMuzpuHbgIvjCwqGLO58eexo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe3HxP11hf_e1EjQWEAyfxwnEpl8e52xi4A-kEcDMx8w&oe=6AE1EE3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
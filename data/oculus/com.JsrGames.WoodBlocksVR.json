SW5kkhS8GVzfhA&oe=69F1E8A5"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cs039lm7uaUQ7kNvwGPWQ7K&_nc_oc=Adqkiu3Nw8qsRPsP2bHK4I7EBoParhGuckLM9lrGI6dXyE8ABXuCGAav0InJl2vpn8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ubJJrQWSWHqP5QajogbLLtZ2hX1YRi5EXjZ2pb8N1_Q&oe=69F2119E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fOAQMkJmpwQ7kNvwH13VGf&_nc_oc=AdrHosvfcHapBp85xsaUc4xb9RP0ClYzN2zd4NNZQaWb_dUJ45-7ytVSZ9yb4scH9Ck&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GpA4huWldJz6s88PuJjsykhQwPvoPgsa0kRSjAYcxnw&oe=69F1FD3C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "pu
6_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyk_o3novhIQ7kNvwFi0jcL&_nc_oc=AdlPjFv9suKTOmp1qhuyCwl0u_fyZ4rkPpOpJvHR1LZD8a1jL04GxQ6IYlmJZ6HHSAQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft66MQH1DQbIKhmMlfv61BS4-D3eQ50f3spH8R7MgERww&oe=69A59A9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URUrqH5iRbQQ7kNvwFVaRTl&_nc_oc=Adlyq2D9DUCL2mjYj2WUNskbhhsKf_d9P7qeiOVEs1R2thi2tM6qgTuETMq6N2R7cCw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftHxAcUbuQOEXPYUaS7-boYzN0uQ-sq78RUJAAGv4koMw&oe=69A5863C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
6_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g53GmmTcWEgQ7kNvwH2H3Bc&_nc_oc=Adk6xaGbUy7QmlFPied22toHSgwam-2M4VHW4N9oLuu_mzfhOAN-0Y7TglojGpZP0M4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdVlmozcSjsTqgEOHFXJQS5NnppYRjvcVXjme6Sz-SWA&oe=69A2F79E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_Jg54dXggkQ7kNvwFRQbac&_nc_oc=AdmYLtxnEUUbHls9Dkm_nbdF2sh66lUKdeS_aHem7MU6ltz16wXX76FlNYZc9MIKLsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsoFDHONcbrmTXFX07hMu2v-Nc0yFaPHdoVkhTGG-HXJA&oe=69A2E33C"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_
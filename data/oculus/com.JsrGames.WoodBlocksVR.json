u5l&_nc_oc=Ado-OJciM7CPhvQLxBjl_BESP5RsKWp74djwTKung_XoiWpWlFm8mDDXWtPM3OUxl94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5tc7JpiH889jB7dJKC9ucG58cjaYY2iX6VbGdtZFYhw&oe=6ACBBB9B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePPaqBLTevYQ7kNvwFOBJiw&_nc_oc=AdoE3vzejm0DmxflA6tVjO3zy5FN46jEx6xzJK5aUTE1OnvplyvkN_KlAm5gUtWPSog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-SFR97cGsQDY7URmAjvnjgeZaRiGDOmyIQOLQuqGzIQ&oe=6ACBBDB8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JW7R5-MZLMQ7kNvwFBx35i&_nc_oc=AdoKBglGRN8n4AfRn5UcAb3MbkuKP2UAUEysElHUAAHF1qXD0c-LEswix6hcfTsLaNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOBkYaHor-9vtXOOgiiblBPs_kPOm3pcZqa4SLaCPCEA&oe=6ACBA865"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOCGut-1A1MQ7kNvwFdk1l_&_nc_oc=AdqMHs6wcYnkavWvc6aye5AFgZg1KGIU97VRc-e93nLxh77jyCOzsTltUnzUb2nkexk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJc2zomIOEYRg4GyHKLs2osQR-5l734MpLP10cBshhIw&oe=6ACB991E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ry7Lo1f4Lq8Q7kNvwF4CmXC&_nc_oc=AdqUnzy7VF0Wy0zciVT9NhICrsY-YFvDJpCNhHNsNQgCrNVgrcs9AmYa9kk4xuq0U-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBa5q4xbfKH1VCZC7Y3kYbaajBMLL-9d-BfZQNxyK3-w&oe=6ACBBCFC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
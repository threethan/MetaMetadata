UmJ&_nc_oc=Adr1kCP1cCHVbESOfkixaXAlvtKVCRDAE-c0HFhqy3181BuywBJGbGTN2UHIJoHZYZg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJbgpEi72mRUTAVtbDa9CnK-coHrbsEZXMBX-DTmrs5w&oe=6AE8BC9B"}, {"file_name": "Screenshot3.png", "id": "1045952006707038", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031553_1045952010040371_4636869864718372597_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HV0nND_6if4Q7kNvwGuiwRq&_nc_oc=AdoKYp4f_57v5Y1TE3QjcwsLIc5rzBKeRLfHAU0NJf1vc559vfeW4-jPVCKfVYZ9K3U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6zO-O_nddx1dRgByTJr7LJQeqnRtIgNXsiBm_wh9wLQ&oe=6AE8BEB8"}, {"file_name": "Screenshot4.png", "id": "1067359567825763", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974516_1067359571159096_2841185050652458235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEQzhyerj10Q7kNvwG6SGFG&_nc_oc=AdonfYjTNlMy12R3KT3lwnN2I5Ws_zfIyMPhsMis12eh9MvIyoQBXJLSeSJdeLXz0to&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ZFKsWvBVqWyQ3zbIE8ymqI6_I-pI4_TRg5hUOHs8TQ&oe=6AE8A965"}, {"file_name": "Screenshot5.png", "id": "3698990077040167", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75269596_3698990080373500_1720394998717304410_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q60zQlgpSukQ7kNvwGOaR7b&_nc_oc=AdpxZz-EnK4wTHSGq4UfNr-kaI2RQhtSyMqbR4yebsi_Edsbmn7hPsXNQFBUmcXoqHo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpo-EPM2bpRAvH575PAMcX4PJLk1rzecytUu-oDIOMZw&oe=6AE89A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt2560x1440.png", "id": "1116343656386377", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974857_1116343659719710_5770378779130662727_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7Z0aH7VAzcQ7kNvwGTo4GX&_nc_oc=Adrd-kkLQN-8mLK--irVpJ8GDzzXERmW2ph5SCOdR2KVtn_xMLHm8w4cAg7aI2TY5r0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKm_S7CYkOFURSwsFm9UQXwfI5hat8ejZ5BumJQVf-Ag&oe=6AE8BDFC"}, "display_name": "Wood Blocks VR", "keywords": [], "long_description": "Get ready for an awesome adventure in virtual reality, right in the comfort of a bedroom! With special wooden blocks that are just waiting for your creative touch, you can build amazing structures and cool designs. And guess what? You can save all your awesome creation to show off later! But that's not all - you can also pilot a super cool zeppelin and fly it around using a remote control. It's like being in your own little world of fun and imagination! So, what are you waiting for? Let's dive in and have a blast!", "short_description": "Step into a magical virtual world inside a cozy bedroom! Use special wooden blocks to build anything you can imagine, save your creations, and even fly a cute little zeppelin with a remote control. Let your imagination run wild in this super fun game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.jsrgames.com.br/wood-blocks-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jsr Games", "support_website_url": null, "website_url": "https://www.jsrgames.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27846225865022570"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974635_1203845703918541_7883302446785572264_n.png?stp=d
eYf4Fnr-4N6GlfCIl2miGFdRAfokGL4nU0BaQ&oe=6AC66C02"}, {"file_name": "HighresScreenshot00000 4.png", "id": "1894702258165115", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673819499_1894702268165114_2249686591641073078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yana2JOycH8Q7kNvwGDjpPk&_nc_oc=AdqUIzyO5soYeKxn1-fLHvH1-MqLY1OGp0JthckPMMebK6Rh7DtsoZsFFO3LcizpHqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2Rp1LYjf0rA1MGHdYtTtOWtb34jhjUmEdC7rMjYSBQg&oe=6AC66EBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Utility Scale Solar Technician", "keywords": ["Utility", "Scale", "VR", "Immerselearn"], "long_description": "Utility Scale Solar Technician is an immersive VR training application developed as part of the ImmerseLearn Utility Scale Solar Technician certification program.\nDesigned to complement hands-on learning, the application provides students with realistic, interactive VR simulations that allow them to practice essential skills and procedures in a safe and controlled virtual environment. Learners can explore solar equipment, perform technician tasks, and build practical skills through immersive experiences.\nAccess is exclusive to students enrolled in the ImmerseLearn Utility Scale Solar Technician certification program. This application is intended specifically for enrolled students to support their hands-on training and learning experience.", "short_description": "Utility Scale Solar Technician is an immersive VR training application designed exclusively for students enrolled in the ImmerseLearn Utility Scale Solar Technician certification program. Practice essential solar technician skills in a realistic virtual environment and gain hands-on experience through interactive simulations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null
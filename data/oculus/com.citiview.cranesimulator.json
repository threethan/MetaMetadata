-2.oculuscdn.com/v/t64.5771-25/596061819_2179525802670972_6398964936514160069_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyKejwlIK0wQ7kNvwG0JUIV&_nc_oc=AdoTVJ79ndW2mQ3jst2EPe-tLCtvzSzrdgKTEwBgRgwK4ContGI3XLqofOAQKp-o8wI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9KJDnGEmer_aqlD1v_Je27f-iigPytIdtHgFwp34Cyg&oe=6AF1E4E7"}, {"file_name": "screenshot_3.png", "id": "1030554876682004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1030554880015337_529384878600033310_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jQwoTkAizMQ7kNvwH3Uubf&_nc_oc=AdqQEMF5IR9pmMMQb84n3HwZ6GurLmYZwAp_xgxLtYyqeb-hsWfA4D3V1qf_ue-pue4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtSKamu3hV6UdhU8nA7SI8dSWAgxQMwhse5ENVD8WtWQ&oe=6AF1D9AA"}, {"file_name": "screenshot_4.png", "id": "28350452054647908", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_28350452067981240_285528680953531671_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_cwDfkqJrcQ7kNvwHJtEGW&_nc_oc=AdrKLWvdvwmT7pJfc4FRDYpSN1V7GJ-9IjEDHEyeb0VkG9HY_ahotKpxiibLX8qa2QU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOyh3asOt4YdWI3HtKhM5YXTMoJBHMqNegHKU1MLmTcw&oe=6AF1F598"}, {"file_name": "screenshot_5.png", "id": "2250822609033312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596168449_2250822612366645_6514486123844722109_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXgsTk75L3YQ7kNvwF85uSF&_nc_oc=AdqCdCEk-o84HTub2dI7iTlcRYrOpAYUAdftAl5vVgIA906_5YzotM-bPIRqRQ8Z4E0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGlpqH1Q_elHgs7hV8xem0INQKHbLpScmN1wyjUms34A&oe=6AF1EE85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1391311499654429", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1391311502987762_1060655920509426263_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSmX0n7bp9QQ7kNvwGjTLVA&_nc_oc=AdqyWteWP_pncVQH39O3EsjZ8WODngxmFJOa2d4Ly7WIE2cTozwjKloYT1eDBbwpx_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7qIeDmDfENqKusL3F3t1l1oBh2wI0AWTXc7sve-Qm7A&oe=6AF20A3F"}, "display_name": "Crane Simulator Pro", "keywords": ["crane", "construction", "simulator", "building", "demolition"], "long_description": "The best seat on the construction site is 40 metres up.\n\nYOUR CAB, YOUR CONTROLS\nSit in a glass operator's cab high above a busy city. Reach out and grab the real joysticks with your hands, or use the thumbsticks. The left stick swings the jib and runs the trolley out, the right stick raises and lowers the hook. Tilt the whole cab forward on its hydraulic rams and look straight down through the floor window to the load below.\n\nREAL LOADS, REAL SWING\nEvery load hangs on its ropes like the real thing. Start and stop too fast and it swings. Ease it over, let it settle, and set it down softly. A live load-moment screen and a hook camera help you place it right on the mark.\n\nBUILD THE TOWER\nFour lifts finish a floor, and then the crew builds it under your eyes: the columns rise and the new deck closes over them. Steel beams, rebar, formwork, concrete, glass, a rooftop hot tub, a roof garden tree and the penthouse grand piano. The sun sinks toward golden hour as the tower grows, and the last lift of the game is the topping-out beam while the whole crew cheers.\n\nA CREW ON THE GROUND\nRiggers hook on your loads and wave you up, the banksman guides you onto each pad over the radio, and traffic flows through the city streets below.\n\nMORE TO DO\nSwing a wrecking ball through the old brick warehouse, race the clock in Rush Hour, or take every load into Free Lift and build anything you like. No timers in the career, and no way to fail. Just you, the crane and the view.", "short_description": "Climb 40 metres into the glass cab of a tower crane and build a skyscraper, one lift at a time. Grab the joysticks, swing the jib, run out the trolley and lower steel beams, glass and a grand piano onto the deck while your crew guides you in. Relaxing, tactile, and all yours."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/cranesimulatorpro/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/cranesimulatorpro/", "website_url": "https://citiview-games.pages.dev/cranesimulatorpro/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1262686563603983"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1782704562775923"}]}, "baseline_offer": {"id": "1782704562775923"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791309180, "status": "PUBLISHED", "id": "1782704562775923"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1283345861538053", "version": "1.0.1"}, "id": "1926012835040815", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1262686560270650", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1283345861538053"}, "release_s
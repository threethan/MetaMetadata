QX8Nu92yaNvUBuWkr-LSLsYyeNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQWNQoHS9usY1DP1I5CbqV0JtIbtdsLP3O92tRB090Ag&oe=6A620D29"}, {"file_name": "migrated_image.png", "id": "244518906574405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162772_1092371477446610_116866157_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtPjZ7-JTFkQ7kNvwE4-c25&_nc_oc=Adrezv6DPVtJwjmYDyIuVPeLINrkFSLnaaXdBLt0sHkydupXVrhFY80Xs_pTSBh4yiE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPhO3dpTTzZm9Q6WfyRQdUI2KutzLNW69fNHkAiQQJLw&oe=6A622664"}, {"file_name": "migrated_image.png", "id": "2607453922717768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162800_801777136579745_1058649118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQzbRclMRqMQ7kNvwFjC_JZ&_nc_oc=AdrQA4Ck1nU9Mv_lMCxec4Dkr8mU9-0qb1jyMV1eCFvz9-WpvxVUh1mYiAdOI98-_9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChXjn0rp-SRcloSj87e_mAGyVvur6yrLX-cbIBUivDow&oe=6A622BBD"}, {"file_name": "migrated_image.png", "id": "3920740217936184", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162776_936248429730701_159836398_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtLMRNffeTAQ7kNvwE57ZL1&_nc_oc=AdqzFNK_MFH2t_qQ-Q5dOcc545DbPPtvR6I0okfOmlfh8MB6UOGX9K5OPdhC47gJiZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAvAKIsKZBMf_KK029qPHBh5TsxArQ-d057kfWR-v9dA&oe=6A623257"}, {"file_name": "migrated_image.png", "id": "233626027774129", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162711_816664968416440_240915004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bdog_gJth5UQ7kNvwHoQcZP&_nc_oc=AdpnCawOevzmAUIFE8jjt_K-BXF4IscYtaF6fDQJuBXL7_yDABHAcS57B7QZqjDSbwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-GKNboNqn4j8ewnwWLfaK3fhlkiSLZxoUeXLC4pRYmQ&oe=6A6230B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InMind", "keywords": ["biology", "science", "education", "neurons", "neuroscience"], "long_description": "InMind is a short adventure with arcade elements designed for the Oculus VR. \n\nThis first demo allows the player to experience the journey into the patient's brains in search of the neurons that cause mental disorder. Submerge into the microworld and experience the miracles of the human mind. \n\nThe future is nigh. The humanity is standing upon the brink of a new era where modern healthcare makes tremendous scientific advancements. With the help of nanotechnologies a surgical prototype bathyscaphe allows its operator to shrink to a microlevel and travel inside the patient's body. \n\nA unique experimental project made by Nival to test the opportunities of the new Virtual Reality provided by Oculus Rift. ", "short_description": "InMind is a short adventure with arcade elements designed for the Oculus VR. Submerge into the microworld and experience the miracles of the human mind."}]}, "developer_name": null, "developer_privacy_policy_url": "http://en.nival.com/privacypolicy-us", "developer_terms_of_service_url": "http://en.nival.com/tos-us", "publisher_name": "Nival", "support_website_url": null, "website_url": "http://inmind.nivalvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "ADVENTURE", "CASUAL", "EXPLORATION", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "240683611550502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138817_551259671698686_383322475_n.png?stp=dst-png_s
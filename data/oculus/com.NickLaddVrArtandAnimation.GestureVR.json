ltUv0TCs1Rm5OrEgfBQ1mxQo2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3XnC6CQX3-yGuNoV-MvLwuiKISXWNtF5eSCwmAHUWbHw&oe=69F0BB66"}, {"file_name": "SC3.png", "id": "1778559479171385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_1778559482504718_7842261226032962691_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx0StJPdY0oQ7kNvwEObJZZ&_nc_oc=Adr-GH9qV7IkmI_0kPf2sduCg9-H4eFHN_g5hf2B6BW2vHEc3y7RHgeP7ut7RepnuuU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af36p0qwZN3X9wQARBnAMQ-V9flxtGYueiDoIf4qLuvdFQ&oe=69F0A4EA"}, {"file_name": "SC2.png", "id": "585274276684643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_585274280017976_232593605248725684_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfrNLd_CRRUQ7kNvwF8aaoy&_nc_oc=AdqAlO7gouq2oNjTlKDEx_h4iLZLvVPwOXWuWjYoT-aBE6TFdF7QSLkwxXMHNkiaQHg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1kQHmqVaXFUpx7eaA4Ku9vWA7VtddIvi7a6V-qF5WZ9g&oe=69F0B45F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_XkhSEGkX4Q7kNvwGlCpQu&_nc_oc=Adod2Jefao92ucYeYAIxIjmAlqKSPmg9uwA2W-t6Y8eA2J7i2cM423ABgHFLV6KWcZs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0mgRhPqwnYr1C2prsKuLGCtUGfEwYQG5ULtII7KTkGbQ&oe=69F0AD4D"}, "display_name": "Gesture VR", "keywords": [], "long_description": "Gesture VR is a drawing app with an emphasis on figure drawing. Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses. Practice alone or group up with friends!\n\n~Features~\n\n\u2022 Draw in 2D or 3D\n\u2022 Complete control over the light angle and pose duration\n\u2022 Group up with friends and draw together!\n\u2022 Draw your way with adjustable pen positioning found in the settings. \n\u2022 Over 100 photogrammetry-scanned models\n\u2022 Scale and rotate the drawing pad \n\u2022 Choose between 3 studio environments\n\u2022 Turn on and off nudity to make it streamer friendly\n\u2022 Support for Left and Right handed artists!\n\u2022 Capture and export your favourite sketches\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Gesture VR is a drawing app with an emphasis on figure drawing.  Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses.  Practice alone or group up with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nickladd.tv/gvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "531951988263795"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3257137134450135"}, {"status": "PUBLISHED", "id": "717079050549412"}, {"status": "PUBLISHED", "id": "878876323270107"}]}, "baseline_offer": {"id": "717079050549412"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "3257137134450135"}]
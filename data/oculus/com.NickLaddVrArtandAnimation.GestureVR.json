104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtQyodfZOUQQ7kNvwGgM9yt&_nc_oc=AdkKpTdm73QC2nUUwvZxkvv1X3NY-Rxlc2A8RI3oQ843opCf549n362b05qMHlh3E88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqllI-cP88HNU6UIoQsnBu6mYOZX-RaSCcv--n7mUusg&oe=699C5A81"}, {"file_name": "38974782_364345656398935_95227346211499558_n.png", "id": "608091604831942", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_608091608165275_8670850032465100818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGH3g_741J8Q7kNvwETLlX2&_nc_oc=AdmVcs4Q_CMuijPVEWEmIw5AhSQRvNd_YdHxVGPCWhphbpP9MbVv4JbzRUoCUYh2Slk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuVpqmjhGwGy01ktnRvJg8a3UpeR5xrXkdUr9RMgy_u2g&oe=699C5225"}, {"file_name": "39035466_1774953746307051_2057520495555447334_n.png", "id": "6875797342548790", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974692_6875797345882123_7293554530518219752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAabRRSQMVEQ7kNvwEhFG8s&_nc_oc=AdmY2aX-Z23oxe8FLjMa0eGVr0Aj7Y7Vd26WE29LKMNtNFMaUDJE1WmdoYgQv_wXW4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afuw5qQneNf1cdgAG-t5T1POQRbK-SX6iv07Dehf0dnA8g&oe=699C509E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c-FhbrYEikQ7kNvwFU1_-0&_nc_oc=AdlBycGxSb1S2zbQPQc5-vyzy_dS5ZFFcer5f5mkXzmmwzxyXgrqium0bRpejg6QEtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu6-ox3HXbSNadyTF-dOteW0M_HSskpz1vvzI5yvR_oMg&oe=699C4D4D"}, "display_name": "Gesture VR", "keywords": ["art", "drawing", "anatomy", "education", "painting"], "long_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. \n\n\ud835\udc05\ud835\udc04\ud835\udc00\ud835\udc13\ud835\udc14\ud835\udc11\ud835\udc04\ud835\udc12\n\n\u2022Drawing\nSketch in 2D or 3D with pressure-sensitive strokes for dynamic thickness and shading.\n\n\u2022Mixed Reality\nActivate passthrough to blend virtual models with your physical drawing space allowing you to draw with real pen and paper.\n\n\u2022Models\nChoose from 200+ models, including 3D-scanned human figures, skeletons, animals, statues, and anatomy guides.\n\n\u2022Guides\nLearn to life draw with a series of figure drawing guides by Stan Prokopenko of Proko.com.\n\n\u2022Modes\nFreeform Mode: Select from 200+ poses with customizable settings.\nGuided Mode: Engage in an hour-long drawing session with a single model.\nOpen Studio: A blank canvas for freehand drawing.\n\n\u2022Sketchbook\nGesture VR records each session in a digital sketchbook. Switch between the pages of your sketchbook with the arrows found on the paper pad.\n\n\u2022Multiplayer\nJoin up to three artists for a communal drawing session.\n\n\u2022Sharing\nCapture and export your 2D artwork as PNGs for sharing online.\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. Draw using our digital 2D and 3D tools or grab your sketchbook and draw in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gesture-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection
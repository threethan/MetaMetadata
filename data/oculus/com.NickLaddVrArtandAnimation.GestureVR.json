DGdNh0dlzlqwfw0ww7OID0AZpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afui0qNdmmHNhiGi3b9qv5HPYKAW1LLTIERWF2Ir00rARA&oe=6999B866"}, {"file_name": "SC3.png", "id": "1778559479171385", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_1778559482504718_7842261226032962691_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI_MygbYWtEQ7kNvwELKsOn&_nc_oc=AdkjojfDQEFvWiBm5H90_m7zW559-wpt7xYDlyDVQSrvNrQjK8h7-oImaIPElK72AIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvVRcYyV82ZzrstWNovSqvaxjZmCMujAAcoquRf-Cgvcg&oe=6999A1EA"}, {"file_name": "SC2.png", "id": "585274276684643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974676_585274280017976_232593605248725684_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgN7SyN5FugQ7kNvwGsfXg2&_nc_oc=Admq7w_RERxcHd_ya6qdVvEpH2br1gvE2SVaW3cxnSX6vUyEzECuqV7nu8y0uGIN2Tg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCowBxNVRyWp7c_0jcan5SuGIJXbr94GhuI-cTsq0ImA&oe=6999B15F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c-FhbrYEikQ7kNvwG762Ni&_nc_oc=Adlywy6iZWPZmRcfVwbJUEuDGRLAxpcneqrMD40qNdt-FhhNB0BpzL8HOK-wI2dyOMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVfIBHOIJWE95jUtsOJ1OYKcZXddhIiqBwMuY2M1mrDQ&oe=6999AA4D"}, "display_name": "Gesture VR", "keywords": [], "long_description": "Gesture VR is a drawing app with an emphasis on figure drawing. Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses. Practice alone or group up with friends!\n\n~Features~\n\n\u2022 Draw in 2D or 3D\n\u2022 Complete control over the light angle and pose duration\n\u2022 Group up with friends and draw together!\n\u2022 Draw your way with adjustable pen positioning found in the settings. \n\u2022 Over 100 photogrammetry-scanned models\n\u2022 Scale and rotate the drawing pad \n\u2022 Choose between 3 studio environments\n\u2022 Turn on and off nudity to make it streamer friendly\n\u2022 Support for Left and Right handed artists!\n\u2022 Capture and export your favourite sketches\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Gesture VR is a drawing app with an emphasis on figure drawing.  Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses.  Practice alone or group up with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nickladd.tv/gvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "531951988263795"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3257137134450135"}, {"status": "PUBLISHED", "id": "717079050549412"}, {"status": "PUBLISHED", "id": "878876323270107"}]}, "baseline_offer": {"id": "717079050549412"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "3257137134450135"}]
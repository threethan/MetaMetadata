S45L3i4E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQkoNX5PM5DZfPGQ5gNs0aIcBQ5ElY2tHtQvtcp2k6vZA&oe=6B0B3AF2"}, {"file_name": "39031450_1121122082670189_2099125296214425201_n.png", "id": "1347639389971016", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982630_1347639393304349_3096385629229870094_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CQK4_rpCoUQ7kNvwEy7YpF&_nc_oc=AdqKxjj-hkljYB5F9gomL80BQOu0zUZfi1dDT3b_DUNv4hHdxOXYkFduzavmfeKZr-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTw8z5NGvzl00lZfqiWX9XbKtulTTBJvDT_rgmljbtx3w&oe=6B0B13C1"}, {"file_name": "38974782_364345656398935_95227346211499558_n.png", "id": "608091604831942", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_608091608165275_8670850032465100818_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6iHMa5gTAQQ7kNvwGNiveD&_nc_oc=AdoeF4kvd-FMpVVbkRcBV2rlwbVdDbAOQ7Yj4ffrb748YCE52LRW2VeBVAlDFNunrJM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4iILEw5HPEkP01Jf23vvZH9cE3BRUrkcgwMjBOFnaQQ&oe=6B0B43A5"}, {"file_name": "39035466_1774953746307051_2057520495555447334_n.png", "id": "6875797342548790", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974692_6875797345882123_7293554530518219752_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aYwob-33UwQ7kNvwGmQZ6r&_nc_oc=AdqA7BeKgWD9WQIPAfd7TxYUmEbSKX7mJqFF6-tWpXfhBbCnxAsHsgi60_NL-cpJ_70&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTeqVjqZNR-jKe1xBdZmOAO32MQQllzB9-Lcoxx-ExY9g&oe=6B0B421E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ua0Tp6Ur1gQ7kNvwFEJJ2O&_nc_oc=AdqTVvBihxig9GhurjeGfWeDPmQr1gR1_rRxwyFWmLtuaQ1Srv1ePfESkOP4-aeWhiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqhvzCYjtsLqf4MSx7fboncBtlr-8w2AZUqhtEHghggw&oe=6B0B3ECD"}, "display_name": "Gesture VR", "keywords": ["art", "drawing", "anatomy", "education", "painting"], "long_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. \n\n\ud835\udc05\ud835\udc04\ud835\udc00\ud835\udc13\ud835\udc14\ud835\udc11\ud835\udc04\ud835\udc12\n\n\u2022Drawing\nSketch in 2D or 3D with pressure-sensitive strokes for dynamic thickness and shading.\n\n\u2022Mixed Reality\nActivate passthrough to blend virtual models with your physical drawing space allowing you to draw with real pen and paper.\n\n\u2022Models\nChoose from 200+ models, including 3D-scanned human figures, skeletons, animals, statues, and anatomy guides.\n\n\u2022Guides\nLearn to life draw with a series of figure drawing guides by Stan Prokopenko of Proko.com.\n\n\u2022Modes\nFreeform Mode: Select from 200+ poses with customizable settings.\nGuided Mode: Engage in an hour-long drawing session with a single model.\nOpen Studio: A blank canvas for freehand drawing.\n\n\u2022Sketchbook\nGesture VR records each session in a digital sketchbook. Switch between the pages of your sketchbook with the arrows found on the paper pad.\n\n\u2022Multiplayer\nJoin up to three artists for a communal drawing session.\n\n\u2022Sharing\nCapture and export your 2D artwork as PNGs for sharing online.\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. Draw using our digital 2D and 3D tools or grab your sketchbook and draw in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gesture-vr.com/privacy-policy
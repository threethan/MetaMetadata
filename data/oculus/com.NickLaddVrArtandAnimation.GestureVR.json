_1347639393304349_3096385629229870094_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9e2b4kjWsg8Q7kNvwE0XbYP&_nc_oc=AdqwzWHhmbTwsi1aMSvTrtpxUNzOf23a4AMVTAJ8mHlfi646dkU09UUrmCQTnaBwY8o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2Cf8vnzM_jcfGStFNpieqZfwHfxdlNIzM6SfgK4XxksA&oe=69F20C01"}, {"file_name": "38974782_364345656398935_95227346211499558_n.png", "id": "608091604831942", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974444_608091608165275_8670850032465100818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5InnOnuqUWYQ7kNvwGZtI4-&_nc_oc=AdpQjHgz5HCdJVawDA055WxIao4RHAaRKaU2VGIP_rcbayZ03ac8cY1197Xq6cEcX5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af07_HFNPnu-tPO3b1-UpxE0maSPo228OhoX5zS2wE4Vmg&oe=69F203A5"}, {"file_name": "39035466_1774953746307051_2057520495555447334_n.png", "id": "6875797342548790", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974692_6875797345882123_7293554530518219752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xc2HYa1KIEQ7kNvwGVXKG2&_nc_oc=AdpTuLn2TaarFYjKpNcsU0f6LM8VzlX0-oZUA7ytvDop8fv-KAO56n8o5qYlh3lQXUE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af11M18Reppyp-EUbBUd4XN3csmAnuDqgy861RaYnAuigw&oe=69F2021E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_XkhSEGkX4Q7kNvwF7kjOx&_nc_oc=AdoRLmacbkDeJ-2Z-scJ5Oq0FcrplvqDpxm6Gkl45oiXbDXM7UKIUSL6V_TvTeoKKtw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0SV4H53FiibINYoG-vUycumwin4pIijVjxpsn1KIr9jQ&oe=69F1FECD"}, "display_name": "Gesture VR", "keywords": ["art", "drawing", "anatomy", "education", "painting"], "long_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. \n\n\ud835\udc05\ud835\udc04\ud835\udc00\ud835\udc13\ud835\udc14\ud835\udc11\ud835\udc04\ud835\udc12\n\n\u2022Drawing\nSketch in 2D or 3D with pressure-sensitive strokes for dynamic thickness and shading.\n\n\u2022Mixed Reality\nActivate passthrough to blend virtual models with your physical drawing space allowing you to draw with real pen and paper.\n\n\u2022Models\nChoose from 200+ models, including 3D-scanned human figures, skeletons, animals, statues, and anatomy guides.\n\n\u2022Guides\nLearn to life draw with a series of figure drawing guides by Stan Prokopenko of Proko.com.\n\n\u2022Modes\nFreeform Mode: Select from 200+ poses with customizable settings.\nGuided Mode: Engage in an hour-long drawing session with a single model.\nOpen Studio: A blank canvas for freehand drawing.\n\n\u2022Sketchbook\nGesture VR records each session in a digital sketchbook. Switch between the pages of your sketchbook with the arrows found on the paper pad.\n\n\u2022Multiplayer\nJoin up to three artists for a communal drawing session.\n\n\u2022Sharing\nCapture and export your 2D artwork as PNGs for sharing online.\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. Draw using our digital 2D and 3D tools or grab your sketchbook and draw in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gesture-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PRODUCTI
i": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982630_1347639393304349_3096385629229870094_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASV-DXKvfjcQ7kNvwEybZwc&_nc_oc=AdqSA4ato15ciXgLpFQjQZ-zm8Ib0naElj_J5Y3ia0S4_6TsO92M6kzbjkpl7xqkgRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0ni3W9mCd5Fyqf7Cpk4bZh42WPE9I4tfcm3Wj8yKjmQ&oe=6AEB3781"}, {"file_name": "38974782_364345656398935_95227346211499558_n.png", "id": "608091604831942", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974444_608091608165275_8670850032465100818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5FqT70YKWsQ7kNvwHU-88s&_nc_oc=Ado8tqnOhDe7s1g_j9-nwVjznSfPV6xKo1F9qdgimuZWtmom4qvT-8vUMTamUzy_yPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvnNtpIbTF2OxARBqr0-n2flrz6EwiczZaQ0GTVpk3dw&oe=6AEB2F25"}, {"file_name": "39035466_1774953746307051_2057520495555447334_n.png", "id": "6875797342548790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974692_6875797345882123_7293554530518219752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThVkM3vdQocQ7kNvwG5f-Vw&_nc_oc=AdpuPZb_aPK6G-4qqKudSiIVvPJ6kJxnHV_weN-mtLqB6zIWcarWdns_XQaLn9r7PiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_61M6W1tBAjhQJlP61mnMptbExBWGO2w3cnDJ9ieGcg&oe=6AEB2D9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58bLKuOw9isQ7kNvwHtpASm&_nc_oc=AdpwV0cMGcu1UMaS7dIR7dF3U-PlLmPy-UmfHQULnyjqnYGeVzAFKAuEKhmKfC8a6gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSaBPtlOmYPJY76i3mKNqAiXLJoaQs3e_Ho1Fppt9LTA&oe=6AEB628D"}, "display_name": "Gesture VR", "keywords": ["art", "drawing", "anatomy", "education", "painting"], "long_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. \n\n\ud835\udc05\ud835\udc04\ud835\udc00\ud835\udc13\ud835\udc14\ud835\udc11\ud835\udc04\ud835\udc12\n\n\u2022Drawing\nSketch in 2D or 3D with pressure-sensitive strokes for dynamic thickness and shading.\n\n\u2022Mixed Reality\nActivate passthrough to blend virtual models with your physical drawing space allowing you to draw with real pen and paper.\n\n\u2022Models\nChoose from 200+ models, including 3D-scanned human figures, skeletons, animals, statues, and anatomy guides.\n\n\u2022Guides\nLearn to life draw with a series of figure drawing guides by Stan Prokopenko of Proko.com.\n\n\u2022Modes\nFreeform Mode: Select from 200+ poses with customizable settings.\nGuided Mode: Engage in an hour-long drawing session with a single model.\nOpen Studio: A blank canvas for freehand drawing.\n\n\u2022Sketchbook\nGesture VR records each session in a digital sketchbook. Switch between the pages of your sketchbook with the arrows found on the paper pad.\n\n\u2022Multiplayer\nJoin up to three artists for a communal drawing session.\n\n\u2022Sharing\nCapture and export your 2D artwork as PNGs for sharing online.\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. Draw using our digital 2D and 3D tools or grab your sketchbook and draw in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gesture-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id":
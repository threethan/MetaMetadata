D6--1OZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzsoa0H7xV_5RrjT_ukGQSO14FHfZ1G3BvJIGoRRhG1w&oe=6B085FB2"}, {"file_name": "39031450_1121122082670189_2099125296214425201_n.png", "id": "1347639389971016", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982630_1347639393304349_3096385629229870094_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=po6ZLTYL0z4Q7kNvwFa7Z55&_nc_oc=Adr0pTA6eACWmEGYBCiZX6DGmoDAKnvF7gWhej8SrsJ1tQycsEcxme2z259kqxoUy_I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVjfhsY_bGQ_ALlPiJoSfKcfLWm1Edv-zEYSgGpirLtA&oe=6B0870C1"}, {"file_name": "38974782_364345656398935_95227346211499558_n.png", "id": "608091604831942", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974444_608091608165275_8670850032465100818_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-UcbECY5wAQ7kNvwEG52Sv&_nc_oc=Adp25vlHKEPC8uOmvsaU8_xdBZkIOCt7HZ_Vz3jOpPM7Gx9aC4rLsULfPHnlsw-CMhI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd1hF3a2dkmUG-A0l0-Km1ZUgWNFox1BZGGLhPR46GOA&oe=6B086865"}, {"file_name": "39035466_1774953746307051_2057520495555447334_n.png", "id": "6875797342548790", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974692_6875797345882123_7293554530518219752_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlRHqWNehT4Q7kNvwHuDqng&_nc_oc=AdqxIkOZaFfYx4NkjQzkZhOQ5T24ueQbn2ooTwGB7pIk9xwaFDRcCMypzEDUfijGT5A&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0N3CzRVM7HgYURZFQ07cU_sY_z5JpUYhvv0F8sHVxJA&oe=6B0866DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEi1P3k-2RUQ7kNvwHM-pbz&_nc_oc=AdobG0HQB1ugn8ZgIJj3HHnYPVmPjAS9q5U8Mf_76ozrC8HcmKTdgV9qQDJn7KbF0Ag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRTuMeRRQjnvlXvfsRXGzNJHp8dEE97W4BntsrhJph5w&oe=6B08638D"}, "display_name": "Gesture VR", "keywords": ["art", "drawing", "anatomy", "education", "painting"], "long_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. \n\n\ud835\udc05\ud835\udc04\ud835\udc00\ud835\udc13\ud835\udc14\ud835\udc11\ud835\udc04\ud835\udc12\n\n\u2022Drawing\nSketch in 2D or 3D with pressure-sensitive strokes for dynamic thickness and shading.\n\n\u2022Mixed Reality\nActivate passthrough to blend virtual models with your physical drawing space allowing you to draw with real pen and paper.\n\n\u2022Models\nChoose from 200+ models, including 3D-scanned human figures, skeletons, animals, statues, and anatomy guides.\n\n\u2022Guides\nLearn to life draw with a series of figure drawing guides by Stan Prokopenko of Proko.com.\n\n\u2022Modes\nFreeform Mode: Select from 200+ poses with customizable settings.\nGuided Mode: Engage in an hour-long drawing session with a single model.\nOpen Studio: A blank canvas for freehand drawing.\n\n\u2022Sketchbook\nGesture VR records each session in a digital sketchbook. Switch between the pages of your sketchbook with the arrows found on the paper pad.\n\n\u2022Multiplayer\nJoin up to three artists for a communal drawing session.\n\n\u2022Sharing\nCapture and export your 2D artwork as PNGs for sharing online.\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Master figure drawing in your own virtual studio. Explore over 200 lifelike models, customize your lighting, and elevate your art with the power of virtual reality. Draw using our digital 2D and 3D tools or grab your sketchbook and draw in mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.gesture-vr.com/privacy-policy
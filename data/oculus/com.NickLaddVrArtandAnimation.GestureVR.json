ailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tqb935ijoSYQ7kNvwFVDU-k&_nc_oc=AdrvntQb4vFN-joBMqewqE8V0z0xui_PckT7burs7-ubbPO90aV_zKVpPTMBzkURrTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO0Hf6xuRuCWcWec7C3Z96ZlvGnZlWM5BffNZ7zJM_pg&oe=6AFB348D"}, "display_name": "Gesture VR", "keywords": [], "long_description": "Gesture VR is a drawing app with an emphasis on figure drawing. Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses. Practice alone or group up with friends!\n\n~Features~\n\n\u2022 Draw in 2D or 3D\n\u2022 Complete control over the light angle and pose duration\n\u2022 Group up with friends and draw together!\n\u2022 Draw your way with adjustable pen positioning found in the settings. \n\u2022 Over 100 photogrammetry-scanned models\n\u2022 Scale and rotate the drawing pad \n\u2022 Choose between 3 studio environments\n\u2022 Turn on and off nudity to make it streamer friendly\n\u2022 Support for Left and Right handed artists!\n\u2022 Capture and export your favourite sketches\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Gesture VR is a drawing app with an emphasis on figure drawing.  Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses.  Practice alone or group up with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nickladd.tv/gvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": "NOT_RATED", "com
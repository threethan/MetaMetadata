KaqHGZYTwHvgrS7mkYW3Bfclys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvvqyLx9r77SQ10x0RGddHEaQ5mCV0WDbHGXA4uR1zv9w&oe=699866E6"}, {"file_name": "SC3.png", "id": "1778559479171385", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974676_1778559482504718_7842261226032962691_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI_MygbYWtEQ7kNvwGujK13&_nc_oc=AdnkHLJtOsEDxt7ew0_rgR5GFdSzh0J2c7-aqnv_XUSDr1g8iA2azWfJVk1mn01jtQY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftCNJ2PLF0B6A1Tks1XOqOaVX2ahq64aTxRFxvqBHbpyQ&oe=6998506A"}, {"file_name": "SC2.png", "id": "585274276684643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_585274280017976_232593605248725684_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i86WQPJcWS0Q7kNvwF2ZnrR&_nc_oc=AdnCpcU90QKXD_j9MfEWjQ0SHhki9B1FNyjGVEvdnHovHjeleuj75g1vJurB2v1TWpA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsdK_F3a7G1Kd-bIiXA5oT_YGfFbczNwGPxnMAuX1DEyA&oe=69985FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SC4.png", "id": "462887172469532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001702_462887175802865_5796091747656159830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-JonnERCuMQ7kNvwF1idz8&_nc_oc=AdkeDfVbtYvVNUDMshK9l7LV6YdwiSYDR5B85Q4c1b3LxKGC0-HFgPqq7a8BEA6aqxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuNAnBPALrI2qbVwBizZ3urNdvqr2vjuGG4pfqRQ9PQ1Q&oe=699858CD"}, "display_name": "Gesture VR", "keywords": [], "long_description": "Gesture VR is a drawing app with an emphasis on figure drawing. Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses. Practice alone or group up with friends!\n\n~Features~\n\n\u2022 Draw in 2D or 3D\n\u2022 Complete control over the light angle and pose duration\n\u2022 Group up with friends and draw together!\n\u2022 Draw your way with adjustable pen positioning found in the settings. \n\u2022 Over 100 photogrammetry-scanned models\n\u2022 Scale and rotate the drawing pad \n\u2022 Choose between 3 studio environments\n\u2022 Turn on and off nudity to make it streamer friendly\n\u2022 Support for Left and Right handed artists!\n\u2022 Capture and export your favourite sketches\n(Android\\data\\com.NickLaddVrArtandAnimation.GestureVR\\files\\Images)", "short_description": "Gesture VR is a drawing app with an emphasis on figure drawing.  Draw in 2D or 3D from over 100 high-quality photogrammetry-scanned models and get complete control of the lights, timers, and poses.  Practice alone or group up with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nickladd.tv/gvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nick Ladd VR Art & Animation", "support_website_url": null, "website_url": "https://www.nickladd.tv/gesturevr", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "531951988263795"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3257137134450135"}, {"status": "PUBLISHED", "id": "717079050549412"}, {"status": "PUBLISHED", "id": "878876323270107"}]}, "baseline_offer": {"id": "717079050549412"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "3257137134450135"}]
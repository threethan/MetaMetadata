VwIOEwRNgyICDTPXbWTVjvFR4SdLGo21D_ZRoJhw&oe=6ADF4838"}, {"file_name": "Screenshot-9aee3d7e-e3e6-45e7-9c58-4e111e33ccb3.png", "id": "678807377719010", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254871_678807381052343_1200447438551898278_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBQiegLIWLcQ7kNvwFTOUwW&_nc_oc=AdrkorYrFn3_IU8v1BJERHgDFzCEiIF0iOAADSAztr3OKa7ghJXgDtS43i-PG1RIGL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlWK-Vgsy60oI-sGLY6MgezXOQDHH7u4XaatD-ISWa2Q&oe=6ADF767D"}, {"file_name": "Screenshot-d786126d-8ece-4e32-baa0-a17ca52bc7c5.png", "id": "1385075068857975", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031387_1385075072191308_3501645936122851081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdFU5PkIWOkQ7kNvwGDQ0H5&_nc_oc=Adp5h3LSCUqCYup5QDxXbo-Ljd6ws-XWs5oTJCUNxtLFlDQksIZa0jO1jYzHh_7z9UQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX-gMorNOU3kJtzMITBvREDJUx-Jzu9J_XRNT0mIdhcQ&oe=6ADF73DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PuzzLR_TrailerThumbnail_2560x1440.png", "id": "1078276894532822", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313107_1078276897866155_2442925271679496025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8S2NH6xTIXoQ7kNvwGv5nfy&_nc_oc=AdpKaEYXGaAFlWoThp4YJjZddhGmNi78zXVPhYSUQCd3PGzc-2R-ERlWiBP7eliT3zM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEiyxm62Dwv03ZybCxgS0BLaqP2s16eX-6KwNfwUqZrA&oe=6ADF4872"}, "display_name": "Puzz/LR", "keywords": [], "long_description": "# **The Archive of Lost Memories**\n\nIn the Archive, memories are kept as rooms you can walk through. You are its newest Archivist \u2014 and the Archive is coming apart.\n\n\n# **Book I: The First Archivist**\n\nSeven chapters. Seven memory-rooms belonging to Elara Voss, the woman who founded the Archive \u2014 from a childhood forest, to a buried temple with her name carved a thousand years too early, to a door standing open among the stars.\n\n\n# **Three ways to chase a clock**\n\n**Timed Mode** \u2014 Solve against a depleting survival clock. Every correct placement buys back seconds; hesitation spends them.\n\n\n**Solo VS** \u2014 Race head-to-head against a rival ghost. No lobby, no queue, no waiting \u2014 your opponent is already on the board.\n\n**Grand Prix** \u2014 A championship event: multi-lap timed rival races, scored across the full run.", "short_description": "Every puzzle you solve restores a lost memory. Rebuild the seven memory-rooms of the Archive's first Archivist in a voice-narrated story campaign \u2014 then race your rival ghost through timed trials and Grand Prix championships. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://puzz.world/index.cfm?event=main.privacy", "developer_terms_of_service_url": null, "publisher_name": "i-Team", "support_website_url": null, "website_url": "https://puzz.world/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28335915926092787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974704_1631637507227260_573673291672040665_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mAkXP1KgI0Q7kNvwEK5ixA&_nc_oc=Ado5TVcpe8oPIHBdxbPNbpswGJKqCUdj9j5tknlQe_Xf9b7_azikOBDpQ4Zaj7YRNhY&_nc_zt=3&_nc_ht=scont
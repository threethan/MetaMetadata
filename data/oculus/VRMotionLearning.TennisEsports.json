"asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25746711315029864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773431335, "id": "25750594557974873", "version": "2026.2.1.0a_603132017_FIR-2310", "version_code": 603132017, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25746711315029864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "553256016211576"}]}, "change_log": "\ud83d\udd04\ud83d\ude80\ud83c\udfbe Next-Gen Physics Are Here \u2013 Feel the Spin Like Never Before! Welcome to v2026.2.2.1, our advanced physics upgrade is now live. \u2728\n\nIn cooperation with Universities, we conducted structured research including controlled test series and physical measurements. Based on the collected data, we derived and implemented refined mathematical models to significantly improve spin and trajectory realism.\n\n\ud83c\udf81 New Features\n- Enhanced spin physics\n- Stronger and more realistic swing path influence on ball trajectory\n- Improved interaction between racket curve and spin generation\n\nThank you for helping us push VR tennis to the next level. \ud83c\udfbe\nYour Tennis Esports Team\n", "created_date": 1773400254, "id": "25746711315029864", "version": "2026.2.2.1", "version_code": 603131202, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25746711315029864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773398331, "id": "25746511528383176", "version": "2026.2.2.1", "version_code": 603131106, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25746711315029864"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1773348710, "id": "25741543872213275", "version": "2026.2.1.0a_603122122_FIR-2310", "version_code": 603122122, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
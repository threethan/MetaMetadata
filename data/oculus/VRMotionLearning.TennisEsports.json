ename": "AndroidBinary", "id": "28619019221132378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793978177, "id": "28619935054374128", "version": "2026.11.0.0a_develop_824", "version_code": 611061556, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28619019221132378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "553256016211576"}]}, "change_log": "Version 2026.11.0 brings updates to ranked PvP, private events, and Playstyle controls. It also fixes issues you may have noticed on court, in menus, and when watching replays.\n\n\ud83d\udcc8 Improvements\n\u2022 Private event lists now show which players are currently in a multiplayer match.\n\u2022 You can now leave a ranked PvP match before taking the court, but be aware that you\u2019ll lose points for leaving.\n\u2022 To trigger a Playstyle cue, hold Grip and click the thumbstick. Court side is the default cue setting.\n\n\ud83d\udee0 Bug Fixes\n\u2022 Fixed replays that could break after a rematch.\n\u2022 Fixed disappearing menus, profiles that failed to load, and issues with avatar catalog tabs and filters.\n\u2022 Fixed an issue that caused the sky to move when you turned your head.\n\nStep back on court and try the new Playstyle controls!\n\ud83c\udfbe Your Tennis Esports Team", "created_date": 1793973452, "id": "28619019221132378", "version": "2026.11.0.2", "version_code": 611061448, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28619019221132378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793969938, "id": "28618351277865839", "version": "2026.11.0.1", "version_code": 611061340, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28619019221132378"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793961897, "id": "28616992564668377", "version": "2026.11.0.0", "version_code": 611061108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
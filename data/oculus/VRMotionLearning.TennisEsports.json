0x1440.png", "id": "1351735028667744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031372_1351735032001077_7246146035196325895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMnUwvFbFM8Q7kNvwFE6pLW&_nc_oc=AdrNFnz9Ugwm5jylmYexWX4G9RZFr7QgFlro-VB7C4rt31ZnA5CuRHvlQ2W27sANQog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg45oPoe-CUvtDArU_vXyez3ArQMne7uwMO1fqorO8LQ&oe=6AE0B814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage_2560x1440.png", "id": "1477754659328730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982584_1477754662662063_6596429464770896767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5gzBcasp0gQ7kNvwHh8prY&_nc_oc=AdoCrvRDw7DfR1is-2cAZtBe6YwMiyG3CwOTnsq3_2WlZttREXMRt_rgBFgw3d6CoLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMC5xtWgbqn5yiwOCfhF883yn-2HxiEf61FmFA4Q3VJeg&oe=6AE0BFA2"}, "display_name": "Tennis Esports", "keywords": [], "long_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and leaderboard. Play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, real time technique analysis or receive coaching in VR.\n\nEnhance your experience and use the Tennis Racquet VR\u00a9, a 3D printed racquet handle that is weighted like a tennis racquet and become the best in the world in the Tennis Esports Pro Tour!\n\nTennis Esports gets everybody active and playing tennis from virtually anywhere!\nSimply download the app to join the Tennis Metaverse today!\n\nWant to chat with others? Got an idea for a new court? Tell the developers directly by going to our Discord server:\n https://discord.gg/nM7ecSjf", "short_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, or climb the rankings on the global leaderboards! \n\nJoin the Tennis Metaverse today with Tennis Esports!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis-esports.com/privacy-policy", "developer_terms_of_service_url": "https://tennis-esports.com/legal", "publisher_name": "VR Motion Learning", "support_website_url": "https://www.tennis-esports.com/contacts", "website_url": "https://tennis-esports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "549900073412151"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "3055107208017959"}, {"status": "PUBLISHED", "id": "4338848149732111"}, {"status": "PUBLISHED", "id": "2082887995801450"}, {"status": "PUBLISHED", "id": "900727632901139"}, {"status": "PUBLISHED", "id": "521690484000837"}, {"status": "CANCELLED", "id": "930659678822761"}, {"status": "PUBLISHED", "id": "834287584824208"}, {"status": "PUBLISHED", "id": "902688718132529"}, {"status": "PUBLISHED", "id": "359245393282211"}, {"status": "PUBLISHED", "id": "855987046147849"}, {"status": "PENDING", "id": "644830427819448"}, {"status": "CANCELLED", "id": "783560866669979"}, {"status": "PUBLISHED", "id": "701317758066658"}, {"status": "PENDING", "id": "1021203999147852"}, {"status": "PUBLISHED", "id": "750070716638751"}, {"status": "PUBLISHED", "id": "827007169424276"}, {"status": "PENDING", "id": "1008556620413263"}, {"status": "PUBLISHED", "id": "1213912406054525"}, {"status": "PUBLISHED", "id": "275773504836314"}, {"status": "PUBLISHED", "id": "739940111363728"}, {"status": "PUBLISHED", "id": "419038607526908"}, {"status": "PUBLISHED", "id": "8983078568401086"}]}, "baseline_offer": {"id": "3055107208017959"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783942500, "status": "PUBLISHED", "id": "3055107208017959"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28412562495111386", "version": "2026.10.1.3"}, "id": "553256016211576", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28412562495111386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "553256016211576"}]}, "change_log": "Version 2026.10.1 is here, because apparently bugs don\u2019t fix themselves, but we do.\n\n\ud83c\udfaf Bug Fixes\n\u2022 Fixed shots lacking power in some situations.\n\u2022 Fixed shots being incorrectly called as aces.\n\u2022 Fixed an issue with the Spectator Rankings.\n\n---\n\nWe\u2019ve been quiet for a while, but behind the scenes we\u2019ve been working on a long list of improvements for version 2026.10.0. This update brings your first unlockable player Skills and private events, alongside improved physics, performance, and fixes throughout the app.\n\n\ud83c\udf81 New Features\n\u2022 Unlock your first player Skills: Offensive, Defensive, and All Out Attack playstyles. These change court positioning, contact point, recovery style, and whether you take the ball earlier or later in its trajectory.\n\u2022 Adjust serve and return positions with the thumbstick, including diagonal movement, and save your preferred positions for subsequent points.\n\u2022 Earn Spectator Points when others watch your matches and climb the Spectator Rankings.\n\u2022 A new Spectator board shows how many people are watching and whether your match is live on Twitch.\n\u2022 Join private events and tournaments organized by Tennis Esports through Discord, bringing larger groups together for special ranked matches. Browse active, upcoming, and past events, and easily match up with fellow participants using predefined settings.\n\u2022 Find important information about playing Tennis Esports in the new central Info and Help area.\n\n\ud83d\udcc8 Improvements\n\u2022 Expanded the return movement area beyond the baseline and sidelines.\n\u2022 Simplified access keys to one gameplay key and one AI Commentary key. Buy keys in bulk at a reduced price, with existing keys automatically converted to the new types.\n\u2022 Players are now introduced on Twitch at the start of a match.\n\u2022 Each replay recording now contains a single match. Rematches start a new recording.\n\n\u269b\ufe0f Physics and Performance\n\u2022 Upgraded to Unity 6 incl. SDKs and package updates.\n\u2022 Improved performance throughout the app.\n\u2022 The ball can now rest and roll on your racket.\n\u2022 Reduced excessive ball spin.\n\u2022 Player movement now favors half-volleys over deep, low volleys.\n\u2022 Added environment collisions across stadiums, match and exercise courts, Mirrorplay and Hit \u2019EmAll.\n\n\ud83c\udfaf Bug Fixes\n\u2022 Fixed an issue where the Online Match UI sometimes failed to load.\n\u2022 Small thumbstick movements no longer block movement toward the ball.\n\u2022 Fixed several UI errors.\n\u2022 Fixed spectators in the stands appearing black or flickering.\n\u2022 Fixed the ball passing through the racket after a point was evaluated.\n\u2022 A long list of additional bug fixes and improvements throughout the app.\n\nReturn to court, explore the new playstyles, and try the improvements for yourself!\n\ud83c\udfbe Your Tennis Esports Team", "created_date": 1792682707, "id": "28412562495111386", "version": "2026.10.1.3", "version_code": 610221707, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28412562495111386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792680039, "id": "28412053791828923", "version": "2026.10.1.1", "version_code": 610221604, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28412562495111386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792676955, "id": "28411478085219827", "version": "2026.10.1.0a_develop_806", "version_code": 610221529, "release_status": "RELEASED", "status": "APPROVED", "binar
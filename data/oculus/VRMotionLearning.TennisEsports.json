s and improved multiplayer experience.\nYour Tennis Esports Team \ud83c\udfbe", "created_date": 1782296442, "id": "26932254466475537", "version": "2026.6.1.4", "version_code": 606241201, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26932254466475537"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782294702, "id": "26932032619831055", "version": "2026.6.1.3", "version_code": 606241135, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26932254466475537"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782293382, "id": "26931874556513528", "version": "2026.6.1.2", "version_code": 606241121, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
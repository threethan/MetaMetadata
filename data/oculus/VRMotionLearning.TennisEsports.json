cb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnBHiz1BTdEQ7kNvwHaNLas&_nc_oc=AdkVB_biPcsYC3qFmPeAcwpOLxqBGjYOXZsvhmkfIFfTCAdvmgMGyaeqKhph9uSN-xY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1NQfqXzOKbRKUxmI4KZlhV3oOMGJeR0R4Ty9RSOtkiA&oe=69A04F32"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1351735028667744", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031372_1351735032001077_7246146035196325895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfgWiLAI-usQ7kNvwE3795K&_nc_oc=AdmIwiEKNpE1xZ36aTHkS8jDIfaw7yvvEHxUG2p5U1XEg8EzybbtvRm6YPp1vqROj8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsL1UxoQOpRv8CNJLpFgbhhlz-FYQa7zyoZ8d0joP6_3w&oe=69A02354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage_2560x1440.png", "id": "1477754659328730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982584_1477754662662063_6596429464770896767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtCd4DbgFEQQ7kNvwFHMBM_&_nc_oc=AdnC62sQGsl6lPXHQMMm8pZ0aJbG--VGhzl124Ib_xTf6DvR4rpOwX5fKGX2ylozkH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZXHzdn__TlfXXdlz_aJiLaP4ODtVOY8D8ZBUEtw5gOA&oe=69A02AE2"}, "display_name": "Tennis Esports", "keywords": [], "long_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and leaderboard. Play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, real time technique analysis or receive coaching in VR.\n\nEnhance your experience and use the Tennis Racquet VR\u00a9, a 3D printed racquet handle that is weighted like a tennis racquet and become the best in the world in the Tennis Esports Pro Tour!\n\nTennis Esports gets everybody active and playing tennis from virtually anywhere!\nSimply download the app to join the Tennis Metaverse today!\n\nWant to chat with others? Got an idea for a new court? Tell the developers directly by going to our Discord server:\n https://discord.gg/nM7ecSjf", "short_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, or climb the rankings on the global leaderboards! \n\nJoin the Tennis Metaverse today with Tennis Esports!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis-esports.com/privacy-policy", "developer_terms_of_service_url": "https://tennis-esports.com/legal", "publisher_name": "VR Motion Learning", "support_website_url": "https://www.tennis-esports.com/contacts", "website_url": "https://tennis-esports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "549900073412151"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PENDING", "id": "4338848149732111"}, {"status": "PUBLISHED", "id": "2082887995801450"}, {"status": "PUBLISHED", "id": "900727632901139"}, {"status": "PUBLISHED", "id": "521690484000837"}, {
: "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974448_1101030917158879_5334321293078676495_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_wqSKWGI-YQ7kNvwG1UfiZ&_nc_oc=Adrdkdzhq2DhGU8ovk3aK-QlSC89nK3rG1-pXP3_opGf8yIYBmKpfdBiRf_SGCn0PeU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QUKqRm8jnLHsRkwKaPCSWh_THlex9EJpwZ6sGfTcJZA&oe=6A1301B2"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1351735028667744", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031372_1351735032001077_7246146035196325895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Isn2ElsiPlEQ7kNvwFNB0yu&_nc_oc=Adq-8LAtVn6oUaIJuTXci09H9w6AYgoLwo3Pr9k7JclbN7N-26y3RtZWT4gizvGYnpI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yLHSA7dQjmSCKI9LLix2X0tcT16YT1kTUPS3oEjYsTw&oe=6A130E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage_2560x1440.png", "id": "1477754659328730", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982584_1477754662662063_6596429464770896767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIGXJPJfcBYQ7kNvwHBpKE4&_nc_oc=AdodmzRYGVtVz1H_nbOIAykqpLnr6mtBnpGW2I1W9euRiktVqqyMRlq-NI0JEnGGyXk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af493j5OxEqht0xsnoLzmrr6OvGP0_zQMq_l_lzYneP2kA&oe=6A1315A2"}, "display_name": "Tennis Esports", "keywords": [], "long_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and leaderboard. Play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, real time technique analysis or receive coaching in VR.\n\nEnhance your experience and use the Tennis Racquet VR\u00a9, a 3D printed racquet handle that is weighted like a tennis racquet and become the best in the world in the Tennis Esports Pro Tour!\n\nTennis Esports gets everybody active and playing tennis from virtually anywhere!\nSimply download the app to join the Tennis Metaverse today!\n\nWant to chat with others? Got an idea for a new court? Tell the developers directly by going to our Discord server:\n https://discord.gg/nM7ecSjf", "short_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, or climb the rankings on the global leaderboards! \n\nJoin the Tennis Metaverse today with Tennis Esports!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis-esports.com/privacy-policy", "developer_terms_of_service_url": "https://tennis-esports.com/legal", "publisher_name": "VR Motion Learning", "support_website_url": "https://www.tennis-esports.com/contacts", "website_url": "https://tennis-esports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "549900073412151"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "4338848149732111"}, {"status": "PUBLISHED", "id": "2082887995801450"}, {"status": "PUBLISHED", "id": "900727632901139"}, {"status": "PUBLISHED", "id": "521690484000837"}, {"status": "CANCELLED", "id": "930659678822761"}, {"status": "PUBLISHED", "id": "834287584824208"}, {"status": "PUBLISHED", "id": "902688718132529"}, {"status": "PUBLISHED", "id": "359245393282211"}, {"status": "PUBLISHED", "id": "855987046147849"}, {"status": "PENDING", "id": "644830427819448"}, {"status": "CANCELLED", "id": "783560866669979"}, {"status": "PUBLISHED", "id": "701317758066658"}, {"status": "PENDING", "id": "1021203999147852"}, {"status": "PUBLISHED", "id": "750070716638751"}, {"status": "PUBLISHED", "id": "827007169424276"}, {"status": "PENDING", "id": "1008556620413263"}, {"status": "PUBLISHED", "id": "1213912406054525"}, {"status": "PUBLISHED", "id": "275773504836314"}, {"status": "PUBLISHED", "id": "739940111363728"}, {"status": "PUBLISHED", "id": "419038607526908"}, {"status": "PUBLISHED", "id": "8983078568401086"}]}, "baseline_offer": {"id": "4338848149732111"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772007180, "status": "PUBLISHED", "id": "4338848149732111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26414253068275682", "version": "2026.5.0.0"}, "id": "553256016211576", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26414253068275682"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "553256016211576"}]}, "change_log": "\ud83d\udd04\ud83c\udfbe\u2728 Welcome to v2026.5.0.0 - Get ready for another update focused on improving the competitive experience, performance, and social gameplay in Tennis Esports. This version introduces long-awaited ReMatch functionality for unranked matches, improvements to ranked point calculations, and several important bug fixes.\n\n\ud83c\udf81 New Features\nUnranked ReMatches are now available. Continue playing instantly with your friends after an unranked match.\nAdded new in-game information regarding the Race to Championships 2026 qualification system.\n\n\ud83d\udcc8 Improvements\nImproved Ranked Match point calculations for more accurate ranking adjustments.\nThe point reward you get for a victory is now also dependent on your opponent's ELO rating. This should guarantee a proper reward for beating strong opponents, even if they haven't collected any event points yet.\nAdditionally, if two players play each other multiple times during an event, the points exchanged diminish with every match, avoiding large point swings towards the end of the event. \nUnder-the-hood optimizations to reduce memory usage and improve overall performance and stability.\n\n\ud83c\udfaf Bug Fixes\nFixed cases where serves could incorrectly result in a false ace.\nFixed an issue where the \u201cUnit System\u201d setting was not properly saved in some situations.\n\nThank you for shaping the future of VR tennis with us! We\u2019ll see you on the court.\ud83c\udfbe\nYour Tennis Esports Team\n", "created_date": 1778698897, "id": "26414253068275682", "version": "2026.5.0.0", "version_code": 605132026, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26414253068275682"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778681204, "id": "26411392295228426", "version": "2026.5.0.0b_605131558_FIR-2320", "version_code": 605131558, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26414253068275682"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778679464, "id": "26411109885256667", "version": "2026.5.0.0b_605131528_FIR-2320", "version_code": 605131528, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26414253068275682"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778677302, "id": "26410763175291338", "version": "2026.5.0.0b_605131452_FIR-2320", "version_code": 605131452, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2641
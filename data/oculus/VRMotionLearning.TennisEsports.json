4285107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrXFGDc67jcQ7kNvwHdmF3l&_nc_oc=AdmGkuq3nI7waIBmNpbTTwbj51UlGf1oY6NdZDW5lbkNRNi_DEvNMLv31uzdM3m2g1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afufmys-Lt64Y2q4lLXrGxH2pfY40KV28yrmFLETyrBeAA&oe=699AEA2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440.png", "id": "1127069095849699", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1127069099183032_5174951047094773110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQVIjaR1TWkQ7kNvwGqlcRI&_nc_oc=Adnm1TU8kt43lmjQgxaNKPgzvy8Gn0Y0V8xdR9oiJTHDyTuajyUPr3qgTBCjfHKp7BI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftSwdPPrb-CRyNNE8GZkV5n0vpRWSNB7-Mv1873mFMzNQ&oe=699B127F"}, "display_name": "Tennis Esports: Fun, Social, Competitive", "keywords": ["Physics", "Multiplayer", "Racket", "Fitness", "Sports"], "long_description": "**Tennis Esports** offers everything you need to play tennis in a vibrant virtual tennis world.\nPlay casual or competive matches against real people or AI. Customize your avatar and socialize with players from all over the world.\n\n{841446012015456}\n\ud83c\udfbe Match up in the **Tennis Esports Arena** with real people online (casual and competive), or challenge AI opponents\n\n{1323175872915083}\n\ud83d\udc55 Visit the **in-game shop** to gear up and style yourself with exclusive outfits \n\n{864706189272692}\n\ud83c\udf0e Enter the  **Social Club** to meet people from all over the world\n\n{1994151444461772}\n\ud83c\udfae Check out the **Arcade** where you can play **HitEmAll** against time and **MirrorPlay** against yourself\n\n{1121656599862661}\n\ud83c\udfc6 Join the **Tennis Esports Tour** and compete in events for tour points and trophies (*requires **ELITE** subscription)\n\n{1980867525791989}\n\ud83d\udcc8 Train using courses & exercises, then enter the **PlayGround** to define your own ball sequences and setup\n\n{1392305242553142}\n\ud83d\udcd0 Enter the **TechZone** to analyze and train forehand and backhand strokes based on scientific research (*requires ELITE subscription)\n\n\nWe also invite you to **become a part of our community on Discord**. It's fun!\nhttps://discord.gg/8rcSArKJD4", "short_description": "Enjoy tennis in a vibrant virtual world with Tennis Esports!\nPlay casual or competitive matches against real people or AI opponents. Customize your avatar and socialize with people from all over the world in the social club.\nAccess training courses, arcade games, and the TechZone for forehand/backhand training.\nUpgrade to ELITE later to take part in the Tennis Esports Tour.\nJoin our Discord: https://discord.gg/8rcSArKJD4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis-esports.com/privacy-policy", "developer_terms_of_service_url": "https://tennis-esports.com/legal", "publisher_name": "VR Motion Learning", "support_website_url": "https://www.tennis-esports.com/contacts", "website_url": "https://tennis-esports.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25205212462513088"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_764985839966384_3970221910558927769_n.png?stp=dst-png_s360x360&_nc_
g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz0B3OjcvIoQ7kNvwETyGYV&_nc_oc=AdnpbvzR2AToYSl8AwpPOinGt6dy6oCKwjkC7Xt-Cm-JO3zDLjaF-SQowCDjqVBrxTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjEFSrvU9EP5maD7UkLS6rVQ9UnGXOnbKAWrnwsftv_w&oe=69A6E825"}, {"file_name": "Screenshot_06_2560x1440.png", "id": "1418447955596834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570305_1418447958930167_1033562964254285107_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMHzO5rEXwEQ7kNvwEESk3t&_nc_oc=Adke5jAK1dCQ3q3EV57HSovhL_BFFi-bT8TWMfv2eyBMX1Aq0aXp6NQNIqWLe-3FBIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-2VVDAwTljPCcSreOKXapkzZy7cXJ8o5R1P_Qbd_PPw&oe=69A6C7AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440.png", "id": "1127069095849699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_1127069099183032_5174951047094773110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2skiJLXYh0Q7kNvwFtMbDQ&_nc_oc=Adkvh84redMB-u_L3_U5rKWwY9_5lJTJmUwXNnyfW-l4KnTWZ9zPnSh7iWC8QsHY0pc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHjpOIMJwrbhl1sIR-5O87o9toy6goxcMr7SZL5TUiIg&oe=69A6EFFF"}, "display_name": "Tennis Esports: Fun, Social, Competitive", "keywords": ["Physics", "Multiplayer", "Racket", "Fitness", "Sports"], "long_description": "**Tennis Esports** offers everything you need to play tennis in a vibrant virtual tennis world.\nPlay casual or competive matches against real people or AI. Customize your avatar and socialize with players from all over the world.\n\n{841446012015456}\n\ud83c\udfbe Match up in the **Tennis Esports Arena** with real people online (casual and competive), or challenge AI opponents\n\n{1323175872915083}\n\ud83d\udc55 Visit the **in-game shop** to gear up and style yourself with exclusive outfits \n\n{864706189272692}\n\ud83c\udf0e Enter the  **Social Club** to meet people from all over the world\n\n{1994151444461772}\n\ud83c\udfae Check out the **Arcade** where you can play **HitEmAll** against time and **MirrorPlay** against yourself\n\n{1121656599862661}\n\ud83c\udfc6 Join the **Tennis Esports Tour** and compete in events for tour points and trophies (*requires **ELITE** subscription)\n\n{1980867525791989}\n\ud83d\udcc8 Train using courses & exercises, then enter the **PlayGround** to define your own ball sequences and setup\n\n{1392305242553142}\n\ud83d\udcd0 Enter the **TechZone** to analyze and train forehand and backhand strokes based on scientific research (*requires ELITE subscription)\n\n\nWe also invite you to **become a part of our community on Discord**. It's fun!\nhttps://discord.gg/8rcSArKJD4", "short_description": "Enjoy tennis in a vibrant virtual world with Tennis Esports!\nPlay casual or competitive matches against real people or AI opponents. Customize your avatar and socialize with people from all over the world in the social club.\nAccess training courses, arcade games, and the TechZone for forehand/backhand training.\nUpgrade to ELITE later to take part in the Tennis Esports Tour.\nJoin our Discord: https://discord.gg/8rcSArKJD4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis-esports.com/privacy-policy", "developer_terms_of_service_url": "https://tennis-esports.com/legal", "publisher_name": "VR Motion Learning", "support_website_url": "https://www.tennis-esports.com/contacts", "website_url": "https://tennis-esports.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
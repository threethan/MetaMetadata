: "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974448_1101030917158879_5334321293078676495_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9KHPyKeyl0Q7kNvwGBjVdG&_nc_oc=AdqiYIRfw9gMcyZLIt0ckdHREQauGSHWacC2jhY8J7oIgwDZoj1tDibqJ8fJaAfai7E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZpK6vIYlnC_VmxtGTCTtc5ZqHuhNlsgvhUBPMi-wiMA&oe=6A26C832"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1351735028667744", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031372_1351735032001077_7246146035196325895_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbcB4xGViigQ7kNvwFtUX2q&_nc_oc=Adqv78N606zm82XOrd-LxV25AL28lnvNhFUk5kYbh2Zyab5dQQGmJrEQk5au2VBP1bw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96rVCp3WDE84uo84VbzE5_g2-7-zkQEJEyE7LZwgW5XA&oe=6A26D494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage_2560x1440.png", "id": "1477754659328730", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982584_1477754662662063_6596429464770896767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNRyCoqN_lQQ7kNvwGMYj3Y&_nc_oc=AdqZ9VTmOdCK_EvaWc22YoWiJ5m93zKM7YseAKJIeSKS5yKaLldnak3U9uq-n2geVTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--wmlg8yGKPtyRkmkdMctab44eoIPLglKQPD0Hu3T-VA&oe=6A26DC22"}, "display_name": "Tennis Esports", "keywords": [], "long_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and leaderboard. Play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, real time technique analysis or receive coaching in VR.\n\nEnhance your experience and use the Tennis Racquet VR\u00a9, a 3D printed racquet handle that is weighted like a tennis racquet and become the best in the world in the Tennis Esports Pro Tour!\n\nTennis Esports gets everybody active and playing tennis from virtually anywhere!\nSimply download the app to join the Tennis Metaverse today!\n\nWant to chat with others? Got an idea for a new court? Tell the developers directly by going to our Discord server:\n https://discord.gg/nM7ecSjf", "short_description": "Tennis Esports simulates and feels like real tennis for both tennis players, gamers and fans to enjoy Tennis in the VR Metaverse.\n\nJoin our global community and play live matches, arcade target games in any stadium you can imagine or even play against yourself with MirrorPlay\u00a9.\n\nPractice your virtual and physical game from beginner to advanced tutorials, or climb the rankings on the global leaderboards! \n\nJoin the Tennis Metaverse today with Tennis Esports!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tennis-esports.com/privacy-policy", "developer_terms_of_service_url": "https://tennis-esports.com/legal", "publisher_name": "VR Motion Learning", "support_website_url": "https://www.tennis-esports.com/contacts", "website_url": "https://tennis-esports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "549900073412151"}}]}, "scheduled_offers": {"count": 21, "nodes": [{"status": "PUBLISHED", "id": "4338848149732111"}, {"status": "PUBLISHED", "id": "2082887995801450"}, {"status": "PUBLISHED", "id": "900727632901139"}, {"status": "PUBLISHED", "id": "521690484000837"}, {"status": "CANCELLED", "id": "930659678822761"}, {"status": "PUBLISHED", "id": "834287584824208"}, {"status": "PUBLISHED", "id": "902688718132529"}, {"status": "PUBLISHED", "id": "359245393282211"}, {"status": "PUBLISHED", "id": "855987046147849"}, {"status": "PENDING", "id": "644830427819448"}, {"status": "CANCELLED", "id": "783560866669979"}, {"status": "PUBLISHED", "id": "701317758066658"}, {"status": "PENDING", "id": "1021203999147852"}, {"status": "PUBLISHED", "id": "750070716638751"}, {"status": "PUBLISHED", "id": "827007169424276"}, {"status": "PENDING", "id": "1008556620413263"}, {"status": "PUBLISHED", "id": "1213912406054525"}, {"status": "PUBLISHED", "id": "275773504836314"}, {"status": "PUBLISHED", "id": "739940111363728"}, {"status": "PUBLISHED", "id": "419038607526908"}, {"status": "PUBLISHED", "id": "8983078568401086"}]}, "baseline_offer": {"id": "4338848149732111"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772007180, "status": "PUBLISHED", "id": "4338848149732111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26678751481825838", "version": "2026.5.2.0"}, "id": "553256016211576", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26678751481825838"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "553256016211576"}]}, "change_log": "\ud83d\udd04\ud83c\udfbe\u2728 Welcome to v2026.5.2.0!\n\nThis update brings ranked event rematches, refreshed experimental physics, a new way to manage your favorite players, and an important fix for weekly event transitions.\n\n\ud83c\udf81 New Features\n - Added a new Favorites Panel to make it easier to keep track of your favorite players\n - Ranked rematches: The first two matches against each opponent in an event now offer a rematch option, giving players more chances to continue great matchups \n\n\ud83e\uddea Physics Experiment\n - Updated the experimental physics based on testing and player feedback. Activate it in the settings menu, test the latest gameplay changes, and let us know what you think.\n\nPlease share your feedback in the Discord channel #general-feedback.\n\n\ud83c\udfaf Bug Fixes\n - Fixed an issue that could occur during weekly event transitions while the matchmaking panel was open\n - Various small bug fixes and stability improvements\n\nThank you for helping us improve Tennis Esports step by step. See you on court! \ud83c\udfbe\nYour Tennis Esports Team\n", "created_date": 1780500047, "id": "26678751481825838", "version": "2026.5.2.0", "version_code": 606031604, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4872542182873415", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26678751481825838"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780495065, "id": "26677901968577456", "version": "2026.5.2.0a_606031526_FIR-2327", "version_code": 606031526, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "Androi
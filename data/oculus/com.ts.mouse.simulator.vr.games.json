Uw&oe=69D0FBCD"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L57vLkTiBRcQ7kNvwFfYugU&_nc_oc=AdoEDC6Os-DZ1GT1UaJqyzWol5qp6O9eK_1fmvOboXdZJPkRPhcwgcYiI5bx4aXibGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIAx8svyHzx0JlzAXJGXPNja-rLRgfBfqyktOCIhgsFg&oe=69D12263"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjy23jfJwcAQ7kNvwEyultx&_nc_oc=Adr9ETcKW9pral3PjXo77KC_RAgLhfConUym735vvu7AEdERwNM87h24c8xz_qGq-Po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3FGDHrq8iU77rTnwwws-bPcIZfv2LgoT3c3wUQpRLvA&oe=69D0F5D3"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfWl752h7pwQ7kNvwGwBbnB&_nc_oc=Adp9A-_aPXQ3f76ZjXaBo0rnMdkDWDc2C9Ga5NgjeyZP4xKErEcZWchkKDqxh3JpoEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9SXkoe-p9EP2GvLyagRXpwJDvxvecHbdVMq2XJBevCw&oe=69D110FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct58QNbDlLQQ7kNvwF9FOdV&_nc_oc=AdoBbcbjQUsYh7W2Uu5qvcYlt0_4qTmUN0bYsnCmHCdUV6Vvx7L4x1cAeWLUtYRPJWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvlMMxuqaw2fl29KHBFNOvBoExMHlhlFD990EjH4iwNw&oe=69D11D44"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"i
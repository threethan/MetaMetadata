g", "id": "1064278595152859", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618444_1064278598486192_6608726600079685729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIz5xOwyUCMQ7kNvwHoGt7D&_nc_oc=Adppdv94muCpMkTFrFN4WQVO1orMSkD4xGVzcUfi_IYE5UaRvLhE7wHtVSRowLuKU80&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PwoYARLWSfG2y_9MA6I-UWzZKGKrwk3iWCTceG5Allg&oe=6A46898D"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzK4ULGT7J0Q7kNvwGZkcZz&_nc_oc=AdpI82qe17L0SsMevAciWqOo3funrM2-1X61CoxUyHNcxLTPJt6MRyZDgWPuCKV7iDU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--gJHr1tRO17j5sPPCATeqPlFjmge3CvEjGapi8dX-qA&oe=6A4677E3"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_eUMj4HVUkQ7kNvwEVBv9J&_nc_oc=AdpXwmOVzJncKtWBiSTr21R1Br6fAL_T3B-8NngbvnQXGWANNvWVJxrlnGoIZLUQK8A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HztELa0B8KnXdqAYHFrXF_gYBBdyMFp6t7LoUXp0ckw&oe=6A468393"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFfrCwxaM5QQ7kNvwENyTFz&_nc_oc=AdqfGPF2jChFlOR0h_E1bUJTvbLVPxC4NgfzatvXVquz4mGwj3H-XxpDNa407ZSjDyU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Sp5-X1xwxjQ4pvoWHxfrQeRKVsW6GBnYMiuVcBYawrw&oe=6A46667E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_H7xIH59uysQ7kNvwEup5Vm&_nc_oc=AdoAJEBR27iRGDcVUkvpBcLoXnZB-bGjbZmypdurAkJDvg8xeLw7KFE_uecTZDXrmA0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g32bd3Z77UIWv5JtsTYwqQiM_wp2g6o6ec-AuCu_w2g&oe=6A4672C4"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "de", "de_CH"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9909435879166450"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1018615914448750"}, {"status": "PUBLISHED", "id": "2107488466490688"}, {"status": "PUBLISHED", "id": "2354957764970176"}, {"status": "PUBLISHED", "id": "2681697795500633"}, {"status": "PUBLISHED", "id": "4106731759614624"}, {"status": "PUBLISHED", "id": "728648986439587"}, {"status": "PUBLISHED", "id": "2229872407453585"}, {"status": "PUBLISHED", "id": "602189292957109"}, {"status": "PENDING", "id": "1365610551191958"}, {"status": "PENDING", "id": "905250718457435"}]}, "baseline_offer": {"id": "2354957764970176"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1018615914448750"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2582528739382137
uA&oe=69EDFCCD"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDf_FqhG5V0Q7kNvwEuly6b&_nc_oc=Adp3it6i2eJYolcp8IO56KUUWxnfiiz3CZ7O11MTeY4EuxhfEdNAf8QwoeMs21CWo3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wv9bBYnsgDxiIs-QLgFuwRPQYx9xsZ1I4hS7DC_5dRQ&oe=69EE2363"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF-62_hvJIUQ7kNvwFGzti3&_nc_oc=Adocnq1kd6Hdz92Pvcn4N5AhJpPKJLbbmXJ0r6qtWSDBU5rvY5kVBR2kQUZJzljEfqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zsvruXlekv3OK8Kynl9vTKs5ZqhMuwS82dkTfcChOGg&oe=69EDF6D3"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5ByB4sPOyQQ7kNvwG0sVKz&_nc_oc=AdqmSrGYJApeMQBbMvvxodOSCNtYhkkwKQry8Auc1qCnjwktxW8IbxELgkDy57zcVu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hZ3PuhvVMDoHvaeoA-fal2suEmb6pYGO3QKCTQZH7Hw&oe=69EE11FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkalzJxp9RoQ7kNvwHlLr9S&_nc_oc=Adqwe103LhOGmA4kAXtOoq5aTMAae4aCgcw0IDN58YRWGvVZ7O7pfbdxgfB76MxeDBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LrHdW-mIoAmFXa0YiFeHh6wsJZ20Lw9u1zeobDW70Sw&oe=69EE1E44"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"i
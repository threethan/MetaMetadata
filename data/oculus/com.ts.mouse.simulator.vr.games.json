0f&oh=00_AQMvnATHXeiLEf-iQlIW0Dkjota2gKfbgCRqFiM7pDiq7Q&oe=6AC25E09"}, {"file_name": "vlcsnap-2025-06-26-14h55m16s255.png", "id": "1064278595152859", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1064278598486192_6608726600079685729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J7n7cbkG-EQ7kNvwEY2j2j&_nc_oc=AdqFSbHz21GGWr8lXTuZSA6S_1Hj90BtLtNoQbtwwfkKho79AWDF4SZDwPubSKO_5JU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaiMCUm-k8Vc9p3XWCo3zTEXteBtYRVXCc4QnF8MjuCw&oe=6AC2768D"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQz9AOi7VEAQ7kNvwE8leYs&_nc_oc=Adql8bA_1nhPxxzmXU7q2kxDp0nANIky4vAYx3DrCt8IAAOFkPDO_9pEwJvnbnBmpiE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsONCXbwRQB3DRa41Kf8joFKpCCPL0iByw8P6jsgtEQQ&oe=6AC27093"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9jzOVFoSrsQ7kNvwHrvmrm&_nc_oc=AdqCQ43GCEUD0d-EDz1fEDyn5Q9znLBiUHfsUOH3Ubz0vZffTrodUD1N8f7GFgwnOt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9YnkqrQDwktaDTGS2wt76wSXEtKICScWAZEV7N6OcKw&oe=6AC264E3"}, {"file_name": "ss1.png", "id": "792722973086141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820886_792722976419474_4938376504075842474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnBQH5fJoOkQ7kNvwGjEjEz&_nc_oc=AdrfKpvFo1TGwV5narhX4NcBDdCGQTy4ceV4n4n6_1jgck4YEX6w3xS4NcE61L92RNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4_blNZd9KVlw08GxzP1gFY8NCGS8PX4zI_6dlB-RkHw&oe=6AC26067"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1314477467235763", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1314477470569096_7800708190831145047_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCx7clmy2FIQ7kNvwGeMpo8&_nc_oc=Adqvl2Yti1jUOZDAmmrc9W0TUTkyfPoylQ2X6PooSZVSFfwxRQ3ku6RU_wUJ0WQ6Mo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRBrT5411ZCeDlmpuXCqKJYExG9ZL4rP1xbcv-4EFuNw&oe=6AC24ED7"}, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure", "iammouse"], "long_description": "**Welcome to I Am Mouse: Your Tiny Adventure Awaits!**\n\n**Pick Your Adventure, Little Mouse!**\n\nChoose from the House, Office, or Space and dive straight into exciting challenges and surprises! Each world has a new adventure waiting for you!\n\n{1159542949524800}\n\n**Cheese Chase: Snatch the Snack!**\nOutsmart RC cars and drones to collect the most cheese in this thrilling, high-speed adventure!\n\n\n{745547554751341}\n\n**Aliens on the Loose? Send in the Mouse!**\n\nJoin the mouse on a galactic adventure, armed with a space gun to blast those pesky aliens!\n\n\n\n{10042326845876356}", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}, {"images": {"nodes": []}, "id": "1650952189860824", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "**Bienvenue dans I Am Mouse : une aventure minuscule vous attend !**\n\n**Choisissez votre aventure, petite souris !**\n\nOptez pour la Maison, le Bureau ou l'Espace et plongez au c\u0153ur de d\u00e9fis et de surprises palpitants ! Chaque univers vous r\u00e9serve une nouvelle aventure !\n{1635857221527838}\n\n**La course au fromage : attrapez le casse-cro\u00fbte !**\n\nD\u00e9jouez les voitures t\u00e9l\u00e9command\u00e9es et les drones pour r\u00e9colter un maximum de fromage dans cette aventure effr\u00e9n\u00e9e !\n{1622594362568375}\n\n**Des extraterrestres en libert\u00e9 ? Envoyez la souris !**\n\nAccompagnez la souris dans une aventure galactique, arm\u00e9e d'un pistolet spatial pour neutraliser ces extraterrestres envahissants !\n{1081846761217638}\n", "short_description": "Glissez-vous dans la peau d'un minuscule explorateur avec *I Am Mouse : Adventure Simulator*, une aventure en r\u00e9alit\u00e9 virtuelle amusante pour toute la famille ! Faufilez-vous dans une maison, un bureau et une station spatiale en incarnant une souris curieuse. R\u00e9coltez du fromage, accomplissez de petites missions et d\u00e9couvrez le monde sous un angle in\u00e9dit."}, {"images": {"nodes": []}, "id": "1643662580703422", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "adventure", "simulator"], "long_description": "**\u0414\u043e\u0431\u0440\u043e \u043f\u043e\u0436\u0430\u043b\u043e\u0432\u0430\u0442\u044c \u0432 I Am Mouse: \u0432\u0430\u0441 \u0436\u0434\u0435\u0442 \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u043e\u0435 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435!**\n\n**\u0412\u044b\u0431\u0438\u0440\u0430\u0439 \u0441\u0432\u043e\u0435 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435, \u043c\u044b\u0448\u043e\u043d\u043e\u043a!**\n\n\u0412\u044b\u0431\u0438\u0440\u0430\u0439 \u043b\u043e\u043a\u0430\u0446\u0438\u044e \u2014 \u0434\u043e\u043c, \u043e\u0444\u0438\u0441 \u0438\u043b\u0438 \u043a\u043e\u0441\u043c\u043e\u0441 \u2014 \u0438 \u0441\u043c\u0435\u043b\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0441\u044f \u043d\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u044f\u043c \u0438 \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u0430\u043c! \u0412 \u043a\u0430\u0436\u0434\u043e\u043c \u043c\u0438\u0440\u0435 \u0442\u0435\u0431\u044f \u0436\u0434\u0435\u0442 \u043d\u043e\u0432\u043e\u0435 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435!\n{1811095613484100}\n\n**\u0421\u044b\u0440\u043d\u0430\u044f \u043f\u043e\u0433\u043e\u043d\u044f: \u0445\u0432\u0430\u0442\u0430\u0439 \u043b\u0430\u043a\u043e\u043c\u0441\u0442\u0432\u043e!**\n\n\u041f\u0435\u0440\u0435\u0445\u0438\u0442\u0440\u0438 \u0440\u0430\u0434\u0438\u043e\u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0435 \u043c\u0430\u0448\u0438\u043d\u043a\u0438 \u0438 \u0434\u0440\u043e\u043d\u044b, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u043a\u0430\u043a \u043c\u043e\u0436\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0441\u044b\u0440\u0430 \u0432 \u044d\u0442\u043e\u043c \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u043c \u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e\u043c \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438!\n{2137305110505631}\n\n**\u041f\u0440\u0438\u0448\u0435\u043b\u044c\u0446\u044b \u043d\u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u0435? \u0417\u043e\u0432\u0438\u0442\u0435 \u043c\u044b\u0448\u043e\u043d\u043a\u0430!**\n\n\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0441\u044f \u0432 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043c\u044b\u0448\u043e\u043d\u043a\u043e\u043c, \u0432\u043e\u043e\u0440\u0443\u0436\u0438\u0432\u0448\u0438\u0441\u044c \u0431\u043b\u0430\u0441\u0442\u0435\u0440\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u0434\u0430\u0442\u044c \u043e\u0442\u043f\u043e\u0440 \u043d\u0430\u0434\u043e\u0435\u0434\u043b\u0438\u0432\u044b\u043c \u0438\u043d\u043e\u043f\u043b\u0430\u043d\u0435\u0442\u044f\u043d\u0430\u043c!\n{1829638281366057}\n", "short_description": "\u041f\u043e\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435 \u0441\u0435\u0431\u044f \u043a\u0440\u043e\u0448\u0435\u0447\u043d\u044b\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u043c \u0432 I Am Mouse: Adventure Simulator \u2014 \u0443\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c VR-\u043f\u0440\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0434\u043b\u044f \u0432\u0441\u0435\u0439 \u0441\u0435\u043c\u044c\u0438! \u0411\u0435\u0433\u0430\u0439\u0442\u0435 \u043f\u043e \u0434\u043e\u043c\u0443, \u043e\u0444\u0438\u0441\u0443 \u0438 \u043a\u043e\u0441\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u0441\u0442\u0430\u043d\u0446\u0438\u0438 \u0432 \u0440\u043e\u043b\u0438 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u043d\u043e\u0433\u043e \u043c\u044b\u0448\u043e\u043d\u043a\u0430. \u0421\u043e\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0441\u044b\u0440, \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f \u0438 \u0432\u0437\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u043d\u0430 \u043c\u0438\u0440 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443. \u0412\u0430\u0441 \u0436\u0434\u0443\u0442 \u0442\u0440\u0438 \u0438\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u043b\u043e\u043a\u0430\u0446\u0438\u0438, \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u0441\u044e\u0440\u043f\u0440\u0438\u0437\u043e\u0432 \u0438 \u0432\u0441\u0451 \u043e\u0431\u0430\u044f\u043d\u0438\u0435 \u0443\u0441\u0430\u0442\u043e\u0433\u043e \u0433\u0435\u0440\u043e\u044f \u2014 \u0432\u0430\u0448\u0435 \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0435 VR-\u043f\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u043e \u0441\u0435\u0439\u0447\u0430\u0441!"}, {"images": {"nodes": []}, "id": "1480859670615399", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "adventure", "simulator"], "long_description": "**Bienvenido a *I Am Mouse*: \u00a1Tu diminuta aventura te espera!**\n\n**\u00a1Elige tu aventura, peque\u00f1o rat\u00f3n!**\n\n\u00a1Elige entre la casa, la oficina o el espacio y sum\u00e9rgete de lleno en emocionantes desaf\u00edos y sorpresas! \u00a1Cada mundo esconde una nueva aventura para ti!\n{2203815620195099}\n\n\n**Carrera por el queso: \u00a1Hazte con el aperitivo!**\n\u00a1Burla a los coches teledirigidos y a los drones para conseguir la mayor cantidad de queso en esta trepidante aventura a toda velocidad!\n{2283148482259362}\n\n\n\n**\u00bfAlien\u00edgenas sueltos? \u00a1Que entre el rat\u00f3n en acci\u00f3n!**\n\n\u00a1Acompa\u00f1a al rat\u00f3n en una aventura gal\u00e1ctica, armado con una pistola espacial para acabar con esos molestos alien\u00edgenas!\n{2726486897753762}\n", "short_description": "Vive la experiencia de ser un diminuto explorador en *I Am Mouse: Adventure Simulator*, una divertida aventura de realidad virtual apta para toda la familia. Corretea por una casa, una oficina y una estaci\u00f3n espacial convertido en un rat\u00f3n curioso. Recoge queso, completa peque\u00f1as misiones y descubre el mundo desde una perspectiva totalmente nueva. Tres mapas interactivos, montones de sorpresas y todo el encanto de un h\u00e9roe bigotudo: \u00a1tu aventura chirriante en realidad virtual comienza ahora!"}, {"images": {"nodes": []}, "id": "1100507349030028", "locale": "vi_VN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "adventure", "simulator"], "long_description": "**Ch\u00e0o m\u1eebng \u0111\u1ebfn v\u1edbi I Am Mouse: Cu\u1ed9c phi\u00eau l\u01b0u t\u00ed hon \u0111ang ch\u1edd \u0111\u00f3n b\u1ea1n!**\n\n**Ch\u1ecdn h\u00e0nh tr\u00ecnh c\u1ee7a ri\u00eang m\u00ecnh, ch\u00fa chu\u1ed9t nh\u1ecf \u01a1i!**\n\nH\u00e3y ch\u1ecdn b\u1ed1i c\u1ea3nh Ng\u00f4i nh\u00e0, V\u0103n ph\u00f2ng ho\u1eb7c Kh\u00f4ng gian v\u0169 tr\u1ee5 v\u00e0 lao ngay v\u00e0o nh\u1eefng th\u1eed th\u00e1ch c\u0169ng nh\u01b0 b\u1ea5t ng\u1edd \u0111\u1ea7y th\u00fa v\u1ecb! M\u1ed7i th\u1ebf gi\u1edbi \u0111\u1ec1u \u1ea9n ch\u1ee9a m\u1ed9t cu\u1ed9c phi\u00eau l\u01b0u m\u1edbi \u0111ang ch\u1edd b\u1ea1n kh\u00e1m ph\u00e1!\n{1598999562010134}\n\n**Cu\u1ed9c \u0111ua s\u0103n ph\u00f4 mai: Ch\u1ed9p l\u1ea5y m\u00f3n ngon!**\n\nH\u00e3y nhanh tr\u00ed v\u01b0\u1ee3t qua nh\u1eefng chi\u1ebfc xe \u0111i\u1ec1u khi\u1ec3n t\u1eeb xa v\u00e0 m\u00e1y bay kh\u00f4ng ng\u01b0\u1eddi l\u00e1i \u0111\u1ec3 thu th\u1eadp th\u1eadt nhi\u1ec1u ph\u00f4 mai trong cu\u1ed9c phi\u00eau l\u01b0u t\u1ed1c \u0111\u1ed9 cao \u0111\u1ea7y k\u1ecbch t\u00ednh n\u00e0y!\n{1361007889151674}\n\n**Ng\u01b0\u1eddi ngo\u00e0i h\u00e0nh tinh \u0111ang qu\u1eady ph\u00e1? H\u00e3y \u0111\u1ec3 ch\u00fa chu\u1ed9t ra tay!**\n\nC\u00f9ng ch\u00fa chu\u1ed9t d\u1ea5n th\u00e2n v\u00e0o chuy\u1ebfn phi\u00eau l\u01b0u xuy\u00ean ng\u00e2n h\u00e0, trang b\u1ecb s\u00fang kh\u00f4ng gian \u0111\u1ec3 \u0111\u00e1nh b\u1ea1i l\u0169 ng\u01b0\u1eddi ngo\u00e0i h\u00e0nh tinh phi\u1ec1n to\u00e1i!\n{2056313921741417}\n", "short_description": "H\u00e3y tr\u1ea3i nghi\u1ec7m cu\u1ed9c s\u1ed1ng c\u1ee7a m\u1ed9t nh\u00e0 th\u00e1m hi\u1ec3m t\u00ed hon trong *I Am Mouse: Adventure Simulator* \u2013 t\u1ef1a game phi\u00eau l\u01b0u VR vui nh\u1ed9n v\u00e0 ph\u00f9 h\u1ee3p cho c\u1ea3 gia \u0111\u00ecnh! V\u00e0o vai m\u1ed9t ch\u00fa chu\u1ed9t \u0111\u1ea7y t\u00f2 m\u00f2 v\u00e0 ch\u1ea1y tung t\u0103ng kh\u1eafp ng\u00f4i nh\u00e0, v\u0103n ph\u00f2ng hay tr\u1ea1m v\u0169 tr\u1ee5. Thu th\u1eadp ph\u00f4 mai, ho\u00e0n th\u00e0nh c\u00e1c nhi\u1ec7m v\u1ee5 nh\u1ecf v\u00e0 kh\u00e1m ph\u00e1 th\u1ebf gi\u1edbi t\u1eeb m\u1ed9t g\u00f3c nh\u00ecn ho\u00e0n to\u00e0n m\u1edbi. V\u1edbi ba b\u1ea3n \u0111\u1ed3 t\u01b0\u01a1ng t\u00e1c, v\u00f4 v\u00e0n \u0111i\u1ec1u b\u1ea5t ng\u1edd c\u00f9ng s\u1ef1 \u0111\u00e1ng y\u00eau c\u1ee7a m\u1ed9t \"anh h\u00f9ng r\u00e2u d\u00e0i\", h\u00e0nh tr\u00ecnh VR \u0111\u1ea7y th\u00fa v\u1ecb c\u1ee7a b\u1ea1n s\u1ebd b\u1eaft \u0111\u1ea7u ngay b\u00e2y gi\u1edd!"}, {"images": {"nodes": []}, "id": "1074667078753627", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "**Bem-vindo a *I Am Mouse*: Sua Pequena Aventura Aguarda!**\n\n**Escolha Sua Aventura, Pequeno Camundongo!**\n\nEscolha entre a Casa, o Escrit\u00f3rio ou o Espa\u00e7o e mergulhe de cabe\u00e7a em desafios e surpresas empolgantes! Cada mundo reserva uma nova aventura para voc\u00ea!\n{1746455629923025}\n\n\n\n**Ca\u00e7a ao Queijo: Garanta o Petisco!**\nSupere carrinhos de controle remoto e drones para coletar o m\u00e1ximo de queijo nesta aventura eletrizante e veloz!\n\n{1095381426238846}\n\n**Alien\u00edgenas \u00e0 Solta? Chame o Camundongo!**\n\nJunte-se ao camundongo em uma aventura gal\u00e1ctica, armado com uma pistola espacial para acabar com aqueles alien\u00edgenas enxeridos!\n{1412309780868951}\n", "short_description": "Vivencie a vida de um pequeno explorador em *I Am Mouse: Simulador de Aventura*, uma aventura divertida em realidade virtual para toda a fam\u00edlia! Corra por uma casa, um escrit\u00f3rio e uma esta\u00e7\u00e3o espacial na pele de um camundongo curioso. Colete queijos, realize pequenas tarefas e descubra o mundo sob uma perspectiva totalmente nova. Tr\u00eas mapas interativos, muitas surpresas e todo o charme de um her\u00f3i de bigodes \u2014 sua jornada em realidade virtual come\u00e7a agora!"}, {"images": {"nodes": []}, "id": "928435449988170", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "**Welcome to I Am Mouse: Your Tiny Adventure Awaits!**\n\n**Pick Your Adventure, Little Mouse!**\n\nChoose from the House, Office, or Space and dive straight into exciting challenges and surprises! Each world has a new adventure waiting for you!\n{1128461029711671}\n\n\n\n**Cheese Chase: Snatch the Snack!**\nOutsmart RC cars and drones to collect the most cheese in this thrilling, high-speed adventure!\n{877745172021200}\n\n\n**Aliens on the Loose? Send in the Mouse!**\n\nJoin the mouse on a galactic adventure, armed with a space gun to blast those pesky aliens!\n{1678865310713199}\n", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!\n"}, {"images": {"nodes": []}, "id": "908685492325075", "locale": "sv_SE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "adventure", "simulator"], "long_description": "**V\u00e4lkommen till I Am Mouse: Ditt lilla \u00e4ventyr v\u00e4ntar!**\n\n**V\u00e4lj ditt \u00e4ventyr, lilla mus!**\n\nV\u00e4lj mellan huset, kontoret eller rymden och kasta dig rakt in i sp\u00e4nnande utmaningar och \u00f6verraskningar! Varje v\u00e4rld bjuder p\u00e5 ett nytt \u00e4ventyr!\n{26297242179972976}\n\n\n**Ostjakten: Knip \u00e5t dig godbiten!**\n\u00d6verlista radiostyrda bilar och dr\u00f6nare f\u00f6r att samla p\u00e5 dig mest ost i detta fartfyllda och sp\u00e4nnande \u00e4ventyr!\n\n{2964788457200770}\n\n\n**Utomjordingar p\u00e5 vift? Skicka fram musen!**\n\nF\u00f6lj med musen p\u00e5 ett galaktiskt \u00e4ventyr, bev\u00e4pnad med en rymdpistol f\u00f6r att skjuta bort de d\u00e4r irriterande utomjordingarna!\n{1464760792187228}\n", "short_description": "Upplev livet som en liten uppt\u00e4cktsresande i I Am Mouse: Adventure Simulator \u2013 ett roligt och familjev\u00e4nligt VR-\u00e4ventyr! Pila runt i ett hus, p\u00e5 ett kontor och ombord p\u00e5 en rymdstation som en nyfiken mus. Samla ost, l\u00f6s sm\u00e5 uppgifter och uppt\u00e4ck v\u00e4rlden ur ett helt nytt perspektiv. Tre interaktiva milj\u00f6er, massor av \u00f6verraskningar och all charm hos en hj\u00e4lte med morrh\u00e5r \u2013 din pipiga VR-resa b\u00f6rjar nu!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_i
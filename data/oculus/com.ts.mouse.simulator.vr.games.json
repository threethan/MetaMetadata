_yRJVLle-XWCM9n-_j6Cg3Lybi2VrA&oe=69A44F63"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtt2PgH1ZOYQ7kNvwF6Or2y&_nc_oc=AdkuPJZUUg3Ei4Lg4xGfmVzv8bTl0gjaN9eeirubALuzF9TyO86GCRyJl8RRa04x4nA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftmMbf9PKSiAhQQH92qZ-Biw-MBIdTmjOH8dQHug2oBgw&oe=69A422D3"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJb1SXFTX9cQ7kNvwHY2A3h&_nc_oc=Adlbtmys0qH6HAw0XIA-mt5XlHtV0zEeVyR7FVBTzq9Kr-WLdieSNHDSx0r3rUCkzUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuW3abkYM586l9ILxSXoop_Ee2duiDN7lBDsRw5t8wjNw&oe=69A43DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8XvDT5g72YQ7kNvwHE1UOJ&_nc_oc=AdkJKa4B8GKwvd5ngoLqugw4kOgI4iTBsFqtQvvdfmGt13SvlRAW2plqlTR75dGeT7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfudbJXwNvNbomYoG6tEu6VzYL5_dcB5J3mM5mJKeyvPog&oe=69A44A44"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", 
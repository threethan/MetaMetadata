7f20f&oh=00_Af5j_PwSWBobLZSCe_UMDrZnqHMvj95O-md3bxmQCHTxrQ&oe=6A0F18E3"}, {"file_name": "ss1.png", "id": "792722973086141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820886_792722976419474_4938376504075842474_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jI9M3KuHTKAQ7kNvwHRHgyB&_nc_oc=AdpHfuIsjADovjzaVBok1c_5OwvdbHzzx1ALQuufrcQaN1jdxAvJ85zakJcxKMNgIK0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nTFGGVIwVaiAbWVcocuVXc4br2oo1hxmsUdNJ2IMF0g&oe=6A0F1467"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1314477467235763", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825257_1314477470569096_7800708190831145047_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-_gM2Cy-boQ7kNvwEs0rhD&_nc_oc=Adrki9AzgsmntSg6mLdA5QHSEp3Svxb3kxYGC6BS3O8nRjz9PkjOuI3xtR_sww9yD64&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58JbQv6IQ5MFtT6gD6XLeIqm9JXt5WUZP7XuAkMJ8Tjg&oe=6A0F02D7"}, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure", "iammouse"], "long_description": "**Welcome to I Am Mouse: Your Tiny Adventure Awaits!**\n\n**Pick Your Adventure, Little Mouse!**\n\nChoose from the House, Office, or Space and dive straight into exciting challenges and surprises! Each world has a new adventure waiting for you!\n\n{1159542949524800}\n\n**Cheese Chase: Snatch the Snack!**\nOutsmart RC cars and drones to collect the most cheese in this thrilling, high-speed adventure!\n\n\n{745547554751341}\n\n**Aliens on the Loose? Send in the Mouse!**\n\nJoin the mouse on a galactic adventure, armed with a space gun to blast those pesky aliens!\n\n\n\n{10042326845876356}", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "de", "de_CH"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26103249249358522"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619450_1549939730053825_239644551075994298_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h91xXgjQC6YQ7kNvwGprOIE&_nc_oc=AdpFi4TOd1NbBN5NxR3NoK6eoCcjHwaLNwweW7jn52nXm-2KiOuPSPiVqhwEQCl0zPo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_gGXla6JZzCeSycSzBfFyUjyaF8MwDXwz-3OTHPYRTA&oe=6A0F0E98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I Am Mouse : Adventure Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_n
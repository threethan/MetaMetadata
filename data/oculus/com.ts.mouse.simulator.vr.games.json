?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2clYk7E0mPcQ7kNvwGU3Yyj&_nc_oc=AdpuXibEB7F2OgHzZbhft8kRp6fm9fNRSpVQ2pnTLYDVVJ_iQM46y7pfhCZf1bd_74I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o4UQIe62YSgG_Lsztm0Yse97ieSnkeBOeBzA3_ZobYQ&oe=6A0071CD"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-BJBJVFgeYQ7kNvwGOLP00&_nc_oc=AdrDVBgPUahYr2u8F3PUv5HinZKVyBVlcNIAETrFeEyMI8P3_RtmfIidB5WM1krB5yo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45mqK1JBFpe-0_-gH-WjsFX_USsSMP7HhaGuKJu4XFOA&oe=6A009863"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDZpLk8Xk6gQ7kNvwFTRffh&_nc_oc=AdqngUyqGC5rGVeyYrykQ6PRuFv6F6insL8EbPfUx_x-g7V3bezXEYJiFVtVLEp4JJM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5imY3G3Gn0MB7UKslNftsA128cc_NOPjR99mpd_zbEGQ&oe=6A00A413"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8giU-zhWNIQ7kNvwGfZtga&_nc_oc=AdrMB_1wynZE-UyZSz3v9anNDwk2DrYf0jhkMZW8_fy69MzmWtaIj9T7OzUmYJEI8nM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-E6FnNy1qGAQWlGmgg6MCBkuNz8x7IJQ0Esazzvzp9A&oe=6A0086FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uq2mwyPKrAQ7kNvwECM1Nm&_nc_oc=AdoTjp2PIPaFKYHFK93hB0HF698x8lFWDAvrztts2TNKngTQiH7Gt45cB4Jm_od_IjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RWrOiNtNAClNPxCyiV4irb-JF6KjFpqVgFPVRnNKGaw&oe=6A009344"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php"
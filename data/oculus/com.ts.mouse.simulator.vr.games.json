4.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDf_FqhG5V0Q7kNvwFWsWPw&_nc_oc=AdqiwXIoD9f9gfLf-KgM-Ven9XFgSOElogxYTlRwHCM5tGkACC0CU1wuHRmPQ1OFwhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3RQEPyUEAeTFZTVPC9-bVzuJROiL-5X3CYeyf2j_KXLw&oe=69F0C663"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF-62_hvJIUQ7kNvwFLM0GC&_nc_oc=Adp_5eYTz1A8UH91YPI0Ncu5RZI2nOWYrsUmQpCxO7JsCFPa7kMQAU6ImGIWdgd4YaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ISweYEBYe59wFExrt6Y7DAkwwERfIOT-3NZpySICBIQ&oe=69F0D213"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coCtNcimmX4Q7kNvwHTQEAA&_nc_oc=AdrGs_L9fVdSzbuCUTxxSNbjemDbFwWcT2ry-n0gBhRDgoHFQTTOsRj-GNrfhHqFRHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1k8MMEIqJ2SefO1IG4hJiXRnXAma7r_DUALayX5Pbr3w&oe=69F0B4FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLRWifp6_vgQ7kNvwEqDiYi&_nc_oc=AdoxcQRS0crTSSf_Ja2jfOF5_MO5tvLp5YiY7-R-9RLZqoawqD0SSZb1hEdWWtGQ1ns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1dISTnYSeVkPhvuz7va2otNr2MHMOEnGe7GG_hb-gMhA&oe=69F0C144"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED
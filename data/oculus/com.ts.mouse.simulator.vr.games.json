: [{"id": "24334636456176019"}]}, "id": "1436794250889478"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "31112099521736814"}]}, "id": "720922214440907"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9804523692991003"}]}, "id": "1269522004586655"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "23868001389537044"}]}, "id": "2162380197599761"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "10017113878373725"}]}, "id": "1167765258406445"}]}}, "firstRevision": {"nodes": [{"application": {"id": "9804523692991003", "release_date": 1753376400, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 11}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28263341023349323"}, "id": "708690545260704"}]}}, "binary": null, "live_binary": null, "created_date": 1790576615, "id": "28553144401035649", "is_initial_release": false, "name_with_fallback": "v19", "pdp_metadata_with_fallback": {"version": 8, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "28553270011023088"}, "release_status": "RELEASED", "id": "9804523692991003"}, "id": "28553270011023088", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9804523692991003", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2536310933464450"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1832196441298610", "locale": "da_DK", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "adventure", "simulator"], "long_description": "**Velkommen til I Am Mouse: Dit lille eventyr venter!**\n\n**V\u00e6lg dit eventyr, lille mus!**\n\nV\u00e6lg mellem huset, kontoret eller rummet, og kast dig direkte ud i sp\u00e6ndende udfordringer og overraskelser! Hver verden byder p\u00e5 et nyt eventyr!\n{1499829358572462}\n\n\n**Ostejagt: Snup en godbid!**\nOverlist fjernstyrede biler og droner for at samle mest ost i dette h\u00e6sbl\u00e6sende eventyr!\n{1108475288795865}\n\n\n\n**Rumv\u00e6sner p\u00e5 spil? Send musen ind!**\n\nTag med musen p\u00e5 et galaktisk eventyr, bev\u00e6bnet med en str\u00e5lepistol, s\u00e5 du kan skyde de irriterende rumv\u00e6sner ned!\n{1669554964521140}\n", "short_description": "Oplev livet som en lille opdagelsesrejsende i I Am Mouse: Adventure Simulator \u2013 et sjovt og familievenligt VR-eventyr! Pile rundt i et hus, p\u00e5 et kontor og p\u00e5 en rumstation som en nysgerrig mus. Saml ost, l\u00f8s sm\u00e5 opgaver, og oplev verden fra et helt nyt perspektiv. Tre interaktive baner, masser af overraskelser og al charmen ved en helt med knurh\u00e5r \u2013 din pibende VR-rejse begynder nu!"}, {"images": {"nodes": []}, "id": "1808830820121302", "locale": "pt_PT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "adventure", "simulator"], "long_description": "**Bem-vindo a *I Am Mouse*: A Tua Pequena Aventura Aguarda!**\n\n**Escolha a Sua Aventura, Pequeno Rato!**\n\nEscolha entre a Casa, o Escrit\u00f3rio ou o Espa\u00e7o e mergulhe de cabe\u00e7a em desafios e surpresas empolgantes! Cada mundo reserva-te uma nova aventura!\n\n{28752750840987997}\n\n\n**Ca\u00e7a ao Queijo: Garanta o Petisco!**\nSupera os carrinhos telecomandados e os drones para recolher o m\u00e1ximo de queijo nesta aventura eletrizante e veloz!\n{1634688648332261}\n\n\n\n**Alien\u00edgenas \u00e0 Solta? Chama o Rato!**\n\nJunta-te ao ratinho numa aventura gal\u00e1ctica, armado com uma pistola espacial para acabar com aqueles alien\u00edgenas enxeridos!\n{1085467477634312}", "short_description": "Vive a vida de um pequeno explorador em *I Am Mouse: Simulador de Aventura*, uma divertida aventura em realidade virtual para toda a fam\u00edlia! Corra por uma casa, um escrit\u00f3rio e uma esta\u00e7\u00e3o espacial na pele de um ratinho curioso. Recolha queijos, realize pequenas tarefas e descubra o mundo sob uma perspetiva totalmente nova. Tr\u00eas mapas interativos, muitas surpresas e todo o encanto de um her\u00f3i de bigodes \u2014 a sua viagem na realidade virtual come\u00e7a agora!"}, {"images": {"nodes": [{"file_name": "512 x 512.png", "id": "27202492009340770", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823901_27202492039340767_2256356953823872420_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6102hlxn20Q7kNvwFIpmZA&_nc_oc=AdrOzhmtpgiR3_xLEMDRWB-S3cG_rFIucnOCOM177-oN_M4P1O1ZFHbWZIQ67Cv-9z8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNioS8lUYyeSWcYMB0VXTq7EngT66J6caICkSLxSbFjmw&oe=6AC2522C"}, {"file_name": "1440 x 1440.png", "id": "1481195190383303", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1481195197049969_3988846021764435905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jy4zNcCy5lAQ7kNvwGF8a2F&_nc_oc=Adqe4fkhk_JmG8BvcfQY06fKbjAyadte0azoivwhNzkCSAkoJEKQJB5NUoQMsrhLSJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNK16fFfZPE8OAVDEdaFsNvhyL6Mnj9pJkpgsPX2SLz0Q&oe=6AC2759D"}, {"file_name": "2560 x 1440.png", "id": "1418959966120345", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1418959969453678_7931219658563644468_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAfB9B6muMAQ7kNvwFCHBzr&_nc_oc=Adqosfekcbn3WMV-UY5FIgiSEWbnls-khaIFZIhCYk4noxUTmPNS4fTyZFAdnfByFLM&_nc_zt
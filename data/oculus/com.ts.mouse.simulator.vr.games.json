?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTh6gp-mLHUQ7kNvwGZ1sct&_nc_oc=AdqEo0gOnuKEcprkiQeD2-IfW1o0PV3IrN6MMXtbxkdrA3PNA90abIktUC53a7FzjZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15VQTyR6ahiDyjtuPFc4K1v-Ocfidw4aEQC4ZM8ohzXg&oe=69F888CD"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=julCH2TBjGsQ7kNvwEU0ubl&_nc_oc=AdoKwkqyPMEsyuOsc-pIUPmY0UdH4EUsDHcQKyFUvDN6v2ScG2qU_zmKneMhhhSo5y0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pXAZ0Wi3z-Mj_RgBRhxz0nCzj-UYo2UZG2w1r-oYnZw&oe=69F8AF63"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbha3IYwqs8Q7kNvwHARyw3&_nc_oc=AdpJMaJhrz6JKrgkFuV2cm3TkWSjUlKVwC3ZWB4-KXBEc0pLxW2hWAjHKYsAHnEWV6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ckrt3h-HRA5Xp1CM3A5g0R1Ak9-A0L96-I73EVk6Tng&oe=69F8BB13"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7wfZ8Bmuc8Q7kNvwEEmErh&_nc_oc=AdrBw7O_84hlEHyy4EWKct_klGW6LwXy3Tiad_EDfKFtiUkyrduibbsxJRqZyVcJOO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0WexCkGLPxFY5Rx2sglveHvbtN8VJkI366mw2dhHdMUQ&oe=69F89DFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfIUGS3PQ-gQ7kNvwGNl4Y7&_nc_oc=AdrHctxK4zsBWkxqvNFDzIii-AQreOzMannHC5cVtDYuAlny8zCCKjllH_WGbUcrcEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nDqJSxI3Z6q2v4M3f-3m3OZuk_K57W9zEl_S8itC6dg&oe=69F8AA44"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php"
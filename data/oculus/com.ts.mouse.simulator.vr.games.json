Sk&_nc_oc=AdlV1U6OXzbBNuNPK8YlgfqCBnEBx3sTK6SiCsUFUE480vnmyt5jzv9rsMEkogZUW9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftnfnkbmPK8WLjShNaNfpgGKgVgr09V7ZZCD6a8DGAnFQ&oe=69986710"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure", "iammouse"], "long_description": "**Welcome to I Am Mouse: Your Tiny Adventure Awaits!**\n\n**Pick Your Adventure, Little Mouse!**\n\nChoose from the House, Office, or Space and dive straight into exciting challenges and surprises! Each world has a new adventure waiting for you!\n\n{1159542949524800}\n\n**Cheese Chase: Snatch the Snack!**\nOutsmart RC cars and drones to collect the most cheese in this thrilling, high-speed adventure!\n\n\n{745547554751341}\n\n**Aliens on the Loose? Send in the Mouse!**\n\nJoin the mouse on a galactic adventure, armed with a space gun to blast those pesky aliens!\n\n\n\n{10042326845876356}", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVE
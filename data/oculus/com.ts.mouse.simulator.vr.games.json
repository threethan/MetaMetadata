nc_sid=6e7a0a&_nc_ohc=05dAYbuYUnYQ7kNvwEcRyuw&_nc_oc=Adnfzrk1Fn_FoK32bZrE0yFHtX6kfpW9IQvAytKtENsyTuND12hg_0FE0-JMbP3Y7is&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyk8ur2newFnDpzBch5IU5GrW3R4sPBBjX0r-tlqZ3kVA&oe=69B815E3"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4jwBmRPrC0Q7kNvwG6YJKS&_nc_oc=AdlwDAmur3zzooOefBallqwJaVwryzgruJB1qaoev5KGaP0kgjbqno0qjSEwF6DNrFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxoza8oUTtZqd3MzP0yznVhHG4UdCus_CbmqdUPXnUNCA&oe=69B7E953"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsZrgPHCRr8Q7kNvwGnEwV3&_nc_oc=AdlPuMOIVnv9dpMOVHu6YPQrRKJeLR3v-LxLHkuoXCWj5EAogaINA8FLg7XS2dgS-IQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzldrlE86Ld7UQi48275dhJ4SLpLu9pU7-o-CTlYYxXlw&oe=69B8047E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF_eHXLu6FkQ7kNvwFwuLh9&_nc_oc=AdmxDUHwgK9vz6nN5w7XwfC7KXXBgFuvQogPkGdFUVQS3JyB36rRIX6aa4YlaveZw58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvjDRqiZJAoqmtCBpm_PAJAJCbAMQoZ07pS3QjeIjO7Q&oe=69B810C4"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
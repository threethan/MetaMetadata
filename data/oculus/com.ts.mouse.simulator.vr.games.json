?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTh6gp-mLHUQ7kNvwEDt-i4&_nc_oc=AdoMwPaxOXC94Cmdm0495sEHHwVYauID1r6pkwFou9R9mw2-JRIwf5ueIy7vcCv_0Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G9IpEv6ExcRvkzW-u-qSf3dLtyY_JogFNHpfh0tSKFw&oe=69FA128D"}, {"file_name": "vlcsnap-2025-06-26-14h57m40s619.png", "id": "1362965244997410", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491828836_1362965248330743_8857805389436387068_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KD5f8fcoJ8Q7kNvwGrs5Mb&_nc_oc=AdrT3cY58P_B0yyG0NjlePviP2vYgvWv8VJqqCJXu6E00SCi_pKyr3W5EjQwsAOUby8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_9cyLGMzoUPNdEw4_0ji2SBkbsSriDniPXWs5CxllGg&oe=69FA00E3"}, {"file_name": "vlcsnap-2025-06-26-15h36m21s860.png", "id": "709012702102710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618284_709012708769376_3470925897511064858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hptHbQzI944Q7kNvwF3honW&_nc_oc=AdrGWDWdi7BqP88yrnO_uBvoZG_BXLVetwPB8tqMgZMucB8bDgQCitDtfSRpSS34loM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qcrt3-1aqoY488U6gTFzY8ghNpgPuiLXgKBfQ5E91YA&oe=69FA0C93"}, {"file_name": "ssMenu.png", "id": "1055955313347234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618297_1055955316680567_1044107595197462832_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7wfZ8Bmuc8Q7kNvwHpbEVV&_nc_oc=AdpwGLHZp30GkL6bjQtMqSz6VTGI-2I0M6y5fOot0stwktBoEEUfgkdv6qgaE-tQqR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VI6e_L2f1csA-KUgPC9ON5sHV6SjGQgoSCBa1u5NWtw&oe=69F9EF7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1177756150686533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1177756154019866_4024787996372402027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfIUGS3PQ-gQ7kNvwEecT8B&_nc_oc=AdoLYakEeYx21TLT16kFr87wrq9bw3xOJ-51WgtXO_X7jbMGYgg-8BOg82akBJpvhIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sK2hsEudnqkE4zYKw2Z6tTV8f2fleQPm_j5nNg3U8Bg&oe=69F9FBC4"}, "display_name": "I am Mouse : Adventure Simulator", "keywords": ["iam", "mouse", "simulator", "adventure"], "long_description": "Shrink down and step into the whiskers of a curious little mouse in I Am Mouse: Adventure Simulator, a charming and immersive VR journey packed with exploration, problem-solving, and a bit of cheesy mischief!\n\nTravel through three creative environments built for VR fun:\n\ud83c\udfe0 House \u2013 Navigate through a cozy home, solve small-scale puzzles, and collect hidden cheese in each of the five levels.\n\ud83d\udcbc Office \u2013 Explore a busy workspace from a mouse\u2019s perspective, complete playful tasks, and discover secret nooks and crannies.\n\ud83e\ude90 Space Station \u2013 Float through a low-gravity environment, interact with futuristic tools, and enjoy light, sci-fi-themed adventures.\n\nEach map is filled with interactive elements, environmental challenges, and delightful surprises. Designed for comfort and creativity, I Am Mouse offers intuitive controls, engaging visuals, and a unique perspective on everyday spaces.\n\nWhether you're a fan of light-hearted exploration or just want to experience life from a new point of view, I Am Mouse: Adventure Simulator is a family-friendly VR escape into tiny paws and big imagination.\n\nSqueak, scurry, and explore\u2014your mouse-sized adventure begins now!", "short_description": "Experience life as a tiny explorer in I Am Mouse: Adventure Simulator, a fun and family-friendly VR adventure! Scurry through a house, office, and space station as a curious mouse. Collect cheese, solve small tasks, and discover the world from a whole new perspective. Three interactive maps, tons of surprises, and all the charm of a whiskered hero\u2014your squeaky VR journey starts now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php"
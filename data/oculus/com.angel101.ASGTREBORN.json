c_ohc=Pf9IDCgqofkQ7kNvwFfSYhW&_nc_oc=Adqhcb_4ZlXkm7UY0j8-gKSUpaJab4_09lJwK5jmFKb0k2-YYh3rSwKGMW7B353Q_iI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NcvcvgscS0-d-_TxJ7gtFS6oRvQy-1LlWk5HMMnsh0A&oe=69FDF8B8"}, {"file_name": "Untitled design-9.png", "id": "3090793617793438", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618284_3090793621126771_401022266909430834_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKF59RZFW6YQ7kNvwG6EkwL&_nc_oc=Adp08ElvD_7_TTTBcIwWJnMB-HoRzKZLS6WKa1T7Jr4PRF1w5eCVvQ-G56JkbeI6pZQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cw6gK6_WY1KbgngNkk2bWxbCehOcThFcdXmiguaGenw&oe=69FDD3B4"}, {"file_name": "Untitled design-8.png", "id": "1472433921147229", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499301549_1472433924480562_5638431055493976375_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e11odb-iLoAQ7kNvwFTlOUt&_nc_oc=AdoP9Uf_oWfXVU1Tw9lxlf1IGJ3spaE8aL2hYJOpQkDDPVxb0Kr6MbRvbNc3sBETqDM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yfx2-AKxE9Re17upvE3Za4gt-dgF_sxCS3kukgoLMYA&oe=69FDD60E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Angel's Scary Gorilla Tickles", "keywords": ["Horror", "GTH", "Fun", "ASGT", "Gorilla"], "long_description": "Description:\nASGT is a horror game that using hand locomotion like Gorilla Tag. You and your fellow gorillas must run and survive the scary monsters that roam around the maps. Every step you take could be your last, so look over your shoulder at all times.\n\nFeatures:\nASGT has very unique monster AIs that each monster can possess, such as a weeping angel mechanic where one must look at the monster, or else it moves, a wandering monster type so it walks around the maps, looking for it's next victim, and various other ones that make the game better and unique.\n\nGoals:\nYou and your fellow gorilla's goal is to wander around maps, look for new monsters, buy cosmetics, and most importantly, survive against the monsters nearby.\n", "short_description": "ASGT is a horror game revolving around gorillas, where you and friends (if you bring any) go to maps, run from monsters, and purchase new cosmetics. There are various monster behaviors, such as weeping angels, flying monsters, and other ones which spice up the environments in which these monsters show up in.  It is up to you and your other fellow gorillas to survive."}]}, "developer_name": "angel101", "developer_privacy_policy_url": "https://sites.google.com/view/angelscarygorillatickles/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "angel101", "support_website_url": null, "website_url": "https://sites.google.com/view/angelscarygorillatickles/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26658163107112154"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "918986054101779"}]}, "baseline_offer": {"id": "918986054101779"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776538680, "status": "PUBLISHED", "id": "918986054101779"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26948395291422266", "version": "13"}, "id": "1880436389305990", "channel_name": "LIVE"}
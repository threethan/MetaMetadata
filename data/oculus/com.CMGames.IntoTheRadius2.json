875253921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saKccS78YlIQ7kNvwGRBXdn&_nc_oc=Adrz0w6W6jHpmpWc1R0m3ceZyXClVueY9Fx4gYqVkXosKvLrfu-JN4Ipv7EZBx8SW-4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWvoI8YDjoEU_o0cOhC4YccPOe1wSwmLldI_7fRFVhoQ&oe=6AA946D7"}, {"file_name": "ITR2_MQ_ReleaseScreenshot_01_2560x1440.png", "id": "4018167225064139", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391820_4018167228397472_3045675370164399430_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-VRouK3SNsQ7kNvwF08LNN&_nc_oc=AdquqPdc_VZsqKL4rkNFylSNCpWPJahCh1CIqupxR9_bwMeSS8nJpt6_ltGLMRCN6DA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7d8pcfLao3O_XNa8j-sIUGULaCFm7QKA_eF-WZrmJlQ&oe=6AA94F4B"}, {"file_name": "ITR2_MQ_ReleaseScreenshot_02_2560x1440.png", "id": "1001987678686178", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820387_1001987682019511_3127908976758967116_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKEsOgY-XwsQ7kNvwEmKdnY&_nc_oc=AdpdLpwDYZtGxQ9VWJXjJNeCi_7Lvcv-c6lYra9RARvs21Ox3uZ0QLExtqsiu9omJCM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqZuO03ol6p-XKpu5Vx1aGsxj7yWrhj6Pm_YgHxDp6eg&oe=6AA94EA6"}, {"file_name": "ITR2_MQ_ReleaseScreenshot_05_2560x1440.png", "id": "650917877936944", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822374_650917884603610_1712178313212350521_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOJgvArlpIUQ7kNvwHlFMD0&_nc_oc=AdrF0sM_mhfnCn3m9iIargScgmv0eEsyi4aye4p65Uhd3jUKMZSGZ5acD6mZlxkq0vc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhy5gHcbDS9R3szRsKZbDb1a4lQGGlilADXfTFDmE5tg&oe=6AA96000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ITR2_Landscape_2560x1440_v2.png", "id": "1402580734295696", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393132_1402580740962362_27954852657144893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ylk0daikXhYQ7kNvwFblCZr&_nc_oc=Adplaq_5F5RE35KL2vFiwbEbjVOQKuJiC0W7ZL1ZmST1lmfVti4AV49K9UuOLjn4kFI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8FzC-xLmSZKs_-Q-mzQ6XmVKBfaUUPGWb1y9gj6CHYA&oe=6AA93DE9"}, "display_name": "Into The Radius 2", "keywords": ["shooter", "survival", "horror", "coop", "anomaly"], "long_description": "# Master and Maintain Authentic Weapons\nEvery firearm in Into the Radius 2 is recreated with realism, each having unique handling and features. Customize your arsenal with attachments to fit your playstyle. Survival means caring for your weapons \u2014 clean and maintain them regularly to ensure peak performance. Neglect can be deadly.\n\n# Customize Your Gear\nFully control your loadout with deep customization for Chest Rigs, Armor Vests, and Backpacks. Use presets or build from scratch, arranging pouches and holsters exactly where and how you want. Design your gear to match your tactics and comfort.\n\n# Survive Deadly Anomalies and Hostile Entities\nExplore the Pechorsk Anomaly, where environmental hazards and hostile enemies test your skills. Face Mimics \u2014 intelligent humanoid foes using tactics like cover and communication \u2014 and monsters like regenerative Fragments and fast Creeps. Survival requires sharp wits and careful use of weapons and tools.\n\n# Manage Resources and Complete Missions\nScavenge supplies, manage gear, and defend yourself in a world where every resource counts. Return to your Base to maintain weapons, organize gear, trade, and plan. Complete UNPSC missions to raise your Security Level and unlock advanced equipment.\n\n# Choose Your Approach\nGo solo for an immersive experience or team up with another Explorer for coordinated action. Adapt, make every choice count, and uncover the mysteries at the heart of the Pechorsk Anomaly.", "short_description": "Into the Radius 2 is an immersive survival FPS set in surreal landscapes of the Pechorsk Anomaly. Arm yourself with realistic, customizable weapons and manage your gear and loadout carefully to survive. Experience the tension and isolation of the Radius in single-player mode, or join forces with a friend in a two-player co-op to explore mysterious locations, face hostile entities, and gather valuable resources to improve your chances of reaching the Anomaly Zone\u2019s center."}]}, "developer_name": "CM Games", "developer_privacy_policy_url": "https://cm.games/privacy-policy/", "developer_terms_of_service_url": "https://cm.games/terms-of-use/", "publisher_name": "CM Games", "support_website_url": null, "website_url": "https://www.cm-immersive.com/itr2", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "6605328879515796"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1398581921721158"}, {"status": "PUBLISHED", "id": "1704324647455305"}, {"status": "PUBLISHED", "id": "855685040197886"}, {"status": "PUBLISHED", "id": "1389161432877442"}, {"status": "PUBLISHED", "id": "1272087441485151"}, {"status": "PUBLISHED", "id": "840721698447291"}, {"status": "PUBLISHED", "id": "1868992930343745"}, {"status": "PUBLISHED", "id": "1490637475712468"}, {"status": "PUBLISHED", "id": "707997035254789"}, {"status": "PUBLISHED", "id": "1011395334485209"}]}, "baseline_offer": {"id": "1011395334485209"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "s
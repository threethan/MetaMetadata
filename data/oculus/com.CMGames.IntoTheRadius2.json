BhC2eardf02iqk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDZKM8PLbCuJRVlwUiFt8_xKj-RFnDaAHEFwAGopQqCg&oe=6AA96027"}, {"file_name": "Screenshot_02.png", "id": "1284947554702281", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824328_1284947568035613_5793420538301761320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FD7YVKxl9EQ7kNvwFGobRw&_nc_oc=AdpURbST8IlVF3bwcnicp8ie7V8ooTJqQzgw0IRIIIspQ4tfNFGjXYevaV-Fw15hAmg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuC9hgn0ymEqtoqgKuWMkyUcUQN3LWdXOnZhhCxvtuLQ&oe=6AA95B38"}, {"file_name": "Screenshot_03.png", "id": "1772051050605041", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825345_1772051057271707_6385263422369890347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVevfkk4bV4Q7kNvwGIIwGI&_nc_oc=Adr7cSyAlSJNkomA3zXtR-PZNQl-2vHvA_zCBa8G4LfgTLqwOZI5wu5110clmq4Qk-E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUp3qf4xT2mkIeBXwgRm_qQcdSURs00yalxpL5d3gl_g&oe=6AA9536B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ITR2_KeyArt_MQ_TrailerCoverImage_2560x1440.png", "id": "3373864389452198", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823802_3373864392785531_3999967284326883036_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q63SemUqXlkQ7kNvwEjS_4I&_nc_oc=AdqgCs0_2pnl0QJy7iKGuBPfkIEwVP6arnoCT7YDc0VwkIiKWiaQ7x3pqALh8bStoXI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbkJBc7GKt3sYLXuXGKFanKnR-MEWYJhq4YIVH32L8UQ&oe=6AA93EE4"}, "display_name": "Into The Radius 2", "keywords": ["shooter", "survival", "horror", "coop", "anomaly"], "long_description": "# KEY FEATURES\n- Solo or Co-op Survival\n- Deep Modular Weapon System\n- Realistic Weapon Maintenance\n- Fully Customizable Loadouts\n- Challenging Hostile Entities\n- Deadly Anomalies and Changing Environment\n\nExplore the Pechorsk Anomaly solo for a tense, atmospheric experience, or team up in two-player co-op with proximity voice chat to coordinate every mission.\n\nEvery weapon feels real, with authentic handling and a modular system: swap barrels, stocks, optics, and attachments to fit your style. Weapons deteriorate with use, so clean and maintain them or risk a jam at the worst moment. Rigs, vests, and backpacks can be pre-configured or built from scratch, with pouches and holsters placed exactly where you want. Repaint gear piece by piece with solid colors or camouflage patterns.\n\n{1632601501784934}\n\nThe Radius holds hostile entities born from distortion: tactical Mimics that take cover and adapt under pressure, relentless Fragments, invisible Phantoms revealed only by focus, and swift Creeps that overwhelm you in swarms. Enemies react to what they see and hear, so light and sound matter.\n\n{2620005075104833}\n\nDeadly anomalies add further danger, from shrapnel bursts and electric shocks to light-suppressing effects. Distortion Zones deal constant damage unless you wear anti-distortion headgear. The Radius shifts from day to night through recurring Tide cycles, though sheltered anomalies let you wait out the reset safely.\n\n{2264026724365110}\n\nAdapt your tactics, stay alert, and trust your instincts.", "short_description": "Into the Radius 2 is an immersive VR survival shooter, set in a realm of surreal landscapes and deadly entities known as Pechorsk Anomaly. Arm yourself with realistic weapons and venture deeper into the mysteries that lie within, either solo or with a friend by your side."}]}, "developer_name": null, "developer_privacy_policy_url": "https://cm.games/privacy-policy/", "developer_terms_of_service_url": "https://cm.games/terms-of-use/", "publisher_name": "CM IMMERSIVE OU", "support_website_url": null, "website_url": "https://www.cm-immersive.com/itr2", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440400758
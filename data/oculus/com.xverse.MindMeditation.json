=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GLqsCbE_AEQ7kNvwG0IROf&_nc_oc=AdqVOYGnAbMQHG4N2X6N0o_rnZmxHk_PGn_zY1ce6etleA3InVKxuGTd_L95kBWWWjo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxPJRG7Jzj8ZsJOzSweA4guG4VQB2JtVC9vqpP4daz3dQ&oe=69C1411B"}, "display_name": "MindMeditation", "keywords": [], "long_description": "Immerse yourself in tranquility with our meditation app. Whether you're seeking relaxation, stress relief, or mindfulness, our app offers a serene sanctuary for your daily practice. Choose from a variety of guided meditations, soothing sounds, and mindfulness exercises designed to bring peace and clarity to your mind. With customizable meditation sessions, breathing exercises, and peaceful visuals, our app provides a personalized journey towards inner balance and mental well-being. Embrace a moment of calm amidst the chaos of everyday life and discover the transformative power of mindfulness with our meditation app.", "short_description": "Find peace and tranquility with our meditation app. Access guided meditations, soothing sounds, and mindfulness exercises for daily relaxation and stress relief. Customize your experience for inner balance and mental well-being."}]}, "developer_name": "Shenzhen XVerse Information Technology Co., Ltd.", "developer_privacy_policy_url": "https://appasset.xverse.cn/privacy/quest/PrivacyPolicy.pdf", "developer_terms_of_service_url": null, "publisher_name": "\u53d1\u5e03", "support_website_url": null, "website_url": "http://www.xverse.cn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inp
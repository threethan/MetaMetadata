jXozpL7i-4Uh6g3brvb1cQ&oe=6AC64A14"}, {"file_name": "migrated_image.png", "id": "1559492570865052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_2481287701938145_3363924480509345792_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cnwd-EFfvusQ7kNvwHeBejH&_nc_oc=AdpzdPwphUH4ySiTprwFaaqbMuGjMog6zPLAdmu-e4nBzFCN3xb2AZM5isUduikqOGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeM5da7BRFh1uWGmum7sGBupdPPIHt3CSBNHj-pWOP-w&oe=6AC66051"}, {"file_name": "migrated_image.png", "id": "2648037355431063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031377_447246322540721_3617549622257385472_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pKwCsRwN-gQ7kNvwFuIzkd&_nc_oc=AdrWdF5FqdcB3NaieQ64B18fIm72--UgLd4oLK4Hp23l2v2ga7d80eMfI__ywy9s68Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsDpizTTMGB3WrT8YWB1trbHWd43kHyoyN96T0AmR1xQ&oe=6AC646C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/hlUVc9", "id": "954000998283676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974680_954001001617009_1289459064702500864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXydq6PF7WkQ7kNvwFnBZlC&_nc_oc=AdocXdh_K2xUAImB8piBTd_eX-yJLQWkYmAu26YjQzgU1oIEMRq5BPwuKU7UCUGmQ68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHwWyNHxiKVhHGvPE6C9vsmKaz4rMj9ype4QSNpbf6SA&oe=6AC65CDB"}, "display_name": "Pistol Whip", "keywords": ["pistol", "whip", "beat", "superhot", "audica"], "long_description": "CROSSBUY ENABLED.\n\nInspired by God-mode action movies like John Wick and Equilibrium, Pistol Whip puts you gun-first through an explosive batch of hand-crafted action sequences each set to their own pulse-pounding soundtrack. But unlike traditional music games, Pistol Whip has no line in the sand; you have complete freedom to shoot, melee, and dodge targets to the rhythm YOU see fit.\n\n\u2022 Pair the pulse-pounding pace of an FPS with the flow-state energy of a music game in a cinematic symphony of violence.\n\n\u2022 Form your rhythm and find your playstyle, from tactical to musical, then challenge your skill with friends and world leaderboards.\n\n\u2022 Infiltrate a fever dream of hand-crafted sequences, from bank heists to android uprisings, each uniquely designed to music.\n\n\u2022 Featuring EDM artists from Kannibalen Records, including Apashe, HVDES, and Black Tiger Sex Machine; with more to come...", "short_description": "Pistol Whip is an unstoppable action-rhythm FPS. Journey through a cinematic bullet hell powered by a breakneck soundtrack to become the ultimate action hero legend."}]}, "developer_name": "Cloudhead Games, Ltd.", "developer_privacy_policy_url": "http://cloudheadgames.com/privacy-policy/", "developer_terms_of_service_url": "http://cloudheadgames.com/eula/", "publisher_name": "Cloudhead Games, Ltd.", "support_website_url": null, "website_url": "http://cloudheadgames.com/pistolwhip/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655448735722624"}}]}, "scheduled_offers": {"count": 66, "nodes": [{"status": "PUBLISHED", "id": "916926191030978"}, {"status": "PUBLISHED", "id": "1023472376991621"}, {"status": "PUBLISHED", "id": "1422584466220141"}, {"status": "PUBLISHED", "id": "854600340814612"}, {"status": "PUBLISHED", "id": "705583049234053"}, 
75_4997468884421312512_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98OF9evwdvMQ7kNvwGlHFYF&_nc_oc=AdrBTZfnRYu5VK6uAf7wJ7wyhg15wo39BhGU_h2fkxvB6g0joDNK1dDlSn7Ow2tozGQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt9Uq4sNV_8cWfousY1O60R5W84lHI_Oj7G0DIXeHPjg&oe=6AFC8FD4"}, {"file_name": "migrated_image.png", "id": "1559492570865052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974861_2481287701938145_3363924480509345792_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2mrX-CQjoIQ7kNvwG5JxWs&_nc_oc=AdrLVVo9BYTjOeXZ7EAdIW1FmGFn0doP492zJnEYcy11Nu_ZgfKfKVIir3ib-SgUico&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWC3ikVPERNrkO-y93t-rsNOXmgHQioT-gXMjsPML3LA&oe=6AFC6DD1"}, {"file_name": "migrated_image.png", "id": "2648037355431063", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031377_447246322540721_3617549622257385472_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inViH27cC3AQ7kNvwEZvRts&_nc_oc=Ado-X2M2Bgyl7c6o9XhFuhMgQnVNsEb7Fzik1Nbg-5PXxiznVdzY4wnCxfT_tPKg8gA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9V4_sUHGmPqRy2u1WNDY00KuMmFKvTFBTNFk0yL-8Sg&oe=6AFC8C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/hlUVc9", "id": "954000998283676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974680_954001001617009_1289459064702500864_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9hI52-8pCsQ7kNvwH1xL2s&_nc_oc=AdpVcukAiEn1KmwhW1U8V8zu7vMlQgCaim8phYdQ4rlYadRlsqk_IHkRV-NA4Ab-iVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8ahACO1TkbxD0BnpgboyOD3xQIFKhW2sMLf3dWjE0-A&oe=6AFC6A5B"}, "display_name": "Pistol Whip", "keywords": ["pistol", "whip", "beat", "superhot", "audica"], "long_description": "CROSSBUY ENABLED.\n\nInspired by God-mode action movies like John Wick and Equilibrium, Pistol Whip puts you gun-first through an explosive batch of hand-crafted action sequences each set to their own pulse-pounding soundtrack. But unlike traditional music games, Pistol Whip has no line in the sand; you have complete freedom to shoot, melee, and dodge targets to the rhythm YOU see fit.\n\n\u2022 Pair the pulse-pounding pace of an FPS with the flow-state energy of a music game in a cinematic symphony of violence.\n\n\u2022 Form your rhythm and find your playstyle, from tactical to musical, then challenge your skill with friends and world leaderboards.\n\n\u2022 Infiltrate a fever dream of hand-crafted sequences, from bank heists to android uprisings, each uniquely designed to music.\n\n\u2022 Featuring EDM artists from Kannibalen Records, including Apashe, HVDES, and Black Tiger Sex Machine; with more to come...", "short_description": "Pistol Whip is an unstoppable action-rhythm FPS. Journey through a cinematic bullet hell powered by a breakneck soundtrack to become the ultimate action hero legend."}]}, "developer_name": "Cloudhead Games, Ltd.", "developer_privacy_policy_url": "http://cloudheadgames.com/privacy-policy/", "developer_terms_of_service_url": "http://cloudheadgames.com/eula/", "publisher_name": "Cloudhead Games, Ltd.", "support_website_url": null, "website_url": "http://cloudheadgames.com/pistolwhip/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "MUSIC", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "use
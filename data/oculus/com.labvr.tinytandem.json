ttps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828087_1574505550738936_2335112143320402032_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgecRSDxY3sQ7kNvwEGO-wC&_nc_oc=AdpDRQwKCtMdjR0qfcFuQpMqHEUtOkiAdnSDIVkwtwf41uhl01ULrtafbYi5MvkvUCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6W3kjT9wmeJ3eKCf0jdlVWnUDgIS87klhT8qavx8sZA&oe=6ABBC61C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TinyTandem", "keywords": [], "long_description": "Join Albo and Alba in a charming puzzle adventure built around teamwork, timing, and clever thinking.\n\nIn Tiny Tandem, you control two lovable companions who move together through a series of handcrafted challenges. What seems simple at first quickly becomes a test of coordination as rotating obstacles, moving hazards, and creative puzzle mechanics stand between you and the goal.\n\nEvery level introduces new ideas and fresh challenges, encouraging you to observe, plan, and master each puzzle. Success depends on guiding both Albo and Alba safely through the environment, because neither can reach the goal alone.\n\nDesigned for VR and mixed reality, Tiny Tandem transforms puzzle solving into a fun and immersive experience that's easy to learn and satisfying to master.\n\nFeatures:\n\n\u2022 Control two characters at the same time\n\u2022 Solve handcrafted cooperative style puzzles\n\u2022 Discover new mechanics as you progress\n\u2022 Test your timing, coordination, and problem solving skills\n\u2022 Play in VR and mixed reality\n\u2022 Enjoy a charming and accessible experience suitable for all ages\n\nCan you guide Albo and Alba through every challenge and bring them safely to the goal?\n", "short_description": "Guide Albo and Alba through clever cooperative puzzles where every move matters. Navigate obstacles, master timing, and work together to reach the goal across handcrafted VR and mixed reality levels.\n\nEarly Access now available with 10 playable levels, with more puzzles, mechanics, and content coming in future updates.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/TinyTandem/privacy-policy.html#", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979546511613208"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1431012225602636"}, {"status": "PUBLISHED", "id": "1504870081674855"}, {"status": "PUBLISHED", "id": "3897780017043418"}, {"status": "PUBLISHED", "id": "26047187358312919"}, {"status": "PUBLISHED", "id": "1008662901649521"}, {"status": "PUBLISHED", "id": "798715119865762"}]}, "baseline_offer": {"id": "798715119865762"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1431012225602636"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "990745190493340", "version": "1.4"}, "id": "1584868909830932", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "979546501613209", "is_concept": false,
eDZPYIVRjdce7PfxECho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9K0c4akqJmK3muAEWBduFe4uC1CkaNvZ3WiEBPWhztQ&oe=6ABBCA9D"}, {"file_name": "com.labvr.tinytandem-20260622-174612.png", "id": "2514850399336963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829120_2514850402670296_595891866106728728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeqdFGqd530Q7kNvwG-wLem&_nc_oc=AdqhA4byTCCKa331oUo51D9iv3dO824tvqFStIpxlnXNXzpinptnOohZRZQv79fvEAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLKKPDV5Q4LxQYsytQl-m4PuKTVjcG8vDXTOGYNHvhPQ&oe=6ABBE12D"}, {"file_name": "com.labvr.tinytandem-20260622-175816.png", "id": "1017602600738405", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1017602604071738_4858550635910333123_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YMcqvvUgtgQ7kNvwEwwDYm&_nc_oc=Adrd_NxI5t9n7HOg9ohoFynzvm0KnBkvQEBRDLZc96UpG71hbKpbdy0U6kpZveoDVPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw4mz27yUKhWdv6BAQVbU5OIaKmEGyKSvTD5foBGtM6Q&oe=6ABBBC12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.labvr.tinytandem-20260622-175242.png", "id": "2810452475994271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_2810452482660937_7896258406286326030_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDJyF5I5NHoQ7kNvwG4nwpN&_nc_oc=AdoyPPHg22GydFlfmegvY1_KIS8G9mAxLCTX3F5QAn9MAI7NhM8ZzEuZkJv-V6pnruQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW5j9IbZy2FX0YRm1fjzvLVBf6mYD9gBJVE7GratXrng&oe=6ABBC5E8"}, "display_name": "Albo & Alba", "keywords": ["puzzle", "dual", "xr", "adventure"], "long_description": "Join Albo and Alba in a charming puzzle adventure built around teamwork, timing, and clever thinking.\n\nIn this Tiny Tandem, you control two lovable companions who move together through a series of handcrafted challenges. What seems simple at first quickly becomes a test of coordination as rotating obstacles, moving hazards, and creative puzzle mechanics stand between you and the goal.\n\nEvery level introduces new ideas and fresh challenges, encouraging you to observe, plan, and master each puzzle. Success depends on guiding both Albo and Alba safely through the environment, because neither can reach the goal alone.\n\nDesigned for VR and mixed reality, Tiny Tandem transforms puzzle solving into a fun and immersive experience that's easy to learn and satisfying to master.\n\nFeatures:\n\n\u2022 Control two characters at the same time\n\u2022 Solve handcrafted cooperative style puzzles\n\u2022 Discover new mechanics as you progress\n\u2022 Test your timing, coordination, and problem solving skills\n\u2022 Play in VR and mixed reality\n\u2022 Enjoy a charming and accessible experience suitable for all ages\n\nCan you guide Albo and Alba through every challenge and bring them safely to the goal?\n", "short_description": "Guide Albo and Alba through clever cooperative puzzles where every move matters. Navigate obstacles, master timing, and work together to reach the goal across handcrafted VR and mixed reality levels.\n\nEarly Access now available with 10 playable levels, with more puzzles, mechanics, and content coming in future updates.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/TinyTandem/privacy-policy.html#", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
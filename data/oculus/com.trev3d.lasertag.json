&_nc_oc=Adrl6ParIWKZbuxNrmCRUcnegeTe9HE_9QrWSeTtT7uJBf6K-FZAjK8Hc8SguQpNWRE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EbqHU45MAdb2RvNAXaEMdc-alUxtAIsgiSZLnqoIPWQ&oe=6A0C6FBD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDNszD9ielQQ7kNvwHyGoJA&_nc_oc=AdqN5vxDMqIVF0CgoaMsqQakoJ2LJFW6J09dGt2G4jP3uMjwXjJ4jG_ArMDdLrYYU9k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69_Chtkwx9P-O4ayPFUk_6grMw5S0-8qTs3mtU0GNqTA&oe=6A0C6DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX_cDIUSri8Q7kNvwGDqbr5&_nc_oc=AdpkY35m6EmwrHOVG82a28d68wqigOrmFRbQsaThUasJipCqYt2jZ9KmYBVURTGKrKE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79SFoeK4Zaq6t4hRbIr8jI5OxsTGI-TmhvAEFIPuF6hQ&oe=6A0C6E70"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
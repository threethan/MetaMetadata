&_nc_oc=AdqWON6XdzQc2vkecz3Wf7z8Ei1WyOLhraV9UCA1XQAkRnFJWX-SiAT-1_RcK6oF-7c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NRm6nWLQIM6EWb0s8qhTVDBC2q7uJExTU6YvnbR7LTA&oe=69E23FBD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp6-LV5yXYkQ7kNvwFOHe57&_nc_oc=AdpaXPzz--7RAlx_mpU97BcRYxPs23VTse8Fk1SgzwrfMW-g8mQdNd5MGpoxdPwt6qU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IgjH9IrXRjtuhPwHHR3zsUd5zpSTogNxd5IFoWO_Ttw&oe=69E23DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kYpbRbnkrkQ7kNvwFwT5a7&_nc_oc=AdrXK8pgEUtFZ6L5IsXDoteDtV0jihOBNXS6-5xSwvheCepcWHQct76-x4kFy2OzTxA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bdhpjMOGH4Bt-eIwmdCjW5AIqK2wZFYUL-f7Y0Z9LBQ&oe=69E23E70"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
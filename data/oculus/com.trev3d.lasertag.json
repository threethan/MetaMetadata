tent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxJ-PoqWRmLuT78akULH0gogO-Lt9dGCD6KvaCnmlY4A&oe=6AAE9664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2mgGHAP8KoQ7kNvwHmxqpU&_nc_oc=AdrXQ1bFlb5zWNq7v5GLPDBGZzh1jnJwLM7NK4_C2RZPgVRvO2-kO6ai53T55RmjJYU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1ewZ7aqisJGEI0TSqYu93LfZ-FoCdTLuX9nXiV7NfnA&oe=6AAE96F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https://anagly.ph/privacy", "developer_terms_of_service_url": null, "publisher_name": "Anaglyph", "support_website_url": null, "website_url": "https://anagly.ph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781
&_nc_oc=AdqtkMKwtdJJKmIW0hCVw6wrgcW8xQkO19xy6fVTrXun7a72DO9RGPm1_YahP1iz7ZI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TRjyJdQJhNGCDLNZkv5BpMsDwrbiPYOeKA6JT-eJ1Vg&oe=6A10643D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKqyCLP6PmYQ7kNvwFisUtz&_nc_oc=AdrJlx2eodVTBHYOrYlCdkQfX0sBP3VrSiaZBYqGUPldDE0jfgZR9ehfq9RnWvrWgAY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n6Ntpp6S5TUdGMng2yEyec9G4fKFG6b9ukNchx9vTjA&oe=6A106264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CUbRa2GxTYQ7kNvwGd2y3v&_nc_oc=AdpOqvRpkWnFY7xUG-hNcWs2_crzu3BR9wDyZjvuXOU31EhLwGl93SZsHn1UpKFbat4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5daVSZbK_wFhR1FJEF71kIz1JQGdMuVp4nJ0LP32TIiw&oe=6A1062F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
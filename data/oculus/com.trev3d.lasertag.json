&_nc_oc=Adrir7xmYt0yLLlZAuQH-I6zEEqVyo1UOG8BSK8UTF87kRhF4veNb3s7LwolUmUjucI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz22FAA05pTHFzbycQDw6PLZKqqATNWpUONe_npujG6Fw&oe=69C6903D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vOmSgOqdkIQ7kNvwF93mAf&_nc_oc=AdqEmakWep6KUDc6vef19EAss8zu53x_lsdYdrpXoKETVn--bZA2PIWoDu0l9-_TMG0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6yokhOpRYTnZEIqe6823JC22ej_j6cD1u8KU2usBH1w&oe=69C68E64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6jr1tUdiV4Q7kNvwEgplyG&_nc_oc=AdpULDUIoU_2JdC3OVoaHyNp_7PDPokZFapHge0Dk0PxKTsA336xEL_Fzf0DChujKxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIwcfHUUhlaigINlxglxJRUbZp232hfWNF5-bqa2nJEw&oe=69C68EF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https://anagly.ph/privacy", "developer_terms_of_service_url": null, "publisher_name": "Anaglyph", "support_website_url": null, "website_url": "https://anagly.ph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "31333623136252584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314657_1102760481576369_7500458178113426208_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG4P_ZhOLYkQ7kNvwEITU81&_nc_oc=Adq7MOcg-IueUqD95mV9dUz4vOowCUQaSJ1HAMTuZlnvnlRLS1l-wTaMjul62ilqTAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz21gsGdzroFSFZKutCOMrIq9JqVA8qb61UWXoSVBm9Zg&oe=69C66401"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lasertag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1716263283, "lastRevision": {"nodes": [{"id": "25121192750829018", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
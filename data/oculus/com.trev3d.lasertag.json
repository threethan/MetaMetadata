&_nc_oc=Adoh31SJ1ARNnnpV-34MmPlhNyR14RdXWe3m2uVmbDYGUD2-iW5lM9edZlH8FbqEI-0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dt3O7HyGlGfWRwJBM93LFOfDrFGHjSpxQBDkiDLeinQ&oe=6A01E3BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrp7wqC0cm4Q7kNvwGvAXgc&_nc_oc=AdrBS7YFCJQvJJ9qI5jr4wJMCoBH6sSph7OE7t8ACIZAs84CQBq0nV_JIq9R2Xla9sg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KnMcd8fe-vyC4IIwTOL-kMfWfQPT8mcA_jAJD3W8_WQ&oe=6A01E1E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OSLufIBerQQ7kNvwEgjJj6&_nc_oc=AdqO3S6ssu3qNTYgima1bYm_1aFm4uLKJm5kgmY3jMdrfWAIO6f3_4Q6Xd6ExnS4TuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V09skI4zurFvM7XTfFOMHTi84Z33Dsk7DoN2q_n2V-g&oe=6A01E270"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
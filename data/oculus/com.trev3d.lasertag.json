&_nc_oc=AdpxsxpIOYU9whzjHagOxc9-tKBDnhDF4WZOuiZ-vDrT9WrEJsC0NK_H1zgoPcIaqwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BT3tnJFp4ov2nAu3SzVKXJOpmGE3f2sR4HwwLY7cmOA&oe=69D6623D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RSuo9xHOq0Q7kNvwH2rzdi&_nc_oc=AdreZyflcX6sP9dFKviy0B4-JI52eDYhEF1fQMvzcgqDF3VvjKF_9GbIgZu7XZCP7rQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b527RR7eCiVcZTUj3kPRtbo5qspShpPVxyTxd5iP2sg&oe=69D66064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5xiQqUqj60Q7kNvwHAVC17&_nc_oc=Ado4Xdgehf508d6RafQNyQZtqZG9tQak4TEi0V5Spz3J5c1F7VhyxI0qBRJKs32vEQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CVEJ85p-35C8aKW609_YD-KcNZgBOjwWaFDEx03hl6g&oe=69D660F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
&_nc_oc=AdoEREBGwEMuTTthSARrrUlt8Es2pV5Sb2tIw6F1IjhF2h47lca4DJJOntjr_1-tjIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VeAS5qdHQSznalMWYFNQsgNN4Z2eOyeU-g5NV4AIzGg&oe=69D3BF3D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RSuo9xHOq0Q7kNvwHfyqYs&_nc_oc=Adrpg64wxA22kIoxRZmQv-kBNSevvquQnmEPBYqHbMF5vVDVbDGjq3sWwsh4c4yDp-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kCH8wTDeX30P7Tl8GdHLQ9xPOmG6ZY-ozBLvqR9-THQ&oe=69D3BD64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAfbrHLG634Q7kNvwHVu1OD&_nc_oc=AdpAO3vbse-49hgmigakjQJ4VbK6qI6G9HGfMCY3nwgd-b_j_KstKfQtQtgauQ_6dkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tAY0YaXVpSWESaiU2q93UQFXaCZJt3T0frGkjKUYBJw&oe=69D3BDF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldgN6ygWF0wQ7kNvwGcpvpq&_nc_oc=Adpz-Ar8L044kyhL7IHlGDF9ogq2-c2Gh9Rp6KtoojiQvOSnTyGHrkiGo036xLe5HxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHL5a4r-Rw6XpSW7jULC4YBwNGYMPgqiXykfgevRiUyQ&oe=6B0C6924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zP_LYMRfZG4Q7kNvwEZ2SUr&_nc_oc=AdqMs4MKnk7anUiXwzsR3umLgSuhgv1lwOFwj3BhTZ0Fr4kAAxBEnLqQDKqwf7h4mB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3JZyFmeq9-GoDYQW1ZNYajcKdtZytdtKO0CiF9fBaig&oe=6B0C69B0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url"
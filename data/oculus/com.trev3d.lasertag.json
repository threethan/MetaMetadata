.com&oh=00_Aftre6k1S9Q9n08m9QH_GtXBZL381YxXzU6TR32BD07hTw&oe=699B0EBD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1TF5iGf7s0Q7kNvwH-NmuI&_nc_oc=AdkXQcPmOdGyqzp3O3Yd0b6N_rVVLUPcdN-D1-QPqbIInLiVq434DhWoI1p1JitFfc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvuaNdoksbrhqvWgakn9bPKMVk-MPXH04vBYQSshrkb5Q&oe=699B0CE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQn6I5aSxwQQ7kNvwHb6pi1&_nc_oc=AdkIqv9JexxyqZlt4HFVido_VfeePX1DAtPSYKqvbRbk5o_ifvEggGklbbKcCUvQZ-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftan_4ZpmIledg32cxt4jqrUyhGIdSjLoq-yqtWVYUiLQ&oe=699B0D70"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
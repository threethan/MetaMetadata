.com&oh=00_Af0n2tTFDfMGtSjiWoKalmhENkcxOfaHC063TO8V7hep2Q&oe=69F0C03D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thvQ-5N_j4sQ7kNvwFmOckC&_nc_oc=Adp0KxEX-siJ5GRyjMDl8lnCpZvTp5cjgVTiCw28307WbFhTE2N3MVhvRwy8sWwewYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1QaL0wlMpvtFInwp3bYxdRGH4cEhyWr9bTwFxHbZ--BA&oe=69F0BE64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtFYLhCPABMQ7kNvwHgSSor&_nc_oc=Adr01PGXnK6Pz5SsMg8XCmUQUfqKwaaghAvLSkD8aRRknmyzJK3aAk_QmjgrMsfCUq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2amuWQBbRh6dK9160YiJsgGrpCWDlghN2g402ePQJ1pQ&oe=69F0BEF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
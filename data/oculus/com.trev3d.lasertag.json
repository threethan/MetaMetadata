E7P0VC&_nc_oc=AdpTsdapsNdESHH8doSAF4-oR-LrTOXGd0FA2nTs9qqFq668Dn1N9opL7VpxyqvBi_M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9vTWCOYDp-Px1sJwup5K2SgFb4kvjMNO-Ygs_PqdVIw&oe=6A369FBD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLIK2xuDIvoQ7kNvwEpHFRC&_nc_oc=Adp9Be7RrmIwwHeecFjV2PyEfhqG9Zx2-rlEo0FekSWz0Pu48BdwmzwU1o9OazYhkvI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lD77bJalTM9evvaRceZ0VNvpFFlCzm_IT0rk47aHs3A&oe=6A369DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFUkgXiEfPwQ7kNvwFre1U5&_nc_oc=AdqEN3tM_0M89-ELyaoxWqeHcR79oVf3shDVdYrOlnPMO2wgx7-glewrH7Dzxw5turk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gyiSkGDwo_fXVUTFP41thxuEd-PhhQ5TYOaETNg2giw&oe=6A369E70"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_
&_nc_oc=AdoUF5HU3WW2qxvUiia9lNqqho88LeKDDQdkGs0im122u-jeOFP_-80XDhG4WsFbcfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BOVR59hdz99sDjxsXooJ9L-r3NWkeeyThwtpM-7aQ9A&oe=69DCF9BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGXa7IdH8JoQ7kNvwEdTgUh&_nc_oc=AdpQqF7Q5Lq5pZ8S76fu1UA8sxg0fYrmSheZuZJ_FWYuNAbw1dqkt3OuikY3e6NWNmc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IpkaUAM7Zyy4fdiiqozj-IAKIJ3AAQ8g3O-rdL5gYjA&oe=69DCF7E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48G5zOEVBk4Q7kNvwG77vwl&_nc_oc=Ado-tXxoOoQQLDgLOFkrUGzZNMWyAAOq_DEjL0bAQPEmY1V4EWbdG-Fr4c58m9RPxqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w8Rx8dKS4Bu9MsSfsRxbLAqV9we8ybTb0MWCaBPOD8Q&oe=69DCF870"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
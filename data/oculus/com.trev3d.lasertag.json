D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXgbeiZkbgUQ7kNvwERqHvz&_nc_oc=AdrM9UONrxCCuWz29A4QXy9Ko8drcONCsi2lsWJYY3vGC205loY1iHDjPuGzVw_iQeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgxmCRxr45mqBXYsbyXz8QlHvOv-CHKH2g-uv1KpPE1g&oe=6B09C624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuTIJ1H7WdsQ7kNvwFaZlu2&_nc_oc=AdqPnmNYxx-1GmiGBXlL3Nt9yomYYqBxSqYTwDHxKs6F0Sd95ZDSX4BE6JYV_-gThas&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5sUoFKno6wfnu50Xb9GeaqnahNv6bUvoGT1xrhUZnpA&oe=6B09C6B0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url"
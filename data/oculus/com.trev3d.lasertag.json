&_nc_oc=AdrBoT_YrCEynNqBu3CtqkzfpU5Uo-DCRNqaBvIz_ihTfrMeN6ghFqvkVQiM_FIeMek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqjwJItSlMWo5tKvhI_jPNLd7-1dBhyn9xO0gpYSY7fQ&oe=69C9333D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=630ksDDvUqoQ7kNvwGiA3pQ&_nc_oc=AdqCtBx-stgcX7phPtJunOQeFNIk0FNSvq8mrbAHHbeY0EX9L0xoIvXa5IXHBBT9raY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxB37hzUEA1sd9nFyRqr69_pAHmAigrlFjjkEy345TM9A&oe=69C93164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6jr1tUdiV4Q7kNvwEdkgUs&_nc_oc=AdrQJBIytQ139U3dnDreEXmq2pNbVws28c6QoyW2ovp4rHS4F2YmPVHyQ2UQ2JaatGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoYJwexjdPLOcFYbWOr4QwruPmGUjdIzIqvL5bvGz9wg&oe=69C931F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
&_nc_oc=Adq59cE2CExNiWfLINMeCr494Y4OUnkEXRwhSqhxtdU0jRPuDFvDRZVFAbTG97fD7Io&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e3VZUDcVu4cYeG7hmvXCL2b7vNORD4zH7viIpk1dg6g&oe=6A0729BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoM0I0r4RZ8Q7kNvwGHJ0Sw&_nc_oc=AdqE_333l3_4JXpqgmMp74rcLhN3YFjs9MVSu7C4H95yZk1-KG57HlEj6DWoV24dLvA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UbsTlhOimiDNRFFeMKGNAPavwkmAszzz17GnyzZAomA&oe=6A0727E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrelnYlzINwQ7kNvwF2lTbs&_nc_oc=AdpMHyToNLBYM9tEsw4W8i11zr6xUwaOJzDJ8TTbEJ98RbP7mZJXBUKcbRt4uxH7JT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ryXbZFfE-vVYp7zNA-rfvUy9g7v2AZ12JTpakehEmyw&oe=6A072870"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
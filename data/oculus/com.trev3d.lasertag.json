&_nc_oc=AdpyRsMJLsVa4FuU0cwXl8nceXQNvB12WiCQicmqfWdT3jSUqbP7vLchBeY17XehIwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SIuBVT607w_0mY1B34Vaqnbkd3eIi5PQZw7hxlLFxkQ&oe=69EA28BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXvPKHViTpsQ7kNvwHH0Dr7&_nc_oc=AdqHkLCAVtfZwGdRq8ukpaT5GYnPmLeCxlGHHSCCH2ls3IXaWET8G_QxDhfiW7iJwTk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2em5Z7wfGIV1no1qEdnu4jVUkkUK78oNmOS331HXaY_A&oe=69EA26E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eB3pE4NrysQ7kNvwHAV7Jo&_nc_oc=Adqi7ZuNi1m4kZ1IV20ScLR_9wSxMMR1vmgkk6p8EczXINvt4wV3_cOqIBa4dZQMlPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AMk2Vfn4GbNsB5ZGhvsJpfF53PlAXuf3om_D8WYL-bA&oe=69EA2770"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
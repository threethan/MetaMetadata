GeChja&_nc_oc=Adow9DZMkAVnQYnUuY-5iVxX1Ehg0_DF8MM0ZyB8OmdaYByze7d1XBIRURoUC870NpQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M4bmdiRD3yh96HK5nOaZ3rZNXdXiQrO2M8y_J4EX1pA&oe=6A22D93D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CKvyAq3iRE8Q7kNvwEJ1EE-&_nc_oc=AdpBv-OpmBOXIADWYvfOEeaQeXEaZ6fqvoEP702pQaiMg8ju4QW61utTvXVUzfASAiQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ig7VDYgrjLfa-PqW6ZS-i8uR6wI11WA8x3ymO7tKbow&oe=6A22D764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl3V6uUFA-gQ7kNvwEmRBM_&_nc_oc=Ado5XM5n8HlcOs8_Sbi77Ax76U1BXSYKUOeu6A2uRviLDBq1PIHMD_mdeLo4yGhKchE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lRinQWTNDzLNbm3B3MZLJp8aAJUNxQU6iTCnRu1fe9A&oe=6A22D7F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_
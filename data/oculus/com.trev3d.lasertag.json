&_nc_oc=AdrZU2yV3vWy6V_gtTyeZ12k4GKqbg11sgQpm-xXu4f6zUmd_BJcHUPKVZdDe357DBM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWCLyY5FF625RroD_TQskSSp06rHVaHyAi3acyt7pZUQ&oe=69CE793D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QpTmq2VLokQ7kNvwFWfSNw&_nc_oc=AdpATDU9qGTesyxMfDWAvLa4W_aJ6s7I8euNcb4vyhvqfbuOq9HOEeriPtj_rP5Dpp4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFmDhBdJ2pgod8awolIeqa2nIta--pr1ECHgawLJhT3w&oe=69CE7764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwCG3RQ5F4AQ7kNvwHhu3bY&_nc_oc=AdrITz8JzE9OSqx7DdyFAkjibqkkg6FRhePSrvJijGq1RGBt25ULDLU5ddBEX_VV7ns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybTId-sHhkLSiud5mpAbQyCYIwoETd4qpYzsTJLOZy-A&oe=69CE77F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
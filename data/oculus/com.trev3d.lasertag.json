&_nc_oc=AdoDAy-cwA9uvI7DROzm2XTRlfMu6YnYdQybz50X_Qhs9Jv2-VOAbHfcW2YybwMtzRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxR_j7tS8lB-NfO4tUKDtccV7naJQwUqe0hHDG7ZaoxQ&oe=69CD27BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s9fkUgBPWMQ7kNvwH8nrWP&_nc_oc=AdoAj4Q-StneTIw9d-r1-b_mc1bwpBPVoxR60FnjkxwlyemWDa3M5VOpt4xMdhzPHYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfQGjq-bzWhE8Sbq4j_PaXrZxjaudUMSki5MnCzLGX0w&oe=69CD25E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcjFeyBMGhAQ7kNvwE3GCOD&_nc_oc=AdrFxAZtjRo5Zkyn1Ojh8UvnA22PNwJ51_Hi6HKRp3zYEB4l1WTPxrOCae2bHSzWbOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBzbLB3cRzxBRZDp2bncqkfrmwSqZWSktHTpw4zq2JfA&oe=69CD2670"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
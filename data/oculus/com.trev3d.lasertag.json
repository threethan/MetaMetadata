&_nc_oc=Adrpi13lFbXM-BSXD170GbpPDS78vrHgmRupKRHoTD0xMGIaw81eYb-SVPslcth2lU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FBDQ0cWWOpdF0dxs_JdAvlk6slif6t2LKm9gd2Kdd5g&oe=69EE1D3D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thvQ-5N_j4sQ7kNvwHmuSvq&_nc_oc=AdphwPahDt9SI8S_iDJJUPWnA4H1aMNbhqtRdcXKiMAu8oiJjslpDbO872N1wuaWpzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v9N-fTIfYarBEP6jE9ACVElub1h8Pk7Z9JlJR0vmbUg&oe=69EE1B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtFYLhCPABMQ7kNvwHHXvhv&_nc_oc=AdpqXDgQO-Ia-FDkZNLhj7_W1LLVSPG5-FqeKZLiGkJ6oVkXoxs9x2GU85P2ghlGPvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CfwdiPoJDlu2A85plA_vqR8KmkUYlXdBs7qyFEnm5nw&oe=69EE1BF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
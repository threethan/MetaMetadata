.com&oh=00_Afu1M9WiEzMc7PX6KhYdnVT6suFH9c4Qg6BhqniPG4jmUQ&oe=699DB1BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyS6GSFxql4Q7kNvwEmTEl4&_nc_oc=AdmgCLn6l5T33tXaScCusGUHmPreAUcbrmYDBaeroux9BfGH_5itLwtmxDiZ0d3LfIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsfPgMty4LL0idyWLoSxzkf8vTYD_MB8KHqqsW1aVysQA&oe=699DAFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQn6I5aSxwQQ7kNvwFXgGyr&_nc_oc=AdlKICNry209hjfz2XdvDoNO6vs3AsPE3ChAFm3UJ7vrwITtzrpXNPyXvFMV_3GBscg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft5O_uWbYAZDznV5T-LJ_8bBvHxvqwyzT5fSaiq6TGS6Q&oe=699DB070"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
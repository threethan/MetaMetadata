.com&oh=00_Afveq1mwBWuma_yUQY9NX1n5L1mZRZrJFMG8UMppcmyejw&oe=69986BBD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1TF5iGf7s0Q7kNvwG9kPeq&_nc_oc=AdmeVK2T5475xNyrx_JyzbktqSDuFUpGcVJhUTHHUx2UK2cCjDKpJm5yKpI22kk3Tww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsRBy2GlP3JwXjfbG9mu5O71UBaQgttJbdo-N2wWvwrAg&oe=699869E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvX6SZ_xPSsQ7kNvwFhwyDW&_nc_oc=AdkIi7OQ6PU0oZZxohe9CQcBU-7aYnNhxTm-kt4K85exvyy9gqZSPrj8BjTas5d3VjA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftNRw36muO-TYHagZH5QlXh0iCghu_3b2EN_7duGeuOfQ&oe=69986A70"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
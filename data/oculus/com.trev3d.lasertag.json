&_nc_oc=Adqa1ysWOZfPQYWAxzSUQhyxt2UUJGdL4bozAXecue1c_b6KNfz826hDg8KZYnNZmpY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sxt0FhNKGAsGQfoc5qpB3zCeTh3AJE1g4HrnN_7-HDw&oe=69FDEF3D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY3GnGWgjBYQ7kNvwEypoFy&_nc_oc=AdqDQrWTUK8Rvi5VA30P0wZymSt211yVZ4HRcvGf45owyFI2VEu78wxvfNUk-020xtk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LnUe0UyonC959DXnPHm-XwZPlVPXM60G5XKLTj_9kuw&oe=69FDED64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bY_ZbTF0BmwQ7kNvwGb2C0H&_nc_oc=Adr2W3ObqIl32NC40TWa2eVy0S3Akn0dpwMNE1YiLGHgaVZiuSE0wPNX8tqbDh4aaUE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HHthEjZX0vfOOP3mGt_nYEtXS-njEvpY5OtSocn7u9A&oe=69FDEDF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
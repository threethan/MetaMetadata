&_nc_oc=AdoJjVNDEsjemSXblYYfhJb7f1dOoEULlEaFCrEhO6UQwiG3Zz7lkwvBn-bu9S5ogI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_I4hAH2z9e_2hGkHbz8ZQjK92_iy5TQSZDatDxuMr7A&oe=69EB7A3D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXvPKHViTpsQ7kNvwF1F0VE&_nc_oc=Adpir05TWDtbohoCNkvjoEghdfRXjUfSRw6pEnTRAsOhPt36SuURa6qy88yAzBsmxUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af184MXnWHxXNicNCCviZXMoBB-KH8pHE47C1vWb4Xitlg&oe=69EB7864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eB3pE4NrysQ7kNvwEehYap&_nc_oc=Adri350J60_kxP-Np5PWBgqTJamw8Z-MG_WRC2IIc9yHP8qIYBU7BTYv3OBC1L_gZ_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RtDvr7lRoglkBm9A9fxaQ8_teLPTGnu0pnbqRlfgMiw&oe=69EB78F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
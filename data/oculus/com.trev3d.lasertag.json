&_nc_oc=AdpraQCuiFifP0IaxIXonEZY85U6hcQl_3uex1geDCaYLD3ghxDFhcL8-7o1xOtdfkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FRDDp_di8SY59sEW9r3iY7UHHEAnFzaw7XSssqf5bmw&oe=69D9053D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1wUuVMTsJoQ7kNvwFUPMr8&_nc_oc=AdowtKW9qBteSTuBTmhNPAlcqUx-ZiCblEesudwXrIAeI7P1gendGUSuMqkZw8a84Bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZWy5teNDwRG3q_2pEQLYznVTHtq7LRgjYjDzqXBN_0Q&oe=69D90364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5xiQqUqj60Q7kNvwGqknw4&_nc_oc=AdrKdO5G8BRuvrsuwNR6JNkhpVfTX31KZqRe0-MHaIo9sFP0JXYct7HK9CafzcxCpbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HW2xxA7Cpdsphv_IzowAHxNrNOR5sBPVdQ9FDoVfreA&oe=69D903F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
&_nc_oc=AdrvindlGnQiHGXZVm194DzjB0hwU8HJYGYIaiC4kT9Bgf0S6HOa65cBINFL8VQa4zQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e9UbOHOtJBhI-HTbqV2P3iAts063cbHMGqLy58tf42g&oe=6A3E88BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsRajyBgW9oQ7kNvwFvyUFm&_nc_oc=AdoDj7cpOmucColwKcvckB6E2IOuhHz1yUE9PrMrwDcQVB5Bmodqyz1OmbnPSVrBOPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wLmavAFuGNdSFuDFrrj9abq8sjUryvIfry3-HxJSbTw&oe=6A3E86E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BP6MRpb2u1gQ7kNvwHLLOnh&_nc_oc=Adql0VU2r48_6d6t_JSc6sepGCdX7DFDwCBEKZPtbcP8pJJlsNG918AX1Tlkvzit4dc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JXNzgSH0HP7YdVLZPo4SyEXxD0GIM35pXTY7w2KYOvw&oe=6A3E8770"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
&_nc_oc=AdqvnLOz0oRBx-v1PJnNP-Bs1BOH6sVyn2hVb03ryBfsnIGpVEq9Y_EUfoadVKjg_IQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iy9QdbhWJ5HmP0Ih-ddV3trk0QASVVAusqdamaNenrg&oe=6A1C41BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THqrSdhSsdYQ7kNvwHsw0aE&_nc_oc=Adoi9RsosrDuS_PG6haec6-Aln1tHpBCFcDt73QioRALCSYOnggPjp_cNbrWm5QQNv4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bhhelMfDEzLlh51_9Y_zfau2Mz0cm5Sy3MX5IoQZzAg&oe=6A1C3FE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q56L422wAwQ7kNvwHG30-b&_nc_oc=Adpf4mF8QlnW4rQElgsw2CHP7rWFFKWmSmWvBsBiYHLSZ97nDVZekr1IFaDw1HhasJc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YpUzl1K6m7ij-RaMXsetB5porE8Hke5EglwbgVppGkw&oe=6A1C4070"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
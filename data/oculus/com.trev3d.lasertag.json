&_nc_oc=AdqxQIRY1egjjzRN-NsFgiDWDfNiw84-cGHInZe862hJEtsKnSBJ4zobMIbbgmBx_Ww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6He-t6dFRdsy_xb3Mafktpzo4itEw-EhKcbC3yp6a8jQ&oe=6A1458BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIw44ssP81MQ7kNvwEXsgAQ&_nc_oc=AdpufLcB-URmS9wei0uazlrPcXrhxMAn35flsIRh8Ye38C2l56Nhy_vozI-MozEw5-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YDKxEJ0Tsq4_SefYAclWek7AgyPTimAWguYyYrsAy6A&oe=6A1456E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mltkpYLNKg8Q7kNvwFHLPqX&_nc_oc=AdpgPeLR-81GsHmCbpOzys75UEtZMqtQwn-LPf6jicnnxISeiHEcwrxweythJDgkLbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xcAVfzs3ydZak4Kf5qIHKUtp52uSYoE-SNdnaUKSv7w&oe=6A145770"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
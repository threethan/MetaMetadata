.com&oh=00_AfujpFjW1qDOjwhMpHVphqiGxjNGZeX4r4Nvv-Hgn7MeFA&oe=69A1A63D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcB8CwC-LQsQ7kNvwHQ4X6Z&_nc_oc=AdnB5ijwaQU905DPXNrrXYDZDBePbuK7p8uA5urfjUEDWM8qXsdaoKE5o16jOpI-s_E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuTffr72hqqLNxBWXD6vfGIaK0WAjatuxRjd398fzUAXA&oe=69A1A464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a8fbl65qv4Q7kNvwFWk_AU&_nc_oc=Adn6Dj3zJQRRxnnepIFMXiwZ4laW4KVDd6fHA38b5FO3e3VV7ztatILZXffHLCCkANM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftuaqRzvOiOwEqMMtLQt_fEcn1Fv_r_GkCYFOrHhM5PNA&oe=69A1A4F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
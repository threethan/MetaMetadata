&_nc_oc=AdpSyVwGzQnnvTt2BbNQBiI4VLTM_xzaUjYabjgv7RfwPxpWXwM0SI5SLWk-aMkCNlA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zOP7CP8n-YY59Fp3AFChHfP1prWAo6GlGrTCUtE6JaQ&oe=69F8A93D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s6KGSWe9dEQ7kNvwFkdA54&_nc_oc=AdrZooZ7MjFlH59GYI9lYGQAoCHamhiB9oKews4VqNFG34ilvXx7-z59fU4l7gbxlvE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ie8WWZfi7OVPABilE0zb_uG7STxqSzZ-iu76X5BTUqA&oe=69F8A764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNSMZ2w9PLAQ7kNvwGA7oK7&_nc_oc=AdosqTqu_mu9YRi6Tgzq2UQ5Lo6_XyhTnZ_4PgphVo48h8Mrf_HYCmbHOjkE7oMYWe0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23ZkohWl2l2sscVlruWV9Aa6SAJZPrSIP9M55kAod90A&oe=69F8A7F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https://anagly.ph/privacy", "developer_terms_of_service_url": null, "publisher_name": "Anaglyph", "support_website_url": null, "website_url": "https://anagly.ph/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "31333623136252584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1102760481576369_7500458178113426208_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebRrjRUcfmUQ7kNvwGd7G8w&_nc_oc=AdoP69Ch7h_Rso_KRSewEXciIDlzd-Od57CBoeUUP28Jx--Hlb-AnvyFGvTaD6c4mZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TKN-MescvyIOaAlGCncTxtFlH2NwyNsGsdJP2bbw9UA&oe=69F8B541"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lasertag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1716263283, "lastRevision": {"nodes": [{"id": "25121192750829018", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
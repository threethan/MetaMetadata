D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCqUl5QSJH4Q7kNvwHo0v_y&_nc_oc=AdpNmAFuSCosY-H9YwCZufNnWQgi88lPaaMQi01CPF3TZkurEYOCy0nh0CUSajyPPXI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpwoyh4aZdjRIeGFNoxQQ0kwleG7RTSNDY6vaeMbTWXA&oe=6AFB45A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niCn2c1ICVwQ7kNvwEo4ZTe&_nc_oc=AdqPh609B0SlZ16sNhPJGJ7Cq1ZGSfnv8f2eL0rjKK1CGzpKV5mc8MmL1ZmyUxlUi-8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSezAYwmtAZul7cv-i6wDH0B6HCFo0Z30HPysvTmzsweA&oe=6AFB4630"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url"
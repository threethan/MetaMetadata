.com&oh=00_AfuNY2ksDd46BawB0T0B0hAp71F9BSW2AJ_hjKz3W34N7g&oe=6999BD3D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1TF5iGf7s0Q7kNvwF0ownG&_nc_oc=AdntOXwLPm3kFBAa3LiMbF_3t3NCEBp0Q5uGWEWrf4twJ2NQd8o5VUjHHeJB_tk-5Bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuY6KJi0YvyDTSwPZqjb6g46lrv0J01PHX_p0CwQ4oSzQ&oe=6999BB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvX6SZ_xPSsQ7kNvwEWKFXb&_nc_oc=AdmmmeSLImiBbsyfsbBptSYbS9uqdxRuSwAOs6HDiUas_ZTLI2onLEVrv7p-9R51nHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuLdRPjPt_m_Atw7GrUjevy-w2OTGpH3GcqIJ4CiHrbSw&oe=6999BBF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
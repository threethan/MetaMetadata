.com&oh=00_AfvBH0lZeP2-YuaLGQb5IpdDbIndjDyKpXbQt8wuaW1XUQ&oe=69A054BD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcB8CwC-LQsQ7kNvwH20AyZ&_nc_oc=AdmZs5rOF0fLhqUoSPxB_OBBmrN-lXQRB8PtSPtTi1WDjIwNipckKNbCzbIgM9MTxYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuf9PCjSYP2D-IJQBjAL09ukS1ei9_TzjJbINQwQR2wHA&oe=69A052E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a8fbl65qv4Q7kNvwGZXbYg&_nc_oc=AdnbDgLnlQ3refeuEk6HO94aA3EYb_VU4iCM2t30aD8Uw5-nVKNIIewZZsLZ1MBKJRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6ew1ouwAbjhBeXVF0KvGW-bHZs8n7rtGijk1NnOVMaA&oe=69A05370"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
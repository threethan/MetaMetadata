.com&oh=00_AfuSQshJkH7yDkW2HcE_CW_NadzOWyQQ4sDCNtBgzbCUiw&oe=69A59ABD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuHZbRBJP-gQ7kNvwF6O2IX&_nc_oc=AdlnydSvJqAbxu8-zB1U9NbRXw_TGKOs1bQ0THXPscXilD_Tq0620olQDL_t8mGzA6E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftHtbqEH03PxhdzogUql8MwUXBMtOi0_S4HlzetrpKNnQ&oe=69A598E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4-GLXH9h2EQ7kNvwFMzzNd&_nc_oc=AdnuYqw2FUARLK-jLz16uq8761eHBSwg_4WYfEfcXB5_CVQ3fKpudlIqbxiLcuFVno4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afteh7kvYrl3vmMDvwFsM1Liv5mj_lg4N4SgodLqdPCYZg&oe=69A59970"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url": "https:/
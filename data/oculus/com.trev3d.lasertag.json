D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTabYthJIAAQ7kNvwFQsNcT&_nc_oc=Adrj1eTPKCLu4YPM0NtYiqoA9GDG49YUXECz0ox4AKZjzBq3YMLaFLu-QFlW-zrKbuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT99Bkgs5pZf2RfhOvoK_EsHQ3vsIIU7khFakiIIWl14A&oe=6B05D1A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQZ9Yh5TzIQQ7kNvwHiCjRU&_nc_oc=Adp5RkDx_rotx_60nKJUBR3yTm1e9ZXVgM8UuzXaoB0KzVzExMgg3dS7fSz8bf8jdb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDfLYF6TcUoYC_qUC7djcH0baR1BXlWahUYUFiQcvgxQ&oe=6B05D230"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_description": "Turn any physical space into a laser tag arena for you and your friends"}]}, "developer_name": "Anaglyph", "developer_privacy_policy_url"
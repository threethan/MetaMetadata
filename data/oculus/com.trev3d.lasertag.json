&_nc_oc=Adp_WczCMDlsMFA9T369sgpJ3-EInjgflUIE3h3EveYhDHnRmlCTUwXn84VFVzJsrR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ptIiQCmdBMvzOB9tCh0Mzfl7WvkhI2CGKs1jccmC1fA&oe=6A03353D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrp7wqC0cm4Q7kNvwESe2rI&_nc_oc=AdotKq9HMs7pKTNFZw_mIpbV5RwvxN4H5_blLYHLyV9UUKXCuDZFYYz_UxXxIfDgVU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wxgxvoz4NBiX42IQdPN3Ou_-HU8DliVa88biLDPCLBw&oe=6A033364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OSLufIBerQQ7kNvwFLTy6G&_nc_oc=Adp9WWFdsEBgRYR0onrW6dZO34hDiTg_SSoPX_STIJqXECyv7F5GpqCajWtaftAwSBU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FZioz2ApOZCX9qqkudKek4x9Dr2gJ2SyOje0frz4mDA&oe=6A0333F0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
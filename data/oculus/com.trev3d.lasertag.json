&_nc_oc=AdpoZO733WVtgYd6P3x3KJ0-VHafwevQb5nWsEusedpWwiyYGykp9bS5pJXFiuml5VU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l3lgGEF-OSfmaXlU_cr_vRBriZKqqd49o2gTxNut1Ug&oe=6A16FBBD"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWhf2aLSqRgQ7kNvwFnAdUR&_nc_oc=Ado0FK3B-_Q6ciOdhiTrlq-JNYZXo-FNOkDRZ1Vhe2gvKGH5fvxFtOjcmkLvlRpjUTs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Jkd-0fK4dDVPwhTfEWJ09xxrHUS0fsAI-db06r7rrw&oe=6A16F9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joc7lKnaAY4Q7kNvwF65Ffw&_nc_oc=AdrbUssHWOG4iZUnehVK36cYHx-QQLypDhoSdkN39baGJHnL7F5062yJWxUEt-_Ilms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k-Sd4hJTdrrWSjcQifsHQ3jgPviQxxgmxuhJH3rwL6g&oe=6A16FA70"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
&_nc_oc=Adq_AnCDrRwtv1O1LZ4uqpQO_m_l8ImhXEI51as13862wcSa-72NLuDEL6Vz-NKGm9g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxe729tUWhpetUj-Kuz_GrIkEnSah_ZZ8juRxefA0v9BQ&oe=69C3ED3D"}, {"file_name": "fwa3.png", "id": "1181628443981656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821178_1181628447314989_4274608194453586051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vOmSgOqdkIQ7kNvwFQQwLD&_nc_oc=AdputqYsN_FoJhTnwOX-mHgAioJZL1ptojhdlm6RNwY1gUwqKnWOJ5tHJxc2LKxlSa0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyieP9ZIW0hms7QP-bTNNf-1exfO1K5uXG4cNJDVlqGlg&oe=69C3EB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1272221703934454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499305194_1272221707267787_1827965176633839495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WNs1ed5KxgQ7kNvwGc9VzK&_nc_oc=Adoc-J8kZANHYx-j_R8oThaGueUX944V7YEEAbSGN_cPJhF5RF0KHX0uhGwmAetxTVo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_V8JiRdFHVVyZX4Rhg8Tmexq71SWKBf6FULIvUUO9BQ&oe=69C3EBF0"}, "display_name": "Lasertag", "keywords": ["pvp", "fps", "laser", "tag"], "long_description": "# Live environment scanning with no prior setup!\nQuest 3 and 3S automatically scan your environment as you play. Virtual bullets collide with real walls and furniture.\n\n# Automatic connection\nNearby players connect automatically, so starting a match is super easy.\n\n# StrikerVR blaster support\nLasertag is compatible with the StrikerVR Mavrik haptic blaster peripheral to take your laser battle experiences to the next level! Pick one up at https://strikervr.com\n\n# Early access\nThis is more of a tech-demo than a full game at the moment, but we're actively working on making the game more engaging with fleshed-out gamemodes and more weapons.\n\n# Discord\nWe have a Discord server if you have questions, issues, ideas, etc. http://discord.gg/DgTqG5A6BD", "short_descri
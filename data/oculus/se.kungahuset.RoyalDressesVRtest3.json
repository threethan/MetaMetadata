ungliga slottet som gav bes\u00f6kare m\u00f6jlighet att se de kungliga brudkl\u00e4nningarna och \u00e5teruppleva de kungliga br\u00f6llopen. Utst\u00e4llningen var v\u00e4ldigt popular och f\u00f6r att l\u00e5ta den leva vidare och n\u00e5 fler bes\u00f6kare har man nu \u00e5terskapat den i en virtuell verklighet.", "short_description": "VR-app f\u00f6r utst\u00e4llning av svenska kungliga brudkl\u00e4nningar."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kungahuset.se/", "developer_terms_of_service_url": "http://www.kungahuset.se/", "publisher_name": "http://www.kungahuset.se/", "support_website_url": null, "website_url": "http://www.kungahuset.se/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sv"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "327806865934559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162695_474167502958308_681814680871632896_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7yfIRwM99MQ7kNvwFJHIU3&_nc_oc=AdnrQew6I0y8fPgqF_uJxYnSRHA0G0I9HQKz12CFZVLI60FExUlicPLMUfZfkQPf5UU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxvlw9JYje4Lo-rlcazUzfeJKT7vqFIkY2E0hXWnygTwg&oe=69B3FC3A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Royal Wedding Dresses Virtual Reality", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1511805600, "lastRevision": {"nodes": [{"id": "
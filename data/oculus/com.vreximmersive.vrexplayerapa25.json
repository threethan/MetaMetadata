wBX3o66S0H0Srb4ZUybd-WTjWV7nNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDsgvE5fpyTq-V5uRwBDZBx571AMn1rM_EF3xPBsj1PQ&oe=6B0F043B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "National Parks Georgia", "keywords": ["Georgia", "VRTRAVEL", "NationalParks", "Nature", "Tourism"], "long_description": "VR Parks Georgia is an immersive virtual reality experience that takes you on a journey through the most remarkable national parks and protected areas of Georgia.\n\nExplore the country\u2019s diverse natural heritage, from majestic mountain ranges and lush forests to deep canyons, rivers, waterfalls, alpine meadows and rare wildlife habitats. Experience the hidden gems that make Georgia one of the most unique destinations for nature exploration.\n\nThrough high-quality 360\u00b0 visuals and immersive spatial audio, VR Parks Georgia allows you to discover protected areas, learn about biodiversity and experience the atmosphere of Georgia\u2019s wild landscapes from anywhere in the world.", "short_description": "Discover the breathtaking beauty of Georgia\u2019s national parks in VR. Travel across mountains, forests and protected landscapes without leaving your home."}]}, "developer_name": "VRex Immersive", "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Agency of Protected Areas of Georgia", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
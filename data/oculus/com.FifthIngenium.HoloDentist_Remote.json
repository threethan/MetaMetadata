25/39036665_687524459315377_7304706057550264784_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rOpViYtVEAQ7kNvwF2oDIL&_nc_oc=AdmjxyUh2hf4ZaPY7cafDGN41E6UaeocTvPUqysYyb0-hVa2AkEYZ44JrkKi0_HqrfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfznOAVg2bwUQfJdbKbaeC8AR3FU4gVCzQ3SFre5pwtYgg&oe=69AED99B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HoloDentist Remote", "keywords": [], "long_description": "HoloDentist is a mixed reality application dedicated to the Digital Dentistry sector.\nThanks to HoloDentist, doctors can analyze and explain the treatment plan to the patients using 3D data coming from CBCT, intra-oral scanners and face scanners as well as 3D modeled implants, crowns, surgical guides, etc...\n\nHolodentist also enables two or more people to communicate remotely thanks to an integrated audio call system and the opportunity to work together on the same 3D data in real-time.", "short_description": "HoloDentist is a mixed reality application dedicated to the Digital Dentistry sector.\nThanks to HoloDentist, doctors can analyze and explain the treatment plan to the patients using 3D data coming from CBCT, intra-oral scanners and face scanners as well as 3D modeled implants, crowns, surgical guides, etc..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://holo.dentist/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://holo.dentist/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["MEDICINE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en",
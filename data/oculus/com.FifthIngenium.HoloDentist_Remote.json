...\n\nHolodentist also enables two or more people to communicate remotely thanks to an integrated audio call system and the opportunity to work together on the same 3D data in real-time.\n\nIf you want to get a Demo account to try the solution, please contact us at info@fifthingenium.com", "short_description": "HoloDentist is a mixed reality application dedicated to the Digital Dentistry sector.\n\nThanks to HoloDentist, doctors can analyze and explain the treatment plan to the patients using 3D data coming from CBCT, intra-oral scanners and face scanners as well as 3D modeled implants, crowns, surgical guides, etc...\n\nIf you want to get a Demo account to try the solution, please contact us at info@fifthingenium.com"}]}, "developer_name": "FifthIngenium", "developer_privacy_policy_url": "https://holo.dentist/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FifthIngenium", "support_website_url": null, "website_url": "https://holo.dentist/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": ["MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "26223353390604967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75308615_3251328821755712_5691740572252714973_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmTCx7tc6U0Q7kNvwH7APBo&_nc_oc=AdqVhD63LJ04MnNqdM2ggvH-LCfCqGcINM
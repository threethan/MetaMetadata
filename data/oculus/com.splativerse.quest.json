AQULJOn1tbLdL6a9Gq4s4i4qP7wFPq18gsLiH_XRrgbmiw&oe=6B0EFAB7"}, {"file_name": "05-Kumamoto-Castle.png", "id": "969178345988206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839755_969178349321539_4424932139641041490_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIxiXO7yJ_UQ7kNvwEV0GBC&_nc_oc=Ado0WfJyifd8tKjo0ILov7SrPth27n-wXiTpKJ0GvNtBfCol72KQ72SNOjyJs-UFNVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW83ZNAfMeX49W30twS5JH-1XWpFgWIVotjOK6Vc8qiPQ&oe=6B0EF4D9"}, {"file_name": "03-Dogo-Onsen.png", "id": "2728796230908067", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839691_2728796234241400_116986753901945170_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_cSjmZ1lNQQ7kNvwEQgXZm&_nc_oc=AdqcRIt1pbLqnTX96cAno9uJ4ZPHRoVhTS6yzfNrXDN60iovivsORqITAp7LfF7Zipw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOzlT1y7WvajVBVRrbstqDNIGzr3Dx8AIZkz8Fy1HTog&oe=6B0F082B"}, {"file_name": "04-Kamakura-Buddha.png", "id": "889920434171396", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839720_889920437504729_8635014716428150293_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yciEU71JFc4Q7kNvwFQleIO&_nc_oc=Ado1JWowwohia6XkK8ssxVtJqJcy7dPqW_DXhXToDqTvMnLMfjf3vNy7ZURx4dZtdwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKABFhpMJSdDHU93AZHsnD_MqlX-wp2NYblqU4SEDQ6A&oe=6B0F224E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Splativerse", "keywords": [], "long_description": "Explore your scans from the inside.\n\nSplativerse turns compatible Gaussian splat files into immersive spaces you can move through on Meta Quest. Look around, fly through a scene, and save the viewpoints you want to return to.\n\n\u2022 Import SPZ, PLY and SPLAT files from your headset.\n\u2022 Search and sort your scan library.\n\u2022 Save, name and revisit Views, including directly inside a scene.\n\u2022 Hide scans from navigation without deleting their files or saved Views.\n\u2022 Adjust the viewing radius and appearance.\n\u2022 Move or hide the immersive controls panel.\n\nA small demonstration scene is included. Other scenes require compatible scan files supplied separately; the locations shown in the screenshots are not bundled with this app download.\n\nTouch controllers are required. Navigation uses artificial movement and does not provide collision detection. Scan quality and performance depend on the source file and headset. This version supports scans up to 1 million splats.", "short_description": "Step inside your Gaussian splat scans. Explore immersive 3D spaces, organize your library, and save favorite viewpoints to revisit with a controller. Supports SPZ, PLY and SPLAT files."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ncubeeight.github.io/Splativerse-for-Meta-Quest/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ncubeeight", "support_website_url": "https://ncubeeight.github.io/Splativerse-for-Meta-Quest/support/", "website_url": "https://ncubeeight.github.io/Splativerse-for-Meta-Quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1441417102391763"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839689_2247998866124126_849
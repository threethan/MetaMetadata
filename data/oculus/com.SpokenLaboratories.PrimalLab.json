_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRc41P5BJFuI7Et3X001csj_Zz7b1HyA1aERE89t09XQ&oe=69B2C284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aaaa.png", "id": "1249772293199174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830615_1249772296532507_3827602851437760726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1Uj0gM3DbkQ7kNvwFoy_gL&_nc_oc=AdmReN9OSjLgBcJnKbOvIeQEFXErvNMmrQYRK-bU9f1A4zrPmlb6x6K1qejwom-bsK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgLATkNnCfLQyfuoxMzaa0mNfm61c3A9nhHQcEZaQ0Ww&oe=69B2C3FA"}, "display_name": "Primal Lab", "keywords": [], "long_description": "Primal Lab is a horror experience inspired by Gorilla Tag movement mechanics. Set inside a mysterious facility, players must use hand based locomotion to explore, survive, and uncover the secrets hidden within.\n\nYou are not alone. A failed experiment known only as Andrew now roams the building unpredictable, reactive, and always hunting. Stay alert, move fast, and use the environment to your advantage.\n\nThis game focuses on immersive atmosphere, AI driven threats, and tense exploration. Primal Lab offers an evolving horror experience with ongoing updates, new encounters, and environmental enhancements to keep players on edge.\n\nCan you survive what was never meant to exist?", "short_description": "Primal Lab is a fast paced horror game where you explore a facility and survive against rogue experiments like Andrew. Use your hands to move, hide, and escape the danger that lurks within."}]}, "developer_name": "Outspoken", "developer_privacy_policy_url": "https://walkboygaming.wixsite.com/my-site", "developer_terms_of_service_url": null, "publisher_name": "Outspoken", "support_website_url": null, "website_url": "https://walkboygaming.wixsite.com/my-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
1782341139017447", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830776_1782341142350780_8577216266601927816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5SXqcEPinwQ7kNvwFjv8Pk&_nc_oc=Adqavgb5XxEnSyPMlQYLjHZ2WwXGZcXIYANfGH-knIw7Y34ovii39rZvJM_zcANnmsw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQDVTe-w8yzSKskYrK5CIVkTh2j99lw5RTvwG6iUiuWQ&oe=69C51AA6"}, {"file_name": "1.png", "id": "730167696617592", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499311559_730167699950925_6871449491210946251_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0DNcVUn2zsQ7kNvwEs4vgo&_nc_oc=AdprHTsTrhHt_E_o8y7qaMWwOQZi-hunmI-lNYnw-KbEClUSS9qh9WGqLR8QLhvtWRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUw9GcWPmuoXcK9Lqu0XgvtAup34xg2BJJnfAxLtRLlA&oe=69C533BC"}, {"file_name": "3.png", "id": "1016051650597435", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830003_1016051653930768_3284518048656398394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UETH5NUPWgQ7kNvwFavscQ&_nc_oc=AdqWFsOWVHzThtBPB8j_sEi8i8byDOcTyE859-FeBo7ZLGjFNA_2KW7q4qSabS-I5gs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGwXsLG7T8gBYr_bGyZ26jk9HJeAqJvl7KWIsL-Ei7Jw&oe=69C53784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aaaa.png", "id": "1249772293199174", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830615_1249772296532507_3827602851437760726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD1oPC6oLEcQ7kNvwHd2IbG&_nc_oc=AdoIPlePbc0LFx8vP-VqJzbUqQA3UlVJil7qGE1Nuf4Nvzz8q3CXvrMcfCyfZ-3KcLQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpygUwd6WYr2_NB1TIgrpGQmXVBmi1tZcV0Bys1wRQnQ&oe=69C538FA"}, "display_name": "Primal Lab", "keywords": [], "long_description": "Primal Lab is a horror experience inspired by Gorilla Tag movement mechanics. Set inside a mysterious facility, players must use hand based locomotion to explore, survive, and uncover the secrets hidden within.\n\nYou are not alone. A failed experiment known only as Andrew now roams the building unpredictable, reactive, and always hunting. Stay alert, move fast, and use the environment to your advantage.\n\nThis game focuses on immersive atmosphere, AI driven threats, and tense exploration. Primal Lab offers an evolving horror experience with ongoing updates, new encounters, and environmental enhancements to keep players on edge.\n\nCan you survive what was never meant to exist?", "short_description": "Primal Lab is a fast paced horror game where you explore a facility and survive against rogue experiments like Andrew. Use your hands to move, hide, and escape the danger that lurks within."}]}, "developer_name": "Outspoken", "developer_privacy_policy_url": "https://walkboygaming.wixsite.com/my-site", "developer_terms_of_service_url": null, "publisher_name": "Outspoken", "support_website_url": null, "website_url": "https://walkboygaming.wixsite.com/my-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24571379069130118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831056_4245329039022435_7090529998979922283_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGGcGsprvRUQ7kNvwH85UGI&_nc_oc=AdrgtDec5V7e73VNcgU2id
0_8577216266601927816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvzVEADeogEQ7kNvwGIYM7m&_nc_oc=AdlY-WL4aqnACiXrSVAVoi4bcqfIcBkJLoFrSV05GvHEZ30nWXdDaaZEIRd_nwPpdLc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfteFXTxPuA4uZ7fg9rVN0QwQZ_Qp1MmoyBEj2fbHulG8g&oe=69A18226"}, {"file_name": "1.png", "id": "730167696617592", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499311559_730167699950925_6871449491210946251_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3r4CPJ_E28Q7kNvwGGXmqd&_nc_oc=AdmYHgTuHqQC0XWy_F6QF63vbU1he4a53X7f7tyjdW-SS7T5tZFDkJkKpUfI7DIkfDU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afung2PK6ZUUCnpLgcqr2Wb4Yg1M2nW0YHZIAsKZMrFkkQ&oe=69A19B3C"}, {"file_name": "3.png", "id": "1016051650597435", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491830003_1016051653930768_3284518048656398394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhpeWQHXL5oQ7kNvwGly-x6&_nc_oc=AdmNHXBkYknOg9OR7vmdongzDIbissY79ZJJnKr6nxyJJU2fTLCvASN2feu8cQU0aIQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft0WEU9cKB2q8Jn1N4z1kTnkPb6DTlQs0JJxK7aBJ5n3g&oe=69A19F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aaaa.png", "id": "1249772293199174", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491830615_1249772296532507_3827602851437760726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWRnpLWPPDsQ7kNvwHs_34z&_nc_oc=Adnhmo1r9U_9KrlP1Y_f5W6oo7NJ1qEPXOhDi-gXP8pYzkt05rc65Flakm9Zf9wPbE4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvMa2PdOuzB6drjNn9xIpz0XHCXj59pzlsJXm27eLN8vg&oe=69A1A07A"}, "display_name": "Primal Lab", "keywords": [], "long_description": "Primal Lab is a horror experience inspired by Gorilla Tag movement mechanics. Set inside a mysterious facility, players must use hand based locomotion to explore, survive, and uncover the secrets hidden within.\n\nYou are not alone. A failed experiment known only as Andrew now roams the building unpredictable, reactive, and always hunting. Stay alert, move fast, and use the environment to your advantage.\n\nThis game focuses on immersive atmosphere, AI driven threats, and tense exploration. Primal Lab offers an evolving horror experience with ongoing updates, new encounters, and environmental enhancements to keep players on edge.\n\nCan you survive what was never meant to exist?", "short_description": "Primal Lab is a fast paced horror game where you explore a facility and survive against rogue experiments like Andrew. Use your hands to move, hide, and escape the danger that lurks within."}]}, "developer_name": "Outspoken", "developer_privacy_policy_url": "https://walkboygaming.wixsite.com/my-site", "developer_terms_of_service_url": null, "publisher_name": "Outspoken", "support_website_url": null, "website_url": "https://walkboygaming.wixsite.com/my-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24571379069130118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491831056_4245329039022435_7090529998979922283_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viVYKSbrSLQQ7kNvwEs9vMP&_nc_oc=AdmPWdRdAX7p9n8aeegM9ykMnFUnUHUHZV9TDmmfs5xs6uJklReYtx6ZEZEhRtapFZ8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftigJ2LafOWq34UgsqqrvFy_wU4kUEMyBqiZyjkUdQwog&oe=69A1A92C
1782341139017447", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830776_1782341142350780_8577216266601927816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORsuQpj362wQ7kNvwGtipDZ&_nc_oc=Adqi2fdBFcceM2wq4c_KG_QTjslMFQ92ZhujYoT3YD95NG5X3cJ0DnhGwFkMVLxJ6MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-foM8nti5QRCvECrFdaR_4SjCKqywE2dpNp-TxA-KDhA&oe=6A259066"}, {"file_name": "1.png", "id": "730167696617592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311559_730167699950925_6871449491210946251_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_Pxb0IB2GgQ7kNvwEsUHLJ&_nc_oc=AdqoL_ToMBJ1a4x2f4aP1W1UzcpfZq9lSqCXj9BpDrr0Q2pA5Smv8FYQlxN9aS6ITX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DZbVr3dbvOfrIj15y9SL0PLQfThEK8bLqzCzZDebdPg&oe=6A25713C"}, {"file_name": "3.png", "id": "1016051650597435", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830003_1016051653930768_3284518048656398394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duhjA1yjMbAQ7kNvwF9BbKt&_nc_oc=AdqAaKpgk4cBg_4GlFph_pgRuYEd-hueuOyPnwbtFx8gXWgKYw034ARpQ1usTIp2sQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oyzc2JHRYo85d0cCmrKzRBIqKUYWyox3Q9EyQ0UEZIA&oe=6A257504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aaaa.png", "id": "1249772293199174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830615_1249772296532507_3827602851437760726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXjtuVcWgJAQ7kNvwH7fazQ&_nc_oc=AdqDdicwwgnFa4S3KsQO2NJNLlqkXXevV1drftaHN94wzgw5GOEZY0rhGq-ptltEi-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NXVQ6sAf3M8otB0OcD5ufCpq4VpMUkb2Ho70vNRqO6Q&oe=6A25767A"}, "display_name": "Primal Lab", "keywords": [], "long_description": "Primal Lab is a horror experience inspired by Gorilla Tag movement mechanics. Set inside a mysterious facility, players must use hand based locomotion to explore, survive, and uncover the secrets hidden within.\n\nYou are not alone. A failed experiment known only as Andrew now roams the building unpredictable, reactive, and always hunting. Stay alert, move fast, and use the environment to your advantage.\n\nThis game focuses on immersive atmosphere, AI driven threats, and tense exploration. Primal Lab offers an evolving horror experience with ongoing updates, new encounters, and environmental enhancements to keep players on edge.\n\nCan you survive what was never meant to exist?", "short_description": "Primal Lab is a fast paced horror game where you explore a facility and survive against rogue experiments like Andrew. Use your hands to move, hide, and escape the danger that lurks within."}]}, "developer_name": "Outspoken", "developer_privacy_policy_url": "https://walkboygaming.wixsite.com/my-site", "developer_terms_of_service_url": null, "publisher_name": "Outspoken", "support_website_url": null, "website_url": "https://walkboygaming.wixsite.com/my-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24571379069130118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831056_4245329039022435_7090529998979922283_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E73EFpABCAMQ7kNvwHfVHeF&_nc_oc=AdrN74ZzrwMo1wQc7zOH7G
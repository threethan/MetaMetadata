1782341139017447", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830776_1782341142350780_8577216266601927816_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfS5rGP5ykoQ7kNvwG5fJJZ&_nc_oc=AdryagO7qaeNMCOzNl0hZfRMPd9ywoRKvgZNx_kT0Gc3iFJin2jBk8SCddDw0ia5jn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ReeEH35xRY3vWyUC9q4A5t1fkZ1oWwauWrK8Ck2wsQw&oe=6A3E9CE6"}, {"file_name": "1.png", "id": "730167696617592", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311559_730167699950925_6871449491210946251_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhIqE6QNyPYQ7kNvwH6sk79&_nc_oc=AdoFVNf6g7zFWYhrGNw2Vuc1dznc_ZYw7xuc_-ZhTiyB9AfR71cvKuHeTqGlp6_jzSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K3a2p1VturD7n-hnm9wDk6NV60ca-XPrMf0Qjah4h9g&oe=6A3E7DBC"}, {"file_name": "3.png", "id": "1016051650597435", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830003_1016051653930768_3284518048656398394_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YmZH7pqWUQQ7kNvwH80Fu9&_nc_oc=Ado9Xec-wjdM8_jKc6n-u_Px9VB2E5Y3KzhNMgrfQB4kx5o-M8iOhviy-eWsfyKdrLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JllLZAHI3gzoykI1tiC5HZ-ADT7YIHudRIOgpjBCM6A&oe=6A3E8184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aaaa.png", "id": "1249772293199174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830615_1249772296532507_3827602851437760726_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DNC-C1J8EIQ7kNvwH55rZU&_nc_oc=AdpQpmKCw9lKwJk9kzHoasXL1khixi68daO-qFq7YnZ0XfgxItxtbQ57BnoF4Multo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EGssnsTdYmNn8AApITUTWFnKbPJDySQLCPmCKv29cnQ&oe=6A3E82FA"}, "display_name": "Primal Lab", "keywords": [], "long_description": "Primal Lab is a horror experience inspired by Gorilla Tag movement mechanics. Set inside a mysterious facility, players must use hand based locomotion to explore, survive, and uncover the secrets hidden within.\n\nYou are not alone. A failed experiment known only as Andrew now roams the building unpredictable, reactive, and always hunting. Stay alert, move fast, and use the environment to your advantage.\n\nThis game focuses on immersive atmosphere, AI driven threats, and tense exploration. Primal Lab offers an evolving horror experience with ongoing updates, new encounters, and environmental enhancements to keep players on edge.\n\nCan you survive what was never meant to exist?", "short_description": "Primal Lab is a fast paced horror game where you explore a facility and survive against rogue experiments like Andrew. Use your hands to move, hide, and escape the danger that lurks within."}]}, "developer_name": "Outspoken", "developer_privacy_policy_url": "https://walkboygaming.wixsite.com/my-site", "developer_terms_of_service_url": null, "publisher_name": "Outspoken", "support_website_url": null, "website_url": "https://walkboygaming.wixsite.com/my-site", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24571379069130118"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831056_4245329039022435_7090529998979922283_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd7LXHFeNO8Q7kNvwFaiBVW&_nc_oc=Ado_LAWVY69pYKcWisipE6
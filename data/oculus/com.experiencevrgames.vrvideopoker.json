_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9kZZhoQ648Q7kNvwEucqX6&_nc_oc=Adn_-2i8qIlbIc9TZOFMRUBMem1GGexGjRacUzXlFd3DGTQhEiYGDUc0cn_J8P-4u4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoWp5h7saAVx4ERmQJDon4HnA7_FRGQeygTsLbobikvw&oe=69B0125B"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRD9d13FLrQQ7kNvwEd40cf&_nc_oc=AdlREQYTfJl50YPQCmEbT56Ek7PsmXx98CUX2thhxR3unW55MaCTYoOkd_vHOOAd9r8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4cvisHuJaDKlWRKigO1r-_siyQx7PVU8BbNz5IEBvMg&oe=69B00631"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdyTYchf9OgQ7kNvwGORpTq&_nc_oc=Adm-oLNBNgHP6dsv2Ry5WiNpPqTT_9IaBVCTobsMJnw_47n4DJtwGk519U659C88Oj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyClyUNzk_Pp8kGVxpMiamjuPxXc5X9PNNc3fDmhhFZIg&oe=69B00F43"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD6fNW25XWUQ7kNvwFpDyzF&_nc_oc=AdmO7xJd-FdpJsj2KrJAmnOShI7tYAzyWgXjZe5sg_KGT6tCLHVOMcY50oAtfqMrQnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiBvOnL6BEHHFEo6j8MtbZcXGEoBR72aP8nmfUE9ApuA&oe=69AFF858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv0suWOzBD0Q7kNvwFyRm66&_nc_oc=AdkSmGr0uON4zKwJHJatQogM8BsMh7xx0SME2otLu6jaZ7cmFLCPtP_TLDnrYFa2uuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5eL66FFOA0y-1Nd2jjuYqjSBPyiTJsg53Eoj4tvTc0A&oe=69B02871"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
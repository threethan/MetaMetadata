_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aen-A0K9F2IQ7kNvwEzNxDP&_nc_oc=Adldz75xyXNIwetbaq3oWMxmlinxGCh1AcqNe70oUUtzAel6Q3mTWeONi51YSyYomOs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfynMTor-oQ4BDLwtetcKRtjslTdqYYqDM6R1F0BQR6l7A&oe=69B2B55B"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRD9d13FLrQQ7kNvwEF3ExQ&_nc_oc=Admc1TmWbaps3z6NygCkLtqXeS0i4U_Mv-cjAkwaaCuFSUtBY28hE8cJJaXpngSKKrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_sP2XsiHRkTs58MrRtPiCN3zEVULqm-1vQfI25a6qGw&oe=69B2A931"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX_GXW-qqpIQ7kNvwGIv663&_nc_oc=AdnbQBxp2mseN82yjJIynqt4XQgpE1LFLFUZGooP_eNRgQCIttrfbxggzSP7bJ_byl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxASLnzSRhgfRk0pk3GrfjdrLryK_PmOGcky94f-ZhnyQ&oe=69B2B243"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BdJdj_lKrQQ7kNvwHZttVB&_nc_oc=AdkTlHp9OZEJniGkObP4fUsQMy3i1ZseF5sJ8XlzlFyZ4MInDDJYXZvycu8ejOXJLug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYFq1Cy0g4FFBsqoQ9gztrFP6btSadz5RPrNL2vPqiMA&oe=69B29B58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc1xOBsDKZIQ7kNvwHNQQXY&_nc_oc=AdlZhSynTHYnmGpGL8EmhQpUt7oKm7zGX-LDMt4h5VIWk40iHTWz0A0bqwmXYmeAHeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvR0SP1EahWKO_ZLsImy2e4DrYcVljIZU9wEC3WZLIlg&oe=69B2CB71"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETuEkcX6h0UQ7kNvwEIh1bG&_nc_oc=AdkuMqrr9ZyJOWUAnvUkAfhlAIH37g48jRxFcTxk5aA8Fri4PRkUOMlHat--NlEq9tU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsobW_oPrr1Y_6E1d6GhgGpc05cbyqLm0a5hSW5XziD0A&oe=69A97ADB"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdF7LP3-rIQQ7kNvwGB2XzQ&_nc_oc=AdlZouh50j38qs8TDeuO8ZopaWXgBCofVUUg2wFBclKVdZQXN3HFaMyahk6htbL3D9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuj9-jYnDlN97Y96MxUdDwSnU9Jl7iKWmIyMe3i5tLGQg&oe=69A96EB1"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x26F7N-j9gQ7kNvwHnGiPx&_nc_oc=AdkcIRKqztJS4F5X3KlX8bpDvLLU63Xt_Ot-W_IbQxK02mmjxY09svluqbTJR9nFxpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvsXfYtRpwQzBdovNGAuM8DZg9kvSWTD-JdjSCUvElNQQ&oe=69A977C3"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPNhNnBaua4Q7kNvwETFnSL&_nc_oc=Adkm5-JW3WXkQjeLDSppSbfaTXAs2AX1wH037m_16PeHAaNWmcLPvCPNReutsc516Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsc530k_GjLdqD0Y52cXtJES2OUk5HEYLI1jFwl5sW1yw&oe=69A960D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn99N8HjEZMQ7kNvwEsKUnh&_nc_oc=AdmdASWI0cRqTmVM8sC4gP6IRNXPfMGUGCZbhPf36B7-4suoBN9_M0rs6D9tbC_lb44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftdTLwjXFI8vIenjrY6ONpHITgTh_MN_Z543xCM8Pv0Yw&oe=69A990F1"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
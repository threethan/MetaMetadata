_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDCCcTJ6WBUQ7kNvwGOmWUj&_nc_oc=AdmO7np7PiVyQWHbdkVzIt99J-ql6goD-ndd5FFmD94qyKsDSLyWSmXBEgtkQH4llvs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxS27vyNVmKqot8U_IbjzkCwt03v-6Lyg3wOHbRMrMncA&oe=69BA9E5B"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOa8vKqYeY8Q7kNvwFrb8J4&_nc_oc=Adkd8CMYSDVBzKqMYppsMauJBQ0p4Ih8ge43Gz-DG7F9RDA4-8GbqqT3LLhjgbTP-UA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuSS5Rh4Yoko2nizPCyNneAKBjMHWF6Wf0ji67LpZPJw&oe=69BA9231"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSos8PaI41sQ7kNvwG5v-Gy&_nc_oc=AdnfBUxQYr6stx-UUJIvZVj0NiwmWYx4QwLQ1-nP6mWcXhbhApk-rpSkHupiNLJ5aDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2Uii0-bvgkdEjfKQUMxf_Bv4a0PNcR5KFH-nYXtK8Og&oe=69BA9B43"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr4QKPYCg-IQ7kNvwGZeo3K&_nc_oc=Adn7LcNZIhXTxxYPEB_J9U3agyYqKYbukPF9D_3cVEp6tbuRQAUVBZBtYYTVqz3YwmU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6-xyRVYFxfwZsfKTao6Fl_Ei_eScZxk1yVrwkpWKlrw&oe=69BA8458"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0sD6LEykEwQ7kNvwHmUAVO&_nc_oc=Adnumf6fAGGNNbju5aW_C65opV3_S0zzOydpyLjvj3796zgu8_IASeWWKC4HGPd3gdY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCepsf3CBfAjO5lAUsYaBrsMs7OK4FAnj5ejcFK7ZBmA&oe=69BAB471"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
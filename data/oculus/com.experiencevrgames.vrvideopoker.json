_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEN5I22OIvUQ7kNvwFiwJm3&_nc_oc=Adnq50OMVx4rFTLKbDEsoAcqoQk_wACqEKs6IRRNcpYDGFkPpfnCJBPQObnn-ra3MP8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxgTkdMGl20Ps-m0SHvfyDcUWHFcsk9iWhNTxuNFivyww&oe=69B7FB5B"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOa8vKqYeY8Q7kNvwFjPj3C&_nc_oc=AdlrPU-Z-xTRuPZ2xcEQYNn-D4hEeG32LJl9-tfaia5E0YLRMVjY4zbsFkGT8e68UU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyUMRwmsVFwnMRiXvXTmqZhiIrXNxlb4SzVoDUnmNJ38Q&oe=69B7EF31"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlOTDHYTbAsQ7kNvwFRTfhY&_nc_oc=Adk7k1OjbTtZWDwiXI-8nSnz2DwzGWR-13CzkEZMqo9Fq1kfSQjQZaX1bAWGwqYM0rE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrXdiIGcvvtYP6QCNVZw6WjQcNKD9VLhN2ke_3TE3UfQ&oe=69B7F843"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZGeDN6K96gQ7kNvwHxdBJG&_nc_oc=AdmJ4kvzczeeRRj8PiaQxweF64xG5bPR5a1q6rVT0UZTgML5RwGBBcD96vXpjiJdyw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrQZNypdLJrDZDYJ6m3RZGFbrQIyyrWxipSVqL6DL8lw&oe=69B7E158"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Do9DE9nnYSUQ7kNvwFCGxfF&_nc_oc=AdlN1puXpE9at77lpfUVDHGTTbHMBtbIhPHchp990soeJTrEf2ysjLd543b4SijGLxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzbde7l3p_DFxiJ1u7M4B0Ra3xPeeFeYbfQzGu5yGsKtA&oe=69B81171"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ82aJvmxiEQ7kNvwHI-T4y&_nc_oc=AdnW72z4PV33_FjGM8RXXe7avduCM4rrI7A6hm4BTRZv6byt1bPCQKyRe-OlH6gBCBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz557Pb4CjEi51L-bUOkK2PRkQk9REcNHHulPzw3FsB7A&oe=69AD6F5B"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iJ1E3zEyAwQ7kNvwFQnb60&_nc_oc=Adn-ZcguOeIwkiQZ9SOfSPbeAmtUNKZpuJQ6rEv9EPfkxmZpI5wZHqWpYi_lxbLn5a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXpcuP8iyXKY8rjdL9sJ4Z3HbshuBXWaZ5FlDT-KwrKA&oe=69AD6331"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdyTYchf9OgQ7kNvwGWIelw&_nc_oc=Adke4aiiQxFAC_zYMiDNmHJr77gmj-XdIsFXuiV8nz3hWvywWYvpbbYB7K_1u70yYx0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn6MDSC67G8lTL6TBQRE1rjTDK9_Iru5cbr7oIHvc-3w&oe=69AD6C43"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD6fNW25XWUQ7kNvwE8-wve&_nc_oc=AdmekELB4yzKvRuppolP_eIFXtIQLu0pfLj6ALtH5QcfBQusdp_I6F3qEYp327MRM68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2YRkzcw9YyUoZ_J5940ReeiNYzWeb65WIcdHdiSAZMg&oe=69AD5558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L12AqAPJjJkQ7kNvwFK2-BW&_nc_oc=AdnwpuDFWO4gvKvUEoA7zH-1Tb5GzRjcIvwFVonN2nKrKida4NeCTpLodfoJRnP0Nqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjVKTJqe0Gz2To8ZDTXLh9MIaXYWHFzsN2VuUxk4kWIA&oe=69AD8571"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
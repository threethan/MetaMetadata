PDmB&_nc_oc=AdkKD8jiJVGkR6VyFXUmn3M34D-n1MEiHe16mrFUsVsDTSTxzWn-py2x28jOrxnZz0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVR13pGJyMrZCCRt_NdlzfzOYSg5Ll7Zq-4eh_LjyvKg&oe=69A431C3"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4rUqfFtvKcQ7kNvwHsL3fY&_nc_oc=Adn0XM64uoRalfCYfceapu-V2aqddsOGypVhXC69YnyE8G39LiRqYU0kzwAYKx6ZjMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuz0sE1OR9TrCqZrQ42vonY9rBRukAaW66I8gZhUlPekA&oe=69A41AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRMt-FpYlFIQ7kNvwELGo9-&_nc_oc=AdnKfxZ9gQJYFNb8G2wjp-U374_pM8qsWz77PLL3yCtwoMkOYq37Hv_gujB5ReNGSpM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNfDrKf9-Hy9S5hL2G9o5MPmzSd9--sXF03OnkGDBCIA&oe=69A44AF1"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the co
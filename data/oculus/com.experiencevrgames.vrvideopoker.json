_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aen-A0K9F2IQ7kNvwG5e_60&_nc_oc=Adn-ABzoun0W2n4dDaPn7PIefx4xMMm1kqvkMejf1B4-FS9peV7PG5EFQ_W5bNkg67k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyvretrPqj6UUS2HIf1NuBVZ3t7f6pPq61xGurp0Xx2BQ&oe=69B406DB"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWOj5PZREK8Q7kNvwHevNPy&_nc_oc=AdkjPyAa6I67lYREx6Pqwh0lt4s5hCeG6fhwET2hrmJKtGWB3KRHFWFrIcecRE2gLM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxE0tz8szpLJxjyKo-rU7nL5X29cJOJVcwppkR2iXl7qw&oe=69B3FAB1"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX_GXW-qqpIQ7kNvwFP4kY6&_nc_oc=AdlUb9U-pw_oXt3ouactBI0FHlB9rZ9ofzQJFrsyDV2ptfTTmWXTM7m8Dccix5puCWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzoYxxtSZ4wINbifP8HOBZMsrBxxay1tZ42DFhvCn0ow&oe=69B403C3"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BdJdj_lKrQQ7kNvwGV8K-J&_nc_oc=AdnXOnQXEt0jUhKWRsp_PfbcP3oau2HEyQMWVycbdoHR2D9e8Egh8CaZrxA6jKZbgA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyph2vIAJcI4MSUcKxN6Dh7TciF61XI5yyzuinr3pi8mg&oe=69B3ECD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc1xOBsDKZIQ7kNvwGcZ53m&_nc_oc=Adnn3Pj3VGD7TC9t7nfvIlnMIPaITB7aMPrdnh2r1lUQMDPgyWJJnrjk6WTHwabnsDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5D70wcprjz5DoB1DVAz4utnvvRz02h6Tejs7G6FvHgg&oe=69B41CF1"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
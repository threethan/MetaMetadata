rated_image.png", "id": "2565556726999916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_eG_xvPGQoQ7kNvwHbFXtQ&_nc_oc=AdkF3p-ihQb06tLTld-LygqciJduOldDTd2qFgT5WnhI6jmf09wHqtWCOQRHcgohSlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz06h2m3W0ssy4I9QW4OaG5emqCQoanpwOMNNvRp_Dczg&oe=69BFE143"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37TMIwKC6EwQ7kNvwGtEUxS&_nc_oc=Adl9GNPYSAS7GYrUOUqmIVjG3a7IwE665Abh3Jb4lLQxLHwugqmQYjY1ShkzJaLdinI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMlhieQBl6wsJWS74TtdoKiH8TYBIDhGAR0OID2cDfZw&oe=69C00298"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oEDLdkQTJgQ7kNvwGlKrBt&_nc_oc=Adnn3BBHqt2URS71eORz3EfBCUXC3eQ9fH8VB01SLMbPppmLFauYoz7M40LIjJjXyi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJoE1awiI8OzUuqxA4qDdUynDdYRlpcRneVvmVqfvLhQ&oe=69BFFA71"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465687005230076"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "357041925011798"}, {"status": "PUBLISHED", "id": "492740961248696"}]}, "baseline_offer": {"id": "492740961248696"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1562000400, "status": "PUBLISHED", "id": "357041925011798"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2016644238372845", "version": "1.1.0"}, "id": "1499093656860578", "channel_name": "LIVE"}]}, "is_for_oculus_k
_214323166155878_2792330261159739392_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDCCcTJ6WBUQ7kNvwHeDSE5&_nc_oc=Adm-bp5vabr2jQqC25TgdWklKPtIiw8-T-spzgqX6sME9fIHCI_NVhL7KmwinlHoV2Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afys47ZulKffCuI1Bsmb5-snvuwyIclkIrgzvr-VYMAxRg&oe=69BBEFDB"}, {"file_name": "migrated_image.png", "id": "209475473732125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974662_2137931359584146_2015228002794733568_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ka7bT9cM_-MQ7kNvwElOQDc&_nc_oc=Adn0hhYl6kP4jfbyRWUqwg7ACGG_vxzI3SXiXd7b78Gze3psnZ8rA9wQ4Te4E95ZVRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKoN8bf65Fj6p-6orWqp08bRHsQjf3DRZFSfRqKmtHKA&oe=69BBE3B1"}, {"file_name": "migrated_image.png", "id": "2565556726999916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974734_588155201626918_626134119255900160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSos8PaI41sQ7kNvwH0RKP3&_nc_oc=AdkXI1RAVWiA0HSQNwUDYoqjOz55Oe5E1a38C0niFy-Yh55x5_HvG3tdmMQmMEKAlJw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afydy7MCQKowLwXqS7jhl9x3FJ7gfsPCtNdSkBatgkjv2Q&oe=69BBECC3"}, {"file_name": "migrated_image.png", "id": "1822279854571303", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974470_2465823577004795_3766819664441638912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr4QKPYCg-IQ7kNvwF2OPwC&_nc_oc=AdlRkN4n4MqoYTiOrgnnpxhOTUXyiqvv209OI3GYfjWt029g_tYWZiNybzTGN5HlRpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw77yEFMUrrsuYLIHv506t4E7aNSZ67SfixdIhZGeYuYw&oe=69BC0E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/XoxR1G", "id": "394517381287914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_394517384621247_1185750697019179008_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0sD6LEykEwQ7kNvwEBfg2q&_nc_oc=AdnuU6HmM-MEm5GOZn1No27Z-nkPE-nKQWL16z_NR03Z4IVtpse5RANcdP1ryH23NXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysR93RUGuwUdAeJLHcBmXwC0rUFNQkzU3Vk8KAG4ng8w&oe=69BC05F1"}, "display_name": "Video Poker VR", "keywords": ["casino", "poker", "cards", "relax"], "long_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing. \n\nFeatures \n\n- Six game modes: Jacks Or Better, Deuces Wild, Double Joker, Aces and Eights, Five Fives (NEW!, EXCLUSIVE), Pick and Draw \n- Play alongside NPC personalities including Smoking Martha! \n- Never pay for credits or sit around waiting for a time-based deposit, when you run out you can add more for free \n- Stats for how well you play over time (complete with a fancy graph)", "short_description": "Enjoy one of the most beloved casino games from the comfort of your home. Video Poker VR features all-you-can-play Jacks or Better video poker along with five other game modes. With classics likes Deuces Wild and Aces and Eights along with a new mode \"Five Fives\" you'll find a game you'll love to sit down and chill playing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.videopokervr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.videopokervr.com/terms-of-use/", "publisher_name": "Experience VR Games", "support_website_url": null, "website_url": "https://www.videopokervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR-9SlbmoSEQ7kNvwHo0Uvr&_nc_oc=AdoaLcUTJRF04S17PJ3VEGh1nJHE5A3ZRrP6nQ6hAObVmivqBNGKkZoS50EcjmxXvDQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c8NqFy8usIlIVVi8eNxSfTjS0pEWIy_pVt6J4BZdv5Q&oe=6A16F783"}, {"file_name": "WhatsApp Image 2026-05-01 at 2.17.51 PM.png", "id": "1502225861555988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293972_1502225864889321_3013843068060582523_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK_COfnjf2YQ7kNvwGXQYAm&_nc_oc=AdoYNA67aVskFrk9cNcr1rYtUBc6lr5LPfyHO_fWgZt78XHWWN9r-owCEIPdwcMU4wQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wFmAjgrXhutwZ-ncvFPTjAbBWHqedzGhnVRxNvajPWg&oe=6A170ED2"}, {"file_name": "WhatsApp Image 2026-05-01 at 2.17.51 PM (1).png", "id": "1294201002663930", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_1294201009330596_4639788604980281697_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtDzvjeO8AcQ7kNvwF0vshm&_nc_oc=AdpNHjVX8cHBfZnbWHuZchgYshDMP3dh2XZ46ImabOplne7Ymy259k8E053sVWY5IaA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yyw3YigBrkC2a_N7aSAKD-ljKPJIT9acTbrX0_MjlhQ&oe=6A16F206"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Safe to School", "keywords": [], "long_description": "S2S: Safe to School is a virtual reality\u2013based pedestrian safety training application designed to improve road-crossing behaviour among school-aged children through immersive, scenario-driven learning. Developed using the Unity engine and optimised for head-mounted displays such as Oculus Quest 3, the system replicates realistic urban traffic environments representative of Indian road conditions.\n\nThe application places users in a structured journey from home to school, where they encounter a series of controlled yet dynamic scenarios, including signalised and unsignalised intersections, zebra crossings, obstructed footpaths, roadside vendors, and interactions with vehicles, pedestrians, and animals. These environments are designed to reflect common safety challenges faced by children in real-world settings, enabling experiential learning beyond traditional classroom-based instruction.\n\nUser interaction is facilitated through a VR locomotion system integrated with head orientation and movement tracking. A behaviour acquisition module continuously records user actions, including gaze direction, crossing decisions, and roadway intrusion events, using raycasting and collider-based detection mechanisms. A rule-based evaluation engine assesses compliance with established safety protocols, such as the right\u2013left\u2013right visual scanning sequence prior to crossing and adherence to designated pedestrian infrastructure. ", "short_description": "S2S: Safe to School is an immersive virtual reality game designed to teach school children safe road-crossing behaviour through real-world traffic scenarios. Players navigate from home to school, encountering situations like zebra crossings, intersections, and roadside obstacles, while learning essential safety practices such as looking right\u2013left\u2013right and avoiding unsafe road entry. The game evaluates actions in real time, provides feedback, and builds awareness through interactive learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Co0jzt9e0XD23JjuoxHb214ILUgCZ953lCmuev-2aCs/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1oJQwyHILZqSO-sMS4R59Ky5EcMgDPIl7TiDnL2uc3kQ/edit?usp=sharing", "publisher_name": "Abees Jibin", "support_website_url": null, "website_url": "https://sites.google.com/view/s2s-safetoschool/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUI
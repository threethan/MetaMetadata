735412545_8718002698399843994_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaivFl_DVjcQ7kNvwHNxWXF&_nc_oc=Adq363-TiJtaOT_4e3p0z_8ZmISrjU5-MIY-I7wk_3ZuAvrg8xamIBOTn1bnV_4Amus&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAAa9kTL3nP29pT0ggZyrVw5Qje311WMVKk_hU5KLqaw&oe=6AFB3F91"}, {"file_name": "Bedpan_Assistance_Simulator_SS_06.png", "id": "1186675029345939", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982549_1186675032679272_4057784636743753083_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI6H_myZos8Q7kNvwFxbGq-&_nc_oc=AdoZoh0QDOHGt5tUdCpyN_HGgAGSIjFGaTowk8C0VdIug-PndX45r8N7JLtOsILwwwg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD4T2rLY-1by817WWDpNT0mpLcAk9cLYeF18HjT6cQCg&oe=6AFB1A31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1144586286617894", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031613_1144586289951227_3958037237275083766_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6B1jtED_FO4Q7kNvwHk8nqN&_nc_oc=AdqzR06Nq_QspFec-E_Tls2J7s0DMES4TcC3VqWR99kD57XRDmtw5rbDr8E5J7Xp9_A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQImCCIuradDnxwe50k06k1DrYaed_TfyL_ipgP0bKV8A&oe=6AFB1C7D"}, "display_name": "Bedpan Assistance Simulator", "keywords": [], "long_description": "The Bedpan Assistance tutorial immerses Certified Nursing Assistant (CNA) trainees in a realistic virtual environment to practice and master the skills required for providing proper bedpan assistance. This application guides users through each step of the process, including patient positioning, maintaining hygiene, and ensuring patient comfort and dignity.  \n\n# Learning Objectives:  \n- Remembering the steps and protocols for bedpan assistance \n- Understanding the importance of patient comfort and dignity during the process \n- Applying the correct techniques for positioning and assisting patients \n- Analyzing the situation to provide appropriate care tailored to individual patient needs \n-  Evaluating the effectiveness of the assistance provided and making necessary adjustments \n- Creating a comfortable and respectful environment for patients requiring bedpan assistance.  \n\nThis comprehensive approach ensures CNAs are well-prepared to perform bedpan assistance effectively and compassionately in real-world clinical settings. ", "short_description": "Designed to train CNAs in providing proper bedpan assistance through interactive, hands-on practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6596900520434534"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1113042487316620"}, {"status": "PUBLISHED", "id": "1068937144647284"}]}, "baseline_offer": {"id": "1113042487316620"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749742680, "status": "PUBLISHED", "id": "1113042487316620"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resul
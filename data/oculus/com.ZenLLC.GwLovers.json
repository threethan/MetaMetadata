6259931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391924_1350071529593264_5935327002290414006_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gI_rwTFKYRkQ7kNvwHkPpct&_nc_oc=AdoKJSHIzOnpLd9Jpbvu1su-LkFAfYJlT7ailRkTLtCkYhDbNG1qgVZuf9hIkVamdPY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DuDDY5w_owHM6vSijgUeIB5UnbQ0gyHdfbFkZyX4_0Q&oe=69EA1EC2"}, {"file_name": "screenshot4.png", "id": "1841467256629308", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_1841467259962641_221508447805457689_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_XPjwdGB6cQ7kNvwEqlj93&_nc_oc=Adr6Ze8XSIQxOnRv8iPyh_vPWQHEj3hKB9fsEv-DOxu183q6KKteA9Fwgv2h8Cf5s0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2549wLJcDGe8ifubVkFnn5XQARb2Ai6H3PEUPFJU_zLg&oe=69EA126A"}, {"file_name": "screenshot5.png", "id": "1128625529010411", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391959_1128625532343744_1326273777573583637_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ny2pO3az5oQ7kNvwGHePQ_&_nc_oc=Adpnhoibyfz6ILhn26FW6e_T3R6P6OFRHGSS7FstYiBZg5v5sUbQ_W7NWn2YqZ297hQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ftZl8AGioIjnl3codXb8HbXGYMD1FOCcD2tde1vKjrQ&oe=69EA0A74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gw Lovers", "keywords": [], "long_description": "\"Gw Lovers\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Tagged is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Gw Lovers\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UqsEPypXHYkON0ZVGoW-kEAdBCuO9g9hAdYS3xRbFSA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zenix", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1JmFG3qD3gRnkEgOuEu0yxT2Et_pD05hE-B9Jp5ohjR0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29264045223208759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393328_1332192864664684_3858630271809699342_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DAk6kSK00wQ7kNvwG3d4Pr&_nc_oc=AdpURmQX-2ShWlCtwe2VUQgjVqfJhSIVMrx4mVWw81gMRchVnQtBDeXerRS8AxfS8ME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14Kx-bzK7jOYYKNj6orAJ13yqBKnlf-CqzIKNP6i3rWA&oe=69EA0A42"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gw Lovers", "platform": "ANDROID_6DOF", "context_category": {"context_category": 
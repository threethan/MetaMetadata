6A5A21EA"}, {"file_name": "screenshot5.png", "id": "1128625529010411", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391959_1128625532343744_1326273777573583637_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMF8fPnNM5cQ7kNvwGtib7D&_nc_oc=AdrEvvy0gyBZ2QUYa3StFFfp2tMwkLiRnv08ibVL1dyJeWnqzwuMCsFaGFpLcH9hUwM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxTVWeXW9d810BjALf1fGI80RT64_wdg4QQYyr-e3H2A&oe=6A5A19F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gw Lovers", "keywords": [], "long_description": "\"Gw Lovers\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Tagged is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns, flowing designs, or even abstract masterpieces\u2014all designed to evoke a sense of peace and serenity.", "short_description": "\"Gw Lovers\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UqsEPypXHYkON0ZVGoW-kEAdBCuO9g9hAdYS3xRbFSA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zenix", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1JmFG3qD3gRnkEgOuEu0yxT2Et_pD05hE-B9Jp5ohjR0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GA
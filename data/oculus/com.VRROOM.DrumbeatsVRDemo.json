_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNw7C5GaXiQQ7kNvwHswDhQ&_nc_oc=AdrVhtN3xX0-vbCu7tOb05G9vHmMqfjMWZPOrLMzVGXyb9P2j6PAM4fQB7pAP66Y4OE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGU_qqNP0GxeRp5O27mgmvbfxTrbBwnE7SGs3pfwYugQ&oe=6B01DBAF"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56QyADBP2XkQ7kNvwGsZYGs&_nc_oc=AdrkFYaGpnQ6JzvW8gn9cbswVl0RFO2-YE8fRVC37KR0kkkA5HCbGkVWe1hgfwf9XLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRad140KVWIqKmIJ6C7jkhcWK2m-RnUH9ycbQH1JK9hcQ&oe=6B01D6F3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo_J15iDNCQQ7kNvwFUlv89&_nc_oc=AdrMrdKndIGfiMw5PQGhcclQD1lDDfRmKtOLVv-_5kV-uteJoIEkOSjMIGI0Iq4ywdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1PdAx9S2Oti6Try_wg10S2A9pP4kBINc3sRFA7oMW6w&oe=6B01E0FA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAXFGcUck_sQ7kNvwGoSHUg&_nc_oc=AdowgAJhc22SDCYP_dx8avO3q7zXZNlvFrUAAZnm24nZW-m29QMSP-jQfUsRosL6soQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXpQX94fjZIgslgd_oh-ZGvkkKZMUeh0FsOCYAk5xNXg&oe=6B01B8C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5fHkWuGD7oQ7kNvwE9p5DG&_nc_oc=Adoj05YAVfNv8r1xjVC4KHp-7GNbFg2PT7gVBFIpEYwyaC18pm32S96YzWXwomALBww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMmfdMLDQs8F9v7RoNxqf6bJjRJ2wnPcXZyGnknZm77Q&oe=6B01BEDD"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "
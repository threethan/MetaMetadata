_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXa-HLlzzfEQ7kNvwFsmo8J&_nc_oc=Adox3gqqPlz7ntUq4F1eZhVw9nl4h638DZl8vNx7tnZpaDH9Y59f3_FfaiOoxmM4m3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVPbWhOXP6ji3jwD7Td_891bDBid0g9COy97zquto2xg&oe=6B0C67AF"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DyFWLJiUswQ7kNvwGfZmrK&_nc_oc=AdokxuxMHLg4h5TlCKf9-xHpN3Zwl2uIDQkMkh5aQNLowiu5z7P5rUDeI6a9ykwzcoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRgu3J5vy3aAAU3OssHdGPhXy16mGTYHURjWaASSwKlw&oe=6B0C62F3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5nHMQ9mvWQQ7kNvwG3S8V6&_nc_oc=AdoVTnXoPlTWvC2V0xtyuiug-Xi6Tgy4iELv_YA2PvBlqgyxlaYkiZKsvzbwEyNeerg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8ONiMDd-avBDix_pjvkAonaX7NgS8YCQVVl2YYD11mw&oe=6B0C6CFA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuagNgL9OQkQ7kNvwEKvmPN&_nc_oc=AdotVp6oTw-_zCZVXmfG9cfJGCBTMCNTeDWRN0M3rBo82RUz8Df47GwLA_oBBKaPTgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSolLJhq9swJ_NImpj64Z7DgkHiQkhLPVTUvInN8H400Q&oe=6B0C7D08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3s8TPe4dCwQ7kNvwGR41XE&_nc_oc=AdosVtazFxTif8rvNdZOIJzyWhKLOSjidUWx7_zzj6j7W0x9m5Qy2NWHAWOv9C78NsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSskfn7F9EeatTifI4tU0KcdNEFN11GwN3g6WweiJRnOw&oe=6B0C831D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "
=cGdUCVczxU0Q7kNvwHXn5RZ&_nc_oc=AdlIEJcF32rHn8xMLkOu4Acgap4-bQ-1VfwykEPMqU97iLFNIP5Ud7lRDicJJ2juivk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfubIzuCi5lO2fANv6cF7L-KoCq9GMAROs03UdKOmNzWaA&oe=69A2EFB3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCXa8458x8EQ7kNvwFCNoBg&_nc_oc=AdkE6e4GLxTdphPalBt5Km15AbevsH6ETqkI4FrCMQXKbg5dq_4qMh_D2ReorgjBI0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftrbs9ymY4JGGHgH6_pPHx9M_vqddOam4Ok9p8SEUIlfw&oe=69A2F9BA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39onUreD9vEQ7kNvwGII7g2&_nc_oc=AdmIKlJFmrnpPhQDMqIQOSEBn0jV9ipHROud2oO3sl4hGzxrgg0AyO9Xmd_LcXozD10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP9qd5WvqILolnp5GyyEmFJwyZcXgz3G4gCn1u-VUA0A&oe=69A2D188"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb2T9uKgtdgQ7kNvwHMkfiB&_nc_oc=Adnr4nWT2mbfg2Y7T51eOvovTArfgAIHjAQHlVGiIMpTdJe-MJf5xAqaYmR-c7pBbr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu2MoGDuamI6dWfyy4VcgqHl7HalYgzxahd_CCl9liY_Q&oe=69A2D79D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
dn.com&_nc_ss=7f20f&oh=00_Af9oiH9AIG0L4sGzVgLUayXmF9eoqwkiNZjAnVapEvRspA&oe=6A451CEF"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FABCE-EjOzMQ7kNvwFtSbII&_nc_oc=AdphId-eMW5iQLiv4-a8mpJ9VTUmRzNrjxTd4NPOx-YQ97f3ogK3XftVZ2h1igOyFhE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F0TRWsVrjLN5K3SEpZeK_CoXXlK0S48aC7AYAZIEzuA&oe=6A451833"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I71eX1iJiMkQ7kNvwHiAJUm&_nc_oc=Adqbe0A1TV4jStBzWo4M4fTFJrch46lx8L3zF001wBEhm5tdFzknrI6sp9l65OrcT7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZR9Uq0Syw4zjuJsiLTOYg9dPrSYsa9ZmwaFMlUqDG4g&oe=6A45223A"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcwpeHK5D6oQ7kNvwHnZcB7&_nc_oc=AdoaVucduAv1chTVR1d3_FWtpL4Si1vhbk6th_AfeNdo4_CLukGok0nAgaK1rodwkQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n5F-vVuFMe4R2Zl3Gse2poAla_1ydPzeAtIRfvbacsA&oe=6A453248"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2AVJaM9Mx0Q7kNvwHP2Ooi&_nc_oc=AdqN62hW7LEYvJb1zWT0-gHxPMwt-pZM--jx2RWuxmgSdA8yB4giUNq1wv66Qfwze20&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lusj4Es6P8Yaah33bd5tBYfNV_xQFI07JIFwRYAkDRw&oe=6A45385D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "159219297431
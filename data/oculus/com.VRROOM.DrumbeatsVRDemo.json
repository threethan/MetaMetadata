qUlLjo3PQ36le-FTD68paD7vvnRmZeusKPGI-DBCSg&oe=6AC4FE6F"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxj7DAYCC-wQ7kNvwHETqj-&_nc_oc=Adr0IX35qESesBpl91uSQTAO3cNL6nc_zAMJlOAswroCAwkbpcMlmASSE10E9kw0tkA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhtHrKP6z0wTbCkC0xaT7KysWNM8Clw3RoiT4r8Qts8g&oe=6AC4F9B3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVkFZ_s11f8Q7kNvwG8-6m5&_nc_oc=AdpnzMjsNOZPmdkuxyNb82hayJ5oSNEB46KFplwKothL2VzviotWLNEoUUseMXgU4kk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtLqx1YvyoANQzzpz9v7Y6V4fY2D2ewLr5-_zTcXp6pQ&oe=6AC503BA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2n6J_AugUMQ7kNvwHrYcxP&_nc_oc=AdqOIxSIfqlueMDiuH0AvjaCNXtHKDN9VuB4bAQdTnDbVw-5Ohd0HWGJWb7GICtRInI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxom18KxPWWHkHF1KBi3dOZgMxhKbuR3jFe85t4aeYJA&oe=6AC513C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sCqM0LujrgQ7kNvwGgCsns&_nc_oc=Adqa_co5J80iDwDV83_dm5Kw99MCamoIrUBCIxZF2o-FfsID7tMd8cnqDnWBUQw7_FY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ300UfeCpDfQBZxODVwM6y130uEFcHljNzbM1069Z5Q&oe=6AC519DD"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscriptio
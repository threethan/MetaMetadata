SSykQ4lOYFKt7uJfflyzjCa_YF4PSCpVFRgFySvU-A&oe=69F602EF"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfhCE_VJI_gQ7kNvwEnWlVv&_nc_oc=AdoAppX_xnc5e0IOPN0KtwsFtHfj8t26kyqSzZCLrPVmRjaTac-AxVt2ds8CST7TpoY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1k-6dzD1o9wIJiNMNulzUmsKMw8CmkEL8BqTo07EDgqg&oe=69F5FE33"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF59Z5z_wnMQ7kNvwHlJwxp&_nc_oc=AdpxnXBBRO3GnN-17Uexy5TH_Vrs8_qOkdyjORidOZ6lYYHws05K7PVyFM_Qs62_pvA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25kDJdxOm3m8EnOM9S4KCyx0GofKEajBE6uDjO-9fBlw&oe=69F6083A"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfEYKjrgCo8Q7kNvwFDdaVk&_nc_oc=AdqOXMqk3PARVZSLElsTLTTkJoP8zJNVCbI588lZwUUvODjtpafCU1EaSKZI5fg9Fw0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29HFPRnt6tohxuggrp4awqKglgyUUr2sCN0y5sPTgbrw&oe=69F61848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RZQa0PtvcwQ7kNvwGWlcgt&_nc_oc=AdqZntLqWQGAm0V43CIsB5n4jBjaE0_qpdhEJXmFlVHGAMLyrqKN4-_0T5DJ2d6QRv8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_S0L5Al5zc4ri_hlXPU8AY9gUC3160zkfZQ-IBel61A&oe=69F5E61D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscriptio
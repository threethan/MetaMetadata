dn.com&_nc_ss=7f20f&oh=00_AQHB-uDDjEAW5jwiWyuadr1QiGR0M6o3FO67XxUV-DCP_w&oe=6A95C0AF"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnLYVK252iAQ7kNvwG65JoE&_nc_oc=Adr13H8Uv-pia2tnXcjzcbuVVoyWKo8fnw8-f37lj8ZD-2_Z4YVBfR0Vmqr5VgAqVvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIkoDIHtb_DV9YDgBFLOqFoexwwQCfNDxY7fvzwOkKsQ&oe=6A95BBF3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFCQQo1FGyQQ7kNvwHqxR2A&_nc_oc=AdqWNy7AP30AH8A7NdB_4GIkCZkoouqua_-a4Xe96hLBcyxO2BCxeydbsEwGwYt6TeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK8G70YGSRGpsZs9JH7DnGKIhCcBtDg5b1akxWqsTrJQ&oe=6A95C5FA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPX3Sv6IpXwQ7kNvwHbj95L&_nc_oc=AdpQKSV-FdBcUA1jlqGMrDW_Bt-fnkFXwIaG3tGG_EczO_f3ZlEfHD5OuGRT0qYFSNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1LTwB5uR1Kmcpf7xP9i_XznNMHPrRsx3LzGzaa0XoIg&oe=6A95D608"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzwesEM9kuAQ7kNvwHHLieI&_nc_oc=AdqC9b6DMrDoxqGTtRvACIYpPodpZHyychZwIAKqTxtUfMfOw5xzOoMSAJdQ-muzE_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOvVIfI3o0GbNsFCERvLcz_v9X3sygHaNEtxJDJwhBBw&oe=6A95DC1D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "159219297431
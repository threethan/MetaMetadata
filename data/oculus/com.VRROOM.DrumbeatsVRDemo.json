_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNw7C5GaXiQQ7kNvwHEFdZo&_nc_oc=Adp0JTFGsTZcDhPBDTerxQIYf10Z29JybpD0oETvzFzWBI3qMIKF8dDMWShyNrDTBwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSynPEIqygvpS8LtHew9an6kYhq1ujNisxkr-iRA3egw&oe=6AFF006F"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl2dFNSX3NYQ7kNvwEAynNz&_nc_oc=AdqoUFAMfQrT1nfixYmhcxrGu0-SdxOcub8SwCbQdx_9LFeOQTh1DmBzPb4OGCW-PrQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe71AgTEuvRWr_lX72JUTmDogALpsgefycbHv30iEIKg&oe=6AFF33F3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo_J15iDNCQQ7kNvwGqtRBP&_nc_oc=Adr8FqLEUDIURNheE-jWPVmH2QNekqjFRImlv_VlA3896GEY8E_BfTsS22BVr70rOio&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEgQM0DFsnGp2VtWgJ35d3X9OKU6EzCLMAhJ_E4mIl1g&oe=6AFF05BA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdO2Y0frlkIQ7kNvwFejhcE&_nc_oc=Adpa6JvTD04tiNG7-HxQJ9Tr4HtMMWS_cmY_EZ_epNQPSHICTySoEBX1WBcnw7L_VUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe3tShekVR85vxr7K5qkxyjhmQR2FrcQxuDt-GY9lXcQ&oe=6AFF15C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5fHkWuGD7oQ7kNvwHi131q&_nc_oc=AdpbqQ7GCQIdJidE4ZiVkyxh5ZdfyZwke8GU_JiePwelE8smZy5GpW-I9-AQ0VfFTew&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnCch5H6XpdRXXe18Wnws2MGvwkt1OiaMbOOSOREKIlA&oe=6AFF1BDD"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24066215899641533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393286_709052141805010_9099635003315582_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td2hS71CVl4Q7kNvwEPwRZn&_nc_oc=Adp0D9vW1TcUXGR1SZgIuBB1gMUTLr8UTLNqaGWzKi4SHiYB4JzQui7lx2UpQOBSMp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYtJOWuVz7o5WTbrZzYej4TKWmQRFTHZleiCwD2AkuFQ&oe=6AFF1159"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DrumBeats VR - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1746558480, "lastRevision": {"nodes": [{"id": "24028687710061019", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24028687683394355", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "707421895168245"
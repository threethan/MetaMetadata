dn.com&_nc_ss=7f20f&oh=00_AQDJSp9niMP6U9S252BrhogukR6V1-hLbXqzt14fWs-j0A&oe=6A539D6F"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYGLVEmN2jgQ7kNvwFl4tV_&_nc_oc=AdrWykkcmlRU6_ppD2yDeEZ25nDGY_nH8U45KrahsrIscpYOgN59hnbPkq0Vh8dBDYM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcxfyB5r4MTAG-Fr-eCdJup5w7ahLfYCV2oOF6kkPF3g&oe=6A5398B3"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q8G5E5DoyEQ7kNvwGzhrG1&_nc_oc=AdpekmBf89lbrpklSHrp9zbwdK32zXWU1L-ipN1Z3MEr__Tig7i0vit2at_vMenuoPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZP5zI5IboEmHZLxuOeNIfRdN7VhD_pmJfxxh2rikpeQ&oe=6A53A2BA"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb12F3C4NgUQ7kNvwHgZyjz&_nc_oc=AdqvrWrMCk_JmhYnehws5my84kqUcXNCn5cpvkHzIdVP9DFbxkkSU4XIaTg8Cz17jOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABSV1wmapkQDY2RexdtNFbN7ZTbPwW7z5t_EmncD5e5w&oe=6A537A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ETIqDdFBEEQ7kNvwFWZl3C&_nc_oc=AdqBitNOjO6o5e8TUz8w0watCDzLDfdI2uQYh5UlzUEsDydR0gnJx70OoGGbHCpu1n4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUJQ-t0V6M3uGYnRWLNHGmHyht_tBwzTY08o7cH5Bw8A&oe=6A53809D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "MESHm", "support_website_url": null, "website_url": "https://www.drumbeatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "159219297431
_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoY2BXLmHhQQ7kNvwEwCMXL&_nc_oc=Adqzu2jWYE49dAkN13RAUHHApYziWPqfzJY4pvLGGKAM4uy2BMvVJkanqY2fL2mTVFI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkHpwvmSb2yDZeGJrUckkU1dGBoTOEheQTWoDHj06uYQ&oe=6B05D02F"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9z3NjUGyccQ7kNvwGBrJwl&_nc_oc=Adrqira1m1sOIVI3MM6RHIXBU3LK16z_uYlRqMiBiTS6QQ1zgbROCQ4QrolXqDiPs2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSrfR8uc1AXt3VaJZbgLMK0oj5GOq_qycmZlL_csAT3g&oe=6B05CB73"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox7QG8RgNOYQ7kNvwEER4u_&_nc_oc=AdpHxvJOKGFqI_4nFMoH-f9bJjFrsLyj8bwB3sPPNRoOaBS6q_zp7LigmFwP0V54YI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8O-Uc0cdm-YeLHYajeg-w1sF2e1SATM_gss6uqlGbPw&oe=6B05D57A"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dciw6F4dGa4Q7kNvwFjS_VC&_nc_oc=AdqvEOUr9brniP9QsY6uSXCfHXjBMGK7ilpBEb5TP9IZrwq7M6q-XNqSkecSAJrDRTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmAEMCoCO1h-LkmONrFamWSGWGrsLHBRFQV2yIkyuQHA&oe=6B05AD48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhdxSFw1x8gQ7kNvwG0TDUz&_nc_oc=AdpdUCclI4XItXf0LhImUumCrTMFHAjCdt-w_fbapFnAubFAuJVyvbel7YhZl1PbFAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtbluTSi3kZ-trWhbgIBlQxt5z_TAT5ExSSmwA9wZYJw&oe=6B05B35D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "
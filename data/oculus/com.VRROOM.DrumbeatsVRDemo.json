_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXa-HLlzzfEQ7kNvwFJG-Yf&_nc_oc=Ado93yZPrnM9_xm9TvW6wABODahNwkUHBIbOkEiMqoosVlNwi7ry19wmmD6wN3TLhUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSl9eozutcPQ3p-YJKeojs2S-1RhA20EFmqBdojYhIwWA&oe=6B0DB92F"}, {"file_name": "Screen03.png", "id": "1202534061376698", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825091_1202534064710031_1601505026581438344_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl1u04hTofUQ7kNvwHv860s&_nc_oc=Adqbns3uO5KAY5OtnTxmUkY0YR_KwAotYchnwSnA8wQ-A2TkUyWmAPtaJIykedTEoVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCKAplNtoSwQ3OoBL1YyJI8ybGdMNXQb_3Vxcn2tNQRw&oe=6B0DB473"}, {"file_name": "Screen04.png", "id": "619304174490460", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824609_619304177823793_8023419999786719382_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5nHMQ9mvWQQ7kNvwEPERHH&_nc_oc=AdqMY6QI4IU56t9YQ3n84jNVWaunOokxExAlDsy-uNs-Tldj2OG0MSRyROCpbGFi2oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0gMOYxm9tse30labcfLgdwV4igQPf3EZr5VOHyZoysQ&oe=6B0DBE7A"}, {"file_name": "38974904_351784806639758_2658031322900797500_n.png", "id": "469243712900370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818938_469243716233703_7303789553167808720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuagNgL9OQkQ7kNvwE48Gtf&_nc_oc=Adom9Vv9Ia8IvRTCN923P2yMqfQv_jwykOjIWCnmQ0_jO8P4lfYzbcL_S5qZhDuEHm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfzvugciYCXjuUxLtNaYqZHmvUZNDEN0mMU0YkBtHlMA&oe=6B0DCE88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031311_9578478015544343_4355011210598936222_n.png", "id": "696121572810087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821920_696121576143420_6718355276936401442_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3s8TPe4dCwQ7kNvwFtckTT&_nc_oc=AdqiLorqpSCQyxyp9WvU4oH-hLoCf62nI_uIBox5uGgrpa0KqKRyZVxYQaSJ-vTovPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTaEzBEFkvONufoz7lfVwaudwTXehKzvjIiOzyiPpWoA&oe=6B0D9C5D"}, "display_name": "DrumBeats VR - Demo", "keywords": ["Drum", "Beats", "Music", "Rhythm"], "long_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! \n\nYour driving rhythm makes you the heartbeat of every song you play. With a setlist of 21 tracks and more on the way, you can jam along to your favorite tunes and feel like a true member of the band.\n\nPlay in **epic** scenes that will transport you to otherworldly locations.\nFrom the comfort of your own home, you can play in a Studio, descend into Hell, explore the depths of the ocean floor, brave the frozen tundra of Antarctica, and even drum on the moon!\n\n\n# Scenes:\n- Haunted Asylum\n- Drum Studio\n- Antarctica\n- Hell\n- Bottom of the Ocean\n- The Moon\n- Synthwave\n\n# Drum kits:\n- Rock Kit (it's setup is fully customizable)\n- Lefty Rock Kit  (it's setup is fully customizable)\n- Metallica (sound and setup)\n- The Rolling Stones (sound and setup)\n\n\n# Game Modes:\n**Arcade**\n\nPlay along with our custom made songs\n\n\n**Free play**\n\nPlay on the drum kits and environments listed above however you like\n\n**Custom**\n\nYou can import custom songs into the game so you can expand the setlist with your own songs.", "short_description": "DrumBeats VR is a drumming music game for VR. Play on iconic drumkits and play in epic scenes! With your driving rhythm you become the backbone of every song you play. With a setlist of 21 songs and more on the way, you can play along to your favorite tunes and feel like you're part of the band.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drumbeatsvr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "
45000204013_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yh8hHf97HeAQ7kNvwFTEtFL&_nc_oc=AdpWcyLzG83aw4MUWLrzEyP_b_w8Y7ldi1LGAPc-r0ml8D3swTZaxRR75oIIfrA4DFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiJRbOQXZI90lGf3gUt7dVn8N4_7Omm05SH_MD4i-yig&oe=6AFDDE0B"}, {"file_name": "screenshot_5.png", "id": "1793963848555565", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/825629712_1793963851888898_2407815251024994471_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caR1QeLVNbYQ7kNvwHhNhUV&_nc_oc=Adp5gUR6s2Ql-PleKgl2yoO7reup3gR1d1FKCeE0KvesnX2bkbbPJ9LhukrnyEc9hMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdXIx_v0wTzjufK2PEqTZUBCJDTpQb539wKeHSnxOtAA&oe=6AFDCB0E"}, {"file_name": "screenshot_4.png", "id": "1453650943299174", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1453650946632507_7233808385166386490_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcjr0L1vVzMQ7kNvwGtdnor&_nc_oc=Adp9jQogqqGlWQFRspMJ6eceKjb1IQ-3XurkVanRL4IACP_IZEh2Hbv8DVHakRwqdqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN4GUd2e0YtNX9QKTCXnetoWpYYzcAKBw2nlrhdYpVyQ&oe=6AFDC06F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3683794215108984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_3683794218442317_2477200122948237706_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_WU0rjqo9UQ7kNvwHpJLj9&_nc_oc=Adoradt28ckYEOboIl5QAzeTD35mIbcdQf7HZODi5ZlFp60bPiPt67bhwvj-YvC-lzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShM4JpPH0wxKimPm9oiAhM9lEtl0ZWl20PFQoltAtYwA&oe=6AFDC5C1"}, "display_name": "Pumpkin Carving", "keywords": ["pumpkin", "halloween", "carving", "lantern", "craft"], "long_description": "A night in the pumpkin patch, a workbench, and a pumpkin that cuts like the real thing.\n\nCARVE ANYTHING\nEvery pumpkin is a real hollow shell. Saw, slice or stab through the skin wherever you like - close a shape and the piece pops out in your hand, with the flesh showing in the cut. Eyes, teeth, cats, bats, your name, whatever you can draw.\n\nTHE WHOLE RITUAL\nSaw a circle round the stem and lift the lid off (seeds and all). Scoop the stringy guts into the bowl. Peel the skin with the paring knife for a glowing etched design. Drop the tealight inside, set the lid back on, and ring the bell to hand it in.\n\nDESIGN YOUR OWN\nPick one of eight stencils on the board - classic, spooky, happy, angry, surprised, starry, cat and bat - and follow the dashed guide lines, or grab the marker and draw your own design straight onto the pumpkin, then carve along the ink.\n\nSIX PUMPKINS, ONE PORCH\nClassic, Tall, Ghost, Cinderella, Goblin and a little Mini. Earn stars for a clean match, a clean inside and a lit candle. Stars unlock new varieties, new stencils and the dagger. Every jack-o'-lantern you finish floats over to the porch rail and glows there for good.\n\nA COSY HALLOWEEN NIGHT\nString lights, a lantern on the bench, hay bales, a scarecrow, dead trees against a full moon, crickets, an owl now and then, and a pumpkin patch stretching out to a lit farmhouse.", "short_description": "Carve real jack-o'-lanterns on a moonlit porch. Saw the lid, scoop the guts, cut any shape and watch the piece pop out, draw your own design with the marker, drop a candle in and ring the bell. Six pumpkin varieties, eight stencils, a porch that fills with every pumpkin you finish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/pumpkincarving/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/pumpkincarving/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925
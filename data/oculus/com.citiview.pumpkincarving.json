59077785_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0catZqPQbYQ7kNvwFgLZ6Z&_nc_oc=AdqZNq3EbqLMgINETPkSdWpLCJEs54zUtlzdAsBKrPdqs88HI_yxiom13G4ITGaNQlE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaIT1IdGCPa4GUMBl5U1xWMoSgV8M1viVzvtWzpMFNOw&oe=6AF47F4D"}, {"file_name": "screenshot_2.png", "id": "1744956046784080", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1744956050117413_6612785747611353606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6s94rhfDLoQ7kNvwGYs8NF&_nc_oc=AdrFKOThqeb91zi8WI36igMH_m5OgiPf6i955OD-kIv9xa8oQOUa3kqcLa263feayiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu22IGxA73VTPPE_wsRlqUv9ZR_wuepvH3Kk9x_iluKw&oe=6AF4985D"}, {"file_name": "screenshot_3.png", "id": "1333341548726259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_1333341552059592_3860225745000204013_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZhLUsNJGVcQ7kNvwHgtbre&_nc_oc=Ado60iUxapi5K7x1VEAvKv5ANJkG8q-x9hU3ar_ODOR_na3DqhJqSTlwpcDIdoyOIDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReQs6V6PvdGgTLNdA59AbjMhP48ysUpHFo_P1TGtiBSg&oe=6AF4A38B"}, {"file_name": "screenshot_5.png", "id": "1793963848555565", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/825629712_1793963851888898_2407815251024994471_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpdZHj6TRdMQ7kNvwE0VRk0&_nc_oc=Ado79DEzJ6n-DC5HklhMW32GCN0jZjmOpD54zaBiD-8qYuFyG13WCWOl9WVA_iz5RHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYiANTRnXhy6l5OeZEPsYD-UvhLjldw93tPyLvpsor_A&oe=6AF4908E"}, {"file_name": "screenshot_4.png", "id": "1453650943299174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_1453650946632507_7233808385166386490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4UIj4CbyPAQ7kNvwGh55Oj&_nc_oc=AdpwvM-k4MyTO2obzNhXUvrUTiL4-ral2SOaSC-koGLivIwJfzks6ZFOKYGZeBRsfto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlWZFdiiu5gCovpvsMyZ06SBw0TQFtLj1JyJqdP4fmag&oe=6AF485EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3683794215108984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_3683794218442317_2477200122948237706_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvBlfQrSIHUQ7kNvwGWLErp&_nc_oc=Adp0vuhrzNlD9dETL02NBKKfTEFCZTsUl2maJUFVpchg5urwDbYA4vqk3gJa7hdQKOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5EScNyLS6w8xO4045dEgQxXZAGmjz2XXew_mXhIov4A&oe=6AF48B41"}, "display_name": "Pumpkin Carving", "keywords": ["pumpkin", "halloween", "carving", "lantern", "craft"], "long_description": "A night in the pumpkin patch, a workbench, and a pumpkin that cuts like the real thing.\n\nCARVE ANYTHING\nEvery pumpkin is a real hollow shell. Saw, slice or stab through the skin wherever you like - close a shape and the piece pops out in your hand, with the flesh showing in the cut. Eyes, teeth, cats, bats, your name, whatever you can draw.\n\nTHE WHOLE RITUAL\nSaw a circle round the stem and lift the lid off (seeds and all). Scoop the stringy guts into the bowl. Peel the skin with the paring knife for a glowing etched design. Drop the tealight inside, set the lid back on, and ring the bell to hand it in.\n\nDESIGN YOUR OWN\nPick one of eight stencils on the board - classic, spooky, happy, angry, surprised, starry, cat and bat - and follow the dashed guide lines, or grab the marker and draw your own design straight onto the pumpkin, then carve along the ink.\n\nSIX PUMPKINS, ONE PORCH\nClassic, Tall, Ghost, Cinderella, Goblin and a little Mini. Earn stars for a clean match, a clean inside and a lit candle. Stars unlock new varieties, new stencils and the dagger. Every jack-o'-lantern you finish floats over to the porch rail and glows there for good.\n\nA COSY HALLOWEEN NIGHT\nString lights, a lantern on the bench, hay bales, a scarecrow, dead trees against a full moon, crickets, an owl now and then, and a pumpkin patch stretching out to a lit farmhouse.", "short_description": "Carve real jack-o'-lanterns on a moonlit porch. Saw the lid, scoop the guts, cut any shape and watch the piece pop out, draw your own design with the marker, drop a candle in and ring the bell. Six pumpkin varieties, eight stencils, a porch that fills with every pumpkin you finish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/pumpkincarving/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/pumpkincarving/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1367304843129045"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1085175844406213"}]}, "baseline_offer": {"id": "1085175844406213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791823320, "status": "PUBLISHED", "id": "1085175844406213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1367359983123531", "version": "1.0.0"}, "id": "2444787212716537", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_
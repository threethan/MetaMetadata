48\n\nBuild defenses to protect your home from invading monsters. Cute, yet a challenging mixed reality tower defense game with 8 levels, minigames, and the final boss.\n\nFeatures: \n- Full hand tracking support\n- 90 hz support\n- Passthrough mode", "short_description": "Mixed reality tabletop tower defense game utilizing a passthrough system and hand tracking. \nBuild defenses to protect your home from invading monsters. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://toymonsters.mdfx.cz/privacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "YetUnknown Games", "support_website_url": null, "website_url": "https://beacons.ai/yetunknown", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472109455057627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031505_793886958579565_3901689692315295136_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpE9bhP2FN0Q7kNvwGlBS6M&_nc_oc=AdkiLuyQZV3i1XTqOgfVpE2c-ijbe_maI9yKmWo04kzZblzvIpuEIbJQCXv96z72egY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6XETwtT2s6olOqsSKm3Y-vVNfvyRxgiAsScLfjqmd7Q&oe=69AAE593"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Toy Monsters DEMO", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1
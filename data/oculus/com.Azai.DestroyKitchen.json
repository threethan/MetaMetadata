}, {"file_name": "6 (1).png", "id": "911436828203527", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491828008_911436831536860_44645538212638042_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztDrAQhi8jkQ7kNvwHOE6mq&_nc_oc=AdqkYY8TGX0WBztWrNSMXSAqgfaEL5f599fA_BCdtnwRlVFc2SrT06ev2OSs1DsYHkQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQjPxTYKM3C-mb6kTCDjx0fWByPmSzysevDE4zQhHcyw&oe=6AAE7EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5224530263788952149 (1).png", "id": "895685799993635", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821568_895685803326968_7205574574759638173_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zJ1w-7_vogQ7kNvwEvCHGY&_nc_oc=Ado663u13ygcQ8IIUd-R7kOl4VT4AscOrxdLaSrSruYkk2baqWEbEJXfDM7bics0lyo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK2ZeyybVbX2bWjzp9R3h4qfemnEBiLDskOokabAS6xQ&oe=6AAE99FF"}, "display_name": "Destroy Kitchen", "keywords": ["Destruction", "Sandbox", "Stress", "StressRelief", "Kitchen"], "long_description": "Why Destroy Kitchen?\nIn real life, a broken plate is a tragedy. In VR, it\u2019s a high score. Whether you want to perform a slow-motion kitchen takedown or a high-speed wrecking-ball routine, Destroy Kitchen gives you the tools to unleash your inner chaos.\nNo Rules. No Recipes. No Regrets.\nTags: VR, Destruction, Physics, Sandbox, Funny, Stress Relief, First-Person.\nSatisfying Hyper-Physics: Experience the \"crunch\" of every plate. Our advanced physics engine ensures that glass shatters how you\u2019d expect.", "short_description": "The only VR game where the goal isn't to make dinner\u2014it's to destroy the kitchen. Unleash your inner chaos, defy gravity, and break everything in sight. Your kitchen, your rules, zero consequences."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/02/11/privacy-policy-of-destroy-kitchen/", "developer_terms_of_service_u
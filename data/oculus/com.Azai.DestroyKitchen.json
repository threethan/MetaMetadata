dn.com/v/t64.5771-25/491828008_911436831536860_44645538212638042_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWkCFArvEKYQ7kNvwHeKdvO&_nc_oc=AdokVs8ufCaELdwmYsZUYKCTd5Z_o8wq1DOlCzf2A4Ife7tOPd2wBYvI4avFMvemrSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEY5LvGRMU5oPreGhuxWwOPGa5aEcd8ev09INnoO731g&oe=6B0DA2E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5224530263788952149 (1).png", "id": "895685799993635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821568_895685803326968_7205574574759638173_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjeX5ZAxsGUQ7kNvwHJxINf&_nc_oc=Adr2Oj2f4amQTe5Vnv6KHQRCgqC3I0t4eo-28ZKRrF-go3Gi11tyrZelLC07IufralY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSPphE6WR65zBQKyHQjyHGPibfB7JG6fIPjrfMnUV4L1g&oe=6B0DBE3F"}, "display_name": "Destroy Kitchen", "keywords": ["Destruction", "Sandbox", "Stress", "StressRelief", "Kitchen"], "long_description": "Why Destroy Kitchen?\nIn real life, a broken plate is a tragedy. In VR, it\u2019s a high score. Whether you want to perform a slow-motion kitchen takedown or a high-speed wrecking-ball routine, Destroy Kitchen gives you the tools to unleash your inner chaos.\nNo Rules. No Recipes. No Regrets.\nTags: VR, Destruction, Physics, Sandbox, Funny, Stress Relief, First-Person.\nSatisfying Hyper-Physics: Experience the \"crunch\" of every plate. Our advanced physics engine ensures that glass shatters how you\u2019d expect.", "short_description": "The only VR game where the goal isn't to make dinner\u2014it's to destroy the kitchen. Unleash your inner chaos, defy gravity, and break everything in sight. Your kitchen, your rules, zero consequences."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/02/11/privacy-policy-of-destroy-kitchen/", "developer_terms_of_service_url": null, "publisher_name": "Azai Gaming"
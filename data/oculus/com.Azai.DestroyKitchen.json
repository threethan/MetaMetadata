_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If3W2cnc2m8Q7kNvwGZe7eS&_nc_oc=AdpjlMFZlctTi_3Da6eqykjviwfJ6_lxrOdkSc0BHoIsnIv5IJrEDqocGKaYAeXDKVg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlHUaLP-eiwtFUcpLEVTSMgeUO04AeznkrR8ylpaG7Fg&oe=6AFB493F"}, "display_name": "Destroy Kitchen", "keywords": ["Destruction", "Sandbox", "Stress", "StressRelief", "Kitchen"], "long_description": "Why Destroy Kitchen?\nIn real life, a broken plate is a tragedy. In VR, it\u2019s a high score. Whether you want to perform a slow-motion kitchen takedown or a high-speed wrecking-ball routine, Destroy Kitchen gives you the tools to unleash your inner chaos.\nNo Rules. No Recipes. No Regrets.\nTags: VR, Destruction, Physics, Sandbox, Funny, Stress Relief, First-Person.\nSatisfying Hyper-Physics: Experience the \"crunch\" of every plate. Our advanced physics engine ensures that glass shatters how you\u2019d expect.", "short_description": "The only VR game where the goal isn't to make dinner\u2014it's to destroy the kitchen. Unleash your inner chaos, defy gravity, and break everything in sight. Your kitchen, your rules, zero consequences."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/02/11/privacy-policy-of-destroy-kitchen/", "developer_terms_of_service_url": null, "publisher_name": "Azai Gaming", "support_website_url": "https://purposeworlds.wordpress.com/external-support-link-of-destroy-kitchen/", "website_url": "https://purposeworlds.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_g
6 (1).png", "id": "911436828203527", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491828008_911436831536860_44645538212638042_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX8RMtQmG84Q7kNvwHHBRyY&_nc_oc=AdqFnchAMZD4BNDxncyRJTzhAW-bmFiqGBCwmv3tePhALDYCMMb7gow-Y7nIOfFKavU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0l7sa4WAAWCelhf7K8HUArptjDLtlcvB3BpWFZnKU2A&oe=6AF9DC62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5224530263788952149 (1).png", "id": "895685799993635", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821568_895685803326968_7205574574759638173_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=If3W2cnc2m8Q7kNvwHOaioU&_nc_oc=AdrQZvQx6zRt18SPCWvdBxRR6KLNRMuxV60jxo2CPi-3fmiAwDlbqIp_gS9iULOGF0o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpxI6DjLRPexSctfl1Y_OhYbCM13iT9Lg4pBAEkPdquA&oe=6AF9BF7F"}, "display_name": "Destroy Kitchen", "keywords": ["Destruction", "Sandbox", "Stress", "StressRelief", "Kitchen"], "long_description": "Why Destroy Kitchen?\nIn real life, a broken plate is a tragedy. In VR, it\u2019s a high score. Whether you want to perform a slow-motion kitchen takedown or a high-speed wrecking-ball routine, Destroy Kitchen gives you the tools to unleash your inner chaos.\nNo Rules. No Recipes. No Regrets.\nTags: VR, Destruction, Physics, Sandbox, Funny, Stress Relief, First-Person.\nSatisfying Hyper-Physics: Experience the \"crunch\" of every plate. Our advanced physics engine ensures that glass shatters how you\u2019d expect.", "short_description": "The only VR game where the goal isn't to make dinner\u2014it's to destroy the kitchen. Unleash your inner chaos, defy gravity, and break everything in sight. Your kitchen, your rules, zero consequences."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/02/11/privacy-policy-of-destroy-kitchen/", "developer_terms_of_service_url": null, "publis
f-gxgvntVDULUfaCssHXAM05rblpGcG5wWuQVThQ0JotQ&oe=6A3E9C63"}, {"file_name": "3 (1).png", "id": "1739469377437250", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/585720338_1739469380770583_7332829512158832052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBTv4aIJxw4Q7kNvwHzIvay&_nc_oc=AdpCehHcdl1fpr0jB4KsReXPwsG0paw-OmjAb8ZS_ZWRhKxWZ5SbTSey4jl4iouqPgE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lSwXu-hE13JYnvGXdTYDVCR510Xz7q4vAhxaKDCkYXw&oe=6A3EA3C0"}, {"file_name": "4 (1).png", "id": "2056762534885696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_2056762538219029_5791409377515486886_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffsUOQm6YHMQ7kNvwGXhgC7&_nc_oc=Adq-wyivVAXwZDTS9RvYDcOdUYXrOFmA0iEUmckIXFgVlTgx8iaihiOQzY5hrFoCMag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xo5mtwSJU6NvQwKd-hH4xHwQUfo70YRVcF77QJugSbg&oe=6A3E9FF5"}, {"file_name": "6 (1).png", "id": "911436828203527", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828008_911436831536860_44645538212638042_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tk4FHUWEeikQ7kNvwFyV8s-&_nc_oc=AdqfH2exha7T42zaOSykARHc-K6tvwcd_nerx307tfyzZPyhrU-84bD_LfOPj6qdaLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XAYtmq3uC76w65qdC5rWI7bOFEV8c4PtEZ6FeAZQ0_w&oe=6A3EA762"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5224530263788952149 (1).png", "id": "895685799993635", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821568_895685803326968_7205574574759638173_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRW6hVGM6i4Q7kNvwEfmp4J&_nc_oc=Adrbun8_P-mmzPNHYByV6iBV-kpCmz5yy0QIn1fakiuHmQ-aoA7EKuY_YjxbWVTKheI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y4UyE6458nbzkXa3FUEPOVNkUYJPXso4cwem7yrvlWQ&oe=6A3E8A7F"}, "display_name": "Destroy Kitchen", "keywords": ["Destruction", "Sandbox", "Stress", "StressRelief", "Kitchen"], "long_description": "Why Destroy Kitchen?\nIn real life, a broken plate is a tragedy. In VR, it\u2019s a high score. Whether you want to perform a slow-motion kitchen takedown or a high-speed wrecking-ball routine, Destroy Kitchen gives you the tools to unleash your inner chaos.\nNo Rules. No Recipes. No Regrets.\nTags: VR, Destruction, Physics, Sandbox, Funny, Stress Relief, First-Person.\nSatisfying Hyper-Physics: Experience the \"crunch\" of every plate. Our advanced physics engine ensures that glass shatters how you\u2019d expect.", "short_description": "The only VR game where the goal isn't to make dinner\u2014it's to destroy the kitchen. Unleash your inner chaos, defy gravity, and break everything in sight. Your kitchen, your rules, zero consequences."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/02/11/privacy-policy-of-destroy-kitchen/", "developer_terms_of_service_url": null, "publisher_name": "Azai Gaming", "support_website_url": "https://purposeworlds.wordpress.com/external-support-link-of-destroy-kitchen/", "website_url": "https://purposeworlds.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33706728885642480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823279_2419189408
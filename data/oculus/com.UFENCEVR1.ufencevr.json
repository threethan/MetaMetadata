ent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr4wwL-fPPFNXnBq4L3AaSvNSQ6HfFIHG-WmWsgRN_yQ&oe=6B05C15B"}, {"file_name": "Spider 1.png", "id": "381573091706891", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75245821_381573095040224_6934361407784081417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rm50OsNdEDAQ7kNvwFHRCEi&_nc_oc=AdpaYA3YPB1d13LJvbI4TTKo8KdEWQ-HTjjslV-AtU_inxFX_wfbH2BUASckqmOxxxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLnwnCUUJ8_wcmlc3svBlb4H3MI6ZLVmbH0pEP3gpEBg&oe=6B05BE08"}, {"file_name": "Dummy 2560 1440 2.png", "id": "1988704778723220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1988704782056553_4250809995388362075_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRKQ2BaVo2UQ7kNvwEGQSa3&_nc_oc=AdqdCQZwyJikXX7zTG6Xcmmti8XL_O1f0btk-jm2OESU4pBINjxGScM7JEP3Z7y9_gY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi2Tk-lkAhb_4U-LWawPggSV8LLG0BbyiT_siR7GuwRQ&oe=6B05A186"}, {"file_name": "Lesson 123  3.png", "id": "1771149487189689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821674_1771149490523022_4905220180915685748_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEEZ8GbQfT8Q7kNvwGNeBxM&_nc_oc=AdqT7h-IENbZvUh-S9YYJ2aOwxGflyWA6_tzScPXl6lA5ZAhL-y0WrTJzzFO2Wu1DLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy8-dXOHOHYc8FLWli1eBNAVNQ7HofAbRcO2R30yAaGg&oe=6B05CB0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 1.png", "id": "3735712979906797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031384_3735712983240130_4160159961143953837_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0va3ybsGvsQ7kNvwHKFD3J&_nc_oc=AdoQD2UByGJ6-BaeWEWHFGJa-ICcvbTDQ5TyBmokFRdfg_fSOXgttXFBwX9Fy0Q6yDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0lJdWJ2oBQniaLuvTS8GDWyeHvjf5DQjz4GtEgtuHGQ&oe=6B05BB4D"}, "display_name": "Ufence", "keywords": [], "long_description": "\nUFence is a mixed-reality fencing game designed for players of all ages and experience levels, using a primarily passthrough environment to safely recreate the accuracy, timing, and technique of real sword fencing in your own space.\n\nTrain and compete through a variety of fencing challenges, lessons, and AI-driven matches that focus on authentic fencing fundamentals such as distance, timing, cadence, blade control, and footwork. Realistic sword physics and responsive feedback help players develop precision and consistency with every action.\n\nThe experience includes multiple fencing games, each offering three progressive difficulty levels to test and improve your skills. For more advanced training, a dedicated fencing dummy allows experienced fencers to practice freely, refine techniques, and create their own training routines.\n\nAn in-game AI coach provides structured lessons that introduce core fencing concepts step by step, making UFence suitable for beginners while still offering depth for experienced fencers. Players can train casually for fun or use the experience regularly to support real-world fencing practice.\n\nAll game modes are fully playable in a wheelchair, and the passthrough design allows players to remain aware of their real-world surroundings at all times. Only a small clear area is required, making it easy to enjoy fencing safely at home.\n\nWhether you are new to fencing or looking to sharpen existing skills, UFence offers an engaging and accessible wa", "short_description": "Virtual realty Passthrough  Sword  Fencing training and adventure game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ufencevr.com/general-5", "developer_terms_of_service_url": null, "publisher_name": "Hugo Veryzer", "support_website_url": null, "website_url": "https://www.ufencevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_
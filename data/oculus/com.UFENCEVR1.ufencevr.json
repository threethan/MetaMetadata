.com/v/t64.5771-25/75245821_381573095040224_6934361407784081417_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCfVK1Q6bgEQ7kNvwFQgnMd&_nc_oc=Adoz2kNBKNzQ6NhNn5f3YvYyJA9HQMaLBeWS5nPex0aUKJp8MUX2hH6zF0a78CoWGFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpN_1aab2P2TpQF9r0F1u1oiwazEZDEgkjKFdzFVBdSg&oe=6AFDD508"}, {"file_name": "Dummy 2560 1440 2.png", "id": "1988704778723220", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1988704782056553_4250809995388362075_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX-MLlWUwFoQ7kNvwGmnOHx&_nc_oc=AdrmS22VStrM3VZTbuBjwu7zndsBFs9b24GDpoUwjYcF_gTGLQd2g7d3zKKpkPKKCv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1jsxbb_OzkX5iefNOnGCCM2m9VvyziDO-LlCeXs8kYw&oe=6AFDB886"}, {"file_name": "Lesson 123  3.png", "id": "1771149487189689", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821674_1771149490523022_4905220180915685748_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ecftOgXdIYQ7kNvwGiAQmC&_nc_oc=AdpVY4o4pZkcFYG2lAAYmqIgWGHXbXoix2Nzexd6_duOvcMsNHam3Ua7AXcyn3fWVrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMvZXcR0FmzZ7t1DpG8MCB8ddRW8QOOm0NjrwWU0ereA&oe=6AFDE20B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 1.png", "id": "3735712979906797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031384_3735712983240130_4160159961143953837_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufxdwggXVqYQ7kNvwECNIvR&_nc_oc=AdpzWUXT5CowuNYdOwsVKhCpuOagYmrxVv9L-lprjqACeKErdRCT4Dmgaiv0-yuqxwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbbdEHUThDMiXlku2vK8sO-qChSFQ3W5Z_f7udcCkJ-Q&oe=6AFDD24D"}, "display_name": "Ufence", "keywords": [], "long_description": "\nUFence is a mixed-reality fencing game designed for players of all ages and experience levels, using a primarily passthrough environment to safely recreate the accuracy, timing, and technique of real sword fencing in your own space.\n\nTrain and compete through a variety of fencing challenges, lessons, and AI-driven matches that focus on authentic fencing fundamentals such as distance, timing, cadence, blade control, and footwork. Realistic sword physics and responsive feedback help players develop precision and consistency with every action.\n\nThe experience includes multiple fencing games, each offering three progressive difficulty levels to test and improve your skills. For more advanced training, a dedicated fencing dummy allows experienced fencers to practice freely, refine techniques, and create their own training routines.\n\nAn in-game AI coach provides structured lessons that introduce core fencing concepts step by step, making UFence suitable for beginners while still offering depth for experienced fencers. Players can train casually for fun or use the experience regularly to support real-world fencing practice.\n\nAll game modes are fully playable in a wheelchair, and the passthrough design allows players to remain aware of their real-world surroundings at all times. Only a small clear area is required, making it easy to enjoy fencing safely at home.\n\nWhether you are new to fencing or looking to sharpen existing skills, UFence offers an engaging and accessible wa", "short_description": "Virtual realty Passthrough  Sword  Fencing training and adventure game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ufencevr.com/general-5", "developer_terms_of_service_url": null, "publisher_name": "Hugo Veryzer", "support_website_url": null, "website_url": "https://www.ufencevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQU
.com/v/t64.5771-25/75245821_381573095040224_6934361407784081417_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT40uhriZnwQ7kNvwHl0XVc&_nc_oc=AdofoFmYHGlCzk9CDVGAMEJb7G1GihuOShgfkBEvP3dwwJN_oOAdNTbKVXSP8xZhSfM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dv8Gh4GIrFdatbGjcQpYhQeCLNA7P17raQ9zjBYrTHA&oe=6A3D5A08"}, {"file_name": "Dummy 2560 1440 2.png", "id": "1988704778723220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_1988704782056553_4250809995388362075_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rcduqAmaCkQ7kNvwFB9f4b&_nc_oc=AdrOKeEUyxPC0EPdTuE_hr8XcUpGzzZmQzVnV6GqF-84OZG6W_pXqI2JlODI5PICF_U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PBtxiHC5Uni9CRDFtcsptdp-PUOVhGgCojj-eCMSb5Q&oe=6A3D3D86"}, {"file_name": "Lesson 123  3.png", "id": "1771149487189689", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821674_1771149490523022_4905220180915685748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEX21i0oL_4Q7kNvwGFj7zg&_nc_oc=AdqDLQoCXklPcuMriltbGZuUvo65vy83f3Q-24um3kb3n1KSxFeIO1nFugJlNY_gLkg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BsvrcyLt9GoJ5xxVDdKzhhiqTRFCrcgXoilPGM9JLIg&oe=6A3D2ECB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "logo 1.png", "id": "3735712979906797", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031384_3735712983240130_4160159961143953837_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wivYpHy8MLQQ7kNvwHC6Y2E&_nc_oc=AdoMwdpeWaOyBQOFLlvlNjRdB3zMiBx7G866NsEvU6BhuinTo1kPtsu3V38L_9zw6fc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aBtXPyVXw-zVTrs2xJsmSQV78BwX9CGip5t3jR-BZUA&oe=6A3D574D"}, "display_name": "Ufence", "keywords": [], "long_description": "\nUFence is a mixed-reality fencing game designed for players of all ages and experience levels, using a primarily passthrough environment to safely recreate the accuracy, timing, and technique of real sword fencing in your own space.\n\nTrain and compete through a variety of fencing challenges, lessons, and AI-driven matches that focus on authentic fencing fundamentals such as distance, timing, cadence, blade control, and footwork. Realistic sword physics and responsive feedback help players develop precision and consistency with every action.\n\nThe experience includes multiple fencing games, each offering three progressive difficulty levels to test and improve your skills. For more advanced training, a dedicated fencing dummy allows experienced fencers to practice freely, refine techniques, and create their own training routines.\n\nAn in-game AI coach provides structured lessons that introduce core fencing concepts step by step, making UFence suitable for beginners while still offering depth for experienced fencers. Players can train casually for fun or use the experience regularly to support real-world fencing practice.\n\nAll game modes are fully playable in a wheelchair, and the passthrough design allows players to remain aware of their real-world surroundings at all times. Only a small clear area is required, making it easy to enjoy fencing safely at home.\n\nWhether you are new to fencing or looking to sharpen existing skills, UFence offers an engaging and accessible wa", "short_description": "Virtual realty Passthrough  Sword  Fencing training and adventure game. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ufencevr.com/general-5", "developer_terms_of_service_url": null, "publisher_name": "Hugo Veryzer", "support_website_url": null, "website_url": "https://www.ufencevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEME
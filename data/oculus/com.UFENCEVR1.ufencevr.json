ThDMiXlku2vK8sO-qChSFQ3W5Z_f7udcCkJ-Q&oe=6AFDD24D"}, "display_name": "Ufence", "keywords": ["Fencing", "Epee", "Sword", "Blade", "Duel"], "long_description": "UFence is a Mixed Reality fencing and sword\u2011fighting trainer designed for real skill development, fitness, and immersive practice. Train with accurate blade control, responsive physics, and structured drills that help you improve timing, distance, and technique.\n\nChoose from guided lessons, free\u2011practice modes, and challenge routines that build coordination and confidence. UFence blends real fencing principles with VR training tools, letting you work on footwork, reactions, and blade actions in a safe and controlled environment.\n\nUse passthrough to fence inside your own space, or switch to immersive arenas for focused training. Whether you\u2019re new to fencing or looking to sharpen your skills, UFence offers a fun, active way to learn, move, and improve.\n", "short_description": "Mixed Reality sword\u2011fighting and fencing training with real lessons, blade control, setup and save your own immersive practice routines."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ufencevr.com/general-5", "developer_terms_of_service_url": null, "publisher_name": "Hugo Veryzer", "support_website_url": null, "website_url": "https://www.ufencevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_in
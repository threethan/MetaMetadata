3489201942853760_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d4JtIQLL_kQ7kNvwHgf1Ak&_nc_oc=AdoEc-B9oLgcIKXmh0nYWegtu6BpLLqY_MuZDvJaUUatIOoFvUzEK4tVwrjR0ciglN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1842UJifm-1F0UHbbHEazJqIBcvCvDVSaiSB8vbezUaw&oe=69EB6D95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "931247532992107", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_931247539658773_5930149275412435259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFggMYXDIbgQ7kNvwH_5JrD&_nc_oc=AdoJMXVwoQG0CM0riXhj_yHith__XPefEZiOmQw6MT9oi1iUuKb__OKiMhT8ol7yz1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YgHtMC4liwDPVNcoHRv8T7nvzfnigQFc_mlzxzh_Q9A&oe=69EB6472"}, "display_name": "Extreme Tracks VR: Racing Game", "keywords": ["VRRacing", "CarRacingVR", "RacingGameVR", "DrivingSimulator", "RacingChallenge"], "long_description": "Extreme Tracks VR: Racing Game\n\nExperience the thrill of high-speed VR racing like never before.\nExtreme Tracks VR puts you inside the driver\u2019s seat of powerful racing cars and challenges you to conquer some of the most intense tracks ever designed for virtual reality.\n\nRace through multiple environments including desert highways, futuristic cities, mountain roads, and sharp turn  F1 tracks. Every track is designed to test your driving skills, reflexes, and control.\n\nFeel the adrenaline as you drift around sharp corners, speed down long highways, and perform extreme racing maneuvers in fully immersive VR.\n\nWhether you love car racing games, driving simulators, or extreme racing challenges, Extreme Tracks VR delivers an exciting experience built specifically for VR players.\n\nFeatures\n\n\ud83c\udfce Multiple Extreme Tracks\nRace through diverse environments including city roads, deserts, mountains, and stunt arenas.\n\n\ud83d\ude97 Immersive VR Driving\nFeel like you are truly inside the car with realistic VR racing mechanics.\n\n\ud83c\udf0d Different Environments\nExplore unique racing worlds with different track challenges.\n\n\u26a1 High Speed Racing Action\nPush your car to the limit and test your racing skills.\n\n\ud83c\udfae Designed for VR\nBuilt specifically for immersive VR gameplay.", "short_description": "Race across extreme tracks in fully immersive VR. Drive powerful cars through deserts, cities, mountains, and F1 tracks designed to push your skills to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamelooms-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Game Loom", "support_website_url": null, "website_url": "https://sites.google.com/view/gamelooms-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26300426276280796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_1464386692003560_3509394391250112472_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttvThzh_BO8Q7kNvwETMQz3&_nc_oc=Adq4s3xZwq35JletSMD7-wwvmIFXX0EDILj3XImsbS23vk7qd8PK1ERoNgD5Ms63hDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q-J7z7edI3zgWlz4iP4g1icbfVIIXBI_jHoYZuqeO4w&oe=69EB6C01"}, "is_concept": false, "is_t
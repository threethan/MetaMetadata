04_1290232459724788_3069391058031319937_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17Qgei34heAQ7kNvwFpfeCm&_nc_oc=AdqkKkNi_x-djKXHr92sPmi1I5YjZM0qgZH1sYORTC7g73nR7dZBkoUiLz-P_vZPIPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc-0RN60zc42nDiiUMHsMzi3NWW61mzqttfbeUAMIZaw&oe=6AFDBC40"}, {"file_name": "ss6.1.png", "id": "3068180110022013", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_3068180113355346_6403489201942853760_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnW8H47pzqgQ7kNvwFyFE_n&_nc_oc=AdrAypZiCnpSeau39RVDWQuHDIE8APju_J-i3iXiOmEtHKFGJX8gfPOdTNO0qqft0ZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQszG-mtqX90VaYFJ2JZTBIFyiftdtw1rsBubZO8VolkQ&oe=6AFDDDD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "931247532992107", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_931247539658773_5930149275412435259_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3Vh7XVp2BwQ7kNvwEUU4Ao&_nc_oc=Adr4XgGKvMwskK-QlL8ZXQ0-ZFzkmcCTs5XD5XbEQBlgyoada6iBkZI2KJ61OvA6wXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSabufa70i7JMul5JcYeEWOhAcamNsuU5B2x4BYtNJJFQ&oe=6AFDD4B2"}, "display_name": "Extreme Tracks VR: Racing Game", "keywords": ["CarRacing", "BuggyRacing", "OffRoadRacing", "DrivingGames", "SinglePlayerRacing"], "long_description": "Race from the driver's seat in Extreme Tracks, a single player VR car racing game that takes you from city circuits to snowy mountain roads and desert buggy tracks.\n\nA NEW VIEW AROUND EVERY CORNER\nDrive through daytime city scenery, race beneath nighttime lights and take on mountain routes surrounded by snow.\n\nCAR AND BUGGY RACING\nExperience enclosed car cockpits and open buggy frames. Head from road racing into the desert for a different view of the action.\n\nSTAY IN THE DRIVER'S SEAT\nTake on bends and straights from a firstperson cockpit view, with other racers on the track.\n\nSINGLE-PLAYER, OFFLINE PLAY\nPlay seated with Touch controllers. An internet connection is not required for gameplay.\n\nEarly Access: The game is still in development.\nComfort level: Intense.\n\nTake the wheel. Take on Extreme Tracks.", "short_description": "Get behind the wheel in a single player VR car racing game. Race through city tracks by day and night, tackle snowy mountain roads and hit desert tracks in a buggy. Experience cockpit view racing, play seated with Touch controllers and enjoy offline gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamelooms-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Game Loom", "support_website_url": null, "website_url": "https://sites.google.com/view/gamelooms-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28280062478317156"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618254_1464386692003560_3509394391250112472_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTfnqrPWGm0Q7kNvwEBMltY&_nc_oc=Adp6weqltpH8C4Bwhvq2_UFA7pE0xlGREXg0PPHDZ2iGT12qwlFMYb3JQKAE
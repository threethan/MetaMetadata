ntent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_931247539658773_5930149275412435259_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3Vh7XVp2BwQ7kNvwEUU4Ao&_nc_oc=Adr4XgGKvMwskK-QlL8ZXQ0-ZFzkmcCTs5XD5XbEQBlgyoada6iBkZI2KJ61OvA6wXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSabufa70i7JMul5JcYeEWOhAcamNsuU5B2x4BYtNJJFQ&oe=6AFDD4B2"}, "display_name": "Extreme Tracks VR: Racing Game", "keywords": ["VRRacing", "CarRacingVR", "RacingGameVR", "DrivingSimulator", "RacingChallenge"], "long_description": "Extreme Tracks VR: Racing Game\n\nExperience the thrill of high-speed VR racing like never before.\nExtreme Tracks VR puts you inside the driver\u2019s seat of powerful racing cars and challenges you to conquer some of the most intense tracks ever designed for virtual reality.\n\nRace through multiple environments including desert highways, futuristic cities, mountain roads, and sharp turn  F1 tracks. Every track is designed to test your driving skills, reflexes, and control.\n\nFeel the adrenaline as you drift around sharp corners, speed down long highways, and perform extreme racing maneuvers in fully immersive VR.\n\nWhether you love car racing games, driving simulators, or extreme racing challenges, Extreme Tracks VR delivers an exciting experience built specifically for VR players.\n\nFeatures\n\n\ud83c\udfce Multiple Extreme Tracks\nRace through diverse environments including city roads, deserts, mountains, and stunt arenas.\n\n\ud83d\ude97 Immersive VR Driving\nFeel like you are truly inside the car with realistic VR racing mechanics.\n\n\ud83c\udf0d Different Environments\nExplore unique racing worlds with different track challenges.\n\n\u26a1 High Speed Racing Action\nPush your car to the limit and test your racing skills.\n\n\ud83c\udfae Designed for VR\nBuilt specifically for immersive VR gameplay.", "short_description": "Race across extreme tracks in fully immersive VR. Drive powerful cars through deserts, cities, mountains, and F1 tracks designed to push your skills to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/extreme-tracks-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Game Loom", "support_website_url": null, "website_url": "https://sites.google.com/view/extreme-tracks-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26267110209612403"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1475423241106744"}, {"status": "PUBLISHED", "id": "1633743998340141"}, {"status": "PUBLISHED", "id": "1306718911316360"}, {"status": "PUBLISHED", "id": "2039343610337160"}, {"status": "PUBLISHED", "id": "4664933767126540"}, {"status": "PUBLISHED", "id": "1800743140883792"}, {"status": "PUBLISHED", "id": "1439873937542121"}]}, "baseline_offer": {"id": "1439873937542121"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797451200, "status": "PUBLISHED", "id": "1475423241106744"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26267375029585921", "version": "1.2"}, "id": "924377960073402", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
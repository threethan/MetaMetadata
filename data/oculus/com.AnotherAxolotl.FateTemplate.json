=1-7&_nc_sid=6e7a0a&_nc_ohc=5loHajfxijMQ7kNvwFmp9Ii&_nc_oc=AdrUMLor4Pe5UIc11YOoBoDD_gRhqASyEFUyOyWs5RsJGJLiK3gJW7Jm66hWWq44UMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0gznlThuJT7lfe2iYyWmCtmdgnVFQr5FTeR88R31r5nA&oe=69F0A8D9"}, {"file_name": "gorillalife5_resized.png", "id": "1216137189854774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1216137193188107_8905978899675830287_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IobJU_yR5TsQ7kNvwHMrgAr&_nc_oc=AdqybAGjg7gP5-fWAZ2t8mZSsgpjqTWInOVvONAiPyXoBkDQc8dDsT3RyHqohLs9VCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af22sugTwhYT1Bs44wWy3jBmoo5eQUEbby4REdnyDO_Yqg&oe=69F0BB96"}, {"file_name": "gorillalife2_resized.png", "id": "871756852233161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_871756855566494_8646307181600752909_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrxLBqLyijIQ7kNvwEXKotu&_nc_oc=Adq2thgU3ZezkGFTbvacMurrn2CQB7TwvyHsAW_cKjPK2_srv_hA15lXvEx4v6Inc54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3f7E9Hjq1B_pSMcwd6FyZc9ulVzlj_1DsdLKMR-9q82Q&oe=69F0AB86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Revenge Tag V2", "keywords": ["tag", "tags", "tagging", "taggering", "tagged"], "long_description": "Revenge Tag V2\n\nWelcome to Revenge Tag V2! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.\n\nIn Revenge Tag V2, the objective is simple, but the journey is intense. As you leap, flow, and maneuver gracefully, you'll need to stay centered\u2014using your hands! The rules are easy to learn, but mastering the movement and outwitting your opponents, or finding inner balance, requires skill, strategy, and a bit of tag-like calm. Whether you're the one being pursued or the one in pursuit, the excitement never ceases as you explore the harmonious world around you.\n\nPrepare yourself for a game that's not only physically and mentally engaging but also full of surprises and moments of pure tag. Whether you're a seasoned tag player or a newcomer to the art of mindful movement, Revenge Tag V2 offers something for everyone. So take a deep breath, warm up those hands, and dive into an experience where agility, tranquility, and fun blend seamlessly. Welcome to the game\u2014let the tag chase begin!", "short_description": "Revenge Tag V2\n\nStep into Revenge Tag V2, a heart-pounding tag game where your hands are your only way to move! Glide, climb, and race using the Gorilla Movement System through serene landscapes. Master your movement, outsmart opponents, and find your inner balance in a game that\u2019s both physically and mentally engaging. Agility, fun, and surprises await\u2014let the tag chase begin!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deletedaim12.github.io/Revenge-Tag/pages/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "StevenGames", "support_website_url": null, "website_url": "https://deletedaim12.github.io/Revenge-Tag/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "s
 presence, filled with eerie clues, environmental puzzles, and relentless danger."}]}, "developer_name": "Nux and Under", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/c-h-i-m-p-anomaly/1c02aedc-73c0-4236-af36-853362a81530/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nux and Under", "support_website_url": null, "website_url": "https://doc-hosting.flycricket.io/c-h-i-m-p-anomaly/1c02aedc-73c0-4236-af36-853362a81530/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9418143301554404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392025_1130817414921989_8259630148177962633_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVwBKX8BruEQ7kNvwGfv-yN&_nc_oc=AdoA0lGt_Y2Wp4yyYbil-l3M7M9fqtarkLkleTb2Um7bPfV7q2yx1K8fjBrB0iwlgq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC2zFEfb9maIqnFy8GEviYQ9CyyXz6EybzK6hIPdSDJA&oe=6B0871FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "C.H.I.M.P Anomaly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT0IfUDCJEQQ7kNvwE9tQgh&_nc_oc=AdmJpi8xbSOPeE9FJqqFB3nuU1mXu5yp6_6HEm3AOB6V3LHnVlwgw8GsVQfFl20yPUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEyY0MWn29IvTpIWtxrVDqr-1eTEsHtDRWpq1RC5BqTQ&oe=69AD7741"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQwhc7BO1G8Q7kNvwH349vK&_nc_oc=AdkDSnS__E7jrobcEuTw3WJHXOw9y9kt6se96J-uGYVZVdy6q-waR6H2W_6rQ3-I9_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGwkm0yOv9yy9PsrWw4gzCeXpKGr1d7fQCEdWuApB2TQ&oe=69AD6FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dsdDTM5Tc8Q7kNvwFYoiEX&_nc_oc=AdnazRJOUIqy67dpocY5in7tjJ6UmXCrRDtGClSH5i_LWHKOjUZbJ5kjO8Hv8YKR-2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD-sPKeYGotHDSnm5sPTA0ODGhU8vT6shN7xBiMPZw8A&oe=69AD659F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT0IfUDCJEQQ7kNvwFWCWOA&_nc_oc=AdmWfuv7GuknyCRmk5B7mzO5qTVYzHPQwZcefMnh7uNB4xIVPJbMnxXNJgkAJ282OSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxbtn62Z3e8qtTw1LeB4F6YCU53KLSMzuQzbW_pwhB1WQ&oe=69AC25C1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2R4WWWH274Q7kNvwH6nmhH&_nc_oc=AdliArilE35Rk3X_vwvHzVnONcyFGQFSW21s78W46V2NxmPa4sc67QmMxgLmLy7xV80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYF2BrbZGnFmRqNbhYe9PvsDLb8UbrTaJvN_QgW-Kt5w&oe=69AC1E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dsdDTM5Tc8Q7kNvwFa6Lkc&_nc_oc=AdnmoAwbeNAAA9bCONeQPFt95x71yXtGbWQFGrkcoHgRHFsQSLD_Oln_748TEh7z-14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJhwxzrTrVK1YxzkKzeupfeFA_sNwx8y4kIu951k1X7A&oe=69AC141F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmMRBXmRYBYQ7kNvwFTCEwf&_nc_oc=AdklBrSJiZcXtBXxu69cqTy0bdm98UcNjCAThRcgCTvSomEUxeMh0YyBw0URdD9ZUbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXJ_M8U2BgLYaMm7m9bdMwx4rMaI7rrGwwXKdYYAwfKQ&oe=69B56041"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqr_N9QC8z8Q7kNvwGZRzQ5&_nc_oc=AdlBglFMRm9n6YiIZP2XtjgLmzYBQr_wQH7LeuAZill-dp6d_wbLnA3apvtDm3IY8l0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywBndvxqEzqTQHQYy5BzWFG8FMcrKleptZHa3X0QmJBQ&oe=69B558A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3qxwfUkmysQ7kNvwEO4M_a&_nc_oc=Adn1SIVObQGa7JytC7YhNdFw_xb0lm5-q3EIWcAnveetjdRTu2ANj7xBrwDZRbV4x0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMdmBypAGR2e5nz7LDcbeFStMtRSsL8zzBtTVABRKSMg&oe=69B54E9F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
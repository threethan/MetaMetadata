0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7rTiq6lmOYQ7kNvwGN1gc_&_nc_oc=AdkDZCRzCLkLmU5oK2EbYgUbzlOYbz3VJ-pP1y8fnvHi7ucSc0dXNHZ9czKJme9vTn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOETJ76onY4XkYs5RUF3RBoBZUx4noztFG2rf-yeCCzQ&oe=69B01A41"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQwhc7BO1G8Q7kNvwEWSq5S&_nc_oc=Adl0B5HSFD5Ey-GS24oO-79RLgU2-5OXr3faeQ-7enyav15nVZGN9AP61Dq0fg7wTbs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6NyPA8XMWANnqEOYRZWvn5yAg79tdKuKUT9sOnxMlJQ&oe=69B012A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKF_x0LMa0oQ7kNvwF3VfD1&_nc_oc=AdnJWUvs8ckxVY-AatM0VyTe8uS4m6PPBiQcfkO0_6LBQImkH93-WYDcwok7Vz_y89g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc8xJm66T8RHpWWayf1ndnJxGvsHqlwxoKVSuU4iVqbQ&oe=69B0089F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
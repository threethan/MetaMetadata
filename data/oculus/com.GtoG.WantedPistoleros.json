ve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name": "GtoG", "developer_privacy_policy_url": "https://www.facebook.com/AboutGamerToGamer/photos/pcb.114198597927763/115651667782456/", "developer_terms_of_service_url": null, "publisher_name": "GtoG", "support_website_url": null, "website_url": "https://www.facebook.com/GamerToGamer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5406415949389477"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1930561107763880"}, {"status": "PUBLISHED", "id": "273631319103025"}, {"status": "PUBLISHED", "id": "613438190066864"}]}, "baseline_offer": {"id": "1930561107763880"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729620360, "status": "PUBLISHED", "id": "1930561107763880"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8564463590337459", "version": "1.0"}, "id": "744752613374128", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5116482965135556", "is_concept": false, "latest_released_binary": {"__type
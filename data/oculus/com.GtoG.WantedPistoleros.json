/v/t64.5771-25/38982464_471255085985305_3375951509998844129_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHQcWbC4gPQQ7kNvwFme33J&_nc_oc=Adpjf4VelFJ4UvvbYk7n28VTOR_gTBeBwFpsNESB5k1O2pbTJIk5h0UbWt8KSYSgTJU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtQ8wk1NeJB-oZK7eniWv5MXgebIPYUBXDgemlHRCKyA&oe=6AFB4233"}, "display_name": "WANTED", "keywords": ["Shooter", "cowboy", "duel", "fight", "Tir"], "long_description": "Be fast and accurate if you want to survive in the Wild West.\nHandling your gun is one of the keys to success, so practice in the shooting range with several activities (bottles, targets, birds and a contest) to develop your accuracy and reflexes.\nIn Campaign mode, you'll have to kill 5 different opponents over 4 different distances each to become the most wanted.\nIf you prefer to challenge other players, multiplayer mode is for you! Take on other trigger-fine trigger in a merciless world and start a new legend on the wild web.\n\nPS: A new Survival map full of Zombies is available now", "short_description": "Be fast and accurate to survive in the Wild Wild West. \nAn immersive VR shooter that follows the rules of old-school dueling.\nTrain at the shooting range or in the campaign mode, and launch yourself into the Wild Wild Web with the multiplayer mode."}]}, "developer_name": "G2G", "developer_privacy_policy_url": "https://www.facebook.com/AboutGamerToGamer/photos/pcb.114198597927763/115651667782456/", "developer_terms_of_service_url": null, "publisher_name": "G2G", "support_website_url": null, "website_url": "https://www.facebook.com/GamerToGamer", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING", "ACTION"], "has_in_app_ads": null, "internet_
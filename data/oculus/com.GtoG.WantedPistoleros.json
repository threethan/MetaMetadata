0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmMRBXmRYBYQ7kNvwGEVffq&_nc_oc=Adl_fSz3qwV2MxYp7mMHwsH4wARgF6ILuMREa-7z_-SgaHoSISWxyfOSmNBcRjunKkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNigPxkOXquYqcFjzI8K6atLr2cqI3LYhBIV9LFxXMFg&oe=69B40EC1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIiw2I2MZ4sQ7kNvwE-Tq-R&_nc_oc=AdlSSmHfx9sp7TZFqJ3cXosw_ThBgvhmfH0Ua9t_J3T1GDK1i41c77uNpF6VX80H_ec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwb5a5cVXF26d4x1GCMfHukWjT15NoYI_lgCmpjaFsdBA&oe=69B40722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3qxwfUkmysQ7kNvwHohipa&_nc_oc=Adkz0Ssq1sa81nIpFCprwGWl0LRj_UHy8SZGQsIdh01OHhuj8p_rzXR-VK132a7sJ_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLgnF885EgRv-0HxCbjDMp1zXk7Kod5O_HHazwpgwZhQ&oe=69B3FD1F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
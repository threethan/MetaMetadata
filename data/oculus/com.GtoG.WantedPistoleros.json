0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE8qM6JYMu4Q7kNvwFcsPjv&_nc_oc=Adm-PJbClSbPKriZ_NQTk1BIfg1gpT0hLKCzGo8iMdBdw6-3NHAdc3EO9hpfg1tpxQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftWhuoR5EUwWl9CtS5Ul-2Sfc6MflcPREIZ1HfMJLhEyQ&oe=69A83141"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhJd3fYPa3IQ7kNvwH--bT8&_nc_oc=AdlxC0YddpXqSvyOipCxtm3EJFAMKK-mlwZtRwajHqPOFWD9ENIphpI76Nkka8HrsH8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvrOYolPLHfmbI4R5Vuz1IgAHPq5pGTHWwOI_WEh6OPcw&oe=69A829A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XnRI0nTnDUQ7kNvwEAbJVs&_nc_oc=AdleCTAozygcK1GH7sQ6iCJ1tmgq4J6b3gSWgTfxKAoND0a1B3yQfYcBKcwHU_uYPkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu8EI63oSRWYABPTaSLruzlP_2DZ3knt_fI1mwaK3N4-A&oe=69A81F9F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
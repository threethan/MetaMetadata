/39035334_545790823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE8qM6JYMu4Q7kNvwFPvc-0&_nc_oc=AdmN40bG7T2fV9jd5-EP6sGoOs-_q3bCT8dONk1TUcX03cgZPoMGbRYnNu639tstnWk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCPGcT_6JfHIQAJpE1T_68YFblZHYehcFyeYdswzah9g&oe=69AAD441"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2R4WWWH274Q7kNvwEQE6vo&_nc_oc=Adn4ko-t8Oh2XGf4Tc0PO3T5cTMe6GmoyjzVXmNoGedwnT5dr-jmGjtMbPRNMiWidD8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrxLwaWeAxQwK1ax2h3OchqmsAf7_A6xzdQjAgkjMqiQ&oe=69AACCA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XnRI0nTnDUQ7kNvwEdG9RB&_nc_oc=AdmGNPLSieylQ_0js8etvvtk-BrduQcnncs6fnTbkJww8I6O9ZpLgnqjbMAHoY5FmIc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOzRvfdw8ws-1l7-9Nk6Uy5zgvZiXK6csIemT4Tk7FVQ&oe=69AAC29F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, 
0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8GbYdYANpcQ7kNvwHXtwV4&_nc_oc=AdqyJIdurcmEAgpkkoDBU-Val5SsB8BIKUPNoFFOBEZv-7p8_TRH6NWijYoBx7AzkZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLN7uxeyOgsUG6hXbX2FNyXT5yMVHxo5_x-VlCsq8lRQ&oe=69C13DC1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB8uWHWtbNwQ7kNvwGCWYje&_nc_oc=AdpL22qihDrWky9IsK2aObZzFzC0lKTslyPxxPvMVoFLGW9y-5BJF_aXJgURL1oclAQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0-JMEwgIH19wuvE6gpyqkFk6yx0RRZADA4_4cDPtPlg&oe=69C13622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwW1NV1n0f0Q7kNvwFJmFLG&_nc_oc=AdpH0QWOoxPN6P4KjISKh_YrKLh7hGNRMeyBoussWZ3OCCzVK5eJwW9KLSUAAZCd7aA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzwocYvhUQauXh8VIDfpnOsylxucWwwf8NzwcQ3XxJXCA&oe=69C12C1F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
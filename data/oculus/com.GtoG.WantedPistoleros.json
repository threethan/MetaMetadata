0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE8qM6JYMu4Q7kNvwFTwluU&_nc_oc=Adltp7pZ5BapPmQYq8JpQl_bOZ8tmRrnMAiYw0SrX8HeD-XlR1ILt7hmdQG5S7FInzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftuD0wOAza5OZ1UxQ-SZd07IQbKU1w4JTTm3ZfLC-cFpw&oe=69A982C1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2R4WWWH274Q7kNvwGCrxMq&_nc_oc=AdlDkziwZ8wZmtIq-MpAFcZOOWYXdM8NloLTqHVStT4VtsIviYbiIjyCWz6axNNoxpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftJSbgMR2Kzpesi35uYCdWZoHxRdxBpfyA4eCoLW19_ag&oe=69A97B22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XnRI0nTnDUQ7kNvwEGeWIU&_nc_oc=Adlh_cfhceDSZ-2G8g4LiO9sChjSadleVq8lReHz94FQk2eivj0dhRg2cEzYcZvOeRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv67on8IxA3FMSzaV6r3m3RK-ewvuFF_4wLDTbtMVHOEg&oe=69A9711F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
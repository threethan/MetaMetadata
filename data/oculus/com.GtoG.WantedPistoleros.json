0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7rTiq6lmOYQ7kNvwFdN6Bk&_nc_oc=AdlqLllkH7eaa569YCZBnClOzxBhG1CAS5rf52ZKBt5QpYPRdbANeCcgroFVwYmvGaw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz18Oeo9vjFff0RWVDvaxby6HkHqQCgbtvtQTbqFmnoGg&oe=69B16BC1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIiw2I2MZ4sQ7kNvwEmBKBO&_nc_oc=Adktpc6iGU4mLL1JLUpirLFsVgAOpTLevNQN4RFKDIJB-4b0D6d0tn8PUti99hN67MA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3bWGH3_W_EanOJd4utC3bZWWskIExaZpCsln9EYuT5Q&oe=69B16422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKF_x0LMa0oQ7kNvwF305Dg&_nc_oc=AdmmrBqQLIj5yQfqZrOXvUc7HlyCaju7SUnt6xNRbyke6NIpHVjsR9Sl-jv8yCc4U2M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSWdRH8UsR_NVa5YCSvYUn9C1KMfZD1hQnLDkkyeGZLQ&oe=69B15A1F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
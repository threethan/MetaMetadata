0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jT0IfUDCJEQQ7kNvwHu1-zV&_nc_oc=AdndHXhJLz_AJb7g2Su6hAn7geRLveWd30lIoQwWdEDWcNNSiBuUcp41vn0sfb_M1iU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu9y1NgKQffu86oq5A6Crs7l0BoRxM6q0vXm62XfI0EA&oe=69AEC8C1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQwhc7BO1G8Q7kNvwHYlai9&_nc_oc=AdmrHVgww0_yqbrG4CI_T_VyHFyKNmJN6vWcDKPHg8u-Ubd86ADTQ5UPjKID7Sspwbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPr1EidE-MyGuVL0E8YJoFt9VtafSGtJqaRR70cCRrsQ&oe=69AEC122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dsdDTM5Tc8Q7kNvwEgbv8s&_nc_oc=AdnoRIJpQud2jzYvL8cKoxTiq2wcVCfhEth5TIh7lchPLCH1Q43iIP2fqtEKWl16m4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBjjPUqBFxbhkngvQvqKHXzlzC1bgfBd_84-XQYFK19Q&oe=69AEB71F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
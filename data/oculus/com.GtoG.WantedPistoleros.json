0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwtZVlw3AQkQ7kNvwHNicU0&_nc_oc=AdlT3jptb7vmO9Y_hCNeuhVAAMIbWEI1Wx6q5BKCAogr1cjBS0gZ7qJ1qkOdrEXVM9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrDT4bs25trT3rEirXi-xQ6_2PXro4pXWnQQyjgHeEmw&oe=69B80341"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqr_N9QC8z8Q7kNvwHtexrX&_nc_oc=AdkV-qnj1hPuFmkqYEkZYdOGRV50RxoYuLQHagHW_77Pp4UilPgeZ4_OL8_wdWtbMec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiL0oHIEAnd6OHTfnZWy_-i6lxJfOHXWuF8Bh-YWYTWQ&oe=69B7FBA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SavLgEdKQx4Q7kNvwFc-6XQ&_nc_oc=AdmGd-7Sqcb6XuDgdFyuGRbtf-GPcAbHrEfz0hkQRzfdQg5hscRASxnjaLcOfilMJGs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6HS-kx9fHAkhrI6Bsu_Yr33EMpeSWG7ukK8VjZkhrUA&oe=69B7F19F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
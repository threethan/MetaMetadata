0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmQdLX_8h5cQ7kNvwENH1MP&_nc_oc=AdmtQdMfdKZ_NVqOCLCGbjBX29hHlqMqQKzCoRKN1wpbpdH5aNwVWxryrsS8OBdWIec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvA89b-yyLWdDC97hirBJoKhpTsM4kYUrE63qCv4vVHA&oe=69BBF7C1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDhJaSxuje4Q7kNvwEVZEC2&_nc_oc=AdkVFoxSC-SG2r5oqKc9hVTGZ8-sBxb1v0F44ihuZ8JrEr0lNNEeRsVzg8GBLzIf2T0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykOZzxAe1QNEKFcVulIOXcZgy4L-Kw4pZ3DxOeLNAeuA&oe=69BBF022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEqphQzW30gQ7kNvwF_DkQ5&_nc_oc=AdmDmH3dVm-aWM0_phHNE9Ijwwo4LCckp1D5Em1jUsgPwHyB2d79N_HKoPxl86daNgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyugBljH_gn8kGBgCbFJyYD4BVmWMvhivDI4UDEm5pwtQ&oe=69BBE61F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
0823581237_2426036209941425543_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmQdLX_8h5cQ7kNvwFE3LTR&_nc_oc=AdmO6V-E7m1W9OpuLiELn0vViWIjBMegiB88sSuhBHbIkUIjHUoTss_ZmoWukIxs3Rk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuGa4pu-WZmjx_jbH7kqL53Dcv1mnMPEWq0Q40Jbv2Nw&oe=69BE9AC1"}, {"file_name": "4.png", "id": "507203211105239", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031619_507203217771905_3748377675033881057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3ox2dvwOLYQ7kNvwE2fOCx&_nc_oc=AdmivLrmhZc13mtCxHZArARpRnsvFv9U1YHxUFtAs0j1Shg0xeGwv41MWdbmT_wWFXk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeWylT2Tpk2FUD2-KlAhzueTHjCiDjAvqefhtX2kAYfQ&oe=69BE9322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVERVIDEO.png", "id": "337877825078594", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240102_337877828411927_2449979645059503721_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEqphQzW30gQ7kNvwFMKTUB&_nc_oc=AdlfQBGpp_6Aw4kNcIPBrzK4QCPfSBic7olAuano3tLmyj4qMXEPFX5Meq-dEvAU6oc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuwEYAtL8vSXb5Q02Lf6GG4dTPR-Wv29GdaMK2aGTHpQ&oe=69BE891F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name"
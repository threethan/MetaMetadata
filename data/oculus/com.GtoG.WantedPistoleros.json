uvzA&oe=6AFB295F"}, "display_name": "WANTED Pistoleros", "keywords": [], "long_description": "Welcome to the West!!! As the sherif of the city, the locals are counting on you to clean up the town from the Scorpion gang...\n\nBe quick and precise because the members of this horde are not into the business of joking...\n\nPassing all the Gang members, to reach the final boss \"Scorpion\" will not be an easy task. Along the way, you'll have the choice between earning more bullets, more slowdown or more health... Choose as if your life depended on it.\n\nTo make sure you're protecting your life and the lives of your people with the right skills, take a trip to training to improve your speed and accuracy.", "short_description": "Old-fashioned duels in the middle of the Wild West... "}]}, "developer_name": "GtoG", "developer_privacy_policy_url": "https://www.facebook.com/AboutGamerToGamer/photos/pcb.114198597927763/115651667782456/", "developer_terms_of_service_url": null, "publisher_name": "GtoG", "support_website_url": null, "website_url": "https://www.facebook.com/GamerToGamer", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "FIGHTING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5406415949389477"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1930561107763880"}, {"status": "PUBLISHED", "id": "273631319103025"}, {"status": "PUBLISHED", "i
7_361363906514372_9082455880927070213_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wu5C-WxxgjwQ7kNvwFg4jnS&_nc_oc=Adpm6aH3y1OEqQI96blVPyobbF-cXxxVF49PVj2bVzoK41pE45l-lfnOQY8vMQuQIR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWaqhS2kfKegellwT9nsss9pK4RkC39cs-x3qeJABx5Q&oe=6B05B328"}, {"file_name": "Screenshot5 - trackhoe.png", "id": "3595315237374987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43931327_3595315240708320_2111437253244231984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qWphD9sB8wQ7kNvwFlvAxK&_nc_oc=AdpAHqtzaq8vkQSYnAawGB_ia4D1UZlH9EnnOgDFNkfvN5ry_kqTgHCnQ7oDWGqn0zI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY95DOhX9g4lX_3-VlFw3xRjvvdHSDC44b_ll6NkAVvQ&oe=6B05C892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot1 - trackhoe.png", "id": "1362196601352415", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974551_1362196604685748_7497940842319491704_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvVNMl1JsNgQ7kNvwH3ksnH&_nc_oc=Adp0JvZcuQWmcBdXyKFddtiNYfQ1RZLnYPuLPVG7U7Su4GIDRDRfNusIyLAXBp3NVQo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzOhjMhC-oF-bOS0p5usMa4sIjQE4YllAZgDLfBGAS3w&oe=6B05C8B1"}, "display_name": "Track Hoe Safety and Operation", "keywords": [], "long_description": "Track Hoes are the toughest excavating vehicles used across multiple industries. They are used for material handling, landscaping, demolition, mining, trenching, river dredging, and construction projects. The track hoe consists of a boom, arm, and bucket connected to a cab that sits on a turret that can rotate 360 degrees for increased visibility. Track hoes use tank-like tracks and have a low center of gravity providing exceptional stability. Participants will operate a track hoe and complete various tasks on an active worksite as part of this engaging simulation. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment.\n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a dump truck in a safe and realistic format. Participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Participants are challenged to complete tasks at an active worksite, including digging a trench, placing irrigation pipes, and backfilling the trench. ", "short_description": "Track Hoes are the toughest excavating vehicles used across multiple industries. They are used for material handling, landscaping, demolition, mining, trenching, river dredging, and construction projects. The track hoe consists of a boom, arm, and bucket connected to a cab that sits on a turret that can rotate 360 degrees for increased visibility. Track hoes use tank-like tracks and have a low center of gravity providing exceptional stability. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
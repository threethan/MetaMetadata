Er9z6YNqgHQ&oe=6AEB5528"}, {"file_name": "Screenshot5 - trackhoe.png", "id": "3595315237374987", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43931327_3595315240708320_2111437253244231984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHuobyxrxBAQ7kNvwFh84w2&_nc_oc=AdpluuzT626gPIadcpdUvv3eRCe5HSJ4ziw0f4C-gYpLFQid4cFZShyFcpRZujcnPLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXjWs-CnC0tPr1UOZuE4aNGpYiYBf-US9AEhw_pdWoLw&oe=6AEB3252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot1 - trackhoe.png", "id": "1362196601352415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974551_1362196604685748_7497940842319491704_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd_WVTi0rnEQ7kNvwHQ6sQZ&_nc_oc=AdqV9Hgx4ib3Vr9WmJuxLX8gjtxlABnFF2xg5_SzI8xetWrWLcuvgMUpnELHRcjly7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhmvCYHLUDNXT8blSJes74zneui3oaNI3ulh3pt7nknA&oe=6AEB3271"}, "display_name": "Track Hoe Safety and Operation", "keywords": [], "long_description": "Track Hoes are the toughest excavating vehicles used across multiple industries. They are used for material handling, landscaping, demolition, mining, trenching, river dredging, and construction projects. The track hoe consists of a boom, arm, and bucket connected to a cab that sits on a turret that can rotate 360 degrees for increased visibility. Track hoes use tank-like tracks and have a low center of gravity providing exceptional stability. Participants will operate a track hoe and complete various tasks on an active worksite as part of this engaging simulation. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment.\n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a dump truck in a safe and realistic format. Participants must don personal protective equipment (PPE) and conduct a walk-around inspection of the vehicle. Participants are challenged to complete tasks at an active worksite, including digging a trench, placing irrigation pipes, and backfilling the trench. ", "short_description": "Track Hoes are the toughest excavating vehicles used across multiple industries. They are used for material handling, landscaping, demolition, mining, trenching, river dredging, and construction projects. The track hoe consists of a boom, arm, and bucket connected to a cab that sits on a turret that can rotate 360 degrees for increased visibility. Track hoes use tank-like tracks and have a low center of gravity providing exceptional stability. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24532520453059900"}}]}, "s
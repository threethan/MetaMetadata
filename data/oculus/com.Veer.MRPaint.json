https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393723_682764528243698_5823479591663659370_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FHKiZCTvAEQ7kNvwFXMIjq&_nc_oc=Adq2D69uYBAxQ5KpqHpCMSDGID03Vn7jG48x-fVj1JnfNXy93hhNTzQU79K1T0p28_A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wSqQMAQ7tMA9GkZYs1cUWguglT9Uefcwi5Tk3lP8vLQ&oe=6A243154"}, {"file_name": "1.png", "id": "2019358538589106", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393905_2019358545255772_2623391390180246431_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfZluZHrRasQ7kNvwHxvz9B&_nc_oc=AdqLeenOjRrBK96vc8j3efajXplxAl_nxSNnvV5bqilw5WcQ5waCFLZ60zmOhA_6Z4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_su58Yz3DQbOYuSseyI4XuTpCPZyw_e1VU7AD4CCptnw&oe=6A243BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "spraycrft-25601440-32bit.png", "id": "1174300697766760", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819351_1174300701100093_1821219150499979681_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN8LoheP9t0Q7kNvwHT2uh1&_nc_oc=AdqPx1Cx_jGKUc4FesNg3DVt5NDFAPnh2N-I5TA6In4b1-idr7CAreKfquRK2q8-h8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X3Q6YKFW6SLhZmRZP6eiubO_SWuJ6ixHkGXEQu0wB1A&oe=6A242C8C"}, "display_name": "Spraycraft: Mixed Reality Spray Painting", "keywords": ["graffiti", "art", "draw", "paint", "kingspray"], "long_description": "Spraycraft offers you a mixed reality spray painting experience that breaks through the limits of your imagination! It perfectly combines the mixed reality gameplay that blends the virtual and the real with the exhilarating and stress-relieving spray painting simulation and creation. Here's what you'll experience:\n\n- Spray paint freely either in your real home or outdoors. Switch the material surfaces of real wall, floor, ceiling with a diverse material library to create a mixed reality graffiti paradise. Say goodbye to the trouble of buying expensive paints and polluting the environment. Enjoy a highly realistic spray painting with adjustable spray caps, pressure, and special effects.\n{1805070990069367}\n\n- Spray-paint anything! Unleash your wildest imagination with various sprayable objects. From hip-hop skateboards to motorcycle helmets, from the famous Thinker sculpture to ship-size rubber duck, there's a vast library for your graffiti art. You can flexibly adjust their sizes and location, putting together a crazy collection in your home or backyard.\n{1589598851729966}\n\n- The convenient stencil feature (supporting multiple layers of stencils) makes it easy and enjoyable for you to create professional masterpieces even with no prior experience. Stickers with adjustable transparency help you easily paint with an auxiliary reference. AI-powered stencils & stickers enables you to turn your wild ideas into professional spray painting in just a few minutes!\n{674811758630428}\n\nJoin discord (https://discord.gg/GGmhPzFVDr) to get early access!\n", "short_description": "Spraycraft provides an unparalleled mixed reality spray painting experience that surpasses the boundaries of imagination. It seamlessly merges the virtual and real in its gameplay with the exciting and stress-relieving spray painting simulation and creation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommen
cwgAM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LGm5mNhw9eOq8aiZm1LVTQNPL6ENdjmd1m4SvJXhQvw&oe=6A24355D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc169.png", "id": "4196286593949301", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623314_4196286597282634_14202489118353156_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQMHg4RN0LYQ7kNvwG91v91&_nc_oc=AdpEN8m4CeAtMeK-8-XUEaDJF0KYFjG6LNbeI8uSMR-UwW5YdXF9qmfGRy6hJC_xEvM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RMefrT_8T3V5Jiva0VI4yfY9BxfLAz1gA_tx0bQjmTA&oe=6A243523"}, "display_name": "Spraycraft: Mixed Reality Spray Painting", "keywords": ["graffiti", "draw", "paint", "kingspray", "Graffism"], "long_description": "Spraycraft offers you a mixed reality spray painting experience that breaks through the limits of your imagination! It perfectly combines the mixed reality gameplay that blends the virtual and the real with the exhilarating and stress-relieving spray painting simulation and creation. Here's what you'll experience:\n\n- Spray paint freely either in your real home or outdoors. Switch the material surfaces of real wall, floor, ceiling with a diverse material library to create a mixed reality graffiti paradise. Say goodbye to the trouble of buying expensive paints and polluting the environment. Enjoy a highly realistic spray painting with adjustable spray caps, pressure, and special effects.\n{1805070990069367}\n\n- Spray-paint anything! Unleash your wildest imagination with various sprayable objects. From hip-hop skateboards to motorcycle helmets, from the famous Thinker sculpture to ship-size rubber duck, there's a vast library for your graffiti art. You can flexibly adjust their sizes and location, putting together a crazy collection in your home or backyard.\n{1589598851729966}\n\n- The convenient stencil feature (supporting multiple layers of stencils) makes it easy and enjoyable for you to create professional masterpieces even with no prior experience. Stickers with adjustable transparency help you easily paint with an auxiliary reference. AI-powered stencils & stickers enables you to turn your wild ideas into professional spray painting in just a few minutes!\n{674811758630428}\n\nJoin discord (https://discord.gg/GGmhPzFVDr) to show your work!\n", "short_description": "Spraycraft provides an unparalleled mixed reality spray painting experience that surpasses the boundaries of imagination. It seamlessly merges the virtual and real in its gameplay with the exciting and stress-relieving spray painting simulation and creation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "ko", "ru", "ru_UA", "de", "de_CH", "it", "fr_BE", "fr_CA", "fr", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32847354191579047"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622325_2133774633826387_1278310541558573527_n.png?stp=dst-png
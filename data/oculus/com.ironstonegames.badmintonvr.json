0a&_nc_ohc=lNN0sCIBl4cQ7kNvwEYl98n&_nc_oc=AdoHV1HGCopAOj1FCJpyOV-q_ycyOUX6ht5qwqxdSacv2UqX5-8gOByhED49GhE4HN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIthM0K980PRBAW4JL-RAsrOv4YeYXl0qM8QpjmtvXrYQ&oe=6A9EE2A2"}, {"file_name": "3ss.png", "id": "766031955583521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003242_766031958916854_1064202153085358352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_aWbv0AH-4Q7kNvwGGRVDO&_nc_oc=Adqu5XVc08A9ALjTQjadAZ37ps1SCcqovKzqhyU4zqPRuy3e6pEtUZTMHwK1F9yVp70&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaggUfxIYIms41Im0UQemeM0X5Y-mfQxa3t2dcYmXD-g&oe=6A9EC9CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "badminton_cp1440.png", "id": "212278464249674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422369_212278467583007_726524267905999486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHyPNFRsJ64Q7kNvwFBk_0k&_nc_oc=AdoesUDOAwXCLuZ0G19DHJWw8bG6HirD1Lw7Fdz8Jh-jd3KnM5GRAacPZEoFKIBzZTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5QTLG1-aHek9cOM2GIelsq-R08GtbGIozGZBAIR7hoQ&oe=6A9EE34C"}, "display_name": "Badminton", "keywords": ["badminton", "tennis", "court", "net", "racket"], "long_description": "Welcome to Badminton! Step into the court feel the immersion and enjoy the gameplay with the untethered freedom of Oculus Quest.\n\nBadminton is a Virtual Reality(VR) game where you play against advanced AI and there are other amazing game modes. With physics designed to be as real as ever and has been achieved in Badminton, don't worry you will forget that you are in VR.\n\nSINGLE-PLAYER EXPERIENCE\nIn the single-player campaign always know that as you win the harder, demanding, and troublesome it gets!\n\nMULTIPLAYER & ONLINE RANKINGS :\nMultiplayer modes are officially now available modes are Ranked, Unranked, Into the Bucket Versus, Hangout, and Champions League.\n\nPHYSICS:\nWe have been obsessed with creating the most realistic and futuristic Badminton the world has ever seen. We spent countless hours coding to ensure you get a good experience, and we believe that we have accomplished that goal.\n\nWe hope that you enjoy playing Badminton!", "short_description": "Finally the best VR badminton game ever for VR! Now grab your racket to smash, hit the shuttlecock, and do a crazy smash to your opponent like a badminton star!\n"}]}, "developer_name": "Slumberlion Games", "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion Games", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pt", "ru", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27461826120172083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974523_418152583256073_3153573907440751103_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNPzp2c15L0Q7kNvwEegh9X&_nc_oc=Ado-qoL7tV4KzBDjRcQxUkTwuUhHJmKyFfpCeEsXcvv_JWMEID42yD0dXyVqmXjJmvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_VLzSCIuS4Sclu5BVdpDHMkErvXEkCF7Kb8NYZk_SrA&oe=6A9EC40D"}, "is_concept": f
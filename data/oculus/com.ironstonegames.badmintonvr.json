0a&_nc_ohc=fUFovyVEG_YQ7kNvwEvVO3i&_nc_oc=Adrb44x43DJBIgBZfd9-2-tW5-On59Jjo7xh1JyP14YliNmzo0pRdt4XrRhpnV_WgPc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3K_fMsWYqq7mD96UGkR8_hUEomSXmqcsATBipHsN1bw&oe=6AD39EA2"}, {"file_name": "3ss.png", "id": "766031955583521", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003242_766031958916854_1064202153085358352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z23wuqa71F8Q7kNvwH71Ckw&_nc_oc=AdqCACNyKWGjtcA709TKIdeRj0afhf42mRRZDO_l3J9AXbw35BevYKQKRZlEmR0ZOZk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZa2cXbshs40izOhlOVuN4_doDrLmQMz4DiCPvpx11VA&oe=6AD3BE0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "badminton_cp1440.png", "id": "212278464249674", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422369_212278467583007_726524267905999486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KCdO-kn4D0Q7kNvwFHXLt-&_nc_oc=AdqKZs2-GyYjdwSni0GhoyAncacuNfYJxdXkKM7zTrPlvqlfFiO8WWH5_6omZi9debw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO703pyPs8Gp4q7vMiNH4VcOJCBpmrkazdyJf7bHojPJA&oe=6AD39F4C"}, "display_name": "Badminton", "keywords": ["badminton", "tennis", "court", "net", "racket"], "long_description": "Welcome to Badminton! Step into the court feel the immersion and enjoy the gameplay with the untethered freedom of Oculus Quest.\n\nBadminton is a Virtual Reality(VR) game where you play against advanced AI and there are other amazing game modes. With physics designed to be as real as ever and has been achieved in Badminton, don't worry you will forget that you are in VR.\n\nSINGLE-PLAYER EXPERIENCE\nIn the single-player campaign always know that as you win the harder, demanding, and troublesome it gets!\n\nMULTIPLAYER & ONLINE RANKINGS :\nMultiplayer modes are officially now available modes are Ranked, Unranked, Into the Bucket Versus, Hangout, and Champions League.\n\nPHYSICS:\nWe have been obsessed with creating the most realistic and futuristic Badminton the world has ever seen. We spent countless hours coding to ensure you get a good experience, and we believe that we have accomplished that goal.\n\nWe hope that you enjoy playing Badminton!", "short_description": "Finally the best VR badminton game ever for VR! Now grab your racket to smash, hit the shuttlecock, and do a crazy smash to your opponent like a badminton star!\n"}]}, "developer_name": "Slumberlion Games", "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion Games", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pt", "ru", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27461826120172083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974523_418152583256073_3153573907440751103_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7Nu609p24sQ7kNvwEK1Dj2&_nc_oc=Adp5stBSnMGeO0vprfkD4UErEY1INlMfI5V8wZYrG9Rnu_mK-lG0AkInA4OguC0X7q0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwhDB0vlH_veDySXR12CfDnXb-5QUQ6hey07tEMJUsgw&oe=6AD3B84D"}, "is_concept": f
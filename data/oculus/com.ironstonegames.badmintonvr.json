0_AfxfVUX33rHj0sioGwaxQnNSBr0qOrK4V4VQTc2ONuP2_Q&oe=69C910D5"}, {"file_name": "ss6.png", "id": "573340430514716", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566678_573340437181382_6514483573230342226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAZ3jr7Rd8QQ7kNvwE6WDV0&_nc_oc=Ado3KgIniLr2i_Y_hI_0UzhzxYmnr5yBIKXS6rAdQckmenKCrtSLiLDgTIF7tLpkG-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5yUtLBB93hnj88xj3K39Z3GaSZ2ttDjZGgNYSnYfvPQ&oe=69C92E75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "badminton_cp1440.png", "id": "212278464249674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422369_212278467583007_726524267905999486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nbNVOsjFUQQ7kNvwEzsytK&_nc_oc=AdpFXUyWJxzfguM5hQNCzu3wy5hnbGAfIt5COd8nGww09odlWeDmO5WwWcRTeSmjmuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwzw1HeL-3a_SDlYhfNIWhpUSm4wmnefsjFxlBMfRj5Kg&oe=69C9180C"}, "display_name": "Badminton", "keywords": [], "long_description": "Welcome to Badminton! Developed by Ironstone Games for the untethered freedom of Oculus Quest.\n\nBadminton is a Virtual Reality(VR) game where you play against advanced AI. With physics design to be as real as ever and has been achieved in Badminton, don't worry you will forget that you are in VR.\n\nSINGLE-PLAYER EXPERIENCE\nIn the single-player campaign always know that as you win the harder, demanding, and troublesome it gets!\n\nMULTIPLAYER & ONLINE RANKINGS :\nWe are still working to perfect our multiplayer mode and it will be available soon! You will know when it's available, keep checking for updates.\n\nPHYSICS:\nWe have been obsessed with creating the most realistic and futuristic Badminton the world has ever seen. We spent countless hours coding to make sure that you get a good experience, and we believe that we have accomplished that goal.\n\nWe hope that you enjoy playing Badminton, also awesome updates coming soon!", "short_description": "The best VR badminton game ever! Now grab your racket to smash, hit the shuttlecock, do a crazy smash to your opponent like a badminton star!\n\nAwesome updates coming soon!\n\nJoin Our Discord: https://discord.gg/x3pKCaEX3u"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ironstonegames.com/privacy-policy/", "developer_terms_of_service_url": "https://www.ironstonegames.com/user-agreement/", "publisher_name": "Ironstone Games", "support_website_url": null, "website_url": "https://www.ironstonegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pt", "ru", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "360628155903440"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1231281820675757"}, {"status": "PUBLISHED", "id": "514556147461716"}, {"status": "PUBLISHED", "id": "1352783205627418"}]}, "baseline_offer": {"id": "1352783205627418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1632360540, "status": "PUBLISHED", "id": "1231281820675757"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24637162305971826", "version": "2.0.4"}, "id": "202701471822448", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typen
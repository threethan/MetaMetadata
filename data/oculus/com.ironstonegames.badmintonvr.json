g", "id": "251817376851003", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031603_251817380184336_6451284824683203126_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msYhwHrqGAQQ7kNvwGQkuF6&_nc_oc=AdpCVQcBgbih31uNhRUssESbBt9PrLTvx6mrPcwTs1dlZiQ77zcZWlkWD7EHC0I6mqM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN067_H2TODLjuf2APmUilBzCtjwTB3afH_9DW7eET9EA&oe=6ABFC56E"}]}, "id": "843918912123673", "locale": "en_US", "screenshots": [{"file_name": "2ss.png", "id": "1576194123152916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001654_1576194126486249_7255661654914767565_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtQFTBIwTzgQ7kNvwFIFtDx&_nc_oc=AdrATGntjiIKG_unLmSKjYVr1d7c7xiDsBWWXpAfByOeOixRncAhCWv8E8LQrmULink&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb0xi810C3aSFYp5i4jbvy9QWUGLmE3cGJ_RliY69vkA&oe=6ABFC2AF"}, {"file_name": "1ss.png", "id": "1061900241791444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_1061900245124777_5308768794369516440_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz9v8UbG5tUQ7kNvwFGEwgI&_nc_oc=AdrmU2ZzNvLGAtWZ9ZeiKthUSGP8P-1gHSzXppUHF8yHrCEgeUyFRjvgibhgLdYowOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIexnNWNSWVeoprWfppxamubym1NMDx3m064nwzoULGQ&oe=6ABFE028"}, {"file_name": "4ss.png", "id": "275493575516024", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_275493578849357_8007809835456036211_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0ciSbwcqUIQ7kNvwEW8Elv&_nc_oc=Adp1gdNUcMOIfoUEIAhwmabRr-zUSslVvKh902VSEDfUtec6cjOncJXpvSeWIOLyz6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUUStcDgKO9Ky1tygF4j95no6ok04RUTqcislXwBwKGg&oe=6ABFDA0C"}, {"file_name": "5ss.png", "id": "1297785310927799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974891_1297785317594465_2224116625908864109_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZIHHqP_QQMQ7kNvwGuLbYv&_nc_oc=AdqUk55OAqXTSEOIfEWxddzLIjPO-KrB7PcxKBfkIpon-Ktuxde_8tpX2vHiT6D5w88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxCSdmo96WWqNN2QrN7qCIaYbKzzfPOaBgxQiUPS3PrQ&oe=6ABFD822"}, {"file_name": "3ss.png", "id": "766031955583521", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003242_766031958916854_1064202153085358352_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNvWW8O_E-4Q7kNvwGosl3i&_nc_oc=AdqkluQwBHU0UHDvk_-Vater3id6CZgueJq1ljL22wHikUAM6I4l88hALjr-iZnukJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_93qneYaoDc2yGk80dxdRTeJhsBhFuj1vVK6GRzUzpA&oe=6ABFBF4D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "badminton_cp1440.png", "id": "212278464249674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422369_212278467583007_726524267905999486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyDl60Tglf0Q7kNvwHwy71U&_nc_oc=AdrnKnX4EPPWNtQZpbJrGCLPFyBdcIXtYl7hrt-3xx3KujJl7pjF_QaXGSuWA3mn15M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRbZUMztb41O_kQfWhpZZerF49l7UDORIhflwUiqAFUA&oe=6ABFD8CC"}, "display_name": "Badminton", "keywords": ["badminton", "tennis", "court", "net", "racket"], "long_description": "Welcome to Badminton! Step into the court feel the immersion and enjoy the gameplay with the untethered freedom of Oculus Quest.\n\nBadminton is a Virtual Reality(VR) game where you play against advanced AI and there are other amazing game modes. With physics designed to be as real as ever and has been achieved in Badminton, don't worry you will forget that you are in VR.\n\nSINGLE-PLAYER EXPERIENCE\nIn the single-player campaign always know that as you win the harder, demanding, and troublesome it gets!\n\nMULTIPLAYER & ONLINE RANKINGS :\nMultiplayer modes are officially now available modes are Ranked, Unranked, Into the Bucket Versus, Hangout, and Champions League.\n\nPHYSICS:\nWe have been obsessed with creating the most realistic and futuristic Badminton the world has ever seen. We spent countless hours coding to ensure you get a good experience, and we believe that we have accomplished that goal.\n\nWe hope that you enjoy playing Badminton!", "short_description": "Finally the best VR badminton game ever for VR! Now grab your racket to smash, hit the shuttlecock, and do a crazy smash to your opponent like a badminton star!\n"}]}, "developer_name": "Slumberlion Games", "developer_privacy_policy_url": "https://slumberlion.com/privacy-policy/", "developer_terms_of_service_url": "https://slumberlion.com/terms-of-service-agreement/", "publisher_name": "Slumberlion Games", "support_website_url": null, "website_url": "https://slumberlion.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pt", "ru", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27461826120172083"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974523_418152583256073_3153573907440751103_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6KNHkwKK0QQ7kNvwHYeKIR&_nc_oc=AdqylBCsBg_L7skBAWeYcfuqB05Mg-vpMe5LGPJLv8-9x15_A6Oo0qegOy-FB69rvRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDHxwcrUKcQJnxM5MwoUDpvn7ZdOAaoW1GBrQ31fvdQw&oe=6ABFB98D"}, "is_concept": f
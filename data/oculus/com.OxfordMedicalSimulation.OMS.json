{"file_name": "ScreenShot_01_31343.png", "id": "981952515865382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974907_981952519198715_5546388269440267536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJYmaajlIIYQ7kNvwHsNYnf&_nc_oc=AdmsYeIYXO8jJdFOODaHI0n5Kp8Atve1de_AhHUwM2-a74SVsQN0sioePastWUV1ZKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcNsOL7ez2ImBntai6IrzOa1Fnm_ldzDot82eGygdAaQ&oe=69BFD7EE"}, {"file_name": "ScreenShot_01_879.png", "id": "337019861563320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_337019864896653_3993836798915940721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFIx8EwuSVkQ7kNvwEZFig1&_nc_oc=AdkGsdUO18eH3Fws_Fiw9kizREUPPafDRWMN6VV7kt_uf4CpZCWmiNS2hToyl_6i3PU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeDacdtRKDWNyOmUHtzefsK22IARqCImfCc80PGORFuQ&oe=69BFEC2A"}, {"file_name": "ACLS - Eyes.png", "id": "598458138028696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031384_598458141362029_8070608380969850911_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EycGRcUaCAQ7kNvwGJwxfu&_nc_oc=Adnj8K03ChEEmh_VD9ERFX_ojzYMupJ_4nutEiq5HQh2vFtQ_eViy_ApN2jG2Qd7KBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5y30VClttL5vBTX_f51Dn2PxiJerKa9Z34_YNlrLZ0Q&oe=69BFDF4B"}, {"file_name": "ScreenShot_01_42310.png", "id": "1035510867231442", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031378_1035510873898108_3057224764746273782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNpMkMrLEuwQ7kNvwGv3bMz&_nc_oc=Admf7og-a77rzEawt6TaVXLD73SS67WUfj3bg9eHr58mv0Vf6pkHQAMcmOivxjgnKNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWOxiVYjmoVXi6vQGinOOemOKAZsCRv3JCzZPsVnDdUQ&oe=69BFD925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Image - Landscape - 2560x1440.png", "id": "1724728847882935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75272211_1724728857882934_1214432791915465845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hmoo3fyWO8Q7kNvwEOvhm5&_nc_oc=AdllGZQyMoW_kGix2IFdvgH4vlFiavj_hUGoB7i066IIiUvYCivTXnr7sbYMpTFfGe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwROuoGhRtSyxJqeGC-_i6wlnAqZd3f84CE5RytR4gggA&oe=69BFD98B"}, "display_name": "Oxford Medical Simulation", "keywords": [], "long_description": "At Oxford Medical Simulation (OMS), we deliver immersive, virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex scenarios allowing healthcare professionals to learn from experience: practicing more, making fewer mistakes and improving patient care.\n\nLearners are immersed in clinical environments with dynamic, engaging virtual patients in true-to-life clinical scenarios, independent of faculty facilitation. Learners can see multiple patients, conversing, assessing, managing, and engaging with interdisciplinary teams. Learners receive a guided debrief, automated, intelligent feedback, performance metrics, and blended learning. \n\nOMS offers a wide range of standardized, repeatable, flexible, faculty-free scenarios. From ED, med-surg, OB, mental health, and peds to procedures, communication skills, and advanced cardiac life support codes, choose from over 200 scenarios that can be used in VR and on-screen. ", "short_description": "Oxford Medical Simulation delivers immersive virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex clinical scenarios where you can investigate, interpret, and practice your clinical skills, training in world-class patient care without risking lives."}]}, "developer_name": "Oxford Medical Simulation", "developer_privacy_policy_url": "https://www1.oms-app.com/pages/privacy_cookies", "developer_terms_of_service_url": "https://www1.oms-app.com/pages/terms_and_conditions", "publisher_name": "Oxford Medical Simulation", "support_website_url": "https://intercom.help/oxford-medical-simulation/en", "website_url":
{"file_name": "ScreenShot_01_31343.png", "id": "981952515865382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974907_981952519198715_5546388269440267536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGH_IJDp3DAQ7kNvwFGhDvI&_nc_oc=Adnq-RRFHrDqqPtXsVQ7M_EiR95mZjRihQXzvrdf_Yu5t6CwRWOVWdROTMFcjSQVJbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb56auW48PBefVUsRGS5x0YHOCUrM7IdMJrRZdu9gvUw&oe=69B54BEE"}, {"file_name": "ScreenShot_01_879.png", "id": "337019861563320", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_337019864896653_3993836798915940721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjQE8QN2lEgQ7kNvwHgx8CR&_nc_oc=AdlfhTu3MTkS4JoQ0CAYWP_9eHVO3qvUanitwUr3PfEU-Wtq1nL0AAUHhnRZuAJ1AAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrApyn8XBC4e9NwaXof6FT1kqwyZaGAQ0viFvflUF1RQ&oe=69B5602A"}, {"file_name": "ACLS - Eyes.png", "id": "598458138028696", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031384_598458141362029_8070608380969850911_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt5q17M3aroQ7kNvwEgxu4W&_nc_oc=AdlXFQXttqGjSxIPOnkFxFRtMa-2f20Tj5YaDMLFW_UlWZnSZfKq4yvIcYtqkbLi26U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJzICEL9IroKYYfQdR6RCSZE54YHY53H6LLCL-tt-F_Q&oe=69B5534B"}, {"file_name": "ScreenShot_01_42310.png", "id": "1035510867231442", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031378_1035510873898108_3057224764746273782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvyG-5fVcwcQ7kNvwED0WWG&_nc_oc=AdmRnFjgmTsucS7n7JOwo75-ni9Ps3kk8kKFpF39304zpO7sVOvGXMBl_91phgdBxa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxIUj7V7WDZzP1JzflSf9Ig7GS9W9uM0976uIJblpBBQ&oe=69B54D25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Image - Landscape - 2560x1440.png", "id": "1724728847882935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75272211_1724728857882934_1214432791915465845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxRqOLwyKvkQ7kNvwEz1eiR&_nc_oc=AdkbluJfEINRAei-2b3BmlVzuRt1lGTakxnLMCIop7_h9QCZCRQIc9k8LcYMIeYscXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxX5xOmOZSvIR1nlBqHRaTyj56r57NOsf4X7AHUM_sBQ&oe=69B54D8B"}, "display_name": "Oxford Medical Simulation", "keywords": [], "long_description": "At Oxford Medical Simulation (OMS), we deliver immersive, virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex scenarios allowing healthcare professionals to learn from experience: practicing more, making fewer mistakes and improving patient care.\n\nLearners are immersed in clinical environments with dynamic, engaging virtual patients in true-to-life clinical scenarios, independent of faculty facilitation. Learners can see multiple patients, conversing, assessing, managing, and engaging with interdisciplinary teams. Learners receive a guided debrief, automated, intelligent feedback, performance metrics, and blended learning. \n\nOMS offers a wide range of standardized, repeatable, flexible, faculty-free scenarios. From ED, med-surg, OB, mental health, and peds to procedures, communication skills, and advanced cardiac life support codes, choose from over 200 scenarios that can be used in VR and on-screen. ", "short_description": "Oxford Medical Simulation delivers immersive virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex clinical scenarios where you can investigate, interpret, and practice your clinical skills, training in world-class patient care without risking lives."}]}, "developer_name": "Oxford Medical Simulation", "developer_privacy_policy_url": "https://www1.oms-app.com/pages/privacy_cookies", "developer_terms_of_service_url": "https://www1.oms-app.com/pages/terms_and_conditions", "publisher_name": "Oxford Medical Simulation", "support_website_url": "https://intercom.help/oxford-medical-simulation/en", "website_url":
_31343.png", "id": "981952515865382", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974907_981952519198715_5546388269440267536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm1LujhueFUQ7kNvwHdu_0n&_nc_oc=AdrwbonbSHjMtX-cBgHfcy9Vb9_aBrCj5v26GF5F17jfpcaB0WK-lHqv_Rhgo3Qv_3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hroNk1MSz4bylCYpP8Yfq3xgFBCxBdfY78mcsGVLcXA&oe=6A1DAAAE"}, {"file_name": "ScreenShot_01_879.png", "id": "337019861563320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_337019864896653_3993836798915940721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPW3FaypomkQ7kNvwHv7ZDk&_nc_oc=Adpcp9dLnTX9Vk9MqZan3KyU4AhJEpnCKtkvrCf55wU5EuADj7Z1rtvUsToeOnzARIw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fH4jyghxlrJdSu_1eeKWrU838zr56d72mwhDqjXMnxg&oe=6A1D86AA"}, {"file_name": "ACLS - Eyes.png", "id": "598458138028696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031384_598458141362029_8070608380969850911_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7ZHKQUT_9YQ7kNvwEI3vb6&_nc_oc=AdpGUgxgAuWLdPbDSlYRbv5HGZfPjquiE3igpMDj_1xP1H3lOjR6Sv4Kzdmtv7q-Iso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JvjwqmQv6Z7M173-O_agOIPN7_gmuFS_S9Uy0oc2TuQ&oe=6A1D79CB"}, {"file_name": "ScreenShot_01_42310.png", "id": "1035510867231442", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031378_1035510873898108_3057224764746273782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FaGBC5SIREgQ7kNvwF1pVPm&_nc_oc=Adr3yr9GRrYDiWXQkEE0tIXYkpwHKxGi55oCewVvXgsRf8EJbDO5RmZLADJ3DOyNLYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xiquuBTcJwwNv-wGrs4VKb9aGkf5fNi9zqjv-SHPJyw&oe=6A1DABE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Image - Landscape - 2560x1440.png", "id": "1724728847882935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75272211_1724728857882934_1214432791915465845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYO4TDDZs8IQ7kNvwHH82IP&_nc_oc=AdqIzPxPa6PsH42iIuxIiQQ4_90lVcwuQPPp7gQ284iw_iKqSBAiYl2RTjmNrWthNqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x8SqUB57WnMvFyrGmOKEUn4TkLEHhkYkL88Nlaq33Yw&oe=6A1DAC4B"}, "display_name": "Oxford Medical Simulation", "keywords": [], "long_description": "At Oxford Medical Simulation (OMS), we deliver immersive, virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex scenarios allowing healthcare professionals to learn from experience: practicing more, making fewer mistakes and improving patient care.\n\nLearners are immersed in clinical environments with dynamic, engaging virtual patients in true-to-life clinical scenarios, independent of faculty facilitation. Learners can see multiple patients, conversing, assessing, managing, and engaging with interdisciplinary teams. Learners receive a guided debrief, automated, intelligent feedback, performance metrics, and blended learning. \n\nOMS offers a wide range of standardized, repeatable, flexible, faculty-free scenarios. From ED, med-surg, OB, mental health, and peds to procedures, communication skills, and advanced cardiac life support codes, choose from over 200 scenarios that can be used in VR and on-screen. ", "short_description": "Oxford Medical Simulation delivers immersive virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex clinical scenarios where you can investigate, interpret, and practice your clinical skills, training in world-class patient care without risking lives."}]}, "developer_name": "Oxford Medical Simulation", "developer_privacy_policy_url": "https://www1.oms-app.com/pages/privacy_cookies", "developer_terms_of_service_url": "https://www1.oms-app.com/pages/terms_and_conditions", "publisher_name": "Oxford Medical Simulation", "support_website_url": "https://intercom.help/oxford-medical-simulation/en", "website_url": "https://oxfordmedicalsimulation.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION", "MEDICINE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "607400554040746"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1029887807918414"}]}, "baseline_offer": {"id": "1029887807918414"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1659301200, "status": "PUBLISHED", "id": "1029887807918414"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26743516735286291", "version": "11.4.20260409"}, "id": "1434642690239296", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4285940041470614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26743516735286291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1434642690239296"}]}, "change_log": "This release includes new features and enhancements to deliver several new scenarios, including new Leader Rounding, SBAR, Bedside Shift-to-Shift, Telemetry, and OB scenarios.\n\n\nKey changes include:\n\n- Improvements to the voice interaction experience to use LLMs to better interpret and respond to longer learner responses containing multiple intents and provide more targeted feedback for complex communication skills. \n\n- Introduction of an author-editable whiteboard to support the presentation of clinical context and facilitate realistic, day-to-day healthcare communication. \n\n- New telemetry environment and multipatient telemetry monitoring. \n\n- Additional assets and changes to environments have been added in preparation for new scenarios in Telemetry, OR, and OB contexts. \n\n- Upgraded to Unity 6000.0.67f1 this ensures the latest security patches are in place and provides a stable foundation for future performance. \n\n- Some minor performance and usability improvements are included. \n\n\nAll pre-existing OMS scenarios are expected to remain compatible with this release.", "created_date": 1776288281, "id": "26743516735286291", "version": "11.4.20260409", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26743509478620350"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4285940041470614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26743516735286291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1434642690239296"}]}, "change_log": "This release includes new features and enhancements to deliver several new scenarios, including new Leader Rounding, SBAR, Bedside Shift-to-Shift, Telemetry, and OB scenarios.\n\n\nKey changes include:\n\n- Improvements to the voice interaction experience to use LLMs to better interpret and respond to longer learner responses containing multiple intents and provide more targeted feedback for complex communication skills. \n\n- Introduction of an author-editable whiteboard to support the presentation of clinical context and facilitate realistic, day-to-day healthcare communication. \n\n- New telemetry environment and multipatient telemetry monitoring. \n\n- Additional assets and changes to environments have been added in preparation for new scenarios in Telemetry, OR, and OB contexts. \n\n- Upgraded to Unity 6000.0.67f1 this ensures the latest security patches are in place and provides a stable foundation for future performance. \n\n- Some minor performance and usability improvements are included. \n\n\nAll pre-existing OMS scenarios are expected to remain compatible with this release.", "created_date": 1774956240, "id": "26577101111927855", "version": "11.4.20260330", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26577098408594792"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4285940041470614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26743516735286291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774534266, "id": "26525614253743208", "version": "11.4.20260325", "version_code": 39, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26525609167077050"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4285940041470614", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26743516735286291"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null
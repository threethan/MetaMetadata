{"file_name": "ScreenShot_01_31343.png", "id": "981952515865382", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974907_981952519198715_5546388269440267536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLV9MpCF2f8Q7kNvwHtnpN1&_nc_oc=AdkBwYcFSRhxnjFmVNxKe-QN7SoxAc52ZEZWoL4CsBHLcSSL5JUTLeo_KCjdel00jos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8L5LRCmPoxuZ_dPoYJndlrbOCRk4nqKPLHD1UC5Qv0A&oe=69B005EE"}, {"file_name": "ScreenShot_01_879.png", "id": "337019861563320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_337019864896653_3993836798915940721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzXYuCYkQpcQ7kNvwHy_31z&_nc_oc=AdkDdR-_l984C_mtLIyB8n3IoC2LNbgdfO2HZU1cZygKA9-2M2-_yZa0-1DyXDmLuN8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1kuQRcbsprNlAOWasJHKFSbFnqjgBXRGaExovRTTW7w&oe=69B01A2A"}, {"file_name": "ACLS - Eyes.png", "id": "598458138028696", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031384_598458141362029_8070608380969850911_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKQ8bAgcTEAQ7kNvwEH37GT&_nc_oc=AdmWzpgb-Sm0J5z9YT9fcVb9wi_iH8DVf-cg-o6r2tkU7nfNq2a-zO4QTveTJhGO8lI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS_wdGDvPYtQiArmPmMwl94nIuAz5j91Julk6OhlV2ag&oe=69B00D4B"}, {"file_name": "ScreenShot_01_42310.png", "id": "1035510867231442", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031378_1035510873898108_3057224764746273782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mk6IebV8_EQ7kNvwHmcJ2I&_nc_oc=AdkKxuT3i6b08apIRZyW4ytc1BNwz41DPGO-o06ClBNXHmKwJ70f-tQrfjvxS2AcEkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsoPmZXw2gGWX_ula1CaF7du83MuGo9_M6ZpK0J7jFcw&oe=69B00725"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Image - Landscape - 2560x1440.png", "id": "1724728847882935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272211_1724728857882934_1214432791915465845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttGTVfnfresQ7kNvwH1fXjx&_nc_oc=AdlyvzM5WRjC2E3LhaQAoKyGtlRlcEyCYrnbRwfi6eBSLXsUfLJlpWrxcO1tN5oIwZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQIVGz_fYM6zKoBB83HrgTbzxudRCMbGqFkIc1ExpeKg&oe=69B0078B"}, "display_name": "Oxford Medical Simulation", "keywords": [], "long_description": "At Oxford Medical Simulation (OMS), we deliver immersive, virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex scenarios allowing healthcare professionals to learn from experience: practicing more, making fewer mistakes and improving patient care.\n\nLearners are immersed in clinical environments with dynamic, engaging virtual patients in true-to-life clinical scenarios, independent of faculty facilitation. Learners can see multiple patients, conversing, assessing, managing, and engaging with interdisciplinary teams. Learners receive a guided debrief, automated, intelligent feedback, performance metrics, and blended learning. \n\nOMS offers a wide range of standardized, repeatable, flexible, faculty-free scenarios. From ED, med-surg, OB, mental health, and peds to procedures, communication skills, and advanced cardiac life support codes, choose from over 200 scenarios that can be used in VR and on-screen. ", "short_description": "Oxford Medical Simulation delivers immersive virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex clinical scenarios where you can investigate, interpret, and practice your clinical skills, training in world-class patient care without risking lives."}]}, "developer_name": "Oxford Medical Simulation", "developer_privacy_policy_url": "https://www1.oms-app.com/pages/privacy_cookies", "developer_terms_of_service_url": "https://www1.oms-app.com/pages/terms_and_conditions", "publisher_name": "Oxford Medical Simulation", "support_website_url": "https://intercom.help/oxford-medical-simulation/en", "website_url":
{"file_name": "ScreenShot_01_31343.png", "id": "981952515865382", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974907_981952519198715_5546388269440267536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X14zD0_TrVUQ7kNvwH4N8au&_nc_oc=Adm18LAIKJJhr51ucJWxrJ5zqWBtBtA7XEJB6E432euaPIprR1lzvNIdXLkLI_Plm50&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJjbyTYqFgzhOfEEs6IRgS2fIlXnDrOHBN81G6f-xVZQ&oe=69BBE36E"}, {"file_name": "ScreenShot_01_879.png", "id": "337019861563320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974677_337019864896653_3993836798915940721_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL54MhMvaAMQ7kNvwEOhiZ2&_nc_oc=AdnR9pOxwt04qopd0vLN_5cGS8YIRJ9d_c25h86mAMD9a4WXx7tg8eR-D7bbgPDSoUo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGlt2f-2thOuaH0naWrXHlv4YiXGQjvUxUa-6zB5XDrw&oe=69BBF7AA"}, {"file_name": "ACLS - Eyes.png", "id": "598458138028696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031384_598458141362029_8070608380969850911_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ba_PDa3lfd0Q7kNvwE61GFm&_nc_oc=AdlIygloWS2Cn-Xvqu64D7qSsry_I5Ea96g36ZwOPAFPz3k82ZVvGcEdbsneXttXpSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzssjANlsVtJgrrTk9kq0JKfp-g6BQxurwXL7jXSSrFsQ&oe=69BBEACB"}, {"file_name": "ScreenShot_01_42310.png", "id": "1035510867231442", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031378_1035510873898108_3057224764746273782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg8WdSz1iLAQ7kNvwFQwhsv&_nc_oc=Admb9gcJk6fcOc72Ri0q0jhqFgTbsi6fulXcLihPLXBAUwftA4f9TNU2sPqgGk9rqns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5OQNo7Pxb-awJoM7f962vng0iPQYilHdNcQaaJ3TOfw&oe=69BBE4A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App Lab Image - Landscape - 2560x1440.png", "id": "1724728847882935", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75272211_1724728857882934_1214432791915465845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGiZwq7qGr8Q7kNvwGknPDQ&_nc_oc=AdkG_j8KJTPytE9oKlhPOL19wl3P-4hmxhzP27K5DcswjeCTuinaVVs1jROUsgn9-eg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzq3SYUrU44HmJWPraTq_ftCPWfXub_8-0gaKRa9OVH1w&oe=69BBE50B"}, "display_name": "Oxford Medical Simulation", "keywords": [], "long_description": "At Oxford Medical Simulation (OMS), we deliver immersive, virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex scenarios allowing healthcare professionals to learn from experience: practicing more, making fewer mistakes and improving patient care.\n\nLearners are immersed in clinical environments with dynamic, engaging virtual patients in true-to-life clinical scenarios, independent of faculty facilitation. Learners can see multiple patients, conversing, assessing, managing, and engaging with interdisciplinary teams. Learners receive a guided debrief, automated, intelligent feedback, performance metrics, and blended learning. \n\nOMS offers a wide range of standardized, repeatable, flexible, faculty-free scenarios. From ED, med-surg, OB, mental health, and peds to procedures, communication skills, and advanced cardiac life support codes, choose from over 200 scenarios that can be used in VR and on-screen. ", "short_description": "Oxford Medical Simulation delivers immersive virtual reality clinical experiences on-demand. Our clinically-led approach creates rich, complex clinical scenarios where you can investigate, interpret, and practice your clinical skills, training in world-class patient care without risking lives."}]}, "developer_name": "Oxford Medical Simulation", "developer_privacy_policy_url": "https://www1.oms-app.com/pages/privacy_cookies", "developer_terms_of_service_url": "https://www1.oms-app.com/pages/terms_and_conditions", "publisher_name": "Oxford Medical Simulation", "support_website_url": "https://intercom.help/oxford-medical-simulation/en", "website_url":
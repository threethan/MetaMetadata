52445815_1886160586_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hvUjqMa0oYQ7kNvwH-L-jr&_nc_oc=AdrnKVgdUGidsOC1UnvHCVea5DQS4anq1wsBDWhDNrdRHpeG85o2tFolaUhEwbuS0iI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME_Dee2kHlCzD9-CsMCpJg7NUAJJHhJM6u0EBFnh6A9g&oe=6AC4F3F8"}, {"file_name": "migrated_image.png", "id": "524436235157929", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602239_561658314027007_494878862_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HITua_xN0WUQ7kNvwGP2x4L&_nc_oc=AdpOpkJf-Hjtbzty6yIdajq-RHZ_WT12W0HuIttgAicAlv0ZTaRfecxrxjmYRprezNg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGjOAZJsbjwp5ixboG1onhxgKDSzFI3nbCrVZKx_GdBw&oe=6AC503A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Stalker", "keywords": ["space", "action", "shooter", "star", "wars"], "long_description": "Space Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay.\n\nNavigate your ship, avoid and destroy various  traps and enemies, hunt for mysterious artefacts, survive  deadly chases using different weapons and tactics, grab your rewards and upgrade ship to get ready for next challenges - plenty of exciting gameplay mechanics creating ultimate VR-experience. Travel through beautiful atmospheric locations and complete exciting space stalker story!", "short_description": "Open space is full of danger, and space stalkers are to face that danger!\n\nSpace Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay."}, {"images": {"nodes": []}, "id": "725337477872448", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Stalker", "keywords": ["netflix", "fear", "vr", "race", "fun"], "long_description": "Space Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay.\n\nNavigate your ship, avoid and destroy various  traps and enemies, hunt for mysterious artefacts, survive  deadly chases using different weapons and tactics, grab your rewards and upgrade ship to get ready for next challenges - plenty of exciting gameplay mechanics creating ultimate VR-experience. Travel through beautiful atmospheric locations and complete exciting space stalker story!", "short_description": "Open space is full of danger, and space stalkers are to face that danger!\n\nSpace Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.fibrum.com/license", "developer_terms_of_service_url": "http://www.fibrum.com/license", "publisher_name": "FIBRUM", "support_website_url": null, "website_url": "http://fibrum.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "943173036332640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12410280_588280624867757_3329854536469708800_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxFKKqmQcicQ7kNvwF9MUzr&_nc_oc=Adovn8mmhap2M8YOGWxQ-dPgFr9YPU5UWPleeqASrEYX1cuCALNI1uSBZOgazcZWSSk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFtbV_VQo2tTlpEOYb84F71yulroJG56lzjyUR5xi3wA&oe=6AC51579"}, "is_concept": false, "is_t
52445815_1886160586_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnXbKjirqCAQ7kNvwEHFABo&_nc_oc=AdrD9B9-K8CnK21RtWbicuHpm8Iaz09TRnAkAyLQ9jHbT9oHh5VuwNx2BW8P8uDOJdU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93POxq_049pTja0MH0ijRg3BpoEq-zDNkAmA2tKQjCHQ&oe=6A26BFF8"}, {"file_name": "migrated_image.png", "id": "524436235157929", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12602239_561658314027007_494878862_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JduUxd-weAQ7kNvwGplPZI&_nc_oc=Adr0an6_e5DH2XMZUcSr1h35DjI_V8XcXW-G--VcpDW7SCM0H78F9TETm4knznKjNQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8siVqIQc61LQkZjA7uZHe_nWIJt3QQON_dcm4I1tel7w&oe=6A26CFA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Stalker", "keywords": ["space", "action", "shooter", "star", "wars"], "long_description": "Space Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay.\n\nNavigate your ship, avoid and destroy various  traps and enemies, hunt for mysterious artefacts, survive  deadly chases using different weapons and tactics, grab your rewards and upgrade ship to get ready for next challenges - plenty of exciting gameplay mechanics creating ultimate VR-experience. Travel through beautiful atmospheric locations and complete exciting space stalker story!", "short_description": "Open space is full of danger, and space stalkers are to face that danger!\n\nSpace Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay."}, {"images": {"nodes": []}, "id": "725337477872448", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Stalker", "keywords": ["netflix", "fear", "vr", "race", "fun"], "long_description": "Space Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay.\n\nNavigate your ship, avoid and destroy various  traps and enemies, hunt for mysterious artefacts, survive  deadly chases using different weapons and tactics, grab your rewards and upgrade ship to get ready for next challenges - plenty of exciting gameplay mechanics creating ultimate VR-experience. Travel through beautiful atmospheric locations and complete exciting space stalker story!", "short_description": "Open space is full of danger, and space stalkers are to face that danger!\n\nSpace Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.fibrum.com/license", "developer_terms_of_service_url": "http://www.fibrum.com/license", "publisher_name": "FIBRUM", "support_website_url": null, "website_url": "http://fibrum.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "943173036332640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12410280_588280624867757_3329854536469708800_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrqstOnXaLQQ7kNvwEZjP_u&_nc_oc=AdrWBSMF3Zu1gfGeizmd-kCzdCEvmJX8sEgwrdoAb2Uwch2NGgj2P3TjVezFOUJW5JU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uyX8mjbhtdgWtcMAr5RV8NxgIXF2FGjYwPz2ajhDHKQ&oe=6A26E179"}, "is_concept": false, "is_t
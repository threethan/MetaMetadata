52445815_1886160586_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzNsWCUaB3cQ7kNvwG9BHTd&_nc_oc=AdrsMf37x_Ky-0eKhsD36_P0GvXDgM4zZWVkrZTJ1r5ur4LJxiVkaXTuysJcbCbYhHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH0Vg6tGcPT5qOKYpCnFv7HEuEobfjGQV22JKVCCmecA&oe=6A89A078"}, {"file_name": "migrated_image.png", "id": "524436235157929", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602239_561658314027007_494878862_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNVju_tWHn0Q7kNvwFnyWkR&_nc_oc=AdqKHQlqvLT9laaBtcpLLOUkpt4Opfi-v5wSKo0kOCifCRZWhaU_puSj-qqlo-rw5a8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeBE6bWwcllqMKx__xzu9HwH3oengJDmT5uxCE7Q8Y4A&oe=6A8977E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Stalker", "keywords": ["space", "action", "shooter", "star", "wars"], "long_description": "Space Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay.\n\nNavigate your ship, avoid and destroy various  traps and enemies, hunt for mysterious artefacts, survive  deadly chases using different weapons and tactics, grab your rewards and upgrade ship to get ready for next challenges - plenty of exciting gameplay mechanics creating ultimate VR-experience. Travel through beautiful atmospheric locations and complete exciting space stalker story!", "short_description": "Open space is full of danger, and space stalkers are to face that danger!\n\nSpace Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay."}, {"images": {"nodes": []}, "id": "725337477872448", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Stalker", "keywords": ["netflix", "fear", "vr", "race", "fun"], "long_description": "Space Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay.\n\nNavigate your ship, avoid and destroy various  traps and enemies, hunt for mysterious artefacts, survive  deadly chases using different weapons and tactics, grab your rewards and upgrade ship to get ready for next challenges - plenty of exciting gameplay mechanics creating ultimate VR-experience. Travel through beautiful atmospheric locations and complete exciting space stalker story!", "short_description": "Open space is full of danger, and space stalkers are to face that danger!\n\nSpace Stalker VR is mobile virtual reality sci-fi shooter-adventure game with cutting-edge visuals and immersive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.fibrum.com/license", "developer_terms_of_service_url": "http://www.fibrum.com/license", "publisher_name": "FIBRUM", "support_website_url": null, "website_url": "http://fibrum.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "943173036332640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410280_588280624867757_3329854536469708800_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TguckKqHZgQ7kNvwE-h0EG&_nc_oc=Adp3sSmpKOwQq7HpqMS7AnVU9Hde4YIgDS6KSmKOW0vxxEcwaK7yRLSsEE7mObgAXb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrHNR8ORLGaDcNFufbs25e23xdbyM4LN3hfE7aZd3AAg&oe=6A8989B9"}, "is_concept": false, "is_t
0f&oh=00_AQETUf-2nSMMFDIfh02dF01LRJTSQHCjae5MFEGb4sEhHA&oe=6A8D8510"}, {"file_name": "M3.png", "id": "980503850316320", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982480_980503853649653_4480502916857009795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0rajRDwOAkQ7kNvwGdbKYi&_nc_oc=AdoC_qIWLD5ZofGzGJpD-MKhd6hTjZfthm189Xe1I7PACzlIrwW3L-faSzBt3LFsAig&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpva79qq8gc6iFNYG0kW8-yYLN0abAxqJWeT_64RGN-g&oe=6A8D9915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P1.png", "id": "1524334651830823", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75223475_1524334655164156_5919903215483884694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9_LL-u_88cQ7kNvwEHrX7f&_nc_oc=AdrP9GNM0tF1VjJpiww2SmYTetVSX705vhSfpal_AxE1n1SHXZMhsy0zgt7iWF6fP20&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGJVwJuilDwQgWJz2eAjPaWBc9pcdLHUl0tddkSBHlfQ&oe=6A8D8778"}, "display_name": "Mimadim", "keywords": [], "long_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D. With a wide range of colors, patterns, and designs to choose from, you can easily experiment with different combinations to find the perfect look for your space.\n\nProduct Features:\n\n- Easy-to-use interface for seamless design exploration.\n\n- Wide selection of ceramic tiles and house tiles to choose from.\n\n- Realistic 3D rendering for a true-to-life visualization.\n\n- Customize tile layouts and patterns to suit your preferences.\n\n- Save and share your designs with others for feedback.\n\n- Perfect for homeowners, interior designers, and tile manufacturers.\n\n- Enhance your design process and make confident decisions about tile selection.\n\n- Experience your space in a whole new way with Mimadim Visualize.", "short_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mimadim.co.il/PPolicy_English.html", "developer_terms_of_service_url": null, "publisher_name": "Mimadim - Tiran Naor", "support_website_url": null, "website_url": "http://www.mimadim.co.il/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8545097775517925"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24698018526465926", "version": "1.7"}, "id": "895832192312514", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8545097758851260", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24698018526465926"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "895832192312514"}]}, "change_log": null, "created_date": 1747648268, "id": "24698018526465926", "version": "1.7", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_resu
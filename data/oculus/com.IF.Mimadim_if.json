Zhn28cbscCbRYH2PEGfgxm8zwF-20m-C9sqwFmoA1gg&oe=6AD24B50"}, {"file_name": "M3.png", "id": "980503850316320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_980503853649653_4480502916857009795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjXBdKlKRqsQ7kNvwE_-xxZ&_nc_oc=AdqewJLZryrAtkZQpzEj8dTNWTkxFq9grmdVT-rNRPBfM0GFuyPH2ImayWMxaaP1vmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCTjfUXMVFJ0EKmwJcN00F4olW7UknegcE7XivHzfe9Q&oe=6AD22715"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P1.png", "id": "1524334651830823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223475_1524334655164156_5919903215483884694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c85kOUQ5Yt8Q7kNvwHj_QpU&_nc_oc=Ado9gFQ0yLrRPZoiZp-DXCCqOkBMazQD85yD9uTzBZVf5JyDaxJxcAHhKkYufmfOjsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE4pkczNG_gEORy_7dmgevLQdyInkDdwJr3MO-SuA70A&oe=6AD24DB8"}, "display_name": "Mimadim", "keywords": [], "long_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D. With a wide range of colors, patterns, and designs to choose from, you can easily experiment with different combinations to find the perfect look for your space.\n\nProduct Features:\n\n- Easy-to-use interface for seamless design exploration.\n\n- Wide selection of ceramic tiles and house tiles to choose from.\n\n- Realistic 3D rendering for a true-to-life visualization.\n\n- Customize tile layouts and patterns to suit your preferences.\n\n- Save and share your designs with others for feedback.\n\n- Perfect for homeowners, interior designers, and tile manufacturers.\n\n- Enhance your design process and make confident decisions about tile selection.\n\n- Experience your space in a whole new way with Mimadim Visualize.", "short_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic
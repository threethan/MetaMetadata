ontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982480_980503853649653_4480502916857009795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBK46aGbHVoQ7kNvwFIUOxJ&_nc_oc=Adq7lTY97p3sYBuuJC-WfpvW0SDuDzMBv1lrYHDvVlziMdqiQazek-8hkOI5ol0KPz8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CeqXHlnS8E3QN-ZvI_XNFNInSkUktb_-3Md32l3txxg&oe=69EF6515"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P1.png", "id": "1524334651830823", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223475_1524334655164156_5919903215483884694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeZHknZXa2gQ7kNvwHlJB_K&_nc_oc=AdporBSkE-ZJNnp-hcad1Pk4IqIjy9Rljs-bvG9LXYUXiPKfohIo_wPeXvda2R_2w9c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3uNDvUY5Jzg6p2Nq0jHEZKXOoOKGCTpthfOp8NB5dneg&oe=69EF5378"}, "display_name": "Mimadim", "keywords": [], "long_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D. With a wide range of colors, patterns, and designs to choose from, you can easily experiment with different combinations to find the perfect look for your space.\n\nProduct Features:\n\n- Easy-to-use interface for seamless design exploration.\n\n- Wide selection of ceramic tiles and house tiles to choose from.\n\n- Realistic 3D rendering for a true-to-life visualization.\n\n- Customize tile layouts and patterns to suit your preferences.\n\n- Save and share your designs with others for feedback.\n\n- Perfect for homeowners, interior designers, and tile manufacturers.\n\n- Enhance your design process and make confident decisions about tile selection.\n\n- Experience your space in a whole new way with Mimadim Visualize.", "short_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.
x7JhevF-wFJCFmFg4suRxYA5ZeKO35vrq8bKhgSHjPw&oe=6A3C0050"}, {"file_name": "M3.png", "id": "980503850316320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_980503853649653_4480502916857009795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsMCwOAyZTQQ7kNvwHo40RS&_nc_oc=AdrBDC6aqUUy_wTmFd6FNA_gOB30fhQJjmCcyAxhIH-daIbvP0qwypIXxlo-qJCiudw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v29AKoDEgsb2N6Si_1QnAfU6re_CwxaPV1uTQNA_1TQ&oe=6A3BDC15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P1.png", "id": "1524334651830823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223475_1524334655164156_5919903215483884694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_Zjx7XaMYYQ7kNvwEq87Zi&_nc_oc=AdqMAEYCwbJ2PDF0VeSaQSOUZOHzhz---wNzntUkrYr0TA8zm0KadvV8t2sG1U1NSTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EI19ZbgC6Laf2gHdJSH4CvsHdUiFLbCeruHlvdOMF8A&oe=6A3C02B8"}, "display_name": "Mimadim", "keywords": [], "long_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D. With a wide range of colors, patterns, and designs to choose from, you can easily experiment with different combinations to find the perfect look for your space.\n\nProduct Features:\n\n- Easy-to-use interface for seamless design exploration.\n\n- Wide selection of ceramic tiles and house tiles to choose from.\n\n- Realistic 3D rendering for a true-to-life visualization.\n\n- Customize tile layouts and patterns to suit your preferences.\n\n- Save and share your designs with others for feedback.\n\n- Perfect for homeowners, interior designers, and tile manufacturers.\n\n- Enhance your design process and make confident decisions about tile selection.\n\n- Experience your space in a whole new way with Mimadim Visualize.", "short_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic
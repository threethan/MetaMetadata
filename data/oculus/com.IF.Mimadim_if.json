ontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982480_980503853649653_4480502916857009795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zdpNivSyEQQ7kNvwH1awzT&_nc_oc=Adq4ESFFAcVSoQmobFW9FodTNQFQ57aRHHx8frXmxdWr4uV4PfBiGmJgd1ppvSrMMe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SbJ-GipRbzmXOPZr7OUnzWLIGPLieBwqCwcqo_-s8nQ&oe=69DE4195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "P1.png", "id": "1524334651830823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223475_1524334655164156_5919903215483884694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRxxO_tPR_QQ7kNvwH-Agyy&_nc_oc=Adqs600DS6X4SzIjX0xNzBgtZIAUfyfEm4ech0jAo5Kg1hGTYY8umPN_DlKHK4fkm5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00pYLvAX40YS3G9qKTvylAIIPYEvrT6v191n-u_rmasQ&oe=69DE2FF8"}, "display_name": "Mimadim", "keywords": [], "long_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D. With a wide range of colors, patterns, and designs to choose from, you can easily experiment with different combinations to find the perfect look for your space.\n\nProduct Features:\n\n- Easy-to-use interface for seamless design exploration.\n\n- Wide selection of ceramic tiles and house tiles to choose from.\n\n- Realistic 3D rendering for a true-to-life visualization.\n\n- Customize tile layouts and patterns to suit your preferences.\n\n- Save and share your designs with others for feedback.\n\n- Perfect for homeowners, interior designers, and tile manufacturers.\n\n- Enhance your design process and make confident decisions about tile selection.\n\n- Experience your space in a whole new way with Mimadim Visualize.", "short_description": "Mimadim Visualize is a cutting-edge software that allows you to visualize ceramic tiles and house tiles on your walls in stunning 3D."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.
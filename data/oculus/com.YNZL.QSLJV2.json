_trailer_thumbnail": {"file_name": "\u5ba3\u4f20\u56fe02 1440.png", "id": "1427294908501135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310896_1427294911834468_6464866751825739763_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8F8U8mgOvMQ7kNvwHQFZFt&_nc_oc=AdoqX8XK77GsbHlsx3mfVAYN00a-bWtIi7aSwU7vCj5eCsU7aFdvGBginUKbHQmlc_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hgJd77i3Z6h3kPgBjLKj0BcNpu_tvSs1KItB8F1FsXg&oe=6A295406"}, "display_name": "\u4e91\u8fd9\u91cc\u00b7\u542f\u4e16\u7075\u5883GISHERE", "keywords": [], "long_description": "\u524d\u5f80\u865a\u62df\u4e16\u754c\uff0c\u4f53\u9a8c\u81ea\u7136\u666f\u89c2 \uff0c\u6b22\u8fce\u6765\u5230\u201d\u542f\u4e16\u7075\u955c\u201c\u65f6\u7a7a\u7a7f\u8d8a\u4e4b\u95e8\uff0c\u6211\u4eec\u5c06\u524d\u5f80\u591a\u4e2a\u4e0d\u540c\u751f\u6001\u79d8\u5883\uff0c\u4e0e\u573a\u666f\u4e2d\u7684\u73cd\u7a00\u52a8\u690d\u7269\u8fdb\u884c\u6df1\u5ea6\u4e92\u52a8\uff0c\u611f\u53d7\u8d85\u8d8a\u73b0\u5b9e\u7684\u5947\u5e7b\u65c5\u7a0b\u3002\n\u8ba9\u6211\u4eec\u7a7f\u8d8a\u7684\u5239\u90a3\uff0c\u6539\u53d8\u4e16\u754c\u7684\u7ef4\u5ea6\u3002\uff08\u4e3a\u4e86\u8ba9\u4f60\u7684\u4f53\u9a8c\u7a7a\u95f4\u66f4\u5e7f\u9614\uff0c\u6211\u4eec\u5173\u95ed\u4e86\u8fb9\u754c\uff0c\u8bf7\u6ce8\u610f\u4f60\u5728\u73af\u5883\u4e2d\u6240\u5904\u7684\u4f4d\u7f6e\u518d\u8fdb\u5165\u7a7f\u8d8a\u95e8\uff09Embark on a journey to the virtual world and experience natural landscapes. Welcome to the \"Qishi Lingjing\" portal of time and space travel. We will visit multiple different ecological secrets, interact deeply with rare animals and plants in the scenes, and experience a fantastic journey beyond reality.\nLet us cross the moment and change the dimensions of the world. (In order to broaden your experience space, we have closed the boundaries. Please pay attention to your position in the environment before entering the portal.)", "short_description": "\u524d\u5f80\u865a\u62df\u4e16\u754c\uff0c\u4f53\u9a8c\u81ea\u7136\u666f\u89c2\uff08\u4e3a\u4e86\u8ba9\u4f60\u7684\u4f53\u9a8c\u7a7a\u95f4\u66f4\u5e7f\u9614\uff0c\u6211\u4eec\u5173\u95ed\u4e86\u8fb9\u754c\uff0c\u8bf7\u6ce8\u610f\u4f60\u5728\u73af\u5883\u4e2d\u6240\u5904\u7684\u4f4d\u7f6e\u518d\u8fdb\u5165\u7a7f\u8d8a\u95e8\uff09\nGo to the virtual world and experience the natural scenery (in order to make your experience space wider, we have closed the boundaries, please pay attention to your position in the environment before entering the portal)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yngishere.com/?page_id=44348", "developer_terms_of_service_url": null, "publisher_name": "\u4e91\u5357\u8fd9\u91cc\u4fe1\u606f\u6280\u672f\u6709\u9650\u516c\u53f8", "support_website_url": null, "website_url": "http://www.yngishere.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24765832589700854"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620444_697004236362934_6089224710597431532_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngKlY0YV59IQ7kNvwHeZE-g&_nc_oc=AdruhYZqpfxMkMWwLuEGsHSOQhiAt8B6FG6sntfDbbu0L16aQeSAX6jgjTcYSWqJQPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MTz00ugx9QErY0KqyjQQ1hd02v9wecTTF2O5lxDcWmA&oe=6A29879F"}, "is_concept": false, "is_test": false, "is_tri
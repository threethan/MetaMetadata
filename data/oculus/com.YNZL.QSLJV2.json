\u81ea\u7136\u666f\u89c2\uff08\u4e3a\u4e86\u8ba9\u4f60\u7684\u4f53\u9a8c\u7a7a\u95f4\u66f4\u5e7f\u9614\uff0c\u6211\u4eec\u5173\u95ed\u4e86\u8fb9\u754c\uff0c\u8bf7\u6ce8\u610f\u4f60\u5728\u73af\u5883\u4e2d\u6240\u5904\u7684\u4f4d\u7f6e\u518d\u8fdb\u5165\u7a7f\u8d8a\u95e8\uff09\nGo to the virtual world and experience the natural scenery (in order to make your experience space wider, we have closed the boundaries, please pay attention to your position in the environment before entering the portal)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yngishere.com/?page_id=44348", "developer_terms_of_service_url": null, "publisher_name": "\u4e91\u5357\u8fd9\u91cc\u4fe1\u606f\u6280\u672f\u6709\u9650\u516c\u53f8", "support_website_url": null, "website_url": "http://www.yngishere.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN", "zh_HK", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24765832589700854"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620444_697004236362934_6089224710597431532_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx8eAjRZuJ4Q7kNvwHuNnIf&_nc_oc=AdrsfWNj0qQx_d6Hj3TPcPuF_zmNqp4_-r4WB8Ft05zZCWru3MUpkxgelu5tGJfMFQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdSoA5WMkwuEgRH8KdRvQSA8gxdNg1mp8oc9Y8r9zOVQ&oe=6A5773DF"}, "is_concept": false, "is_test": false, "is_tri
KNN2NfykG4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af894YuzWpTo0__Y5q17oFRUiHFC6xa8C6RUbzBq-wWASw&oe=6A36C50D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440_32bit.png", "id": "458129080179631", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/428937943_458129083512964_6569944225846957464_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7FRcd0wwCcQ7kNvwGEGCB0&_nc_oc=Adqdg1_8NIcDca5yohWyajEIKBR7jc0VdjZsoJUtaVqvjKuSugupAGoUPi_N7xhOgHY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4VmF3TnJ1gnvYHTIAfpZJxVUTiOz45a25bk3dpFPd-g&oe=6A369E17"}, "display_name": "Bounce Arcade", "keywords": ["pinball", "arcade", "bounce", "velan"], "long_description": "Enter the machine and play pinball like you've never seen before in Bounce Arcade!\n\nWield your hands as paddles, guiding the ball through a series of immersive pinball worlds, each with their own challenges and surprises.\n\nNostalgic and frantic elements of classic pinball join all-new skills for a fast-paced arcade experience. Use a tractor beam to attract the ball back to you, and use a controllable lasso to nudge the ball where you want it to go for the ultimate skill shots (if you can master them).\n\nEach world brings its own unique mini-games to the table. In a dusty western town, your paddles transform into pistols for a shooting gallery. In a futuristic space station, use the ball to break up asteroids that enter the docking bay.\n\nExperience chaotic pinball action, flipped inside out!", "short_description": "Bounce Arcade is pinball blasted into the future!\n\nEnter the machine and play pinball like you've never seen before! Play through multiple thrilling tables, strive to survive, unlock mini-games, and chase high scores in next-level action gameplay.\n\nBounce Arcade mixes pinball classics like multiball with new mechanics like lassos and mini-games only possible in VR. Enter the zone and keep the ball alive!"}]}, "developer_name": "Velan Studios", "developer_privacy_policy_url": "https://www.velanstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Velan Studios", "support_website_url": null, "website_url": "https://www.velanstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6641604625958125"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "8533865693327836"}, {"status": "PUBLISHED", "id": "1306561480348482"}, {"status": "PUBLISHED", "id": "4315122448755277"}, {"status": "PUBLISHED", "id": "1461667125612317"}, {"status": "PUBLISHED", "id": "1253064956786163"}, {"status": "PUBLISHED", "id": "1253214090018002"}, {"status": "PUBLISHED", "id": "816043268121324"}, {"status": "PUBLISHED", "id": "2595799580799624"}, {"status": "PUBLISHED", "id": "1212078457492197"}, {"status": "PUBLISHED", "id": "736789012517608"}, {"status": "PUBLISHED", "id": "727675373096358"}, {"status": "PUBLISHED", "id": "1396552524850139"}, {"status": "PUBLISHED", "id": "1039155684710879"}, {"status": "PUBLISHED", "id": "2082060075641647"}, {"status": "PUBLISHED", "id": "959677256032284"}, {"status": "PUBLISHED", "id": "1966118740569307"}]}, "baseline_offer": {"id": "2082060075641647"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "4315122448755277"}]}, "live
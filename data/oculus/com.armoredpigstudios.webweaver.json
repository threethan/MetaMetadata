15902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPBz6tW6fmcQ7kNvwFFOY94&_nc_oc=AdqqgjBby6Jk--xa1J7SwdXUXsAgrwC1Imoge48IMc6S0ft_0kAH8EmD1e2fjReiwdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfT3iZlBohq768ir3mr032t6HPgRGFjqZETvYs_EQsLg&oe=6AAA946F"}, {"file_name": "vlcsnap-2026-07-28-21h16m22s227.png", "id": "1028907503371969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1028907506705302_4733710544246166805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAvqEP3AfIsQ7kNvwGyz4MP&_nc_oc=Adonca9TCRTnJlm7iaYnC0DPMfMDk4b4xzdW6E-RDV_6oZ1GJZMxdtK1FrlLsZw9TQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt62pU8Qr4NgTk72OAAhmmP7y0t4CO7TMiubTJz44GBw&oe=6AAABC6D"}, {"file_name": "vlcsnap-2026-07-28-21h14m47s863.png", "id": "1897785034472551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1897785037805884_5940151767079708996_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nV15EhRBesgQ7kNvwGFgBYV&_nc_oc=Ado1ChToZu22HUsH_NXI36CqNaVUuYYtpYLEwFBchapxqGpvQfEIaFiewOUM6TrCPg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQm53d17SWGhx9B-nqv3UdeW44ZWYrp39jI46aRT0Uuw&oe=6AAA9F9C"}, {"file_name": "vlcsnap-2026-07-28-21h15m13s909.png", "id": "1747397439612949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593858738_1747397446279615_3937584290932783368_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1t1rGxjf7UQ7kNvwFSRcvK&_nc_oc=Adr5opUz2SQMB8bJsR_hV5usG4E2zUcyUVbXV6k0EdOHyjcthWktTDRXFPkklE_ztEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5_pvVSI1ozjf8Ib-9vy0O5gpM8XtpLEagEnqcAwMS_A&oe=6AAABA71"}, {"file_name": "vlcsnap-2026-07-28-21h17m47s545.png", "id": "27470374099300173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673536876_27470374109300172_3318935900093651350_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFv4p8Y5dxsQ7kNvwERatBO&_nc_oc=AdqMKu91uo9INNAEuDvgyhd7oLH4Nb6xQi1wYw-xHV7gvz1cMiP-MJJGqJpYUgUO3PM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnjjtJRbJCqPgFqmcwQ1b_Vx94zxYT2fh1Y6RXeKvURg&oe=6AAAAE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGShf3fjlwYQ7kNvwGrKnuj&_nc_oc=Ado5oEgT7Yf5JCZA7jD-c79JVEsJaU8ygqRMD0Rnx-WYqat3FSxKR__aE893qPIGgSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlQPyyhztpz9IxJr_pmcA0kAouS2MOAIFjSjsAFfZCJw&oe=6AAA92F2"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "**WEB WEAVER**\n\nSwing. Flail. Faceplant. Repeat.\n\nGrab a web, launch yourself off a skyscraper, and pray your aim was better than your judgment. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with friends.\n\n{1590796759424065}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n{1566776888280050}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{1045542848436579}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n{2230945841053332}\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1360651905570840"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3455362911311265"}, {"status": "PUBLISHED", "id": "2022096858412168"}, {"status": "PUBLISHED", "id": "1674562976953937"}]}, "baseline_offer": {"id": "2022096858412168"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "3455362911311265"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1379675623668468", "version": ".19"}, "id": "1360180336203268", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1359800928989271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379675623668468"}, "release_status": "RELEASED"}, "binary_releas
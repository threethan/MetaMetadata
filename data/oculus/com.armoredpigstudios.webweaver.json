15902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GKzWF6aWQ8Q7kNvwHYA3EM&_nc_oc=AdpNE31tkVnz9J7Z5xW-yqyB_fSLoO997__lz2I0wxCTXvIv89mEg2u6ifQl5VeL6bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3WgAeYEgvx2fDfTj7OkayNrZyKtnZUHJ7ZKO-yejOYw&oe=6AB12BEF"}, {"file_name": "vlcsnap-2026-07-28-21h16m22s227.png", "id": "1028907503371969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1028907506705302_4733710544246166805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxD4TFqmD70Q7kNvwHfCpc-&_nc_oc=Ado7g2LMzAIwgxmN4M-96PRaYr3s0lSB-tnIJIKnksLVVZe9qVaMZrsQktggJUWK0bQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMC-QRdxijudpHlL2151mAjcXbIGILbMncTraQR9FQ4g&oe=6AB153ED"}, {"file_name": "vlcsnap-2026-07-28-21h14m47s863.png", "id": "1897785034472551", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673573223_1897785037805884_5940151767079708996_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h-avc78SI0Q7kNvwFwf4XS&_nc_oc=AdrjGs9g680eOm0nItCL5hfD4JFE4Ph8LbyheolTg1yq-pwqBccQoNC1_iTV_G1zcso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNp3IMX31CD3Y2IWt9wSrEqwDvZmLSW5u0UUgLFqZ-VQ&oe=6AB1371C"}, {"file_name": "vlcsnap-2026-07-28-21h15m13s909.png", "id": "1747397439612949", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593858738_1747397446279615_3937584290932783368_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-63kZ-d2448Q7kNvwGbgi1B&_nc_oc=AdrffcWQS8Jm8Bz-i2em5rsVvVDiZt-X6IN5XHfLuWQovT6-P55YDAA3m-5WnqgSEyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr8FRgadUReXY5Wh72bQLnpBFxVaBbyt1jU5fXIKHgtw&oe=6AB151F1"}, {"file_name": "vlcsnap-2026-07-28-21h17m47s545.png", "id": "27470374099300173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673536876_27470374109300172_3318935900093651350_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYnn7hi4X10Q7kNvwHv7sh-&_nc_oc=AdooXJj0yWu7wqgZ263_ypMIEpeCpuebqSCfxTmlMXuuogw7aneBH7BSpudmTDRoZqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp1-KuygD-hmakE65ehm1SZzDUpNEJfm60Ae78gwjafA&oe=6AB1459B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UilDWH7JCwAQ7kNvwEjq51R&_nc_oc=AdoKdEd2xbNUEoH4m_uZAyIe_hPmHEUnK2gksMXugP2E8kSmMZ1L36b43WaQcZyf2ZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbAZ_6dg3U3mlS48VS2uiRb-2A9jnECqACfXCSlgV4GA&oe=6AB12A72"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "**WEB WEAVER**\n\nSwing. Flail. Faceplant. Repeat.\n\nGrab a web, launch yourself off a skyscraper, and pray your aim was better than your judgment. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with friends.\n\n{1590796759424065}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n{1566776888280050}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{1045542848436579}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n{2230945841053332}\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1360651905570840"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3455362911311265"}, {"status": "PUBLISHED", "id": "2022096858412168"}, {"status": "PUBLISHED", "id": "1674562976953937"}]}, "baseline_offer": {"id": "2022096858412168"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "3455362911311265"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1379675623668468", "version": ".19"}, "id": "1360180336203268", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1359800928989271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1379675623668468"}, "release_status": "RELEASED"}, "binary_releas
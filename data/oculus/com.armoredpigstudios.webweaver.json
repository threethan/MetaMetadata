2l5HEawOyUL5K9oDarlShqe5B5E-mFNKq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3xlwBttelITT2QOzA4SrS_aJT6WvbMYy7x5524s05ug&oe=6AEDF0FB"}, {"file_name": "S2.png", "id": "1718330439398332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595129854_1718330442731665_3209059799744699982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwV2RpMAAwwQ7kNvwH1ZYdm&_nc_oc=Ado1OS31ih4jSDYK70KOtOPd0uCCQ6IUQm_M8OnGsnYbmnrw007HNT-biHRjNwMss1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOLrcKPPJhlspRO2mV1BuwATSEJ6MCmyrIBtaxP1J_og&oe=6AEE0790"}, {"file_name": "S4.png", "id": "2633254253761629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_2633254257094962_2532184228266596029_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uS8keQRzm4EQ7kNvwEJuTlO&_nc_oc=Adrmpu4RhOOJgDzPxD0jEYvgpqEQGx5PJA6nilajOg0c-gJMHkv1pt2gzHVu6nq_f1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDjRdrz11TNJjxY8_loLg3XzzItaFKKvG4TQ2W-JrFvw&oe=6AEDED97"}, {"file_name": "S5.png", "id": "1109376902037770", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830441_1109376905371103_5052696636826473835_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hptyj7oAQXQQ7kNvwE43Wn8&_nc_oc=AdqGCYWtDxGXbC1hD0P-ajVPxNhvqiaj4u-R751y8Tzg3HezzRaZmcuTU2GvM_wZgHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfTLDkp9NmtgcHDpYJFhQj2EvAA-N-37ZZO3CE52y_AQ&oe=6AEDDF53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Web-Weaver-New.png", "id": "1352395733380838", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1352395736714171_2263927534261243081_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rDBjhD6GAEQ7kNvwENCyXK&_nc_oc=AdpTJWtcUVXluSK8HsUvYtHv-TJqumtAd-yHE5ppctT9i3NFKt6YacVSDUQeT9xA3Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqCNNlrRbY8MQC0Pe-S4ciz0QjljyXVD4i7GGJj6n7Dw&oe=6AEDED1D"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "movement", "superhero"], "long_description": "Swing. Fight. Flip. Repeat.\n\nSwing, flip, fight, and pray your way through an incredible open world and more than 7 campaign levels. Web Weaver is a physics-based web-swinging superhero game where every jump is one bad grip away from glorious disaster. Even better, you can play with your friends.\n\n{1051831694494166}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot. Nail a perfect arc between rooftops and feel like a god. Miss and eat pavement.\n\n{2172536073671077}\n\n**BECOME HERO'S WITH YOUR FRIENDS**\n\n Multiplayer mayhem. Swing together, fight eachother, race through the city, or become city-wide menaces. Everything is better with a squad of web-weavers.\n\n{1894342194877282}\n\n**INSANE COMBAT**\n\nCrazy enemies.  Tenticles.  Grappling.  Experience the most insane VR superhero combat on the market.  Fast gameplay, multiple enemies, and unique Web mechanics make Web-Weaver combat a must play.\n\n**Grab a web. Get moving. Try not to scream.**\n", "short_description": "Become the Web-Weaver in this superhero game!  Experience immersive swinging, intense combat, difficult parkour challenges, and crazy multiplayer fun!"}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
68480_1183970067481375_8052399525008306295_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDo3geF8EfYQ7kNvwHt1kSx&_nc_oc=Ado-o2g6QisQEzruhdnscroBt7bYstlN5VHzXlS2__ZcpSfLYhwqk_SnIdCJvzUDPxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRekpQit_kz9z1A2QHoYMB144D29Ux_1LmVxks48V3jzA&oe=6AFDC2FB"}, {"file_name": "S2.png", "id": "1718330439398332", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1718330442731665_3209059799744699982_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBtu9qn_as0Q7kNvwEz8De-&_nc_oc=AdrbskUlEoq4-WDM5rphMdhFcY58k7vdZKQWv6TzY39a0GWnAQj7Iy6oOVAI_zuk4CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNDTWi-eZVWvURzNTfTuefTgMLR-Y93puw8ZWkiVSN7w&oe=6AFDD990"}, {"file_name": "S4.png", "id": "2633254253761629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_2633254257094962_2532184228266596029_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIpCLelfMOMQ7kNvwGtvP45&_nc_oc=AdpCGl07gbQwsyDJOF3jT8iDA50xnYd2HeqAV6-uCGKUV9S1T8G_JKTEPIx0LFE9Tv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPrpt5Y4AlAJhVRj64Z1F5d4q3UthUpk3Y62Urr2WNkQ&oe=6AFDBF97"}, {"file_name": "S5.png", "id": "1109376902037770", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1109376905371103_5052696636826473835_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tInkIuGzWOIQ7kNvwGriUt2&_nc_oc=AdqudlAP8HO3-MopKYOnnh5VPKOjOdvgfM5lWlC1ak4DUunlmURR0EegcL0wjFMDkws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsnTEhcb2HN2HwMXkO6JIBJnkSat-T-f9k5u88XPYdPQ&oe=6AFDB153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Web-Weaver-New.png", "id": "1352395733380838", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1352395736714171_2263927534261243081_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWEMOhid6usQ7kNvwEfjRm-&_nc_oc=Adpk5rTzAWYbpzHgW-tJrG_BzS0IqsBo1Dp77-a4eXdzPt9yCpDU7IvSasUdxV9g_OU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtIu3vOH_J7AnKip2WpdlwjAzsLMhxD5BLCagN5bdQbQ&oe=6AFDBF1D"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "movement", "superhero"], "long_description": "Swing. Fight. Flip. Repeat.\n\nSwing, flip, fight, and pray your way through an incredible open world and more than 7 campaign levels. Web Weaver is a physics-based web-swinging superhero game where every jump is one bad grip away from glorious disaster. Even better, you can play with your friends.\n\n{1051831694494166}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot. Nail a perfect arc between rooftops and feel like a god. Miss and eat pavement.\n\n{2172536073671077}\n\n**BECOME HERO'S WITH YOUR FRIENDS**\n\n Multiplayer mayhem. Swing together, fight eachother, race through the city, or become city-wide menaces. Everything is better with a squad of web-weavers.\n\n{1894342194877282}\n\n**INSANE COMBAT**\n\nCrazy enemies.  Tenticles.  Grappling.  Experience the most insane VR superhero combat on the market.  Fast gameplay, multiple enemies, and unique Web mechanics make Web-Weaver combat a must play.\n\n**Grab a web. Get moving. Try not to scream.**\n", "short_description": "Become the Web-Weaver in this superhero game!  Experience immersive swinging, intense combat, difficult parkour challenges, and crazy multiplayer fun!"}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"
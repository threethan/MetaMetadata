64.5771-25/491821704_1008564858655959_5977210075793815902_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSOTakr8-iMQ7kNvwHM7I-e&_nc_oc=Adrvs8tEZuSloDzTONon9R-k5YqA_yILTyQzUo_qBK7UcG1w8ErK1hRACKjpRyFT_Zg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmKfm_MjBbn71ktOF71NsPCvIYcMDD_YUP54e5i_AjMA&oe=6AA3FCEF"}, {"file_name": "vlcsnap-2026-07-28-21h16m22s227.png", "id": "1028907503371969", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823351_1028907506705302_4733710544246166805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piJCldLAJrsQ7kNvwFmz_2t&_nc_oc=AdoAhxTaHa7Ghe_XWEAbCox-MoIx1mtQzpBAzhZabaVa8k_Xl2iFBRh4qkEmoRs-8ys&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1mozwK0xKaANomoGdF_iFimdWVMDy71uYMbn3zZpMCA&oe=6AA424ED"}, {"file_name": "vlcsnap-2026-07-28-21h14m47s863.png", "id": "1897785034472551", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/673573223_1897785037805884_5940151767079708996_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWEu7u3cC0EQ7kNvwH_Y-fc&_nc_oc=Adr-xshRWWkUGFUiAl_4HqBWHTUED2e4ojfq03X_VJwwAzIbYj9KFPcLcfSswG7mbOA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKm6UiqMhY0vNgzyT9BB2K4g71mmgjzHpeFksEbpCNsiA&oe=6AA4081C"}, {"file_name": "vlcsnap-2026-07-28-21h15m13s909.png", "id": "1747397439612949", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/593858738_1747397446279615_3937584290932783368_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U03JqCYscG0Q7kNvwGFhhwG&_nc_oc=AdoDoHaNIzrhayNWA0M0Ly5hjyWKoI1Y46Y76QcCL1zHRdbPRB_cPPY1nrMjT5R79tI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSNxM4e17wbjiAjH2d_cxT2jcr59PcFHG4LYISsW0yIg&oe=6AA422F1"}, {"file_name": "vlcsnap-2026-07-28-21h17m47s545.png", "id": "27470374099300173", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/673536876_27470374109300172_3318935900093651350_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrmRvKhTaoIQ7kNvwF5JVmZ&_nc_oc=AdruoJTpY71Cm5lqxb39L0Nw5lArcoFHpI4LMbewsg9ZSQZYBgcsZdAXS4M7XTD5vB4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKTFdL7JFPcNIERxK5vC8cTtbyVj53t5PyAYwgaZPqhg&oe=6AA4169B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EJ__Bjn9GcQ7kNvwFKqZse&_nc_oc=AdrhYYkKp22W_QCXVU5TsnqyBBABgxkh0xlFK2Z9jFxCbvwKpNf8F_iOuxYWiizxeeI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzzcNSrcHE5YRgBEmAAnA-OPBXtP4WJDZCNpFQxU3WPg&oe=6AA3FB72"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "**WEB WEAVER**\n\nSwing. Flail. Faceplant. Repeat.\n\nGrab a web, launch yourself off a skyscraper, and pray your aim was better than your judgment. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with friends.\n\n{1590796759424065}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n{1566776888280050}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{1045542848436579}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n{2230945841053332}\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1360651905570840"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3455362911311265"}, {"status": "PUBLISHED", "id": "2022096858412168"}, {"status": "PUBLISHED", "id": "1674562976953937"}]}, "baseline_offer": {"id": "2022096858412168"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "3455362911311265"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1379675623668468", "version": ".19"}, "id": "1360180336203268", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1359800928989271", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "137967562
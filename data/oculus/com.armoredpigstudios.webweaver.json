3475_6106920690230410410_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz7r-7qsXtoQ7kNvwHw_Fof&_nc_oc=AdqitbQ96Ya67NK3EGHOuLFm1CbYZmWCBRYGvl6RMck5wruPQO5Qv9nROTuEv1cXJOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG0sbgnsgwzxtkhPmIXfVfN2l41TFkkw2NK5hYStBSxw&oe=6AA6B900"}, {"file_name": "vlcsnap-2026-08-18-00h18m08s324.png", "id": "975548698737949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_975548702071282_5011686404646458163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaWl14q19o4Q7kNvwHm1l5-&_nc_oc=AdrxV3fyWv9o7udZGI1mYwhbyR3Z0kw4tgMjzGFgrmtVfJ3f6hWdKiBeuo9ht_1EQTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2PGyx8j3dHPiAjnow1mdJLfSNpGWdYLy3CRj-SD6Wow&oe=6AA6BA08"}, {"file_name": "vlcsnap-2026-08-18-00h14m45s293.png", "id": "1045839164520523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1045839171187189_5048577381270627752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj7Tbgq78YwQ7kNvwEZ3xA3&_nc_oc=AdpkKMPErrV2QjXh--g1oYsFqes5ftUIgg1ym-8PVNacetuXOGuIa-pF9Fk2wLhqEvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoMo13Ll-73U7GBkqoROr-1Ije25PuHUjm4r_amOPBnQ&oe=6AA69328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSzYTsjwB9oQ7kNvwEZZo0O&_nc_oc=Ado7KmUUvUOQY8l1yD_OT0Vjx69756GmCx-pe5O0CZs9Jt0EpWsYLBwmrDlQrVjR9js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSzMggHRpECBsbS5vNgNAsxw0WlSqoMOyx84rkXxFlVw&oe=6AA69E72"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "Swing. Flail. Faceplant. Repeat.\n\nSwing, flip, laugh, and pray your way through a web-swinging campaign. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with your friends.\n\n{900892415999728}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{4441876472749234}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n\n{2230945841053332}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
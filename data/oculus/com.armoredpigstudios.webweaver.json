1h17m47s545.png", "id": "27470374099300173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673536876_27470374109300172_3318935900093651350_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7esP5Oo3kYQ7kNvwECTUE_&_nc_oc=Ado74O5apa5Ciz6U-1-1OYwZKv14_4Z9gygQvWoAQukyWdMSyqfTGTN607s3GEDeRWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWG8Cq6DV1hdlG0rRpQNiSRIJ5M24jDSUuKqIbVr5FsA&oe=6AEB479B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1erGL_ZChcQ7kNvwGH5ii3&_nc_oc=Adpp-8VLsptHQXzs44T9zSAtYkkzZE4LFro6J3wLQiYaNAjS-BJz-cTuYY-8kv7SXUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS2HAitK9RLEpqdYESU6J5XnlZfq1b4cj7YFQ-NrwKTA&oe=6AEB2C72"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "**WEB WEAVER**\n\nSwing. Flail. Faceplant. Repeat.\n\nGrab a web, launch yourself off a skyscraper, and pray your aim was better than your judgment. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with friends.\n\n{1590796759424065}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n{1566776888280050}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{1045542848436579}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n{2230945841053332}\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1360651905570840"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2186399875555657"}, {"status": "PENDING", "id": "28467688669552935"}, {"status": "PUBLISHED", "id": "3455362911311265"}, {"status": "PUBLISHED", "id": "2022096858412168"}, {"status": "PUBLISHED", "id": "1674562976953937"}]}, "baseline_offer": {"id": "2022096858412168"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790946540, "status": "PUBLISHED", "id": "2186399875555657"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1435520288084001", "version": ".32"}, "id": "1360
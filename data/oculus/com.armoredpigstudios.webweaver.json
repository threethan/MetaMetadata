3475_6106920690230410410_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_tCjdSHj8wQ7kNvwG5jU5i&_nc_oc=AdrFCtKn6z9v8nOXvWhq4Y7Q9MUg2CjTfKssKjB5V8elBFE-CaX-32v3NBOD3p38C6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5esa4ws4Efgwtx_RB9RoQmDFkm3qnk1FHDhbE7Tl0hQ&oe=6AA80A80"}, {"file_name": "vlcsnap-2026-08-18-00h18m08s324.png", "id": "975548698737949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_975548702071282_5011686404646458163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaWl14q19o4Q7kNvwHZUSHw&_nc_oc=Ado5rhgbhiyXsEQDS7MLvlcKdVPXG5KEV85SxJG-WGMON2LuYpauE11Z1Dlgt6S341w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy-fYoe7SqKiTMpHKF1FI5aLidbrOsU_tTAtJwX0IORQ&oe=6AA80B88"}, {"file_name": "vlcsnap-2026-08-18-00h14m45s293.png", "id": "1045839164520523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1045839171187189_5048577381270627752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj7Tbgq78YwQ7kNvwETNhjO&_nc_oc=AdrGnGzUNr-5fC_eO4DISGS7XZcEXDCGt3BY4AJ0fR7idt335sfOIT7p8N9sRC1S2-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLGFZA7LFH3sYREx1w5cFEv2UbN02Ilv-RtZkOxaIIIg&oe=6AA7E4A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSzYTsjwB9oQ7kNvwETlAW6&_nc_oc=AdricCGIr1wHT3NoS6j3eoyXNaPFiOj4Ysuis8j48jy7IkPYFVoKajj5CIDqS5H8ppg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoo2LlC8YhNgv4vij_NcOk54evObEPNoB7eHvHJw8WBw&oe=6AA7EFF2"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "Swing. Flail. Faceplant. Repeat.\n\nSwing, flip, laugh, and pray your way through a web-swinging campaign. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with your friends.\n\n{900892415999728}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{4441876472749234}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n\n{2230945841053332}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
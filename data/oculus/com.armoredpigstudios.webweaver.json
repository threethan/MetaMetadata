Jrbx8rXNtCfQ6Aqtao_hzrcx-1pLuYA40w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZm1Wezos6EHSxyJ_SjC24W-3PrHcfmohDanefhGB41g&oe=6AEC9F7B"}, {"file_name": "S2.png", "id": "1718330439398332", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595129854_1718330442731665_3209059799744699982_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwV2RpMAAwwQ7kNvwHM3bJn&_nc_oc=AdoI7LZxfHzmpnDjMcD3DdrpfNgAFG_e-B4a1i5g-vvPnVEQsrULl8THL2xtXoehIq8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK2AUOb06NSK7_c0anqOv-81B3_wDvzg_RgCJUYYTQsQ&oe=6AECB610"}, {"file_name": "S4.png", "id": "2633254253761629", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604360590_2633254257094962_2532184228266596029_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9l0b-Mu5cW8Q7kNvwGb5kSO&_nc_oc=Adp1_3X97coxTF8y4yDJym6SFg-CDFshrNV-TEx8YLtZbI8xOqIG3SZd62XpWcpzCVg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsccNzaz9pyPfxTTMzU95a7ACDjeBGTdwMvJHkyIjjBw&oe=6AEC9C17"}, {"file_name": "S5.png", "id": "1109376902037770", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830441_1109376905371103_5052696636826473835_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hptyj7oAQXQQ7kNvwGDvG4e&_nc_oc=Adr2M57TuQiufkl1133XlJUQg2r57a637wc5QUjpIU4XmsSWH7wGsdf-ahonAtXWqg4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH3vGVHOkPBs5UPJl6pwCLY_h8U8HNwcTemjgCaC_4Kg&oe=6AEC8DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Web-Weaver-New.png", "id": "1352395733380838", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673573223_1352395736714171_2263927534261243081_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVQQXlIIDQsQ7kNvwHS97Aq&_nc_oc=Adprojrmd828xJ1nqf2zQ3nm6R9LQP0eQiCV4J9pdyd96sG1WJMPSKYcNKoLRHb890Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2HMa1KLRLlZm5NsZMgxbWVl9rr1sWaU3XwowE4mBsIw&oe=6AEC9B9D"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "movement", "superhero"], "long_description": "Swing. Fight. Flip. Repeat.\n\nSwing, flip, fight, and pray your way through an incredible open world and more than 7 campaign levels. Web Weaver is a physics-based web-swinging superhero game where every jump is one bad grip away from glorious disaster. Even better, you can play with your friends.\n\n{1051831694494166}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot. Nail a perfect arc between rooftops and feel like a god. Miss and eat pavement.\n\n{2172536073671077}\n\n**BECOME HERO'S WITH YOUR FRIENDS**\n\n Multiplayer mayhem. Swing together, fight eachother, race through the city, or become city-wide menaces. Everything is better with a squad of web-weavers.\n\n{1894342194877282}\n\n**INSANE COMBAT**\n\nCrazy enemies.  Tenticles.  Grappling.  Experience the most insane VR superhero combat on the market.  Fast gameplay, multiple enemies, and unique Web mechanics make Web-Weaver combat a must play.\n\n**Grab a web. Get moving. Try not to scream.**\n", "short_description": "Become the Web-Weaver in this superhero game!  Experience immersive swinging, intense combat, difficult parkour challenges, and crazy multiplayer fun!"}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomm
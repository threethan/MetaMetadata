3475_6106920690230410410_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6Hee0OqkUQQ7kNvwH516Wf&_nc_oc=Adr7FvHIKMnVESw-TFkREGMiT_fQIB0AL-yrV3oLY7s6zgc4wvEEvXpPXtXzWyVU8LU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBEY2i9GbxUj7eKki7WV8iIwTYSiPcB9E0zWvWvd4qhg&oe=6AAFF380"}, {"file_name": "vlcsnap-2026-08-18-00h18m08s324.png", "id": "975548698737949", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_975548702071282_5011686404646458163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k3zbteBVE_kQ7kNvwGeEjnc&_nc_oc=AdrExjIZo2Wi7gasupVm05VcApxBALmkKhh8PHPhva9EstMqgmUwxfSUj5itGkig2kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOPUW7fw94Y7k0FYJkmdv5MItH0ORvuS8304KqErL_sQ&oe=6AAFF488"}, {"file_name": "vlcsnap-2026-08-18-00h14m45s293.png", "id": "1045839164520523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1045839171187189_5048577381270627752_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQaPOQHIVmwQ7kNvwH1NxpH&_nc_oc=Adqnruq2B1jwZZo-aOEUwNDbHh1V3y2vO7N-ZFpRPdxsKSGXMo9RwYqCqStyezPpRM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJarYAl63jJw0zAoMHB6w7i2hQC6yNfBJ-xpQiERVOH6Q&oe=6AB005E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled(1)(1).png", "id": "2087130625540636", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828038_2087130628873969_7866446366568667079_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UilDWH7JCwAQ7kNvwFAimAt&_nc_oc=Adory24kK1DM4C-V-2KSs4GCa3MNtrPOnuRicxItGWZwR5FWXyO1pw0AkcNIFBCF83E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI68YpTeA4FlfCVf8gpdjQi3NVJy8-09T5QFF8z8tmDoA&oe=6AAFD8F2"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "grapple", "movement"], "long_description": "Swing. Flail. Faceplant. Repeat.\n\nSwing, flip, laugh, and pray your way through a web-swinging campaign. Web Weaver is a physics-based web-swinging parkour game where every jump is one bad grip away from glorious disaster - and it's even funnier with your friends.\n\n{900892415999728}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot \u2014 just you, your grip, and gravity doing exactly what it wants. Nail a perfect arc between rooftops and feel like a god. Miss by a hair and eat pavement. Both are great.\n\n{4441876472749234}\n\n**BRING FRIENDS (IT'S FUNNIER)**\n\n Multiplayer mayhem. Swing together, knock each other off course, race through the city, or just dangle around being menaces. Everything is better with a squad of googly-eyed disasters.\n\n\n{2230945841053332}\n\n**DODGE THE CHAOS**\n\n Lasers. Obstacles. Traps that appear right where you were about to grab. The city is actively trying to end you, and the parkour gets meaner the deeper you go.\n\n**Grab a web. Get moving. Try not to scream.**", "short_description": "Physics-based web-swinging parkour. Dodge lasers, chain wild arcs, faceplant gloriously, and cause chaos with friends."}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
rUEkQ7kNvwGd8ofu&_nc_oc=AdoSiMmNTXh4k_3viwTZG3ao_79K8yS8RQNk2fYe6wFKppCoPxoiH7xcFPTTjgqZ7KA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeEOyYKQRIYqxlccnLuHh6pM5rKtQnO8EEjit4hk5acw&oe=6ACD1210"}, {"file_name": "S4.png", "id": "2633254253761629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/604360590_2633254257094962_2532184228266596029_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tvKNLFpaToQ7kNvwG9sfQP&_nc_oc=AdrLuPLtwX9zGduqX6kAUu9rozLgIXlb-M35dBCaJjZo5ussgEW9-Lw9slSArFwEMRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSgOuTemCBm22-a5mpaGkbSATm-evEhxqZk5Dfh5yNWg&oe=6ACCF817"}, {"file_name": "S5.png", "id": "1109376902037770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1109376905371103_5052696636826473835_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmZ_9qrl9gAQ7kNvwEiwrRC&_nc_oc=AdpGQAWm0btFUSWBRkHaeg_O5h6ciueVaIDjNGKxHofTo85Q5UCOXb3YqGwBQaQk6C4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoWNhEtXin-H1UYda0Mf3AxAP9V1QpSR-_3iH5yGUZZQ&oe=6ACCE9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Web-Weaver-New.png", "id": "1352395733380838", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673573223_1352395736714171_2263927534261243081_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGc-T7-0440Q7kNvwGtVghb&_nc_oc=AdqBogA78SIk-VDKRVDFlpt-q3smi9ULiIBrVoQDypvWLdjLqe5tVopBBgR0n9Q4vhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqKOIfblQtN2tozi2_SS4b04Ly5-Ji72i3Fm7fQNuAsw&oe=6ACCF79D"}, "display_name": "Web Weaver", "keywords": ["swinging", "web", "parkour", "movement", "superhero"], "long_description": "Swing. Fight. Flip. Repeat.\n\nSwing, flip, fight, and pray your way through an incredible open world and more than 7 campaign levels. Web Weaver is a physics-based web-swinging superhero game where every jump is one bad grip away from glorious disaster. Even better, you can play with your friends.\n\n{1051831694494166}\n\n**SWING THROUGH THE CITY**\n\n Fully physics-driven web-swinging. No rails, no autopilot. Nail a perfect arc between rooftops and feel like a god. Miss and eat pavement.\n\n{2172536073671077}\n\n**BECOME HERO'S WITH YOUR FRIENDS**\n\n Multiplayer mayhem. Swing together, fight eachother, race through the city, or become city-wide menaces. Everything is better with a squad of web-weavers.\n\n{1894342194877282}\n\n**INSANE COMBAT**\n\nCrazy enemies.  Tenticles.  Grappling.  Experience the most insane VR superhero combat on the market.  Fast gameplay, multiple enemies, and unique Web mechanics make Web-Weaver combat a must play.\n\n**Grab a web. Get moving. Try not to scream.**\n", "short_description": "Become the Web-Weaver in this superhero game!  Experience immersive swinging, intense combat, difficult parkour challenges, and crazy multiplayer fun!"}]}, "developer_name": "AP Development", "developer_privacy_policy_url": "https://sites.google.com/view/babydeathrampage/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/babydeathrampage/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1410940120542018"}, "review_messages": []}]}, "cover_square_image":
_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS10Zaep2ycqeyNZtOc733E9UArcBLrCLQkEuLTamXLSg&oe=6AF71939"}, {"file_name": "Screenshot 2026-10-03 060846 (1).png", "id": "1501373715208667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1501373718542000_3657357858783989561_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4r_tXNag2cQ7kNvwGZDiKX&_nc_oc=AdobQIHApKts6ZWTvF0QJhcigH3YxzbUVz9-z6hy2hNVUiBWH2HrBD103T46x_xMnWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpYShuWZmSfV81W1oqbtNnTb_J8tkW84ZQA3xjOq-YHw&oe=6AF74B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2026-10-24_at_04.09.08 (4).png", "id": "1609062583552723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1609062600219388_8574944052856939665_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_oZCWvJayMQ7kNvwHOu665&_nc_oc=AdqsorHJpoJd2b1XrNemJ-AClgkAZ29cAW3738JBdeisJAu2Ga_zwdrMG3Gq9fG-ogo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8jQirNbi7Y8-i8lSL1tlEqMkPPt-MzURDIQW2P1URdw&oe=6AF738C1"}, "display_name": "CAPU", "keywords": ["monkey", "forest", "pvp", "horror"], "long_description": "Welcome to the forest! Enter a fast-paced multiplayer world where movement, competition, and chaos come together. Inspired by the movement of Gorilla Tag, this fan-made game lets you run, climb, swing, jump, and launch yourself through a large forest while playing with other players. Whether you're looking for intense PvP battles, competitive game modes, or simply a place to mess around with your friends, there's always something happening in the forest. Use your movement and knowledge of the environment to chase down opponents, escape from danger, take shortcuts through the trees, and discover new ways to navigate the map. Compete across different game modes, challenge your friends, and practice your movement until you can fly through the forest with speed and precision. Every match brings new chases, unexpected encounters, and opportunities to outplay your opponents. So grab your friends, enter the forest, and get ready to run, climb, chase, and compete. The forest is yours to explore \u2014 how far can you go? This is a fan-made game inspired by Gorilla Tag and is not affiliated with or endorsed by Another Axiom.\n", "short_description": "Enter a wild multiplayer forest where movement is everything! Run, climb, swing, chase, and battle your way through the trees in this fast-paced Gorilla Tag-inspired fangame. Take on other players in intense PvP, compete across different game modes, explore the forest, and master your movement to become the fastest gorilla around. Gather your friends, jump into the forest, and see who comes out on top!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://capuhub.com/pages/capu-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MXPZ.GT", "support_website_url": null, "website_url": "https://capuhub.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30151864997747979"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1063210096769442"}]}, "baseline_offer": {"id": "1063210096769442"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793368260, "status": "PUBLISHED", "id": "1063210096769442"}]}, "liveChannel": {"nodes": [{
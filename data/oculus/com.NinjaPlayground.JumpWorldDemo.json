hM-AtSjF9GdAI_P-Qe2k07WoV-Fk61vhwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeA4EGgS_6A7uVIF-taVEgYCm0Bg7Yiu470j3CWfN_-g&oe=6B070840"}, "display_name": "Jump World Demo", "keywords": [], "long_description": "**RUN, JUMP, PUNCH & SMASH** your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover.\n\n**In this demo, play all 5 levels of World 1 including the Final Dungeon.**\n\n**How To Play:**\n\n  - Movement - Left & Right Thumbsticks\n  - Jump - A Button or Click Right Thumbstick\n  - Run - Click Left Thumbstick\n  - Ground Smash - While in Air (Press either Trigger)\n\n**Want to play the (Early Access) version?**\n\n**https://ninjaplayground.itch.io/jump-world**", "short_description": "RUN, JUMP, PUNCH & SMASH your way through 40+ levels and dungeons in this retro-themed VR platformer & obstacle course game. Filled with tough challenges, inventive obstacles, treasures to collect and secrets to discover."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ninjaplayground.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ludus Vision", "support_website_url": null, "website_url": "http://www.ninjaplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking
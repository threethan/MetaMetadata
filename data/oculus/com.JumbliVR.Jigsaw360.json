oh=00_AfvT1G2OfXUzOg5p2n2kx6RsO5uyAL06gOBX3IVlkbwlcw&oe=699C380C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jigsaw 360", "keywords": ["puzzle", "jigsaw", "relax", "meditation", "relaxing"], "long_description": "Relax while completing beautifully detailed spherical jigsaws. The new way to experience a traditional puzzle. Suitable for all ages with between 8 and 162 pieces. Choose from 10 scenes or add your own.\n\nOnly possible in VR. Find yourself stood inside the jigsaw. Use your controllers to precisely place your pieces as you build the spherical puzzle. Rotate the jigsaw and scene to see it from different angles. Traditional flat jigsaws are also included. \n\n***What to expect***\nBe relaxed by the music\nCalmed by the sounds of nature, rain or waves (headphones recommended)\nGrab and manipulate pieces with ease\n\n***Add Photos***\nAdd custom scenes - thousands freely available online:\nSee: www.JumbliVR.com/photos\nCustom scenes should be saved as .png or .jpg files. For 360 degree jigsaws use equirectangular photos sized at 4096 x 2048.\nIf your photos aren't listed, ensure you've enabled \"Storage\" permission via the Oculus app page.", "short_description": "Relax while completing beautifully detailed spherical jigsaws. The new way to experience a traditional puzzle. Suitable for all ages with between 8 and 162 pieces. Add custom scenes - thousands freely available online."}]}, "developer_name": "JumbliVR", "developer_privacy_policy_url": "http://www.jumblivr.com/privacy", "developer_terms_of_service_url": "http://www.jumblivr.com/terms/", "publisher_name": "Head Start Design", "support_website_url": "http://www.jumblivr.com/21_connect/", "website_url": "http://www.jumblivr.com/519_jigsaw_360/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "RELAXATION_MEDITATION"]
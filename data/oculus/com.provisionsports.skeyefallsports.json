D_9xJ&_nc_oc=AdqFEtw_f1mgtqjhfzBVCp_p_JmsD84QI_N5blwlv9VacxOYWJGNfE2olmYmz03NCWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5OBxKZGnw0KEP87_sbDAADtA9L6r-7bLhloKpZHBALw&oe=6A3FEC06"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIGS4FwZnRAQ7kNvwGSp70l&_nc_oc=Adpay7PaBzKxbTfA_2Rdl8cIoxQYdmutj7qAxcfg2HIrRe47da_yuOBFxkHpCPutYYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QvHDBgG_K8O79erRbiqaleAR6JjrKLXavI0uS9cup8g&oe=6A3FE815"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZ2AMT4DgccQ7kNvwHLUHjs&_nc_oc=AdoWGxk8aMYUc6bGMBa_BXv3xGvrnKLzWudaWOgih0kitlvBEsaCm0Pepq_9Nraeikk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EK0DWJ4b5pYpdC_m9VGE5Qvp8_v8hI2R7XHf54U4neQ&oe=6A3FC703"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8jWnBJ5ln8Q7kNvwEyvtVc&_nc_oc=AdqYYHaoM5KEyT4wpy2T1qD_wdIFNmP9BvLkbekbdzUoekhVFYcCGnZBnlwKR1LRIEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VaCmDvbFKs0YF89Ygi_PDVkzOLFDbHvzuK4K0Spmg9g&oe=6A3FC678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7l361WxWHEQ7kNvwGkPtt1&_nc_oc=AdphKP3eudcfgKg-fBt0-XpJsw211RMHE0b-1ywoHhhx9qt_Mwrs60k4ds3WqPxJZuw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Osfh74FcWrFGbe9nVRy0R3lXtK5UihzMkwh_B_B0GYg&oe=6A3FE440"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
chJ7L&_nc_oc=AdoutW7CgjH10reC1v4NJxwuYEm4rAMDTSeg9yEz6H6vPS8TFC7WkI6qjpAzsgpQcDY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ99JYnVGXzEzbDNVGVyktpVE1WXQnWZVXh3jtvhn4nw&oe=6AAD5886"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65HQUnPET5wQ7kNvwHwgIIH&_nc_oc=Adqs6mcVHfXuuiMI7Ke5rGdIulCRT2DmI0AtInQQXGD1lrCY6XGutltptRujB8gQAKo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-wngrhwGme_aXh5j1vbCgo5aGkFgi7Us8o4k3XTvZGQ&oe=6AAD5495"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HiBJFM7Rm4Q7kNvwEEad9X&_nc_oc=AdpCDJJdXTZDBsLQL1ELqXmgtGbbbI9qekzdkp5qK9n9wmjFTSZqEUZ-l1nM_gLkYF4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjQU9ApLjJvPJLti9KAULpR4wdMqacm3wrSwoorsNgzQ&oe=6AAD3383"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrQjoTubk6AQ7kNvwFnHnbl&_nc_oc=AdrHaeSaVjQ5dcOTZqrb4m7xop6tm6FnUG4shPoFMzpURUtvTQdb81wdCEYERWGiFY0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSX7m34zSqTV-4qfVFjOOWFpG2rGlI31vmNyZ2ZKckDw&oe=6AAD32F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSem3TPULbUQ7kNvwEUC_CT&_nc_oc=AdrJf5n1Xetf-R9qC52pjsRuolAZ-8pOil5dY0lMbtlkHBpR5ROPYvHEtyPWlXOC4Lw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI8GORQazF0hbigYRPyIL8W0atV8HQxayarJSpv0SxHQ&oe=6AAD50C0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
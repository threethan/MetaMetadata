QwNsw&_nc_oc=AdoxcmS-fzt5h2B6JTXpgv_LTP-9q6dXGnnkvNln0ErrZecnuNU9BTqedrGVLdRm9qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af815-a7n9GXHChSINciD88URUFw8XDYQ6cLE2bClo1fTQ&oe=6A356006"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahZulwdJUJIQ7kNvwEV5Bz4&_nc_oc=AdrdMxVVhIgocbKNS-4H-PkFsT12jZWLwhFVxYQaGY_TrX6Hr__aJijIYWmRDl4g8JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ri4RAjOQpNpKx1-fLqnKm7_kL5t26mTX5Hlhu_DMl4w&oe=6A355C15"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMuD7I3wcy0Q7kNvwGFXUxA&_nc_oc=AdqCQJaixTwLhAzmB5WelvatrhckT9cgHmog0DQWIhGQbVq3sEiUYHODe4kmgkOEtBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AWiRSTGPVl4jdQGzfDIuScodFgyXpiP4URVz6gnHw3A&oe=6A357343"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K281hiz2tpgQ7kNvwGqLjeU&_nc_oc=Ado6srJETAktQl-HHtxNd4ES8x-sPC8wy5avGjwZHdgzp_a1_PgEXfxgODaDn6i-LIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w5VDtDCaXNp8E7CjI5Z9nlIpv8OGYzeVnm-N8Ld4INw&oe=6A3572B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmfTiLGu8LQQ7kNvwEEOdFW&_nc_oc=AdrSyvzApcHfbWGsJvIlVgo6pOOtscK1fRhrxKFCqot5XgUzYyMvfS-vhh-GEbG_p0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WV_wyXZU_le7g1C1j4jC_hSK-5slkDUUmjvJU3qEXLg&oe=6A355840"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
_BUtf&_nc_oc=AdpC3UCDT-O3h4U3kTCet8bUljUlA7GlopP5346cGiE6PJ2nyONo12W1UJbZkguGXbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV95cFyH_e_eRkE_-OMvdwBtX3AZfQzQVq3KV2Ftqf9A&oe=6A61FAC6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5AIsq1K_Q0Q7kNvwF83Vsr&_nc_oc=Adpem4P67ofQZCAOY5vL7C46SAcpVZGpTAavU-B446GinBkRLlJJBlFJO3XFMRGroEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkLPCf3_YRRUL8Z-M6bwxe6s_UJpYtDi9b5oRBUSWuYw&oe=6A622F15"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5o5tnTv8gAQ7kNvwGhOCBh&_nc_oc=Adqzj7UOJTWPHV_KByJDHlhdC-6hgtFGG85N6N88TzcfK6PK6QOs37Onkx0xRZq_Hso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClud9nNveg_6jKgwgtcdbCkTMgTbIScQx9Wn2K5ubnng&oe=6A620E03"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_IGBXJa8I8Q7kNvwEFAlcV&_nc_oc=AdrsYkPxHyYxwY0hrqcchx2h12HIz4gsOqh5-q0PLEW7YTBj7jLOOWpM3xLuUOJ6ejM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSM5dYJZBMZa3TXizozFDb6HlVdE4yas6zor4wjwHI1Q&oe=6A620D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9BBUxGSvU8Q7kNvwFgRvc3&_nc_oc=AdocftoYNIHoNJ3wOgUlDyfoMrCpMc0tZ7I0uj57CAmdRXUsjFQUa4aULGHSD0g6drE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtTuvMSZlNJYX99f0XdVKhprLQU0aOyUkVFmPPCeCvrA&oe=6A622B40"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
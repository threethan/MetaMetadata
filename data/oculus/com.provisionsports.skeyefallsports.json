BU-pO&_nc_oc=Adr1xHtNZOnmmSMtbVOtdaU5WEFkwGyB_96aFjoAPhKVE_vHDBzTcP-pwa1jpmQaIRQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUU8TkBRUBm_2T7P2TpGGjlS41rki0lf6KoWVemEvb9Q&oe=6A65EF46"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwKjyn2Y63wQ7kNvwHlk282&_nc_oc=Adrw6TQC8XSnAiTgjBnIO_hg9vc_5-1Sw6AoZb2QGwYPKvKVvHl1DTBGKvBkNZnLJiE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS7B3Qe3-J_0KSsqd7AV-iueVZqD0u0GGu9VFH6zmqsg&oe=6A662395"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LQGfwPn8isQ7kNvwGh4_ny&_nc_oc=AdovXJPUpHbFoXaDosxVRz8tHFtkgauwQrfHz-Xm04z0T6iWUV1xd6cHV2sn3fUi1pE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxI48eZr_YlrOHt4SAhn9RbbNfUxN917BZmnZ_L0i20Q&oe=6A660283"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8X6Jvef9NEQ7kNvwH5prMe&_nc_oc=AdoKjCSsuz2aDElgYY9EBt6_BpI2ufhdCx10GqyqGshCE2VKJOQccuiYp1t-wj5VrlA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEIOavTXQx8_xmtjYSnlbB2Rr9An0XoXsUSj_258dndw&oe=6A6601F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n01BeDFKFmcQ7kNvwEpL6tl&_nc_oc=Adq0WuTAwdykDokHOUWuXVHIjagh1h1zaIH_dpgI0vFCbcii8oece65K7GXY8iy-UA8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCGdmaPtQyl1MU3O9Ui4XGiK3j_c9hrZln1SzXphZcYA&oe=6A661FC0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
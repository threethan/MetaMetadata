OvRDq&_nc_oc=AdqilKKWvfnOHf2PIaqv8Af3EhMJxwDPJrd7xsVNcE2En66vDodG_GDrslTywFfXug4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqNSvc5GHKZ2UljzyjmR5xTYZGkx9_TnPhLn3ZCY1B_g&oe=6ABE7C06"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXu2m02YNdoQ7kNvwFK5EBi&_nc_oc=Adpo8pC8591re3Ke-Rx0QRpJQ0Vi7fOtkWu50rupe2LEiu7XnwZffNvseDoqFO1yjjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaUpSbQGKV2mRkhQK7VvFljKPuMY8VUT7lWajdJd7n7A&oe=6ABE7815"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pqquYRWlSgQ7kNvwGrDPz3&_nc_oc=Adqzge4U-by6miKSFUXf3_VH3tiSgipDDhhH4Zql8eb2w5tbce8yDMNFSp-44QIEd8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSfgbh1COQZo661ljFYafYacdRlVkPk10ugU6JX367pA&oe=6ABE5703"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xgbtTc2WBsQ7kNvwGNKVVY&_nc_oc=Adr1pxq1lm6AIhC59U59vjYrGPgd4N31oVU8ZIWxidUmrzgoHcfWiZovQHCHunZFPX4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtjnmyVNW2WBC3jWF3fgTTJSR7m0K2ezDUQLWvjcB7nw&oe=6ABE5678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQrAsqIUGEYQ7kNvwGDcebA&_nc_oc=Ado5ECHrEOT3828pYm3TEZ9xR7CUql1h5FmyDWxQyRq5QS1HPLQ__SqEUDbk2BQu2wc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZv7ePfXXqcdAbfonKFfQd16GN5iSZU9eEB2E1DFTfXQ&oe=6ABE7440"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
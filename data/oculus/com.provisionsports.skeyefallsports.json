VdB_RWmfYzWDRAKnFVwwjpDGyKvqn0k3XwzyVRdkad5OWKyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsg7nQIThhoyzNHwYUFpSUH3ezUyG5BYhLXU6Sa-G4k6w&oe=69A968C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWuFfWyK72gQ7kNvwGOhXk8&_nc_oc=AdnnYlYQW1WW7uR4MMmx4OkbOViK7g4Bhf8vJ0s3Z8d2GGb27Vnt5x9S1FplogrMxfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftHIJlFHeV1EtNoXDZy-yQmBywZUHZgIZZOvUPKRCTIeA&oe=69A964D5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK1CW8RhrgAQ7kNvwEn1wYN&_nc_oc=AdntI1FXFHZu0x45LX7WSSIOnL11yXy-GxmdnKC_4t_RoO30uPO-UKj5BEW8bm1GoFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGFf37gAeaXa-HAxrcCLrFHotft98XaLOczutcExSXqw&oe=69A97C03"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qYd_JXA9dMQ7kNvwEb7eTl&_nc_oc=AdmhQzqwstzRvouV7cDSUqrh8YmI7DHP5N3zmihZzv7Lq7wFsBcxpKj83BfcxxryxzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsoNLekdf4YAVAH0Qy4Oy91w8fP1bkH--6y4OyMLCUC-g&oe=69A97B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE5tIvVmjroQ7kNvwER80X_&_nc_oc=AdnK-mmS9k6yJQzfbNue2lQOnOC2m5aCm_cjr1jKNnkf2SGINowFvsXfCVgZCJO-_DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsDccffOI6laCs7VRJb-WpaEwForg4DjFCJK7n4znhqdQ&oe=69A96100"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED"
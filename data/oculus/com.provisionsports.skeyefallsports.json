Ym72O&_nc_oc=Adpu1K3AKFJooFynorpV4iGHuQE-2jweDQiguy76FtR-qNS4azNMpvCoR6lS5Hsbpv4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P1jbY2HDJX8MH-15ygMNwJwOmXy97MP_ygeUfqIkr9A&oe=6A0F2486"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJmZR3p3qZkQ7kNvwGU6RWQ&_nc_oc=AdrYZW3-56XKD86eJk0XCnM1l2zDbNlQ_qsdQVlclU64vqgbSid4eGx9SNGq5kgYaAE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PMucTJs5pk9OOhgHfeU4gnBDGjlSadsOuBLIsD1ZH5Q&oe=6A0F2095"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3st8MxaZHw4Q7kNvwG1Zuh6&_nc_oc=Adqu9nUQkFjPk0FgBhj-eZoYyvcxaNIJyUOeo6l3Tv-It548t1BeXL8k7fBY7nUJJww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oZ9ItRTW6Zvdhlwe1QefeESIjaQMVJyGe6XPCmuaT9w&oe=6A0EFF83"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SshVPWhlsMwQ7kNvwFMJSWJ&_nc_oc=Adp_hc9qHpX_K6UQh-ReLA7AJ-DDyI6P404xp0LeMRDXUSMLNGc8U-Tx-KuBuKRfHaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lr8lwM-n1OGNtfjm5sAIPutl6UgAFFyN6447MBWROHQ&oe=6A0EFEF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZtPXM8bdVMQ7kNvwGgHixl&_nc_oc=AdpCYT8pomlnoT-H-WYkpJUXO0LFRmoQX89FvtrHfpIe22gfqWoFqmjysPdeWLXW9k4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af508ME0JMg0fr1U0u2--OnWWN3VtqFugLVmi0uSqfBYpw&oe=6A0F1CC0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
v4b8y&_nc_oc=AdrxpmRD3eMZnSOYZwyHmhzlSOeN9r1HKzEKOP9d8Vh0FwMlSX1rXHP6sZfPAnJl7o0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qteX607Kxs4dpO-ibIUzv6N1lsjfDkCg_dLqf8wnM6Q&oe=69EF8086"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlOigliPRwsQ7kNvwFHY8_z&_nc_oc=AdqUvMkbk_qpg6XXBhnYKtHvVvnMetdQwlFKZQsIqRGRPWLpsLz1IOhM9ZwdvB41L20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tFypNGeXK--YYUJAWjgPdQG_znWCI4-WiwzjYOdxeGQ&oe=69EF7C95"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t1nbGoZxSgQ7kNvwEI9U3w&_nc_oc=Adr5gNeLKh-JmWhlnZwray1E2KmP5ZA1VVEkbR_wKkGcvII7Nd2m1oDKRZe9WnDsQPo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rCusgL6IlRIZLDkDkSjWeB1JgZJla-qz0R3PSmj0NAA&oe=69EF5B83"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTkcHH3Y8yUQ7kNvwHGqLAK&_nc_oc=Adr2k5bRTzj0RtOW7i36VEAc04hwUb_c3WaKhv2K5fnddH0q9_hU7M7qwJls1ruHXA0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04buUldSU3RmCFK98mbi9Hk5cxR8V_evJRK4_l06CT-w&oe=69EF5AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vUUv0Rq53cQ7kNvwFVekdd&_nc_oc=Adr4bRLPCGB3NvHzxGfynCL8fecVeixn0kP-b2QSpZ20tvLHmCuH-Bz2i021zN7I4LU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SgaoHIwaqf43_eGmOQwbzfSSSVZf0FZwUo7369istGg&oe=69EF78C0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
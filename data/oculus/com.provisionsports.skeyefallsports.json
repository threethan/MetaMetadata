LgK4P&_nc_oc=Adpx0dlOuqx7Xuv4nj5KTJyWlK0K-P48YSASNda0N4na6Vv20b7yka2iYIcOvnSRlG0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sCaMBlyYI-8OExx6h2BxX9O8rmQSt_DVCDYCC6P-26A&oe=69D63BC6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGJXfqyQZBwQ7kNvwHpFA1E&_nc_oc=Adpu_pVjeRU_O2tY5esQKSzNzWDRTGC77Vd3ohcTyuHFWD0fXMNCIsJQG3cU2fEFnRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00XUJ8cjsJa4d-6Id8TTLVOgIx7zt2zoQe8qk0f_HnWA&oe=69D637D5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxfPMECpUEEQ7kNvwFxIhx4&_nc_oc=Adrf4cmWpmBdQ5eL78RQWdLsZbUNeJtX1d0BnCe09GjNdwmdvDDijbjj9cmAaFfMeKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jNkmRa2ONRJk2W4Nq0YHrBkmbjgYVBWCOxvfQ0JtQWA&oe=69D64F03"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJptxAT3PBsQ7kNvwHV4OYo&_nc_oc=AdpzykhfnRJxLcOxYrNthWIWFD1f0ejjCNVUNUEJBjFOMMaJtCIhT0DtWPdq9PCkJCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_pPr9jCUjhnvUVxuj5LR3j-ubZFU-PFY7YgIeeoHwgQ&oe=69D64E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY5YXX8izgMQ7kNvwHMmF5Z&_nc_oc=AdqPt8MpVua-qhcmqirf0LJEJnrRyZtnMnbFPzQzdYr4Nf_GR9DKATEicr3d73H3A5I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oUB536rDgqu971Fd6pPgRFnw4Ouh0I1vrbu0RtLNBJw&oe=69D63400"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
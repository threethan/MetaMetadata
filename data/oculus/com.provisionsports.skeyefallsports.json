cZKvw&_nc_oc=AdoXxCQbcD7ymw2r2vakXrPIShPXMpbnEWzRWl8v5qPBu40TNZT_B_GgpRY_o9G-Z1s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxspUUkMLk6fjn1PaWK-YGQSL3DSqyGzM1HEFD4c_1PA&oe=69C669C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIGEcF_EAjAQ7kNvwE4kd7I&_nc_oc=Adr848p9N4VYTkRI3fC1wiqwOWq32JvFVO5R_dc1lG1ke__Jn6KEuyoCxiOhv9yiN50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6kpC2jFq0stnMS6Hpb6BSDj8Kv1RKlbDnd2isT3H1lA&oe=69C665D5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG9_Bv1qv0cQ7kNvwFAHcQQ&_nc_oc=AdqWw7B6WBXlED6icVdGLD86AOGSNK4WBnofx1n00342NaeTNYXGCyRpJw5NCvBJMk8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRw_3SIMjUZyGKx-GBCvP6kegWhOYLIZDQsindAtxFuA&oe=69C67D03"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIhKQrTOcFMQ7kNvwGAUF1a&_nc_oc=AdpvfNLkL5jbFf-v-b61DnRPz8_cDjsehe7mUti4dii0bh239xDQsh5nVADA1cjZyic&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQGBSrhZZxm7rPcPX8vvxhVN11XwjkAwt4WVDnK1EFIw&oe=69C67C78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OAm5fMLtl8Q7kNvwGbCR9Z&_nc_oc=AdqQx1VZCzyAFw6HrzuBTv77zm3pHrVCoZu30d8SgzMHse4kfKdzh7hPPQCDvvPM2oU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRMt5WcjDhSqjwvkpbVz33dqrkm7Mr_X8EgqsyVPIuMg&oe=69C66200"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
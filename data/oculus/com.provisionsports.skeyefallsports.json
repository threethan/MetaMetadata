e7l4T&_nc_oc=Ado9azDSdijrBpBfkqnrRKARBZ_Eu0BzyohsF1BNKVqEH4stwIncjyGuLf-nQvvMcK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSQw2x86Ve_znytvZu9RBCmQ8S45X1g1j1rRG8Ob-1nA&oe=69D0F5C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9KHHPD7ASgQ7kNvwHdc8ac&_nc_oc=AdqnRjMxW2p88SRTd11_a70qiByhyMzhuWqOFr9hiOsFhJs3tfNC2vnue_JwH1Tm71I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCJ_AONSxIhwKz9wSvS0RPC-ibHZx9ahZmuKM4HQlS-g&oe=69D0F1D5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwf_zTEAO0EQ7kNvwGAYMQq&_nc_oc=Adpcd3OGARst6BYszK6PXfC8tFL7R8xIwRC7oSU6SxglNHPgjwI_z5LILR9J9VSYraY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLok4XsSKD9Y-8ETaSZ2x4LmmsIlv5Y70taDVylz4Xkg&oe=69D10903"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_Gx9uz6pOIQ7kNvwE09TMU&_nc_oc=AdqyFP7t5VVhgdd2msX7qT_h5Y8YRj6yaFyjmadpfA3e23f9mynxxNEpeDzBBwLXTwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1yw910A0LWyozThXSlOYzNCr_bjKsD2GObpnLErPB-Q&oe=69D10878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCjCZBsbaDYQ7kNvwHF40FM&_nc_oc=AdqsgxJU1vmAkDTIp4I4-KQ9l3L7SX4sV_so0v3UViF7QYQLJ6ZO2LB6lCXZf0adyFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe0owZDU43YQCLs09rn5-fFtf_HNcYLC1lfncWWWZ8qA&oe=69D0EE00"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
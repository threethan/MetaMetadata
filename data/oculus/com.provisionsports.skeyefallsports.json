9EWqfV0dnvGslYZWb0dos9MC7HfeuvzP_qbJF3iUHgZOzkyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyq3VKMEtu_vWNlPjUPh9NFciMPNvdX3-7n_vtK4IV4cw&oe=69BFD246"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYLaEP-jkP0Q7kNvwHkio7T&_nc_oc=AdmgEzRcbIi6P2bU9_0NAv29Qda3TuVCuq4K1PupF0eiXsjzxApwfy2Sz0xwRqMo1qs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVORC6F_bBJ-_7tikSKhHZiINoBTP6DngphyBTnO_Nsw&oe=69BFCE55"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hDdRHgcMsYQ7kNvwFRi8Se&_nc_oc=AdkXpTkIAiYMRLouDD-sDSQHypyQuBASyV6mZsWFKs5HznE6g4BfuUIRa5v4C7QF8Fs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1LPx3Vi6akS_LcftNw8kAYiUC8Ej6H-ZmE0d4d3o8ag&oe=69BFE583"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndiQKu2kCnkQ7kNvwFNzkVT&_nc_oc=AdlsG7GZ8lkWIaSt3Lwc6O1jQA82_mPydx3jc5mRDOFKkczlxG960kuu1YKwtJJ4iMM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkEcJF5D1F2h6psf1fC99zAVT01RMQI_BInawXiQ4Uug&oe=69BFE4F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM4nljVUuKkQ7kNvwHFkERo&_nc_oc=Adm4rDCp61rc7rhDcfys_CNxy7BkJFIUGE6zj6UQRzk1K6lvffwlbl2vitXKr1U69QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1LDujyetLn69heiu91cS-3od-rNs7q7G47BGtVLLOdQ&oe=69BFCA80"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED"
Ir3-o&_nc_oc=Adoo2JfZ1beEJZSVbFWE449fFEPly3BYTXMIaXKRlw-rV5PIA5-EMin4kPJAO9RcP8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvgp5xDt7EHD0dQnK5k2O83UB2SdHPYEQHtdU0Z6L6HQ&oe=6AC7B686"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGqXFe9UvlQQ7kNvwFx4oK0&_nc_oc=AdpZBcaP3cDrx9YDu95LBpNPQAXD1ETyAlp-iG5hLCqRsoGxWmDF4saFvicVwhsc9nk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU0qRli0YXhN4tuvIaIvt179HwbIIddEPk_y1fkMj86w&oe=6AC7B295"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krNLaAmhbuQQ7kNvwEdLTxj&_nc_oc=Adq62YihbgAI3KiHbO_AOuaHlUr5Wx71TSqGj7Px1if7zzoIK9y_3OOO1LPyXHM73RU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF6e_jmwlZ2fa-JDqfDjDzIbqoaoPiUFXU4RBO5h41Tg&oe=6AC7C9C3"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkZNlfvarFcQ7kNvwGMcOMn&_nc_oc=AdqJjN6r3Vf6ovjB4zS6LSvFWSeidN6cBKLYq1idmrwus6MfEejs6NCpG2rc2kkmYLA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfmG8JCpjAaMwhW_PSBgPtv5bmQWFCGLb_JRDgfjyx0Q&oe=6AC7C938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELmQhwRkJ6wQ7kNvwE1i8pB&_nc_oc=AdqCnpP0zsiCWRzPbtRVpMB5W5DDujfH_wT2Mv7Q4aSNom5eOGOd9ZB-gsyapfoMcOY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu2Db_1C8oNSaXhaUGxqxnG4rYAkL2BzUpJ02zyXZmcA&oe=6AC7AEC0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
K0uNi&_nc_oc=Adqcl2lYIY4TlYJkIYLmn88MCCsiLk6HVlAXTi5Rvs014EeNyjKeSxOuG5TqzMtfVTw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RloMq7ZvG9asORXDVB83A1vdSknaRr18udF_xUfwVOg&oe=69F4C686"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0wgLl5f6ZsQ7kNvwGKrgOE&_nc_oc=Adq1q-VgKN_JrqiTlpnGrQwWki55Mv37jj31kDsb8ovzbOWKoxfhA1DtiVWacc82tqo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zSJQwW0UtrIvLZwvgOarnrMTeisKWITCXYnDbKscY_g&oe=69F4C295"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C66gni8F3tAQ7kNvwGJfnw7&_nc_oc=Adpzor6bMh32hS0eFqDB8HNTK3cJvPfzT8A0gg8d3B1wWHxezUHvlqGhehzLLQ9iDAU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MdQnp8hMkVboZ-POYkT-Qg7Jem31LVdNtZvrMJt6unQ&oe=69F4A183"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2xPk_YB76YQ7kNvwGol3w3&_nc_oc=AdrUd3mctJYmrGCO41-turZhFbK8wmwG6o8QebnpXz0HbGYeSOR6uHTFeK1mFMWKhuY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2b51xdt85nv21F0OgLDAb5V-uyrpZQCeij-ePtZqXBmg&oe=69F4A0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGS3Cj3AUaoQ7kNvwFC5pnC&_nc_oc=AdpJcQqh_n_mmLYUCIz6Ks1zah_qz9j3-uiDbl5sKQ9xaw7fpVdonAXAaGWRuvQFqYo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DeM_U3FpTOIs-WRrqBa0YLhzVWJH56xkV9LO48W_eKw&oe=69F4BEC0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
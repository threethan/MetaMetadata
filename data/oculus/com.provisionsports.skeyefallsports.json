HQ7Zd&_nc_oc=Adqn9zUqSEbjONXKqae3DNSTEDJUG9xhwsjpr2ZpLWar6fHUe4HTDpOnEvq6pnc7oTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1e5Bkh1naZIt0rBmW0Iyu8s82As1iFpvSviNQTLgJNfA&oe=69E8B0C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whyzp4YsBwoQ7kNvwHwXPKI&_nc_oc=AdpOIct5XgYy96kmOB3f0Ha3egR-ZNO4LC90rIk5-_G6CYwabVvSTgw6JKa6teH-yik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06Emb3yceffHDIGXFuHgrlm_2v8ZA5coD8tKLH-9obsw&oe=69E8ACD5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsMn-7WIKH0Q7kNvwHukj7A&_nc_oc=AdrHKOqA-DO5QJnreUghBpTtzywyOqI2fUhFyhkV7uYmLqfgeXWLDo05Uh96urm6jHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29mNAQnJa12XIsHZkStxOwXZgqXN86lyxkM9368_dziA&oe=69E8C403"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5CE9o2BqCYQ7kNvwHdeNvg&_nc_oc=AdpV9AKITbhTONwuT94cXsaRBBSOo6uUCv1L1qiurD98Uw0nABendOIrnVNs-_cRf_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mQlWWApLhyYxzAVy6HpfFv5V9QG1m4qRD-h0siKNM0g&oe=69E8C378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=443FAHwEOicQ7kNvwFHXtKB&_nc_oc=AdouTstAsp_LpgqoK0se9CEj8NIQGYL9HZrcFBIfUKcoXuPUPqyDL83RL-LOC2KGenU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rIDfKp8aWXsAGiZCD2mGJsyH5F_rgBoytbnh6Z1tOlA&oe=69E8A900"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
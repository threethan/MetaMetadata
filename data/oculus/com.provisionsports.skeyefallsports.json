svzdsLxYGyhv4xUVu8mHMclejMYQBPOQtbqxcuD0nDavASeo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyjjw-qnqnEZxMaxtJIhP454Tbz4BxMQdP4CwcyRh-DRw&oe=69BD2F46"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KswA2VPl76wQ7kNvwFeZ_yG&_nc_oc=AdkmLPdfv3xYIvuTzV8Em5OBz2JgvfD42ZnXs3uVnH3cjTXO6VXR1JpdmjHYnVdhf7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSIFUScYHSMCXlc0BWV5en6QFPc2CshMUVzJfTLiWGbQ&oe=69BD2B55"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hDdRHgcMsYQ7kNvwGwy2xr&_nc_oc=AdmLjW5yqyEhPgTAIheNzZj0P0Lml6ZN8UYtRZa0zGYLZgCR5z7wZ_02a3CFk1WQnUU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyvXn8LWjMPFO2JLlERu4l3rFA7YyHlqcLV1jxQwZHo0w&oe=69BD4283"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MOgWNRJmNYQ7kNvwFMuWu3&_nc_oc=AdnJbYlEYYwR2OdmWDPAMNzIbFPolThdqG81t7_fZVrftYAAd7dIDIPAbOnWWxpguDA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoNtzq8xCFgzqrLblA8_YbrYtw7jaw4PvrinJb7TWGQA&oe=69BD41F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM4nljVUuKkQ7kNvwFoNVbE&_nc_oc=AdkYdmzyC6FgvyudEZhvjPcwoQh7YW1Tph1BiWEqhHemdx2VZZjwgQQ-vk1rwNJBLY0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxP0bADMyGeRwEdoNbw3x46rg1mzCZTK93ANn5MvCuZA&oe=69BD5FC0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/", "category": "GAMES", "comfort_rating": "NOT_RATED"
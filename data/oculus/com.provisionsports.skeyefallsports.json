2T96O&_nc_oc=AdpaaME4LhFFlZzLYb4fhkOeLYGciPeXC3EP_SlDZ26mwJSFzxtyJNKcbOJv466Nz3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnfXiIk-UFmzRk7MKFp3qmSHFh-BNGJczsBlJKXZWX4A&oe=6A786446"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdDpl-DvaE0Q7kNvwGKklEQ&_nc_oc=Adqtuy-PpQfk9iq8GCq3JhO76_40AVYaOQ0aSshL-jHuwpIrSfE_BDWUEUJk6OKqJcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgFxId0f_4wc7fSJOvMFssEHMAKnx5TZGxwFzMSfGuvw&oe=6A786055"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua0WGicNoM8Q7kNvwE5R6TF&_nc_oc=Adr85fIumJIJrNgRB_SO_g8OZrDSQykeWMfsHm6Q_6Z9xTpjgzBjEvXxxBCZ_1dSpoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPA75qMXIg5U442K07uSet6zxoPUbHHDNrmWymTAcxPA&oe=6A787783"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goUBZ1THELIQ7kNvwHVtjnr&_nc_oc=AdorTkAnhjvr-6M_-znRAk7gG7C_Ai5tous_Hj5RXBypKWw3IgGo9xcXMacClbL0IoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZh28Nqcq2CTlLEEbn7Naj32fEsIyjOIjTz3RPv1zklQ&oe=6A7876F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW-3d_WgmAEQ7kNvwFk6sRU&_nc_oc=AdpzR13NL3_iLWZMpMPz7c_KlRjB1M0zyibE8JM_3Ob8w4M_R9ORuxPWqynR0wWl0RI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB5NlqoIl4_MDEVy1920RoJ6_s2tFkId1vS8b4ANaP5w&oe=6A785C80"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
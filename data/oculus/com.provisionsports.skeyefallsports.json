-NQBe&_nc_oc=AdqtTjJFV8ZB2n1cyN5NIImIyYHHng6swhuLzY395i8Vk67_s0KhmkR1wGrlf-xerC0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqXIYR3xo7zen7HVMcj9bcLdZGr9ABDXU0XudDubJ1tA&oe=6AC90806"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZiKpz_14OoQ7kNvwGYt63X&_nc_oc=Adqj-nmlCsltaAE88fmuj84NnV_9W9B0B9JVLtojnQyVzMq7FsgA_3NN7wV5uSbeY3E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpzvY22yLrWl-Yt8W-Hhtoko_-Er2A_D0O7F8ekditiQ&oe=6AC90415"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krNLaAmhbuQQ7kNvwHfqMNs&_nc_oc=AdqH-8KQ4jCFknvOzgnvqghNMT6ENT4UtLIvUw3vk613FlUCq9me52StTAID9S0RsEY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH04LMfkr4tiZIWCYLszAMsYPd5DIRr-stbcFqt45_7Q&oe=6AC91B43"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkZNlfvarFcQ7kNvwFCDLa4&_nc_oc=Adq4c2yVfYyn4hB-iVINQmtAUQg4rjK3TTrsZ1AaeyoLdTpSohvSf4NCs6D113AyvTo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx87Qm-YnvEZPXCiiE_naI4DjZGEIbUFrlsNofl4oCeA&oe=6AC91AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELmQhwRkJ6wQ7kNvwHzQOCc&_nc_oc=AdpcN3sLHsRLcBei4u-5AeBaA0TvRXliwOCByUT9qw8bpq_q6p0Q27bQqs3BlwLfs4U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNVyjxrWaXWBa-ZORxokKUCT-p3fJQq9cP5AlthUk_SA&oe=6AC90040"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
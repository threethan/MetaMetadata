cLFFJ&_nc_oc=AdqfZo6cjrSOCaeSw64y7Tv52vs8L8DRxlnhfcomG5AWtxbQoRSVd039CSejWAiyr7M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjHwQgSnRvwL24B0diy7BStJgU4vWcUkRuYJzwK1FJ4A&oe=6A8987C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMitmMmvFjcQ7kNvwGR-LPI&_nc_oc=Adoao_yJ5CncjOtcbK3HHC8ShwnpslHkTFBMN7_nIVniTih22kA7AwGK4UKJGE5LMcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCAoDxgIKtirDDraMh7QQm0wTlz0vNXwYyK2lIFLujKw&oe=6A8983D5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdSN8iXgM9gQ7kNvwFFIGpB&_nc_oc=AdpAsvsk2xKT6h0Ac7S7cBzD6imTmeJYfdV_7fVD1XzuiGEqZFx0D30UvNxjQF2hrHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDwqnPR-HeY9sWmcD1ldA1YUleVkprFU59K5NjBsDnMw&oe=6A899B03"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoC_0_iOBpAQ7kNvwFCW7we&_nc_oc=AdqrRUCWpE_3HyLFGd-U4Je8zfrAbDqL5mPwTJUSb1cVJ6IzjlkPn2Ki6pBsKFyJXxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLvr2iR0cAiq52cunCC3eN5XjURS9cKWKkTjzLs_gHJg&oe=6A899A78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9mLyw-iiQYQ7kNvwHZEpsY&_nc_oc=AdqIpBREVjpXSBWgN3_AFJKxe9VlohpDjCpwRPNa3VevvRhEL6zqCtfmSX5NQw8Blsc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTqbfH81_rXnE5IZ8Tgbopg0WC8jacZkCJD5kVr4STAg&oe=6A898000"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
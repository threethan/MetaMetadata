ZBLbF&_nc_oc=AdphXaCdio-C5vzmzthzg683ELWwUgL9aLn5bAYheXapILer8eeCOBv7nl-cdTj2eB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6j788W2mWibCRQpj-5I5G4vqvRl3iIMg9XQkPnyx78A&oe=6A6740C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwKjyn2Y63wQ7kNvwFgFl_l&_nc_oc=AdqkREqJL8kYA2305JS-tPvdBfpVHmnxXiUF_hDMyuEnUEY3PDtBIROMKZjc0iLtw54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw-ICtPOctxGWC3YwFYwx9EU1gqX_N4qzTPmBiNJYp4A&oe=6A677515"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE0lN_S-EIEQ7kNvwGtyjGC&_nc_oc=AdrvLnm5NJO7-wLQMKutTLiPIeH6DfdBvMgNDxgPi938cnrOsO2ZAffJ2u-KYeZkuSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcCO0Exm-sQvciTvPNSLgvheZ0eSVx40IQoovBndgJaA&oe=6A675403"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8X6Jvef9NEQ7kNvwFn8uv4&_nc_oc=AdpIc-hKwe-ly-WoGGYhtsRnIuObW_qglIff3wEGQ4SK2h2dUWRIIlC6NZ5EutnSdbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUMaeUcbNorP4ev_87nyG1iHg4aGYhRmkIwabguUTiHQ&oe=6A675378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwB3s7RUD6AQ7kNvwHDtiBD&_nc_oc=Adqbv4G7Ld6ENtfr1dgYM0OHEfhc9Y1iggxhyUN69uwQL6xAEHAg0QroLJu26cf0MAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5CerhVFKKw2rZF1IWMhPk2E440WWjTXNhrHT1UOr0JQ&oe=6A677140"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
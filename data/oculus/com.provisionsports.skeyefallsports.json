sr0ux&_nc_oc=Adq7Bn8hooD8HO5BDPqkZEcy0VgFKN7ZJ1aTauKtdOEr3HtLF3sJs3E1Ka0HBBamWQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKeRq36eGUGfVsEzS8oFN0io8wmV92Kh432iWVCdM1JA&oe=6A984086"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lzqSzGS8vkQ7kNvwG-TV6r&_nc_oc=AdruUjVlzWDx_cl-UwrbCV-Tko-qd2EY0_7ck3janE2Hj4ULRQ1bHD4d0OqzPlNxcb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW3gErFZ9cUBsGQjxiwSUzLMvuA6NdOvTgZ_esLqjGxQ&oe=6A983C95"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBBGf9JQSi4Q7kNvwE3i-dG&_nc_oc=Ado8dPFvUUqX02mN-s_G1gRVVZj7IBkfCZ5Wttmb9RsUWQSCYaF1qdbMHw_zWLnq5Gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWLrvvorED8y94Lus07iBt0flygC9IleEAOAaMs_5JHA&oe=6A9853C3"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLbbmAM_sqUQ7kNvwE31q_s&_nc_oc=Adopqz9kbdyCjK1cy5-5KHr6cK-fCIIGYXVjNCiQ217gY7bMPJx5kg9UkRSa8vrJbZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTfqU101ztLxlgHPT0ufxLyT0qyXhXtLMqnd6QzkDhHA&oe=6A985338"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKMQum1JNwwQ7kNvwFikpCo&_nc_oc=AdrnSuz5HvvxYSlEEsM1enHZa5ZFFX9fTM97KYjP-AUXYcNK35Y5dNV72Cb3_KfSOSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKIUU2CFU2bL5tfrOr5Cjra42aee9tIIoXqx2VM6Eulw&oe=6A9838C0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
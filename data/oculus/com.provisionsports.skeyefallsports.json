2hi3Q&_nc_oc=AdoPiLrgh0knmJGT71iFPP8tw4tQEPyd27kh0A3CHmixjdZL36fEm75XT0W9TMRaq30&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsrv5Cioxd37KicSwMct_UvaZlIJMhScZ4C0JUXiMlSg&oe=6AC51386"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGqXFe9UvlQQ7kNvwFww_aS&_nc_oc=Adrj1lTcDpXYs2Wx_qscI7N_eXXqpDlq-g21RvcV2AqbWO1Pqzs1ODpbLpnPykF3s-M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaPvHMFtNn5bCuCm5pCseJwioGvmwrNMC5rhhtr46BNw&oe=6AC50F95"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtNZjTLWXEoQ7kNvwHGBpFI&_nc_oc=AdrfWp4NgiE0xzTZekXMzBIm-aRGxNOuZr_7IwR6k54ybRQxOyw0WmxyC_52-02Aks4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDUYT4w0LW_XXD3fJey3fbj4dak3bxQEQ1q43l_lz0ZQ&oe=6AC526C3"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5F6xAAiNaEQ7kNvwGED-HM&_nc_oc=AdodS7kkGLYPNA7q8uC5aHy4YF99QxerWzA5TRZLCp8fcJujrdSguGWSVvYEuGIRMg4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLjCiWl52hpK6Fb_jnWEJbZHPsIDwSoOs7qClTnsey0g&oe=6AC52638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyETs4coMOoQ7kNvwENkP_G&_nc_oc=AdobMqnAZ14tropPeJIaAdb4ryNNpdJWHwwpJ5tXKN7poC_Z1mmWzbsLFEwtZ2lou18&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUPgSpmsH1VpdsP17bmZoQm6XmYC_sW-pwa3t9_vnbww&oe=6AC50BC0"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
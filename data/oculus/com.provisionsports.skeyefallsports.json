r8nmK&_nc_oc=AdrIo0TW8uTg5bMOA54IFzqJYn_4j5PrcocWt-tUYREORv3bWwyWZfdc2BiV8CCkfIQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqELzmdV0TVYn50ul7fcMQLiZKWEqqC47VYn6FgUm7tw&oe=6A8AD946"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMitmMmvFjcQ7kNvwG5nirI&_nc_oc=Adp278X_Yf0JijPWZb8JfDm5ILiZ83RNgOn2AtAiIX3QqUaqrt8A-O0HVrfylmT2qnc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY_-RkK-pzyuTZYgc0f9m4GMv7FKo_NuNj3ku-yZYMIQ&oe=6A8AD555"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhw8WmraiWkQ7kNvwGIAoB9&_nc_oc=AdqQccdoTf6LlAjg3P5IKd71aAUBH8fp7VqO0un0HCgX5ClRy4Mq0ew3AmNS-2sJzA0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1UxCn0s6KXpt0HNdw1qT2c3AILm_JrC4uQALXkig8RA&oe=6A8AEC83"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoC_0_iOBpAQ7kNvwFYHkwN&_nc_oc=Adpr7lla6SG-MglkZFC1IG63RH1GDez1M16Lt3sR2ogpxAEceRma2-fA1TxdEUA0vac&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD6YJ-v82mK0OgFKXQFuOM58vrTc-hei1E3q-mUM6fsw&oe=6A8AEBF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9mLyw-iiQYQ7kNvwFV27Ie&_nc_oc=AdqIsJkh09Z_4AQNK6Bp0y0JYWAGriIgOOkyg9xWj_2tRyaC01cU280n2ixXX8HmmRQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLXPFq1-8l89WNAMxF13ZUJBiaDjGHkWI4HRdd4jYpow&oe=6A8AD180"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
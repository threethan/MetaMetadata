yuPks&_nc_oc=AdrrGMw2AMlTu2KYFWmkGnT0f5wV19x-TZZoopWoBKfDSzRbWPjWEhXuO4KbJKMi1k0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn7CTVFIRptmm_Kxhky9vamTomo3gcFfEW7K2kduCWCQ&oe=6A7C58C6"}, {"file_name": "Frame 3.png", "id": "1238786690221020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982710_1238786693554353_714730932884703314_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dWJ5NtbxLsQ7kNvwFk03fY&_nc_oc=AdpZcrGe20KIdYN8vLAQYRSOyofZXm0gz9KWzF9Z0UEpHg1h4nQ-FQuHcaCJMyyMEi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYhWhd1DDMzYApKItbyje1B2N1icvGK5LLZHQopVfmUg&oe=6A7C54D5"}, {"file_name": "Frame 7.png", "id": "574631297530523", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974584_574631300863856_5061623237791822213_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCxC5GSH69cQ7kNvwHw8cV2&_nc_oc=AdpzbH6Tjv0UTTZp6gu7O57aitb7qZMd6Yh3pVhpFeeUfdNsVlgPc4hKIew49K8_JkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoCPlHZK_mH-lobKLymWCVn2r8sr2pgmZ3D8NrniH6RA&oe=6A7C6C03"}, {"file_name": "Frame 6.png", "id": "5497722673649021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974497_5497722676982354_345368716961418100_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCcO8ebGPY8Q7kNvwHiqyZm&_nc_oc=Adpf78x7NSErobLtLTO7fBA0CgH717XkT-W9_PUE67vtWoaW7S_HxxDFTzlaWv774iA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxNbZARjF7YbOCTbwxR1FWy63joC16N56v7oEedIHPKA&oe=6A7C6B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "309102244373880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195902_309102247707213_6299735279736006057_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seltbfeRcRgQ7kNvwH_p4_l&_nc_oc=Adq_Hdxi5EpkJ11GQiVh1c-zlDH5m3-WmpR3OA_PpGULJ0_RbpkHbhEI118EaEmbh5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaInX-Kk4-f3b7yDVxQkakVu1nyEJ8Z_bORuXHiErFsA&oe=6A7C5100"}, "display_name": "SKEYEFALL SPORTS - 3 IN 1 - SBASEBALL, COSMIC DODGEBALL, HYPER ARROW", "keywords": [], "long_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro sport teams to train their athletes. \n\nPLAY 3 DIFFERENT GAMES\n\nCOSMIC DODGEBALL\nDodge, Duck, Dive, Catch, and Throw your way through 8 increasingly intense levels across the Solar System. Cosmic Dodgeball will put your mind and body through the ultimate test.\n\nSBASEBALL\nIt's like Baseball, but in Space. Fastballs, Bombs, curveballs. Not to mention the 7 Pitching bosses that you need to beat.\n\nHYPER ARROW\nOur best and most innovative game. Fly through new worlds with this insane twitch fast flying race.", "short_description": "TRAIN YOUR BRAIN \u2013 IMPROVE YOUR GAME\n\nTrain your vision like pro athletes Steph Curry, Lebron James, Jose Trevino, and many more. \nThis is the first sport vision training game that you\u2019ll want to play.\n\nSkeyefall Sports is the first VR sport vision training system that will make you a better competitor no matter the sport you play (yes, even esports!)\n\nSkeyefall Sports training was designed by world class Sport Vision Doctor Keith Smithson who works with championship winning pro teams.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/d679ae80-c566-452b-8a41-9e3a1a934c7d", "developer_terms_of_service_url": null, "publisher_name": "Pro Sports Vision", "support_website_url": "https://www.skeyefallsports.com/", "website_url": "http://skeyefallsports.com/"
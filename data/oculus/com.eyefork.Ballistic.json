Jn6S_5NhMDwQbaLUHq5K4ijv3byKH1Rswf8YbFs0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhLQ-ZEcZpkOLO4NEoptA-n6cGX6AN9cq3GRdcE71nww&oe=69AAD6F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd7Cj2c-_GQQ7kNvwHIXkkr&_nc_oc=AdkRSYEwKmE1iKX5Kh73qyIneqEDoX3U71veZY_urAVL9QXRMdmD8I8-VBeJbwL3X2Q&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPIb_oSUNE_rL_LxG-kH7s-B9E09Flh_0HLFxcs-PxLg&oe=69AADEC9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkUawhVJVYQQ7kNvwFZkp0x&_nc_oc=AdncJj4gs5NYUUoUMb3bExosY0G9WQGvwCCrfmrZm0iBRljXwWVppvwwulxCjN9jK1A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6iUIlvNtLy0iFrAlXP2AbOnaCHTMiU_xNfeTlMi7wcA&oe=69AABD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVPArZhWUyoQ7kNvwEpYEji&_nc_oc=AdmJSQ2IutY14h9CQRxuP4jPszSnzsO3uzqNlmre-c6x-W4cXWWbQDDUH87IMYN7i4Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw03NL2wtYejq1PoH_O4eYrVrgxmggRVL4SiiH1af5bdA&oe=69AAC0BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zlo81MUkUl0Q7kNvwEDrFrv&_nc_oc=AdkAhh2LhEMSoPN7nwF1XtVc4cGhnuEtoZ62iTPl93PB59aHw8_K4BtxNZ5Ml_pzYsU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8SyCIS1a4x5ISlf183DNbgErqXs_O6kXNqqAVXezmbA&oe=69AAE3F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "
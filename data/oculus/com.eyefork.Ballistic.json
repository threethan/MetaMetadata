837575370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBtBBl--lkYQ7kNvwG0bDLt&_nc_oc=AdoF4-A6eAxsGvzFsVBVJ6QdbyNgq2yCQbaygsPoEUNduJ4o8OXyrWgh9Kav2MfRGOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTltcU6LeL4SoeMfbdREU5DBu2ik-0LGpQk3qaow0gIsA&oe=6B072309"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIXEEOlYSZwQ7kNvwE_6F79&_nc_oc=Adp_J8babInoQ0VcIJhcFhQupAnTo85tub0ElJoziBPUO19Lu7IkBmReUaUJmBNrKEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFNRhehI1ijcZIoabka4zCypw8HFgp4nCzi_3E6oixOw&oe=6B070147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF73ePyUGgEQ7kNvwF05U9w&_nc_oc=AdpVnUrX6-LMJ1hfDkPsvMdHntTx83Zvd7WJJ_TX5exDgd187YjijH5ARaedMzAP5vY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2JJOcroFWeQHXVFMMtqcJ6I9D3EbS5BmTt4_8GadiwA&oe=6B0704FC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
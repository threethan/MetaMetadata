837575370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGl4FLVqY00Q7kNvwFGvPQb&_nc_oc=AdqT3UZqd82-O23kI2wJmfe0Q_6F8arJAWEh2wfGIar-hoDLTFf6RxTkNnGXhlNUDZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVjjxxsNZ_wABhOd0TovLdY4TCLtUXQQYYlfkjHCW3mA&oe=6B105D89"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsH1uizfH48Q7kNvwE_b28x&_nc_oc=Adp5ETT4i4fUWD1g3LK8uyj96s2s30Cvf-2VsLkj8AV6WP7neuslkcK01757-gWXIKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEBQmX7sTq80ogvgK9IpHxkrQOvOlWwRXcrU404kgxSg&oe=6B103BC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNsDX3hX4L0Q7kNvwEoncah&_nc_oc=AdoYj8kamKJWLcLkK188H5HhAmymhakW3ft8f9zp1GfvkvDBBeXcETERw8SWo3SBUsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8LfpXzZb8N2gKSdTe_DSaWIFAAKdckSgsPK2RThX_NQ&oe=6B103F7C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
H&_nc_oc=AdoF1FGe9Ze_D9x7yn2dxnsQnxQfNU5gFgrac266oF6Q1kZCrlDw7Qvl69lXIoDj98I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCmDQaGUff9R9_XXbPpKpdPeX22s7KYWiDqwBKWS9LbA&oe=6A7DC6F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMC49zUQNFEQ7kNvwETNlfE&_nc_oc=AdrV9F17DXER8jjyTwDSljCYNy-vWOV7bpJZQvfnJf2w-R5aU6uN4EsYjWKiotUVcEc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq9JKLylxTPwLXNUQJFSQLXdCKEg3n7ETz1BDSV_u1wA&oe=6A7DCEC9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY0HSTMy9ZcQ7kNvwF1oTpH&_nc_oc=Ados4-76L1S25de6HzPZio-3LuxtqUdfC-01YG9Yj7j1bftjz8dg8oBDRDVYndjIkbA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFer5MVguSzTtabpNbdF4VZgejNteBFj8CM4HJDpRJRYw&oe=6A7DAD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEbVHYykpSYQ7kNvwFl3ZP-&_nc_oc=AdoR10rgNgEt7tpniAr_JjQcXQ9vC-2M254lJK0eZX9zVTxv9OO_9xgyx17aB055b_E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW-fSaaylYaaZ6PT0naPsj0flD4b6sEaaE7PLRpP5hKQ&oe=6A7DB0BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLVt-XWzZpcQ7kNvwFDrdJJ&_nc_oc=AdrLTk58OkmBYR0BSP6E8VaNsIMCOsy11P4VozOhGdUXMpOU_nutxRYIQlmElAqs1Sg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgm4g78N8_qkoNUFi_2UgBONHspc3vLtin7_itAYUtQQ&oe=6A7D9BB5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"
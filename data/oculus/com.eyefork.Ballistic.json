oc=Adq1cTqZoSCpmqsB0dqYRYKhbfx9J2JzUhQkpNIqNRN9dw8G3aE7DbpuM3l1VoBPP5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2o9VuxcNyuXAyKa8sDISBhx39sv81BDUjJqPiY59r7iA&oe=69EB7076"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGqsygPV0EoQ7kNvwFlQq8Q&_nc_oc=AdrY_ZVEY6RmE1cjvAAve8rwRslfwgqR7hlIT5ZG_mFUMTrad6lG-fEshIgCLqnyuTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oPEgaSnesjF6Dv2i6PyVSLTRcWGg-masaGPgnCKIezw&oe=69EB7849"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeUUBIUKfiUQ7kNvwGfPbBJ&_nc_oc=Adr4eBAPtIhN9rry5ASY9YgtO7Jh5wFpK6ifheig0NXtjzCsj5mum5oA5NyXspJWfNQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oXddQbLLOJnFAXgI57ssNJZt5Jl7n07ewS3mWkt11fA&oe=69EB5687"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zolb_JiujU8Q7kNvwH0lKIL&_nc_oc=Adr8ELJ6G3EDveogsR1-5vF3Kdtw-vBN5p3CyFqIep6JlGgbglpPGejj9nketO1G984&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u6MLkqkDfQDT6R4Np18iKpC4NXFtnsTPxXwSLVRoTYg&oe=69EB5A3C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zyyKb0uwrgQ7kNvwEbMlEN&_nc_oc=Adp1OArIU2Qhkj9q0bJA-FBZhlYrsvaNn9GVE51xmEnD2d7izyOp-dtF6irkkmBFjl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yeDkXcXnuTt9NoAeMavq9zo9suQSvmdggxbKK2H76mw&oe=69EB7D75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
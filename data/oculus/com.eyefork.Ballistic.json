oc=Adpqop7UmIDDenRD1cOhgKhS4GMfbDFIq-m_lkgvmJy657gWlNzHrn_lf9MhPX1HMgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLfO8b9m6dr9GrAGqCNA_QkPPG3r7TB3-SiB-ECveLDQ&oe=6A772F76"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5hfirxKRuwQ7kNvwFNjcaA&_nc_oc=AdrMK4hsZYozVJeYuml4Q5vO1qg9ekexZXYPLzNyVPQ7U45dd57mxSp3SJcTuNhPl6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLJovvnH16-ARTN3khfFT_1AvkqqdJyA7E2X73x3etdg&oe=6A773749"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z60vWz_WOlAQ7kNvwF5-fkD&_nc_oc=AdrXinLxmdLo4Ted4BvzPZ4QXTyT8HJtiEdgxHVdeXCl22OfnT-Xu0VUqZJYlM4lxwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDAhH59wBt3CXWsZubYbdMrjI6SHD1BlhLUDL2NY1ttQ&oe=6A771587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIfBWSewA-cQ7kNvwGCffpL&_nc_oc=Ado-d-G0oehet-TxKmQjrNoqD4Pr6hDvrHbJSN3trChDjvK46lFqgbL-f_hYysoHxGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKmm6O0bjYyCT66sLDrhfJDK4vikbWQyLlKtZi7Ge01Q&oe=6A77193C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ArKID2exlwQ7kNvwF_f4GY&_nc_oc=AdoinyRpd6OSRKwr9UmRnNdY5tiLQXHzmoSBc3XQ39Phu3N9i0PatX7vjyCUDKv7wRk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkATtG5NlDmHUFhunOiIkfaEoXmDjU_-l3S3gyqQbFxg&oe=6A773C75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
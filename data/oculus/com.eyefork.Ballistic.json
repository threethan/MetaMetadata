oh=00_AfvwCaXzbytB95hUAatoEvlQ86Q2ouZpywSxwlMBkK1b7w&oe=69A6E276"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew4eg4KDN_wQ7kNvwH1oc6W&_nc_oc=Adm3hRevMJwam8VjM3kXIDPztRnQmorcoc3bPsTsCSBGAwhBHLkjGGZd-wSJ8WA-gb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuhMBRv3-wFUHaA3aDknEAE7swrwAfDK8sNGd1lf5zWww&oe=69A6EA49"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_R0-g7EGVoQ7kNvwH-Jlsm&_nc_oc=Adnqitw9lUsjbMynSXvl0V_Y5Ob9lgnSEm8ph1sagfpsENrVCpbvjMN9D7z4YHcmVyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-kT6UvrCieg9BqjXiBvPEOu75lEpRXetAElBYdeWxoQ&oe=69A6C887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JGMhRzU93kQ7kNvwHRE9l7&_nc_oc=AdndbwZ8upjmur4tipDpIRljBZ9ZSByA_WQocVszZ_gXrRE3iXxyTk3tvVYmSvqz7vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuikarUwKlEg_9oxp3ibpPwcdvJnGh8dd_KMPkUFMLaBg&oe=69A6CC3C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
oc=AdpEHhX_FZJjOLdChX4t5eaNo5LRK91jrHuD6UiQQaTVeZO7bBtn70RgmMakIz5SGys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5McIbnjLbYTFY4a9yvczv5Zzu43y058krWtPR0M_vD2A&oe=6A008876"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xoqPcan0dMQ7kNvwHGNodw&_nc_oc=AdoCH5lajZBrLzghmKpOodko9YysCZHb4Qs65BcADPWvsxTVaGaXu_0Us1zpq5TYomI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SgWUCwAHbDXhoFYm0U6m1TPViy_CX6ljv3Y3GXKEpzg&oe=6A009049"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rX_bzJOhIkQ7kNvwEhG85H&_nc_oc=AdobINi3bzi8bVSrpzo499d3Hqrzn4p9kqcMcit3Ybaban01GZicwiut8qB5ynPtCSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EaL8aSrgwijZUw1Kpq4H7gEkUnzP5A6OxXmQbVtkSgQ&oe=6A00A6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kosBrJZOSAQ7kNvwHBPLXS&_nc_oc=AdpY3JI_GyjPU2AgQAOUnlB7bqjZbUPBpP6DOk_CwW3lLVjOApHOTS3IuyR7iQoiB4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HPWAfvc24FvLSd1w7JNhvoQUrw99_FYHLJSqHmSMNng&oe=6A00723C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFvMOkMZ4HYQ7kNvwGsXCFS&_nc_oc=AdqvNaeuSwaparVSF1EpfrdjGDmBijediaS6QA9pGh-vLu0IRsvalP0DoZ6SNiPuXPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NaCIBovdoMPhn1CHDCVXxtFnhCd62EccjNh-m-ev8Zg&oe=6A009575"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
837575370", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBtBBl--lkYQ7kNvwHDLRAS&_nc_oc=AdpKod7VhduO3rpHQeMnuC7k-UWs9sn-DrNjRgtjciFdsCkOJZ_MlB2udI2kJgODBRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3PnaNL_ecDmK3RA67fExHbOyPaEOgRCOFdSeNI_PNTQ&oe=6B087489"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIXEEOlYSZwQ7kNvwEE8r5p&_nc_oc=AdqinZd8XrvenN1D755_dCORxMaeGDyuTBfQIiNyR7Hfw_hfUPbf7b-Rex5BJdZF8Ic&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJMxOvR6lTisW4-IVvvHeurHsi-FH2rvt53D_qFOTkSA&oe=6B0852C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF73ePyUGgEQ7kNvwHoUsAp&_nc_oc=Adqzj_JX4TD3PaNE_ALbvJSBlbS2xGFUm-kjnJQBUnkHyf5MYooCunpkcz-kt_OP_3Y&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfgYwyjkYemxHfVKYLrckwlkGoneeS8LWEYVgDxKGTmg&oe=6B08567C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
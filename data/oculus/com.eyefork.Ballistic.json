oc=AdpwlXIouGuWpHatZ9yHUtFhimGmhVhzw8fInESc7K7ulDQ66PmOsSPd4nt17px0AGk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKpZZ_d5S_kxVFYkhpw5Eg1_pe71YxLzllaGZJJmH5rg&oe=6A71E976"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50-oEOD_CeQQ7kNvwEqf-mi&_nc_oc=Ado8iz3d9CUHyxaPYL2xF5wUDGwpizqqkStE4EaeUXeCHd-caatcEVLcOU2XzH-BNWY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0UCiuAP7S6G8AJNWQcP0M9dWQjQrZ9iDd42D8VU3sUA&oe=6A71F149"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83IFxZCRmnUQ7kNvwGbhHrW&_nc_oc=AdrGU7ra-ipooydvvBAqJ_J5RHrKT4UYQ6-rBDrcz_AOyI_h3DaLPB-yJp28MluY7i4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjjeNYChIdfB6q_GnfZwozweWOuutFNdzAxLONooqxdw&oe=6A71CF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBdGH8VFIu0Q7kNvwEAdM9K&_nc_oc=AdoXk8IcPbprz--pRCuRQRu9YMH_a1z58lXDE5e70tAO4mr8XCjzIhVZSaRA1gA-8xM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZOwYefbkxxRBPfUIRBVni3h_xZjTQYmfw2GI1p7bDKw&oe=6A71D33C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUE359MgBI4Q7kNvwEeCPO4&_nc_oc=AdqxrG1TldU4Xpa7MD8eTvC1YGrOBUDaeasYKOjWTEx6Z1BknlaATxu_HS8U0dQc1lQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAQl80t6Z8qTPWXYVbkTjyyN_D-Zytum2wj0k7ur2f6Q&oe=6A71F675"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
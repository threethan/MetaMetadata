oh=00_AftwuvEZIMpkNQ1Li_0uyq79FuicAy2cZQs4Z3lFqRRJ1w&oe=699DA7F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNKo9z49cw8Q7kNvwEDkAad&_nc_oc=AdkCHWHUx1CPuDVd-q39cyRCqpGb5LxbhUk5LJEUVUb21Z9ay2w43Ip04X_l2SD_QjE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsmqWTQC7fmqOLD3aAKM6f4110kiWUjRj8LMPYMJgsofw&oe=699DAFC9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHyfYwsoxEwQ7kNvwH8xCEV&_nc_oc=AdmHsYNGVLtJy5Wad8Roeo4kdFy-8AzlOYGH0OlxAXf5ujJ0fUnSYUJWRsldD7R_S_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftU2Y6LE28Q13vygBUKpBm1iIMAk1FS98w3pPwsdNeH6A&oe=699D8E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpVxngv6v70Q7kNvwFAHExs&_nc_oc=Adk6VGIM9YaHDZZ_3u_vMWOBZOM8GWJ6ZDO4GYHXBpb3pCUJQAUWuEIn4rBGNBzMgUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuazPrZv8yx2b2O_bl5SHI_8qOIZy6TI0A8N3nbAvPWCw&oe=699D91BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
oh=00_AfsMiJaQp2NGePpOIyk5c_k-pc-8D4-iE319JjoYC6pUeQ&oe=69A2EDF6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOAGoP5uXe4Q7kNvwGWF2Pp&_nc_oc=AdlEUStflWEfSdBqrTuNCRndV3Gsrhuc6Oj0utLuLl5iumsdi46tOTvt3vvTWcVdAH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftH8qjEM0lBNEuNc52dWslfyCx-s4NYwbqJAzIdLn14sA&oe=69A2F5C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPd9WRbgwlcQ7kNvwErgYTF&_nc_oc=AdlPqx6t459GwvxfBUoTiCBaZuwx1YvTO26RUPr4M3AXqWPsAbtoMZ0-Ic4pnWGqMiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQv4iRdFrEC10zYdhY1_eMDSpy2rFmJ9EoEKZOzbYAvg&oe=69A2D407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy4QEksr0xEQ7kNvwFnEcd-&_nc_oc=Adl_ab9WPzZsz96XzRdqdPaVjv2bm4D9aWcEdMSjpBpDc0ZTB5RMP_d-ZwukFFdNq74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaJd5xR-lwNt11SxdDQeZMu7nTFc_M4V8kp-N-bPOYOg&oe=69A2D7BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
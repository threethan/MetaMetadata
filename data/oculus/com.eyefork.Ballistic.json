oc=Adp_SxDTvNlbaljI-jUIx_C0y1QCWIfDDR1sjsY8Eb_T-Y20bkbC_k2lpHhdDpbCH44&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA1Q7RX8n1MJfX22j6H551vhVfnNlCS8bSkp8pw_bWtw&oe=6A8852F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8J03Fk9Zc8Q7kNvwFr8pWS&_nc_oc=AdqV48GVQnwjxplzhdMrCcmz5J5abB_hy61ZFpP9OECEvS5eK1oZ1WgQ-3qIdyz7HQI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW98qiuBXInCMPpso6Pv8zojeEMfDNVf59dAi5TyZ2aw&oe=6A882289"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJkxQHmSi60Q7kNvwHVTOgd&_nc_oc=Ado3L3G7YsXfuF8CtGHoDQe7moChPZMnlmthEskySCpEu7-9YYaK2BDyPuwNyvFuJBk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNsAu1hD91hjNt7N5zqNGkf-s5_d1EakNEPuPvmF6kpQ&oe=6A883907"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA52bGQxjqAQ7kNvwE8fIko&_nc_oc=AdqhfzpWbvVi-0pkO347aCkTr-mNkyule4OwlpgoetMJxGEdnySgLjJVjl8Fc4isGlY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7t_pAE3xfZqYrv9hhrQ72VczjLvY8jr-ptzpNIlvFqg&oe=6A883CBC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIDxoFTXQmUQ7kNvwHmTX5O&_nc_oc=AdotEGy3AxaqHjjA36eSx76MfV2FrehFoIvo-MzyJ-vbHk1QTxBtd6VpF0CShIS2bos&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQaOeyidbL4GV71KRv4-CVClio1ZzWGErNefHbyMCMTQ&oe=6A8827B5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
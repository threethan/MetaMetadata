837575370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lK_gD636eUQ7kNvwGRz6mf&_nc_oc=AdozVWsJw89IwKXL0dnskrJicBJf_fipB8u-wD7Q9Gw-A91w5JbKk3gj-NHK2Ou_5G4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaWnpUAstfiG7sU0tGAAkiLL66RuaPkN8gnZ6o4A4fBw&oe=6B005349"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kroBrp74fcQ7kNvwGSOhPj&_nc_oc=Adrme7W9Y1xU6Y-0WzclOJ3BpLwI3QBeohQemvaeGkpw6MbHzAcHrVhwgSOv2xt5szs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo9RtlQRaesBH8Bl11R-0l6c2nj26OxPDpKkpXYPKKlg&oe=6B0069C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJonqrTzufcQ7kNvwHfTPVz&_nc_oc=AdpSlBC6-nfioeqV2H8Eprv1m3mqkNntsIStdz4RoDDJy9AJqbUot1RmgeMuMv1x7jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTewsmHWSwPeXerd_syXBcnmuY_MBP1TWhzoE8-P9aJ8Q&oe=6B006D7C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
oc=AdriLlBzSnM-WhNRTxrhSQgZCuXVN7k9JbelwNsQx5MqVWN0UZQ7DudUxHg2BdrGkT0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Mi3E-omFnb22e1IB5N0mgh7DYtXHzgVQWTJiau8bptA&oe=69D7A9F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_L6xOahBGEQ7kNvwHfnKHA&_nc_oc=AdpFsB5ZX8CXKKp1ViNfza7Bxcv2AmP4swMYcVXWtU0HD3-XJ-IQSLAoyDfPV6KWxUw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EUzwA9vej_ip75rsSK90K7aGvcNyUlMNg0dFIKiygoQ&oe=69D7B1C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfwLIEZ5-9QQ7kNvwFHpeTI&_nc_oc=Adr8xbGI9MHUKVDLyuZdeoTWe6rqEiKMvu9jn8SWMf6_xAl8EB_a5yo7PucHP6qymO8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oZuNWIcpi1Uchn6OglgrhLkpMSiIJANxyMDHQuL-ghg&oe=69D79007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9Brq7-61PIQ7kNvwH0yUp3&_nc_oc=AdpJBPyYuzuGiInNgcnKKthdkvrwKJnw5Le_Gynd1mRSgSDJvufNOIGa3BBa7UlDc9M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23uFm_HnYIz_M5Cug7NHQy1FeEb3WZbbWgZiLrbC4Sqw&oe=69D793BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxgTA6cqVKUQ7kNvwHKAdSi&_nc_oc=AdqiufMUVYcQQRZTZriDT1V3-9f4i16aVZ4T6io7Y2o8iXTBDqeWw4q5pUIFokom39I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kGFtOIsn8m0Krg9k80muMz7NN4nEvs6sm0w4l3Jkivw&oe=69D7B6F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
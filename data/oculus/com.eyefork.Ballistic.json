837575370", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7xaUAvNquQQ7kNvwH6fg5E&_nc_oc=AdoFbu27I5lp5OXpnvyI8Vqcjmwny-nwdz0_b_KRpr7jvIrsoXLM8dQ9Io4XSqxUNuY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOULqq6c20ksdc48M-zLgQ2aPFnW9pgPrvTjEFFzTqfQ&oe=6AFB4589"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAvcEXMt9v8Q7kNvwGhZgRl&_nc_oc=AdrdyNd2Uf-OhX3R8j0DOqcvZacNBEnjxz_JGRxNSau2jvyhL0AgkYMnFwJiUEw0J-c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDemhuDhBjzDCVIxwVHpsTV1M5CDHI4uHteJx2vK5zPg&oe=6AFB23C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1eYgp6CF88Q7kNvwEkq2Q0&_nc_oc=AdqP7Lnt4ihNNDgZLIh6f9zPHl-k6Cl_zBnedVopcDidMkPiCDPVwlvEzTqtRx3oiCk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1OUh89YzJpQG3Fw41aVLYklkclKr_qHZ5AM9ewsQpCQ&oe=6AFB277C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
837575370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lK_gD636eUQ7kNvwGBNXBL&_nc_oc=AdpKfMz6ZWZ-XzJHnFxKb-fZZ9KbsBRxdFYIXcgtJxO5yu277AGNfrdFaSw9iMK3hl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_s1EeaQ4iBLPT0cGcefucoQbHPuOAn7HCCGGhBFxuWQ&oe=6B01DD09"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbBBFmfpIxMQ7kNvwFwcnCx&_nc_oc=AdqDrF9RT-PXXClY6g1G1chzUk7FMTuF1BkD8C-G4zbdEV3IqfNZPzFhO5XTv_SgQGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh1bbsdxNrWdBw3nd-LkI8MzeLOsr-PFcZcgkd3jaVLA&oe=6B01BB47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhnTwAfwbY4Q7kNvwErwPNw&_nc_oc=AdoUU16BtTeDewv4vUJOSuWWu4ZBlMKOYcLE6sY12GsgbWstVTyOlont7J2fyCa70NY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM-_CSkrBmOIhMXmAfJPVPePOskJ8IyHgRsLGBCaG6eQ&oe=6B01BEFC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
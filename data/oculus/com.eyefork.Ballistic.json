oh=00_AftGntR31OUOJ-dsd1EIXhUPwLJFUn-w37EWAhXLJFEjEw&oe=699EF976"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGxeHIRrG3sQ7kNvwG6hgfR&_nc_oc=AdlrJvobSOlAMxtIF1oVGaCkkYUoExt8pk8osMYTJ12oeEoFhYwxp0EA3FwsAKEuXZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftVIY1rHB3UKODjYRL69rb3zHJO_H5UmsBa03AuWlPEuQ&oe=699F0149"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHyfYwsoxEwQ7kNvwHWz_wM&_nc_oc=Adloqtlb-y8X-Y3IhkqwfjbDPiRXcN9j1buFvETnE5Z_mutBYrmOL-HLMzGfAHmCIVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuEtEVyvAKREd3qiSdebmfDASCEs4uA_Z4KUs54IjoAEA&oe=699EDF87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpVxngv6v70Q7kNvwHfbNHx&_nc_oc=AdntD5YFSkZ7TfQorXd4raa0cLHm294mrPjJvL3eJVNqCN7U49ugoLDkYBWrw0r3Y7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftxR9zBz9SvPKrRd5wLbPGfoSrHjkkTHWYeC9k2kq3f2g&oe=699EE33C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
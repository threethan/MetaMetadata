oc=Adq9VbWPSQ3fHB3YWrN4pCGSX3BJ6Ov3yTCvdfKZb9w7-a8iRJy3lrEC2LgAaTB6mcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUZxlxedNbul7gjeHtFMdadn4B2r9NogZof47QBC6ZgQ&oe=6AAA99F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kZ3AmE42xcQ7kNvwEu7pSe&_nc_oc=AdphdCvMEv9COURmVChJaBpLUBFEkprVDftp2R6BSScSSa308EF-vgOiEDzPpJOX_Xw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSnNA7vZfu2xFT8AebQei411-4XNw8MqSvr3pO2WRqtA&oe=6AAAA1C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNo-ReMR0x8Q7kNvwEcKu6r&_nc_oc=Adpx4jUh7vVP_82v3Ia4kBjbt7ROOW_bpKHre1koeY1MD8mpI3CdE0_bhlwu7gBqNJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLesCbG0ANgCdtdjz_LRY-fpHpfLlgsuhJK3A6X-YJQzg&oe=6AAAB847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSUX4C8dqb4Q7kNvwHqMz7O&_nc_oc=AdoN-BCfs3vIECN18xrKVInkIVgvZFHK6PzC8ZGLPjBbjq7rUAYeiEvV3h51OofvlPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5pyJ6YE63yALxg2rKEUFWMHVHE2-RW2q6Tu03V0Q4cA&oe=6AAABBFC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuVVX3HyClkQ7kNvwGPu4U2&_nc_oc=AdqbmXY3zHr_T3jQPMIFtE869qacAe-Ys0hqKvBPiz1LI0OPXdvqiP9tCty1R8M5IvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK167qwJ9HtSmd2k02-rfrBo4OyPI1jdxCHVH5TIZklg&oe=6AAAA6F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
837575370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAG4LeZTEIwQ7kNvwGVD_dQ&_nc_oc=Adq59SNuGrPDqdzcyyVsIpjHP2D3jqQDtqRVU6zUOrUhrMg7fdIyRMwZ89K6OQj4gC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRv7pFYUBnVGLEYdmv8tC2Rop2yvUJWyIibbQxC1MqaA&oe=6B0DBA89"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsH1uizfH48Q7kNvwFU7e1W&_nc_oc=AdpTuyfd8aY13v6d2o5zCj7Bf0vioUarQzxgARQAWYUccU0vYOClaFyQ0wsSW8vgpt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQULh9CRKz-WBlBUM22L1vQeIq8kEt0IVGOaFOZAAH0gQ&oe=6B0DD107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNsDX3hX4L0Q7kNvwGa7MKu&_nc_oc=AdogQgoNVapGWNQGQ1pjghMxNz8q_CjdFCPRmFmgxBFXlk3lw-GSP-a_HvXNUhU9Vo8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0x4MMQwWfDkQQYGZ51ZGyj7-cDp1QbAsFZKTFwNqKeQ&oe=6B0D9C7C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
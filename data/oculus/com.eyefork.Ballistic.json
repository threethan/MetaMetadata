837575370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lK_gD636eUQ7kNvwFaYYFq&_nc_oc=AdpfG-t1-V13L_nsz8bBUk5fm73JcwFOgAjyja_rV0-QiALuXibknrHV08CGDEVcqWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLUq2vkBgKXMEyjoqxkF9cW5cci2YunuFJdEDUckTMHQ&oe=6AFF01C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kroBrp74fcQ7kNvwE5iMqt&_nc_oc=AdovQ0-kE0tXDHHp_M9a-CdJNn4WOXvUy38G7crDqqlfCTdR1u-t99Tl9B4cCO_pExs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbLSCVj00Va4bITIi5bf_N_eI-lUHmDq092Z1NmftFWw&oe=6AFF1847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJonqrTzufcQ7kNvwGhzasZ&_nc_oc=Adrxs1u52Zo7acImBp3daagMi-6YANLV9eYeHb_c6nI8PGq5aSupTMe2gwtpBteJT_8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgAOqgV3pPJg1m-YdsU-LUQYxw4RqhGvDDUBlKfBTTzQ&oe=6AFF1BFC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
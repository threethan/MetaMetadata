837575370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAG4LeZTEIwQ7kNvwHCoC2R&_nc_oc=AdomdtqGdJ67zb-fbg-ssTwgibw9-TWdc_x_qhAZqReyzgwOeEuTSetomcm1xvsSz00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9aXiutc0bBnWeoy5l5K2Z_c-40YdpH3W-jt6QHMdg5Q&oe=6B0C6909"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BojxZL0qFskQ7kNvwHMMe3z&_nc_oc=AdqPDAyY2BcZV_2F9MQ3RlKZAOyTtgwCpEk6J9khxQRqu_KvXusseqAPUruQg8tvYFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSX928Uk2tfS9YSLNlyzEj6FgeaoK6DzpjlEkJBaVRc9w&oe=6B0C7F87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nqqiJyYHz4Q7kNvwHy2DYx&_nc_oc=AdrY_ZuKKCB38ldVlaYotg89EUWWLBgILB1bbrgxorkTpGfVBInNaYhZ00MfhgELlrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoyBY3YiQ-MQPjXvbinI3tu8r0buSy8TQoauQjO72XrQ&oe=6B0C4AFC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
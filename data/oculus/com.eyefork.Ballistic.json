oc=AdovGQmMfq2I2SCRtNKBT2e17p5bMvBL2c5TKzouL_rM7mOS27-39FYm99Sz6VyKY-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEymTgfgDbUwsP6cxQp02CAT7RVyaySAsbaAQQ2zwu6jg&oe=6A733AF6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50-oEOD_CeQQ7kNvwHJHUA8&_nc_oc=AdrYLZv1igt5kJRzqTUuJY8jdyweowfc0DPUPP2td6TOWRZGh46GSwwrcTDwQjqtMQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzN0f-gK5GV-gXP7JS8tXqiN0aBIOTWe7uNH16OlGuwA&oe=6A7342C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pONzOIvKUKMQ7kNvwH1sqP6&_nc_oc=AdqH2yYtAoDoO018zr7csfUE5sh4DF10d2ZcWlFfQLznanhgP1JHPty36NZ0Z25Jnuw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSPXB-OJEiy7BQeIyLNf-TBSBTNQaHic4Nja5fYuPDNg&oe=6A732107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKMRnsLPm4IQ7kNvwHAC8pl&_nc_oc=AdrYxwgbXOBHbnEiDsdpVr3GHomDjxlSPkqf7pjUFdjGspm5BK5fR_Sh0KdZrwlL_xI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr0trC95QxXcQt0wC8TpZZ-JQXCgbporUFwWr_AO8g2A&oe=6A7324BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUE359MgBI4Q7kNvwHOO123&_nc_oc=AdoVWiUBbACGst2rWTfVDFMN3HgAG2tofj-Yi6ojYP0K6XOwKoBxwss4PYTg7vpw43Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvEZ1TOYN4VQ2DoAhquil9PKHZpluDAQ0iXx5NRB4ycQ&oe=6A7347F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
oh=00_AfviruhPuwuJ-9flw2R6OnUU_3AB0ojKgBY-xjnRyu3WmA&oe=6999B376"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOKtVjCYtyoQ7kNvwHbDHSq&_nc_oc=AdlEfxrCu9iEKei5bg_5hEUzVt79NO-haw3ih3FUa9ukQENhfQWezTwLB-l1Q6RAGKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTYtJjqCWaMEpoQViCtvTU0neAppD3JoYqFTD3MODsuA&oe=6999BB49"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKucbE_Le_oQ7kNvwHssRNe&_nc_oc=Adl20CeAlPH6OfhJNJ5jrLfgGekOYBUiKjt0xS4TLydN8s6RDLX-iG7dUzAtLad6wT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0jsoTiYYkAB61-6bQEpCpGT5EUjhJbRSQFKpQX0CgWQ&oe=69999987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyPEXv2O_WcQ7kNvwG89vB_&_nc_oc=AdnU5f18q2qA4Xcp7quXqk_Y3HbVfzDCuHSmPL-ZnvAVbW1eLtrk1-khRIk3ZsYg3EY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfveRmn1-LWcMKN1yse16gCoEY9whZVOHgo47A4hnhNltQ&oe=69999D3C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
0L-Bl42v5Vp6m4g5_Yk_Sa4BHJyGz2G3gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxnZREjhxqGGJUt7fKzN2skjRQoZ7wwJ0GhO5bJ-sqQw&oe=69B6B476"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzQgLdf1z8oQ7kNvwFrfcBX&_nc_oc=Adnd6vq8VvVSlJW0aIZEvKhmO_H6nRQReKm778BZVVbBK_uL-nobA9hQ_50RVq6xfeo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKZ2X4-2uXl3JCG9gR1NFOS_3-6G7tjkGitCTQn6OrXA&oe=69B6BC49"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2dyt_bK_1YQ7kNvwHUWZ3Q&_nc_oc=Adm6GlvLoCQtg2CWhq1wOB2Xg3HeGxR-3QVYa7TF5wGBM_EWd2xLOsuFFKpaCAfiHOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfaZa2Wy6p9Ff-QMMFtBEPCYnmtwxp7iFCNVaVX4O8Uw&oe=69B69A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFa91u1PvCMQ7kNvwHW0rTo&_nc_oc=AdliuLYCJbLOO0aUdTcNj-jzFLuIFah3NeC8Pmx30r_d-wmbwgLDvapiqmJeld3iilg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytPlR34_vGFQCcUL_3q9z0NpoMCRtCsjyA6m4bFkeP0A&oe=69B69E3C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFQ99CiBK-wQ7kNvwGR1Cd6&_nc_oc=AdmR0yj0Z3uyWmwmxZ4pdP81iFtUPaQIrMSyrg-ttL73s_MYNhLP9VrUQCQ5oe2Zcfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy32Ritncazw9MknLk7ZNL09JKbgKlnyfJyKJolmcNLog&oe=69B6C175"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
837575370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7xaUAvNquQQ7kNvwEYLZdV&_nc_oc=AdqWSXjHSHNXSEu7Si-w8z3P59O0RJFda5ULR8xMnXSEZl-4wTf7dF61YzAtMz0FAw8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsUQxFG3sSvfYvirhz83kpUW6yo2L1KtsJntH1tESyFg&oe=6AFC9709"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAvcEXMt9v8Q7kNvwF-cA-o&_nc_oc=Adrcy3yyvvi7o6VoE8TtHhnSGek-yIf94QVf-z67p_WdEWzG1uMTFA8arXZag0SQd1E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ISAsWUUbkFKpuIS51bOcGUbf7_3ORaZM9Sr84YJ4uw&oe=6AFC7547"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1eYgp6CF88Q7kNvwERd3jH&_nc_oc=AdrHHWSvfT-n8wZSzUK5OrvPwszO0vG8lUgMpGtCqj2tHYxNCEQB1RfqFWuMkI_msoQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu16dywLSah_FYxs876oM2XBZw0rIFqA9LTfQRJyt9Vw&oe=6AFC78FC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
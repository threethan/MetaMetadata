oc=AdrRUaBpNM69vC61UCYonSR15VztfMBZot-IlR0aiRXsgLzRNj-nanCcIWY-zsyC6LU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSyrSn_WFaSK2J5ySIugRETTuZz2r_GXZBMV_Ro2qzbA&oe=6A7B23F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvyLDKGyTIcQ7kNvwEuzYTP&_nc_oc=AdqfNDltzYigxCSuTjXwK0MX_2GBnzgpF0Uh9UN1QGEsrQNwNc1QI8KMFcEGc4E_aCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_hsdFrRr4kuy7FhCinBIU1sNZlUBcX8Azkw5D3Sp77g&oe=6A7B2BC9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY0HSTMy9ZcQ7kNvwEa2uYJ&_nc_oc=AdrlhSQvyENoi28mfKP-pKRD3WnlBf6T9zme2BexWTGw4iKj99pfY1hxU5XGszRqzOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS2ghR5ORXxCSGkzd3FMCSlu6SZiraIuLnwtrjBy6wjQ&oe=6A7B0A07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEbVHYykpSYQ7kNvwFy3nRi&_nc_oc=AdoPYN3qpt2zyloCp_89y6UquRZ9OIg7OMT181nc5l7cTF9txzMFLbPUtTG_pdV14X4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg-ly4SWcwWqQBDO_f7-ta5tIrtlEbnaJz_f5s7P-nbQ&oe=6A7B0DBC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reSO7dUSJfsQ7kNvwGxA6ef&_nc_oc=Adozn-NJoD3MAd_CaxL2R_B2o6USAaJISQVd10BN479vAZIQYzTzHlQhzHOyl4EngHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY1Lxgh5SQXxuUdcvuEbcBAH3JyYTaTWjdg-Y_o34tDA&oe=6A7B30F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
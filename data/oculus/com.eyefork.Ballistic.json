oh=00_AfuFa45t4Y78mdq8Wo4EgTs3JDZelxh_wojzYEDXaY7wQQ&oe=69A590F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOAGoP5uXe4Q7kNvwFQemMh&_nc_oc=Adnj0R2xQdGZiv5P7M0iYourYQLtNKIzAwY6P8C4GrqpQfNBkPvA5m1wThfouL83Km4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsm7yQg6WSb0oSWlwXcKTgtg4Xa1hK3mbkOfaufSvZxvg&oe=69A598C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_R0-g7EGVoQ7kNvwGVXOXs&_nc_oc=Adn67vM3yXGHa9ckDkQdd8EovfRxYOugqTDp4-hptv20L0JjAOhIvbuvmA10Fi_8xgI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftpDQU7fnnRHN8CPu-fkMrt9u3ycC0SIjWoU7skDIw2cg&oe=69A57707"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JGMhRzU93kQ7kNvwEeZMF9&_nc_oc=Adm_OzZgqaio6bmGfYbvosH94NcjE01F4QQBm2FLzYG5uclMXUzGj8gYnv9x85XgYMk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs1__a4psC_Z24UQs0PCC7KF02aNqOtL6yjmv1iNXuhAw&oe=69A57ABC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6m3C5nQpcwQ7kNvwHTkvEH&_nc_oc=AdnrzJSOhZRM2P8IiXEFBNOKfX_rvHWQj3TZ6puBcV_AxQ7B1nd4gLUiuH3Ytnm2uRU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuQgwmRhqF0hiyBz-a6U20-43VpSA0Ko2VNjb7J7A7DJg&oe=69A59DF5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_n
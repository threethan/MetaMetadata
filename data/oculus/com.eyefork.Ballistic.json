oh=00_Af2EuRVCeEo-18eqnd1QxWFAOP_L8ABy-haFY0E56J9iLw&oe=69F0B676"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJUtWNiVp54Q7kNvwGBP39a&_nc_oc=AdqrvtoB74HR9yLMlWRRoYCqtCOhURtekmImODxvAQX7eKCy2MJisMHTCxRGiaQanGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0kLVkjUw-Bo-KwgT1VbTaimbVKATTjd56X9z9quykCNg&oe=69F0BE49"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkNRI1gDtCcQ7kNvwE48kyt&_nc_oc=Adpzn8cr37xqKVFVPSu9mwM9_vxGjYm8CQpw4Zn4NT-yOx17-vnMWZanbyBCAuc5_us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2tcPbprSAwQwWNHtVfWzHPCrhvUi7FsMg82pwZTjwhcA&oe=69F09C87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byQt5m7AdMQ7kNvwG_iyfm&_nc_oc=Ado9kRQyaKdtZW8eFw3V4qtzY53APiex-oG6flIictCeanFANNbl3uy4jiIyF3VYEpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3_G7dp7eK-HiW-wayQrw8jyX2-bMeiRdTa5i9SNrXjyQ&oe=69F0A03C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
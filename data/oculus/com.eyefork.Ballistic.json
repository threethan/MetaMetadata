837575370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBtBBl--lkYQ7kNvwGaI8HO&_nc_oc=Adow1KvPCMzKmaXtBvUfqT53ZZXxYS12bBquZtcHw-9iuu1LDLnivpNbaBTJDOnFXoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9GzXCtqkmKf-cOOOuUk8oS6e4yUWgtuKfCwVKP_yp_A&oe=6B09C609"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BojxZL0qFskQ7kNvwERu0KQ&_nc_oc=Adoit08tSoa3fjxjU6wBn52et-bu9X8MLXUC1G8-OlXickMZHHVN16XP9yKYa-idkQA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjfMcDQxAXYXAbTy6xYF_ni5ytAxicobk20zZbML2wvA&oe=6B09A447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nqqiJyYHz4Q7kNvwF84n57&_nc_oc=Ado_LSf-uDIJwEXxGEBoU2-VFyU0jkbaKZ_Sbs96yAatU1hDF7Tby6f-blD2oWHYb7o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs1_PNvs9MXMDpymA5XsGHizC86UX2PHo9aQIaJ8gpHw&oe=6B09A7FC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
837575370", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7xaUAvNquQQ7kNvwHvaDUH&_nc_oc=AdrMH9KcnVckmhOTt7zmPTVTnb-XtTPoUWoqmTtsJy5PxV3S3o19h242AGgkKa8OB0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQAqZVrpSBIHNFvA84ubjWIUUO8PJkiqoMK40_2N4FQA&oe=6AFDB049"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kroBrp74fcQ7kNvwEHVVYL&_nc_oc=AdrA7EjsSh3sllIom6gtZmDTuAKebSGdiiVOF8izvrL4c0gas3ZEIYw3y2fqKlRhvTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM3D4nv07bfezb83KPb9xoqWt3Ct2QlcnzmyWYQTtwsQ&oe=6AFDC6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJonqrTzufcQ7kNvwEHAFgc&_nc_oc=AdorB1N8q-Z0_GN3r9N5NqfY_PzkXYK4t7xcQKblPuJ5reVsZBe373NOMD0YWCQNmD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Wf4DtPVfgziasVpVqTN7BUSOH_ZeeKz3Esj9PcVd0A&oe=6AFDCA7C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
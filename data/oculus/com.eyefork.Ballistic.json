6&_nc_oc=AdpO7W1wuB549VHsylK4mPZj0DoDJrmk9KJ-lymF7JwtR7vr7xJXhXEJvnDIURj1E6o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhRVK_AgYJnJTJ7zqMMGYW76fiPtFtxUEUTvBP71BDaA&oe=6AA40276"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4lafCFZnEoQ7kNvwHEIB0a&_nc_oc=Adp7R_INAkO47Ird8v7bHpLmzp_Ue-PmWTUSvqJvYTkP90sqSberAccOI-apKXx4hxM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrjaZ0CrXRInUMRzZJGkl05pnOZSeBPD6fpgEmCJuorQ&oe=6AA40A49"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEI70m_8vTUQ7kNvwFFJW2k&_nc_oc=AdrcAZq7jgTw11WPvDh7g-MxzyspPZHkKtJIU7OSqQXc6YIxY97lOq82DVipeL1P8cU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkt5Tr9dIVeGcEWsTh2S3ARnAF3hFQTUoLBldwDXg-WQ&oe=6AA420C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2HsJtJxL-IQ7kNvwEmRRp1&_nc_oc=AdpKMLWgSJtlia1Ab7CWLW8iC5OhY86qAwlo8bsTJZOCCcFsWuIC1kIrDih2eEdlO1Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnxXijEBq3jhMHHoeRzn9XnSnvAikJzonfkAVDkz7lKg&oe=6AA4247C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3_H_9Br9gwQ7kNvwHfr6O9&_nc_oc=AdpzbOyKboveWo9hfHEabRvOKmfJC_ZVA9pC74vZmeDOo1ezy5Zze5-rAhBIrCx8VrY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICEU5InJ4IpVzgWaXxDjLPqcnBA7tkW8izKdT_X050nQ&oe=6AA40F75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"
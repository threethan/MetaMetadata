oc=Adq9PwXBGq0YnTPNsmD3WxBx_qXstQ5C0YCBm0uZLnSPOeUtn2q6ZLtOuPtpRvK7B5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4X1lgFk7oDEhmIRgHRjkpcxbuHi6ibeLDDuhUgJbuEw&oe=6AA6A576"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4lafCFZnEoQ7kNvwFrUE0Z&_nc_oc=AdpUlallIny6rnLmQExROvUHaBHnU_nn5Nl_ywXFVO18z8es9z_NyZxtcDUmqghrCg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFEtjy5KezGO0j_6GUkawecGdSQwQlzWpM2ygiYAizuA&oe=6AA6AD49"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3DAYsOsA8IQ7kNvwGx8Jdw&_nc_oc=AdrO_soZTvxGhFD7dZyYN2rkkmFAX2TjtPK_RzL_TUM_srls0n3gA5U-g_kk0xndrLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCQS98ItXQZ_0stUKVSZgrX8x5GD82HzKabpgm7cHJIA&oe=6AA6C3C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK7uyLuQNpAQ7kNvwH2X27l&_nc_oc=Adog0Vkoa4fXoPLoqmkAPnTUL-cKg1TLykdW-aiVnrkxdZGSOy7ze12dp5GC8cWwUuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZv7p1YSoSdy4iTwFokCTbdU4JTOOGTtulGTYA4P3uIw&oe=6AA6C77C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jm2emtjDfWUQ7kNvwEyfbaj&_nc_oc=Adq9SiPQ3JUcAaYZnGS_Xa2z_9JSL6els_N14o15Jxf2D7drze6s0cO9Jv1VyYPKJIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfzAWE5dJKXFC3Uxx1umUeW7b-wEh4_h_PsZlfdpRmTA&oe=6AA6B275"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
hxU4WqvK3_YJRPSBNG45DXcUBlv5a7pXvc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwO-VFwiUsbZTij6ro-QW0wRs9zZPwy63B9DIdo1LM1fQ&oe=69BD4BF6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjS8mu0iyQYQ7kNvwFHrdx9&_nc_oc=Adm8Ydgyiy6Igfyf5kZRYwjbhO7OZgDGmcrrupa8jx5ow79ngbqI79bZhGs6-TLKpws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT_dxQ2zAnIPxIWz7O8Pk98wLdVTqG_dN8-hhDkBsMbQ&oe=69BD53C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmzmqGNM33UQ7kNvwHmEO7X&_nc_oc=Adli5BsQOAf2mHp_FP7MUyy4gUt6mFttKbIzd5OFz5MIJv3vT6CHyLV3H0jGlwYRnjg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-1WkNkYak_Z68xNijEyIsJhdFO7lO0ni8iaVUi8FYnw&oe=69BD3207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rVM-UiUOMUQ7kNvwF29Pl2&_nc_oc=AdkpCTpPNie3cYQPO1mdjmI6W1MpB1wLf3Thuogc4uPy7wh6Uh8jDW3eAhG5GHQ8vUU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8CozyOEj4mK3wmirXNMlNS4HNXtzZSX3rA4wUf2bAgg&oe=69BD35BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGSxz1S-3EIQ7kNvwEmalrU&_nc_oc=AdkZ-1L549CwReyrRkC2Y7lRFhvuLgRxaooIpd_MpTwgzqpK2BFJdLUdrhjjd5gVk0g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFwCY9auURvTp1SElWs2tqYIUj-UcHVFj0a6vRGtkb9w&oe=69BD58F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
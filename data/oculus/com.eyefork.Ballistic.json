NP0d_&_nc_oc=AdrPYYQ7ccT9_hqegslj1uqzYIfe8tUqP3PXyvkqGPCXxlObCxZNPsmQ-_i509atKEI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw3XXsmCk7rNGO1IQQIdb25hqxlBAtUaCiJjDAv9zrSg&oe=6AA966C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK7uyLuQNpAQ7kNvwHrCpuN&_nc_oc=AdpMFO5sqREh73-TWWuqxArNVBUV1vnzycQ84pd_ZxirUAsoBHoNup2LWGXgky_sem4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlAYqJTgZoIr8EXaRCOkP_UNRrvqn4zX8hLGR9Hafd2Q&oe=6AA96A7C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://eyefork.com/ballistic-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://eyefork.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "37440400758
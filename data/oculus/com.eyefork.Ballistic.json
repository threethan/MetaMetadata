tent-atl3-3.oculuscdn.com&oh=00_Af31dWZ1RcOsRVZQ62Zfp_GKsu8knwtymm_Yvj92av6kkA&oe=69F207F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4xGJwhDglgQ7kNvwFInfi-&_nc_oc=Adqo3qzEs6G2OpjqVMPP8CdmkMv0GrNsNcj_ShEzMlW9iu5G9ERUUH4i2w5dD3bAvyE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3knBWZjSs26MsUWihi3nAyqo5lu-908GbDjHFH0AVesA&oe=69F20FC9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkNRI1gDtCcQ7kNvwFIIHk1&_nc_oc=Adpni_PdImRY1OJEvibS6CrccqUgr2TnX9fvxIa9uV1rHyQtk4qzja7BcqqDiyf4orA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1U5JHA9NZRqA9793HQQ1MKqcalkcp10OJ1atU6F0z_Sw&oe=69F1EE07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2byQt5m7AdMQ7kNvwG41K4y&_nc_oc=AdrpliYO6xwkmvcOBjp55M7TJBX5ixM21T3D9OJ7airDW57p6lztq7dNtcITlbOdcOE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ASGmhoSqzfEn1-arVggMFVnhbZehFLHfsnzRu2McrSQ&oe=69F1F1BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IH7pBcgWU0AQ7kNvwFLbIDx&_nc_oc=AdroGVIV9i3990UdFn7vigtdGGxdJssliT_7zbFDI69U060e-Lw1inRIrg1L3tVBjFo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af01_yrtHU9hjaQfnERkUlppSene9CEf1pnkPqUpLunLuQ&oe=69F214F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"
oh=00_AfuZP2P5V7Ul0J5SMW5UwHIZDdTIFYAOD6mp5dxUR-vjzg&oe=69A19C76"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGxeHIRrG3sQ7kNvwHIVZOA&_nc_oc=Adlo6uxTm8k-dfwjgjGqZwvOJSn-E9pZdAZG33NpeTRBfvE6Dbx30p-XnDgYEh4A3ls&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aftl1DXBX4KGGMXdR9LrAnUBFy0Dtww-cedFN3y4t6d9lw&oe=69A1A449"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPd9WRbgwlcQ7kNvwEMapm2&_nc_oc=AdngT8CLBhyq6o1ePysLf36gXHAVkEvEkwYD9sjNl9BwvI99TNdTfcHb0iuUnuAaDYM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afuqj5gYQZulH4hEmPoseAEYyTOQ8p_R9L2sn4_lOPmxWQ&oe=69A18287"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qy4QEksr0xEQ7kNvwG3ZlLK&_nc_oc=AdmUecZpdYKzH9icruK5AiIpnon3ZCis1mzXOsJNEadk6TPdcM9xCgJosv3YBcI1iWA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs_w_rrI9EQQBasWQneGv4FKws4FtTRKv5uYyFFZqCTzQ&oe=69A1863C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_descripti
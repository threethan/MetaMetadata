837575370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88vaKXak0swQ7kNvwGt9TGn&_nc_oc=AdqJ9zZ72eCW57VQOMj8nF5RhY8XOGN1aj4nSqfnlnqQkPfzVRSN9ymDnDRwLbl5rmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3mTfU1CmZQxdziHTa_7Fu8whaUNRW1o98iOo9zxSyaA&oe=6B05D189"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIXEEOlYSZwQ7kNvwFIn6JV&_nc_oc=AdqWpQhWCK6jA23nrYAf78NoCS9oX2NYJdryDBapu5v2CFD_aieuWiBhMSKRu7XZ6D8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCb0YOBdlisMJtNHrpfh8C81w2XQfN8-hLtxH5W4xwwA&oe=6B05AFC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF73ePyUGgEQ7kNvwHFWro9&_nc_oc=AdrVEPhXxUHEZ9lIK4JtSA3-x5ORkbf_TZENTZ8e-cBcYHtyOVqaSED1fJf6G39MkYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnFhENF8xSmZ3mqT7ka-SlKiFJBFeFhEGCGa5NAztkPA&oe=6B05B37C"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "sh
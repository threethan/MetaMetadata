oc=AdpsRV6JUz_s72ot5mMbRtoQE8tNKcbtvMR9dR1K8WBKNxhgeNXSlkSFl8am68K3Pqo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0xZHKWr6XbkK-5M8Dq0NDOcFNybNzNr4NQdG_TffMWyQ&oe=69F4AAF6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4xGJwhDglgQ7kNvwGIWdMD&_nc_oc=AdqKE4ohFxKSALYDddrjQz4DG3PlcWC1I0TGeNof88pfP01wYjf8-ObOn5eM97SvoJ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1B1Tx4a2Oe5ycy3dWfem7HPGG8u0Z5TBeG5xuHchqqfg&oe=69F4B2C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QINvK_JaKnMQ7kNvwHNekhR&_nc_oc=AdorPAH9zcJC60MAc_SufbbTObPL8i1ph_QdLDoBMH_4PzVC0NTnwU2qtGWXKDIIaiY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MUaHzIkSYPby_VBeOF1SALRj5xm81-M-rlKg4ypy8NQ&oe=69F49107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4veYNh6xaIQ7kNvwGWNly0&_nc_oc=AdpVuLYPNlsQZodC_5qeinuMLQnsqMcqsfzyAvJlMetxujjetztmha6b1cJ4XL-YM6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3E19fTMnr04Yb8jXN4stkmt0rK1l_33CiVHMDqJBHMTQ&oe=69F494BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvDPj8L7ivQQ7kNvwHQKsYi&_nc_oc=Adp4wius4QxO8Ox9ArIWzxkxaV6J3HclF0iJEB5VPYlWDK9-8NjoX9CyYidtbWTbq14&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13JDIo5o7VkjB7O37zVmOyqEjUTnvEBp6NZosLChPVzA&oe=69F4B7F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
oc=Adpj9XHihJEuR72YtfPWUWNfZb7ekYY26-N0ILRgyrPk9CFRxNR6K-NqZhH1ssDMFN8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nT0JPyJ0mdwwXQeHym-a5UyWgPFZHPU-IrcdUEaanLg&oe=6A2C09F6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JqDWzVnPrkQ7kNvwHHusst&_nc_oc=Ado8Tz4e76kYNcb3_WwJjRwl7HbC1vxmdVzVESEBJhlxYLUOSJ6W0Ple3_sNuNBAafU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dmJEvTiZisvvkzPCfEq_2IluM-eNu-aosD7QbOyusLw&oe=6A2C11C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y83Av4f3sjkQ7kNvwFTNndr&_nc_oc=AdqGNMMo0iaBn4LogVs2pZXejcoj0-dHY1R87o6OCj06oZjzI9hwCFhhx6YEk1ji3cg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OqUuWoNWW_cA6xBzROok-3h_aqSAM3cvQCqZEePF9YA&oe=6A2C2847"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2-93K_PnB8Q7kNvwESop0t&_nc_oc=AdoXIJ-KIlKR9ggr9P7iH6B55NF643UFp-sMV9w35Eb7q6yfvkzL_QVVvYd8Aaqs9_g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9N0NJ-DCYcGkvYM-7aVOP0deYdJ_xiK7IFGrfCIAB1Q&oe=6A2C2BFC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qv9LNWq-mYkQ7kNvwET4tY3&_nc_oc=Adpe91XD33KSbbx52XhLSfeGT6nGNztNILazO58emM8XvT3IQiQL-6HBrhStNyAOfF8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uKx2fRgT1_IIP_8989awEs-0zSHXBmZuvA2iLo4OG4Q&oe=6A2C16F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
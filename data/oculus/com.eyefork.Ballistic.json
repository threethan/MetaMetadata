oc=AdrO3w6EBaLZIlR1XYqfY0TDrQPiuNKStraQACC1EPFvai0dhx6XS5nJZThGhZu2MQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pu9aY2Dd3Y-mOXktOEuZEZpHBCuJDwB2bS7wIy9n3wA&oe=69DA4CF6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4t9x5rDYboQ7kNvwHNc3-s&_nc_oc=Ado-HDTrmljAryxneyI-fW26s5hLBUvk2EkZCj4yhzfIVV1HISzm1V9kViXVeewCkG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kv9WgN9X7a4EwBG8OBS-njNi4Yb_wyFOxz_MW6XlycQ&oe=69DA54C9"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE_h9CTIqrsQ7kNvwHq04C3&_nc_oc=Adr0fmvy2SGnUjBj8imoPMHDptTEWIrue-nYGe7ho65yH1Znd1X797kKxGvgVKvq4Pk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0o5S8tMqc-1u0iskjaSNKLY98L5fEtrXYInl1OnTWiuA&oe=69DA3307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FX5YCsIff5cQ7kNvwHBYMRL&_nc_oc=AdouwLuV0MHsXVAZGUSN5LnoWY7x75P_cYgHlT91R_POLymq5wJEow2ShitRJQa-n1s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00T4d9m7qAT8obaPAA9_E_xjP-vQ3jGRws9LYASiJmjQ&oe=69DA36BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxgTA6cqVKUQ7kNvwHT-trU&_nc_oc=AdqLqlkdt8w_CkPLAC4QDrIWq1QfTa--j-iUIXf3O4cn1oPo27ovKhNB_EEdIO2SNYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W8byUrBcyR0u86hRgz9QDsTBy-LhQQhD-dsMqG-3tsg&oe=69DA59F5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
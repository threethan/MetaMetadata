oc=Adp7d81pxKh3nR7zI_Q_gNFVzDANi2WKHafMQZfzbMtjpJV4jro-eB1Ks1xTxJ1uxpY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP4T6D4R0LzCuGKw82DTMq4QUFgJfMniNBA9AMM9sxQQ&oe=6A903BF6"}, {"file_name": "5.png", "id": "249475837575370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86621377_249475840908703_7135258099161286017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT0Gb6x6ePQQ7kNvwEGmc5X&_nc_oc=AdqtUqiIS1AzvZcW3NN8E139Ig1VyH0GzcS_biFrB57wSlvsTez19eBP2Zkc8SHbokw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgMls3tdg1equr7nw8oyQupopH6OIJjgbG8dmfw2GxYw&oe=6A900B89"}, {"file_name": "2.png", "id": "213929834579484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974537_213929841246150_2126938869392503972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ddz2YQI-8MQ7kNvwE-Ruz-&_nc_oc=AdoGyGwRXgdsTMozjIOs-vNfDsedS71-XD74RMjuZljTVGIgm34f12z-D3ZMoRsU6_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2RRp1xMgmMcoP7pP4W5FSQy0beEsEx9fEgph83OY3Tw&oe=6A902207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VID COVER.png", "id": "537194471909024", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75251819_537194475242357_4309468404986525274_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSRduWWgDuAQ7kNvwHPLVWY&_nc_oc=AdoZMVQfDrpk6wl9CMu2MTxnMN1TWAoOJqgR92aA5AqUBWUwT2IdNskwrrkWMkmB3NU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn0I8pohQ6NEZGRdhvO2diQ13ZXisOL79bD1joVU7ARA&oe=6A9025BC"}, "display_name": "BallisticVR", "keywords": [], "long_description": "It's a puzzle game where you start by taking a tutorial to teach you how to use the input system to control the missiles before launch them to hit the targets.\n\nThe directions that the player inputs is relative to the missile's axis all the time and the player can hit the targets with so many variations of inputs.\n\nYou need to go throw a magnetic field to hit some of the targets which increases the level of difficulty as you progress in the game.\n\nWhen you finish the level in a the fastest time you can put your name on the board.", "short_description": "BallisticVR is a Meta Quest VR game. it's about hitting targets by trying and refining inputs. With so many worlds and so many changeable targets the fun never end to beat the fastest time.\n"}]}, "developer_name": "EYEFORK STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eyefork/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "EYEFORK STUDIOS", "support_website_url": null, "website_url": "https://sites.google.com/view/eyefork/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7776746665787920"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031332_1197053007681139_7897954441911827885_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr4D8Z_KThQQ7kNvwGDH9aN&_nc_oc=AdqmNZLPTqZMwpDYLkxQv7cghVA4Mqwb96sQWYExfEieXiH0TBbQ74bciuBefrADQn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRSxzDXFxDgvYMCQO098iope0y0r0vHdsKZqOEu9nZ5w&oe=6A9010B5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BallisticVR", "platform": "ANDROID_6DOF", "context_category": {"contex
mrCDAQ&oe=69E8D75D"}, {"file_name": "Scissor Lift Safety and Operation_Screenshot_05_2560X1440.png", "id": "285004124153620", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75593939_285004130820286_4686391512891869317_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCWFJL7LQ6gQ7kNvwGPJALc&_nc_oc=AdogXp6GSRCTeDbBtsFLw6ySS4OukZczORAXS72lEQhE-MEhhVhIItE7-PEhfjQnkAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ycWh60ntd_AYFIcfX5kN9kbwwolu0Nl9cessw6_1Kmg&oe=69E8D164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Scissor Lift Safety and Operation_Screenshot_01_2560X1440.png", "id": "1302159294022928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974885_1302159297356261_2972959549361089636_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBBIrWLwUGkQ7kNvwGZ5tWZ&_nc_oc=AdqJN-NFd-cJVlZ4vUybRAsyUY-io59k9GxMHHNbD2TI9Cz9ieMjcAbAIKmvewn6fxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WMlai9Uz8M---jR4zv4tJuDo7UicfEt9GLP44yxALVg&oe=69E8DA0F"}, "display_name": "Scissor Lift Safety and Operation", "keywords": [], "long_description": "Scissor lifts are flexible vehicles that help workers reach heights up to 60 ft. safely and efficiently without the need for ladders or scaffolding. The lifts have a platform that can accommodate multiple workers, making them perfect for team tasks. Indoor construction sites, factories, warehouses, and commercial buildings, use these lifts to perform tasks at height, such as maintenance, renovations, and moving building materials.  \n\nBackground Primer & Activities: \nAn overview provides participants with context and helps identify different types of lifts, related parts, safety concerns, tipping lines, fall protection requirements, and the basics of a walk-around inspection. Then, participants engage in a sort-and-match activity to learn the central controls and steps required for starting up. Embedded learning outcomes based on Bloom\u2019s revised taxonomy include remembering, understanding, and applying. \n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn and practice safely operating a scissor lift in a safe and realistic format. Before beginning their tasks, participants must don personal protective equipment (PPE) and conduct a thorough walk-around inspection of the lift. They must then navigate through the warehouse, collecting task items and repairing them at heights ranging from 25 to 45 feet. \n", "short_description": "Scissor lifts are flexible vehicles that help workers reach heights up to 60 ft. safely and efficiently without the need for ladders or scaffolding. The lifts have a platform that can accommodate multiple workers, making them perfect for team tasks. Indoor construction sites, factories, warehouses, and commercial buildings, use these lifts to perform tasks at height, such as maintenance, renovations, and moving building materials.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1054953838996146"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved":
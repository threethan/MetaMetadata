A&oe=6AA3F6C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "page2560x1440.png", "id": "1712785096659004", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620875_1712785099992337_6127890218167065968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr4twtF7ml8Q7kNvwG1VVNn&_nc_oc=AdoW-mdhw3HUx7v9HBg_ixosGIf2NgS1BLJMctQdB5Z-O0tcV8IQ-UnMQvJN_Ec_rVU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_ZgOjzJmMhN3MdOu4KdqRH9SFgHoI77dRM4L9-VTtvg&oe=6AA41AA6"}, "display_name": "Home Run Stars", "keywords": ["baseball", "homerun", "strike", "sport"], "long_description": "# Step Up to the Plate and Experience Baseball Like Never Before!\n\nPut on your VR headset, step into the batter's box, and feel the excitement of every pitch. Swing naturally, time your hits perfectly, and launch towering home runs in an immersive baseball experience.\n\n## Features\n\n**\u26be Realistic VR Batting**\nExperience intuitive 1:1 motion tracking that lets you swing the bat just like you would on a real baseball field.\n\n**\ud83c\udfaf Challenging Pitch Variety**\nFace a wide range of pitches, including fastballs, curveballs, sliders, and splitters. Test your timing, reflexes, and precision against increasingly skilled pitchers.\n\n**\ud83c\udfc6 Compete for High Scores**\nBuild hitting streaks, crush home runs, and achieve perfect contact to climb the leaderboard and beat your personal best.\n\n**\ud83d\udcc8 Progressive Difficulty**\nStart as a beginner and work your way up to facing professional-level pitchers with faster speeds and more deceptive pitches.\n\n**\ud83c\udf0d Immersive Stadium Atmosphere**\nFeel the energy of a packed stadium with realistic environments, crowd cheers, and immersive sound effects that bring every at-bat to life.\n\n## Fun for Everyone\n\nWhether you're a lifelong baseball fan, a VR enthusiast, or a newcomer to the sport, you'll enjoy an easy-to-learn experience that's challenging to master.\n\nGrab your bat, keep your eyes on the ball, and swing for the fences!\n\n**Are you ready to become the next home run champion?**\n", "short_description": "Step into the batter's box and experience realistic VR baseball! Swing naturally, hit powerful home runs, become the ultimate batting champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.taifrog.games/privacypolicy", "developer_terms_of_service_url": "https://www.taifrog.games/termsofservice", "publisher_name": "Taifrog Games Limited Company", "support_website_url": null, "website_url": "https://www.taifrog.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1305747285946931"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3329820263866554"}, {"status": "PUBLISHED", "id": "1035679299177749"}]}, "baseline_offer": {"id": "1035679299177749"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "3329820263866554"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1299291656592494", "version": "0.1.00020"}, "id": "1855978949117363", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application"
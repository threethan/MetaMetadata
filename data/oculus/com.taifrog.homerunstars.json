90742947868443336_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGEXGJy50J8Q7kNvwEvEF4_&_nc_oc=AdonnAf8pe7BtDZV6cLAHswgHLj2c2QIk8M11YWoedSA24j1Vej8b2YYLSPc-K8VKR4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTMm81V9nDwkL0Y_10bYHFQ3CeRNXzN3VswzQU3mg53Q&oe=6AA40EB5"}, {"file_name": "Video Project 1 - frame at 0m51s.png", "id": "1387095556213012", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619187_1387095559546345_5518091563366160151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY93ybAPadEQ7kNvwHmP1KX&_nc_oc=Adq7opch0YrpR9qIBivNBixZ1TUthxW3quc-ilFgbZIgfgNNPdkY5BYkvVLtItM-gh8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5FUoTEjYNFrst9zal86hGo600Rh3uhqE95vCR8tJUjA&oe=6AA3F6C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "page2560x1440.png", "id": "1712785096659004", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620875_1712785099992337_6127890218167065968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr4twtF7ml8Q7kNvwG1VVNn&_nc_oc=AdoW-mdhw3HUx7v9HBg_ixosGIf2NgS1BLJMctQdB5Z-O0tcV8IQ-UnMQvJN_Ec_rVU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_ZgOjzJmMhN3MdOu4KdqRH9SFgHoI77dRM4L9-VTtvg&oe=6AA41AA6"}, "display_name": "Home Run Stars", "keywords": ["baseball", "homerun", "strike", "sport"], "long_description": "# Step Up to the Plate and Experience Baseball Like Never Before!\n\nPut on your VR headset, step into the batter's box, and feel the excitement of every pitch. Swing naturally, time your hits perfectly, and launch towering home runs in an immersive baseball experience.\n\n## Features\n\n**\u26be Realistic VR Batting**\nExperience intuitive 1:1 motion tracking that lets you swing the bat just like you would on a real baseball field.\n\n**\ud83c\udfaf Challenging Pitch Variety**\nFace a wide range of pitches, including fastballs, curveballs, sliders, and splitters. Test your timing, reflexes, and precision against increasingly skilled pitchers.\n\n**\ud83c\udfc6 Compete for High Scores**\nBuild hitting streaks, crush home runs, and achieve perfect contact to climb the leaderboard and beat your personal best.\n\n**\ud83d\udcc8 Progressive Difficulty**\nStart as a beginner and work your way up to facing professional-level pitchers with faster speeds and more deceptive pitches.\n\n**\ud83c\udf0d Immersive Stadium Atmosphere**\nFeel the energy of a packed stadium with realistic environments, crowd cheers, and immersive sound effects that bring every at-bat to life.\n\n## Fun for Everyone\n\nWhether you're a lifelong baseball fan, a VR enthusiast, or a newcomer to the sport, you'll enjoy an easy-to-learn experience that's challenging to master.\n\nGrab your bat, keep your eyes on the ball, and swing for the fences!\n\n**Are you ready to become the next home run champion?**\n", "short_description": "Step into the batter's box and experience realistic VR baseball! Swing naturally, hit powerful home runs, become the ultimate batting champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.taifrog.games/privacypolicy", "developer_terms_of_service_url": "https://www.taifrog.games/termsofservice", "publisher_name": "Taifrog Games Limited Company", "support_website_url": null, "website_url": "https://www.taifrog.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1305747285946931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499626172_1733840301698360_610849766191205553_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JTD13eS5GkQ7kNvwFPgbRS&_nc_oc=Adp9yos-iIQe6zvNkJ1zx2Y9ek0N88_3t0Wv70405dp9JL_FeF6L25_jlAY1YeHJUJg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJELziaXRc6Kg6s7ocq4tMmtnJvaY2il-mYkrI1pl3yaA&oe=6AA41400"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Home Run Stars", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1786945500, "lastRevision": {"nodes": [{"id": "1297851343403192", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1297851330069860", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1745235073060923"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "648c5d22-de4c-442e-a22e-12df90398cb7.png", "id": "4577449775910167", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619681_4577449779243500_8840111655774345771_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4LmgBbVOYUQ7kNvwF0AjeU&_nc_oc=Adq16yU945HXDwI9sH8hk7Q0dFAiLl0inInPT-BdxcllrJxV-UHBsmIumIKvNYEZyNw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDWDF8P9KO3mQDcqIlGYbbgXD9adERG0dO0aaGCGSxqA&oe=6AA41660"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "4102938789951576", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620921_4102938796618242_8890962522392890759_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZM4XFrCTBwQ7kNvw
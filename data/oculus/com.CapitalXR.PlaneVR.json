, "id": "406330001528796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGFe5DfyVM8Q7kNvwF5wPGF&_nc_oc=AdrUcCrGWHNbbc0TWu15-4hNUDvQ6GfCp_A7dHu7cVEupbJTm9ccKpqPgBygVvmTUro&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNesZZVqyQYmi1qC4oCGaU0p78cpsLFarpINp-A0ZFVA&oe=6A7DA52C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoGJwa83zakQ7kNvwECEXor&_nc_oc=AdqPHP4vjfdHc9GMgOcq1rXn-LZRk-21-8_2VHW6-dIfSyQe04cqADP09xpfn84xL-U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGacbbCBNa-uVQ4xQJ3r-d5jzj4cOI-nLYrVW4IG-EQNQ&oe=6A7DD0D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D4bKkpTvA8Q7kNvwGho1qF&_nc_oc=AdqhhrADIvxTqhtOQwknMoKg3vJJEUyBynyz2of_7JXHEb_JjUFUAwDxeWOnLrsIyaA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0CJ0BmnTthfuw7uAwawFhZHjBceyTkDIh_xyavp-1Qg&oe=6A7DC74F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntVrF9QtgsAQ7kNvwGpIMom&_nc_oc=AdpAerk_G9mgBQEgyRSHSb1T8P8qpfT61jI9pM6pmx6dXulJMKBTZUrTJ2Uk_w46W_U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAXeEBSd-9A-IGd6-K6qL0PqxaCqP5357fHZjX_hfDfQ&oe=6A7DCCAF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frQZ3kaEzUUQ7kNvwHv3jLm&_nc_oc=AdpiC-BEM78kkfH30Ohzuqm_gDjOKodp4-yEdERxu5ztfPORsO-Poh1cYk9XxlO3aX8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETlSeMDR8A3bg2YQk4tSPN5x4l0DLAoDI_9RQHKS1uVQ&oe=6A7DA3AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https:
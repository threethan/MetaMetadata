: "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDadX1iO5MYQ7kNvwF40HC8&_nc_oc=AdmG9SrqU2LTj5frNX39M3E0jmxH-PMgLp9aAodz66BftOl6MF8uSwIHKbMr-4R3RQo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxcsa3B7dkf0lqphkVL_r-IXl6MwVC5DHJLm2WpQef6rw&oe=69AAB52C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCu6F7gjwdwQ7kNvwGz5xt3&_nc_oc=AdlIqyxfAigN7rj3B-tDlPeg40verzrD1Na2i3JfnsVX12PlOQrfdlZ-4aITWmOP3ts&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz_nBZuV8zHdfPzrsbnir9A8vFe7f5Holi8N8pOsIN7jg&oe=69AAE0D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk_itAFCHecQ7kNvwG4V-x5&_nc_oc=AdmUBn54QYAwS4Td645Kyaj567skwQMiL_PaHPzKEd1TQTxrwWM-7nycnTarO24FU9A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc7BvWsGn5VbzJXcUTIDoDgP-0DC66gSIRKqCW-SLpbQ&oe=69AAD74F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnQCw0UdTywQ7kNvwE6c0zi&_nc_oc=AdnS0d_M33A3apQl3y3SCmAUzcBYS844UM5gdMEqr3WARkG-RrcsVLhpCgXXkgEQWc4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0OJqj-Vx7EJkbQR1SQIh8ISBfZHqSRtpS8YRWdAAB7A&oe=69AADCAF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EezZXZW6E_8Q7kNvwGupCS8&_nc_oc=AdmHfBY-WAtrszdjeWwE8YWLtxS3dqJKnaJ-P4xegzrYOVuT9__VcfCnoT9wTlvqxJ4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzmbZ6ZKotDOmSSVzxy24fJzcPO0ku9kUjY0P8uP8Hgw&oe=69AAB3AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_r
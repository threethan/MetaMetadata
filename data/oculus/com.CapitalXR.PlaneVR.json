ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwgCvgzlsNAQ7kNvwHhPCl_&_nc_oc=AdkFF35S1wVo3jKqyPyMGi9aiALJusuR-XagPxxLxkHi3jivnlyGolVOt0LIaHq_r9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaeZjULxc-ocJFqLO-aLPYi5HSD9ksv9bac3RDK_p4Tw&oe=69B935AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2ReeFv7x-QQ7kNvwFFL4DU&_nc_oc=AdnqQInIWixZNWuOKBKfGfpqSvTtSIH2-zcZUW7QkjCRxSHPtUDTunkwbj2KjAzkCUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeJjyqAALvOpW7_AmtbwXpMrU0swzBiSxZVN-nPIQcIA&oe=69B96151"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLiEfclWhLYQ7kNvwHSfdLj&_nc_oc=Adlr4uWwwjnDHgilh-J8KCYlOiPPczPKZ9PUbvmS7zF7vOWvc8PG_CdzfaL0Qy_0Cfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAE54-_Oe10irongHuNfvPDt4f4W4OvIiqS67zAUoxtw&oe=69B957CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTJ2uBCCKN4Q7kNvwGjSJbx&_nc_oc=AdlqxdJve3tg0hZ-CH8Aa0bya7fJvB9RL2oxhiz0OuzvLLohq-K5ilnmee0vYHtPiKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxcekLO8YzWHv2FswQ-ayJMigLRZ9dDNGsrBrr6ExRWmA&oe=69B95D2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKeM0i8NV4kQ7kNvwGZOZFR&_nc_oc=Adla1qzetXHyJm0dfNxPH7wiFi33-KakD7Ooie8ei8joPJQtPfhgxMWHTznAgyTA3f0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrswBe31fd434j40cDTcnsKnWFCuMyxg0i_fBoVslaXQ&oe=69B9342E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
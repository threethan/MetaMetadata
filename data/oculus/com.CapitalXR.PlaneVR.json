ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw13x_pANeMQ7kNvwGvfPr1&_nc_oc=Adn1WD31LHc4cZFpIoIbEavta1BFBhDLaE2Hb2G2pHSPGXmGfQdvqwZACObBHu3rKxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8vkjZy7eJauo4PP_BYc-iAfQt_nu1V-me2G10E1ZCwA&oe=69B14CAC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGxxI3Q-HFQQ7kNvwFeEjWU&_nc_oc=AdnNZ7Vqy3yDQSMwe0RPMxDO-nADkuhdcCEOMzA34KO6JFj8Bvlh6pssyJNtvGc7o74&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcgHD12zuLMQ-vQh-ejgWxWL0VfEMTRCZYZ6PQusIgbg&oe=69B17851"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vX4zTSlbVAQ7kNvwHDq_A3&_nc_oc=AdmCfQrR4lvEW3hRDv8xZH6lXl0A7lN2B65IQYrB258ODMAYBKQ4zVA6DTI6syHPb7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9aZtv6_WqEjueY9qBOigbFx4_ihDOutFAYpoBe9jWyA&oe=69B16ECF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsKPQ3hYQUsQ7kNvwFycdc3&_nc_oc=AdkPCpY-Txe0WP3E24L1JxRx14obAeZJN5xghX7lg0w2t7VIpjScLulMrEP6LrPTxBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUiVXvhQzmwjYtxGUXzyY-NmOOWzrzlr413JYwRG5l1Q&oe=69B1742F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9qaOGgJB5UQ7kNvwFn45-J&_nc_oc=AdmvOSrjIepzROX8ZNGY4DfFrznAxPHlqOXu6KpXGqk6Yj11jNRzBcRCurozMF4R2eM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfykEhZHs2s00AQr9dZQ2ugVCQbzXIxVEMCvF_nadD2DAQ&oe=69B14B2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
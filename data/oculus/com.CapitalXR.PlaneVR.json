ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv_cLg2SbZIQ7kNvwFnbsk6&_nc_oc=AdnWphQLJ9gJf1H_yk_hKlgIuPeZ1AwEmbzA9B6D08x9MxnvTko9sHPWEmvo-AGZXY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyxeg6ZWjXv-oOiCfVVgoO8thQVW302BINnalvcYhigaA&oe=69B3EFAC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74Rq15Djk4EQ7kNvwGFMHYK&_nc_oc=AdnIFXzaHJBNvDPXdwEI8N5ZZNbQiGXLlG1xosjGFHlbwfsVH_0Xnrkv4F2j_k7P2Bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQz_KSSwjpOITP6IGYYr6hDdqEsftuRAvjkQOUhtmwpw&oe=69B41B51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0iCHbbnv6EQ7kNvwGAXdgA&_nc_oc=AdnpjIMOMMCfTpQskVz_PB4FW6efqegwDKuPmqt86M-DVp1OhUQVbN0Ff6hasO1CrCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2nuC1k9iRDA0GbfTnsF-2VGUsv1E6nclrZt8yXDwKCA&oe=69B411CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGf78rdoiGsQ7kNvwHvrHvR&_nc_oc=AdkPEO8hAMLs_GgY3QLWXuOWklFPV1KlEMzUueu0yVjl3VdTgEiVklOLAw3vamk07r8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyV0pmz86zqsQmIqAHyWbeEWYijWtaIBRx5Ic_KE9PL1Q&oe=69B4172F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mslgj5AONY8Q7kNvwE8jbIF&_nc_oc=AdnmLw-PEajPhXDk-IspqJfyv46IxrrFM_lHRR1nQm-5Ic78gwyyDJgrItGRc7TgB0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy27RHTv0BucaSBYySmUKkbbRaHz9xmB4pTPoAcv8KCYg&oe=69B3EE2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
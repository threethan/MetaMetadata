, "id": "406330001528796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdqU80gZjEoQ7kNvwF7D35Q&_nc_oc=Adous8B6PaHATKrFMNpvGE8N6gl5LBcWu_2g1DdvZnot5LLex6KBCY5p6sCVK3oPaKo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x9puwkSyxcgUMrJiDtZksAIi6JNIqaz5HmKYzLdSe8A&oe=6A11C26C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyUCy86W7a4Q7kNvwHaqhW0&_nc_oc=Adq06iUrxvcQ1_b80zB6MgdpCrwe3MUtK-xCa4EtOaZiBiybHGjyeI3c5-b3VJM4kuc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FxT-HpxDzXYT8hXHlwubDbxVTkR_ltdBHx-Iaq0tYfw&oe=6A11B5D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To1HisV_tssQ7kNvwFNa3Qs&_nc_oc=AdrrWtxznZ78oeW6GWf9f0CpQoYIFcoNwWux9FpXhDzOMN2g_TunbJ9FOrN-ztB4Gvc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kdSSBIlR8TIcc8jI4qpqN-Tl3o0lOia20Va3rabIDMg&oe=6A11AC4F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu__DZDPcq8Q7kNvwFVNLVz&_nc_oc=AdpBZZh_6Qy-L7oAhbroubOr62nXNvo2UgnMPYPzVjB41wA0mOULfq2-81EvJD_0E3A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dbgjzgiPR1RtWzbsE0Tnz77EgQlyfzd0fkiSMUJxtrg&oe=6A11B1AF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4P0jTHUsEpoQ7kNvwEUOO7U&_nc_oc=AdqUnLqcT6G2HMKenww1sQNFJv92urMcoLgItRzA-AQdt3IJXvkIMwx0VrqmI2gVo6o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YpqgA9RCbKOR1GOuRq9H33AAAOcI4sgXylC_kK6v0UA&oe=6A11C0EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https:
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RlXF2u_mNAQ7kNvwFNUInT&_nc_oc=AdkXByhRzZq1VXuc-mTTbVKBPtq1oRVMzuYedhvwc91BMib8QRQmJrzprysgpfi7-Js&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzioJ7lGrIkLJfm-8IRSDsDynh__HM7L614KtV_lu6ewA&oe=69BE7BAC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XGaQpr4SmsQ7kNvwGFRAsK&_nc_oc=AdmvMhyd4b4mOZ0C4ANd1k66GFQmtPpwj-GxKAqdRvJwppTUujWZW5lad8mNnBOAwQA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7i5sB35-EGSPTEERgvpmi1pU_I13mt4vnIzuMwkC7IQ&oe=69BEA751"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0EF_uM_B8AQ7kNvwHCwWsM&_nc_oc=AdlsZ0kVJXjR4RCz__7gXTER2LZMms61G02JZ990hLaI0HOx1TLJYZJSKgxnFuq56U8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6WqG_JwiwZUKT0Rbecema_DaR84TLQ9BqnXnGSX_dRQ&oe=69BE9DCF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNiKFVAb39cQ7kNvwHcN6CA&_nc_oc=AdnVJVT238Ok7sP_l1mYdxPxDiYldWiB2mglfu0xn_UIX9TXQ-14d9t6bhUVylAKxB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-q_6YK4CjtdF_q5qWPtiz7e_m3Lk3ccXmlilvMieGfg&oe=69BEA32F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGr_evnkHGoQ7kNvwHUZ7w_&_nc_oc=Adlon5yh_i1btuktW_P8aeg3QnFzs5KoNUX1Q0ruM24L-7blkBzlSEfSnoImSPFfnOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFMNnScx_RYXOrXrxrVGsBXEcsecFbXhIQiHcSyP3l2A&oe=69BE7A2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
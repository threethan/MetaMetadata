: "406330001528796", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQyfaRveemoQ7kNvwHvg1XE&_nc_oc=Adqses2fkRUYnO8G6x81aP4kRuqz6-dncoEey5q4j2qQuhVIXMnIyuqemcePeylAqJE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMuvsrk3jJMj361IzgbdMTjo7wNI_mXnFMdNVr_lOIYA&oe=6A9ADE6C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqKJZaTrZzAQ7kNvwFzZxWR&_nc_oc=AdpSzeqOgv4UhehJRHGzvVlK_Ge-o0Mogm98x-slUoE8dB3feYo2-ZqcdxKCBKjun8c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9_IJXgMFRzBhZQadXTP9O-alMxsKTwJg0W3Jg_7Otkg&oe=6A9AD1D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcJoQMJ0Iv8Q7kNvwGNlVPr&_nc_oc=Adrch-1ib3iVyzvObMk6eaVg53CfL51Hip9GcfOf0i258vlEJJsYrUt0jhxyzzIay7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_0y7xVORTWHEaAOL7uhieF-VGcd41DQisiWptk3kt3w&oe=6A9AC84F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgBYxEuvA-8Q7kNvwGbtGz1&_nc_oc=AdqYj0gX02nUsPIBLYa3JxP84ZhR62VeVU8jnfJuP-LmeEYoebpHQh0PkKDTZLERHWA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7gAvYzdUwt8LrBmFXwLbd3bQuWKRHvOfIa7bFV4ykAg&oe=6A9ACDAF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOEnBmDE9b4Q7kNvwEHpDwk&_nc_oc=Adp6I4JAfJ-hayRncv4zt7ch_BNK9eB7ALOn5GSp9FfEHfr7LJyg-bhZzfNhPvrGPHM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAGyCDHx0oZr2iY9VPurgwju4a-HAYVUb_zBVprPV7ig&oe=6A9ADCEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "835465294503752"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "879091851238784"}, {"status": "PUBLISHED", "id": "2096576594520067"}, {"status": "PUBLISHED", "id": "890966200176516"}, {"status": "PENDING", "id": "1519514979277111"}, {"status": "PUBLISHED", "id": "839636697185571"}]}, "baseline_offer": {"id": "839636697185571"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767530940, "status": "PUBLISHED", "id": "879091851238784"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25180235165005515", "version": "1.3.78"}, "id": "937424300252069", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4685190171603315", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25180235165005515"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781755980, "id": "26881267791568902", "version": "2.0.104", "version_code": 104, "release_status": "PENDING", "status": "DRAFT", "binary_te
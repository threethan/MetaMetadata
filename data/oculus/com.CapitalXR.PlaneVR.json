29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrwueaqrQrgQ7kNvwEwQiBR&_nc_oc=Adk5JCAcyfFhU5x0nQAvxSzy2eRll6CCdbfje8PbK2QXvi4ZEsLy267XiMuGc7ETXtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftnT_eB946IOiOsEaB_riPjBnDsdHM4MrnxyKGpJG2_4A&oe=699C34AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibUbM65C6HQQ7kNvwHgscSo&_nc_oc=AdnoJjncq4kd5w1fqOnyi-jbmCLAEcfG6d5xzXkeuBicjIS2ISIhrALx5KMzpW-hsk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfucKXT0UXqTKP6-UCh0RfEPcrUfMDbGemRd28I_CEaHBA&oe=699C6051"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8dUwEeLg6IQ7kNvwHpI1IH&_nc_oc=AdkuosEOKjdCUEBTZ0yWJQiUywrMC52PO-63aBVjXf5aytyIrH8zwPCOazeL0mD1GYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu-f7Wacwjvmk5v_w1jHmusRMSqwntw1dUl-V49L2eB8g&oe=699C56CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StDKYEVdQTAQ7kNvwFKm5r8&_nc_oc=AdmhlNOJcpyYJRFGNNpUTuhIDQorhmV3OgYHO5CfsHtHTp-QULcm31b1dLP9O8f9NOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvK7vgXpKvRPvpNe-ADTHOGrdCZMCbA_oxzHDi9xxafaw&oe=699C5C2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eclsJrAMHrwQ7kNvwGITZI0&_nc_oc=AdlmyDGUu1mxK8XB1ZvRpwRwsHx985rrTsOI-D_e5RylBIp5QMg_i8ZZynKw_5fUa48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftpwPJw-Y_C78v49CKv6m5HRI0HhiPl2ZGDGLDqBonuVg&oe=699C332E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
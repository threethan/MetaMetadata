29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIxCAia7JN8Q7kNvwHHmB5R&_nc_oc=AdmTaVH3CHCEaF_8y8ycSOPYlSZcRN7iIu_oMZFjK4mA2hYXSJrG1QKIgOFsf79EdvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv-uFcndKNfmFDp_f7Nc_Sxi5O_Gx0kNu7DMFfxbYQyVw&oe=699991AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz1XqlZIEFgQ7kNvwFVoHAs&_nc_oc=AdluIGFAutoG7Xts6_V8TjjMdQ9Rp3HjasAYCZv_IczzdvorwG8jtz6CpOEkLQWWp0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuZg33ayJqWLu8-DqDtznYcMQ7-EVusgGhplpqEIWLGjA&oe=6999BD51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMmJouB2oEcQ7kNvwHAGbvE&_nc_oc=AdljgZwAGiG_w7P8kc7gur1pFXfn0C7AFjZDP3J-S1R7IUyrjFZ1beb8A0zczuRVsiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJ5eUrMDWBB9gzIyDO8jPhtiqrfy7pB23T6T4iRdC3lw&oe=6999B3CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71FyFJUNUyEQ7kNvwG0Ghxx&_nc_oc=AdmpKlF_8Uhf5Iozyvrtf7X2Xh0utIbUmsq2-HLWVZto35Zr9r30qkBhUicu4aYotd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFXmhiNm7NIvF3W7uhlnomAcoXcKmSEFfiwToLhUVhRg&oe=6999B92F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9P9UDFX_NAQ7kNvwHUZrEt&_nc_oc=AdmKJe5VCEqngGeYVg_PQ6LSdw9aqDBgb9ZMcAL3dBu3xDl0xFLrGZIU-mnI62KHNrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1uX1oAHCY7uA9croPAcJjdMGWI9mogr2NtUgGXNLG_Q&oe=6999902E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
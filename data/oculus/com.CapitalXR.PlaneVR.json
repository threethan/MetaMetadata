ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwgCvgzlsNAQ7kNvwG0jAWl&_nc_oc=Adlccw02QvUjxGNl5DL04qydO80GGsHdsmNFp0Q1iqWsFWXg50cF9zHLQtmYUCVfaAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfqgxW6bBjfXFfp2jfksgOcWX-klG1r-izm8P6kSsKOg&oe=69B692AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2ReeFv7x-QQ7kNvwFFptmd&_nc_oc=AdmQ1MUMZwl3nrz3soHWDwbNS4AOSACmImv8FnaCMSID9drYIj4IbAv_B9QR9dlfPRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7UUufkQOEGUvtJlP-BNNCn6CcjRGvbj6Qfx-O_jg4pA&oe=69B6BE51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLiEfclWhLYQ7kNvwGyOpUB&_nc_oc=AdmVLWbne_hHZ79g9AlfQ7TVtxGTi0QCpcFdvzYZmyVjfqsZjswpftsQqpo2S-JztM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw15CZ2GAdspv5VbfCQAwhXsaRnC9RkWyS9-RH73XtYDQ&oe=69B6B4CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTJ2uBCCKN4Q7kNvwHD3bvn&_nc_oc=AdnFlgHSOuqamBjqvW_1Vn_huzgOgvWK-sRXtxmOASl1XNM7sX3LvCxxfZQYC_sFGT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfxncxKee1YG4QJxPUVXO_qb9rcHL0Af4FA7klqEMeag&oe=69B6BA2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKeM0i8NV4kQ7kNvwEcJycl&_nc_oc=AdmXk7y1CKBAJ0lcldKmOuUE--DsTg5QB4HSduMHUyYchjbEecMa8zaT8TNpWUJWBVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxrcWIIQIzx3oyzviVMK7O76E3qL60k07OvwFD0of94Q&oe=69B6912E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
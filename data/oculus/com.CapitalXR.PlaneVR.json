29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1ZSVWkTN_YQ7kNvwF-yIM4&_nc_oc=AdmlXYVvTDdlcC5RpLtt4gAvSylFX5-Wk84WE2RMOqwtZLAtUprT_jaYeVVRS1oIWXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfteS9UvJHPw39g1NkiuMkir0i1cJxYeGcE-RRq7cfzlTg&oe=699ED7AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spDrL90EDocQ7kNvwFz2aV6&_nc_oc=AdkaBDqqg555KZkpRACZCwBA8iEVCeXnlPvlTI_WA88jDwodxP14M48icuRD7101elU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfueO3NPGTCZMP9-tID4I0jRiG3l0iTuWViAbK1V5ax_oQ&oe=699F0351"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0nnuNSSCEgQ7kNvwGHEt4I&_nc_oc=Adk782m3ygRtggPzb9etaX3g9MOm28oqDgNGP7Wj94FtlyMMe7AG3O2hQO9xu0wXi5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuK3pIq3XvPRiEg6yuKb3JZYyUEjZnUGYnzkeYo-es4mA&oe=699EF9CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36-E5RwONjQQ7kNvwEYxenx&_nc_oc=AdkWylQClkPTwViA9J74_CQQTwdrDvQjbMhzUTHd7qxGDxxbW0KFTQVgUiHfmXxrHrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8G6LzJe4uSxZikTc6hiAVnkjoiVZTnXq6CjwLmXAJMA&oe=699EFF2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_WA3Npm4VMQ7kNvwGQf_uy&_nc_oc=AdkMkj78iMfruRstpDTONpx1FG2-99HkLnDQc2Ld_ab3j6OKY17A4XvdEw1utIw_mfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs7evUNQ2OJ_sOe3GciMrPi47AEKP4jSO5Bug2x2NkZIA&oe=699ED62E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
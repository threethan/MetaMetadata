ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3aM_dh75woQ7kNvwENiML4&_nc_oc=Admp-zLqVoaTd4pzZxXCpE15SE-AT86KoHhedVLvxUKfYxNvNqUPK8SEVcDys5bcU1c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXF-NzO93Y5f0D6ZP-i_szxwVeGND9xdv5t6Fjn1NDjw&oe=69BD2A2C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfSUXpiTn1gQ7kNvwFRBHgZ&_nc_oc=Adn08tYlrfIYl70_m14TZkVIq5vtPU2yrqqP7jf4Nok-R5D5F1Vwk4Cy2gzWmGVfYmo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFT4Jhmwh0wGRiOTwf5QcQUpK4jiDZXNt1oIMlD6ZZVA&oe=69BD55D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3eRSlc8fEEQ7kNvwEr6PpA&_nc_oc=AdlBdm6HUZKj9bfaopg1o_v7UF-H8t2OaKS7_DaxJB1LKfj7R1feLZH2P4qxhSi6rOA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz18h2WO0ELTFCvM9xC_zrw3kDJBaWqyigwOMvL97vrYg&oe=69BD4C4F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIwW4ix3SRQQ7kNvwHkMlHL&_nc_oc=AdnjG-hVj05hPHKeUoqj1sa1tVAMDSUEd9RM_4RcFIGTcGIg5ylMbxiizzVbrxQwc3A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxae9OBbXu0RgJoRyBAenjBK1AywvWBzfKLKVhNaaK2fw&oe=69BD51AF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98iReE4br5EQ7kNvwFw7CuQ&_nc_oc=AdnyDmdzXy2kcqlSVuxuQF91ckRNcRA0mgtuenBOSld_gHKZUV1UjQrWEanpi5NLmxE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwTT0poB2dZ5PZv9SwcQ_MJABJnFOXkTwh6dpHKh17TYw&oe=69BD28AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
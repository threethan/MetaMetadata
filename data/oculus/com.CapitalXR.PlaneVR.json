ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1n8bEAjB1MQ7kNvwGPSj5A&_nc_oc=Adm8j0afCpKOX1jlycWVsFpY9AvPV11566Fx_58xLJTK1LFi9Iv5Ynj1Q-0la5BOnX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftdRT9tnEhEwONMM3Z-SBCto-iYd3J03v5ySN7m35fyww&oe=69A963AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph4hyLI2jFsQ7kNvwHKoYMZ&_nc_oc=AdmRwGctDJUGwETR0cbRnvuC402KmIcRgohNtpMPPlcONZ4sYb_mkLVe2YY2ii2ejjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvCHKXABZlx7uDXjrvDapRib9vsdAVpmJy9wjD7Vpd3aw&oe=69A98F51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j9W6ImeKbAQ7kNvwHL0i7e&_nc_oc=AdmMUm23_qeOLDk3J2XHHtcQUqZEizBwA069RY5tWnUXabkJNfoDUMBFwbF5n4_MydE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvkyf9ZoImjbpKqsoqu-soHoQbRVFk0t2JjBB4vfu9ing&oe=69A985CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpgQB3NC2hQQ7kNvwGgwvw0&_nc_oc=AdleQ_WXlC_h5pMo9HBG9VUI-oh3oCNBwzFEjhIRpN6QZIgPWpAqn0lTCBwqJQt8rJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftFmRg9hTw2cetCFpYkLiBGjamGEASB1T8lFKW9fwzgQQ&oe=69A98B2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nInmmd7jkWIQ7kNvwHs_AvO&_nc_oc=AdmhhUD8-PWlUNxKABa-SWmo5EiBoM38KAwpXizs9llI4aJYFoX2KZgXqzsiyIop73w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfssmxTgCsTAF2-w_3DXedFokNlpy2LKnsIdfKSeWFwVqA&oe=69A9622E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv_cLg2SbZIQ7kNvwHpjWZF&_nc_oc=AdkwkwkY7qJ4lZdrwzPNF8XYAPWGOLglUXrfyEr7XHraH7P48Dfym6c2kBFG-CR1jB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkiM-C95JbuudLM2Bmz9FhTOTFnRtqPJFnAOznZTo1oA&oe=69B29E2C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74Rq15Djk4EQ7kNvwHQnJC-&_nc_oc=AdmdtZEtPpU7JJ8ixaNba7WcreEzKYZMKmlzGiOdeDYrOVwNMIqPG3sQzxaOUTyErlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyvAZ1cBxEBEZ0mNSerhjZRHxPV0N5geani3mz4nz7xDg&oe=69B2C9D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0iCHbbnv6EQ7kNvwFXnBBl&_nc_oc=AdnrulPwsP9-_aX5I4VDJV3CeQrFAOvZR0-rVMHsEiKWL0-rvWOJEHk_lYqtsVnimbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWqlvvS2Qu4vqAWa_j1x03xzcxxhCS0yTpRpglzMI02Q&oe=69B2C04F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGf78rdoiGsQ7kNvwFtbiTO&_nc_oc=Adl6Rh87yj8x4KTZSBccAq6PBFdVutA6h-p-wZjzsNm4Z6GVau_AE233QgWJmdraq0Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwttNwU2Vi0FDcP89F3R4AEU8JC-A_2rtCH1RzyuoGHrw&oe=69B2C5AF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mslgj5AONY8Q7kNvwF6TF9T&_nc_oc=AdntFdOJSbCWtbQzfR2A31S4qmlzlx6YT1kCWwjojbkjaxat6NRISBKcmwAPGokZHDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW80dnwnyJAkB-39urwC40xkMgSATqTLhXpQ2IQiXNUA&oe=69B29CAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9thmGyXFY6AQ7kNvwH57or6&_nc_oc=AdoMCpg_XJWhPbugcrKsPnBhQvtfSf5yQW2Hs0pJY_44_B6SjtH_-pKOfoCbWUVS1fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af05wSe-Gv8L3I3Lsv6sUIB2E0i7nIbl-ZTgm0pbCBARHw&oe=69F0CCEC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQ-v5GraeUgQ7kNvwH1eLlK&_nc_oc=AdoXxHiOC1HK1C5EKPLlXMMR-vOBUdEH4tv3T5d4S0DOiLBKVm7r_S--X01ZcOOqbjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af066-Kx2VKsCZkDWCoQAEhMJbZciLfORIoLPJGhi1gdgQ&oe=69F0C051"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyL1zysleIMQ7kNvwFwzUs5&_nc_oc=Adq57T9Z5VgvA74URHVmqu__AAFkhrARbUVtpJWufTAktyywsjxFjexYzaTfTRwLPZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1SAT6Nfkf7AE3PUDcLDDl1zbi9M60Hin7TPOyaJsOjWQ&oe=69F0B6CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZoK2kdKMKsQ7kNvwG04T0-&_nc_oc=AdocXQShEYs2_lfWkYshBwT4DFt8ex-rsfrrCKU51qgt-Zz5YAfopYSyA-5OqtwUp34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2LCzino3mPH5_gE0h33TIrW-WHmOFDIm_pGFFuy8o91Q&oe=69F0BC2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvtuXBx2YaMQ7kNvwHu9-lx&_nc_oc=Adoz591b_UCp9NQ41YGJxbpwbdUFBXi_6VWrA_Js1LGB4sE099gwYGtLr_SHhdCktj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2zYVyUAG8A2i4OmKkpchP8Cx9yVIj0dI4DafTvRM4L0Q&oe=69F0CB6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
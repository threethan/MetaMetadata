ps://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RlXF2u_mNAQ7kNvwGcREZM&_nc_oc=AdoU9T5UMxxHcDVpS76AUvdPlsgFDHVmzh93ow03ueblg9onRd07Q7Kh2tci_ho32Cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyN5vw1chU1sREob_aPsglh2rNZvciP8tIKDvlWo76nA&oe=69C11EAC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XGaQpr4SmsQ7kNvwGLIFcU&_nc_oc=AdpGmzAJu79pJI062Bor0yNH4sKMHlWbokJbxW3qlXP9brpl_HnTQ-Qcdcsk3nk0i8U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynVDwTDq7NawxkraAZfLBuIfJWFsHIkxzcgRphTTNM1g&oe=69C14A51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0EF_uM_B8AQ7kNvwH8UzAY&_nc_oc=AdowQzWAeJSwKvWCLz4h3imsLgngAGdm_J9yBdP9W3bMtnt8ezq1j5bN3w8_wYbpd1Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz78gEKa4ToATBthnBBWGZ3CquWUXU0ka48u-_SHD0H3w&oe=69C140CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNiKFVAb39cQ7kNvwG74sjq&_nc_oc=AdrwlrWZ-PyehpPsHSRx44EU1HBSH1Swr4hZc8_YcZh3_xvgAjioqW5kpQWuU75NstY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-5u1D3Hl4IbFjr2y32bwYje5DAnedw_2Sno5FTU3Jdw&oe=69C1462F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGr_evnkHGoQ7kNvwFeYLyr&_nc_oc=Adrd54C9vs7o-Qbfm7tKmb-81mhZMAyWokABi3IvXsmtcqxRiI-nLo4E3TWtu6RBg7w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfX4RWWIj3W5SUfdDMWpe5ateVO_aVFs87E4RRtJcV8Q&oe=69C11D2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
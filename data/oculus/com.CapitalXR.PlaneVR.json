29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuSfljTKpkwQ7kNvwH7qiM6&_nc_oc=AdliBwJtmZfxcESCn2u88thNL8La7mA2BCTPmcIKprwyWYv_VUikD7NOm9TLMj3Ykqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftdr2aOUn0RQGOYcCwpvv2eSlGDKsgdmwfvgzl85LRYXw&oe=69A41DAC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFuA0X8IpWMQ7kNvwFUDmpC&_nc_oc=AdmvMzQ7mcjcRnC3oglXUefvClE7Cv2ndtTn--8Dec_DKtuDSkiD-dFvAG_gJepizxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftGiSDj_BTJKkFO7aV317qHt6-QgPTjy1tv1uuTiiArow&oe=69A44951"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0cG7TKf15MQ7kNvwFmObiZ&_nc_oc=AdkuqEACNX2aGGYPQKKb-mewnnwWIjZjLYOUR82glFpMdAbLx3UQ8stAivVXWd6Q33s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftKZ1lkcsyPrGlS8ewHKw1fMIusacVvp1VqFQXPw8CkUw&oe=69A43FCF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frmFqX9RHUUQ7kNvwFU6PYb&_nc_oc=Adk-U_Qi03ssnwWISH3iCjIFOTBUfnp2lAQQbG0OoFqJnIKaaGPHdT3XaeI46eMFLnQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfufQCN50TlMxBKAVygQ3c8dlztFpDhx2Ids_bsmuPtIsA&oe=69A4452F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mu2zxiSrCQwQ7kNvwF0tPrM&_nc_oc=Adls9c8CukCTVHkcu_mybcO4vDJCUiCccqhr_iT02W_b5dzxzhzGFod-iFg36_dKCtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvh7w3XFP9dVXsnxTfFzk0PFwLEiAbLBxhWdFtgDFmsqQ&oe=69A41C2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
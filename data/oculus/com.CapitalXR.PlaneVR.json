29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1n8bEAjB1MQ7kNvwE2mvBb&_nc_oc=AdkdUqKsO6iOmGQz1zZoRMGN20KnGhP10oz66Lziwp5fY6UldRtzICAt6ldBFhGoXZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft1VzLSqd2aR7MLfTnCAU6SS3s0Vfz7zYFGTpXCv-ucPg&oe=69A6C0AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph4hyLI2jFsQ7kNvwHuJt1M&_nc_oc=AdnuXG9JY9FTGR4XXdliw7NpLETl8E8S9naCD47Ue9jqh11dCVtKzPS8ybqkw4-bnFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfujnKRfsgtgEK_x0GPJUKslQR7-EGhKpZ-1HOFmiewBjQ&oe=69A6EC51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j9W6ImeKbAQ7kNvwHcbcfM&_nc_oc=AdlGdkuBaGfUg0et540CWFWmrVKwgkyZ2x1zBX_ixcq_W-0yOrOHRIKtroSr7BFMNQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvn3Aa8-zvDLVyuhVWuaedPtz4Oi_dIpMnVE59YG_RfnA&oe=69A6E2CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpgQB3NC2hQQ7kNvwHZqcry&_nc_oc=Adkc-cxKS4h7i7tVo7FYSI9sX4FyoyXtpxbdwkrzAC7IWtEGEqKP-RE_XzLrmdqTI8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRy1Geh9XwSoBsbuMoXMiAtReMn9S-Olyn_HEIqUEnyQ&oe=69A6E82F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nInmmd7jkWIQ7kNvwFKTz_8&_nc_oc=Admo156O3_a4olrsnad34Bg05i7QVcJqMciYLzMu2jaA3p-KsK4Dgu2R9gm3f35eROk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswjIxAl_J1TYhgRHopLqaMxVGOei7V9oSgTvDaE_v8Bw&oe=69A6BF2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
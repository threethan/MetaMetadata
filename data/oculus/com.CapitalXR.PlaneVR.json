29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrwueaqrQrgQ7kNvwEPeksJ&_nc_oc=Adnt848iP-s1yffqiMy7Qojm0zPSlGhm_HFNcj1yrN8rR6Su8HBBprfNCm_dVeE6MPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftIh_BM2mtqkEkT-_gT83KbWflVGpD8ZiUIU43iDjfhKg&oe=699D862C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibUbM65C6HQQ7kNvwGgW2Ga&_nc_oc=AdlXYFfMvWA65kLHwRLyNDE0uAjwTJ1zVd2sguTioJOkphNPmSRH_-sDgrWVysAV4s0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdfyigeBLZy0Pk9hS_3_lfUwo2GoSxNDOargWg5FJt-g&oe=699DB1D1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8dUwEeLg6IQ7kNvwHLuIzs&_nc_oc=Adny6zxAtJLUvMj4tpCy-yr43yApng_e1Qu7cU3yz7LJsj6mIVWBv4xOZtKTckgPsUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDDtz82ShVn8m60LpeZFEyNENKdrTfus_L5EPVZYg8GQ&oe=699DA84F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StDKYEVdQTAQ7kNvwHW-mC6&_nc_oc=AdnflJurWSqpBhLEHFyuzdvAfGvOblxKwXhG0Gx3eKxm0AC_rnn1bK9l1V6qKi5K7cU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftwpC_V91DGsnucH4NPV_eXnTaIZRjnVFvvosYlNgKVyg&oe=699DADAF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eclsJrAMHrwQ7kNvwHZRUle&_nc_oc=AdnDiISQzX0xt753DI1amKiUsFUxga63LYbAEM-Es4F7YTaX9CNJ3Kd5-lFoCbTYJJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuK4HEATk1-R6DcWiSPosCjKVSHs03G-SjpJMDE4Fi_yA&oe=699D84AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
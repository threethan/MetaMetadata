ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1n8bEAjB1MQ7kNvwHK2Kby&_nc_oc=Adk51VSGbXMRQx-q8avGy5QB30QvoqQzJt502CVVAB5c9L_CuNDdMU9uZhIeyOcl20E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftYT-pbs_YW5nZ1sYrSrkj1t4Jb1AjiUrbnuuFyEgeYAw&oe=69A8122C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph4hyLI2jFsQ7kNvwHW4Zzl&_nc_oc=AdmjACbec8ZXxz2KKxzFIC8gpvGluLkwCxIB8qdrqnmdcAayXX9gjfoOkbVJyrGiXr8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsVcHfXoh84EuuI_WhH9nt_zSTX2lwLP7faOvLpRBPSHQ&oe=69A83DD1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j9W6ImeKbAQ7kNvwG4S_zk&_nc_oc=AdkbMln762Vd4qtHm9w-t95IpOK26WC6X-B0wQVDpeRHMdvvJVcBgohWhJIsnM4JTbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftQYpbUB9RMwRK69NgpNFw1_G3kiPyD1kvKWn9h1hfDRQ&oe=69A8344F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpgQB3NC2hQQ7kNvwEw9TOP&_nc_oc=Adm6m-_jBmgcB7Lxb-E7O61DgN4UM6IShsIMmIwuN2S2P9VfvuiurHDlayCSZUTo0Rk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftqDCdTsNkjGGfdzUfSGZgF4U5hv5oXIOelusKiMrp2yA&oe=69A839AF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nInmmd7jkWIQ7kNvwHtONdp&_nc_oc=AdlPDEQE4q3pgnl6RFgw5PV3T1E4IUTjgAylfU-gIgxVhTPRYhW3w4-QdNhu61cJjG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsRjQVhDUBNVEoW4DKWSxabqH5tvZVTpjCV6wq2Lz_Nuw&oe=69A810AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3aM_dh75woQ7kNvwEnMuUj&_nc_oc=AdlCWPP6XPh21bkNE6R01S9gigW8tjeuC_pFKL-1FttMMqETJbVZjik7cNP71LYf2qQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCQz9_0rc1u1A3XvGxculk1ijs-cfzJCWm1p8T_5E1Gg&oe=69BBD8AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfSUXpiTn1gQ7kNvwHjPO27&_nc_oc=Admk7-uyQUIHcdtjFgYOhqqw5aUfUG5iWFT4Jk_9dxdBfPTwYVzgZZAed130oRSS_v8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQGt5Nv30nvnl23kmdx4uMVi4LIr-vCtmTk4WPJ1xXlw&oe=69BC0451"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3eRSlc8fEEQ7kNvwEi8HSN&_nc_oc=AdkyGyFdOQg7wku6CC7KSCzIx8rW4DmiG3NyUdlKMDfLCnvs9qiFe4apnx0-7iBFlZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5y0cQKXyWy-AYQBn8JsiKEac_sLEByDy7nQ6rWF1jTg&oe=69BBFACF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIwW4ix3SRQQ7kNvwHMktLU&_nc_oc=AdlZTcuT1-Mr_2j2ZTKCcgvVr6KE8EKTxjrNx4l8uTHuo5WvWTSzxtAafnGSKm0hZxo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzromcrkysUuXayz2-twxHCKgjSY4WJF1MKBnS2yFvAZw&oe=69BC002F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98iReE4br5EQ7kNvwFM_SJW&_nc_oc=AdnBFfWhLI6kayZIizqBKVHX34BkWyCHZAP3iFwyPCvdC0cxrhjzSiQXH7BJJhRsmPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-z28EF7uJxoFrqXEKPBVkb-Y94VqkCw3CH92d1aiUNA&oe=69BC0F6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
29_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1ZSVWkTN_YQ7kNvwEbbuc2&_nc_oc=Adk9I_-gWOkZ7YHzRgjdzCjIsgxBRMR3lx06Jjh2Pv7lzrGnF3p5Fc40vaO8ivQ1dWs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuXztN8XFFUTTZx1LR8LJGFGkPEvT-86f2aMIcqqfsF-A&oe=69A17AAC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spDrL90EDocQ7kNvwF4NrFf&_nc_oc=Adlbe6Qs7p8zXMAblD2Z38-o8dnvOTmVSmCeJm-stueW5rulP_Fc9EDOCxTpMYRN4Ic&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu9LVoGQpjack2Kq9EzYhadiSAVHeatHH7d0ozuBMx9Iw&oe=69A1A651"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0nnuNSSCEgQ7kNvwHvX04K&_nc_oc=AdnXxbqWriuHzxUEacoCBhhiVgBmMMjC9Vatvmbzx3sec8jonmmoU_3Je2zJNIvAvdw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs6xuwMH0IruhqnkwHxTTzedmQQlWEcf0P5cFsppXJ_Xw&oe=69A19CCF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36-E5RwONjQQ7kNvwGLP13c&_nc_oc=AdkiVq1feY4hSCyDU4abQHnMOaY5T-ruBEBo00mIfd2FWzWaUMgUdfn3buqsoauBvgQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsxGSKeuiS8xN7weRiU8cTNaNrRVxq3ABFemOfk0b7iPw&oe=69A1A22F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_WA3Npm4VMQ7kNvwEoO7GN&_nc_oc=AdlH76ycky1-oE-hZWPDWiVvzymsaF3XysRYBRwWS--ZBYz5R1FB6wySSppYYJF9xBU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsZHhPHehjg95NqrKURu0QMOnbtm6H1fEnngPpe0PxkuA&oe=69A1792E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv_cLg2SbZIQ7kNvwFb_Bly&_nc_oc=Admue_T8f7cmi7mGHiX1ngG6YAJ5aHKA-NZsfgvoTFxLLV4bG_kJsEZgEWw50t5XfBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz52NbP3lFBOtc6Zu_TbJfD2VVsM7JWd06NoBxeDupmOg&oe=69B5412C"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74Rq15Djk4EQ7kNvwErk9rv&_nc_oc=AdmWW7jP2DL-Kzed92SqKV4KWfIWr3KxqqPrexTvYgVvEZuQxjIqVJ0ateEMogKHyho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyf1RbA2SwunDzHXbCur945rCVlAXEMm1SV-A65q0Ks-g&oe=69B56CD1"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0iCHbbnv6EQ7kNvwEbvGPX&_nc_oc=AdmwjG7GXZlNlyP80PWQH48tM7mjjY_p6hLXvV4NEIB83QlSTwR8V1WGnBDTAJ6zJ_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzK64mAs7Ra4GYHdL05F6rttTrZo7x9F8vfE2xnUKZDyg&oe=69B5634F"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGf78rdoiGsQ7kNvwFW1NSW&_nc_oc=AdlqaqePW1H9pIzdiHZ8ilVfjPmgLpCtu4rrYPExhmVoVbWwGtHihfSTHxQsBMQaoPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfygyY9EHG26PyzVXGPx2KVtp89CmrdEagGmLu-nwt4YZQ&oe=69B568AF"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mslgj5AONY8Q7kNvwHdJmGO&_nc_oc=Adm1YwwlXYjSRfzw4_HP7nKLr1u0D57kvssdATl135RaOjFdsWV2Rm_Odu-lYlLUGgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNumI3P-RpGzs4HcDsY0h6UNSnI-LZfeMEwM8jpY58yA&oe=69B53FAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
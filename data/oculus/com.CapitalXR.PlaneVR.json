ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDadX1iO5MYQ7kNvwEyA1WC&_nc_oc=Adm-TzFvsTU2FQAropSPKk6iqguj_Rarck2Y7giBN_fW2O4nL0tFXFT5HW3505p0yII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzA0wuHMrGjQwVoMleFVmeH48cxN6QrPpAifW59j2SDoA&oe=69AC06AC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCu6F7gjwdwQ7kNvwHGQGWS&_nc_oc=AdkrqN5KCJvZKMVKe1PoUvv72LrrPvNcy9GPUS1LkHz8JSKpNuJgz96LWZsheGcDfww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrkAHIfW96_YWeDsqbwKFsbOx2itBiMF84Kyji0Gtd9Q&oe=69AC3251"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk_itAFCHecQ7kNvwEbEPnM&_nc_oc=AdkYjSaATvF7ITxVcMeK7Fi4edr3Y_6kk1tzH8mpCwuzzzkS9UZgn-zul5Al1IfyJxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymnwE4UfJ2Rl-ZCFETedT1X6s3EzWaxLZnjoQqQgiwWA&oe=69AC28CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnQCw0UdTywQ7kNvwE3C8Oc&_nc_oc=Adk5drYazSzqUnIEQ_E0yoacIjPnBWs3w6fjCeYSg2PvHXuU8moMHjL-T0bnyk8F1jE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxloi6TRtUfZSfF1_Ga4z-pgw-pyK7_vYdRV88HiZyhQw&oe=69AC2E2F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EezZXZW6E_8Q7kNvwGZguJN&_nc_oc=Adk84MiX6PCubiiaCKxUspTZ1HR6bZIHIlHgcwurYKwuOMV5WM04AmKqFgOR8rjSM2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdZf3VuDbxrsVRiIHwbD-rcE7b12JrlH6-AdH-I6x8Bw&oe=69AC052E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https://capitalxr.com.au/", "category": "APPS", "comfort_rating": "N
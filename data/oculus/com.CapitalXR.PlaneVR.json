, "id": "406330001528796", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/227853516_406330004862129_1175205830114362881_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8VpHG8dSFUQ7kNvwEiJRpd&_nc_oc=Adp_OzMx9J30GXsqBeUS6YUtyB1XuHwgZjl8WQbO3UNU4inaMXxHBoJI573hlR4sA9Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAPYd-0m1rXSN0Hz1hBvv-17C47xg-TGvkJXuRqMtHCw&oe=6AA418EC"}, {"file_name": "Screenshot4.png", "id": "446929100295825", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974854_446929103629158_8067820089203255135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQw8AGDl9KEQ7kNvwFAfx5P&_nc_oc=AdoyD-uzt08mb6570TEl_g4XQbJoFO5cUKWng-CSQL4JQwJJ55QYlJlh9-1t7jrr2ww&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8o8DQaoOKlIAKGE6rfc2lwJrPTMXCocgB3t7u5s_TlQ&oe=6AA40C51"}, {"file_name": "Screenshot5.png", "id": "1190351718408809", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974864_1190351721742142_5365923970435642482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiojqwXT3Y4Q7kNvwH6OhWf&_nc_oc=Ado0_uU1yno1bhcirwTLsvIgk_u9qF3hmWBrJ5dl3UxmtrpHCDlp6SUxMK8VzxJX0Bw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2H9RXnSbrJmLr9WlqezlOpvk-o_UbT7a1LPIgWiWCTQ&oe=6AA402CF"}, {"file_name": "Screenshot2.png", "id": "3148880642028043", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974864_3148880645361376_7350291430480536731_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrX7I2t7VJcQ7kNvwFZHgHq&_nc_oc=Ado3KGxs8hclDy3wApoPHvI0REXkPQC3ghtiikqI-nnPZT7XwOoeDmO79EpL5KG2u_A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMIaN0wtsyRzyWbI7_coTFFKOmsNR9uLiTMCzrP3J1WQ&oe=6AA4082F"}, {"file_name": "Screenshot1.png", "id": "1112549806002940", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75643375_1112549809336273_5726513214021419921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bho4qrEA00Q7kNvwEbIVOy&_nc_oc=Ado0B-qaInft4YlKa5Tz6bA8UcQ9IcHrAfoeBnEO95KZGbS-scdLqZX9pqzQ5NDJs3E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFbRrVVt4TZjcpo6ZeW_Q-Tv0qgVE_UpAGLXGSNzlqcA&oe=6AA4176E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PlaneVR", "keywords": [], "long_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can complete procedural checks both outside and inside the aircraft, in order to be better prepared for the real thing.\n\nStudents can be assisted by instructors joining their session and have the instructor remotely guide through their learning experience with voice and interaction. Instructors can talk to the students and guide them with their virtual avatar. \n\nNetworking aims to provide the best experience for students looking into the world of flight training and for instructors looking to pass their knowledge on in the unique experience that is PlaneVR.\n\nPlaneVR is an application that's already in use across multiple flight school in Australia.\n\nThis experience requires a Quest 2 headset.", "short_description": "Learn how to fly a Bristell Classic aircraft with hand tracking in a realistic flight simulator that walks users through take off from Canberra airport and teaches them the basics of flight over Canberra ACT.\n\nStudents can hone their flight skills in a world class flight simulator. Students can be joined by qualified instructors to remotely assist with their session and guide them through their flight.\n\nThis experience requires a Quest 2 headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://capitalxr.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CapitalXR", "support_website_url": null, "website_url": "https:
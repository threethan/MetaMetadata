: "907883678453756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_907883681787089_2253442365174884600_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynB_mN5dzU0Q7kNvwEItd9R&_nc_oc=AdqZ5Lj2rjerOjJBfdgkkOF1qvc5eFSiK_8qN30QW5LzkwrO2zevxafRX26rqZH0ruw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFipLNsVbrGJErc3oTxiLNX98e9fKRFgdaESBr3Xj8DIQ&oe=6A7C6B66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Stunt Bike Extreme Moto Rush Sim", "keywords": ["VRStuntBike", "MotorcycleVRGame", "BikeRacingVR", "ExtremeBikeStunts", "MotoSimulatorVR"], "long_description": "Get ready for an adrenaline-fueled VR stunt biking experience where speed, skill, and balance decide everything. VR Stunt Bike Extreme Moto Rush Sim puts you on powerful motorcycles and challenges you to master extreme tracks filled with daring jumps, narrow platforms, steep ramps, and off-track obstacles \u2014 all in full virtual reality.\nFeel the thrill of high-speed riding and realistic bike physics as you perform insane stunts, land perfect jumps, and race through challenging environments designed to push your limits. Every turn, jump, and landing feels immersive thanks to responsive controls and a true sense of motion built for VR.\nWhether you\u2019re a casual rider looking for fast-paced fun or a hardcore player seeking precision and mastery, this game offers the perfect balance between arcade excitement and simulation realism.\n\n\ud83d\udd25 Key Features\nImmersive VR motorcycle gameplay\n\n\nExtreme stunt tracks with ramps, jumps, and off-road challenges\n\n\nRealistic bike physics for authentic riding feel\n\n\nHigh-speed action that rewards skill and control\n\n\nEasy to learn, hard to master gameplay\n\n\nDesigned for comfort and smooth VR performance\n\n\n\nPush your limits, conquer extreme tracks, and prove your skills in one of the most intense VR stunt bike experiences available.\n Strap in, throttle up, and ride like never before.", "short_description": "Experience extreme VR bike stunts with high-speed tracks, daring jumps, and realistic motorcycle physics."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25299603619736513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1212891230968811_2981862261018215588_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJWammnhzDsQ7kNvwFx38YB&_nc_oc=AdpXCkIXD8BhbQfIui0ddA7VyKdrOMNJ65hVWsIh-1IgBrqT_dKwnZ0s6_83I5g8nBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER4MKtqqB9wbKgn98ZEEgfiI-UJfs1zjV3aAtpXeB9VQ&oe=6A7C5EF2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Stunt Bike Extreme Moto Rush Sim", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Acti
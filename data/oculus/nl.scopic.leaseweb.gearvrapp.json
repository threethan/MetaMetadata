027761623767449600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSajF-UbSu0Q7kNvwG2xv5x&_nc_oc=AdoUQYReHB8OO078fCKHcwnIX0ol-CCZooVAkmty_cv066889uqH020AR__kIFS2E18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJgkvVAAuRotiWx70pk7nsi-Xxkqnv1BmjG1ns5bf9bQ&oe=6AB93C5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LeaseWeb", "keywords": ["leaseweb", "flying", "datacenter", "cloud", "stuntflight"], "long_description": "Ever wonder what \u201cthe cloud\u201d looks like? With LeaseWeb\u2019s new VR app you can see it from two different angles! The app offers both an immersive experience of the LeaseWeb Amsterdam data center that will show you first-hand what it looks like to host some of the world\u2019s leading companies, as well as a 360 degree flight experience in the LeaseWeb plane piloted by our very own CEO. Whether your idea of the cloud is the servers that fuel the digital economy or the ones floating in the sky you will get a chance to experience them both for yourself.", "short_description": "Ever wonder what \u201cthe cloud\u201d looks like? With LeaseWeb\u2019s new VR app you can see it from two different angles! The app offers both an immersive experience of the LeaseWeb Amsterdam data center that will show you first-hand what it looks like to host some of the world\u2019s leading companies, as well as a 360 degree flight experience in the LeaseWeb plane piloted by our very own CEO."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leaseweb.com/", "developer_terms_of_service_url": "https://www.leaseweb.com/", "publisher_name": "Scopic", "support_website_url": null, "website_url": "https://www.leaseweb.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EDUCATIONAL", "EXPLORATION", "MOVIE"], "has_in_app_ads": null, "internet_connec
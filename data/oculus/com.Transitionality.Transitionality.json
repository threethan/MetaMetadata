ontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_1588873365505735_2291693902917767547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HhAJz4SZrUQ7kNvwFA94u0&_nc_oc=Adp0AFHW59KUIxhT2nJoRVGPzcKSWP8T3Dnv8J-VEKs7lppDbdEOBhwbv_JxjJRtnSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4agu2KQ5sFLHSSawBhrA5JyRM9OuJO_To8gRh71m6H6w&oe=6A0DCCFA"}, {"file_name": "Screenshots (6).png", "id": "1854671271843476", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307413_1854671275176809_1773269959968287915_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIbz6yjehk0Q7kNvwGqa6Qh&_nc_oc=Adri1VIik45GdpGJ0Y3rWH-NX8ayMiKVY5dAFQkLZG3R7Tx6XwJMVi2pxtAw0QTqOFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52Zdiizw5fz8V3ULJUKOwKIs2xJ89_CtrJqzuvlNohpg&oe=6A0DD657"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey", "Backrooms", "Dreamcore"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Beashty", "s
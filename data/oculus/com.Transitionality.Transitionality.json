_ss=7f20f&oh=00_AQNLKYNeypHvYDwDFLTv2TBFrlAMcMGYmy3x-2_Xeg11HQ&oe=6AE36299"}, {"file_name": "Screenshots.png", "id": "26506066242326610", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499296209_26506066245659943_91896085792660908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62WItxGyIMgQ7kNvwFGpygE&_nc_oc=Adoi1MZS96LLf0Wz09CsBO3W_GRVImspPH7TErLMSrn0Y636b6CCl3Oz5CzwpiuOkpo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6vsHlcNVP6cEtUBAvrq3kj1OCXwJJSSXHP2ieidcnyw&oe=6AE347AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "1 Door, endless exploration. Have you ever wanted to explore a variety of levels with nearly infinite gameplay? Transitionality is the game for you. You can explore each level, and once you do, that level will show up on your map. Every time you explore, you will learn more and more about the secrets of Transitionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Landon Corfield", "support_website_url": null, "website_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2
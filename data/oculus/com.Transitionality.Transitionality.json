bi4w-3QxsGKqBKiuGG3PevWg&oe=6A36C39A"}, {"file_name": "Untitled design (22).png", "id": "1288219805710767", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818943_1288219809044100_4153025136128290964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sI4NLNzPJaIQ7kNvwHuRmv9&_nc_oc=AdohrgAO2B0BVrbkIRfjjeEyg2mh-zKyAZs001UiGecbRP0IFGe7n7n04a2BuUDGOpE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eUY_ZXPQ-MDjJVOHjf9e2WfC8gcoXcQzxKEPX5qT4WQ&oe=6A36AE19"}, {"file_name": "Screenshots.png", "id": "26506066242326610", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499296209_26506066245659943_91896085792660908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5XApkTmbaEQ7kNvwFhaKNU&_nc_oc=AdrVLukHz1MDNL6W4I10l6wECv9FKlVTdmjdHkdRnn6yuDiNrb6INYKaGw991H3rKwo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QhdShy0ghNYoT_sFL6f6bHrN5RYDgZvMiz1Tejw7jKA&oe=6A36932A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "1 Door, endless exploration. Have you ever wanted to explore a variety of levels with nearly infinite gameplay? Transitionality is the game for you. You can explore each level, and once you do, that level will show up on your map. Every time you explore, you will learn more and more about the secrets of Transitionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view
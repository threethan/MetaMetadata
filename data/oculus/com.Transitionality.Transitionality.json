https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617847_1588873365505735_2291693902917767547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fucou-ZtAmUQ7kNvwF70TgP&_nc_oc=Ado_5g_7BWYRD-xdwkrRkKapPEXStbLaKKobYb6e2ebdEhLp1HSOcnVSY_QXPAG9xGU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nZTE5yzBDCn0Nfkt8-T_OWLZUEuWhZbuBIyNRK0Qq1g&oe=6A36AB7A"}, {"file_name": "Screenshots (6).png", "id": "1854671271843476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307413_1854671275176809_1773269959968287915_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNSHMZHivO0Q7kNvwG2RVOj&_nc_oc=AdqhKfc77l8MliolJqRyJDum4uaIl9O3DOxpBCBLWrjnV2RFoV9EdhXELPglGPRagUU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l-ublUqHNhwmFrQhXltOIN8k4UPhd8l8aK36S8iK5ag&oe=6A36B4D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey", "Backrooms", "Dreamcore"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name":
54671271843476", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307413_1854671275176809_1773269959968287915_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6AHeq2kcCgQ7kNvwGFB0JM&_nc_oc=Adr00iEGq12NN_iAW6cNPGl4GnPZsZ93k4bJTXsmOaJqVIVtx7bCAvwC32HXEqshpYQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx1qnhMDhOYAoBuQsHP6CIPRG9WUx318TGYv8S2Ke-8Q&oe=6A7DAD97"}, {"file_name": "Screenshot (7).png", "id": "892866133899311", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499623345_892866140565977_1120936444939559907_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxqqwtMNe4sQ7kNvwHq_FE1&_nc_oc=Adpb1UO8T_8G0OKGVMyV6TjWSQvuxZ7CQIcekd_e4h-FR8r4RnymGlruGlwH6EC6ipw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUrpr92pJfOfljnhviK1T_xV_F-cpw8CDofTpjIQjbNA&oe=6A7DC284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey", "Backrooms", "Dreamcore"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": n
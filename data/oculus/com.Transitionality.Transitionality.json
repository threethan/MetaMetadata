771-25/491818943_1288219809044100_4153025136128290964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ays81lslNgQ7kNvwGFGlop&_nc_oc=AdluFrq8Od9R6_EXVkirM5ctTXx1wXX1yveLwPSanUYm5V9Fe1ZWn6bLPh-kqbImZqE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD1nJrHGpSXpgZkytahOlr8kmsuHfgQy73K8-DCXVG4Q&oe=69AEAB59"}, {"file_name": "Screenshots.png", "id": "26506066242326610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296209_26506066245659943_91896085792660908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVk0-vcsBMkQ7kNvwFwjEBv&_nc_oc=Adm5enu3Fg4GnxGf60VmQNbTjs8Q0DsSRtopcSHRjAHkcNZ5vD1xFWjbPeIOi8hBDoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3pwVmReQ6iK4irFA2FCpX45GuBq4R9aMMLTHZYorxrQ&oe=69AEC8AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "1 Door, endless exploration. Have you ever wanted to explore a variety of levels with nearly infinite gameplay? Transitionality is the game for you. You can explore each level, and once you do, that level will show up on your map. Every time you explore, you will learn more and more about the secrets of Transitionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Landon Corfield", "support_website_url": null, "website_url": "https://si
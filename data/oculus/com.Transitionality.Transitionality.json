uoQ7ggANlrJJYnyyHYx5gRN9Sb7Mk4XO1Cog9kcMusBpaBeAmcnN1wClWfI-bvxU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDG0FeJi1KXjJx8hr7ha2SpD3dSsxpdkO_F6OIN5Q2eg&oe=6B0B2E97"}, {"file_name": "Screenshots.png", "id": "1815828042891767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823341_1815828046225100_6358077088778420657_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8oqVJdB4QUQ7kNvwEqUMkh&_nc_oc=AdojgGrLa8bC-U5GjcxWquy5QWXLRbTykNioSibQSmnpnh3VewS_oxUo8CdYpjFkr1E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ53cjmkAb7WFBmr9UyYjiNBPf-VKimiGiFy9XOU97zmg&oe=6B0B37CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey", "Backrooms", "AsymmetricHorror"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Beashty", "support_website_url": null, "website_url": "https://sites.google.com/view/transitionality-privacy-policy/home?pli=1&authuser=0", "category": nul
ogBHo0zg&oe=69E0D9DA"}, {"file_name": "Untitled design (22).png", "id": "1288219805710767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818943_1288219809044100_4153025136128290964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLBjJiq53BUQ7kNvwEj0dcg&_nc_oc=AdoQnilb0cdZTV_zFpvwWNIyFSpoHpmtUiyArlRKyzT_hU9nNeqr4rhdz7_5OREgq_s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CYwA0H4YtKwej5Gi8kfMzoyKbETSrj3cHNMyeXhELnQ&oe=69E0FC99"}, {"file_name": "Screenshots.png", "id": "26506066242326610", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499296209_26506066245659943_91896085792660908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sl2P6AMA6IQ7kNvwHLydVC&_nc_oc=AdrmLjqV1H4mQWdLPeWGuum9AgxBQR1Y23S2YbuiPcYaDIwFaSO5TFR2zJZCRbPn5Zc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T3e8c36Lz0Cenb1GJ4d5ofD4scbipCJaXSIw68vdfaQ&oe=69E0E1AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "1 Door, endless exploration. Have you ever wanted to explore a variety of levels with nearly infinite gameplay? Transitionality is the game for you. You can explore each level, and once you do, that level will show up on your map. Every time you explore, you will learn more and more about the secrets of Transitionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-p
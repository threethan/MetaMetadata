uNGULbS96baR7Q1b-UVffLgcV9itn_Eu675ZMFqWd80x9d85jOwM6YtiZwRxavrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLtb2nxuQtttGtXbcpmrQ2gcUbX_GJI34P_u9bMiRLCw&oe=6AFB2457"}, {"file_name": "Screenshots.png", "id": "1815828042891767", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_1815828046225100_6358077088778420657_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Dmh1aZtecgQ7kNvwH1HVGZ&_nc_oc=AdpG_sNsX3AtbUpAt8VH7zujO2-kSgRZKzvBvsjsAkH-JjssuB0hq_6k5BDJgj72GyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBaKI8iymg9jGL-w0hbNw9D5m3HOdSUr7ebYuGNh9H8Q&oe=6AFB2D8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey", "Backrooms", "AsymmetricHorror"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Beashty", "support_website_url": null, "website_url": "https://sites.google.com/view/transitionality-privacy-policy/home?pli=1&authuser=0", "category": nul
3698770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617729_1277984420365436_1404447247905351050_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSFdiMCncLgQ7kNvwEpXbym&_nc_oc=AdrUqRuLoIq0ea1hx3kz_ApE2Lc9V6UuuGsk8I_8dehdkbGfa9hDpnR2IUQIbYkinFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EB1VWCn0apDwZ4su_raspxjo26O8gy09wrKeqdMDN8g&oe=6A01D1DB"}, {"file_name": "Screenshots (5).png", "id": "1588873362172402", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_1588873365505735_2291693902917767547_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kvFajfrYmEQ7kNvwF1DEGG&_nc_oc=AdogZKq6MsZnb5ARyuu4ud_R_jd6_MX-r4WA_d9NYPTCNVHlsxNXXyqHeMx41eIaOl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TF0pBW0of-OeGflEF782tqoZHzFaUYf5W07Rld7_5fw&oe=6A01EF7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Landon Corfield", "support_website_url": null, "website_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26550251727940499"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296214_2469713516818600_7126679570665619720_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbVrBl4yDNYQ7kNvwEli3PE&_nc_oc=AdrK2nAegAGjkdRG8XkbGfymW6ARbDV-axfrLeZAHO6Rs1UZijsM5Qd8KCY_HPZ6Q4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qw-g09OwYiCd9dCM7j1dS6PtXyLXSC579wvSW1fBnHg&oe=6A01C388"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Transitionality", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1765836000, "lastRevision": {"nodes": [{"id": "24402948966004130", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24402948919337468", "is_first_party": false, "enables_in_app_
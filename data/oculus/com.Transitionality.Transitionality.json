3bjfMY_mGk9-ldzVoqjKrl0enhzCKJnaAYOVYhKj2fkmVRk-v3ihA8mBXwLwMV2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgXQ_dBalfeyNmxvgTu7Kv7-jgz_Vyht7h76QKh2xzyw&oe=6AFDC757"}, {"file_name": "Screenshots.png", "id": "1815828042891767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1815828046225100_6358077088778420657_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVqTYmlxDOcQ7kNvwFNDEM2&_nc_oc=Ado4cBBGPulZxthfgC-8r9IeWSGlbEao_U5TEVcv2vt_q7pcnMefA6K3OoB02Ctj41M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMw09rR1TENh4cMgB5cYpgFl82mnaxYSECLGiy0C6aAw&oe=6AFDD08A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey", "Backrooms", "AsymmetricHorror"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "Transitionality is a VR Horror game that uses Gorilla Locomotion in a fun, simple way. There are many horror aspects, such as entities, ambience, fog, audio, and more to keep the player ready for anything to come. Do you have what it takes to explore the simple, yet complicated world of Transitionality?"}]}, "developer_name": "Beashty", "developer_privacy_policy_url": "https://sites.google.com/view/transitionality-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Beashty", "support_website_url": null, "website_url": "https://sites.google.com/view/transitionality-privacy-policy/home?pli=1&authuser=0", "category": nul
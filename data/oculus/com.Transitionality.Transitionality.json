sUaXF4IEbDx3SlG-UYN1Lseg&oe=6A7724DA"}, {"file_name": "Untitled design (22).png", "id": "1288219805710767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818943_1288219809044100_4153025136128290964_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf9uQ0ru04IQ7kNvwH6IWYi&_nc_oc=Adok4qrIknuio6kPdb6b3CANbRNreeWD5Y9RU-Oj4r5Scxt1I2dzGwAHoDz8g7aK1B8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNkb7MWhb8cUyteqYLGYDHihBNvumRKyhaDaXUS9wSsQ&oe=6A770F59"}, {"file_name": "Screenshots.png", "id": "26506066242326610", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499296209_26506066245659943_91896085792660908_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rabZbL48R0Q7kNvwG-CzvT&_nc_oc=AdqiSF461HyjVnYrHiHhNhIFJU8UseIu5sQcPtnXsKdRHfRcB4uf6-gkGfTP8NuBxxk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlmFDXEwny7dgvgYsKLdBZHNPpapbwqNHU7hZmCbyDtw&oe=6A772CAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Transitionality", "keywords": ["Gorilla", "Horror", "Monkey"], "long_description": "Transitionality is a game where you explore several different levels, each with their own unique twist. Some levels might have a monster, while other may keep you alert with the ambience and the dark fog surrounding you. You never know what the next level will hold until you experience it yourself. This game will constantly update itself, adding new levels, and more content for you to enjoy. Do you think your ready for whatever challenges this labyrinth has in store?", "short_description": "1 Door, endless exploration. Have you ever wanted to explore a variety of levels with nearly infinite gameplay? Transitionality is the game for you. You can explore each level, and once you do, that level will show up on your map. Every time you explore, you will learn more and more about the secrets of Transitionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/t
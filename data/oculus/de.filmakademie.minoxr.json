-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4sRNv1PX3KEg1gGXZ4ZVIwgDtxOtSx2lbdWVFasMoAg&oe=6A5F6A22"}, {"file_name": "FotM_SS (7).png", "id": "691053233958157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_691053240624823_531712794194118404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAfrgtmAYYkQ7kNvwHrZ5AG&_nc_oc=AdqIiFEV-c2EUrS7SqgKo5F1g8vzOE3_dLS9lPOeswB1k5P6aTD1x2Hu-lmif2g9niM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9IJb8L596haVdANpRbzVwaTdKX37VORV-yEQ3E1wXbQ&oe=6A5F54F9"}, {"file_name": "FotM_SS (6).png", "id": "798811776564021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_798811779897354_3249652390951778577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T8wlJlm8nkQ7kNvwFfAPcI&_nc_oc=AdrQVz3SyNEFKDwpZB1SXGLk5GjHRNT9Gea6D22Nmxr0iKJyIR-C1a1sH-bCo1ufHFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj_VRh37jRwzifO9y-9M3evhxuAKnxc_BPI65w-NQmOA&oe=6A5F60FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fate of the Minotaur", "keywords": [], "long_description": "Within our narrative location-based VR experience \u201eFate of the Minotaur\u201c, the players embody the role of human sacrifices from Athens who are sent into the labyrinth of the Minotaur by Minos, King of Crete. The players learn about the tragic family story behind the ancient Greek myth and have to pick a side by either killing the Minotaur or sparing the troubled creature's life. In a unique approach, the content can be experienced in different immersive scale levels, depending on the technical and physical limitations of the location presenting the experience. From a technical perspective, a novel engine-agnostic and flexible open-source virtual production framework was used to realise the multiplayer network part of the game. Our non-photorealistic visual approach is inspired by ancient Greek murals and vases, allowing us to provide the experience with a small footprint in energy consumption and required equipment.", "short_description": "Within the scalable narrative VR experience FATE OF THE MINOTAUR, players descend into the mythical labyrinth, learn about the Minotaur\u2019s tragic story and confront him to escape. It can be experienced by up to 4 players in 3 scale options: free-roaming on 8x8 meters, stationary or non interactive 180\u00b0 3D film."}]}, "developer_name": "Filmakademie Research & Development", "developer_privacy_policy_url": "https://emil-xr.eu/lighthouse-projects/fabw-location-based-xr/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmakademie Baden-W\u00fcrttemberg GmbH", "support_website_url": null, "website_url": "https://cli.filmakademie.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26123789830611056"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1522965378989192"}]}, "baseline_offer": {"id": "1522965378989192"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775124000, "status": "PUBLISHED", "id": "1522965378989192"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26256433337346704", "version": "1.0.03"}, "id": "680017758446368", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{
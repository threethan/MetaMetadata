.com/v/t64.5771-25/491823901_877608768232801_4881262802221471748_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTcPw8wD8YwQ7kNvwESKz_i&_nc_oc=AdodljTQN6e4Airh79OOXUwWUrMESZpVb_dmYChndP2jtH_FSVVq6y_gNS2LWYK9Dy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9sQinuasyEIXcqp-I-DVq-Aw-plYqN1-R1BY1StrLXA&oe=6A5F5D9D"}]}, "id": "2085984458852122", "locale": "en_US", "screenshots": [{"file_name": "FotM_SS (2).png", "id": "1880782066656506", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825305_1880782069989839_4759469445910507189_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0YsevSbNeYQ7kNvwE-HPcD&_nc_oc=AdoxumB84w762LIWdLRP9JpjuYDEv62qejGsNIOkr68qs-lpX8V6UZSdeXcXtpX-Q24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdRydjCTQ2ftMdqpPv9lJTDmFqE6nYFeFOO9rXaGM4zA&oe=6A5F5F1B"}, {"file_name": "FotM_SS (5).png", "id": "765949645897061", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_765949649230394_4971348005612491428_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GInDCja9i-kQ7kNvwEGcw4V&_nc_oc=AdqXUke9FLgqI6-kXx_4s5dfGaThqbEGzZfWPJZzwsQ1qtfO79MeoyJA-BZz16YTqEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbpdn_76EhSOyc8gYp70XrCf32VuKjh-OZhmU5vVM2YQ&oe=6A5F68FB"}, {"file_name": "FotM_SS (1).png", "id": "1525653741977308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1525653748643974_2953848112718236792_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRneOcMFHW4Q7kNvwHHb05l&_nc_oc=AdpMmIn8i7C8zQOeJXCcwjtUmsVFFW7dUd8xY3shEd-TI81iGfe34KD_00VVO6ZYs7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4sRNv1PX3KEg1gGXZ4ZVIwgDtxOtSx2lbdWVFasMoAg&oe=6A5F6A22"}, {"file_name": "FotM_SS (7).png", "id": "691053233958157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_691053240624823_531712794194118404_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAfrgtmAYYkQ7kNvwHrZ5AG&_nc_oc=AdqIiFEV-c2EUrS7SqgKo5F1g8vzOE3_dLS9lPOeswB1k5P6aTD1x2Hu-lmif2g9niM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9IJb8L596haVdANpRbzVwaTdKX37VORV-yEQ3E1wXbQ&oe=6A5F54F9"}, {"file_name": "FotM_SS (6).png", "id": "798811776564021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_798811779897354_3249652390951778577_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T8wlJlm8nkQ7kNvwFfAPcI&_nc_oc=AdrQVz3SyNEFKDwpZB1SXGLk5GjHRNT9Gea6D22Nmxr0iKJyIR-C1a1sH-bCo1ufHFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj_VRh37jRwzifO9y-9M3evhxuAKnxc_BPI65w-NQmOA&oe=6A5F60FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fate of the Minotaur", "keywords": [], "long_description": "Within our narrative location-based VR experience \u201eFate of the Minotaur\u201c, the players embody the role of human sacrifices from Athens who are sent into the labyrinth of the Minotaur by Minos, King of Crete. The players learn about the tragic family story behind the ancient Greek myth and have to pick a side by either killing the Minotaur or sparing the troubled creature's life. In a unique approach, the content can be experienced in different immersive scale levels, depending on the technical and physical limitations of the location presenting the experience. From a technical perspective, a novel engine-agnostic and flexible open-source virtual production framework was used to realise the multiplayer network part of the game. Our non-photorealistic visual approach is inspired by ancient Greek murals and vases, allowing us to provide the experience with a small footprint in energy consumption and required equipment.", "short_description": "Within the scalable narrative VR experience FATE OF THE MINOTAUR, players descend into the mythical labyrinth, learn about the Minotaur\u2019s tragic story and confront him to escape. It can be experienced by up to 4 players in 3 scale options: free-roaming on 8x8 meters, stationary or non interactive 180\u00b0 3D film."}]}, "developer_name": "Filmakademie Research & Development", "developer_privacy_policy_url": "https://emil-xr.eu/lighthouse-projects/fabw-location-based-xr/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Filmakademie Baden-W\u00fcrttemberg GmbH", "support_website_url": null, "website_url": "https://cli.filmakademie.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26123789830611056"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821115_1096548839186696_365013319711665007_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRdxvrZ10VMQ7kNvwG-xlpm&_nc_oc=Adov4ab6GDAhQ2_QTIJOn7eQuxnA3-xPzbmKUmGonf_8lprHe5_dePKMILIrdZdqby8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXXo-h-Q84xvx4yFnZBGKto9vp2jkAGE7z4cBJcLnlYQ&oe=6A5F60E7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fate of the Minotaur", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1775124000, "lastRevision": {"nodes": [{"id": "24662973513359369", "release_type": "SCHEDULED", "administration_status": "A
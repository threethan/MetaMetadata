&oe=69A57840"}, {"file_name": "migrated_image.png", "id": "526408351608098", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12522329_623059887872669_680677654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05d1iSEUIXgQ7kNvwH78k1S&_nc_oc=AdngnQ3ua5Qk3I4jHYJMsA2vZHZqVNevxhGOVv5Tk73QKmCYqXPl9bgf4YBK7X6dHls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuOnw4hsXlYIv5HFG-UUPPGqSwG4Gbz3Iwf3k-rbNVOLg&oe=69A57952"}, {"file_name": "migrated_image.png", "id": "550558808920820", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533746_727563614050845_312279791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqn4PD03I2wQ7kNvwENneIh&_nc_oc=Adk78iZkO-8Qmg22c3XVOmDBTRWPnnv4YDbQg01opkVgSsfktb1nfHxC81gO_ecGGco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuN5nHvrhKlrJLKWniu0oYbTVLdDv5vgUSqUaHmzTBFiQ&oe=69A58D14"}, {"file_name": "migrated_image.png", "id": "595452944509509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386202_1134494369920443_243487705_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM9eS6MS2wwQ7kNvwG7ooSs&_nc_oc=Adm9vRb4IJsZIqteGvf7OaVjVFRCfNq0GZD0X9qm9zogvPfgNdb7jMvqW-uNjJm006w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsUzFEAOWnF0LmmOE-C3CrM3jAl50QT97jndy-D-UZVQw&oe=69A576C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlickVR", "keywords": ["video", "360degree", "blick", "blickvr", "virtualreality"], "long_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer. \n\nBlick pr\u00e4sentiert einzigartige Einblicke mit 360-Grad-Videos aus ausgew\u00e4hlten Bereichen:\n\nFlugzeug: Fliege mit im Cockpit der Patrouille Suisse, dem PC-7 Team der Luftwaffe oder einem Airbus quer durch die Schweiz.\n\nSport: Als Eishockeyspieler beim SC Bern oder auf dem T\u00f6ff mit Dominique Aegerter bist du mittendrin im Geschehen.\n\nReise: Mit uns kommst du auch an die entlegensten Orte. \n\nAuto: Zu Besuch beim Autosalon in Genf oder eine Fahrt mit dem Ferrari \u00fcber den Sustenpass. Steig ein und erlebe Automobile so intensiv wie nie zuvor.\n\nPanorama: Erlebe die Fl\u00fcchtlingskrise hautnah und sei dabei, wenn die Bergrettung zu einem Notfall gerufen wird.\n\nBitte beachte, dass gr\u00f6ssere Datenmengen beim Anschauen der Videos anfallen k\u00f6nnen. Die App funktioniert am besten mit einer konstanten WLAN-Verbindung.\n\nAnregungen kannst du gerne an apps@ringier.ch senden.", "short_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ringier.com/de/datenschutz", "developer_terms_of_service_url": "http://www.ringier.com/de/datenschutz", "publisher_name": "Ringier AG", "support_website_url": null, "website_url": "http://www.ringier.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "241427341491691"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410201_135515706901145_1977941380_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU3hNBNStlAQ7kNvwEcEuj8&_nc_oc=AdnoICMdSbphTTxVaZ_TICPNtE9g6-CiUWpf6RMLFOzJshiBIekbLP7r9Q88hArI4Lw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsJ5-idsn0vr1EAcASeOCD1f9L2oDxdGuGP4YsVNH8mjA&oe=69A58EBE"}, "is_concept": false, "is_test": fa
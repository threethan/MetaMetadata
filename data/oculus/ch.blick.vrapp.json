-2.oculuscdn.com/v/t64.5771-25/12427532_614494742056343_962435063_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfzrrOiFya0Q7kNvwG1Gy-T&_nc_oc=Adpuv5YeJA9HG2JMD96b5gc5NEKFnAeIkr2L6EjzG7Bn2Te1c-msej3eBFucZRrm8zU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVjGamvYeKnalFiq2UM9RGWZ8weKfR5QamT92_6Wxgxw&oe=6AFB2500"}, {"file_name": "migrated_image.png", "id": "526408351608098", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12522329_623059887872669_680677654_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLp4UU73gSMQ7kNvwFN804C&_nc_oc=Adr532mGceymoi8KpPl6YDv6cd-m2CAJyWjr50cCsBV4w8ULZAug04orvqQf0Gw94rw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwnYTJ4jSTXYGnDC7LMclXRIYljGPe-mCYqN91AKekrw&oe=6AFB2612"}, {"file_name": "migrated_image.png", "id": "550558808920820", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533746_727563614050845_312279791_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPQljttGZW4Q7kNvwF2rW0J&_nc_oc=Adr57-txUlhNS4DfSrNDxr5HV5ewR44JGPescZYrjeyLjDDGC5E8lqcudnZA7DKAAiU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdKSOGcvoLBfPkYaV1izkxwiKgmWWbok1FbEW904iq5A&oe=6AFB39D4"}, {"file_name": "migrated_image.png", "id": "595452944509509", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12386202_1134494369920443_243487705_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fx0jcXmeF18Q7kNvwECxDAn&_nc_oc=AdpEIV-M7MT-u68DyR0yong61QhZkktkKs96qUBGnE07oFPP8kniTC01skBIAY1lj9M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-1VSN8PjLaYJQd51fFJC6Ybt0S_tJkoD69M1jlxNAQg&oe=6AFB2383"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlickVR", "keywords": ["video", "360degree", "blick", "blickvr", "virtualreality"], "long_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer. \n\nBlick pr\u00e4sentiert einzigartige Einblicke mit 360-Grad-Videos aus ausgew\u00e4hlten Bereichen:\n\nFlugzeug: Fliege mit im Cockpit der Patrouille Suisse, dem PC-7 Team der Luftwaffe oder einem Airbus quer durch die Schweiz.\n\nSport: Als Eishockeyspieler beim SC Bern oder auf dem T\u00f6ff mit Dominique Aegerter bist du mittendrin im Geschehen.\n\nReise: Mit uns kommst du auch an die entlegensten Orte. \n\nAuto: Zu Besuch beim Autosalon in Genf oder eine Fahrt mit dem Ferrari \u00fcber den Sustenpass. Steig ein und erlebe Automobile so intensiv wie nie zuvor.\n\nPanorama: Erlebe die Fl\u00fcchtlingskrise hautnah und sei dabei, wenn die Bergrettung zu einem Notfall gerufen wird.\n\nBitte beachte, dass gr\u00f6ssere Datenmengen beim Anschauen der Videos anfallen k\u00f6nnen. Die App funktioniert am besten mit einer konstanten WLAN-Verbindung.\n\nAnregungen kannst du gerne an apps@ringier.ch senden.", "short_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ringier.com/de/datenschutz", "developer_terms_of_service_url": "http://www.ringier.com/de/datenschutz", "publisher_name": "Ringier AG", "support_website_url": null, "website_url": "http://www.ringier.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2414273414916
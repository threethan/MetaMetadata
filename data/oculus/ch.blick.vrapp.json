-2.oculuscdn.com/v/t64.5771-25/12427532_614494742056343_962435063_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl24eG_SBhgQ7kNvwEtNUob&_nc_oc=Adrgdi57Rqc5unukRFgeI2AENTL1xLzpIYUr4xyEXEJH4HUXC1rFqb6YtfzfOGTtReE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTq6MPnAbGkdYNlhMT-uTEbbQxGMSQsIrGIyGi3pSc1Xg&oe=6B0D9A00"}, {"file_name": "migrated_image.png", "id": "526408351608098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522329_623059887872669_680677654_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqsehf0u1ccQ7kNvwHXUQlD&_nc_oc=Adqu1Lf4UFCdllXoUv6qZ6203gKSV96wuYX_LqFBO7PNj5RKWlAQ5neOG8nWqb2cBgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQjuEyJLhdLSG3BMZEqH6gcmUX5uxWCxsUk6ghRF8giQ&oe=6B0D9B12"}, {"file_name": "migrated_image.png", "id": "550558808920820", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533746_727563614050845_312279791_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYmLMirdFAEQ7kNvwHVq345&_nc_oc=AdoMYdTZ3wM3_W9eYo2FCkqX9yjKjTvFblM5LkP33W8qWoS9YQHXaPo8Ulk6nRpaYGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTct5o06-qNxzIYVX004iczNaSmCJyCidl75KWYn7f5rg&oe=6B0DAED4"}, {"file_name": "migrated_image.png", "id": "595452944509509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386202_1134494369920443_243487705_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szQj88HyRJoQ7kNvwH-nRaY&_nc_oc=AdrJfKpa3IPOrP7_Wogn-d_fwBaFpu7WVni7i8tY8bYDI_Xxkw98wKe2QAIKrysN0bA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtAdSJ6MdHzrnizGBsUeoXbOuWqgbxorTrpZbNX5M5NQ&oe=6B0DD0C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlickVR", "keywords": ["video", "360degree", "blick", "blickvr", "virtualreality"], "long_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer. \n\nBlick pr\u00e4sentiert einzigartige Einblicke mit 360-Grad-Videos aus ausgew\u00e4hlten Bereichen:\n\nFlugzeug: Fliege mit im Cockpit der Patrouille Suisse, dem PC-7 Team der Luftwaffe oder einem Airbus quer durch die Schweiz.\n\nSport: Als Eishockeyspieler beim SC Bern oder auf dem T\u00f6ff mit Dominique Aegerter bist du mittendrin im Geschehen.\n\nReise: Mit uns kommst du auch an die entlegensten Orte. \n\nAuto: Zu Besuch beim Autosalon in Genf oder eine Fahrt mit dem Ferrari \u00fcber den Sustenpass. Steig ein und erlebe Automobile so intensiv wie nie zuvor.\n\nPanorama: Erlebe die Fl\u00fcchtlingskrise hautnah und sei dabei, wenn die Bergrettung zu einem Notfall gerufen wird.\n\nBitte beachte, dass gr\u00f6ssere Datenmengen beim Anschauen der Videos anfallen k\u00f6nnen. Die App funktioniert am besten mit einer konstanten WLAN-Verbindung.\n\nAnregungen kannst du gerne an apps@ringier.ch senden.", "short_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ringier.com/de/datenschutz", "developer_terms_of_service_url": "http://www.ringier.com/de/datenschutz", "publisher_name": "Ringier AG", "support_website_url": null, "website_url": "http://www.ringier.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2414273414916
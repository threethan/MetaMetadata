gtJD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwnEPao27H0W37zWFo57zM2Flm2K4teZ8-PR2fi6nTQA&oe=6A9D8A80"}, {"file_name": "migrated_image.png", "id": "526408351608098", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522329_623059887872669_680677654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YjZAue8i0UQ7kNvwExrtdB&_nc_oc=AdpaXiuF7J8okYVD_O_3nMtU4TuuMrbKNq91JbHw-FU8AOrLRaYSd93WfEeetxs5N3E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyap-n0TYtNJbk3rJtSXgUR9i9zcmKEOVbMoPcVYvaJA&oe=6A9D8B92"}, {"file_name": "migrated_image.png", "id": "550558808920820", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533746_727563614050845_312279791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URXHjaItM5AQ7kNvwEpL4_G&_nc_oc=AdrYFOeI4Jwc4NHq37TcPcRcM-BwVu1xBGFwQEir6ZS1v_QPrv4JzEq3RR6c_nbdEeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbeTLkBfEQnWVnd_i1MSVvDBcSlkI-M2gYW8Wz5wMhoQ&oe=6A9D6714"}, {"file_name": "migrated_image.png", "id": "595452944509509", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386202_1134494369920443_243487705_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RYwrVAhFFYQ7kNvwFG73Yf&_nc_oc=AdqmwgHR45L8iG6JCx-71ynDLIZ5fgrpt7j2VpF_fHj_HTrZuBkY4PUsG0HA9XVuE0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_oDFhPiruOtfm2NO1lYH-qAhvofKnZcaDirQ-IUo9oA&oe=6A9D8903"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlickVR", "keywords": ["video", "360degree", "blick", "blickvr", "virtualreality"], "long_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer. \n\nBlick pr\u00e4sentiert einzigartige Einblicke mit 360-Grad-Videos aus ausgew\u00e4hlten Bereichen:\n\nFlugzeug: Fliege mit im Cockpit der Patrouille Suisse, dem PC-7 Team der Luftwaffe oder einem Airbus quer durch die Schweiz.\n\nSport: Als Eishockeyspieler beim SC Bern oder auf dem T\u00f6ff mit Dominique Aegerter bist du mittendrin im Geschehen.\n\nReise: Mit uns kommst du auch an die entlegensten Orte. \n\nAuto: Zu Besuch beim Autosalon in Genf oder eine Fahrt mit dem Ferrari \u00fcber den Sustenpass. Steig ein und erlebe Automobile so intensiv wie nie zuvor.\n\nPanorama: Erlebe die Fl\u00fcchtlingskrise hautnah und sei dabei, wenn die Bergrettung zu einem Notfall gerufen wird.\n\nBitte beachte, dass gr\u00f6ssere Datenmengen beim Anschauen der Videos anfallen k\u00f6nnen. Die App funktioniert am besten mit einer konstanten WLAN-Verbindung.\n\nAnregungen kannst du gerne an apps@ringier.ch senden.", "short_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ringier.com/de/datenschutz", "developer_terms_of_service_url": "http://www.ringier.com/de/datenschutz", "publisher_name": "Ringier AG", "support_website_url": null, "website_url": "http://www.ringier.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "241427341491691"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410201_135515706901145_1977941380_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQ2LN1boa6MQ7kNvwGXFHHm&_nc_oc=AdrG5qDlJNcYKFrwk1oxOEn2uLlLa12V2s785Oj2XVG1dMr_chtfVxnwC7ik
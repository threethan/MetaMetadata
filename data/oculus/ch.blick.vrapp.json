ad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu94X4O64YpU0LvvzL9XdaLrmuRQMcCDC9ICswl61d9Wg&oe=69A96CC0"}, {"file_name": "migrated_image.png", "id": "526408351608098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522329_623059887872669_680677654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNUkgNDw8mcQ7kNvwFayJbi&_nc_oc=AdkPDuKEP1XPVuYLqFh007LC04yVGWOgk0ZD2B79VIapLKn-3PWsgpi3WJA-y2-6jM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfugZ5sGh_iwLWflGDoKtH9J834RNIYLD8uxOLSzrcGpKA&oe=69A96DD2"}, {"file_name": "migrated_image.png", "id": "550558808920820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12533746_727563614050845_312279791_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqN1QPc4cOQQ7kNvwHud8Do&_nc_oc=Adk_ujQKYX0YeusmddcNnbZxzn20d_kG5FtZDF0fzRjHn4soTysexU6TWpU1D96n3ZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvi7CNiNS9zHlc2q26Z0QUq-iqo-71VjbT-JyVlA1BfQA&oe=69A98194"}, {"file_name": "migrated_image.png", "id": "595452944509509", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386202_1134494369920443_243487705_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzotKahjJloQ7kNvwH28j1B&_nc_oc=Adm-ZKtdfvJveawsjECZ8L5U7fU5sbeG_kZD0CUKaIrXipBoACIeN__P1bq3I7Lx01U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftcbVM8pnDj9uu5ts5ImFtYMpN-LgXZZ948tsk3aKSaiA&oe=69A96B43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BlickVR", "keywords": ["video", "360degree", "blick", "blickvr", "virtualreality"], "long_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer. \n\nBlick pr\u00e4sentiert einzigartige Einblicke mit 360-Grad-Videos aus ausgew\u00e4hlten Bereichen:\n\nFlugzeug: Fliege mit im Cockpit der Patrouille Suisse, dem PC-7 Team der Luftwaffe oder einem Airbus quer durch die Schweiz.\n\nSport: Als Eishockeyspieler beim SC Bern oder auf dem T\u00f6ff mit Dominique Aegerter bist du mittendrin im Geschehen.\n\nReise: Mit uns kommst du auch an die entlegensten Orte. \n\nAuto: Zu Besuch beim Autosalon in Genf oder eine Fahrt mit dem Ferrari \u00fcber den Sustenpass. Steig ein und erlebe Automobile so intensiv wie nie zuvor.\n\nPanorama: Erlebe die Fl\u00fcchtlingskrise hautnah und sei dabei, wenn die Bergrettung zu einem Notfall gerufen wird.\n\nBitte beachte, dass gr\u00f6ssere Datenmengen beim Anschauen der Videos anfallen k\u00f6nnen. Die App funktioniert am besten mit einer konstanten WLAN-Verbindung.\n\nAnregungen kannst du gerne an apps@ringier.ch senden.", "short_description": "Hol Dir die virtuelle Realit\u00e4t ins Wohnzimmer! GearVR-Brille aufsetzen und schon bist Du Pilot, Eishockeyspieler oder Rennfahrer."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ringier.com/de/datenschutz", "developer_terms_of_service_url": "http://www.ringier.com/de/datenschutz", "publisher_name": "Ringier AG", "support_website_url": null, "website_url": "http://www.ringier.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "241427341491691"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410201_135515706901145_1977941380_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiITtwzHhnUQ7kNvwELBNTZ&_nc_oc=AdmfV3vb5i_lVtytXbriF4R5z4oWpEPpuR50mIsqr7oNvkp45aUamSGd5k_Nx-60KpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscd
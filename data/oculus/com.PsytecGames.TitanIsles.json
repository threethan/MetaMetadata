cdn.com&_nc_ss=7f20f&oh=00_AQCkBlKmCcDf84H5WsR1lBMty1cV01evstEr8uftCdbsWA&oe=6A5786E1"}, {"file_name": "S5.png", "id": "594540090098322", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391768_594540096764988_2692738886458572333_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=---U4va7u2wQ7kNvwE2Unsf&_nc_oc=Adoxl05Cgs-ycV7IwnaCl2oaxsNIHm0w47ftb2UWhHwPKTb7l4eK4wDNF_GhgWH8KfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCN9Svebk63nwlTgs-k1kE5BrRfPHMppdRS2LZUqeRAIQ&oe=6A579FD5"}, {"file_name": "S4.png", "id": "563142826702019", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391826_563142830035352_1391789033301939051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T_5ifhCC4wQ7kNvwFm1sju&_nc_oc=Adom4IOAmYKVfBBEf0IaezDzVki6t6PU_-zYMdPYYTUmHKAnKpP0KW2qfn3PGbtdIbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg5Lkig73k4hPs9XmWg3xaZuPR1oUaQCV8_pruAzNXbg&oe=6A57971A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1165371891310867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391812_1165371894644200_4815590377693614845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm8i7CRld6YQ7kNvwE-CSJn&_nc_oc=AdodrydnxU3hG7A0ikj0CJHEE_4VHsaia5CaMxaT33B3ZgcO2RImJQDwz2oxlSOJkzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXRO5zJJziGNJ-ec-LHfnW9xcC9z2VpEWEMYeBozMfnA&oe=6A5782E0"}, "display_name": "Titan Isles", "keywords": ["adventure", "coop", "combat", "flying", "shooting"], "long_description": "# **BATTLE TITANS - WITH FRIENDS OR ALONE**\n\nSet on the broken world of Toska, shattered to ruins by the mysterious awakening of giant Titans, you - the player, are cast into an epic struggle for survival and revenge.\n\n# **USE POWERFUL EXO SUITS**\n{1182808979868801}\nBefore launching into each mission, you\u2019ll choose from one of four Exo Suits, each providing it's own unique traversal equipment and weapons.\n\n# **PLAY ALONE OR WITH FRIENDS**\n{658737879847254}\nThe full game can be enjoyed as a single player campaign or you can invite your friends in up-to 4-player co-op.\n\n# **UNCOVER THE SECRETS OF THE TITANS**\n{565889143140523}\nIt's up to you and your team to locate and defeat the Titans, along the way you'll uncover the motivations and secrets behind the existence of the Titans and their destructive attack on the world of Toska.\n\n\n# **TRAVERSE A PLETHORA OF ENVIRONMENTS**\n{1282405879494333}\nAs you progress, you'll discover the many different biomes that together, form the vibrant world of Titan Isles.", "short_description": "Battle swarming robots and colossal machines either alone or with friends across a fractured world of floating islands and breathtaking vistas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "https://www.psytecgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28753331844282205"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1536082827694281"}, {"status": "PUBLISHED", "id": "1293953882762885"}, {"status": "PUBLISHED", "id": "105771714650
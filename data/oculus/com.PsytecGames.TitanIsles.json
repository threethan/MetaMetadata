ldEeKDBxOm-dA&oe=69BAA461"}, {"file_name": "S5.png", "id": "594540090098322", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391768_594540096764988_2692738886458572333_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYvAahx_qqoQ7kNvwFUxJ4F&_nc_oc=AdkvSGywceZy89epVAo6V5S0uV8ODgvUa7F9BWdU2piVmmCtiicPHlzANwXEqj155Cs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwkc0FcBEWoenI3Rtz817dS7YVNlzSgs_DH0GMfs5G_zg&oe=69BA8515"}, {"file_name": "S4.png", "id": "563142826702019", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391826_563142830035352_1391789033301939051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLQgHF3KyUkQ7kNvwEhQwxr&_nc_oc=AdncWRp563vng1089C3BOYEoyJbglAYLwtrvHCPsqjm83gb86P37DJGsxnfrD4GOc9Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyohepe2HyRTOmG6bFkIRWd-9iaqu0It17vv3BtfOJ93w&oe=69BAB49A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1165371891310867", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391812_1165371894644200_4815590377693614845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9JLW6AuwFRoQ7kNvwEhwnr1&_nc_oc=Adnm2rHCRMUYs--MwXhs6zqAAb-4HTCjyiZSxK10EVBaULvKhOJwFy_5PlHvco_VL4g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzw6qOWDxrN9Ozjgxm6LvtbkugjnKl_jBx0UrkwkEdoVQ&oe=69BAA060"}, "display_name": "Titan Isles", "keywords": ["adventure", "coop", "combat", "flying", "shooting"], "long_description": "# **BATTLE TITANS - WITH FRIENDS OR ALONE**\n\nSet on the broken world of Toska, shattered to ruins by the mysterious awakening of giant Titans, you - the player, are cast into an epic struggle for survival and revenge.\n\n# **USE POWERFUL EXO SUITS**\n{1182808979868801}\nBefore launching into each mission, you\u2019ll choose from one of four Exo Suits, each providing it's own unique traversal equipment and weapons.\n\n# **PLAY ALONE OR WITH FRIENDS**\n{658737879847254}\nThe full game can be enjoyed as a single player campaign or you can invite your friends in up-to 4-player co-op.\n\n# **UNCOVER THE SECRETS OF THE TITANS**\n{565889143140523}\nIt's up to you and your team to locate and defeat the Titans, along the way you'll uncover the motivations and secrets behind the existence of the Titans and their destructive attack on the world of Toska.\n\n\n# **TRAVERSE A PLETHORA OF ENVIRONMENTS**\n{1282405879494333}\nAs you progress, you'll discover the many different biomes that together, form the vibrant world of Titan Isles.", "short_description": "Battle swarming robots and colossal machines either alone or with friends across a fractured world of floating islands and breathtaking vistas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "https://www.psytecgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28753331844282205"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1536082827694281"}, {"status": "PUBLISHED", "id": "1293953882762885"}, {"status": "PUBLISHED", "id": "1057717146500816"}, {"status": "PUBLISHED", "id": "1660711631556809"}, {"status": "PUBLISHED", "id": "1189180823153595"}, {"status": "PUBLISHED", "id": "878090164883274"}, {"status": "PUBLISHED", "id": "1223463316252870"}, {"status": "PUBLISHED", "id": "2812487922294703"}, {"status": "PUBLISHED", "id": "1762274367753390"}, {"status": "PUBLISHED", "id": "1098842878847918"}]}, "baseline_offer": {"id": "1057717146500816"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770404400, "status": "PUBLISHED", "id": "1536082827694281"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34225442800404388", "version": "1.7.20"}, "id": "3336161029990352", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34225442800404388"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3336161029990352"}]}, "change_log": "\ud83c\udfdd\ufe0f Titan Isles Update v1.7\n\n\u2728 What's New\n\n\ud83c\udfc6 Prestige System\n\nThe grind pays off! You can now unlock Prestige Tiers for each suit, and once every suit hits max prestige, a whole new prestige system opens up. Show off your dedication: your Prestige Tier now displays on your Avatar Label, in the Social Panel, and in the Room Browser. Let everyone know you mean business.\n\n\ud83d\udc41\ufe0f Eye Tracking\n\nEye tracking is now shared across the network for increased social presence on supported headsets. Not a fan? You can switch it off any time in the Graphics Panel.\n\n\ud83c\udfae Quest Gets a Graphics Panel\n\nQuest players, this one's for you. A brand new Graphics Panel lets you tinker with higher refresh rates and dial things in to your liking.\n\n\ud83e\udde9 Collectables Are Smarter and Clearer\n\nCollected items now leave a transparent ghost object in their place so you always know what you've already grabbed. Don't want it? Toggle it off in the Game Panel. The Collectables Panel also now shows outstanding collectables for your current mission at a glance.\n\n\ud83e\ude80 Interactables Overhaul (Work in Progress)\n\nBig physics improvements are rolling in. You can now hit interactables with weapons \ud83d\udca5, swap hands mid-interaction, and bat objects with your hand. Physics have been improved too. Still a work in progress but already feels much better.\n\n\ud83c\udfe0 Hub Trophies Now Networked\n\nYou'll now see the host's trophies displayed in the hub. No more empty shelves!\n\n\ud83d\udd79\ufe0f LAN and Arcade Support\n\nLAN and Arcade support is now live. Reach out to support@psytecgames.com for information on how to enable lan mode.\n\n\ud83c\udfc5 Achievement Fixes and Improvements\n\nSeveral achievements have had fixes, loophole closures, and multiplayer and assist improvements:\n\n\ud83c\udfaf One Shot Wonder\n\ud83e\udea9 Disc-O Fever\n\u26a1 Storm Railer\n\ud83c\udfa7 Disc Jockey\n\ud83d\udeab Flying Denied\n\ud83c\udfac I've Seen the Credits\n\ud83d\udc41\ufe0f Blink of an Eye \u2014 all mob types now count\n\ud83d\udc9a Staying Alive\n\ud83c\udfb2 Impossible Odds\n\nThe Achievements Panel now also shows the number of uncollected Relics, Areas and Targets remaining in your current mission. No more guessing!\n\n\ud83d\udc1b Notable Fixes\n\n- Cyclone now correctly pays out SuperChips on Campaign 8 (Frozen) \ud83c\udf00\n- Hub NPC barks have been tuned down. Significantly less annoying, significantly more charming \ud83d\ude05\n- Race times now display correctly for late-joining guests \ud83c\udfc1\n- Wind noise while moving has been fixed \ud83c\udf43\n- Quit profile warning? Gone. You no longer need to confirm it every time \u2705\n- Railgun vibration adjusted to stop excessive controller wobble\n- Enforcers navigate better, no longer bumping into each other or shooting into the ground\n- Amorphous Crawlers stay on the ground more and move more naturally\n- Doors can now be triggered by guests, not just the host \ud83d\udeaa\n- Turrets can no longer die while retracting (which was causing doors not to open). Health also bumped up by around 20% \ud83d\udcaa\n- Door trigger syncing fixed\n- Crouching now works correctly when Left Hand is explicitly set in controller options\n- Blazejaw's explosion is now bigger \ud83d\udca5\n- Skulker explosions improved\n- Quirk's hit colliders have been reduced so you can get up close... and yes, Quirk is now pettable \ud83d\udc3e\n- Sitting and standing network sync fixed\n- Map preview fix so all tiles display correctly\n- Collectable in Lurking Shadows has been moved (it was poking out of the wall \ud83d\ude2c)\n- Snowballs now respawn in the Winter Event \u2744\ufe0f\n- 3 new mugs added to the hub \u2615\n- Lobby joining errors are now more detailed to help diagnose issues\n- Multiple map gap fixes\n- Many minor quality of life improvements across the board\n\nThanks for playing. See you on the Isles. \ud83c\udfdd\ufe0f", "created_date": 1772723472, "id": "34225442800404388", "version": "1.7.20", "version_code": 405, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "34225438083738193"}, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34225442800404388"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772720884, "id": "34224858993796102", "version": "1.7.19", "version_code": 404, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "34224853380463330"}, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34225442800404388"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772713441, "id": "34223224947292840", "version": "1.7.18", "version_code": 403, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "34223219283960073"}, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34225442800404388"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772704580, "id": "34221444717470863", "version": "1.7.17", "version_code": 402, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "34221439947471340"}, "asset_files": {"count": 11}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34225442800404388"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772666143, "id": "34214249671523701", "version": "1.7.16", "version_code": 401, "release_status": "RELEASED", "stat
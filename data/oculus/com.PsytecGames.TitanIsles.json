cdn.com&_nc_ss=7f20f&oh=00_Af-s0FDwCkKJ-m1vs0XBo9Nv23bNj37I0UzgxOyVTCNbqw&oe=6A426EE1"}, {"file_name": "S5.png", "id": "594540090098322", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391768_594540096764988_2692738886458572333_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOIy4xmKX_wQ7kNvwESDf9e&_nc_oc=AdpaEgRiA8lid48uIK6IhlXxRBAVqzME7LeXYqHmsoYOVUCdeMX8Uj5pwW5178vab7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bfPoJh-Ed2SjLi9zuJbdyVuUZfhr7uMhKJg1TA2iGog&oe=6A4287D5"}, {"file_name": "S4.png", "id": "563142826702019", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391826_563142830035352_1391789033301939051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_MS1T8lpmgQ7kNvwHnS_ZN&_nc_oc=AdpKqIoIh7cGR5kybExewDkryATL1Q9JkxbCj-dC-NRiAq49swWPfIvBOcq-sO7CZb0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L2RsYZcdjt_EQXWE9Db51Sv7OgRbWrkk4Fg3C5nRqhg&oe=6A427F1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1165371891310867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391812_1165371894644200_4815590377693614845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARzNCDSLB8UQ7kNvwH4pCs0&_nc_oc=Adq4FcObY9NwQI_nukuWXrqIXC5W1Ht5uc2W5wPm6EjAHTfNeNJG-qsPkOrLL4VLYOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wWUxAmt2eh1Sb-wIt35dTxQsh5OiIKYgm4zBbJYGSMA&oe=6A426AE0"}, "display_name": "Titan Isles", "keywords": ["adventure", "coop", "combat", "flying", "shooting"], "long_description": "# **BATTLE TITANS - WITH FRIENDS OR ALONE**\n\nSet on the broken world of Toska, shattered to ruins by the mysterious awakening of giant Titans, you - the player, are cast into an epic struggle for survival and revenge.\n\n# **USE POWERFUL EXO SUITS**\n{1182808979868801}\nBefore launching into each mission, you\u2019ll choose from one of four Exo Suits, each providing it's own unique traversal equipment and weapons.\n\n# **PLAY ALONE OR WITH FRIENDS**\n{658737879847254}\nThe full game can be enjoyed as a single player campaign or you can invite your friends in up-to 4-player co-op.\n\n# **UNCOVER THE SECRETS OF THE TITANS**\n{565889143140523}\nIt's up to you and your team to locate and defeat the Titans, along the way you'll uncover the motivations and secrets behind the existence of the Titans and their destructive attack on the world of Toska.\n\n\n# **TRAVERSE A PLETHORA OF ENVIRONMENTS**\n{1282405879494333}\nAs you progress, you'll discover the many different biomes that together, form the vibrant world of Titan Isles.", "short_description": "Battle swarming robots and colossal machines either alone or with friends across a fractured world of floating islands and breathtaking vistas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "https://www.psytecgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28753331844282205"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1536082827694281"}, {"status": "PUBLISHED", "id": "1293953882762885"}, {"status": "PUBLISHED", "id": "1057717146500816"}, {"status": "PUBLISHED", "id": "1660711631556809"}, {"status": "PUBLISHED", "id": "1189180823153595"}, {"status": "PUBLISHED", "id": "878090164883274"}, {"status": "PUBLISHED", "id": "1223463316252870"}, {"status": "PUBLISHED", "id": "2812487922294703"}, {"status": "PUBLISHED", "id": "1762274367753390"}, {"status": "PUBLISHED", "id": "1098842878847918"}]}, "baseline_offer": {"id": "1057717146500816"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770404400, "status": "PUBLISHED", "id": "1536082827694281"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36613974361551208", "version": "1.14.17"}, "id": "3336161029990352", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36613974361551208"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3336161029990352"}]}, "change_log": "\u2728 What's New\n\n\u2600\ufe0f The new Summer Event will start on July the 1st! \n\ud83d\udd2b 4 Fresh new weapon skins per suit to show off your style.\n\ud83c\udfa8 New crosshair colour customization with a shared palette and an in game colour dial, plus a toggle to switch the lock on target markers on or off.\n\n\u2699\ufe0f Improvements\n\n\ud83d\udc7e Enemies keep firing and tracking you even while being knocked back, and Sentry Stalk and Sentinel knockback behaviour has been reworked for fairer fights.\n\ud83d\uddfa\ufe0f The Sentry Stalk now roams a wider and deeper area, and the Drill Rocket has been improved.\n\ud83d\udee1\ufe0f Fixed the Goliath shield glow and polished several weapon skins.\n\ud83c\udfaf Improved long range aim so the reticle lines up with where your shot actually lands.\n\ud83d\udeec Smoother landing and takeoff portals.\n\ud83d\ude81 The hub dropship now leaves the drop off point faster.\n\ud83d\udccf Improved height calibration so your view sits at the correct eye height even when headset tracking struggles.\n\ud83d\udd0a Boosted NPC dialogue volume so voices come through clearly. [Quest]\n\n\ud83d\udc1b Bug Fixes\n\n\ud83d\udcbe Fixed missing New Game Plus button and hub vendor in the Aftermath area for rare save issues.\n\ud83e\ude91 Fixed co-op seating not syncing and players getting stranded in the dropship during drop off.\n\ud83d\ude81 Fixed the dropship appearing in the hub by mistake, and it now departs correctly at mission end even with the door closed.\n\ud83e\uddf1 Fixed holes appearing in level geometry caused by faces being hidden incorrectly.\n\u2615 Hub shop props such as mugs now react much better to explosions.\n\ud83c\udfa8 Fixed a shader issue that ignored Base Color tint on certain surfaces.\n\ud83e\udd98 Fixed a jump issue where it sometimes does not detect.\n", "created_date": 1782242403, "id": "36613974361551208", "version": "1.14.17", "version_code": 627, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36613926058222705"}, "asset_files": {"count": 9}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36613974361551208"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781870482, "id": "36517127971235848", "version": "1.14.15", "version_code": 625, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36517076551240990"}, "asset_files": {"count": 9}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36613974361551208"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1781617144, "id": "36446421424973170", "version": "1.14.10", "version_code": 620, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36446335488315097"}, "asset_files": {"count": 9}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36613974361551208"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3336161029990352"}]}, "change_log": null, "created_date": 1780608796, "id": "36170474735901175", "version": "1.13.37", "version_code": 610, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36170461309235851"}, "asset_files": {"count": 9}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36613974361551208"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3336161029990352"}]}, "change_log": "\u2728 What's New\n\n\ud83c\udf9a\ufe0f Added a Controller Deadzone dial in the Controller Options panel so you can fine-tune stick sensitivity and eliminate stick drift.\n\n\u2699\ufe0f Improvements\n\n\ud83c\udfaf Aiming is now more accurate, with the reticle using precise targeting so your shots land exactly where you point.\n\ud83c\udfc3 Hunter and Storm move faster, and Blink gains improved mobility.\n\ud83d\udcaa Goliath is now tougher with a health boost to suit its heavy playstyle.\n\u26a1 Prestige now scales your movement speed, rewarding high-level play.\n\u2744\ufe0f Improved snow effects and environmental visuals.\n\n\ud83d\udc1b Bug Fixes\n\n\ud83d\udc79 Bosses and mini-bosses (including Apex, Tentacron, Shellshock, Leviath and Blazejaw) no longer get defeated early before all their shields are destroyed.\n\ud83d\ude81 The extraction dropship no longer lands at the very start of the Tentacron fight.\n\ud83c\udfc6 Your campaign victory is now secured the moment you defeat the boss, so leaving before boarding the dropship no longer loses your progress.\n\ud83d\udd04 Fixed several New Game Plus issues, including accidental early access, progress banking, and saves getting stuck after restarting the campaign.\n\ud83d\udcbe Fixed saves becoming stuck in the hub and other orphaned-save problems.\n\ud83d\udeaa Walking into a closed dropship no longer drops you into a seat by mistake.\n\u2728 Fixed the final dropship teleport so the journey home plays correctly.\n\ud83e\ude83 Goliath-reflected projectiles no longer fly backwards after bouncing.\n\ud83c\udfa8 Blink's disc link no longer turns two colours when you change theme while holding a disc.\n\ud83e\udd1d Suit skills and prestige now correctly apply to your projectiles in multiplayer.\n\ud83d\udc55 Your chosen suit no longer leaks from the multiplayer suit picker into your solo save.\n\ud83d\udcf3 Button click haptics no longer get skipped after switching menu panels.\n\ud83e\uddf1 Fixed positioning of breakable floors and objects, including the soft block on the Apex pickup.\n\ud83d\udcd6 Resolved several story and narrative progression issues.\n\n\ud83d\udd27 Technical\n\n\ud83d\udee0\ufe0f Updated to the latest Unity engine version for improved stability across all platforms.\n\ud83d\udce6 Streamlined asset loading and the build pipeline for better reliability and reduced memory use.", "created_date": 1780521557, "id": "36145210101760972", "version": "1.13.36", "version_code": 609, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "36145192345096081"}, "asset_files": {"count": 9}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
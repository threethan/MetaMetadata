cdn.com&_nc_ss=7a30f&oh=00_Afxfznt5DDcC0DhzBttAT1pj4AnFMMg7JJGHF8GXzz8rCQ&oe=69C53061"}, {"file_name": "S5.png", "id": "594540090098322", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391768_594540096764988_2692738886458572333_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FM_2dwMW04Q7kNvwGlY700&_nc_oc=AdrA2UqZjUyRm9XaoHLmeFqtLdZN4Lnf3oIexcORhhDDyOP7E54d8AU6bBo6Uro_NQA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy05ZaOtIaZTOncX968H1PF6al37xkeuhTVPAHdFJkI8A&oe=69C51115"}, {"file_name": "S4.png", "id": "563142826702019", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391826_563142830035352_1391789033301939051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v28MS3KcwqAQ7kNvwGBrCuW&_nc_oc=Adqz6UWMsBC40dSVLozgSDFdkXvJJKLPhlgoAdbT3SCwxozRJOaW7gR4g0jQSHxvgbw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq_REX4FrCDxmasJJOr2OVyqFltEIDO2W_Npl6op_ttw&oe=69C5409A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1165371891310867", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391812_1165371894644200_4815590377693614845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajIDprduv1MQ7kNvwETW4DZ&_nc_oc=AdrhB74dUXr1ZiDMO8WEmHogj4K5T2EtYnpJmmzucDAzQvtL18mCjcKHQhbRXPU1Q6g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIT0LfqxFEZ-xLH2s65u4H58kZdL261vmuunGS5Y3Fuw&oe=69C52C60"}, "display_name": "Titan Isles", "keywords": ["adventure", "coop", "combat", "flying", "shooting"], "long_description": "# **BATTLE TITANS - WITH FRIENDS OR ALONE**\n\nSet on the broken world of Toska, shattered to ruins by the mysterious awakening of giant Titans, you - the player, are cast into an epic struggle for survival and revenge.\n\n# **USE POWERFUL EXO SUITS**\n{1182808979868801}\nBefore launching into each mission, you\u2019ll choose from one of four Exo Suits, each providing it's own unique traversal equipment and weapons.\n\n# **PLAY ALONE OR WITH FRIENDS**\n{658737879847254}\nThe full game can be enjoyed as a single player campaign or you can invite your friends in up-to 4-player co-op.\n\n# **UNCOVER THE SECRETS OF THE TITANS**\n{565889143140523}\nIt's up to you and your team to locate and defeat the Titans, along the way you'll uncover the motivations and secrets behind the existence of the Titans and their destructive attack on the world of Toska.\n\n\n# **TRAVERSE A PLETHORA OF ENVIRONMENTS**\n{1282405879494333}\nAs you progress, you'll discover the many different biomes that together, form the vibrant world of Titan Isles.", "short_description": "Battle swarming robots and colossal machines either alone or with friends across a fractured world of floating islands and breathtaking vistas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "https://www.psytecgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28753331844282205"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1536082827694281"}, {"status": "PUBLISHED", "id": "1293953882762885"}, {"status": "PUBLISHED", "id": "105771714650
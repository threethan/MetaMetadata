cdn.com&_nc_ss=7a30f&oh=00_Af3T7WoWQu2Hm-B2jbDDDLrMZz2ARhSRpBu-amoZmGBZFQ&oe=69EA1A61"}, {"file_name": "S5.png", "id": "594540090098322", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391768_594540096764988_2692738886458572333_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQrpPfkroOQQ7kNvwGtWFoo&_nc_oc=AdpDuceQhdiwX96_8bVFBTANqb4CgmhWevX0mtz7t2zHd-zCLkFJmW1YZu565yDLy0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AokfHNSwuOvbYm-z14rUuMXAH0hrNC5bY7RMyhM1e-A&oe=69EA3355"}, {"file_name": "S4.png", "id": "563142826702019", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391826_563142830035352_1391789033301939051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR7INN3eAssQ7kNvwFTQTb7&_nc_oc=Adohox9cGRt4ReC-WWpBe8T7hX1ijZd-5ah1B9_e4wlHnm-CG7KumnWCy5WGqUUJh1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dvpkx8Lc4Ki7Pk6qQGpAjXVboa4ryHZTarvdtUvYyMw&oe=69EA2A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape 2560x1440.png", "id": "1165371891310867", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391812_1165371894644200_4815590377693614845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqjJ1fS2R2MQ7kNvwHLOcH9&_nc_oc=Adp_GBcCLj4k3DMtMqrfDE83-IQouRlQ2yFaZ6iXmkFj0SjMkmXOBgk7JoKN0URrwmk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05IgIRITxw5PE36-pHb92AQj-8X1rWjjqdX4_DmK2tfQ&oe=69EA1660"}, "display_name": "Titan Isles", "keywords": ["adventure", "coop", "combat", "flying", "shooting"], "long_description": "# **BATTLE TITANS - WITH FRIENDS OR ALONE**\n\nSet on the broken world of Toska, shattered to ruins by the mysterious awakening of giant Titans, you - the player, are cast into an epic struggle for survival and revenge.\n\n# **USE POWERFUL EXO SUITS**\n{1182808979868801}\nBefore launching into each mission, you\u2019ll choose from one of four Exo Suits, each providing it's own unique traversal equipment and weapons.\n\n# **PLAY ALONE OR WITH FRIENDS**\n{658737879847254}\nThe full game can be enjoyed as a single player campaign or you can invite your friends in up-to 4-player co-op.\n\n# **UNCOVER THE SECRETS OF THE TITANS**\n{565889143140523}\nIt's up to you and your team to locate and defeat the Titans, along the way you'll uncover the motivations and secrets behind the existence of the Titans and their destructive attack on the world of Toska.\n\n\n# **TRAVERSE A PLETHORA OF ENVIRONMENTS**\n{1282405879494333}\nAs you progress, you'll discover the many different biomes that together, form the vibrant world of Titan Isles.", "short_description": "Battle swarming robots and colossal machines either alone or with friends across a fractured world of floating islands and breathtaking vistas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.psytecgames.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Psytec Games Ltd", "support_website_url": "https://www.psytecgames.com/support", "website_url": "https://www.psytecgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "28753331844282205"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1536082827694281"}, {"status": "PUBLISHED", "id": "1293953882762885"}, {"status": "PUBLISHED", "id": "1057717146500816"}, {"status": "PUBLISHED", "id": "1660711631556809"}, {"status": "PUBLISHED", "id": "1189180823153595"}, {"status": "PUBLISHED", "id": "878090164883274"}, {"status": "PUBLISHED", "id": "1223463316252870"}, {"status": "PUBLISHED", "id": "2812487922294703"}, {"status": "PUBLISHED", "id": "1762274367753390"}, {"status": "PUBLISHED", "id": "1098842878847918"}]}, "baseline_offer": {"id": "1057717146500816"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770404400, "status": "PUBLISHED", "id": "1536082827694281"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35033309259617734", "version": "1.10.40"}, "id": "3336161029990352", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8332853930089963", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35033309259617734"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3336161029990352"}]}, "change_log": "\u2728 What's New\n\n\ud83c\udfc6 Aftermath (End Game) can now be opened from the New Game Plus panel.\n\ud83d\udcd6 Brand new About panel with cleaner info, credits and at a glance FPS.\n\n\u2699\ufe0f Improvements\n\n\ud83d\udcaa Each prestige level now grants a new damage multiplier for noticeably stronger runs.\n\ud83e\udd4f Blink's Energy Discs need far less pull to activate, making throws feel more responsive.\n\u270b Grabbable bars and handles now support multi hand grips for better two handed control.\n\ud83d\ude80 Jets across all suits look and feel better with more granular power control.\n\ud83c\udfaf Turret targeting points have been improved for smoother, more satisfying takedowns.\n\ud83e\udd8e Terra Stalkers have been rebalanced for a tougher fight.\n\ud83e\ude9d Hunter's grapple hook has been tuned.\n\ud83d\udef0\ufe0f Blink's Energy Discs now predict enemy movement for better tracking.\n\ud83c\udf93 Training is now only offered once per suit, so you won't be nagged on repeat runs.\n\ud83e\uddd7 Wall jumping has been smoothed out and feels more consistent.\n\ud83c\udf99\ufe0f VOIP now handles disconnects and retries better, preventing you from joining the wrong voice channel.\n\ud83d\udcbe Reduced texture memory usage on Quest 3 for smoother sessions.\n\n\ud83d\udc1b Bug Fixes\n\n\ud83c\udf0d End Game now offers every campaign to replay, not just the opening few.\n\ud83c\udf00 Fixed Cyclone turrets staying hidden after retracting on Cyclone.\n\ud83e\udd4f Blink now correctly drops held Energy Discs on respawn.\n\ud83d\udd07 Fixed disc sound continuing to play after death.\n\ud83c\udfaf Fixed Apex target points for Blink.\n\ud83e\udd4f Fixed Energy Disc flicker between small and large on partial pulls.\n\ud83e\udd4f Fixed Blink's Energy Discs being destroyed when aimed at interactables.\n\ud83d\udee1\ufe0f Fixed shield reflection on Goliath.\n\ud83d\udda4 Fixed a black screen when quitting profiles.\n\ud83d\udd0a Fixed double click sound playing twice on UI buttons.\n\ud83c\udfac Fixed credits rolling too early when exiting Apex.\n\ud83e\udd38 Fixed avatar jittering on the Exo Skeleton.\n\ud83d\udc79 Fixed SentryStalk's last head sometimes becoming invincible.\n\u270d\ufe0f Fixed offset text on Goliath's skill unlock.\n\ud83e\udd4f Minimum pull distance for Blink's energy disc is now local space and much shorter.\n\ud83d\udd75\ufe0f Fixed a hidden secret not triggering correctly.", "created_date": 1776333316, "id": "35033309259617734", "version": "1.10.40", "version_code": 500, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "35033303526284974"}, "asset_files": {"count": 10}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"
id": "2380138809155561", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "944402154801299", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_944402158134632_2636381436900098884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EMc5c3u9eoQ7kNvwGQlCZS&_nc_oc=AdqsKpHCDokbVl3WmUqYLqBH_Q6-wxPk2o61jPLFPEthmADqyoH0avrsSeCRFESadAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af39XqhC0pNKpozgBR1acS6a0REd1QQIo-Mn_WnZyQBLfw&oe=69F09F6E"}, {"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfTE06eiVpcQ7kNvwGj3Sr7&_nc_oc=Adp_IbVSxDdTGiQIh9G25Do6D5mOWdWVbt4YcU1gvoK-kJ-SW58ytpt6QlzobCKrM0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2xSZHC4aRXxFl1say8-ThFsuA0Lpabkh1djIKTKcT8VA&oe=69F09B71"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7PuC10fOUIQ7kNvwF0SJ_t&_nc_oc=AdouC2rhFsdYEqVsZIo_Bg_812AXbT2xsssUvbUHJ12lk-8I-mGnTlazHG04g02nlss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2z3m5Gc1Cw1z-Bkq3MWuqWTifSeWAbFSBLREGwPBa2kw&oe=69F0C2F9"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKuO7Z3DbX0Q7kNvwGBhIHB&_nc_oc=AdqrL9lNJZ4qvK7kQOOB7ecsvAHqIFi7Fg7n_3pncDWRvKcpTido77Ft0JbJB7PVEhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3ASCOa_rKTaEJtb3UX3QLORed-GPl9qWb_sR6wC_tPhQ&oe=69F09F53"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cFY7X07xhsQ7kNvwHa4Rlm&_nc_oc=AdrPEz4csAAIPQpQNjz6fpjliMhUT1pMbUei3pPK_iVUnmVuhmf8MOfpHeo7u4Pq2BI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1T-6sL8VffClzKOzOyk4WAa1xv6m5W0dZUEGgQ5k3T5w&oe=69F09EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flappy_bird_vr_3d_smooth_style_16_9.png.png", "id": "785358011282062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617762_785358014615395_4163713038636993656_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgRvQ8BF3gQQ7kNvwGcfY4P&_nc_oc=AdqCF2Ih7YepfQexxbDFXxMKoTdc7WO3EOSJpKYixQMcmcOSL-OX08jokln_IH2m2lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af13mAQbJMMlT-u4AguLS-bFdW0qI4Da152rJMi2JgXecQ&oe=69F0CFAC"}, "display_name": "Flappy Bird VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy Bird VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy Bird VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "26730914023193262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617831_1278103750865369_7674818175447730589_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C3xLeTFA7wQ7kNvwGcTJi6&_nc_oc=AdrInznedQBmSdfOkAQ42LPIhKIf0ENGii4CY0fxPr6mBby5Oq_CfBxl2f-ZCBIwTSc&_nc_zt=3&_nc_ht=scont
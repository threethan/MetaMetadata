gRDs-ecWg2mKeLxJS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrkhnbbUFU30bpRQ01RKmv4lXFnZ3uhan7MCdKA55zSw&oe=6A95B22C"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR_0y21U0QEQ7kNvwGf3l9E&_nc_oc=AdoKaPVUy6qJD2DWa42ca3U4cRhRCT9GbE1O7Wew4MuIy3ZfsA7eW1R7UqztFgxA4mA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIoO8vADsBx-EqcZ5R_jb1hl-QpaVY-Cr-f_MIPsgd_g&oe=6A95D976"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXVX911SUToQ7kNvwGJrC9C&_nc_oc=AdosNw6ZiSSIPD53NpeEZZcD8qZjsM6laBwTJ3kEodKBZ3aSJB3w3wLG9_Qf-M_d5Vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBwXdjT-npwuCgxOU_mpFlJvkHjVEj17b8lztG6qSNBA&oe=6A95BB32"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb579VI4JCsQ7kNvwG7y-Lw&_nc_oc=AdrYrrG2V9NUuBoxX94uno4Wp_zP5jHJquJiKfdSEKURXm0fgRqZgZFMphGXPH9lOzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY9t-pk78DHINgWu3K3-2UThkQb6wVg9y2TLUfLjlPDg&oe=6A95D737"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "265
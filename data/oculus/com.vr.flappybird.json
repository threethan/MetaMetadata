B&_nc_oc=AdriKJLuDydUOTdxVmwfXAIrW2HRf1u_lH9UwDJ_SJaGc7gECzOFNSGrc0VDQb0mmiY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMTBkIEjw0MUozLw5vYxWqwD0N4Wrq3WNCuIO0s_FcUg&oe=6AA02D6A"}]}, "id": "1799241021434193", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZRfPsCPEEoQ7kNvwEip6C8&_nc_oc=AdoeTVGLkmjDLlOngvRR0Ih-BOcwakaSiXNNqe65pXdx4kSjcdQWylWPaMXRWFuH9UE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzc1kVB0eO0H6D8grGBYWJiy63EhyQ3mSERBS-sR8Viw&oe=6AA02B31"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxXpFQ-ZVfgQ7kNvwGqugsc&_nc_oc=Adr77oIiNNwTAaS04DyR0eKf2oqJLsprZybmvnoCYlI1BfzrCrLGgS47ZxTJw52B78A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxZs0MTNPtQuQ8QRVFz7YOBA4-BCnaVH-bVEYzTlxyAw&oe=6AA01A79"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZWpEilbNo4Q7kNvwGxTjWJ&_nc_oc=AdrM0XVVgSEpQUkjSX7KXJ9-BH1vLHFEB6YynLsSi-DACfmm2Ei-L_4KQNaRUUegrTU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnELOXKSKZKxmKB3qIg8YXF7k8Ck_bkZxxAqp2Tt-vTw&oe=6AA02F13"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kU33IHurEoQ7kNvwEFlklc&_nc_oc=AdpsdvSPbZ4w0pYI-0ZEDKfyWDhDlXr9NRGVZ3yoQ6pnAFkUPOZ85yommxCKa-sTWQ4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdzvovfLJi175-F0Rtnezy9fqqfIpMYUo1--rPt4CY_A&oe=6AA02E86"}, {"file_name": "Flappy VR (2).png", "id": "1728570901689238", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619113_1728570905022571_8419889204353755808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYl-VPAVTh4Q7kNvwEq4ek2&_nc_oc=AdpeX253A7XgYtn7dgqT-1ZAKzrwn-Ql0prUM_-iqYvP_eOGes4KdWLnVx0Pghqwv7E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgv30BEORKQrjuoOmF0ol5ReIrxlC0sUIDxYbNO1SJ8g&oe=6AA00075"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "28402376786046969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622334_1026645020275886_6722412622479013787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ktxyQt8q60Q7kNvwFza4WX&_nc_oc=AdrDJfXry_xsvjAQa91JR6NeLnvWw59zE8VY6mwRgdrTGOs0UHEFGPdQoTcfdHh7_Oo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyucN6Q7vVIJ35rEC5oLwhSYOouTxLWHx8dwEq62i0yw&oe=6AA01E78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
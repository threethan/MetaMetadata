I&_nc_oc=AdoSbowwcRstb-tA-DFe27uUF05NpBK6qfJA3oyNN_79MDSEoWOLh81nz__LehpbNPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4XWEyItf7RssaWIZp20CsYuTVL3cKslm1Xc7GKVnzww&oe=6A98446A"}]}, "id": "1799241021434193", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDBuSpzmLm0Q7kNvwG1Py7_&_nc_oc=Adr0BOWQMqe5tUksb9SbBm7NJBvP41jNXMHW0wJNgs_4D6HBbrMVohJHXRG9WqJPe7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2E3c0vbkNQMdERUQIMKqmwgPIVGdf65S03urRqkVFnw&oe=6A984231"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RvWQPkOwqIQ7kNvwHIGglk&_nc_oc=Ado9Ldq6m61o7o2rtE5TlW73n-98-g3mhvuDswRpB3yKmuviWYnCI2TkWdtbqiRZSHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ6DpLVKMoF5_hBKfsG8a1H86CAf8_G-sUFHI2Sl5e8Q&oe=6A9869B9"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV8pgXhUEFcQ7kNvwHeliJn&_nc_oc=Adp3a58Za3RBWLYFr5Id8yZSisA8xXOuUGGX9ZNqw7dxfKSPEaJA02OqBdwIRUjG1p0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_W1LrVjwLZod3BchJMPTJcSVuxfyENnlcV1-3z80Z7Q&oe=6A984613"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vvrTRRB6_gQ7kNvwGswULB&_nc_oc=AdrN-ThuqsNPVbXI3bvWeuZBalitqj525YVTPt0OY-iVlFMQDsYXhojNraBTOt__qNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDgErnIOBpClMp5E3lwRJ6mzTAAXIp4yXTYGrBH3-q1g&oe=6A984586"}, {"file_name": "Flappy VR (2).png", "id": "1728570901689238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619113_1728570905022571_8419889204353755808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J6VWgviSNEQ7kNvwELaQD5&_nc_oc=AdqyAJu1TqgCcbaEzN6296RkAtrWBc7ZNcBd919OvmcjxY_7_xoI6nR7ZG6Ak8jn3qY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVPCyQYjyA8jAbe_FYdouWYLdme7-AtCltWkAKnhjrmQ&oe=6A984FB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "28402376786046969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1026645020275886_6722412622479013787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdqHDKKMyrkQ7kNvwFXOfA2&_nc_oc=AdraDDIqIUvDsE75uMu6zHqhcTR5ifRbcW2X5SIxWdbUXlddG2FH5BXxFyBDYdTNZVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLDyq8qp08QhB1fRhaz2mnrG8yyuTPgpFl-34CIFXRjQ&oe=6A983578"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
A05E"}, {"file_name": "com.vr.flappybird-20260219-150118.png", "id": "1868698613812462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618444_1868698617145795_1884630849690851075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xX2OB5ZbPtUQ7kNvwFBN3ZF&_nc_oc=Adqd6vBwuGlKVcsKgYKI_AqGQzdIbK1fh0DAKs3_5aQKQQAHEWaAT9BwD5nrRM3iMoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_e7_dnmEnJJw1HHVjJpB-Q0sVxot9iCrVPeeEpbylIg&oe=6A3ABAAC"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHMOB2oY4s4Q7kNvwHZ3fHe&_nc_oc=AdpVmDIXMyA0vq7KZLyWCJsQB-1RyEB0N_gUqRyo2dHKDXyhtFUuKP2SabLsCMcfFuU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0DsGphoWUq4hUJXHLZopBk1irniuJ7cusHg0CsQoNCA&oe=6A3AA9B6"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKzqJkBR54wQ7kNvwHRdnEj&_nc_oc=AdqBKZeFkMW-v6vv5j6zH2ZWYmESoBagizvDmUQ7KiJtnis64JSJwV_P0zfvbxfHf9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MFmqgU6Vaauj1FImOkh95BNQ-VPxL_96IxDoGgiNHbg&oe=6A3A8B72"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejkl8rMaPIkQ7kNvwExH2Ss&_nc_oc=AdqctWhIg7P1ieBmA-1H5WYZ4QZP2Td29vRdGfm2ByGXLoM9IGm2xhuJOvrVscBIEw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9d-EKJVa9D4YC5vXNFWEfyaeQ3Ja8nrjQh3WzPLIIqvg&oe=6A3AA777"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_grap
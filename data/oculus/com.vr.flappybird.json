0a&_nc_ohc=7UnGekdTYuIQ7kNvwEBohxc&_nc_oc=AdqonHokPuY_NIQF0HQZGTp7Wy4FhmV3Fn7_skKnyNywg0pcFgYLSkJqFssySmvvmW8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af06OGt-DXD1sE9xVixm9iMQDTTZ8SO8Lc5A1GWj6ZbMgw&oe=69F0AE6C"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTZbgfp8s-IQ7kNvwH7CCs0&_nc_oc=AdqcQ86auQP35X7t7lYCmvNaY5EpdihwvnI69wnAsVDTCTZb3NsG36OE9YAfiGxmZnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2I1ibYsNKFy92m91SEdsVtuJBELcwkY56FkxgpG1-I7g&oe=69F09D76"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KldWJAjvNJAQ7kNvwHmWzDe&_nc_oc=Ado-uhbNy5-OgN8NPmCbooTf4x28tYsig_y3m6y6qkDrvUOkwL41bvQ9nGcaycNlJG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0672azYOML2NVjW-tmDSPNUl05LP_-sMSqlaAjbm4oFA&oe=69F0B772"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sx2NEvR6tq0Q7kNvwHMvgc8&_nc_oc=AdpakE4T6UDKW7LTtUcslSWcsTB613v5_xUo1glFqQa75HUoX-OQx_SXAeybsneaNOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Q88OTJ3T24gntQRkq8nvjH_-JEs1ycf1K6rdYGi484A&oe=69F09B37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26512609251690408"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2189989035188725"}]}, "baseline_offer": {"id": "2189989035188725"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771547280, "status": "PUBLISHED", "id": "2189989035188725"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26732757593008905", "version": "1.1.3"}, "id": "1182968920521957", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26512609238357076", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26732757593008905"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1182968920521957"}]}, "change_log": null, "created_date": 1773305202, "id": "26732757593008905", "version": "1.1.3", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26512609238357076", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26732757593008905"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1182968920521957"}]}, "change_log": null, "created_date": 1773286341, "id": "26730764026541595", "version": "1.1.2", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26512609238357076", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26732757593008905"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1182968920521957"}]}, "change_log": "- **Multiplayer:** Create/join room by code, lobby with host badge, countdown, same-run play, score submit, result screen, rematch, ping/reconnect, room expiry.\n- **Control:** Wave sensitivity and debounce tuned; velocity peak detection (80 ms); hybrid mode (trigger or wave); haptic intensity by wave strength; in-settings hint for wave/hybrid.\n- **Leaderboard:** Meta OVR Leaderboard API updated", "created_date": 1773130795, "id": "26713728744911790", "version": "1.1.1", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26512609238357076", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26732757593008905"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1182968920521957"}]}, "change_log": "We\u2019ve been listening to your feedback! This update brings massive performance optimizations, a refreshed interface, and the feature you've all been asking for: Global Leaderboards.\n\nWhat\u2019s New:\n\n- Global Leaderboards: The wait is over! Check the new leaderboard to see how you stack up against the best pilots in the world. Claim your spot at the top!\n- Revamped UI: We\u2019ve redesigned the menus for better clarity and comfort. Navigating through settings and restarting your run is now faster and more intuitive than ever.\n- Performance Boost: Optimized rendering and physics engine updates ensure a silky-smooth experience. Say goodbye to micro-stutters and hello to pure, focused flight.\n-Bug Fixes & Improvements\n\nSee you in the skies!", "created_date": 1772593693, "id": "26656001340684531", "version": "1.1.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26512609238357076", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26732757593008905"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1182968920521957"}]}, "change_log": "We\u2019ve been listening to your feedback! This update brings massive performance optimizations, a refreshed interface, and the feature you've all been asking for: Global Leaderboards.\n\nWhat\u2019s New:\n\n- Global Leaderboards: The wait is over! Check the new leaderboard to see how you stack up against the best pilots in the world. Claim your spot at the top!\n- Revamped UI: We\u2019ve redesigned the menus for better clarity and comfort. Navigating through settings and restarting your run is now faster and more intuitive than ever.\n- Performance Boost: Optimized rendering and physics engine updates ensure a silky-smooth experience. Say goodbye to micro-stutters and hello to pure, focused flight.\n-Bug Fixes & Improvements\n\nSee you in the skies!", "created_date": 1772561125, "id": "26652547521029913", "version": "1.0.2", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_sy
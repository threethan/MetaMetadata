9XLaA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGDuTb0YqvA6wKX3Aiyd492E3Q4v7kLhJNE5acxI5k1Q&oe=6A4E66DE"}, {"file_name": "com.vr.flappybird-20260219-150118.png", "id": "1868698613812462", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_1868698617145795_1884630849690851075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BdWaFkMTjsQ7kNvwGK5KTM&_nc_oc=AdoTG9SeXVoJYk4OupmkWzjNELPPljkRLmmkOA4EH14LiQ0bpjt9wJmd2eJDUMHgCjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0s6UtSzAeXvxpki4ZqnCgy9FRAolPVUfqiR8qqtK74g&oe=6A4E48EC"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vv4IcJmfPpYQ7kNvwF95AYz&_nc_oc=AdpDWtTrPBJHHvfKk_-Ri_vfjrUItIsFJXciOBW66-mQQ9kivf67OzHoEH-cS0u0fGA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTWc6OukYcWwFe3KjzZBIP1S8fEUC5sZ3pgjTQnAaHbA&oe=6A4E37F6"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgJYC5aJei4Q7kNvwE-74io&_nc_oc=AdrHj3blIBV3ofEAciLCUYPnOWHjj_QqMmgCY2OBkqYXb1OO7npfJ4KG4HJtvP8aLGo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfN9nxHFUBSWeamBCk-5zOwKTPq9f8aoe9M5HECUKVFw&oe=6A4E51F2"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roYXxzGb61wQ7kNvwExCt6k&_nc_oc=Ado1cS11RZyitpg14RHJyGebKc6GM0LjBXjrxWO7hStJnnJ_hTXIL2e-a7enGRUczIE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa0vctEnBNkeBAV6rk8xN9ko9BafXSd_SlYqAigOw2tA&oe=6A4E6DF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUI
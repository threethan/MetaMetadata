sUscPan3YELiST1tlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzxEW7bCR5NyLmmVDGYFA0M8AtTfKZHqdy9sp_37bz4A&oe=6AE493EC"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xl6FjH2wW0Q7kNvwEHB3Cm&_nc_oc=AdqkuKYkm3gVikSwiG8bt8ElTstXUhGaJCHZN8b6a3CD5sbbEi1BevnMzjUyjJz6mAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8RhlTLE2uzQJNYm6-CrF-PjOgH9zLwVVbJ1kYB36ngQ&oe=6AE4BB36"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEYbplRnjuQQ7kNvwEj9RIJ&_nc_oc=Adr516r4R47nTcdfvRUKfaxidpBOI63U346WxNSRLTujIV10SY8Hl_-kZJkZsx_s-hI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNovvbFX97Ro77aNmDF1xscjTcytyxUoqgqu7b2HdmVFA&oe=6AE49CF2"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXNva2Ky6TEQ7kNvwFhR1XR&_nc_oc=AdpLh56-xA28IYt_9hePfsPs64trQa2BJBhLn5hC2Tak2NZq9kfGac6_GoD3eDYPd-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFon9DJAFqUzI5XAsRBKajqrITXzHk6W8ZtO1LLtwp2w&oe=6AE4B8F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "265
C2DE"}, {"file_name": "com.vr.flappybird-20260219-150118.png", "id": "1868698613812462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1868698617145795_1884630849690851075_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6SJPRqPY-QQ7kNvwFO1Q28&_nc_oc=AdpU7mbZz7wr1z2Ej7ecvJbKZ_e--wK32rFyo3X-ZbSkzAvrejVXFm5zkUYrAWhQE40&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x5XjrXEZtrka2mj2yv1108SRnW40oWfTQeKeWXEePfA&oe=6A2EA4EC"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRIxTe8CLcsQ7kNvwFVTulz&_nc_oc=AdoLKhjOAhBDqxWWBzQLbiSg4vYgrBs0g-XNLq_vprPF9MDG-4dBWEnQQmpnysMFbJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QlZqL3b4jOJG6wVBcifJ-qpijxnlCoq7mugP6mE4DqA&oe=6A2ECC36"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRMdrTUEi0MQ7kNvwGMGXij&_nc_oc=AdoUvbAfT5O6Md-Wfb1Vu_PZv7aDT5zsz2gZRIWT7YKwPVuwjFeVET8eVz9uhq3w0NQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lx5yT0cwqmnr0if-5zZvuY1l9zw8t-uncsxnrpXC44w&oe=6A2EADF2"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ght_z9W1gW0Q7kNvwHxxoT9&_nc_oc=AdpoMic9SXfLpDqBE_XiBoWRAQsvtEzPRCUeKOdBd6G8WPMtNtTorlQq1dhz402_KQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GXp56eN83HYAg_zrHiwqBGg8HLqrH8FPmFEIiYpVOwQ&oe=6A2EC9F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_grap
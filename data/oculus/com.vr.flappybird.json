y&_nc_oc=Adq6KeO9ZnGEfvX0C-XObGLgKKTyFrkbdO9tQNIZOC_PSIcMrhxpAQgAL_GbdbpYgXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfufUCsjxMmdW9J_NUCx9bmsUbPdGWn1Hca1X9d1cugQ&oe=6AA2D06A"}]}, "id": "1799241021434193", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqNVMD5Wf4kQ7kNvwGulGVo&_nc_oc=AdqEnlAT43np2jSQGoaPq4XARA39Tlm3DMvJId764OqW_xFlfGSAO4wnt2TVBd5ig3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLZdmJNSYWokFz2gNHk0d3bBwXrP20pDnihFkFZhqWUw&oe=6AA2CE31"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxXpFQ-ZVfgQ7kNvwH74ZuS&_nc_oc=Ado2BfVI50-7clbpKRXashhRML1APLRZfCcu67iF0pOgMUgJ_NXCwKfn3o7O-Ik-PNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2cFpCZhXeA1_4DZ9aRj5CCwv00WBcSO977QaprcDNqw&oe=6AA2BD79"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZWpEilbNo4Q7kNvwF9IeXb&_nc_oc=Adq6aXZaQt0pfZGsaZBuw49OVg6z1XDgCz86fBOOLmGJ8dJpQKZYUZhM_Zg7hr6PISw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsnYiBAXNIkLzgwk5XYGk-kpGeetXxpthF1B_EgyBESg&oe=6AA2D213"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efC3otdxuWwQ7kNvwHJxRGl&_nc_oc=AdrWFv5eooy5dEi4SXC8sInp7--n6HsxNB1ylqNCAPLqgFT9FfStSq9bJvhRf69_Kj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrp5tjxf5yYs5BkuWEd-v3FcR4Ya3H7qvboliegyICSg&oe=6AA2D186"}, {"file_name": "Flappy VR (2).png", "id": "1728570901689238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619113_1728570905022571_8419889204353755808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjgXqPO7LmYQ7kNvwGRfaGG&_nc_oc=Adq60da6GgNc2KYCdjeDjzLJpUfaJ1qm5xNT_kztYxqs4dqrvY1YyCAfSn0pOPgbf0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiMU23yzdy0Dp66QD76huSPQJ99bVFMTzdO_HJKV2hlw&oe=6AA2A375"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "28402376786046969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1026645020275886_6722412622479013787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFRU_Jh7PvkQ7kNvwF3vLJ3&_nc_oc=AdrC8n-KjgRoAOaulpqzTcu_AtmkYLNQ_T61Ujrkn69SprmmEK7ev8xTtiP4FDt27TU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE26YXNEoimlth197GRG2DA4FncCD9lEU5Od08fATX4w&oe=6AA2C178"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
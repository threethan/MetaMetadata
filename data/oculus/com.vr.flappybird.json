M&_nc_oc=Adpp2aGytLYfEZ6U9hUIu3kjZUzseQM8qkGa6s0LDz0KmOtkhA24sGluI5phO97-gn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5Ie97naj9s9XYZ1nG64D2P0l9_9YIrcPY3sgkcEq26A&oe=6AB696EA"}]}, "id": "1799241021434193", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8VO-SJZ_1oQ7kNvwEYws2j&_nc_oc=AdqmcgPJajurKxHTXpfv9OXXZG-6J8vZZ0eSBMCVjyIdU7i_XY-Y_E8d5jAASvhAWw0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIobCHQvrUe-Njy3q1oebpI08lEkkSUOp_s4RjIfxObHQ&oe=6AB694B1"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbGnX7-A86MQ7kNvwGYYp-W&_nc_oc=AdrBJsFs_dWlXsAmVpqTfc-67MvZKw6ymmX4Hc4fXVD11_p67d0wKY67sI4phN0zMc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUGeK5D0lAUqZeigH4Qm8ead2oJMW9lxLbj6YxycJMYA&oe=6AB683F9"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSHrFWckw5wQ7kNvwGAzOJ9&_nc_oc=Adr-MIr6ppLV5aZHaRzLjAwE4IvV0WO44AS1PBmFl2S0Xxl--VGK7ITZnwlQmmpvSaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKt6K39S7JEY2SshdiJC-c7VYtaVualVStERUKNLKxuFA&oe=6AB69893"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJVtZw5fyYUQ7kNvwEoVWiZ&_nc_oc=AdrhrmiisEAf0zFUXjsQ8urBqVisQTSgGIFP_uZh8Pnu3HRNunDL6dLfpAU38vBVS8o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILCYBHZBAddov5NzMPWr2VUtqXmDcZGqoFqN_enLZk3A&oe=6AB69806"}, {"file_name": "Flappy VR (2).png", "id": "1728570901689238", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_1728570905022571_8419889204353755808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SOhOURd9Z8Q7kNvwEHpWtT&_nc_oc=Adp8EE3P1ewbohbfsqoX-C332QPFNyLTwR7tewv8AsA9TFPWUfBNewadaRTUQEridb0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEe6KOF7hJK4Y-WuIdi7wNhxuNGgvTuEn7Wxenv2JXuQ&oe=6AB669F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "28402376786046969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622334_1026645020275886_6722412622479013787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSWDxZQI9J4Q7kNvwFTplKy&_nc_oc=AdpPv0LfJcUTNe1J93e1Fr1J5sNhxMzEgQOnaciHy1APDV2Nl-bRUcZmN1Y0BUOG74w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRi52BIdBG8pTqCFfQe6Qq8DwzbDOaV1thDoSoQz1IHA&oe=6AB687F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
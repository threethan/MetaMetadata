Mus7MVTun4QjZfLkwQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaWelRsNmI-Y0ajEDDqALCzT7-Q8orYnHFugP6CYEF7w&oe=6A8AEDEC"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86LFH_ZH2s8Q7kNvwF2zowJ&_nc_oc=AdozyeDCUlYBtOaMgr0VzrYBCsa1RU-Ag_taGUl8LIBcIdkzgObYJuedHjbrgs66YvE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ7wfUYDRAA-cxpo4vhI29B7XldL0fdLhIB3yuQs5ufw&oe=6A8ADCF6"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGJkukbA7h4Q7kNvwF6UM8K&_nc_oc=AdpRGlGMGpaFUp74m_zmDU30Q4IUWeEbBxk5ahedjY9iXHa177YmJ_lp1JkK4VRdvk0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQXG09Vc2XWJ02o3uMd1W9EWMlRt_H_a9bSUqGBDSHyg&oe=6A8AF6F2"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1zc_PwSXOoQ7kNvwFPOqnA&_nc_oc=Adodv_HrZ0OqGpca9QzO-WptQ0aph9npgP8x2-_emcJpUNffITljR585Nm7IrqzbNlI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaBRAs33Qkf_4waFzDrrCP9d3tS0nBeKzWkkNOfog7dw&oe=6A8ADAB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "265
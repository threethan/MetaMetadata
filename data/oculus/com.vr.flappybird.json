version": "1.1.1", "version_code": 10, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26512609238357076", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27416393137978677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1182968920521957"}]}, "change_log": "We\u2019ve been listening to your feedback! This update brings massive performance optimizations, a refreshed interface, and the feature you've all been asking for: Global Leaderboards.\n\nWhat\u2019s New:\n\n- Global Leaderboards: The wait is over! Check the new leaderboard to see how you stack up against the best pilots in the world. Claim your spot at the top!\n- Revamped UI: We\u2019ve redesigned the menus for better clarity and comfort. Navigating through settings and restarting your run is now faster and more intuitive than ever.\n- Performance Boost: Optimized rendering and physics engine updates ensure a silky-smooth experience. Say goodbye to micro-stutters and hello to pure, focused flight.\n-Bug Fixes & Improvements\n\nSee you in the skies!", "created_date": 1772593693, "id": "26656001340684531", "version": "1.1.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
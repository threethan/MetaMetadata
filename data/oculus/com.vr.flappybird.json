C&_nc_oc=AdrL1MuEq0KC6pZwfKl8E00deM9HbFU7dn86_kPP6RjST2Cb8F3jDaGLAEoTXRBeYDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxZoM4IfMFvRWs7YCipjr1pMiGI7t80_4KMuS0DIqcaw&oe=6AB2A26A"}]}, "id": "1799241021434193", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TDfzhVwlwIQ7kNvwF2LER1&_nc_oc=Ado10qsVOjJ_S96isnYmVWC7EHejocoK-H6_snNewhh4ARMjLYupTsryj8TcTDV_Noo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcrT5hi0EtW_BbcgZeCx47WT_LuGc2cqVMnamnxwZ-SA&oe=6AB2A031"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq8P9PxbPqcQ7kNvwGfGRCJ&_nc_oc=Adrc-3xoX91MKxhMqM2FkyUGlYcNekY2k4w7tzMRYpH4k-7SPGglBV1cSn7_00gr7dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ4CNaf2CcIXNXf1KMQJCxiNpYupsPuv5W3wN-7takJA&oe=6AB28F79"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCN71hvC_NsQ7kNvwF-d068&_nc_oc=Adp3yXRTd_yiY2RlfGl6WJEFdz0GRGdvfTaK5uXZnIlP0ajGRPosLCTzE75AX3t_vPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqWbMjcTIRTDNB6ZmjkgnH4OxuMOxS-0MCTGp4a-NHtg&oe=6AB2A413"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8J4yFZveNkQ7kNvwEKZI7t&_nc_oc=AdqxAFjdCnP2i_c9px3JcyuJzWlBjdn4hMMr-FLh5jG43kOUCfHLArizxc1ny0dxyeg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsDRuCR8g0eeNLpIkbqBu39ao3PqG2hBaITeGLx-Hhuw&oe=6AB2A386"}, {"file_name": "Flappy VR (2).png", "id": "1728570901689238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_1728570905022571_8419889204353755808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwKF7wprCGUQ7kNvwHfrsbM&_nc_oc=AdoW-U9wbqz1Xzg6qm8u4iD5jjNlSkgIMHAR0CH4wpNKZbrFQQl2zxqFr7jyQ-vZHVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5BJuKdsfwrFvpn6esXCyIIkJ7oO7ICtSuPdYbxRN1Bw&oe=6AB27575"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "28402376786046969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622334_1026645020275886_6722412622479013787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdQ1dNY3MOkQ7kNvwE1A25Z&_nc_oc=AdqBdewK73AExpCcnV2yihhR8gbh_hN1XTC4UhNVL9FXwmMtFIkZchKW35gaAiGJprw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPpnhGSz6Xs7-mE5xh2yzKXY9XLhRUbigUWKzsq_Klgg&oe=6AB29378"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
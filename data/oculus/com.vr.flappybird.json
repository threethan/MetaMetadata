wH6D6vY&_nc_oc=Adop8izV8l4V6eo5BsVfNi7I_Z8L30CN3n0cD9dR8JmRCq9o1JHVdEv7Nsgg-RcoKmE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3x5a8KumqK3aHstsFJOM0WmrLRGGyVkFoxnIXiiK27Q&oe=6A8D802A"}]}, "id": "1799241021434193", "locale": "en_US", "screenshots": [{"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPEWHr_O3ScQ7kNvwGEql5D&_nc_oc=AdpY8F5ab7jqmc31xfl0fcB8WXiN68oZMzqcvHsDS_ZVptaAsbDQ2LCWNUULMGfSUpw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHffiq_lpxTZ3Ac5kcLYw_KVWtVS_y5xzG70aC0YAhJDg&oe=6A8D7DF1"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_mKelJRoeoQ7kNvwESYgJH&_nc_oc=AdrgCC78cQ8TrV5f27hE9MNtIbGjR6AC6sDIhJCpsKgi2H8PMGgvXNNaptbgy6xCnJs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwmszPsK7HwXJ6uSyTpIpZMtB1pxVo2z7gmYpt4ef62A&oe=6A8D6D39"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6Fg29ZBehoQ7kNvwGNDbBg&_nc_oc=AdqnGMpsOH-9bbzvPtcVOKbyGyo_IXVgshZno8CR4SPBBV_v_530692TCrVLm4TzWmw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk2wz_ZtnmVw5WFYT_4ArQotCE5x2tbO7wGF_0bu0vCA&oe=6A8D81D3"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns6vqJO25IEQ7kNvwHfEk6d&_nc_oc=AdoeqYqLyeh3r70StrsAYijDn1U5LyOyn8lXkOFRG7A56SBbaY0zg0jVEBDFqOoW7bs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGQXsq5Ait_tts_2evbx_o7viCBV8Qk6Vlq_IKfmK7lQ&oe=6A8D8146"}, {"file_name": "Flappy VR (2).png", "id": "1728570901689238", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619113_1728570905022571_8419889204353755808_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clwCC8d8tL0Q7kNvwG1R0Se&_nc_oc=Ado_4_H2L7DmWrHQzyx7dLJ8nSBIBDXGt5QPHlFX8ya3-9tkcFI2ZgOivqgp7u246K4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfvMHkmkaO7P-0yBE5O5Uof2Sy3clkde9WuWb0r4ZZLg&oe=6A8D8B75"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "28402376786046969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622334_1026645020275886_6722412622479013787_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ioYfValdsQQ7kNvwFoXLkC&_nc_oc=AdoGxzL37D0gYHdwNvp5BO4YoB4QxHVRAUXCqNsJFh5Y2DUDte94KR5RF683ofy1E_I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErFvNWjiV32nCFCIvHkJusfL8BCJZSi-6Q0KAbFq4SPA&oe=6A8D7138"}, "is_concept": false, "is_test": false, "is_trial_offer_va
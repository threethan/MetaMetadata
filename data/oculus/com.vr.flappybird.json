, "id": "944402154801299", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_944402158134632_2636381436900098884_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=romUNX6bowYQ7kNvwEcDljl&_nc_oc=Adl-oLIqPN1dsZ-TPArjtEq9xmJBj2P1xl-H_zlgKK2iXvs60WnkGYPyWX9uXD3rSoE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyp-HKr_6bSNNw9gGK4d-aAmpnP1YsZxaYu9wGzTf5sVw&oe=69BBE36E"}, {"file_name": "3.png", "id": "3882850368516925", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617729_3882850371850258_4504346475901543590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjSD5HYXlDMQ7kNvwEclKId&_nc_oc=Adktz9RzZjZleFJdO3wH_cjFf9kxLFFtHJMYt4gaACUrFfOJexDgv0ww6lwexVeiKl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxyr-FWbV5HZF25f0qNZDL_3iF5I_A3MNWVqxE2eXw3Q&oe=69BBDF71"}, {"file_name": "1.png", "id": "1840777439936979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_1840777446603645_7643308779420708525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6l3OY2O1Mc0Q7kNvwEeglD0&_nc_oc=AdlR0Z1eoJB-v5zUOZUoRoLLjeN179pS-IPEVaT_hsC9fKrZZ9Ip1bcBaCmwI2CD9sI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzM4dIV4r2fI2qNXWeM56Go1o6I9VL6O6byzu8s98LRYw&oe=69BC06F9"}, {"file_name": "scr3.png.png", "id": "1617858879345375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618069_1617858886012041_6150163056650831999_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCN_u_GtY7sQ7kNvwH9OMdp&_nc_oc=AdnEKyRJR-aPlkN9D8DT0QkHWnN9pzsdomksNYQaI-ee3aywNCUy8dFiFLLjRGaTLqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxyqjkW51PwR1tRD6j73KQsDod2d4bsogGu4m6skl_bw&oe=69BBE353"}, {"file_name": "scr2.png.png", "id": "1437049004784856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1437049011451522_3571452774395295613_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2CqmFtb4xoQ7kNvwEjh2ac&_nc_oc=AdlNrvG2v6cBUVPPrpDzGw_yClOZkQgPW6_TtIT0BnUz2kIe4gcdeafInbkMZZEAbR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw-pfkbnCDPMOL4qYjgT1fLKMKWzvbGFlrOuSfjp4XGAA&oe=69BBE2C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "flappy_bird_vr_3d_smooth_style_16_9.png.png", "id": "785358011282062", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617762_785358014615395_4163713038636993656_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3ZfY54nXU4Q7kNvwFTMbfs&_nc_oc=AdmoXaPJ9YgGhL67xod_evDvrlu_TN3eRSVWZ5suoWQTIpQabPkiTZJWjHeDvDDz-yE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxfh3EbFqom8mT77OqI0No5YpCtYK6kxuB3CcfcIPvK8A&oe=69BBDB6C"}, "display_name": "Flappy Bird VR - MULTIPLAYER IS HERE", "keywords": ["multiplayer", "battles", "flappybird", "fitnessVR", "bird"], "long_description": "Flappy Bird VR: MULTIPLAYER IS HERE\nYOU ARE THE BIRD. NOW, BRING YOUR SQUAD!\n\nThe world\u2019s most addictive challenge is back, and this time, you aren\u2019t flying alone. Flappy VR transforms your room into a high-stakes skyway where your physical movements control your flight. No buttons, no shortcuts\u2014just pure arm-flapping action!\n\nExperience the rush of soaring through giant obstacles in a fully immersive 360-degree environment. Whether you are looking for a quick cardio session or a competitive showdown, the sky is yours to conquer.\n\nKEY FEATURES:\nPHYSICAL WING-FLAPPING: Use your Meta Quest controllers to physically flap your wings. It\u2019s intuitive, immersive, and a great way to break a sweat!\n\nEPIC MULTIPLAYER BATTLES: Don't just fly\u2014race! Engage in intense 1v1, 2v2, 3v3, or 4v4 team battles. Prefer a casual flight? Join a group of up to 5 friends and see who survives the longest.\n\nGLOBAL LEADERBOARDS: Every pipe cleared brings you closer to the top. Track your rank against players worldwide and prove you are the ultimate flyer.\n\nSILKY SMOOTH PERFORMANCE: Optimized for 90/120Hz on Quest 2, 3, and Pro to ensure a comfortable, nausea-free experience even in the heat of battle.\n\nTEAM STRATEGY: Coordinate with your teammates in squad modes to dominate the skies and outlast the opposition.\n\nThe original challenge was hard. Doing it with a squad is legendary.\n\nAre you ready to feel the burn and claim the #1 spot? \nDownload Flappy VR today and take flight!", "short_description": "Flappy Bird VR - MULTIPLAYER IS HERE- Flap your wings, race friends in 4v4 battles, and dominate the Global Leaderboard!"}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/terms-of-use", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/#contact", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "26730914023193262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617831_1278103750865369_7674818175447730589_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=my_9CiGNR9MQ7kNvwGHQldY&_nc_oc=AdlaE9BvgpDZcHAeQa2naaB9fnXkPF4GFk9Is2WmMYCG0Q94NdSTOzwwfqIIMnXqQv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_n
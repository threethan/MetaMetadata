5wDtluRfpb-oBILx6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD59rLANxz_rCEaXZkjSbokFaDef3FlNVAJe_INCxgXw&oe=6AAA91EC"}, {"file_name": "com.vr.flappybird-20260219-150112.png", "id": "813150935125349", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619465_813150938458682_2999594819543753588_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Th9Yps_WCsQ7kNvwHASRTJ&_nc_oc=AdpT_C-A_TXggEPCrccJgTfZKb4ttcBoZm7aCLLPKjddxkIUmux2Aw0kw5-7AEoD7xg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVqddtFZlhTjoQHnpchbAVGMavZL0RadZw0LPZXbtXbA&oe=6AAAB936"}, {"file_name": "com.vr.flappybird-20260219-150138.png", "id": "3976882595935172", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_3976882599268505_3322529131453384391_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyVpgAMIAVUQ7kNvwGr37aG&_nc_oc=AdoNnapnqDlyVzcNeb2NnkpwXSxWVqOZQuw8AP4D3wVsskJgEdlLhtE5izL39xXIwro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYsSgJ7aQ2yBg4ZDk8OJ4DwGva5-6NxukyxBzj9jNa7A&oe=6AAA9AF2"}, {"file_name": "com.vr.flappybird-20260219-150033.png", "id": "2059595051560652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_2059595054893985_6007811827351865393_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUryCvoQd_AQ7kNvwELehMN&_nc_oc=Adq1eiR-I9PMzKv4n_sT9vxZywsSvj6gxt6xHoTPMwPEjxseYcxd2nI2x6QfHjUDmyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv2VHwyj_Pu1z2YsoIqx0Psyr-yLfRbJlc4pY7t9Gp9g&oe=6AAAB6F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Flappy VR", "keywords": ["flappy", "bird", "flappybird"], "long_description": "Flappy VR: The Skyward Trial\nStep inside the wings of the world\u2019s most famous bird!\n\nForget tapping a screen\u2014it\u2019s time to use your own strength to stay airborne. Flappy VR takes the addictive \"one-more-try\" gameplay you love and transforms it into a fully immersive, 360-degree heart-pounding challenge.\n\nEvery pipe is a giant obstacle, and every flap counts. Do you have the wingspan and the nerves to navigate the narrow gaps and claim the high score?\n\nCore Features:\nPhysical Flight Mechanics: Use your VR controllers to physically flap your wings. Feel the rhythm and the burn as you fight gravity in real-time.\n\nImmersive First-Person View: Experience a terrifying sense of scale and height. Those pipes aren't just icons anymore\u2014they are towering obstacles!\n\nVibrant 3D Worlds: Fly through beautifully rendered environments optimized for a smooth, high-comfort experience on Meta Quest.\n\n\nInstant Restart: No menus, no waiting. Just pure, addictive gameplay that keeps you coming back for \"just one more round.\"\n\nThe sky is calling. How far can you fly before the wings give out?", "short_description": "Flap your wings to survive! Experience the ultimate high-stakes flight in VR."}]}, "developer_name": "DiscoveryMe Studio", "developer_privacy_policy_url": "https://discoverystudio.online/privacy-policy", "developer_terms_of_service_url": "https://discoverystudio.online/#contact", "publisher_name": "DiscoveryMe Studio", "support_website_url": "https://discoverystudio.online/terms-of-use", "website_url": "https://discoverystudio.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "265
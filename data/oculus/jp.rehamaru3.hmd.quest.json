ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phYDWnjx4s8Q7kNvwF-cvDU&_nc_oc=AdpEivMtTIgNS_YaivxnVVb67hNGrxLkSsb3dk5P9lNoWJD3qb8FxvH0Bg2hklPnh_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuwnfr3g8tA6Q1eNIOIHR6P1tDffjlhqRpDIMEe79DNQ&oe=6ABA76B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsp2d7rxlV0Q7kNvwG2ZGa-&_nc_oc=Adr9l7u5OzDljaaye98gnVKJEI9gm2uQ3aWWUDMsok1OAz8vhojFx7CxedhEJwwBDgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbIyr0HzcgA5ryoZjZP7rGbhQyhyDIgS4iE0SqEb1k-Q&oe=6ABA85F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqmrMQQdI0UQ7kNvwGcdwo1&_nc_oc=AdpbJWvICLvQtjw3JPoFdC-p8o3F3I_B_mJUXhPzcA-lFJayN9SdsLymjPTChUuKpUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfl4LNWzlxHiusVddEGlz5YJ9DvlyNnrQnGHuREPpT6g&oe=6ABA6CB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2CTu6mb8d0Q7kNvwHxaP3b&_nc_oc=AdpiOTRakdhz-x6ndcVNySoFMxEzKaKX4kX5i8LV61gFYpNRGQq4k9JicUPkjkkCwZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRslCFlKzxf0I8xiCI8f4lccmCJsnJIPBTaL9cfUdSKQ&oe=6ABA8AD2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NSOKsveYU8Q7kNvwFRF63j&_nc_oc=AdqMDl-2xI5qxZ7cZPQEQDdZ9SofF5Sqhj6BXmyLSuYfD3lJQLUWzOQu5xZcPoIwPZo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvtkK-4cuovBTdFqIJcQ-dHGaaujX9WP7FVqARL8KThQ&oe=6ABA5943"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbvCre6g5pcQ7kNvwEBHRYs&_nc_oc=AdprWp5wZe50F4gMRnA5SgvBV2CVJDfvy-Vjyj3CzYbnYgWoxrxhmO97lI8Ven8sIaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ4i2Zxt3_dmJvHboFOQLIAU4qZX9bN5aPGeeg5g4N1Q&oe=6ABA7A2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF5pakTQWngQ7kNvwFYomOd&_nc_oc=AdqH59DMzt10rt8FlNU6Tuaga-mPjDi6Ks8k-CKwQS--hotQ2SP7nmNanYth_bEU_sc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJA4505pxLzyS5RljZuq3z8xLctc-Z8wFOelB3NGX0Yg&oe=6ABA84E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix3D8eXd5xwQ7kNvwHoS97y&_nc_oc=AdpyG1RfO9Kx_p7iPfkojPN7KTE72OhrYlRmcQYChrdWdkyrT5Cmqj-NVJTLGJVbCVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsukaOcfXs9KkbLzbeGcv1VgQj6KpcOwZLCvPkxvCNeg&oe=6ABA89EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
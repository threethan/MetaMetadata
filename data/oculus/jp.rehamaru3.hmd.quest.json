ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyF7-FYpkw4Q7kNvwHtlJ-A&_nc_oc=Adp3ItU5sRDBBX8SjvFUcGmTZyx8Y-GArYSo_fHJOZKX2CMlpJ4X2Muhtlib1nWzuzs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0nvCiiqPvgA8fZOxa7yCAvCJiI9m_bG1by52dSUQrGQ&oe=6A6CAE38"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbsqmfB6YqoQ7kNvwE8Vvp_&_nc_oc=Ado_NxVI5uyKbZ-bMnV2BaC25g8vss41uSj6ecAHjJVtnEz0IO2-w8bmxwXH-HF6hKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHgZG6v5pfQT-SXtw4cV_B7gxNHmbOB-QGVPyvEJODLQ&oe=6A6CBD78"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4XNqw7bMpYQ7kNvwHUwwRg&_nc_oc=AdpU5zPrf7ZRQKhFzcfSP3lEJvoW8dfWZky0amihVii_siz-U5EDXxzFmX9HtachQLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACvJDyVHIU6GWz9uaYaz2qY9QarOce6hCjKLjcr0Urew&oe=6A6CA435"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdrnDbl-7_YQ7kNvwFvdO8f&_nc_oc=Adoneavb8rScPqG4oFxGRvr8twqAe_GZZmvpTP0wyKaMFiB47tXpGZIKfKz_5DaLqs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKswNpEBrdJnjUL_qxFE_BHfpywittNMmgTg0e2MoNYA&oe=6A6CC252"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dTMDhFKNzkQ7kNvwFLnLF-&_nc_oc=Adr2KdLm8oCUTn_Wq7jRDr2_BaXyWJaviNAixN_YXsbnORvF0zQwilQNMlq4hQgOjz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw84VX0_71SyqhCXVF65xviI-QUASkDTsIcXP8d4ubzw&oe=6A6C90C3"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_iUZ7kctT8Q7kNvwFTS_fP&_nc_oc=AdqOlmuN5yBE5VSjgSXbB3Gfrib8Vg91U8QOi92b5mN7_biN0xoYj5SF9KFNkI8wu6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs5IeDYx05xYEAX1rYWSJXr66wPYx9CzdXQkEoKJ3GdQ&oe=6A6CB1AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMcXaoGjH8cQ7kNvwFAwEoo&_nc_oc=AdoWfWthAEy733lI535epDI7zt6Anv83YVAkJUN-pXBYYJy9h7cawHVpXMoiJxEk2XE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrt_OTwv4XCb8nNRcxukd6sExtfa30jHzvhJImiZCAxg&oe=6A6CBC64"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eRxCTKqaSwQ7kNvwH501on&_nc_oc=AdpSrFQtBz_xbcPyozkwfBzxmwovecLXKiNjbx3dKic66jVmrIxBWrrCHmi56LFgVl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjuJj4smo0OvkIT6yTdwyherQLux-JUK4Irm18t1d78w&oe=6A6CC16F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
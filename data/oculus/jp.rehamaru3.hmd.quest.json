ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW3XOtOf7csQ7kNvwEcATuK&_nc_oc=AdrqISNd4i2dbKCRah2hhfPPE_zY0I5xHeGWc2q5fCTuG_qP6w6eHZa-XuhEnBQcZ8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtA-O5Bi8kyup3DyppG7h_-7eW6M8VNhew7R_Ac_hqFQ&oe=6AC65438"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKNhWNhCn7sQ7kNvwFO5Rxn&_nc_oc=Ado9GFbOAGc3jCfF42Mp4ddn931uJOFaanTEbCqLdc-gcynTLfbQarnvz3VyH0Oz0P8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDxh32u0QJt3Qh1k7xgY4P9sFhOMJSQWyqixC6Ijklfw&oe=6AC66378"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pSWBg4Aa7MQ7kNvwHR2FXq&_nc_oc=AdrfHQnECvIa_xyUeyhnG5sAwImdRd3guR1h0yZxCikBwj-rHBVfgf2hJxB8g0AJEdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOR05nvt3NRHk-GlGxgeF9NGWAgQoNkQIp0gqtZD7G7g&oe=6AC64A35"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX5ZsRPl3j4Q7kNvwFhdU2m&_nc_oc=AdqoXZ3if5Oy9qhX6h56lAyWLYtpfV2KU50XVo-RGMn5BOt61pG6T4ObSfcIGaELEXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8b7blRoOn6RnKgC7FWrwuLUpZ4hksgl1zouL4gDiGQg&oe=6AC66852"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yhj-eGcstiwQ7kNvwEOZZ-U&_nc_oc=AdqeDiaRz8tr1skvoOiIu6mddkioxfAIdSe-1QgQksUT6GjGFVzTDBlWaR0IMC2jPhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAL9fYwTFI-yIVQ04HhW8FN76DiLdNyiT3vdZnV1pJ0w&oe=6AC66F03"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs1sTf13BLAQ7kNvwEqq-8V&_nc_oc=AdqWEy-kzUQEuNOWEjd_8G4fidoIrKKvkIF4oxJd8S4LlRkg9nMP1ssrOjjD2FWbuRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNsHOk6qS4sNwo3KYsEzWN7yzc5jOleWplFTm0PasRag&oe=6AC657AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF_ipJX-94oQ7kNvwG6wMPN&_nc_oc=Adrzg-0jKK-YPJj-v0miLttbnaOfbR3AQ2ezeKsckPrzxzKtwXxAM33g9wkXUFzB-tc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNU_-aQ68eSMVObliO43yhX-76am83wz5zhtN4kP9cLiQ&oe=6AC66264"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZkxduzroZsQ7kNvwFVA35x&_nc_oc=AdqvWY3ggrHnPZ3UT7pOA3R7uMi0G51I0UnyTnvqImdsUfcMdHy8uMQUBdICBp1x4xs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZd3eNaC7QYSBmKVxGKp-aZTyhU96ZTCRTdYEsCykV_A&oe=6AC6676F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
.com&_nc_ss=7f20f&oh=00_AQKllfQgEuxhzcOwQA97ukTMhwNQAfdhLVLoqBFaxsyR4A&oe=6A9C2438"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2YrFj1bZHQQ7kNvwGoitPi&_nc_oc=AdpB081QmHbvAtoGpzVq44DEJ1Zk35l6oAkO7y_w2yi7hn_opfo7_3dmnId913uBytg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0HRFXGwmTBEZTx2-X6fMwjq3DnSXPAl97HLMHzH4Cgw&oe=6A9C3378"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrxATRhslN4Q7kNvwG_eSQ4&_nc_oc=AdoRxSLfWDr3I7D_UNVfAHBb5-FHRcXE2APRBlpxlRn2nXWJ7UfmXEr86QvFIUtqfkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaENCnaZ71850_FSuYhXS-rhnoxuyFX1OiB3IrOIM2zg&oe=6A9C1A35"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvlZQ0sMvAwQ7kNvwF4bYvS&_nc_oc=Adpden-ANfzg0p1TwEKKIt9gm2LNT3MI-_VyqBRKSEf2jCnqxQDIsegFCaBfKsw74sE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN4VVgTtM6ty-DZJcxQlXnmb70uDR7wHTW37ohCgSlwg&oe=6A9C3852"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfxcEQpLuWIQ7kNvwHW4LrI&_nc_oc=Ado8YnjqCCEp3Yr-omoPqcXg4nMNGOYA_AZ4watwxkWyiedaMG_qlAitbxTTr_Amgnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA5XV00tiuRZVtBzQ2LWhsPGvhHmspxIUmdwav3FhPeA&oe=6A9C3F03"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOLcTvMacqwQ7kNvwFPBdLh&_nc_oc=AdoN0VrqIFWy-QLXACd99Y1wmVDFD_0NCuvuewaGLKvoMOxSa06tCN57g_6DmCECcls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYSu-afvHI_5koKgLxm6X8gLqc5k_nHi8aQ39pycObNg&oe=6A9C27AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqVfwNjAPZYQ7kNvwFX4VgY&_nc_oc=AdpsJvM6Q-x-8gMA5GQo-KrOOzTJ5-HOt1Yyu3Fl85yyrJENdR2R5YRQUIO0vvmWHbM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3EoSb7mp7zvbTYLRI4mu27y7SJwiYi07ksetsCbZ-Iw&oe=6A9C3264"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7Fd4B4z0toQ7kNvwEieQfL&_nc_oc=Adr9sS8kx9_3uPNDbgbFOv1tzyS-BSuIn97JP3T2T2e4qO8zzhqbtWgfpjqIE-xfYjs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMBL1yKzIs_hgYuSXhH6YPph_vJgZknqzZs3U1giyG8A&oe=6A9C376F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499315353_1252867786673773_1665401367332120204_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7bwwyW6-O4Q7kNvwEperjX&_nc_oc=AdoxjeFYrBGSNX1TnNZ_P0G9bbKCRju9QLiebSGNP9YmInDwU0KVu0pOV4wlDLlTXyc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5A-ndTaUFn3SZYxFslO3H0RLMjQmnzDfcVwW3Y
ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrboDfEFbQQQ7kNvwEUkfsa&_nc_oc=AdpDVhsvPlSctKkOtd4XsXC2Rp8y5JCskJgTqySAavb79GIyFzDofxOSvxfcBI8fxlc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6dBRs7WMBbufTicsWiDRFJZoDX1NR9olIydG0bHhT5w&oe=6A6373B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIIZSCdjqwIQ7kNvwE1MUTt&_nc_oc=AdpIQVeMQ4jwu8WVU_pB-2ZaIMiVMJN6y5hN25n1MOsqAc4df8i-6ZfX7_NSqoHxHmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfUJm8jC6e-4ou9Jt29fMK3O44lU1JLw2R-xmtPa2IrQ&oe=6A6382F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v80qEM5C668Q7kNvwH9NlOH&_nc_oc=AdriSLXl7Cj7QtVSqNViRE23NHTDlOfZbyvvIv3lrbVESEK52zMm_MhPf91mzy7lD_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6E8uWqKnP_FR014NrAqHTa0GM0KTk1P4xBwtlH4thGA&oe=6A6369B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqfmKUDzj-gQ7kNvwED7w2Z&_nc_oc=Adq7GeeWvslYS4WdpMkgBqBDqUaz9tn7GYYwHsgoKklhOlWRjHv3PAITCooXatXLtzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ7_AivI_eG238nRly5cAN-x7wAuWsvR-wAiREbwbAyQ&oe=6A6387D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9naf01kb1kQ7kNvwFFtRhx&_nc_oc=AdqISrsjfyDoMMR3OWrZKjY7OksWUpPSXSGnf5_aC2CYD5MACVpFsIMU0DJqugl89t8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoelFEUhXPHrmSlt0XQIwHkGJ7lAaaHHFiA26i4X0LvQ&oe=6A635643"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15dr4doPjmkQ7kNvwFhRH4u&_nc_oc=AdpkKM6cbOzYIIYAOGFJ7oijMdOPM8wP_4PMWopeFjqpSkpxhh9CJ90iXown5dMF_dE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYgynMgJZDn4OTS7gAWJ08IPKy2c6EaC9MJVO56Pgizw&oe=6A63772A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNr8wzT8J4MQ7kNvwGpskhk&_nc_oc=AdomN87LKjZzeQGUMHOXGb6IVb2fJ6Wj6s5j8s0h2B8QSEn5diBboPvhK04rUdSmia4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClknQb5khxHkseUpN5mINXyhLz_ttli3A20rH2ec6kOQ&oe=6A6381E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ISSAxmvIksQ7kNvwE7wSgT&_nc_oc=AdqNMs0ESBC71ORA8dIUAWn2racrTunymMzj_7ZK_c3fv4GSNlakvRWrwLE-5Z3H8ww&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDm_ZpY12bFCxmL7u4A6ECH_YGtJEHl5Ovvg5vipToPw&oe=6A6386EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
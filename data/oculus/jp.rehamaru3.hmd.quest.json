ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AzykojPWuQQ7kNvwEPtYLf&_nc_oc=AdoL7q0SEjYP8ZBxSnmZq7rx82JKnHTQJ3GEv2w_--9-5g2ZG9tUtNfTTD2QryjjdIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv6A9ImQujFdL3BEB9WrusT9gg6PnXL5OTE-VNzGK0hg&oe=6AD3BB78"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngnuXQ4_T0kQ7kNvwFMsPQZ&_nc_oc=AdrFxAZJBH8yxs_sCHzGYsiT8wBOoCzstdmG9KMab_FL3ukI0TnpgJvz2eSNvZu0aTg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVfH-1oVP6FSyzhzxH4KUgUx5EpchDxRJw0tIn9hneZA&oe=6AD39278"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pO8LYKg-ycQ7kNvwHOTTeJ&_nc_oc=AdoAAX_o0RCuJ01aYurqhTMJH9yY1X-0sahOuJ_NyCwnvwcjbkjzecrKN58misFWSaM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfIi_ElCNLJe1it6rCjtgqNNCUFpJsjfWOB3eRg4aCGg&oe=6AD3B175"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HXiDr1uwy0Q7kNvwF3yU9l&_nc_oc=AdoxfEbQVJFAqT9RUJDV534iZJcYq-9ruSntx3KFEH1e9PcXqRaJQoJ7LBEkbp8GmlM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_uMz-Emuk4N_r0IrW8thydkyuJyS4m4k0lP8X8Ga9UA&oe=6AD39752"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUnOE7q0yAMQ7kNvwEeLkTS&_nc_oc=Adr8DACL2aZQcecyUckS8mZpCqxg4ULL32cdYRxGaqXCuWhi75oHp9irc7QoLxnxsn8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZaLD-JDSSFPazSiDqvyQ3760A7R510c5qATXXmbOlpw&oe=6AD39E03"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2UKb4Jom2gQ7kNvwGOZcEc&_nc_oc=AdocObfN6G1RY5z4RuISiBoSpc2p7il51UFlC0tWTAmB4nxz42_4B-kHWggCHHcIigA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBEnH0imV-OIiUC1HVgzts8eM9NA__bCteiS4ghsJ7uQ&oe=6AD386AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXoCsR2NDdAQ7kNvwFk08JV&_nc_oc=AdpD7g2ENVz7X4xvSjyBm0ZJz6P525pSNoexq-Lz5rUtEyB7jVz3dd6h7MjhDyutmXU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmEuR99_zgtDiND6l2tIOPeStWXoDGKIT4i2SaDuHEMQ&oe=6AD39164"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYCaR-UZ3Z0Q7kNvwG2kdc1&_nc_oc=AdoPiZOPzuUlSpd8KmEYaurDCCJRK2E126CS0Bsqky_py5FX_L9ZXXA0TZagD6sslrw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsFuC5h_KMpJUD5PfoK0TK-8KibMNOCtAChBJqyELMeg&oe=6AD3966F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6TmA8xkBkeHFuWXxgnpAtZLsIDIJnvLrSkeVXTTqf0Q&oe=6B0C7396"}, {"file_name": "screenshot5.png", "id": "2388097988372730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_2388097991706063_1297209197990021774_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1DsE3o25PMQ7kNvwH0w80C&_nc_oc=AdpbXuTAezGhDYXgl1lPIveHSclFblypZEW-wLn8QKXbEIrXcfbJtPD3adEM5D3-L2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRwEVAYdc3bInSGm8T6A2xDsYV392rnrvN7rCJLWQzKUg&oe=6B0C596E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u30ea\u30cf\u307e\u308b", "keywords": ["\u30ea\u30cf\u30de\u30eb", "\u308a\u306f\u307e\u308b", "\u8a8d\u77e5\u6a5f\u80fd", "\u30ea\u30cf\u30d3\u30ea", "\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0"], "long_description": "# \u30ea\u30cf\u307e\u308b\u306b\u3064\u3044\u3066\n\n\u30ea\u30cf\u307e\u308b\u306f\u3001\u533b\u7642\u30fb\u4ecb\u8b77\u65bd\u8a2d\u306e\u5c02\u9580\u8077\u304c\u30ea\u30cf\u30d3\u30ea\u30c6\u30fc\u30b7\u30e7\u30f3\u696d\u52d9\u3067\u6d3b\u7528\u3059\u308b\u305f\u3081\u306eMixed Reality\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3067\u3059\u3002  \nMeta Quest\u306e\u30cf\u30f3\u30c9\u30c8\u30e9\u30c3\u30ad\u30f3\u30b0\u3092\u6d3b\u7528\u3057\u3001\u5f93\u6765\u306e\u7d19\u30d9\u30fc\u30b9\u306e\u8a55\u4fa1\u3084\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3092MR\u7a7a\u9593\u4e0a\u3067\u5b9f\u65bd\u3067\u304d\u307e\u3059\u3002\n\n## \u642d\u8f09\u30a2\u30d7\u30ea\n\n- **\u6570\u5b57\u62b9\u6d88**\uff1a\u6570\u5b57\u3084\u6587\u5b57\u3092\u9806\u756a\u306b\u9078\u629e\u3059\u308b\u6ce8\u610f\u6a5f\u80fd\u30fb\u9042\u884c\u6a5f\u80fd\u306e\u8a55\u4fa1\u8ab2\u984c\u3002MR\u306e\u7279\u5fb4\u3092\u6d3b\u304b\u3057\u3001\u73fe\u5b9f\u7a7a\u9593\u30673\u6b21\u5143\u7684\u306a\u6ce8\u610f\u6a5f\u80fd\u306b\u30a2\u30d7\u30ed\u30fc\u30c1\u3067\u304d\u307e\u3059\u3002\n- **\u9078\u629e\u62b9\u6d88**\uff1a\u9078\u629e\u6027\u6ce8\u610f\u529b\u306e\u8a55\u4fa1\u3092\u884c\u3046\u62b9\u6d88\u8ab2\u984c\u3067\u3059\u3002\n- **\u3082\u3050\u3089\u305f\u305f\u304d**\uff1a\u51fa\u73fe\u3059\u308b\u30bf\u30fc\u30b2\u30c3\u30c8\u3092\u624b\u3067\u53e9\u304f\u53cd\u5fdc\u901f\u5ea6\u30fb\u6ce8\u610f\u529b\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3067\u3059\u3002\n- **\u8ff7\u8def**\uff1a\u7a7a\u9593\u8a8d\u77e5\u529b\u3068\u9042\u884c\u6a5f\u80fd\u3092\u6d3b\u7528\u3057\u3066\u8ff7\u8def\u306e\u30b4\u30fc\u30eb\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\n- **\u30af\u30a4\u30ba**\uff1a\u65e5\u4ed8\u30fb\u66dc\u65e5\u30fb\u6642\u523b\u306b\u95a2\u3059\u308b\u898b\u5f53\u8b58\u306e\u78ba\u8a8d\u3092\u884c\u3044\u307e\u3059\u3002\n- **\u3082\u306e\u63a2\u3057**\uff1a\u6307\u5b9a\u3055\u308c\u305f\u30aa\u30d6\u30b8\u30a7\u30af\u30c8\u3092\u63a2\u7d22\u3059\u308b\u8ab2\u984c\u3067\u3059\u3002\n- **\u82b1\u9053**\uff1a\u6b69\u884c\u3092\u4f34\u3046\u7a7a\u9593\u8a8d\u77e5\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3067\u3059\u3002\n- **\u30bb\u30ec\u30af\u30c8\u30bf\u30c3\u30c1**\uff1a\u30ea\u30ba\u30e0\u306b\u5408\u308f\u305b\u305f\u52d5\u4f5c\u8ab2\u984c\u3067\u3059\u3002\n\n## \u4e3b\u306a\u6a5f\u80fd\n\n- **\u8a55\u4fa1\u30e2\u30fc\u30c9\uff0f\u8a13\u7df4\u30e2\u30fc\u30c9**\u306e\u5207\u308a\u66ff\u3048\u306b\u5bfe\u5fdc\n- \u7a7a\u9593\u8a8d\u77e5\u529b\u30fb\u9042\u884c\u6a5f\u80fd\u30fb\u8a18\u61b6\u529b\u30fb\u6ce8\u610f\u529b\u30fb\u898b\u5f53\u8b58\u30fb\u30ef\u30fc\u30ad\u30f3\u30b0\u30e1\u30e2\u30ea\u7b49\u306e\u8a8d\u77e5\u6a5f\u80fd\u306b\u30a2\u30d7\u30ed\u30fc\u30c1\n- \u5c02\u7528\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u30a2\u30d7\u30ea\u3068\u306e\u9023\u643a\u306b\u3088\u308b\u30ea\u30cf\u30d3\u30ea\u30e1\u30cb\u30e5\u30fc\u7ba1\u7406\u30fb\u5b9f\u65bd\u8a18\u9332\u306e\u7ba1\u7406\n\n## \u3054\u5229\u7528\u306b\u3042\u305f\u3063\u3066\n\n\u672c\u30a2\u30d7\u30ea\u306f\u533b\u7642\u6a5f\u5668\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30ea\u30cf\u30d3\u30ea\u30c6\u30
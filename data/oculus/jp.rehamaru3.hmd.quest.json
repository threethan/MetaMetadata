ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZS1zN0I3kDcQ7kNvwH_J5_N&_nc_oc=AdrbCQVIoQX8tKQy89XrjI9NqwgWuHtkBAueOe1gceC5hJK_QLLk3mZEV5zsBhdRqqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2nOrZjg584U1K66zsiJ3nFfmz_yVADT_lGnBEmEdLUA&oe=6AC25FB8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omYHnYRliMUQ7kNvwH54A_k&_nc_oc=AdrerkoK5e_2_Pqb84IqeVefugUDms83JodOw8Cd2tB4175Qv3DGEpOAs4kqfmIFOq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoSOxv62NsMI80ztWMCA0Td6HgkKonLpMB9aUpytVKWw&oe=6AC26EF8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do_K4fhGXrUQ7kNvwGjDF5i&_nc_oc=AdrUWNl5HF67SkUsdlM0VzjXjvKFkGGQ7Ld6xpwWS9QMW-9-1lrIjFfF-5bnETwtt0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlIjms-m2zxQGbf7XqMW0rR7YL5vBIWPbkVinFxTf_7w&oe=6AC255B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOrG-8bSHMoQ7kNvwG7wbGL&_nc_oc=AdqQHywX9XlaSW6HRN6bPGU9RGTcPfBE_hLpcyGQVfqs19NmLM49NpWx2Yr7pcs7u8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_IkT0dfhZDWNDBGgNS9ddwkiOP2pqpkvmtz78kpyagw&oe=6AC273D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-ZcMoCSxP4Q7kNvwFl4zvz&_nc_oc=AdpxMbpQ5fhMAgE_QpCOizq4vAI8j3nmL5TJJ4-51pYljGE8VthloIkoQD-2oF58_Hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVMYBIws13uwiEESb4Nm01-CK0PbS62OBuFbDacxAihw&oe=6AC27A83"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9bvYapCDfcQ7kNvwH2of1p&_nc_oc=AdrZB83kLNC7WUleYyYDEM5ReNfTaRpLN8DpxuQl8R4C_bKEwW-aMNulycRoQzhdjiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD0sGRbhE79ixiE2KT4BBhp-GXh-t28klLA8rTNB_SIQ&oe=6AC2632A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDVHU7gBt18Q7kNvwGidpEE&_nc_oc=Ado_0vr-oF62Wob8MDUQHRrqSEc7gD6uC-IgLAVQFAVBL2ZUcCVbjBDnsDeKOAgFYSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOev4uf7aiaTHspMKVCyXMT87bR1b2xxmnOlBw4ckyk-Q&oe=6AC26DE4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDk8Pu5zbYAQ7kNvwG0baBH&_nc_oc=AdrEvJg0dZEWJBG4xukTwNh8ZSguabl0TtCpi8Gu_oddQkPU-E2gFJlj0ZC1ND0xGUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4G6s7kmSZ2G5nvPXNbMLDoFTGiS08fLzFq_jh-74DUw&oe=6AC272EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiwMw3tQAp8Q7kNvwEUvIgy&_nc_oc=AdqJnobQiNnpvtvdyjU1ICxMtz1hTPg33lLI64cwhxj_AUNO2Lm7SHkKwJfhCvDTmF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGegIV1IsRKrNWpQbTMAmgmusnIkhkx6DH8yz6wCbjg9A&oe=6A8317B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU6Zw4RQAUMQ7kNvwHMS1dr&_nc_oc=AdoVZJRIGnBy_xcn92exyi1e0ExpoVemCvO_9c0uw9w87lpB7lRI0n5k9sFhvtAIeKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNboqVlGbjiFYdeXYjrvy_pwuLNWUBerzwBrYWT3cQaQ&oe=6A82EEB8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZGYIoK4ErAQ7kNvwGn8NWt&_nc_oc=AdqgmnSS6CCHYdAUw004U3E4qCmiwudtReK0pPqQwJK4cxNnLBRgOHztUV2aIEniNAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyOpQzKKk4Q6kaj9CXHjPWRDcZK6StvaBUY3Dm-dfoHQ&oe=6A830DB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdaJ6Mndx50Q7kNvwGVZhXz&_nc_oc=AdqB6nv1GUjXFmLqoFGaDdwk1UpzQeUOgOwGQj4VMJ__T_4Wiq0tQhmo9LG0z0LlcUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnQOtrE1u2T_svHqEx6hYVysP6u4OMlQSLq3kwCNQxuA&oe=6A82F392"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkqMesXdiIoQ7kNvwEXxTCj&_nc_oc=AdrG6_-yxHCANFqkIanBmTzedNpi3Y8Wg1uor52ZEvPQdbxQI9IFsoXDknD08Ws7ApQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjW_d3CCrJvLlSLFO2C9stSd2dNzUBA8uhiK4IAhpUjg&oe=6A82FA43"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuhSpIIrclUQ7kNvwFT9_Rg&_nc_oc=AdoxShpvX2aW7vKODwKDLur7bG7MUpyiBoTOrYE0QdEthXtVWxz4CHkCtcK3n7sRJkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmyh_baSMWh6MBUqjNBQHxUW0cBZKTgPZCHpXZUX6G-w&oe=6A831B2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1nwaBzmN4cQ7kNvwH818Te&_nc_oc=Adp7P6YFCNzCamboQEJI1TjbMtogUXOmA0prUHvdmuv-99KW9FanKbFkn8QjzdmtKCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhNpYbKUwTOhxDSpf4hPujW5xDumjgKawN4pDmINdVEA&oe=6A82EDA4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwo5oapciDAQ7kNvwF2tR8Z&_nc_oc=AdoruV_uxfls7NCiP4G857TT3kIZv-fa4slw9HZ8TNUf7Zz87CMy_LJ1Y_vbB_S_CKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF17HjeoiR_4FpPXdZiBU6gnL_6NlLX3-4ev91WjcvG6g&oe=6A82F2AF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
ps://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSnDk6L3xyUQ7kNvwHEU260&_nc_oc=AdptsenFKst8OKatbrTy7Fc3NGcE7tC4ifwWBQUIcman4Y7fJ4pq7gD45kahJCSFwgA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbekDKbvRMWbkf-CJ1brzpEmGuxUiNy0xYQDBPm1kWDg&oe=6A68B9B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8Iy1p8-WVMQ7kNvwF8GoRt&_nc_oc=AdoeZoDSEnWbQyxN_UPkkSsL6sTdaJfFrikTmv9v-CKoiwtVMnoTGULbHLACMH-T26o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRkP4_Y58dImbBIDipObgqZs_k3kAF_YWM5ll0iT506w&oe=6A6890B8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8_YssrhtL4Q7kNvwGI2KbA&_nc_oc=AdqmZksoaSIOimXMun_oLJgBjntEyBimPnHVTSNzUymp-ZFxyDgkEqoShXyUp4uGaCQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuvEPOiUxq7LDOkmxkOAC8hxfX9IzYp6zByACDb2_7EQ&oe=6A68AFB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNUgsZNR65sQ7kNvwH8uAmO&_nc_oc=Adpa0MPLUgSmXI2pDL-nrqaI0LF-wFRoNss7Jy0XArjr4taAX3m3d4He-K_AUSbcVME&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAcGNr8f62GDYOg3MQdq3S8siOt6YtaD2ZoiBZPzyhTQ&oe=6A689592"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obmL7-UV6VcQ7kNvwGT07Pn&_nc_oc=Adr98H6-B6FLVwBl76mLeaXeFaPfhMrtkj-RVdgvVKdUCOH7q1tUmVL7Fpf7s1s9V9s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUAi4r5Jl06izoLqQMsl3sHoBQTccWUm84NG3yi-DDrQ&oe=6A689C43"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyN37-qZfEcQ7kNvwGjlvAw&_nc_oc=Adr9_K7LVpXlz_IDCLqQFZRCs-pKilaYtslcrKBp15B7CQHyvoIaMKgu2TfhXnTfnp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBWVSdZRKgWXXHePwMqW9Td1mz6Z2A8fLmKwWHLK_sRg&oe=6A68BD2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukXvy-f5maAQ7kNvwGcuFux&_nc_oc=AdpwBEnG4nMoo6WgVE0Y555-A6HnuQ02_iIH8I1eymLFYo2fdyLoLVE3Wds1dwyHJJ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCU4pfGzYmKMUzi2EL54tm3WQpOsp0kpW2yKdqPbT7_AA&oe=6A688FA4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1LJ-Exep2EQ7kNvwEbZhuK&_nc_oc=AdpFfOiORT_IECejR3pxi_-DaoRzFq6xa63fF3HAo7WEEH5Uducx9SmBZFUPkSCRUCs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM7zH0zdO8eeNQrJgt-gzlTjwBTqpoaYAoO42jSQqCDQ&oe=6A6894AF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
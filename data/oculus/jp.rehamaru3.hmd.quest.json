ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51M7pYXHMtcQ7kNvwFqFQaQ&_nc_oc=AdobVZzHonBQabVuzIZwH0FkKPsLCT5yL1v5icLuLPO3K5AtirR4k6AUu1-wWDUV7vA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_C9gN8AFzH1gf5jXjf0lGspgUaZhcV1epyYZkPBue7A&oe=6AABF638"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj85PqdVAgkQ7kNvwE17aii&_nc_oc=Adr4KMozyp9WYTI-JkICJOSDxHaXJXMl4eMhkHFX2b3Kf8T-3sypUJ4dUTGXE8jISzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrCnYHwnQOqJzLaEMdVIY-mZnbAJ05JB6iCbv9yzKH2g&oe=6AAC0578"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp9gZ9z30rsQ7kNvwGT4JnZ&_nc_oc=AdonGqAI8u9etKVVQXrXc25O5DbaEwuEWRKyPiBcqDcAUSx7atc_phWx7xyELl7XKlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC9RvPKCir4OIJVqFDNKqUMECBMZui_Y2nWVicBgcMuQ&oe=6AABEC35"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJoKGi06qGgQ7kNvwE7gFRj&_nc_oc=Adpbe88txiYpeGHWYziSWBpe_nQyUHNpHVleCA1hWL4bTC-GPrsd-qFOV4D4_b03HRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM4pZKt7_bI1cpDpmcAKgpl0YfZJWs-ozOPt9nwqZ77w&oe=6AAC0A52"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeAoqItRRe0Q7kNvwFMKxu-&_nc_oc=AdqQbxsqGvLR_rpAEENDEHVcfq6EFjUFM7jy-5XBVam45GyVf5sEDMg9RYzaDBkQVLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLchitB6AhyNvET98D9fER95Fi31s_rKQwZroMV5184w&oe=6AAC1103"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oS2H4qy_9MQ7kNvwF2m22W&_nc_oc=AdorrVB7nfkZc25nnk-RJFAgnq4g3lnN_GLod2lctA5ScOM-G90wdwU1sKxnHvN8-jg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeW1YHCV651A0o5Q5y5j-ZQyEccIQAnoAAjwmvoOYT7Q&oe=6AABF9AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GtyVmx3IB0Q7kNvwH3NuQL&_nc_oc=AdoieFghCmLRXN9Q4veJvxkWA0gcucLZ4TcWEuCBmsCtIO7wIu7rWwU-WMc9aBqQqds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDlYOK5Kjn1i7NbW44SqgVnxVNL04FiowZubYH6Go7Uw&oe=6AAC0464"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxnSpCQ_l8kQ7kNvwG_VOX1&_nc_oc=AdrkGe7VifxPWvjRjKFhQiZCF1nW7DVMFJuDV0wYtTkk-_e2t06LjuakbLA_66v5kX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeN5G1Kzayl-N4G0BMMCF8D39TkUuTn5RW-x1b8zhgeA&oe=6AAC096F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
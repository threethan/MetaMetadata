ps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOM9QQhReGAQ7kNvwHMg6Uv&_nc_oc=AdomfFZoW6HbUG_ORNxqH-E9A0BIV78cRhtOVadGgeTX1o-iy7_CGdka10RLJMOQ6lM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq-VbJq9b7XdJWHLeFYG5Enmsj-wf3hxkUBttMQgBoCg&oe=6A71F438"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsvFW7ftK3EQ7kNvwG431fO&_nc_oc=AdqhvYW1sIivdsbxoAROjyZjdpRvHY12rEr1PfLtxvvDfqx0b9btkJRjL36QissRqmQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2DECh3JcuDzMBvZd5Ws7lzBVF7S9cVfjidno3DOeI1A&oe=6A720378"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-JtEv-Rv7oQ7kNvwFaah84&_nc_oc=AdpkTpr7usjQuaum9gP1-PARUkCejQSkzbif4ggQw14aNLpp9N0fovusmevwk75_I0w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFasHNoB-szSDcoLuRxaO_ZLYUamBU-sOY5FjzZT_Je-g&oe=6A71EA35"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAjhSg7YUsEQ7kNvwEBP3fn&_nc_oc=AdoyZSby__LBj_ufu5gnnI2mbFRivaUl6ZDJ6BhbOviUgghQzX6Cr7GydVu38SiOOQA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1pWWrfIJBZmNvaImCU3RcMd73HqivjGmFjzGQmhE0zg&oe=6A71D012"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO5g11RhzvMQ7kNvwGqX5uk&_nc_oc=Adomz1dre7Ue4hBV6ozyQTgHBAAf-uulUYCDvFCwtosoeZjUENJJ8Zrw8Fwi1JHUFJs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqTOXtKM-EM8Ul8RGcqSGKV16qopDRvmZe4b0vekNldg&oe=6A71D6C3"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjiJhKdHd9MQ7kNvwEqzaPG&_nc_oc=AdpGDddg1I_buA2zsl9M20gyHCZX531uObKz5elTHLDLDiJDJwRxQ8URxFm2B_ttuvg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8sPa-Buo4MWBZU37uG3TZmOFB85tfXlPLz8hmzTRnbw&oe=6A71F7AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VatoSHjyUYQ7kNvwE2Ieer&_nc_oc=Adp2BcRHMrToL40nmNk7nmXODshQH7i1X4_b9wUklA0cvzYHOC_74IQdQd4tdenLCss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzd1pbtdZ3xzJUas4S7O0cFDzywlIMev5V4vUNP5JKaw&oe=6A720264"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0wssEEd26YQ7kNvwFvRQtD&_nc_oc=Adpsr1B8JP8Oxi52mvu-h4awj4LwHKVEfkYy37Aq4unuNowrj8WPhSsyoCE9yRYVtSw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjYfT7AJAanpIj1FpT3NlxCO3om8cZG72Yb9G9cG0Y2w&oe=6A71CF2F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
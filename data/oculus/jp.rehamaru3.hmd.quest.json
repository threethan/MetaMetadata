ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkZgrkEJSHUQ7kNvwFGdU_z&_nc_oc=Adr58r83KjbZkKO-6Uxyr4jkba7kzOojkqbWehIh-k46pQrW9Qaj8-ZLX5t7rlpYNv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-quXano-HpUAso9kRTsvJCQ3dypWX91yEWx-3-m0mwg&oe=6AF1D5B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOz3PNHE5qEQ7kNvwGo_ABa&_nc_oc=AdrVUCJfT5S_z7HAuUuaj7US5dzh62bl6UyJjmWQoTVSu_bpoKrn0xK4M58N_xNGHHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHyqan90QaIOBAbpyFmcpIIwYDmZRH0eIXSdeCRT49vA&oe=6AF1E4F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CC04CmJ0mP8Q7kNvwELA_cr&_nc_oc=Adq9FtevMU7kXIL4flBzYcQXwAxdHZRv7r4xnNXLPaCwC8MDJm-H3JZGDliUaOiuGmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqCgmdxbFpheFHDf5WgMW0lmsdFD-RvJnf26xND5DHdg&oe=6AF203F5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_b9DJxWwdl0Q7kNvwGZwh16&_nc_oc=AdoHbtCX7_kh9WubWoogPPnBFrU61RSB6OMiKPhGtESfP6YFx361iOIMv4H5SqvKfXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTt8nlLB_9Q1qU2gNwLnChfdXHiouhPm9CjjZ2-rh8Hw&oe=6AF1E9D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XmumuW1s8QQ7kNvwGC91ei&_nc_oc=Ado-HUehs-3wD6DPOz9tsCYMy15HmpvCPBW0XoC2M5MwRZp-yNStzmxBxyFkMFb6WBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfHDzl_lWIL97UewJTaIMt0YMEZi_7DXCPpl5qTXChNA&oe=6AF1F083"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpPbw0auXL8Q7kNvwEZbqA2&_nc_oc=AdrtRjjTnrJ8NJg1Zm_soAxKY1Lb0ro47B04tCgx_H1KQNBX8XUhvTMVrr_2hMIUKEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOvy3ycZEHbhljcfjsKSOSYr7xun2DL6wZLm35QhcFyw&oe=6AF1D92A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15FgOgkotDIQ7kNvwHIP3Pl&_nc_oc=Adr_HBCBNRxXOdiVPwjPqHbD0zZi_ZXuy7lj3X3Y87n0rpuqImp6PbnqWXqa7DAeqws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBAPeJq9KEP0Py8OXx3a1iaV9PCDo47XZhdWQVoAfjvw&oe=6AF1E3E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuNKB0DPW2MQ7kNvwFxW8pB&_nc_oc=Adpzf5qZd4xKIw5A8-UAMc32DdtXV2I9pOCt-uKymr_aWC0CJ_2WL9Gg4WuygDIKLII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLBTHuKzK1HuvRpJJxVmp4d5Qh7N8Phg4jJsnVhgJqWg&oe=6AF1E8EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
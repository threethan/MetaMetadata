://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_iLrRRoPX8Q7kNvwGmZ3R2&_nc_oc=AdrKaZJOrOpbCWrFgE6EMnUaUFo7E09J8AhDxaQ5XEcVD1mS-6pyRsggEJvBAsnyjL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IFuJCpVNgvhtluHPTIUYZWa_b1gBHoNtlZLM2Phha7A&oe=6A3E89B8"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ErWMB3tVTEQ7kNvwHtOETy&_nc_oc=AdobAFHO442jaBmsj0Ch8DiYtHrhq-B9wFabEcg4tYOVsfrfUS3vXs6gzZ5UkeTpTPU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LsgBhPdwqeM3QoGjc6XI8vDRHIwDQtMzfPS3KzPyEGA&oe=6A3E98F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gX68_UMTjVwQ7kNvwFtzNQ5&_nc_oc=AdoVP2YfCxBbQf4T9KoZPvRdFJd9JvvQQ-E-zJ597UVWAlMsdVbptm4TRLmHjJCFlag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PL9PrFyo-6_C9eZoE5dPJ866zNhjLmEm_e09XstGDMQ&oe=6A3E7FB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9N-IPEvFtAQ7kNvwE5acXz&_nc_oc=Adq63Pz38kBJg7kalTzh9HbrEbie7GhX7SzNJj_B44bduyjdnCbTp11h5qEuFy5rWrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KFgfBDRxwW83OqkZg9UCCDnTVmvVF4iOGslCgUmgNTg&oe=6A3E9DD2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exv0c7p7204Q7kNvwFlYQwH&_nc_oc=Adr7jLdludXpUziV5sucEwLT1l3_KDS3fKCgmbyL-ZRmTmNn02PB_5gAC37d6nSqAy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8v2i6HyZhIA9iBD9NBmmmsi5ySKv5UlUACm0N-ulCG3A&oe=6A3EA483"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wg4LShFZD30Q7kNvwEh3FWW&_nc_oc=AdrByLSxbmtiPu3cf5FiPpD2oYLkenlUX_fAtQ1GP3CWtC4OCkF_eOE2DunenTqiWuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98oorp4ANwFfLjQZUvpWA76biT6-96PFoGkytqelpvqQ&oe=6A3E8D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDJKRfu4SfwQ7kNvwEEPnwb&_nc_oc=AdoWdU1aolAAYkHk7ewxUM2E1KfsD-1v7TolmiDQj1CFYHkcHZmugYOMo25ALDbbTn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uPSmx9wcXRigquVy0pY_80wXgGupmQERekR9vZAs9rw&oe=6A3E97E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vb-MsBhqM0Q7kNvwF9pahc&_nc_oc=AdoT5FuvC_I779ICdXusKCXmdU2-ALLsuePQNtCthnDyMYDFyFYxqTwnyZ1qXzZNnV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UCdfE9UWhKWSQqYKdp0fL0_LN4qALWrACDcTOYtDGCQ&oe=6A3E9CEF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499315353_125286778
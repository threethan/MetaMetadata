ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylcN-uX8hSgQ7kNvwH1jHG-&_nc_oc=AdrW1PUIwYUC6ie2cd_4RCEW0Lr5gftarUp7yp2KysG3bbI5kivmpRUMHdHDme0yp0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK92WpF1_PmxYeB7oQ8XoXMhdECf4oCm3D2OChVUjBP8g&oe=6AA2BBB8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTvbUPFrKvMQ7kNvwF-B89f&_nc_oc=AdrwCE6lG28OCV4c2BKMlDVNce66pYUNJAkisUvVd7AlhnlOX1oAzohq_gpUhh4PML4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItB8jubuVNcBr0Nz1vZ_afsP-0I9Lm37kGb06YMRmPdw&oe=6AA2CAF8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcrXxaFSIdoQ7kNvwFx7uPO&_nc_oc=Ado4FzuHozbXOcyJIM_e1sBZpmI9JKCInMDq0ArU1FymBsG8Ha2OGG2N4ZFc4GjGNb4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW_ww7RNx4eXvmK84qNoLsLYGIZx-hnWECWe57Kzml7w&oe=6AA2B1B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hOKxNaKxlAQ7kNvwGPJhap&_nc_oc=AdpFChDTjEbzizQA8DzxRku42hRuT5Qwx6_2kP2KiKxDheShhw4ShFp5epnuALaiaak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeGLPcpchCDrSrSZtqlCDS03R3vHdaocnON1bzdzJvjg&oe=6AA2CFD2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zM8emizVMQIQ7kNvwH9I8DZ&_nc_oc=AdocvVXZVvmWRLORYOsQo548W2RIHRwJzippmPb9YMeX4_LRvS7wDFKqqC566WIdf3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7inUMrqAOJ1_PWm6vXvaGmq0U9wYRRuQzUSUpsjdH1g&oe=6AA29E43"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zoVgEZO3W0Q7kNvwE_23Bn&_nc_oc=AdohZQibNQIfdvIyq3JLPHdgIoQ8hDH0X8my5197djaWDMDyWH7IcLQDU_PufACUHAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8uXW7SdINdzzLje8_X6yf1R2IZcKPsR-X18m1nEULjw&oe=6AA2BF2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmMpdrfOHhIQ7kNvwFlCC0a&_nc_oc=AdqYKrbFOHzgorUVnMY52gGRwmnFWZCQxK6emsp231VAPouGBPR0VWkTtC3xZCHRlUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWFaGj8ucvbU22avhXPOZ-IJDiqaqX6dNGShl5kwWFjg&oe=6AA2C9E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzlgrA0khpMQ7kNvwEQXusB&_nc_oc=Ado6s3Bm-tUdM9Q4ScJssgN-FAD7mWtrbJpB5RKvD0uIF1sAeUEGOsGHq405Sibwg8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5zpWY8x1xYlvBub0wV7pjPpfa_26p3WyKKoIEWiOtnw&oe=6AA2CEEF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
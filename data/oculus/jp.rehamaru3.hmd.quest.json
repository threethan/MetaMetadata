ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCGmdkHSnWsQ7kNvwGxZqJR&_nc_oc=AdrT-tWMqVvEeC0KWZTnrWHi8he0cRLD5FYhTzfddZc3aDf4A9Kam2NCkbKBtoHIDRE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9AYND0P3-65vsHxfbDQ-M3_3XSmrQCIkpwSt26909TQ&oe=6A8976F8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM3fewNjSmcQ7kNvwEAY_ye&_nc_oc=AdpD6uaWMiwa8zJBnJFK3cf2eNRZZN9kGjJyCVCW3J-114Sp7iGthhbmb35SlhCgW5A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQCTEngrzrmYGdlWOliT75jJLUQzIputxy7EHTcZmTnA&oe=6A898638"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2klZWn-HwWsQ7kNvwFDfb9r&_nc_oc=Adq-5xKplHN_rfUWGRtOFdnMYuFJGqvJZ3S6w2vCDhsVSMAyUcXxJOJtoSpbJ4uaXE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7qtLoKek-Hw5EaImJG6HTfdDBFjt9Lceh9U65a2-wgQ&oe=6A89A535"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycFtIiCqMXEQ7kNvwF-mr4h&_nc_oc=AdqqHrTHrvrJiiBxHRtlOsJXqYRO16Y_sMgwXiO8C9z5TkO1Owq0EO_tz279X5BcuyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbTWB8HjX2xliE-ptlERtAujKKF8LX2PE_Fw1h4oWGpQ&oe=6A898B12"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywHV0Ppz8T8Q7kNvwHDBfmE&_nc_oc=AdpHr_p3s0rPwVZkur1_p1OtcXQXy2V9pzwxxwrQiJfraMt-clAjyX8hqX-w3_On3vI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs8HAuk0eEdZrQakfN9e_KiCBscjiR78CJwnLvg4wlvQ&oe=6A8991C3"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EevXfV1AlgYQ7kNvwE_iJd8&_nc_oc=AdpB3X0sihwCtPc3GV1zeqbr1VoRTPbJ8IG6o3ZpN28FW8faSABsXObaiWtGK2WcyYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwX9Ib-8CDJ4yV1N9MKA1JJz4PIgchKrA96TQtMarGAw&oe=6A897A6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-WBh0uCX0cQ7kNvwHi_-q7&_nc_oc=Ado262KeHlHY8isd-NOg1M668GROVVH85md_ZzrqGm0G7YR38SZSke8Q9n9YbLLlvDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYzdH95-YXpf9HE1tZimqFie60eGTmUvmfQcm8YgbVag&oe=6A898524"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ESd7McFkTYQ7kNvwGOMfKs&_nc_oc=Adpmcd0VRlhZpUzlm29wH0s95F7lZpjZawze-qJi641y09sc3MoapcEZ78e3zyzDdo8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOwK24BxHrIuo2u1_OwOJvQUJC8Hvv6dA_QuJOsKABUA&oe=6A898A2F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
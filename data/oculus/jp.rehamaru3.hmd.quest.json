ps://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr15Vk_ReDwQ7kNvwF3RoTR&_nc_oc=Ado3Tk4xfzln7xjiIWkTtQ5S40hmq9QriObMOV9cnBGnFpL-F4dCy2j31LUc4HHGS7M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oRFwlpaMNorVR3Pbxq8EpRrXQtZ6FWF5wLLBxS_N0iw&oe=6A4672B8"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvBAuEJJxEMQ7kNvwHoVyyD&_nc_oc=Adp5Qw3Hf17KsXDub1vm88uP6phIAA1RB11IpRDbUOZuk7auhpnAvzhjvsr52Ze0qao&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QMKzIX0TZqU9Hmema-hEpGMzjDk5ncAqfl3QZldrbTQ&oe=6A4681F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJsq6XzfkhgQ7kNvwHRGYrA&_nc_oc=Adqd3sx_-884_FQwq826HwJBHs-QW_y1SeFSp46XMxOnFF_akSVhWtpFUBg8A7LYj1o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8epAKuhmSoZkrqcMhBYHllBNDHoBR-_k16uBoiA1Av6Q&oe=6A4668B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9BdefRJiKYQ7kNvwET1sMf&_nc_oc=AdpR-ThD4asjjjvrLEj3V2zG76Nb2Vy8Y3NgGIhdF2-lLVNJyAZR8RNiy_G0jqB6llw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ljt_D51tOtAXExPNBiCS0SDALvK8485voAP6pNVXHHA&oe=6A4686D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTEZNZ2KGMoQ7kNvwF2nKBx&_nc_oc=AdpZt_QKtlvS3Wm2DUGBfvgdxVpfDaf5r8Gu4j-4ozKaokVKsAPyFkhzzg85PpYpWmA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BBdZcVbRYiL5f0fxJtOcBFzSdnGPqDBXP2UaRMC-69Q&oe=6A468D83"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqPwp9och2UQ7kNvwENS-R1&_nc_oc=Adp1JfX6hObKSmeTgwzRxZL0T6Tl9snmSWxpLUUTVwH476jI3_FvLKfjqJYtg5EtZjk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0yX3ng3TD6PCUIwGu3tro7r98msQo7FzbmBOsuxd8Jw&oe=6A46762A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-ZBkMhXxtgQ7kNvwEUY6Fx&_nc_oc=AdoTsh21wk54OTECp7jZ5mujv2qtqNaclI5LCGZBVP3JJTfU36bkow7ReyspeJbHq_A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Xmnbs9B7ry3h2dBrOeqVKuX1fWQpEbOx6dj7o8S24pw&oe=6A4680E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BsjH7yus7EQ7kNvwEZAqh_&_nc_oc=AdoD7KbIqWD9xVDegH6vNfwnwV7ga0ApQ8p5dbGr4iZGXRvzshiwebemEaWHggzV2e0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NSzqjEP9UE3G56TFoAZOipQJffCIWm9r5NsFe6oE1dw&oe=6A4685EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499315353_12
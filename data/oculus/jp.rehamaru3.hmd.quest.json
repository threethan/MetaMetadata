://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_iLrRRoPX8Q7kNvwEYJw94&_nc_oc=AdoaKX65yOns673KXSmX68OgritakpQbpoJrIF9zh12cp_deD7xHXzzusGGMe3kJIqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a6Qmo3bP5D_2MLJg03pGS_uKLMGdCbUqx3xBeW14gag&oe=6A427E38"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RFzeDFY9z8Q7kNvwES6pDS&_nc_oc=AdrLZuTy3N-xxZq5Pjq8bApgA3JX51pJtoz17pNV-bOmVO1pQiOFlu_lsnvyYOkIVag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_54yLAuFGat9XzBmxyek0EVPUZYM_aqDwb_9ivN1waHA&oe=6A428D78"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9j7AlXQ0vgQ7kNvwFniDgr&_nc_oc=AdpotqqC-y8TMy_lyN5YTTUe2F4-vQU6HlRA3DXY-1hGEOzMAB9Z7eqfFg4JZNxyHMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z_lVhLNgbsKPe0ZjAjeEk0GBKYSc4KTJtZLCcR8_8Cw&oe=6A427435"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQxHQ43fg8YQ7kNvwEtLWta&_nc_oc=Adr1TjNYUFABT59Wylug9UnJ-mTvlNfZSrt-85ZvHk_AJ1sMX1NH-dfSOL5hQdWsSzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ay0lz5krtFr8X2SVOq34ob36UrEsytBaJJfaY6p00mw&oe=6A429252"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7WjY2BIaFIQ7kNvwFW4mG6&_nc_oc=AdqexYt4Psqjvqk9TbTj2QtJyX5-OAhjpa5xGTVO5x_5-X8XkPWfGvO0z-0a6Q7g-o8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86cAzzFQasOzY7iV6_WT1SPZOIy-bzCLT-vFCpWCVFRQ&oe=6A429903"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXZ_FWzDQv8Q7kNvwHYetyc&_nc_oc=Adr9p1u8YUgbmtXcv22QZQnGKTXt5scUk4qG7MZZDwlPDjEkSR3JK7C9rExUWGojoCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NomqLAiTyl1zo2DUfMQJf-V-_zHCvwrAGgy2KeXrVUw&oe=6A4281AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VptmHm7xa1EQ7kNvwGH9P2Y&_nc_oc=Ado_fG5xr1pJrFx9XV-rtzuWmullw0QvDrvbKtHptxzfWxWheZiwWJjtY3fQ66gi6MI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tdAtb_0LRiLOa2Cq72VqTq5ivmMT_hRYuhx8_qxVarA&oe=6A428C64"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JniqFXpdYkoQ7kNvwFtG5M4&_nc_oc=AdqlGSLuBIVl_-8jh6mUJqN6XmQv7QHZyeeK9DoPS_e_2ut9R_10KGDNScDdZzW8Ppg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cf7wMhdmKLW6kYrkW20LRZ92kD_QblZQonoyQI7WrZw&oe=6A42916F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_125286778
ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8vrMmfh7ecQ7kNvwF5Qz5h&_nc_oc=AdrpTXbhaidTKS5QmWOJdg5B7y4TnY2NVZO_H_sO7bSFr0qCulriLvRxl1Yrz2L-9YM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdltB7MVMhMPG9ROlurPrYN-c6otMh4Qqva8dYKbLtTA&oe=6A60D0B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIIZSCdjqwIQ7kNvwEKHVm7&_nc_oc=AdrMgdYjAc0XbXOCoXS1rVZhaxXaigASBHS40-LnpiHyHAqMCKiYnf_NDhvSqZt3WCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKPcACwWkuNDEY2w_pF3GzD06dHAaF-Cq0AzAfsnaznw&oe=6A60A7B8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v80qEM5C668Q7kNvwEob_ct&_nc_oc=AdoW7fqfqnx54WmP6EgoNWyvW7cuIJ0-dKo3pUsRkkH7fufcdRF70Sk9q7dzTWgZC7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1f9GqYyvtp5sTLbqY22zGLuFgusk2vUqKCnkDO2Dmqg&oe=6A60C6B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGGXaU8lB3MQ7kNvwH1LELa&_nc_oc=AdokRJ-vMBBZNU14HvZJrBSe_ARkBn2mZIPoz8dhSEWYAbuKEmgOzuiBd9lUspYGThI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGDQaObmuE4407CnZ3RX3O4NvSikEXdmpYpBCuvtIdUw&oe=6A60AC92"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ze32Do3HlL8Q7kNvwGnallL&_nc_oc=AdpJgPkQrXdEq6pbeObSD7X-tJoIzakGzBRGvywXec0-ZViB8ZFcV-W5iBybMc5oQUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAovzCdh_AumZLG4sPbcK0-6qwtkAeIY6tcJTryFbvFXw&oe=6A60B343"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15dr4doPjmkQ7kNvwGYFO3h&_nc_oc=AdrMgiJSfPsqaJNK6_Us-MUx9cEMavn-5kTHhA3_yp2XtJrXp02WwXOytVtRQM3At0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgEsaog8DTT-hpEn53GpLd8nh6fRVzu9VfMtJHalFCbQ&oe=6A60D42A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnbnwTG5V8MQ7kNvwFHaK4x&_nc_oc=AdpwzCO1zjXO5TFVCCjl7mi-DtUVItlmtIqWULB5vd3223x6fuVAJS5NmLzFi0wfbFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKyTZSHZ4N7BfO5MT6PUQVWJHT4_RkLP5lniFmxjuKfQ&oe=6A60A6A4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpXNl-GV1KEQ7kNvwG97laU&_nc_oc=AdoQOn1e-ZYQL8DrleYpv1HoG3oVStYNyvIC8klML6mYJLSJNftFFUej5_4F_pqHoqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM7D_fjubfQpEsWOL14DuvnNxdvjOPrFdI8sno-2y0aA&oe=6A60ABAF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
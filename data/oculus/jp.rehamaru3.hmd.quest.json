ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyC4BumxauYQ7kNvwE7B2_s&_nc_oc=AdpAuxlmdeHIza_kGi-JxeMIPA2qKJebn7hl0I4W8AQY0nuuy1hgbHFlhfrYPK3fTyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkO04GDoGXMyjA8qBryl44E4ONyPx9oKq3OElmVHcJzg&oe=6ABE6B38"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C23gu9tzDsQ7kNvwF5ROlL&_nc_oc=AdrOnkNVkKazzH_TnJD2ObH2kKY8aN-_L076NeYW6PWOer8HQhX2VyycE-MPMIKA5Zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_PPZJ8WNKKD16BT29RVQ3PlGFPUK5a6RPWPqKLdCNsQ&oe=6ABE7A78"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlSSMVsHai4Q7kNvwGxldVm&_nc_oc=AdqKcvXtJGLynApY5r6TgE9yq6h3MtaaNRibUS1SZEfNay1LC2UWZr5aAZj8PN5qCik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSp2pLRGiu6OZ2trXu54C2NEltGxjq9aTc3VhuY6094w&oe=6ABE6135"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzhEwjjRGNEQ7kNvwGRt1g4&_nc_oc=Adqq-TV5Mf5sLEUgkEUwJZyMsHwHLIpyj5kivUqicxqSPdllYtX11NCzNdFTVc8i8pI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgsNLjUhZVfILz9FAzungpo26fDzla1wSsdaVFAIHBuQ&oe=6ABE7F52"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crqp5x7FMWkQ7kNvwFDc7YP&_nc_oc=Adr8n8YbcPfOxECH5MKpFo7IhMOT8ZfMnTqVAPxfeN0kAC20YevqJWxKD0QjWrScgjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdXU2cChRoVIT9BOV0JX-zPr4UIxjKimVFCGBxE3kFWA&oe=6ABE8603"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZdooLwFHGEQ7kNvwG6Pb_g&_nc_oc=AdpQU563I_QCGvDcRG1Spy7W8AJ8UnYpJYNJmipQnKH7Sz8MyPg9AdGJedMBACxq4Bk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQuU6ESvFWv6DdVlQtehBwbX2ABhgkT48PavAkjOty0g&oe=6ABE6EAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKkGkiW5newQ7kNvwHKrZOE&_nc_oc=AdqjwQXMZu6turNaBUWpB0KWWvCV7uDjuk_0MlZ23bhvk9bt7UcCDWMbe5qEBbFx7sQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1qiOttHlDUIlk1oKFmkzaDRwGrEaWODKI2wsnd_yecA&oe=6ABE7964"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Tj8d5TwZg8Q7kNvwFUSBGI&_nc_oc=AdqjG-cp9qvpk5GdLrqJY2H_-GLtfrMqLgND40ofPKfU-df45i55SRAlYHF7VlcoJg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8QW9ygyWkSZGKTmg1M6u8ltEmfw1IEQNo43JL6tyRGg&oe=6ABE7E6F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
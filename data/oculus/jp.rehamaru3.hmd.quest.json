ps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQzoyXeyFYsQ7kNvwEQ7NYn&_nc_oc=Adol_uTkykIIsqNZLG2zD7rxLEOkLB4SMi5FFotNvWtYcQhiYLws7Fu9RaVUlQphgE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_sE6GSjuw_xhKPMaa-SCpm3orhiOW90q_RCl-wHIx6A&oe=6A9AD2B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPTQ5TgwUHIQ7kNvwGtCjbr&_nc_oc=AdroIqyU1M7a_yM94CdpHHSTdmS0waUeNc1uTcXPao1nbdMcB0DJaNjI20Lh5iJkfVs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtaOJH4noG5-44vI4LbW9tevw-sgmvfKDBSTBv1psGWg&oe=6A9AE1F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrxATRhslN4Q7kNvwFtSuen&_nc_oc=AdqUsQrXfOIbj_EmCPu2VzFS00a-COE8j6XynpNXDU-fy6erkDMG-6wqYWrVz-_EF7Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPtjUQP3XUbE1lvgUpUU6hhPRF-iJvFGTzpPlQcafYIw&oe=6A9AC8B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvlZQ0sMvAwQ7kNvwHWcpv1&_nc_oc=AdofftLxxvYRd7Hf_twXKS5ny3tH9nxLM-rtv1JsEbdx1IRqDdHtQMFI9EL2Lwlogno&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEoAc9PoTaHEjQql041k_umdUySyYXWAIL8cU84la6vA&oe=6A9AE6D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfxcEQpLuWIQ7kNvwHUvgd0&_nc_oc=Adpv3zOegMaqMIEiBqTfGjOqWM7Tn8mSMxQgVlltAkX6hSQbf4xkt5Ud86eU0-rsqGs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGOMKhVxP4EcSXMc7miEWykfmr2UY_BwoQbjr_Q8T_Mw&oe=6A9AED83"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUg2XBkfm0YQ7kNvwEfV5v7&_nc_oc=Adqz1DxubAalGsd5MmdDwR-qBTHNyFhz-g_XBqZ_-5Zp1g5eVD1M2JnycAsl5ut3WCA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu8C-oZyrj9HOGfwWm37SUD79M2nsE3qGPUmBPrGdyhA&oe=6A9AD62A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqVfwNjAPZYQ7kNvwEKzWKk&_nc_oc=Adp6Bfd6VhbdNSul3pFFZVmbK9A_bPpXfzmU9M6TLiH_rcjCO2L9VP5THFeTNWQQbns&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHR295C_ydDbmNmcDDVbwMhW0eyn_CvJyhYmjVOCZkrg&oe=6A9AE0E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7Fd4B4z0toQ7kNvwEZdFXK&_nc_oc=Adq8bjF2cVptBHKGX3FqMQqW8ja5g0r1F6U9HweqmxwEB9zLJJ10JfKo3BvAVLGIXFc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSpFpBolcTlnFHyNZTMDpvfDHZVRfyzqwmg7_Avp1qeA&oe=6A9AE5EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
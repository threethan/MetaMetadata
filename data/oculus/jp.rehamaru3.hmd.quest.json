ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W09uElI_LI8Q7kNvwHZp0Ev&_nc_oc=AdpbiOLKrxyPibzx4bOyCNerRpX7a0-8D1cEolKuvOi0ludrNgL7YwdbtTh05Y6R73w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV-y7LlCStnwNQrT95tL4stgy36XDRDOt6vloC9Y6ifw&oe=6A79DD38"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLZ8UL63-xkQ7kNvwHopBwJ&_nc_oc=AdoKFUifUYp2s6fJgvcDuGvDktYsIm2cUvj6lio84f1dFjSD_1KBuInmSuZ19yAL3pY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGiwPpOtglMYM0MUf9H46KNy-ggYH3DR9lRvUTowN31A&oe=6A79B438"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MU4Uvp4YyMQ7kNvwH8zSHK&_nc_oc=Adoe0a-ScHLqqynoWQtE2LiOsoNkW1YV3eQjMW0AzQ4xSHsldSrSVepIuiu3P_caNCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbvtxWwMC31jbZiVpMau6zzQaW1DHHtCJRlD01TWg8QQ&oe=6A79D335"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsoTSkc1GtkQ7kNvwGRlUUY&_nc_oc=Adoa7wbmJDOXzJgEr-JI_M9joO9fEWoildwJ2ZReGRHB_ac5rQKoNmrZx3ktzVejClU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4qaGVy0ue36m2Q8c-F99FtEaR_kNNLp4Xf_hWS766aA&oe=6A79B912"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzgTOfmGScQQ7kNvwH2TjcS&_nc_oc=AdobjVt_ruX2cneD1JOzDT3NoXws7KtEqJwWXcDPo5bNxZqNZWMENmJoz4CEDAeg5tU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElX-KFo540Sr1tzCSU-92mXqawsCxUSnws3LXUn93iIA&oe=6A79BFC3"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n3GewoZEFEQ7kNvwFvkBv_&_nc_oc=AdrGrvA4iUyfHs7yRD4BlfhwLyMWOAWLsK1o_VGHu6XxPfetXjSYLiDTZms0sAyugNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyCOU9zyXwYqwTdRkPKDzjp9zWIHsItbz7vSoI6nx7rQ&oe=6A79E0AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCZCbhFXsC0Q7kNvwEoGyu8&_nc_oc=Adqg8v953nOPTNwJmWDC-J6b4Fq5Tmwr8jJtqYo59lezQ8kOtYfLamuGhAMiyYO3YDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETdYON8wrPqpEXNeYyNrCD1foBhdDA6GMernnrFfIWJA&oe=6A79B324"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W_aN4vaux4Q7kNvwGmeFe8&_nc_oc=AdopTiu8X-9pOXhV4DgW-yHkAaTsgJ7LLSOx-oBPf8GGWtX5zrhYy4TE2zYRolEGOBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHd7b9r8thtfpqPSIMgtXtsqezV9IKwyHPhjqfPJdVsFg&oe=6A79B82F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
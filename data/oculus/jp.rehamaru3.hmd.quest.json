ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyC4BumxauYQ7kNvwEFGRN2&_nc_oc=Adoknrk3mOlleff7c1oAVasJtcPJh6i_DsgdxmJDS73sCI5_VvbuV7hYfHfLjs82RUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1y-4LUwin8ACX0lETtHaHZQd248G67TyT3muAc-i-Dg&oe=6ABD19B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5C23gu9tzDsQ7kNvwGCsmgH&_nc_oc=AdoQRGJJOMK-5OhXYmPxTmq1Dd75sgue-KD8ojlYNdBEAL90ctoWkmUeWEEf9Ep6tWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqgyaCAXAPThbDqRDDeFSdL8NsG15v_vBNRdHDejvSkQ&oe=6ABD28F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EipbnRZhmpsQ7kNvwE95Gb7&_nc_oc=AdoR4TjxOJxH1PZ2IkEKT9CkOz0UEgdC0yqNmxx8CV8XYAiG9X8f-QGi4Xj_3QcqysM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkBWJkrlI1ePoQO63uzZ4nB0INutsWBJQW1kwGCTpkdw&oe=6ABD0FB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzhEwjjRGNEQ7kNvwGxRjM0&_nc_oc=AdpKJo0KUmt-PVXaRCtvilxhsOp5jveG_L71SU0KlbSmnZ-OB8yH02IgE2uQAabmN9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuFj0pZl6XOZpacaF16PMvg5X3__cO8sRWhCAgGAe5qw&oe=6ABD2DD2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NSOKsveYU8Q7kNvwGFb5ju&_nc_oc=Adp8o_cOvPVAYeuM4r_Sc14Ww6wTfVmwCQyCNCCjbeGILjln53_gAyy89bbsyE88Djo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaD625kZryu2blbD8fwUDLB72yBQ8cwY54_JoPep5mwg&oe=6ABD3483"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZdooLwFHGEQ7kNvwGzp0Ff&_nc_oc=AdrEwQrAExlAfpNAOvnX8tZCz2q7i18syRrhaRrP-_g81Zkqd4Gq4uer99q0yj28MCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUNL_qalwybuEzG7o7HfyqWgH6XfSSta6GUpDxfFl8AQ&oe=6ABD1D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF5pakTQWngQ7kNvwEhLbkX&_nc_oc=AdoAW5vRk-1v_jZgIFWw06ZP2qRX7GXZAGY8RV9kybG5Z7GpIru3qUtWLnJJR-UDBkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxJjDPe8K0PAt2SE46P6apNlBeVZmJosTXsgc256X5eA&oe=6ABD27E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix3D8eXd5xwQ7kNvwF0F4mX&_nc_oc=AdqGJxrLJTB_BrDpIUE_b64PkokagiwlmgdbggjSraFxnTYuYw_AZLgxuUZjNsS8Lhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyPsuJiLcfb_URUapMUAT3Z8_D5f6uuRYVvaeB-HIkjA&oe=6ABD2CEF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
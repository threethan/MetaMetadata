ps://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRHgksyZhQ8Q7kNvwE30xwp&_nc_oc=AdohKOxTe60KBY0bzGoZqKIuXGDLmTyasTJ0oyjfWvQST8uV9uWqQul-ZxZdNpvbzNM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BFE1oqwPVN1EmXmV8jKY5RvzEim54QCw53ZrHvUtktQ&oe=6A3943B8"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqVFt4wPZl8Q7kNvwHHLtCk&_nc_oc=Ado3di7OWz_aN_S80IjPtNEIvSfjX7T_XZOwrkbJoV7Cp-3OyNXjFtaPzzOk24SCYWU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VxX8J6h7dewDXYg3PI0ZgmwxX5q2U-2j4QjLbdLUqEg&oe=6A3952F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV7fvmnRJWAQ7kNvwH5UyPT&_nc_oc=AdofyvV1AqQYVJlmuHMbFUlhfaPq6usyuGGsuTs_S0OVUtCHZKTW-U41ZjcM4vg4JQI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g5Il1mVmMV2H-9XZwJ7LbhUO2QbOwQDYKYs58UfMHlA&oe=6A3939B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdFg-wc-TGcQ7kNvwG2iQ6t&_nc_oc=AdrUfnGZ1PZ1jFoWkNB_6H8EY-gbx-XXjZx1PIBVIBPECiC01_EnQigm6-2L069kpmk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cu7KjIGHzgkUbh16GeGwm7odkw4kzn86-V20KRTknoA&oe=6A3957D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a08PodL6JkkQ7kNvwGqUbBv&_nc_oc=AdpAVSvoXrCnrlhfqtpg6v2TiwAriXEAf-GeltewZRx3UIFxz2gtlgW2EvG-yX2GAbU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h0lm08hv_h_NG8EbBPiHMDm4tYCnXdx01iJCZXZe6gw&oe=6A395E83"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uyc6w0NK8UsQ7kNvwH4e2wK&_nc_oc=AdrJg6i1ulqGF-cP3C-tT70Nwt8l1Jp0fWcw_kddNoGqzStKGQiVfrK9ywrDH-MssfI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S_OQspFzZJYWD5ttnZauxyu6wTcaDI92kc4ZzlDMqXA&oe=6A39472A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jkq-XxBNwYQ7kNvwFvZ2Jg&_nc_oc=AdosJj5dHNM4xejfAlT_9Z0ybzVrCs0VsXX9VDP8HZl9zMOtokd8fS0Nx3OC_ocAh6M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wD0sbO8V-AnEq9ickmr7VdYl_-WGJ5NyuzF4ABjnMpg&oe=6A3951E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruge-VFesQMQ7kNvwF-M_Nl&_nc_oc=AdpFkFUvs4Rehs28arn1VzS9NakSdQM3zU_1WF_FQUoT4-CKSzdLNA661g96dzMI2LQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tp1Iy-y2jUrhOfJeJGOgzhkzgMB6JOtnN1lppp71RVg&oe=6A3956EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499315353_12
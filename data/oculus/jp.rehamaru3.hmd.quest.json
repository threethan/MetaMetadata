.com&_nc_ss=7f20f&oh=00_AQAam9FHVidlewYTxwXPUKTctLnyQeNfGVVA7MUxKz_EUg&oe=6A6616B8"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTJESeE5hVMQ7kNvwEHnvoa&_nc_oc=AdrbsJwK73l1j8JedHxCNNDEvD4VE9j9yPefs01rT57h-YYRp3ptforzXCzdBW4ZX7Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmQrK1F6Id9WW3br5_8ln3UCbCMd7vJaSMKADFx2LFdg&oe=6A65EDB8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xZU-lrsh5gQ7kNvwEeFRyN&_nc_oc=AdqYMnoXxMCyxHxnXaM-zphnf_rzzruy-MiIm-KMOlzLJlqC-ifYMT7Bjh6G-OFZDSE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdN9ygbeXXVjnbH8nqGqFtDR8YqZyb1wDK_xrsSd9FtQ&oe=6A660CB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNUgsZNR65sQ7kNvwEIh4hc&_nc_oc=AdoJj5sCep2mf5jiGQBjn_FIzYaI98_R-wA22cL2aMM9LVlSAcW5ekx5qo9WaDf4dDQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlqt3HmkSkpCk7nkWW-YWlOy4pvb1KbAQ0QX9juhEnXA&oe=6A65F292"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9naf01kb1kQ7kNvwHMFJuM&_nc_oc=AdpO0cdc3XaaF-3BTBmqX1S3L_FBEDgjK-M1Mg4BbBiqtMdS3k725XteD7KcrwljQOU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBitzusIT4Y2sPHB2i-nOqUwOWEIPzGoUK_v5vHUxEStg&oe=6A65F943"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFT8VBx-cl4Q7kNvwEmG1Cm&_nc_oc=AdqlcnptPLPVq5MscWabCLvXw2ak8vl1IlqovJX_gIYOYggDYw5DGU1bYVVl_qnYqXk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl5xEJObBkEBqr0N-9uR3R_zcbT9JUQgFJ8JiM_rHNnQ&oe=6A661A2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNr8wzT8J4MQ7kNvwF3ab7a&_nc_oc=AdozcLnGJirrdVCZaSZYwwAdJRRRfv9sczDHEp420jYqLZnj-Fhcn1xtvUIN-Oog3IM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt0qXqWMRrQiRpxeLYPaYKekBwIIeVt0orf6Iba6jPRg&oe=6A65ECA4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ISSAxmvIksQ7kNvwHP-RQe&_nc_oc=AdpQn0P4RaYzDSLxNrDTmSaBBseFDYQarmIpTLZJvjQLIbt3FuxijXmhgA4VLSS71yM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSPxbq196chR-B9xpZgnj2NCC2JyDVN7rW3jyl1c0iIg&oe=6A65F1AF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499315353_1252867786673773_1665401367332120204_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is5tJxMfhwoQ7kNvwFp0_A5&_nc_oc=Adr72lhzeM--bAukwQF74hU-8god5PMVVescNR_oRJgA553F534UVZSRx3TCl10S_yU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvGaxgmkJd_1_kM7ARlRKdhHP0N9n-0bGhJ4W0B
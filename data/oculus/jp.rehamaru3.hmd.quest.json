ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51M7pYXHMtcQ7kNvwGxZBop&_nc_oc=AdpEbozf5G1kodXv6ViJmrg7BWuiKJKJT-3KZSuqOBIjkX3TY5qMU1ZfQDEcIqDsKcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDpuzj4kFZqflBilSunaFXLupyx6tJW8yBwTq5H8Amew&oe=6AAAA4B8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zszv6hgz2XoQ7kNvwGPoq32&_nc_oc=AdpV4D4qCSIdrwCCzAQ-HnzLBu8e3AVlM-tnEvqln6onu3b1FXpPlKhwlikjFxQWxFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5WcF0hPCYtxqtGpvFnZKtHpKpJyDcOoQltpWhGFjK0w&oe=6AAAB3F8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NG0Ud57pD34Q7kNvwEK8PB7&_nc_oc=AdotkgC5BwANFQg4j0gVvf8bQLgamrWp2KXqC8yFux5x-AzVfsRrP4ETXyxuqRynR48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-Tp0q0PNVg9J1xc41sSXYMpY119h8oy1EHISuOzRUng&oe=6AAA9AB5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJoKGi06qGgQ7kNvwGFHs1b&_nc_oc=AdrYi6uE-O_F4Hz0xmjuiJHHEcbvDRpo-VmobGnZk6iTvjT4VjwAXfIwJWmZCsLnomw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9pkn86LNeHakA4w_G1i1tPQOUOLJGWTmaLPux4KDWuQ&oe=6AAAB8D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeAoqItRRe0Q7kNvwH5p0jF&_nc_oc=AdppL0pzM-uCl7OOHotcXKrCFhtFLHobUqJ5Z1QGVho3_QquTngARr_uEHjFQA6i4lY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfhThbQEtT7XH1YLLmCXZF7ZLATZ7zZcyDh5dBRkoYqQ&oe=6AAA8743"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81-ZKehEvM4Q7kNvwFkgZ4P&_nc_oc=AdqNR0mIYEPxJlXQzJ0QE1GRpN0fPJ2aOIEu5_81Mc6J6gZg7e62MYZlH8f_LVRSM18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3rQp1gDdqwVNI4g5m9mmu57MJd9dAHbYL1Ki-QChLzQ&oe=6AAAA82A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GtyVmx3IB0Q7kNvwELwlRb&_nc_oc=AdonKtEXtUuaJ6yqAQSBrmFEcW97nMfXH2I6uATL5sVYcjx01cMXIB6UqDKzcKCMOUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ89elNfefUWjT4o7ZyPxlthAnJemN-ldzVImPt9jB98g&oe=6AAAB2E4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JxnSpCQ_l8kQ7kNvwHjkwXp&_nc_oc=AdoUqRZHYyVbRRGzrw7bzg4bKxU-ayDCGMcpLBoEC4uF7iDtNiN8iq6TXfL3dJ8_hrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFlS-pDNG3sQUo2pF9gz8GTLcSHv6iLe7ti27GvkgMew&oe=6AAAB7EF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
me": "cover1440x1440_en.png", "id": "982378408094414", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHwBxJvoQH8Q7kNvwG6LPeE&_nc_oc=AdqxNuiXeqwdLhh-iBGTmMlXDiPJIZg5PIxUj4FU38114O6-X9WD9B5zQyXD0FWLPLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTH0A9CJr99SYoCocOVHurVGo3xQT3QEizanw70b2qLiA&oe=6B0C6BF8"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm3-DwOtNLMQ7kNvwG7mEKv&_nc_oc=AdpLshpEYCSYYrvD_XNxqPXEL8KnNSBZfKG5EZqE31BRu9H_WdRMsqt_gcVZ4j6Yz-8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRjyuxRNHWDgeEs97NELW37YPJebEMOpdL_SkwGg3twQ&oe=6B0C7B38"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujUsUNV6iAIQ7kNvwGS2Mxz&_nc_oc=AdpA9-MnvLnbm4CI9vV4yIesvfvrxqbXzx2513hOOhHZiVljp97zSXweTUXLr5mF5zU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQw9fqeACSdb96ogP2Mxafp9wIaUa6-bHP1xmAHZcV4-g&oe=6B0C61F5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6emkumENtOUQ7kNvwFHGinD&_nc_oc=AdpFO_1sxAtBzPcyT4bbW0tTzJN11x_ytRok6vQsHA0Sc5KFEDP64O0_tjY9sxIM8qc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOST2_em6KXxVI8YEzbagWK3Lz7FUCTipLOSjxY8OS_g&oe=6B0C8012"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0v-KWVQI_gQ7kNvwE8_UwW&_nc_oc=AdoKElt_8cmQfVJ1fi6GwcUClz-3AN-PdERN8QKp_Bl7OzcGRiY2MGGvY2JVK_-TISU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR20LJM9wrhkE1F9gbem_jaQKJXgroBxONnXcsGNWO3Cw&oe=6B0C4E83"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLr1QR99fuAQ7kNvwE8Ve5-&_nc_oc=AdrUQg_t20fv3jGNXRaBmbmYY4qPSDCgSdEHk7AkShcCop6utTHkOW9AXYcpqC1WDZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYki4-jDh-INFpgRW0blFLifkT41jssLrjQRLotHzJJA&oe=6B0C6F6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocVDK2VJ8f4Q7kNvwFC9cId&_nc_oc=Adr0IDcNa3KujgOjehnv-PG_A_-h2x7pbJXtcNH__9MwuGLxKi1xQr4qZk_0h-uStjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQClOrebsJhmXY8fsVNV41RQBUMESlCDQ0_a9nwCoTLNw&oe=6B0C7A24"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-hKoQEbQV4Q7kNvwFLzR1m&_nc_oc=AdrVt040SW-xG0hn3lvME5F0GxWXCdLm8hSbHkN6gY6j_rWuONJ_TvihR7G6eYez-7
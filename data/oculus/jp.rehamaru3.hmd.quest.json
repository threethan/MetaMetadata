ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-LuCSQjDXoQ7kNvwF0sqzE&_nc_oc=AdqAFeuZI0wHmhoHmCEv7j3nOhaw22_D9v95YSYi4knR_HOXELkwAFkO7Ne0x8soprE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4_HhqnVvU-QMtTBVLKF3Of6i4Zc4Bk5wocC8ad51j1g&oe=6AF5CA38"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy9UpWKO3iIQ7kNvwHNlVcm&_nc_oc=AdpA1YEAopx9euJRnz9aQFdqUrKNkqdSiprebs8k_sRyZF1hJx0zTTDoETS51mChBCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmqkbMlp3mAl0vCtJfN40AY3hTeHwvvOu_MxIZqTRGww&oe=6AF5D978"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN46Yen0Zo4Q7kNvwHPK39D&_nc_oc=Adr6IjQx7CItCqAPmQYKDXjwK-RlzN2NAgB8vKljF8z4xfVZ1WIYavqZuhRSd6IX6kU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiuB3dv7Ko596j7PNRcG8JvAYqJIA6xVxWactFmcOhTQ&oe=6AF5C035"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaF8rdCZ-kYQ7kNvwHbuEAA&_nc_oc=Adpo1YI-iwLCiK6rzyaGA9s0kICDSExWB4j-dGnwHFL_iw09o5EVgSiccP9Z2lOvk0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj4CoyuPQZpNdlXtSqsX4yHUEY11DzwY4McWVPg1CSDQ&oe=6AF5DE52"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S7JCmxcCGQQ7kNvwHg2h_g&_nc_oc=AdryxHExtIyYFD2lIVD4r_qdprFdNGSK6UOgqEOZH8W9NDybbKaPdJaA_EQYKiPs3Es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwoVF-hI64o0lBf_v0wlRWJDoA90TNFgTrzhCajbsp2w&oe=6AF5E503"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-XQOzXTPMUQ7kNvwGPb07S&_nc_oc=Adq8odR2cJFa-KeW1j3zEdpUs5E-ET2-2qw-r6AbNAZ0zZMtdd_oCzwN_2bDs--H_hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBkKp1I6SdpdaBWtb0SunmsyidVbELHqtlZ-NAJy7pNg&oe=6AF5CDAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI8_1WJJHzIQ7kNvwExrDWQ&_nc_oc=AdohJaGFAFFBtajpAzAz3laK3o6QbMwcj-SOYp_Ic7AKZDVCqkK-Cr2e8GAjB1l3tBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYG26z6gSYuvOqfeRr-8KoFBWcKVR-ITqzmUXZMfMkQg&oe=6AF5D864"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa_z1Ij-8vIQ7kNvwHxo48n&_nc_oc=AdpWQb9pgrGnug8cK0syJu86J1dmQr1EtJ-EeLP-i7DeAi6r4GEXPM_B4wPDakYl7K0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdVnMFIx4333PKO10RlVZo88FLx_ojcLzuGQNLh6RrQQ&oe=6AF5DD6F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZS1zN0I3kDcQ7kNvwEbIRaJ&_nc_oc=Adp5jOkU1mGX3EGYsKJZ0nHqDGoDSnqplfsdZX7ss8GoshzvX_4XPlC7NebX-7N_MJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVQUxwHm_64njshlclkj4H_gIu7NJLTVI-z2WKa2cOvw&oe=6AC10E38"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omYHnYRliMUQ7kNvwEYobRx&_nc_oc=AdoLUpLBJ8l7msr0gIvMnzaYjVtV6GeA44AQJopO7UIS9Gm7ZDNmeFh2C5DY5uUxXV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOP49IkscA2WWFzI4GqyAsP3XmT0ZaY29EG-GrOU8U5g&oe=6AC11D78"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlSSMVsHai4Q7kNvwFzi-6L&_nc_oc=AdrqTSoFLuMrnHjqNKLLHqxJ0vQnfbZ2-lC4Cr4tOGcNFKXdDU_GnL4nt-HKWDKcb7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbFv-up8juz8zbDAfZFEAS-rBQ2c5HflAiRbuWIiC8Xg&oe=6AC10435"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOrG-8bSHMoQ7kNvwEjNrgz&_nc_oc=AdqwROWeVltvuFEkg30SVePJ0viDM43T0aU_SaOGIlT2oRBeAr1SLpNT9O_BMWFMLvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSv-uOKqRIfqkBZBKJCt9xxmsC4Ncg4lz5C1S4IAmRzw&oe=6AC12252"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crqp5x7FMWkQ7kNvwERKJyf&_nc_oc=AdrTqK310fXPp4zuULzCrNQbgYk4-6YPl6cHvVmQFT5aEwX7PNvO2SVk6svv7t6Efxw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXSb6S58FBbGKqt1HdAjkF3yTndYgs-LGrnPfZ7K2N-A&oe=6AC12903"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9bvYapCDfcQ7kNvwGLICPJ&_nc_oc=AdoY9Ck3Pv7AUgy5-g46VKAE5tm59l3G5cOaTNOvA0U918iEt-HzbWESdezyIk_AK5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS4aoTlDN7cQMdOXR25Z6dwVPf0_MEIBblhDrOVKmD3g&oe=6AC111AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKkGkiW5newQ7kNvwHf2rMf&_nc_oc=Adr3WRmfntTg5wjD9pf6fv1e0jYC4hMMFu6CYO2Hp_Ckj69D46BJ5cExQB3G5QeIW6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCCKhSJlrlWAerS-cWyiVpATCxAg_fRFWf5DjsuyvQSQ&oe=6AC11C64"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Tj8d5TwZg8Q7kNvwFAUBNg&_nc_oc=AdpMpd3zKJd3d6RZzyK-TSrZBVllI3rCoA3xNmU8p-u7RyQ3lHN7tiW08PP6M-y0saA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA8dMrAX2a7loRUbrt-cRvPK6I11xmE-yaNnulI9xCMw&oe=6AC1216F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315353_1252867
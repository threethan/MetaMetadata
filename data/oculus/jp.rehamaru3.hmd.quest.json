://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_iLrRRoPX8Q7kNvwGu9LkM&_nc_oc=AdoYgkOghQNHtcc7CDAxKAUMjmFNZJlyvLa1Lqwb54Kr2hzNeMmaT_SmZs8rQYNV0OY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k4qlCTnwQZhftpHWxKnULquyo_qIrTawlCvcuZs57tA&oe=6A412CB8"}]}, "id": "1544091694080498", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RFzeDFY9z8Q7kNvwE8gNn9&_nc_oc=Adoh52CjPjKs7MNP5Gm2Jml6olONnJw6AJY0IgyDm34wAkv2stukzWvTFfDaY3rPgTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jZJPihXlnORJgkLmXilvzVCdMJ8SVtvyf2GoAZBx1Zg&oe=6A413BF8"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9j7AlXQ0vgQ7kNvwEtxsrR&_nc_oc=AdqaXDcw1qoyWYgNt3lIkjgrKXAdlfxE6l5E5aZ52H7dlV_QEW47ojXmf1zmHTvAxpA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZxTlIOxsOde9EzD7P85Ev0VCRBKup9ztVVGyQdU71vQ&oe=6A4122B5"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9N-IPEvFtAQ7kNvwHHy5Cg&_nc_oc=AdqxdzdXf3FvT1rhZgbHEpIqUnKSUQT7Ni12_DLDOPgjOG2qS0W1To-jbOqY_LwZBUc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EuSQgCAQPJxw6vmPjso3pV37PycsnTBCLvI3jL7_TCw&oe=6A4140D2"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7WjY2BIaFIQ7kNvwFACBiu&_nc_oc=Adoa6OS_XQDvyfXCW89olSSzrmK-VFATCONyOSn4hPY3NjyW7NDBxansi7tosAH_SZ0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jv49mXT091PANC2nD1W1jUWLkTTQboF4vpWDDg_8sDw&oe=6A410F43"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXZ_FWzDQv8Q7kNvwF8Lav0&_nc_oc=AdpwqlxdnqtYvF76OsgWbOcnyaJcvMW669EILnaFPOHuc96rztUc2eHSGYhUcOVuVsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NlcZcz3zI7gC5OVv8tzSbWL61f_FUtNRMtsSRDQfqOQ&oe=6A41302A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VptmHm7xa1EQ7kNvwGgTuqQ&_nc_oc=AdqzI4VxeptRsLVMxLjSbzlktkKnABPSz0uQrdLqOBqALJ-kl1oh8isq0fH0rDYTQgU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_6LicjS5CO2XVODxTubYucTfybxS-iJxz1Bj-IlmqLA&oe=6A413AE4"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JniqFXpdYkoQ7kNvwEv4LHu&_nc_oc=Ado1h4tKz95AaddugUQHMjPEwuKZPdq4BWznlnXh-z2DxLLTpFSUeybs_1VqmtZ_44g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iuVaSaetSG7aHCb9CabBRueHdRLsLVpkruCdcDR3zzQ&oe=6A413FEF"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499315353_125286778
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxOx7JnF0FgQ7kNvwFJ7dAD&_nc_oc=Adp9EplziTfqsoDjF7I--vloh9WvH5ZGjsOICfMLgFaOF18UhtrUXfHPVesdblgpcg0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRx_ewHJa5EaiWrEzNqj-dZVdoewPUDeYbid-ootplAg&oe=6AE0B238"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A5xop4H_1MQ7kNvwEHANVf&_nc_oc=AdpLmOlm22YlI45f_2HbZboyVRoPAoRmODWQEnfX-g1QGkmzfEywe8mlUCEcKd-Atqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj_E3TBs-8sxbNJyuFse0i2OO7lt-7vPV0t0Rkr7jylg&oe=6AE0C178"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MyK3MAyAY4Q7kNvwGozeoi&_nc_oc=Adrpeyy3SKFZY_7NvcpgRKUmDxqZ0UDZf9uURu30FFF0avhvjdu4WXqpHJ77whpwn1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhfhkSYBNxzoRFWXlnrrOUAg5yyICkJZdv8_B574tVMg&oe=6AE0A835"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhqtaRDSWo4Q7kNvwGotQct&_nc_oc=AdqOJjSQf1XA9zEjOCMYLt--enhOrnsHFJf4GdYzWGLeq9K2lVRZcaYgnVD9VrpHToI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMUED3Ptfi5McSBrdLPUrLXoLK8IBkDxQi70l0VuyPig&oe=6AE0C652"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOqUknz-nEUQ7kNvwHL6nPd&_nc_oc=AdqwUWowz9XP3O1Jo-n80of_bJUPf7jQ1y18k8WIki1c5dM6EH_2Ye8yjdpnZwVNX_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtXgGV1utoL1mzuCkr9_IU6EYp2Cjy9_DX2iMzI-jDDQ&oe=6AE0CD03"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbRv_hVNMYAQ7kNvwE9rvKp&_nc_oc=AdpxcEr9arTaKQp3loAdmcHMhItJYNTPE8XYKsfb70-2m6M40l-WOZW9XWHQfLhhJ7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlbBE--jWlYmrM2TSA_kAkEwv36M0OBhNK0kp-tRssYg&oe=6AE0B5AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvk9NSdcDcUQ7kNvwEGljFk&_nc_oc=Adpnee8QTa4_fePp_qwbmz7IQgcAYNdHYndicpu9m1BeDdHdswmsHKZREZej0XBqBFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkfdqrYrzHxsndYOB_cvQdflDmmhFzbUqNXdk-uOZ9DA&oe=6AE0C064"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orPmMbPC1MoQ7kNvwF9-Z1R&_nc_oc=Adr1YyrkDeTbMEx-iB1YANdvGgu-sKnSSWy2nG5EvyIxGPC9g8P38WybfDXUO33pgWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3FAFTU7Yn9oMbkp9HUZFUh1ta8XoNdfvxoULN4g-d1A&oe=6AE0C56F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
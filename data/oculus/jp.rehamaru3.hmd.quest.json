ps://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622325_982378414761080_6297121199269376974_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sof54ey43jQQ7kNvwFhSgYa&_nc_oc=AdpZNkYLJBKW_pbsWl4jUP7YKk7YkUn9GOPbeQHvOCGUcySFZRTWsduux5meixIOqNM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsCMpaxm8n3QfcovADH5qWdAWa7kNf597bsvJfGe-WvQ&oe=6AB68238"}]}, "id": "1350042019889396", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "2672691649768837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820001_2672691653102170_6070227746444721464_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4cDY83R6t0Q7kNvwHl1Xxp&_nc_oc=Adr0w7EDyZkXNVpvD750G9lkR9i-nwCH-ppRzvRar51jPwFg1HJHo1i8Tc4tWkW2UZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLZk728jZEJwdDpFeaCEQ61MhDulzWFGsvVNnNYfZSkQ&oe=6AB69178"}, {"file_name": "screenshot2.png", "id": "1645642236781921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_1645642240115254_4780819430018594941_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqmrMQQdI0UQ7kNvwGl90CW&_nc_oc=Adr7qxkPLlcu2WRCl5zPvYyvnSSRiY3quM2CKCQaQ64vEx0Rgd25E2qadqH84_zInSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxH_-9ZYOxD4890J7DlG5FHiKIYJV1V-8Uh-TDEvUyAA&oe=6AB67835"}, {"file_name": "screenshot3.png", "id": "2003970736853004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622276_2003970740186337_7038040051001963756_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSG28KusiVoQ7kNvwHPKAAB&_nc_oc=AdoYJUDm0PEtzZcV36X5PxNqZuRGXOWxKq1qzGmfVGDiAu7km3oVxmq3CWYHrnUULDA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8xHLN0FYWSTXxQmHh_-Oppcl_0AG2ph6vsxGzd9l-Mw&oe=6AB69652"}, {"file_name": "screenshot4.png", "id": "1617185392819750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_1617185396153083_4871439775798051847_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYtECo_D_1oQ7kNvwEy_joI&_nc_oc=Adqyw-T4DFct0LS7NXpW7XRwDokvCAaKayj92NKFiOaqCXCxt_DySKOQfgcYqb9HWyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdBEZvvG7yHs19lGMla9yE9XtmopzvvSAEHetxC2_0aA&oe=6AB69D03"}, {"file_name": "screenshot5.png", "id": "927392076591193", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619148_927392079924526_6503803113885199451_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zznyQ25QmRwQ7kNvwFpYDfT&_nc_oc=AdokCH_42NnFwIxRgCwxF6dVgny9nsZd76s8kACpaeaBQjlqhbKeSgQgId0o1qL3e8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkdAwuTBBjP7NFhLbxkv01OGQz3nOliAflhtTx8Kd_Ig&oe=6AB685AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rehamaru", "keywords": ["rehamaru", "rehabilitation", "cognitive", "training", "assessment"], "long_description": "**About Rehamaru**\n\nRehamaru is a Mixed Reality application for rehabilitation professionals in medical and long-term care settings. Using Meta Quest hand tracking, it enables conventional paper-based assessments and training to be performed in an MR environment.\n\n**Included Applications**\n\n* **Number Cancellation**: An assessment task for attention and executive function in which users select numbers or letters in sequence. MR enables a three-dimensional approach to attention in real space.\n* **Selective Cancellation**: A task for assessing selective attention.\n* **Whack-a-Mole**: A training task for reaction speed and attention in which users hit appearing targets with their hands.\n* **Maze**: A task that uses spatial cognition and executive function to reach the goal.\n* **Quiz**: A task for checking orientation to date, day, and time.\n* **Object Search**: A task in which users search for designated objects.\n* **Hanamichi**: A walking-based spatial cognition training task.\n* **Select Touch**: A rhythm-based movement task.\n\n**Main Features**\n\n* Supports **Assessment Mode** and **Training Mode**\n* Targets cognitive functions such as spatial cognition, executive function, memory, attention, orientation, and working memory\n* Works with a dedicated controller application for program and session record management\n\n**Important Information**\n\nThis application is **not** a medical device. It should be used only as a supplementary tool under the supervision of rehabilitation professionals. A dedicated controller application is required.", "short_description": "Rehamaru is a Mixed Reality (MR) rehabilitation support application developed for medical and nursing professionals.\nIt utilizes Meta Quest's hand tracking function to provide a variety of training and assessment programs related to cognitive and upper limb function.\nIt includes many rehabilitation contents such as number cancellation, selection cancellation, volleyball, whack-a-mole, and mazes."}, {"images": {"nodes": [{"file_name": "cover1440x1440_jp.png", "id": "2267283124103757", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622325_2267283127437090_5618732659148961051_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFeTNM6SAN8Q7kNvwEircBZ&_nc_oc=AdqDB7gANjNqSomZTYUkU9rtiQcYOZ_mJG9QQnUuRAOL5TXRo8EB9mN5N-Pe9Ue7jo4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbY8p2nyANTBlJEf-9tSDqmpk3kzY3e9-LmG5_b4mzIw&oe=6AB69064"}, {"file_name": "RehamaruWorld_white.png", "id": "1307626311282892", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618499_1307626314616225_9098268127185132166_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9FWTUOvV_wQ7kNvwG3OIl3&_nc_oc=Adq60wTAK0ZHVikAg9YoqI8LZe_PKxfIboERt_FdK3TUJnQfv1CQOSaTfynxSUms1TI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFHdX0B5iIodJ74wCrz1lRs4tW2TQJsN_45V1_tjv7yg&oe=6AB6956F"}, {"file_name": "cover2560x1440_jp.png", "id": "1252867780007107", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499315353_1252867
UxWfEm9mRVOZa7wtuFRoPJNQEz0DIt5pnSKk-jRfYDvTUnKacQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzHAzlp0R0XpMZKfiPu8t0r2qMEr-rN_bXtGnL1yOGJA&oe=6AFC67F5"}, {"file_name": "screenshot_4.png", "id": "1416769523919473", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604347072_1416769530586139_6036035238132042715_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVAiJRaEG2wQ7kNvwHAQeKS&_nc_oc=AdrAeX5sqj4UAB-FR6FlV_BDbzKXaXUYzS4Dd-RurKsOIOy5vnnpmLlP0EwdWzfc8C8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIEA6VaVCut8cg2CiXkrcPIeEh3Qpz5DWy9uXXAPvvTg&oe=6AFC6C50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1464140208953895", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673751957_1464140212287228_2623470396754892462_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0Jq_KfTDd0Q7kNvwGlCr7r&_nc_oc=Adqe_rDR5RCRmB3INvJnTg-e4xnGSscKz1NUxhnRoDkk3kOYLbVi2sW4xv27EbLsnIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-CHxlwPo70v2xW2wBzVhw5TXXsFA2ITCxsQwCuoK0NA&oe=6AFC8C84"}, "display_name": "Flight", "keywords": ["flight", "simulator", "airplane", "jet", "pilot"], "long_description": "FLIGHT puts you in the captain's seat of a private jet over a whole island.\n\nTHE PRIVATE JET\nAn ultra-long-range jet with a glass cockpit: live flight displays, a moving map and an autopilot. Fly it with the side-stick and the thrust levers in your hands, or with the thumbsticks. Then stand up and walk back through the cabin - the galley under its skylight, the club seats, the dining table, the lounge and the stateroom - while the island goes by outside the windows.\n\nA WHOLE ISLAND\nForty kilometres of coast, city, farmland, forest and mountains. Seven airports to land at: an international hub with two long runways, a city airport on its own island beside the downtown towers, an alpine strip in a high mountain basin, a fjord strip between rock walls, a clifftop field, a farmland airfield and a short strip on an offshore island.\n\nFOUR AIRCRAFT\nThe private jet, a twin-engine supersonic fighter, a four-seat light plane and a helicopter. Each has its own cockpit and its own way of flying.\n\nYOUR OWN HANGAR\nWalk around your aircraft, repaint them and power wash them clean, then choose one and fly.\n\nMISSIONS AND FREE FLIGHT\nLanding challenges, a ring course up a mountain gorge, a harbour run between the bridge pylons, a night landing and an island tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join up on a friend's wing or ride in their aircraft. Voice chat stays off until you turn it on.", "short_description": "Take the left seat of an ultra-long-range private jet and fly a whole island: seven airports, a city on a harbour, snow peaks, a fjord and a tropical sea. Stand up and walk through the cabin in flight. A fighter, a light plane and a helicopter wait in your own hangar. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flight/", "website_url": "https://citiview-games.pages.dev/flight/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supp
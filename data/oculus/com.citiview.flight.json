QQOlvBS5vt2cspeh1LOhw&oe=6AF1FB96"}, {"file_name": "screenshot_2.png", "id": "2329202991172109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595129854_2329202994505442_2918847297448644771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ2Yz8UjpBEQ7kNvwEU0r1B&_nc_oc=Adq56rV060-Z5_Vr6kGDo3nu7xbvsJKl8qzBliI2bu91CmnJU0YaaZ4BqjVaEtueDpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXmbtfFb1sghBX0AAC6h-T562M2AZ8w9Z2Eqc1V0HX2g&oe=6AF1F8AB"}, {"file_name": "screenshot_5.png", "id": "921739774097394", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_921739777430727_8718692551340701954_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gCFW38hZpQQ7kNvwGuC4xx&_nc_oc=Adoj2fP7hFWOBXg5heM8b1wenv_GDz1umnJ8L6nR2M6opCR-LnxqmXxiJSOCtTd7DoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtx6ZWRCeHIPczHVDUAOIilog1uz5Qm9zTcTAHpuuPiQ&oe=6AF1DBF5"}, {"file_name": "screenshot_4.png", "id": "1416769523919473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604347072_1416769530586139_6036035238132042715_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZlJ0jbPUTEQ7kNvwH_dKQn&_nc_oc=AdovXVth-IVBiiZENzOve1IkWd87YyMlUcUOFta5Z74PfBu76DhRJeuQUInZsX9QdoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCqVEHOrlhyTixRyokbENyrI3pofsWV1-M3URmJ0Sjcg&oe=6AF1E050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1464140208953895", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_1464140212287228_2623470396754892462_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSdGh6cOdhEQ7kNvwFgvyQJ&_nc_oc=AdrDYv-R6apFjkm3MK-itJ1gxppNT6SSfEg480Pcg0Dd7hjFddWDB3ZVM5JR1sHWpSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR11xOAbAoxZ6OTAdMbdxNsvKBcqKT_hrv-o1pcocp5HA&oe=6AF20084"}, "display_name": "Flight", "keywords": ["flight", "simulator", "airplane", "jet", "pilot"], "long_description": "FLIGHT puts you in the captain's seat of a private jet over a whole island.\n\nTHE PRIVATE JET\nAn ultra-long-range jet with a glass cockpit: live flight displays, a moving map and an autopilot. Fly it with the side-stick and the thrust levers in your hands, or with the thumbsticks. Then stand up and walk back through the cabin - the galley under its skylight, the club seats, the dining table, the lounge and the stateroom - while the island goes by outside the windows.\n\nA WHOLE ISLAND\nForty kilometres of coast, city, farmland, forest and mountains. Seven airports to land at: an international hub with two long runways, a city airport on its own island beside the downtown towers, an alpine strip in a high mountain basin, a fjord strip between rock walls, a clifftop field, a farmland airfield and a short strip on an offshore island.\n\nFOUR AIRCRAFT\nThe private jet, a twin-engine supersonic fighter, a four-seat light plane and a helicopter. Each has its own cockpit and its own way of flying.\n\nYOUR OWN HANGAR\nWalk around your aircraft, repaint them and power wash them clean, then choose one and fly.\n\nMISSIONS AND FREE FLIGHT\nLanding challenges, a ring course up a mountain gorge, a harbour run between the bridge pylons, a night landing and an island tour - or just fly, by day, at sunset or at night.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join up on a friend's wing or ride in their aircraft. Voice chat stays off until you turn it on.", "short_description": "Take the left seat of an ultra-long-range private jet and fly a whole island: seven airports, a city on a harbour, snow peaks, a fjord and a tropical sea. Stand up and walk through the cabin in flight. A fighter, a light plane and a helicopter wait in your own hangar. Fly solo or together online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flight/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "
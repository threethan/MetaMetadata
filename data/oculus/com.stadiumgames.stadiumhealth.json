17579_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNTtEObvkvIQ7kNvwErLaA7&_nc_oc=AdoXFxpDaklYxmNOmJwVi4HUptq2XyBKs2jx4Hlg68eGfWPhskTE7HmpRc_LZXfBjZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpVVD1UFByHFmG4St10tu3RYSpWg9cf7NovtbIUF3BAg&oe=6AF880D7"}, "display_name": "Stadium Health", "keywords": [], "long_description": "Stadium Health delivers real-time intervention right when you need it most.\n\nWhen stress spikes, being told to relax rarely helps. Stadium takes the opposite approach. By pairing live biometric data from your heart-rate monitor with structured, interactive gameplay, the app actively redirects your brain's focus to physically break the cycle of stress, anxiety, cognitive overload, rumination, and even boredom.\n\nYour heart rate sits on screen while you play, so you can watch your own nervous system settling rather than taking it on faith. Sessions are designed to bring your heart rate down and return you to a calm baseline in under 15 minutes.\n\nWHAT'S INSIDE\n\u00b7 13 strategy and puzzle protocols, all turn-based and free of time pressure.\n\u00b7 Live biometric monitoring from a Bluetooth heart-rate strap.\n\u00b7 Quick 5-6 minute sessions, or a 15-minute championship gauntlet.\n\u00b7 Over 250 trophies to collect.\n\u00b7 Guest mode \u2014 play full matches with no account at all.\n\nNO PRESSURE, BY DESIGN\nEvery protocol is turn-based. Nothing is timed, nothing punishes hesitation, and nothing demands reflexes. You set the pace, which is the point.\n\nBIOMETRIC FEATURES\nHeart-rate monitoring, session analytics and AI coaching require a Bluetooth LE heart-rate strap and a Stadium Health account with active access. Everything else is playable in guest mode.\n\nStadium Health is not a medical device and does not diagnose or treat any condition.", "short_description": "Real-time stress intervention using strategy games and live biometric data"}]}, "developer_name": null, "developer_privacy_policy_url": "https://stately-queijadas-548bfe.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "Stadium Games", "support_website_url": null, "website_url": "https://tbs.stadiumgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1285242774676099"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1513550493834500"}]}, "baseline_offer": {"id": "1513550493834500"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790364480, "status": "PUBLISHED", "id": "1513550493834500"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1386578694542506", "version": "1.0.2"}, "id": "2610772796017615", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1271636762703367", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1386578694542506"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2610772796017615"}]}, "change_log": "Security and account fixes.\r\n\r\n\u2022 Updated network security components to address a certificate\r\n  authority advisory affecting encrypted connections.
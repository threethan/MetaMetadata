on\n- Realistic Oil Simulation\n- Wet-on-wet color blending\n- Impasto effect\n- Built-in Web Browser\n- Capture any pictures and paint\n- 2 basic environment\n- 3 step-by-step tutorial \n- 6 set of paint-by-number\n\n\n---\nPaid DLC ($9.99)\n- coming in Q4/2024\n", "short_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation"}]}, "developer_name": "Happi Art Team", "developer_privacy_policy_url": "https://happi-art.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Happi Art World", "support_website_url": "https://happi-art.world/support", "website_url": "https://happi-art.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8347169208638677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974570_801090675512782_2264195750941668478_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpefZR4ZJOMQ7kNvwEaJWKO&_nc_oc=AdmhVppKGLNsf0JsYebrE2SclKAfNY6hUSb-dX_TKy4V-DinjFTjzUTuxkTkgL2evAM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE9Uqm0K5bLc4i3uY8gZME-iYUrsnZwKQXco4fttsasQ&oe=69BD4CE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Open Kanvas", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "
.com/v/t64.5771-25/38974803_465666986311014_7197731990756580341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tvBLlI5ml0Q7kNvwF16Ghe&_nc_oc=AdqPTZckC_wb-Cy2V-FeqD-qaLv7LB31Hfmha-8xRHZMKhf77TUETYdbjhgqpxQBjnI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eoyFRuLHIWHaMSulipcB0xgXAcH8mKMByJ2y8CtB3Sw&oe=69E373D0"}, {"file_name": "Screenshot-2.png", "id": "378949618334512", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001663_378949621667845_568708544608308433_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab_HZ77gYAkQ7kNvwEh3Sz-&_nc_oc=AdrgeN8HYwp-fCcZJ6YWdxtRJF6tniNi39fjKgElB-xj0o0v1UCvyiPDGEPpL3B47As&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ibbunEsyUcjY1U3cJjAV6D1sju0lmGYYMAaYFviA4KQ&oe=69E36AA6"}, {"file_name": "Screenshot-4.png", "id": "843168287882607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974803_843168291215940_2784707129593999733_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujEV-mBYxu8Q7kNvwE4VM4M&_nc_oc=AdoXFo9I8nm9d_wiJ4UTOew-Epc5cnkyfpx4sSarbioD4TahBM_nPNJOPxCyAGk2Or8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-VbruirfmowNLWBVcGBxPrfOU4GW52ufvQWIS4Y_3Ig&oe=69E36C29"}, {"file_name": "Screenshot-3.png", "id": "1030441884929123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_1030441888262456_1953681753583237542_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZC2l-beKTMQ7kNvwG-0tCd&_nc_oc=AdrNxELaQLLiN2jYJel8r0pMEWUke5ptHBHvHvm0T6x1q8VfqlXE_uTnS31yR9TtpF8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wnaVAPSEDc2XnmP3gNGc0CqgrnfGUuZ-qK88_tMLnOA&oe=69E3945A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open Kanvas", "keywords": ["acrylic", "painting", "art", "drawing", "canvas"], "long_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation\n\nOpen Kanvas provide a realistic simulation of canvas painting in VR, convincingly mimic the way natural media interact with the canvas.\n\nFree version\n- Realistic Oil Simulation\n- Wet-on-wet color blending\n- Impasto effect\n- Built-in Web Browser\n- Capture any pictures and paint\n- 2 basic environment\n- 3 step-by-step tutorial \n- 6 set of paint-by-number\n\n\n---\nPaid DLC ($9.99)\n- coming in Q4/2024\n", "short_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation"}]}, "developer_name": "Happi Art Team", "developer_privacy_policy_url": "https://happi-art.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Happi Art World", "support_website_url": "https://happi-art.world/support", "website_url": "https://happi-art.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8347169208638677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974570_801090675512782_2264195750941668478_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YTRp4MoNHcQ7kNvwG-tr5q&_nc_oc=AdoYUVdTeTWauNhercIDvPcHTHgir6cvM3Nuc1ZrQ8zCkctTQJOK8OTlxaEzrSZvh5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38Lf5zmkK1IIAoH0aVM94x2qvXzbxWF6w-cQ0GhaeOjg&oe=69E38860"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Open Kanvas", "platform": "ANDROID_6DOF", "context_category": {"co
AftV9hDlqfpF4TZ8mUD9atIyfRPUoUT3f5lWYjExior6vg&oe=69A2D126"}, {"file_name": "Screenshot-4.png", "id": "843168287882607", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974803_843168291215940_2784707129593999733_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyhzYPP4lFoQ7kNvwESDa81&_nc_oc=Adkf55WA1F4Ge2Pdu7gVUc486YOv-rlXhXKM6k6xaiOyISw4tDwD4RIF5FS9zMLBmwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWPyKDKbSx8mDEhPDdIOvR40X2eJeW6KyC-aAsbL9hxw&oe=69A2D2A9"}, {"file_name": "Screenshot-3.png", "id": "1030441884929123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031584_1030441888262456_1953681753583237542_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIx2YgFKA4YQ7kNvwFLnllQ&_nc_oc=Adl3nRqxDkm0X6E2fSf4-U5phdT-9rkqHCPkruiH0_wok2fS0bwsrpWhW-FRyuqitoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftovVY26JPM4G2hBjFxUPmFzeRUe2aKZ8byBzedKHUzcg&oe=69A2FADA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open Kanvas", "keywords": ["acrylic", "painting", "art", "drawing", "canvas"], "long_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation\n\nOpen Kanvas provide a realistic simulation of canvas painting in VR, convincingly mimic the way natural media interact with the canvas.\n\nFree version\n- Realistic Oil Simulation\n- Wet-on-wet color blending\n- Impasto effect\n- Built-in Web Browser\n- Capture any pictures and paint\n- 2 basic environment\n- 3 step-by-step tutorial \n- 6 set of paint-by-number\n\n\n---\nPaid DLC ($9.99)\n- coming in Q4/2024\n", "short_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation"}]}, "developer_name": "Happi Art Team", "developer_privacy_policy_url": "https://happi-art.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Happi Art World", "support_website_url": "https://happi-art.world/support", "website_url": "https://happi-art.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
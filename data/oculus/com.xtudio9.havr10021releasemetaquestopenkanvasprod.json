.png", "id": "465666982977681", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974803_465666986311014_7197731990756580341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ejh9FRmNwrgQ7kNvwHie8GJ&_nc_oc=AdpI2lRLyS6NN7QwkSm76hLXrs7Xt63Ju8Tkewietqkqqxb_8JrlXS3GYbirC3T47Y4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3NkZBHjSeaT2ic2Htn3bZEvHQ39eignjZ8QmElJlufXQ&oe=69F1F450"}, {"file_name": "Screenshot-2.png", "id": "378949618334512", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001663_378949621667845_568708544608308433_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdTPS_abYHQQ7kNvwGKZYnX&_nc_oc=AdoosyPVW3l9Hwfza2v_Y8D3PB2dvN57_E41ca0DEazwt375A_HpavnAVcKPHhvErDw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af03hkJ_uQM77W0gT-11e73q0gHHFUz67rbaP076PRA2Iw&oe=69F1EB26"}, {"file_name": "Screenshot-4.png", "id": "843168287882607", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974803_843168291215940_2784707129593999733_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hmAVHTYCn8Q7kNvwG-_sO_&_nc_oc=Adp7cLTGnXr73v2drL19egcU5JhxkXHNE3CXWHoKzgIniOY4hV15UILuFO33RhtX03k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0C6XM6p-3P-5pQhlOtGFrWZvhx6N0fMaZJ3flQuQf5mA&oe=69F1ECA9"}, {"file_name": "Screenshot-3.png", "id": "1030441884929123", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031584_1030441888262456_1953681753583237542_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-npklNkwqF8Q7kNvwEBiXbN&_nc_oc=AdqCSS_CoMJGoz_CD17zqn2okkOPh0_95M_1SyHhecmORNaFmQH7SOn02a_NkY72as8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3DrSD0xgn8la6iz-e-N8zC5TMYMqIENddbNz8lu7GYwA&oe=69F214DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open Kanvas", "keywords": ["acrylic", "painting", "art", "drawing", "canvas"], "long_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation\n\nOpen Kanvas provide a realistic simulation of canvas painting in VR, convincingly mimic the way natural media interact with the canvas.\n\nFree version\n- Realistic Oil Simulation\n- Wet-on-wet color blending\n- Impasto effect\n- Built-in Web Browser\n- Capture any pictures and paint\n- 2 basic environment\n- 3 step-by-step tutorial \n- 6 set of paint-by-number\n\n\n---\nPaid DLC ($9.99)\n- coming in Q4/2024\n", "short_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation"}]}, "developer_name": "Happi Art Team", "developer_privacy_policy_url": "https://happi-art.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Happi Art World", "support_website_url": "https://happi-art.world/support", "website_url": "https://happi-art.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8347169208638677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974570_801090675512782_2264195750941668478_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hB7bhwX9DYQ7kNvwEDutGd&_nc_oc=Adoe_jmK6H1omuIUKpPOTfi3r4KDKdRUSNDVWh0nTrbgISEFrzCPv-RXTYa_DRbmO8c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2HWvbk-KAf5X8HDdMN99W3RVL1xZKX7zeSwYqp5oYbMA&oe=69F208E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Open Kanvas", "platform": "ANDROID_6DOF", "co
9UnYjEyXXcSxmhz3-mJDMUvQn_uk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymRQu9t8zWXy_WjDBuORVKR4asMxt4P5c5p18dGep2ZQ&oe=69B7E926"}, {"file_name": "Screenshot-4.png", "id": "843168287882607", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974803_843168291215940_2784707129593999733_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5-MfEU79hkQ7kNvwHAST86&_nc_oc=AdnAVGU5DTeq3v6nCndcSoHz6-PVdyeHHeFlWbfs96lY4XC8Yx2an_Je2m4KmwoNVlg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGaPUdxhz8DfnUqfgzjrrumjjh2YfAjDaAa7DD_kAXMw&oe=69B7EAA9"}, {"file_name": "Screenshot-3.png", "id": "1030441884929123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031584_1030441888262456_1953681753583237542_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TltZVPy2FkkQ7kNvwHz-Emq&_nc_oc=AdmV8wOosBRZEQPMBQxdg9LcprADiEfjzfPcAAy1YmYE577ejbSVAoBy_OpfMphgCeI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjdqCHSrPX1G2X4C6An2jQRZ5SVxMvrfROhA56d9pKGA&oe=69B812DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open Kanvas", "keywords": ["acrylic", "painting", "art", "drawing", "canvas"], "long_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation\n\nOpen Kanvas provide a realistic simulation of canvas painting in VR, convincingly mimic the way natural media interact with the canvas.\n\nFree version\n- Realistic Oil Simulation\n- Wet-on-wet color blending\n- Impasto effect\n- Built-in Web Browser\n- Capture any pictures and paint\n- 2 basic environment\n- 3 step-by-step tutorial \n- 6 set of paint-by-number\n\n\n---\nPaid DLC ($9.99)\n- coming in Q4/2024\n", "short_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation"}]}, "developer_name": "Happi Art Team", "developer_privacy_policy_url": "https://happi-art.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Happi Art World", "support_website_url": "https://happi-art.worl
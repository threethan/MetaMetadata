-MjLeavBUHDu0-Tm-jDAK7o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ei3er3iLtxGbMjjvaUx441Y862iCpu9zaKcm3ip-vlw&oe=6A031C12"}, {"file_name": "screenshot-1.png", "id": "465666982977681", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974803_465666986311014_7197731990756580341_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NqBAMEL4TYQ7kNvwFvOTZj&_nc_oc=AdoIyAj4m-8PpHyxx77S8WWjnHk9q0xIYXtNySJwLklAnAd1dH_gC6Stad6a4GRyhuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PwnDpRFBrMwsBEncz6KMLDwPN-d_mgwAxHu6fnRaLEg&oe=6A0317D0"}, {"file_name": "Screenshot-2.png", "id": "378949618334512", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001663_378949621667845_568708544608308433_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJ8zLQjtE4IQ7kNvwF9PXtq&_nc_oc=AdrPThedVA85Mt-djSC8rM8nA3QAgw4qPe4wXoGZqtV6WSSL_i-VpzNbJq5E3fvfMkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kANA2WJwDYB5QdCi-Hn4nbQHI3-QAUYaMzYPSSPGUXQ&oe=6A0346E6"}, {"file_name": "Screenshot-4.png", "id": "843168287882607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974803_843168291215940_2784707129593999733_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rr82qJmkuHoQ7kNvwHq2KqP&_nc_oc=AdoWc2OxLBdgUOAbUyg-24zOjn9iqBTxr62s1QxRIPI8usj_IQwNmXRajjw3DMIuDH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RwC3MAaJifh6bsBcF9xRKsyzoy9VnSH5N_bH55Ck8rw&oe=6A034869"}, {"file_name": "Screenshot-3.png", "id": "1030441884929123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031584_1030441888262456_1953681753583237542_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoBG2euVxKoQ7kNvwFe6h5D&_nc_oc=Adp7_B31w8WF0_6izKhkIX4GMOGnXznsRqPwo4-sjTndF8jmfs6qsF9JIE2gQFlDCqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m9c_FZglwtjmbaKY8MXTCIa-hfRw7zweoM9YWwZ6RVA&oe=6A03385A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Open Kanvas", "keywords": ["acrylic", "painting", "art", "drawing", "canvas"], "long_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation\n\nOpen Kanvas provide a realistic simulation of canvas painting in VR, convincingly mimic the way natural media interact with the canvas.\n\nFree version\n- Realistic Oil Simulation\n- Wet-on-wet color blending\n- Impasto effect\n- Built-in Web Browser\n- Capture any pictures and paint\n- 2 basic environment\n- 3 step-by-step tutorial \n- 6 set of paint-by-number\n\n\n---\nPaid DLC ($9.99)\n- coming in Q4/2024\n", "short_description": "Canvas Painting App, with hyper-realistic acrylic/oil simulation"}]}, "developer_name": "Happi Art Team", "developer_privacy_policy_url": "https://happi-art.world/privacy", "developer_terms_of_service_url": null, "publisher_name": "Happi Art World", "support_website_url": "https://happi-art.world/support", "website_url": "https://happi-art.world/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8347169208638677"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974570_801090675512782_2264195750941668478_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIKLLViVpMMQ7kNvwGVZjUg&_nc_oc=AdpzpF49N1f-YLq9YZ-ZgWHGZesd1o_npyNMgo5kalRWY73a6GJkURHGzNPUKDIgGJI&_nc_zt=3&_nc_ht=scontent-ord5
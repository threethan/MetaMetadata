ni5B3s2lhW1Ehejk--kHfmBdAxK03y5PahOyGzg&oe=6A131C19"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGwi0FmLRnwQ7kNvwHtVIgC&_nc_oc=Ado09K8lksbiQbHFJH2xWVethIiWhtbBMw_Qv8o4zjFt7Akw1KdqZsxZkjrAysGFiMo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Qq9MMV2cH-SAB54DyWvFoV7QdIG3DhozDylUwh_Md_w&oe=6A1301D6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj5DrTyuMf0Q7kNvwHr1kXo&_nc_oc=Adr8N_eaDgMrEfqgPkXLKzmdJT3Zw7WVp4XbqohBnQEvYaDs95kBGQ2NsGQ-f9b9xRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_eHRgkCU70UMT3yJh2h3sest5lacAOdmIwJYtVosCmA&oe=6A12F5CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqN-gDcGI10Q7kNvwGhDRoG&_nc_oc=AdoRsNa04JC9R0j7zl6L8HA6gnac3Sw-fZ0zyzm47RCho63uKKE7dueWGeMSjwtznV4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cWCxcDb9iO_2qGdY_gQ4vM0OSNcWENwnG2_lw4z5N5w&oe=6A12FB0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dhSmtzvGSQQ7kNvwH-l8B8&_nc_oc=AdqhYgTIqHG8AgUxjiNS8OCOnali6ZF5RPi0WIWQN0V43YY5fbg5hfHgCi3UoBT8RVk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kyRBXKBLq3rFHPIudCglAFTC0ow0CCzlbVambrMn1Aw&oe=6A12F0A1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "96068058004
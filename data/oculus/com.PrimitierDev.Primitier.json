iKs79pgJTtrpI6m_aQPLdBHaB0W4RsUgq3qwd2w&oe=6AF9D299"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO9DSpzdcdQQ7kNvwELkv6p&_nc_oc=AdqzBiPRJ3fp_uKwZrH8uSP_LzU7wPXemgvWWdb93oP3J-H1XiiB5AIYy_9xrCqY11w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJpAoPCZZQOQgmroi-1MQkdSi6gfbDNHSCigCIOuEsbA&oe=6AF9B856"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKdL_9i_OPMQ7kNvwHC3jyi&_nc_oc=AdpcrAcJ_EbmgseLMz2FynZyWnl2tADV4KQEtEaQ8UecmR14k-8Lcl03lFI67_SJERo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSllhzVM5n3VFEvtHHU8-OVVzy4WwYyrjTUnSL5-ncOvw&oe=6AF9E48A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgMRP0Ju-ykQ7kNvwH-JsmM&_nc_oc=AdrHTK45m7M0f0KSFk7nxdm1nvgg2gtyFg4FIJXK_Qhc6BDWUQyi4LpzDq2kVYuIZzE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiLOndddiJsbd_Pgxi_eUeL2mI2lF091ayiJFrczMG4g&oe=6AF9E9CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hd3Pdu0H7QQ7kNvwFLYECf&_nc_oc=AdrCttoWrL_BUapu0w0h0hmDWjdNUqkqoINd_KZYtVP4o-vw4GS8aToKUt7HTliB9hI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBJ18ZqZBDEyyTDfw5MpqxR4tS3JlkCnHAVgsyO9HXuA&oe=6AF9DF61"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "11005994994
7062395392486_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJPNHqBHy6MQ7kNvwE_PDSj&_nc_oc=AdpnqcssDH6AyeLqieKBLArBRQ9L_QfUp-0-T4a6R5evEg4imkPjq1mIHIucWwfeTgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeWhdFVU1ccPm75p7Rx_VVDHcBaREb9VKPBVVrFWnpIw&oe=6AFDC719"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqfyIg4SkJcQ7kNvwH-R2PR&_nc_oc=AdrlL-FQmXEVYYVZYr9d3M3jGNa5Prm59x3S_WSDSdnNDpdPg_jYx9wP6VA8ERgdnMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY7RA5bZUZVu-ef4pS8J0VowF1SRiPfVgGnj7oysv7wg&oe=6AFDACD6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s17xnKdDRo8Q7kNvwEWVXKO&_nc_oc=AdrsvhRQXu7OxHwxwAM2KLWibzIiOP1g_Ns64qKgLiUvj_wODDF40hS2VmCH7sHyas0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFNAqlzmfMBKAyXhzUaLx8fB6yLuItIeiyWoyFO8v09Q&oe=6AFDD90A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhbBPX-EdXUQ7kNvwHgIY5k&_nc_oc=AdoNfDPKHwZDNPJgnM_CquYTr0GuPNM6t0N3pHL3Dx2uIJRicQXT6zOHRm92rkKjm3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTBnOaAdyvnWo4bP0Zbg_TFP__gQ6mgnJREWVESWQouw&oe=6AFDDE4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jChB2OhyBcQ7kNvwE5EB0G&_nc_oc=AdpsEYUkfd062Di7uOJNWytTlDvpcVdSr1UIMi1_PLIWqUqOi9sBIXn6kodQ4zkULRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN8BzZVvYFOYgM459pId0i0ryY9zk525o-iR15cEaD8g&oe=6AFDD3E1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
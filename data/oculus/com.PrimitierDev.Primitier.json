00_AQILPu6JpslJxllxNGiCVEsz1k7UekfvF2gMh8ow6eCQ1A&oe=6AA96719"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YpynrFdgwkQ7kNvwGqb3Az&_nc_oc=AdpVmMDJnLEL0_YXsyY2XC6ZzPB1bb0F2xigXHvCg-N6DMXJpdZtOgZZDl85Yi5aTU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxbHcTBaHyecBpTlFtA9YFyIQ2bXE5cpJ5lSB4_ctZaA&oe=6AA94CD6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1i7gwGD-PQQ7kNvwGIX3hU&_nc_oc=AdqS8LlNcML63jToEwlZiRoAbxo-iCz-t1uIL5-4N1Fz4x6mKZoRgh2e6QWPzESrVFo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjSzdva4e3GBPnwNlKOoY6hdBuhUdPsvKJg--thxo8qQ&oe=6AA940CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVAWsuTScsQQ7kNvwF8aGdx&_nc_oc=Adrh37Bgdxy9M7mbtPtBbZ6yJZOot-nZLLtdzcsZgU1VpW0M71FBcN5-cTZnwuYjOpc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJPIWU5hAL4nk8I7fNsYafqjcx3mRC7rHlWY1ow471-g&oe=6AA9460E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4nj3tFpr-4Q7kNvwEHbCTx&_nc_oc=Adrph9bM5toO0jnvoiVShNC_WB6i6VRxEOOX2dx3LGMqy6vjJYmFiEO0JK58cxm8N20&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYT7ZGJOROw3i5pNSKKTI7qXi-KpglP_9K1Cx69PK1qQ&oe=6AA93BA1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "i
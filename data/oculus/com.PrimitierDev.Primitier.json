B2NiOIugAtwH8rzaP3xdpxODuAq0yhCjXGKaf8Q&oe=6AE8AF19"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cO7R0t9bdToQ7kNvwGUuhJz&_nc_oc=Adqa5zSFEwrN5YfY5WE0sPv2ItZ-sM2kVLzSUHaaGtwRCTRzKzUxCC2rqR8AeLFO54M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnRXz3jX1cBXVKx6kxgmKRa00ZSywniAIoIxo5MDkuiQ&oe=6AE894D6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGFOTc3JjT4Q7kNvwFnsehR&_nc_oc=AdrxPj0pdaJG_WzC5mcEC9ajMwf_xkD8huHa5IYwgLUO3MIEiPBTf9qOQuVYYyiIr8w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHxQtRszq5ihbPRf5EbJ3T69C4FTFQSU2jEo0GVNOqkQ&oe=6AE8C10A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1uTy1PWubcQ7kNvwGnRadD&_nc_oc=Adrcck6fXaLPDuhpwnAwY3vA5tmEZoFpCEcrp9hlN0ooLrUUJ3iYdr7BlCrO7GZ8Ofk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG82EqL9EQc7YXSA6Bdvl9qYDVWQurzwUPFWp_lOFB-A&oe=6AE88E0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqlJw6WWPnIQ7kNvwEXmsNV&_nc_oc=AdrUHQftRTPBdAtP6umhv1_86rKG2H2_tGAgT-noBr-kHtyCmcnrzywFt_oWZxf07xI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkWQdhlN7lC3nfiSToxCn_sQVbWpW5r-knJJSfR_X-fw&oe=6AE8BBE1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "19487701291
7K4GNciFZiyl6bjEAzyLq45lMs04jZrQfVC57Mg&oe=6A550719"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stu5aaz8AqEQ7kNvwEnfTAB&_nc_oc=Adq0MdgceQeDEBwZcImL2Sb_2T0CI5_-_s0zDralldZ_ZAo8fcTTOOWgWlnnf7wrowI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApv4QEE7GEl0XYZeLFZ6i1Inee4jfqq9J39W2LfdTNww&oe=6A54ECD6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sFgnwxsdLwQ7kNvwHo_nO8&_nc_oc=Adox5oKS7R1XDoIGrpY2EhIldjcnyCM__ZYF9rHD5Ud7stWvj0An3ii17kE03M7Zn7s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlQy0o9_GEWYgr5s4zh3gVUu4yqFcwXap8DPzKL-hUkQ&oe=6A54E0CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIMBMQoo_AMQ7kNvwGZwMkz&_nc_oc=Adpm6ps2AjM7lBlzGCtA17krZ5ckX3UHJ-0BrmuW7yIIZ98Dx_o_zsv-f5oJVDPORfI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtmMp3JYe0lIR9H8fggehtc6KcLt8MT30i7luit5OrgA&oe=6A54E60E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuhzROCaIo0Q7kNvwGG7Hea&_nc_oc=Adpay3AHVXSJm1dHeupkKhBzrnj27mu82FMpo7T4EBNZoatrQBFGMH0cm64C6V940-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAANB5gs1hSVpuveiafsbXcMBF6sIceGs_vXNx9fGFeg&oe=6A54DBA1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "16822909063
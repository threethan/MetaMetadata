Vn4lJ0kgDlFTBHGwA5qhtQGJmw1Iliufj4aIkgQ&oe=6A9173D9"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXwpXSzL_J4Q7kNvwHrfpc2&_nc_oc=AdoG1CSyLzkLVykhKjWEDlLkpAtBStHa8yT0aBwPohCi3gujo09b57vxDfAcjh_NhDI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV3Xkm_LushmQSGh7CH8Rw8clfkC7bVPfnknuGChQBgA&oe=6A9191D6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wzxP1clOm0Q7kNvwGCrH5s&_nc_oc=AdqXfZMGKnxX72CRiFYBtSWTb2J7OWtlEpA-opwtInanWkw0FJnhAyHIk2xAtDR-qKk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGTHjZyS2ele8UJ3_vvTSp-GS6gCWj8bh9djBU5LGTNA&oe=6A9185CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEFJ_CahPCkQ7kNvwEQK6Bt&_nc_oc=Adp4oIN5rtaSluhvuQeJBnprjCceNhgfwAljt0pHL-tpjmjaBi_H3saCtjcHtPvURfk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbl6GEoNPJ3LDB1RK33Zo9J5KpRT77yCror91HnnaXQA&oe=6A918B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1Mo_YTq8fUQ7kNvwEpZBC-&_nc_oc=Ado1_ekM0A8pixNjm7gDrLsxeYkdM1o9YxnN0Kw4I0Fm2GYcPa_fsVa9XG2LQkYeOrU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7vh9Yd9OLidzx90JCt-wh2NhWUUY85WR5Xyg-z83Zeg&oe=6A9180A1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "16822909063
wh6L7hS3kTuflru73nJK79QoXlR5rZESG-vUEsg&oe=6A883959"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSFkeKtBU4MQ7kNvwGzPvy-&_nc_oc=AdqHrlOC-dZ_86KOh6NQCmoDkakqZ2wirNKY5k_F20W5jaySt5ptzEbBY1JpNXg270o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTudyLW-B8AtGc1RxG6G1vDKgDzFd0ElklMDHY0Kr1lA&oe=6A881F16"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZj1_rO3WYQQ7kNvwElr0C8&_nc_oc=AdpTyU46g8utvUuNo3FlMaK-oQHBc2Hf-7x4jcrNok_1pPrXOwvVwFRbLk1xJsOiYxM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJZVbqdI0DK6E9YUaN_lIQT4txW44vnyNESRSTDE-Yaw&oe=6A884B4A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ljs5ZWpYNegQ7kNvwFH7EZk&_nc_oc=AdqLnIGBi_p5zSDb7oX8xy6x7ysU46YSlq9fD_Z43JDbjbPToQFiIPYJKsO6MvtxMI8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZuge7UwrBZbK81XYAznQX3x3-C5Rv7Fnf8KtfBdJZZg&oe=6A88508E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXNQrEURhzkQ7kNvwFG5xWn&_nc_oc=AdpyB4hCKIPWv6Gh2GOy2QERmi2loDtaTqY7MZtJN3jwZZcsW0CyIHsAO8Ihu71Xpo8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA9RDVVa082vzwgDI0kpAeY2eyawXvO41fXcv0gIwQRw&oe=6A884621"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "16822909063
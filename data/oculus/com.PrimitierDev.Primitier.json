4guT2h1GWDRyr4poFBG4KpNbC69ku0JDc2j3XSQ&oe=6AE36919"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCHArFDe2fIQ7kNvwH8R3m5&_nc_oc=AdpSPOehqWUz02IXWZYe9vlOhII8Pwj4J5au_WqSdsgtfcRi_LiF-0zJzS20v1Vvr8I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6y1cabjc2_ulv5M7flwcE9itkZGVm0vB6AXtWmYHuTQ&oe=6AE34ED6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2YUFEMBB9MQ7kNvwGFKi7N&_nc_oc=Adr6ipLRVgmmuCHrAcYk_3AydjWst0JUOjN1_k9NHC03bdq-ycbMBWS5PMyOglqaMLs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN4kaURY-L3MIwdV1JowsK9f_sWhMH5KQYgyhMsv4Jww&oe=6AE342CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvDbU2vGZ9UQ7kNvwE4vjKb&_nc_oc=AdoeXe9yJYqAw3Vmr9S2BxiXDOMoGuYbQgcz8ETcWml7nUr_zvLBSHsj9Y5crSliZZM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjraDdSrQ_pjGHIzMm22YOvZWq-tcenVxBlzs1UOA-gw&oe=6AE3480E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtRCv7p2xmkQ7kNvwFwTcIp&_nc_oc=Ado_wU2m9c4_vmqPRDXSN79wdj3BftE5c2sEcGO6SJS0NVosjEBWVd9K5j7od5q-Io4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvdAXDj6AkhnLVkP6pUN-LbN879nja-5j3Kp-_yuPAUg&oe=6AE33DA1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "19487701291
7062395392486_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osVBqvp0s6cQ7kNvwG9FwBa&_nc_oc=Ado7z8BybB-GCH5fZiTNTJ6126jjoFDDNi_PX4BRT2Xq9pN6TxnNDwWoXXxf_kb06Qk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTShQzM9Vd4GvUsk8_1NZL89JQEKk6f17lfV-kfzaGpAA&oe=6B01BB99"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxxqTIUkfoYQ7kNvwFg7I2V&_nc_oc=AdoiQUd8MveFtgX7L2EiJuO2GTWeOmajbcWnUHHOrElR6dzgW33NNu7YC_ysR5s_ZiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhu88w2U61iL1Rn1s--4V4SG-k3fRj1kFlpxZ1JDhuIA&oe=6B01D996"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNV8fHljbP4Q7kNvwFZOoU5&_nc_oc=Adq4rItBPWPuRAC3y_q5EttEPbanrXFnI89c-8gq7UjPfDr6bKtaUUQxhNDUebT8Bxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDRFJ11SH0q7aC9BQQbY_7VkRxrdkak8iqU9KvSq4Wig&oe=6B01CD8A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwEd_yeN9N4Q7kNvwGJWs_9&_nc_oc=Adp8ybzcep6ddVcXEtzQ-oTP6ldgIvQwRnsl6ncwNgZnzveEU6uC111L44U7GsTbuwE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRriEDu4mdgRW8DCUWyaKh7-RmmoWnGmhDF9jPGsAAv5w&oe=6B01D2CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wy347fOd2vwQ7kNvwGUQq7p&_nc_oc=AdrQNh54k7785uSzry52iyJcQlfbe0zsPAhYNlWdDAjIXCGwm8tLD8pd6W-VgcI7Bt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUd-4yBc-0kh6gIDT7MrdFiCnkqiVNpZZQkoHKbHEDzg&oe=6B01C861"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
kXrScyZWicCMIiCmqY4SpiCelXLq74eAkGbaEYw&oe=6A65F259"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLylVvWq1bsQ7kNvwFo7blw&_nc_oc=AdpAuz74_wu5NlJC23WzjPqQu_GQVJClsAO-3I-GpW7T6f7AaeBOi0gHyOm9a4NJY7k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsvLLh4TC-Ma2EWJ0qF8eFObUI8sGuZNlC-4YmFbaORA&oe=6A661056"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4HnAV-pMogQ7kNvwHI99k5&_nc_oc=AdoGpxR-tHqGIIcmfDrzgSLdV4c7qt9uvETXvDvM1LKLS6AhFOB52frSHspolQqZnCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZm_ZI5eGSnFaCtBb_fFc8bLgE1ssENbvDUtFddKvYZA&oe=6A66044A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqM2E1TNe7MQ7kNvwEsIiHY&_nc_oc=Adrx2xrQclLJK82LmACvuPY-no3beveRdnpWG3j9FlIql4IVJHR68an_mdfImzc1W6E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWyAxTE8wk0v3l7YUO4RmY_rODNYZvVJmywDzlSF699A&oe=6A66098E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZbLqMxLzqYQ7kNvwGICC-B&_nc_oc=AdrGvJ0r6LyHu0GekVQSwibB5HKG7zxdQ6N_S3f1XQ86-pfLtpJjWDn4gprqUhxFOQk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAusp1HfuujnFcw3FLi_N6vJ3IW4oP19mhWWl1efx36bw&oe=6A65FF21"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "16822909063
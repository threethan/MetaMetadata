APqEMteHdzroRSlZNMeSK9jMzyO8mwAiemPavXQ&oe=6AF88119"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO9DSpzdcdQQ7kNvwFTUGJo&_nc_oc=AdoL-_6br4buEBAu0nuAh7yhI-NMaeqqPvYbgySJdFThOXXhstv3yXHcu7wL6WW6VBA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkAoI-Cu2ujoqivoKWIMWhVYFa6yblRyE2nurh9Mq3YQ&oe=6AF89F16"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKdL_9i_OPMQ7kNvwFFvgUV&_nc_oc=AdrLZOYiBAcAckmdai3bG8Cu3fhY3x2LS3hnK-9eP8h0AhDM5lbE59MR1uOkFdqG6Ns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh4gkZn_dyVtruMN_DUn8-Lx-AVRHlmSXE6X-qVG8WMg&oe=6AF8930A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgMRP0Ju-ykQ7kNvwFbmfaT&_nc_oc=Adpb1QwREOxTp7WfPKTCng28Tv-ipi1vcrzdTCC-yxA6g9k6wrhx1uoQQOrVorJfjLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNNp1LG08AnGtu7I8o1Y0AYDz3TnDL7jdGK4LKegwKGw&oe=6AF8984E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hd3Pdu0H7QQ7kNvwHB5t5_&_nc_oc=Adp4XtDi8gm-P6hnUqxBCb_U5krmg6yRonQ2xC1-NemI7kx8IJ6c9VyWpBRrvE7F2uU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCGOFmaTy9I20tgvGaI5w8RkWUWkbViMhyBRlAmg046w&oe=6AF88DE1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "11005994994
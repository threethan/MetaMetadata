z2JQOcCkkOPlVq7LQ8jSfE9eroz4jlZQkzaIWbg&oe=6A2AD719"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFjWWEaOdVsQ7kNvwEYKv9q&_nc_oc=AdqxNm_jwsMSwI1Ny7uzCsdKOXAA1zBYEM47KzVO9Tlo8Of4J0I77LtH8uunX6K9VSY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZIUJNDc0qvlajZqt_0fs_4zfk4EiW-zEUPMNIPUFIHA&oe=6A2ABCD6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be0JiKoe3NIQ7kNvwEtRwBf&_nc_oc=AdrlniIsc2h51IGbyLOtvrMrCgXLAGEQ-ayRqyVOE3MNVr5jH3n9k3rRczUcdYrbnLw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JJnl7sGDvpUBfGYOD9-DYjWFR2trbahKS0-YDxYq1Yg&oe=6A2AB0CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHdIKnrFZYsQ7kNvwGAgbgr&_nc_oc=Adqjwrv4WdYArT6MPCgE1AWM9ExZ27goPBpoYSxaadDMNG6QthHrjd8zPyHwh2aDTYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82R0o1ok2g5GMDe3k7JuE7cXWAFkT1fOtAmYOBbyYXWQ&oe=6A2AB60E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS1mR0KiFF0Q7kNvwF9_6hm&_nc_oc=Adqj-Hye0eHYxt-GJXZ2HQh9HV5q_-k1IUzX_uHxh8Pz6yguq9g-9UN-VDW8L9vynuA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89xFJDnSVSdsBdIWlsDhcVnk6ttu3C9MdBTuFZ1wgHEg&oe=6A2AABA1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "96068058004
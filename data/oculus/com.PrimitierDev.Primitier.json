u3GgXyLXE9Z8nx_wwD61H17-LL3S1n4gndiGYOQ&oe=6A414099"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etGAfsXMXdAQ7kNvwH9Fn1Y&_nc_oc=AdpksH90Fbm5X9-av6y0zhVRyw5ijV6lU_q5BM1CtR3qodFIdNTq2NRv1vSptIU564w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z25fkQBVuRs_FLBHrvlDbHDIrcQm_Wvo2kgg4cY_PFw&oe=6A412656"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ_-NE9XhiAQ7kNvwHmuZmZ&_nc_oc=AdrBCS9vgoNOuD0C42b1gEeneArrCTFbNykyENR1h3XPvtGiNbgDHLad9Pr8hxvabGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qfLslrY6M0NFaVBObP6rNK9NonhkciQy_0Gupb6IbPg&oe=6A411A4A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5kN-BVbENEQ7kNvwHzLE06&_nc_oc=Ado8ZgFAmrp89irczybcZGUASrnh-4baGVTpayDtHq7GDgSbQ87upvj7S748LXxGy_Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s1GFxM8XNN0VuHqnewov25l_WzNJUqzBfR7J5OgAc5g&oe=6A411F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vN7dWjorkbMQ7kNvwEvIWOF&_nc_oc=AdpZTMedxhZ8_yo6CUxI_WmOKs6VNFxWjv5deO24H4CPppF3y8O35E96QYmcxdQOPBI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rhCvHARFdp4yKPZArI0IVMOY2hV6Le3_KlX-Vl7bDjA&oe=6A411521"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "96068058004
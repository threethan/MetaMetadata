UBCbvHu0u3GPn85aORYXxn7yxHHvVLRoupzk1aQ&oe=6A69E6D9"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F70IjOfh40Q7kNvwEP7Wa9&_nc_oc=Adq0FzI9ubms2Ow8WTKW92_wS-uAO5Zv3BrgDHZq3LrU-hoSJhkoy5G19CKb1EgHrWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAag8x4c-Sfu4NjybFP6KLpU27aUIkTZo8hHyhIVg7AbQ&oe=6A6A04D6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSTsWbkcHi0Q7kNvwH6f83l&_nc_oc=Adoa9kz390my_4oijUSfenWpeym8OXqWzI6dn2sPWj9qOTuYjZexzgqc0qfSJxicHC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_X8chjtSfo0NCbyC8xvtUOeu9j0CY-eAliUNDcZytvw&oe=6A69F8CA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybu5cf4lQU4Q7kNvwFGTZ8S&_nc_oc=AdruxS5Uz4CmLA7BNx6-nfPVBwGNHCD4f9ouYOMqBkj2LL3DcIzcm-dqtWd7JLkn-vM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdpTTkYBu5zLJ-t6mpaxR0t9t2KMVJ6jf6PkhZ5En-bw&oe=6A69FE0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0XobybUu5QQ7kNvwGlvA4H&_nc_oc=Adq6nw5SxqOSDAkk48PzKdGc7GfViE1JSiOpHYqtK0ir2mGxiCt809YYslgZZxRVOrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD45D9DDk82gqA3RAqwRxnwGCw-oPZpIuue977W_daNg&oe=6A69F3A1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "16822909063
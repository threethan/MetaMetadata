ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apFtjk0gwTsQ7kNvwFUTusl&_nc_oc=AdmJex4chsF9x9yWEuslTEEpQOTh7oFxkhIxoGyyOlT2XVzxBCjXs3qR89sJPLWkc-k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afvegx5Iz5nsO61IDYQ_xW-w5hzAkSiPlxv-T5laAHe-JQ&oe=69A59556"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc6JCA52cz8Q7kNvwGMxSZo&_nc_oc=Adm_uT31XpeVCNW4a5v__VZJTi3HnvIg9UJLLwOKMUwolklIS6IqJPsAj0cJN00KeHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsaI9rO3tk6buTOZECYam48j4XUSJiwXcUfmAPNicF5Uw&oe=69A5894A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZiW08GxMIgQ7kNvwFVHavD&_nc_oc=AdmgjVWVkJubKBFDQ50PJh1QygBh0bz_SoGuDjbB-DSs6W9ori1VQQ8dzboONdCeUSo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afugspr_mgshO-4Xb-4tIePW1nqLLH5v3SDdnU1e3CwUdg&oe=69A58E8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9CHO52Yp6MQ7kNvwHTLLTY&_nc_oc=Adl6ny5THpnnCA7TivI5XRm2grvEW2_U1AR7xmn-SeTWyb_tT6sXLArHatAlgKc3WJ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft5UWXQQ5C_FAR6fnSWtomSrSVU7jcoxqL_rmjMECgdgg&oe=69A58421"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "869343698885172"}, {"status": "PUBLISHED", "id": "25086111617659838"}, {"status": "PUBLISHED", "id": "741328181954930"}, {"status": "PUBLISHED", "id": "1251596646659518"}, {"status": "PUBLISHED
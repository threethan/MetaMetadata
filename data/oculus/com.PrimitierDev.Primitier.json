7062395392486_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S21Ca46VzEQ7kNvwEOyjun&_nc_oc=AdrgMz-49FfEz-OmIGgaB7RVSkGjnvo6LR68totfVeHHf_6qw3PtUObDbL3JM19TOXQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLtwmcCuta6pmk8AfYOseuL8ccTAitLgvXrbTzn5T9Cg&oe=6B0B2E59"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6kUgKM3o04Q7kNvwExTqOL&_nc_oc=AdriBy-S2Guz6S1B0HXUZESNXC-pgko2dDWJ8rqZtug-57Yrv8_z2GGI56kA7uwYCTw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnk7pZdDs34NebR46IBtXGJJ40pM5Dh3nYmlr2F3j9TQ&oe=6B0B1416"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApO3ppGK8DYQ7kNvwFcUEpg&_nc_oc=Ado0pXq_2p5XNm7-Eg0BrXdxXmi3cmYpP45nl2QGnBWYnsb6HnHN5sz6jwD_bbBo7s0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqbZXJ4hq4Yj0mMCT2fEVSekBkQxZUSsrxSxZCX7xrXg&oe=6B0B404A"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-P9E0EBunAQ7kNvwHZrUf_&_nc_oc=AdprwVGhTTv_-xmg92HCAX2sadJ_zuZBzjd488t-SAo2mSunhtD3sAFR1ZBHZ4jnhFA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiBSUPyJobYQ16EbPRIS8zeVJHneoR0uGBtlYAI04PVQ&oe=6B0B0D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmA9Byj1em0Q7kNvwHA4xVT&_nc_oc=AdoAGVFbnH5y8yn5Qhg8WsmQ0X0Sjx9R3WQq2Bm5gIasoZqyYtWpIOD1ztmPl6m38DQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvh33h22leKoOBHduMsJog2CIa9_6_bdRuF7H6CHXoHw&oe=6B0B3B21"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
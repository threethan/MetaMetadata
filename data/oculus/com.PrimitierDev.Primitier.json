00_AQJWA1pKNdZtYpC0Zp5tM7y8SpTWWi8uMv0E8PaoQgUaRA&oe=6AA42119"}, {"file_name": "AppLabScreenshot3.png", "id": "413754801149434", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974886_413754804482767_4855071253066670020_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCXiA5IAgh8Q7kNvwGWJSj2&_nc_oc=AdotWQQ7KJGFjaZT_qS1w4WLTueWKR2EPNaon06qZap0GW3Ll7W9k6rWw598uHAk_M8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgNjurj_t2Rbj1oZ7yI5fBVZP-VRgi-iCD4DQpHECsZQ&oe=6AA406D6"}, {"file_name": "AppLabScreenshot4.png", "id": "294435413666212", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984472_294435416999545_3795438112730856325_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coyy5tdTK0QQ7kNvwEG2xKt&_nc_oc=AdojLgWjzU30IxyqQfpC0qulJ5F2kql7JdAyeADdX8aDmV13Ywn18uCz-BKJDau62o0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh5ZaTf_YhwU6F82MaASRCx_Ct602fnn8YGDKFyDVVIw&oe=6AA3FACA"}, {"file_name": "AppLabScreenshot5.png", "id": "938499564352926", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974657_938499567686259_86769797011572924_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBK3XuG5D8gQ7kNvwGGiPLJ&_nc_oc=AdoW0OI9BHk4prVUcqFtxxMe60-53Ueg0wqglIgxTtNQvtS9OzHsVXq0Voy7hQ-urFU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOaZRUOSWCj7rACHzYQcd49KeQoTX4nFn_yIT2c_9wAQ&oe=6AA4000E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2560x1440.png", "id": "436329968864272", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974655_436329972197605_6304746820845701801_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTlTqEiWewAQ7kNvwFdzDAN&_nc_oc=AdrAEEyzFIT7__L2tuJLzxxHLIo_7sguX-XlhKh04IHMw7WDobnYvwNyobuEaYoTSQM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRApqG5NuO8ycz8PwKjCUdwCHTsBWjhgYBPmgG35nA4g&oe=6AA3F5A1"}, "display_name": "Primitier", "keywords": [], "long_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation.\n\n- True Crafting System\nAlmost all objects in the game can be freely cut or attached to other objects. Instead of assembling pre-defined recipes, you can create tools as freely as you would in real-life crafting.\n\n- Vast World\nYou can seamlessly move through the vast world that is automatically generated. As you explore the world, you may encounter enemies, so create weapons to defend yourself.\n\n- Advanced Physics Simulation\nIn addition to basic rigid body simulation, the game also includes simulations for air resistance, lift, and buoyancy, allowing for the creation of physically operational boats and airplanes.", "short_description": "Primitier is a highly flexible VR sandbox game, where you can create tools and machinery by freely cutting and connecting objects in a vast world based on physics simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://primitier.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Ota Mato", "support_website_url": null, "website_url": "https://primitier.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24950376051244970"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "i
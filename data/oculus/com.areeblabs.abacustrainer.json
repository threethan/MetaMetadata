nt-iad6-1.oculuscdn.com/v/t64.5771-25/593718973_964009156227169_41986749470564199_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFWrXdQqnvIQ7kNvwG_1Zqb&_nc_oc=AdoUzXlYzo_U3LIW9okleuAcgQ4RZOI6HNREQF3ZXeZihb3uju5UKhjRF5-GkfIWZjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND7Sz-8gzy6YfUTskrAjiAOoWc9Qj49_sgYZV08m5WmA&oe=6AC27048"}, {"file_name": "01-free-play.png", "id": "1105917225302160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622195_1105917228635493_136295478111524164_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8T4wUd_t7IsQ7kNvwEVYRWt&_nc_oc=Adp7K3nwO0Jj0wKZadwv14z5N8QkRisUTfzF47euxX5Hfn_U6O7i5RxLwpOoIginZu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0G_fd9U_AwHFwV0Wu5aXrRP0uePNM0JJ91pyrxgieRA&oe=6AC28132"}, {"file_name": "02-place-value.png", "id": "1483629297148177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623585_1483629300481510_754083096442679871_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjSYgXRXIlcQ7kNvwGe7zQz&_nc_oc=AdodJAp2tFoKu760TH7oOk8U3asOGMyzjmzMlwqbhAtoF2YtI7v8VwkBjCnNnE1HumM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbyycw0OgGDQ_NHLD8H-vAGiU3dWZ6SOgvFWLLRYO4YQ&oe=6AC25B78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Abacus Trainer: Learn Soroban", "keywords": ["abacus", "soroban", "arithmetic", "math", "learning"], "long_description": "Learn how a Japanese abacus represents numbers, then move the beads yourself.\n\nFollow eight guided lessons covering digits, place value, addition, subtraction, exchanges using five, carrying and borrowing. Watch each demonstration one bead action at a time, then try three checks at your own pace.\n\nPractice with ten-question sessions in Addition, Subtraction or Mixed mode. Start with Foundations for direct bead moves from 0\u201399, or choose All Basics for numbers up to 999 with exchanges, carrying and borrowing. Hints and answer guidance are available. Results separately count answers correct on the first check and questions where help was used.\n\nExplore the three-rod board in Free Play. Point and click with either Touch controller, undo moves, clear the board and read its value. Adjust board size, text size, sound and haptics to suit your setup.\n\nAll eight lessons are included. Progress and your unfinished practice session save locally on your device. Designed for seated or standing use with no artificial locomotion.\n\nEnglish language. Touch controllers required. One purchase, with no ads, subscriptions or in-app purchases.", "short_description": "Learn the Japanese abacus in VR with eight guided lessons, short practice sessions and Free Play."}]}, "developer_name": "Areeb Labs", "developer_privacy_policy_url": "https://areeblabs.com/abacus-trainer/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Areeb Labs", "support_website_url": "https://areeblabs.com/abacus-trainer/support/", "website_url": "https://areeblabs.com/abacus-trainer/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1316565511541000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593801605_4620888664857027_2585845978205266346_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jxf5VlBEncAQ7kNvwF2fgqt&_nc_oc=Adov7QUkfWYkar6jSSGmmhlB
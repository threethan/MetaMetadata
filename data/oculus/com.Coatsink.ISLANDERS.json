xMF6CT1gdDfeOFoK2Wpj_ahUizqapkDE3EIPejaVw&oe=6A565406"}, {"file_name": "Islanders_VREdition_Screenshots_03.png", "id": "268398585993306", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75451778_268398589326639_5064043821890409215_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR1lJbWYjmEQ7kNvwFCwbcg&_nc_oc=Ado_amiy1y-gAaRDDXr4DSlU_W1gGoGZDodc19ATJW3IECJKCyd7YWbTR9Mo1IxuSTQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0_G4q5K6OEbZG__eZIE5DeKcD4QU7w7z1cT2Jk6BlOA&oe=6A563869"}, {"file_name": "Islanders_VREdition_Screenshots_05.png", "id": "1415378742398225", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001664_1415378745731558_2019956264389253012_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d7cBZMHkqAQ7kNvwFtRzJb&_nc_oc=AdogRaqmkhInH9L5u9vdiK3PPJNOUvQb3Dc3BstvrewMoi4yVip1DjnGuhk3hQfQ-Ag&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcdI8uCp7HgDch_bDWeJyU5IT2IpN-t8YoaNPEKFMYSw&oe=6A563664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IslandersVR_ReleaseDateReveal.png", "id": "1483737295705954", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982593_1483737299039287_6714985319880285810_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uiSiXjv3_UQ7kNvwER_oXZ&_nc_oc=AdoFA2xgGYpkgtcRKbC1loyPay-x23t6qbadHYmZXYB316H2wdeMCarHnE_Iskb0ZrU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSdYeVlGVBWEgnuAxuK_JSKiWXvP0_sTN8m6c39tW9Ug&oe=6A562570"}, "display_name": "ISLANDERS VR Edition", "keywords": [], "long_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR.\n\nExplore an infinite number of ever-changing new lands, expand your settlements from sprawling villages to vast cities and enjoy the relaxing atmosphere.\n\nIn Islanders: VR Edition, you begin with a blank canvas and a small set of minimalist buildings. Your goal is to populate and enrich each island with your creations, unlocking new buildings as you go by achieving a maximum score. Points are earned by carefully placing each building, being mindful of their surroundings like providing clear access to natural resources and making sure entry isn\u2019t blocked.\n\nWhen you\u2019re ready, you can travel to a new land, exploring Islanders\u2019 stunning new environments along the way, while building bigger, more expansive structures. The more you build, the higher your score will be and the grander city you\u2019ll be able to gaze upon before starting all over again for just one more round.\n\n\u25cf Intuitive and rewarding city building\n\u25cf Endless procedurally generated islands\n\u25cf A relaxing atmosphere\n\u25cf Beautiful, vibrant colors\n\u25cf Unwinding gameplay", "short_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR."}]}, "developer_name": "Coatsink, Stage Clear, GrizzlyGames", "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "http://playislanders.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8146041512164821"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.co
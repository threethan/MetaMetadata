3gkif26ptPrdVq6OPLe8VoR5J3eMPoNMPXdpf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCB1JqUojMFNN8f2S1gD9EeXaH4-y9a5FLAm1dMPU4YQ&oe=6B0B17CE"}, {"file_name": "Islanders_VREdition_Screenshots_03_1440p-standard-height-1440px.png", "id": "1346164232635485", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035327_1346164235968818_7923751512708624710_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNZYV3I7KlAQ7kNvwGoVwUo&_nc_oc=AdpMHIoaKMqwrX8RyzCR7-FBoo63b_0GrPU6qekoOkQSwYi9H-5YdIFaXiIUfa5lEhs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyF2xADrM5iwRsBedWpNd9VKvmxS74JNcpcP-GJoM4vA&oe=6B0B3CD6"}, {"file_name": "Islanders_VREdition_Screenshots_02_1440p-standard-height-1440px.png", "id": "3112852895688402", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974515_3112852899021735_5040215199236679953_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ekzys_1wiJwQ7kNvwFStmxW&_nc_oc=AdrxKp6T6qICmkqhM1Ou7BUpRdA5tpT0Ak67fq0nBw9tsTYU-NjqPkfgsnlj1wdooUI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmoQpBcowut7jfs_BJKDQHFVl540F5Gnimd5Dwm2ihxA&oe=6B0B2D6C"}, {"file_name": "Islanders_VREdition_Screenshots_05-TEMP_1440p-standard-height-1440px.png", "id": "298697709509265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982533_298697712842598_1620060725266348105_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp4w-1hW9B8Q7kNvwFsVysR&_nc_oc=Adrn1-UZ9GTQmTWSpi_NyECN3d4kQv0Vfoavks6JYQP_BeNwtinP719uekBDsJhUcpk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6c0QyOPyWEsShz4QZVHR4GHtsfoCmzkL8-CxHHQ6k6g&oe=6B0B2662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISLANDERS VR Edition", "keywords": [], "long_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR.\n\nExplore an infinite number of ever-changing new lands, expand your settlements from sprawling villages to vast cities and enjoy the relaxing atmosphere.\n\nIn Islanders: VR Edition, you begin with a blank canvas and a small set of minimalist buildings. Your goal is to populate and enrich each island with your creations, unlocking new buildings as you go by achieving a maximum score. Points are earned by carefully placing each building, being mindful of their surroundings like providing clear access to natural resources and making sure entry isn\u2019t blocked.\n\nWhen you\u2019re ready, you can travel to a new land, exploring Islanders\u2019 stunning new environments along the way, while building bigger, more expansive structures. The more you build, the higher your score will be and the grander city you\u2019ll be able to gaze upon before starting all over again for just one more round.\n\n\u25cf Intuitive and rewarding city building\n\u25cf Endless procedurally generated islands\n\u25cf A relaxing atmosphere\n\u25cf Beautiful, vibrant colors\n\u25cf Unwinding gameplay", "short_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR."}]}, "developer_name": "Coatsink, Stage Clear, GrizzlyGames", "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "http://playislanders.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
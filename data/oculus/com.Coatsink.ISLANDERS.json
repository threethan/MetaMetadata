8WER4-qeMXkLyJH3HcUI9g4RFc-xhqB-UYuij4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS16fPpCuSmZJU1FUeFLn4zpm04oWJrCJGOr_Agh4MW0Q&oe=6B07234E"}, {"file_name": "Islanders_VREdition_Screenshots_03_1440p-standard-height-1440px.png", "id": "1346164232635485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035327_1346164235968818_7923751512708624710_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J5ri0-GRP0Q7kNvwF9e0hm&_nc_oc=Adpp2III4Ttd3MX_OKpNH7GYSI8kSiLzuPAS54yWIeeAVY0_fgFWfLEvNrIf-ez4xUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHhHK6ah6yNAn2V7mPrc9txRTpurpMvNf6fImBNzm4IQ&oe=6B071016"}, {"file_name": "Islanders_VREdition_Screenshots_02_1440p-standard-height-1440px.png", "id": "3112852895688402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_3112852899021735_5040215199236679953_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPuMKljJ-NgQ7kNvwFYEmMt&_nc_oc=AdpJH2LgESSA3sdYduyjgAnisfayF5mNLH9i0q34Zk96mwxDoup83MXETRuhJaMq4EI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvtBg5QkNGs4hzUN9nFnG-jAsTs5tuLpDxqWHnNDJH8A&oe=6B0700AC"}, {"file_name": "Islanders_VREdition_Screenshots_05-TEMP_1440p-standard-height-1440px.png", "id": "298697709509265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982533_298697712842598_1620060725266348105_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e00FD_FF4qYQ7kNvwHDB-cU&_nc_oc=Adobzms9D7WOti79xwTdclbxX5Ue6uanT6QIfNkWCWaxk2R2FbIekchOKmsbJaJmA1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRfXO08az2kffwH-yGsq3rm1L8D3gwLE7fUGvXtBw93Q&oe=6B06F9A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISLANDERS VR Edition", "keywords": [], "long_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR.\n\nExplore an infinite number of ever-changing new lands, expand your settlements from sprawling villages to vast cities and enjoy the relaxing atmosphere.\n\nIn Islanders: VR Edition, you begin with a blank canvas and a small set of minimalist buildings. Your goal is to populate and enrich each island with your creations, unlocking new buildings as you go by achieving a maximum score. Points are earned by carefully placing each building, being mindful of their surroundings like providing clear access to natural resources and making sure entry isn\u2019t blocked.\n\nWhen you\u2019re ready, you can travel to a new land, exploring Islanders\u2019 stunning new environments along the way, while building bigger, more expansive structures. The more you build, the higher your score will be and the grander city you\u2019ll be able to gaze upon before starting all over again for just one more round.\n\n\u25cf Intuitive and rewarding city building\n\u25cf Endless procedurally generated islands\n\u25cf A relaxing atmosphere\n\u25cf Beautiful, vibrant colors\n\u25cf Unwinding gameplay", "short_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR."}]}, "developer_name": "Coatsink, Stage Clear, GrizzlyGames", "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "http://playislanders.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
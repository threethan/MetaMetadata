477962181494024_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZyyYrtkhokQ7kNvwGpB9dK&_nc_oc=AdosxYy9SCZ5TEOLEsDckAPvD-lgSDyeMdygylk73ObNZgiA39qsfYF-wOdjtuJ9TLc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPBbZpk6l70ie2_RoYi9smDGfhbQmTLKmZ8Hf-kmEByw&oe=6B103786"}, {"file_name": "Islanders_VREdition_Screenshots_03.png", "id": "268398585993306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451778_268398589326639_5064043821890409215_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC-oOQ9KSCQQ7kNvwGvmwAv&_nc_oc=Ado4bl22QfegPccPbfHfoayg1u1Hbw8Uq9SfRtUW0j715s3CYTl_X7xBXHCaSCyGQ_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUNmx3yHSRd1FUmR0O5RLyUyyNoDC2ju8Cdq4VutSQ-rA&oe=6B105429"}, {"file_name": "Islanders_VREdition_Screenshots_05.png", "id": "1415378742398225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001664_1415378745731558_2019956264389253012_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv2PnO-mHSQQ7kNvwFGoJdc&_nc_oc=AdqhPYjcnx17oFFWV3uKT67hEySV3-1ddzhgmJv_k7v4wwJWgbztH3Q_ViOJ2KjuDqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVGEB6QL5Upp1nh8FEc4G75jiG48xFu6GRL-MJ6DWW-VA&oe=6B105224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IslandersVR_ReleaseDateReveal.png", "id": "1483737295705954", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982593_1483737299039287_6714985319880285810_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dB5Rq3ERh2IQ7kNvwEw-0BP&_nc_oc=Adqbvlsf4226roZ3trPgFr_BIHIOcGfsd4AFNOPNlNKZAZkRvb6AJWl-ZTrtlFf-wkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBMhuhkByGpbOEC0NsbKkrEEMbg13N26em9AYdRlGK5A&oe=6B104130"}, "display_name": "ISLANDERS VR Edition", "keywords": [], "long_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR.\n\nExplore an infinite number of ever-changing new lands, expand your settlements from sprawling villages to vast cities and enjoy the relaxing atmosphere.\n\nIn Islanders: VR Edition, you begin with a blank canvas and a small set of minimalist buildings. Your goal is to populate and enrich each island with your creations, unlocking new buildings as you go by achieving a maximum score. Points are earned by carefully placing each building, being mindful of their surroundings like providing clear access to natural resources and making sure entry isn\u2019t blocked.\n\nWhen you\u2019re ready, you can travel to a new land, exploring Islanders\u2019 stunning new environments along the way, while building bigger, more expansive structures. The more you build, the higher your score will be and the grander city you\u2019ll be able to gaze upon before starting all over again for just one more round.\n\n\u25cf Intuitive and rewarding city building\n\u25cf Endless procedurally generated islands\n\u25cf A relaxing atmosphere\n\u25cf Beautiful, vibrant colors\n\u25cf Unwinding gameplay", "short_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR."}]}, "developer_name": "Coatsink, Stage Clear, GrizzlyGames", "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "http://playislanders.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
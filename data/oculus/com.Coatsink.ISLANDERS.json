xTF93BVxX2FqFcdhY-kJXWMA3rf7p2pGEGf9CnfZypAA&oe=69CBC156"}, {"file_name": "Islanders_VREdition_Screenshots_02_1440p-standard-height-1440px.png", "id": "3112852895688402", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974515_3112852899021735_5040215199236679953_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dWwz1oHeKAQ7kNvwHfebLC&_nc_oc=AdoDYpwoXQ5g3faxn5jI1Isti_vaSOxncLmYk4IFPrY8d0TiLEuKwdyLcr1wjmxt0TI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwjXsI-gIhtulsXn1Q0PHvRDHd8a5pwJ97E5f1LNbzrg&oe=69CBB1EC"}, {"file_name": "Islanders_VREdition_Screenshots_05-TEMP_1440p-standard-height-1440px.png", "id": "298697709509265", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982533_298697712842598_1620060725266348105_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkW4MKZyOQgQ7kNvwHPIgEo&_nc_oc=AdrcpkkWluwHJmN7O_VYcF7vNqzH6mF2JZ5qbZ9udzwJhGEdl-GSMa6GvenUe91fgA0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpcUyKY6midu5BUuNap1WVtx3jk2OyrMuInJSC5z_Emg&oe=69CBAAE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ISLANDERS VR Edition", "keywords": [], "long_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR.\n\nExplore an infinite number of ever-changing new lands, expand your settlements from sprawling villages to vast cities and enjoy the relaxing atmosphere.\n\nIn Islanders: VR Edition, you begin with a blank canvas and a small set of minimalist buildings. Your goal is to populate and enrich each island with your creations, unlocking new buildings as you go by achieving a maximum score. Points are earned by carefully placing each building, being mindful of their surroundings like providing clear access to natural resources and making sure entry isn\u2019t blocked.\n\nWhen you\u2019re ready, you can travel to a new land, exploring Islanders\u2019 stunning new environments along the way, while building bigger, more expansive structures. The more you build, the higher your score will be and the grander city you\u2019ll be able to gaze upon before starting all over again for just one more round.\n\n\u25cf Intuitive and rewarding city building\n\u25cf Endless procedurally generated islands\n\u25cf A relaxing atmosphere\n\u25cf Beautiful, vibrant colors\n\u25cf Unwinding gameplay", "short_description": "Islanders is the critically acclaimed minimalist strategy game about building cities on colourful islands. Now coming to VR."}]}, "developer_name": "Coatsink, Stage Clear, GrizzlyGames", "developer_privacy_policy_url": "https://coatsink.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Coatsink", "support_website_url": null, "website_url": "http://playislanders.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "566103188780163"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "26334443096174098"}, {"status": "PUBLISHED", "id": "1431416438377721"}, {"status": "PUBLISHED", "id": "844785855205205"}, {"status": "PUBLISHED", "id": "1189251840076230"}, {"status": "PUBLISHED", "id": "1462676564802874"}, {"status": "PUBLISHED", "id": "1505003180701613"}, {"status": "PUBLISHED", "id": "1064860495716371"}, {"status": "PUBLISHED", "id": "9759855950735100"}, {"status": "PUBLISHED", "
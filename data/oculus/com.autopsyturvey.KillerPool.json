04.2021_11-03-53.png", "id": "885153078723297", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYghTsXBSvcQ7kNvwEWoyDD&_nc_oc=AdolLnOddcV67VlHj3JgERP_yNDD_kYjijF_sQv3C3KI4KIr7bt1zxynrXoAVcG1U9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4TV_mmk0dxiJF8NkwPZrXGAYw3rzkyndgsnvmcUD1yg&oe=6A5B844F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqYXk0mTWZUQ7kNvwEOg6sC&_nc_oc=AdqnIKbHizvbvpTXJxjcLmzXZzzzB5jC19ud3Vg0SmwBxQ0KySu2ar0s5TI77kWYEC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmarzHEnBCNQv6Hlk6t623gYMsTelX8Q48QGaC56cFMQ&oe=6A5B6E44"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8cX_k-MwDMQ7kNvwEhmxh-&_nc_oc=AdoHvD95WF46o8SP2mhxlvK80eDpYJCg8hEp7Tmvh16xhZ_YGuLpbeYck-LiKUw3hKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCas5Wy19Mduwn06GKnNkArND37IPNNoS6rjCHpbqlm8g&oe=6A5B7ECB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEg-m1rte3MQ7kNvwFgMvIo&_nc_oc=AdoarPww0fjC5Pj5fk_fo7HOBPvC0t2KfrVdn9Nenyt4SyClGwUuDtmjaL_5Jc1cnSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgS8t2TBtLGkr-tZZVWyTB5FkojK2_2Xcxo9vsQtS44g&oe=6A5B8773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6dAlSHMWrsQ7kNvwEw61cd&_nc_oc=AdqBoHkmicVulhJEnuO3uZz8jIJlD8MLtwpibSWiSIffB7Kto1GdTMejCj6HQTf8Zw0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGgf7mJDM5KiZyP1SXw1ZXGaBDpc5DsLDyCnPrc-crIg&oe=6A5B7B3E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
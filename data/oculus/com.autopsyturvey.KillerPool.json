-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdNYl5KTl3MQ7kNvwE5WpoU&_nc_oc=AdkMdJ-OXwJgtnP30t6RRUa7m_a2GkrAL6v2aGO2s5xBWIuj8NG_UEQxbqDepTcvQww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQ-R2rSXKt-vfOyUK2jcfGV4QWTHJn-4zfiSfPvb93-g&oe=6999B7CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8YYD5HG6aIQ7kNvwHDPEVk&_nc_oc=Adnl0_rzsGnj6Xlpv6ajChosOwlkqqp15nEwLX-czMg7CKYQAUeABdgsRh5PQ43sodI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsyMypmoXD5L1w8sjiU0ZTeKbVI7aDwOS_k0zgAKh2zUg&oe=6999A1C4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpydYblw-oYQ7kNvwHn_nAJ&_nc_oc=AdkjB2QCO-3qyB11-5hpIvAYN47G9KnS4p1GIAOa2vaKmD7LPAJGJo4hCBMtZfjDzJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftPzeQk27Mn0Ii4oQaI68WijCTHjEa33Eog-jdo9LC9Yw&oe=6999B24B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5z1cLKblNoQ7kNvwGxKKpe&_nc_oc=AdnAK0uTlEd6-bqjNXfJVPR8OzDIgL0xVFgUjU6Qt23tLezxDofUuEDODKk9pJi-9WY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjtLi3zbUS9pSteOkkk3zh603QPaLWh9UMDaqVPoD6Yg&oe=6999BAF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06Lhy5VNNTQQ7kNvwGYCYSl&_nc_oc=AdnN4FC3ybRFOmT15ke6fRjGW4SDYfy7z5Dyj9iUPe5b4cTgM0BvT6M220neAR-H_BI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYra4VrSvm6E_IBBjjbkfrQc0w-wSFCuC3kqhIDcISpQ&oe=6999AEBE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "sup
04.2021_11-03-53.png", "id": "885153078723297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vq4r_vX1ryoQ7kNvwFWahX8&_nc_oc=AdqhlsUhf78KKYwnSLN7jU8ASNMORNQoURNUouJj5TrkX7PyJZgmslEUaLUtO5aMOHM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L30cEajNw_QutDh8ftWDvEVo3oHHhy3uDymQ4u96leQ&oe=69E4DD4F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r38_tDC4c8sQ7kNvwEsMQE8&_nc_oc=AdpjY3qRfE2vS-44-Ygudse-S5H1NF5hRxSruIstOGoVlVi8uoUpNdOjBDtnLrz2RPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yaHdMqt0XpFHhG_Ikh_OZp0TCwC-6Oczhg2mlVaeYWQ&oe=69E4C744"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV1ukqtbffEQ7kNvwHvpGld&_nc_oc=Adq61dTah2JXiawZ5Kw_WSP9ww3008bQsu-dOqhKmzJppA2E06e2rTptaAJDFzOTvcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06223YnvHgwmOrf_Qhn6MQWWQ-2TfV2iQ-ugysXyAdFw&oe=69E4D7CB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbK0_F7J7ZYQ7kNvwFNUjhW&_nc_oc=AdrJ4Cf_78kggioBigKsB6NyC6W-LqO2sWoYXMU6kV2mwdSYm8390kvMaJsUQG9D58Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nSFY8HgwLI2-VONOuR15brMxWsRjHnLyRoY9nS0VN_A&oe=69E4E073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcmVA0IQas0Q7kNvwGfqrLK&_nc_oc=AdrZOraKhsRAJSR0vvucCtMD359kx97AGIg6PKn-NnrW5XUDID4OELhkgmvbvb53tdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tbytxIr7yhG9YuiU2gjY_NnUFmcWz7yyx6XIaR9cAVg&oe=69E4D43E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmWZYsd3sckQ7kNvwGqYmLL&_nc_oc=AdnducpiYJczfaoBsLf7A783lPhN_fUAjq34s8JpW7xF8PLU2NGKmFqjS8XEL41v7QA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftndCAE_-lh6pY9eX0uAnaN-4uzt_915DHpkuc5sJ-XEg&oe=69A5954F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=em_9baeYx-YQ7kNvwGJ-czA&_nc_oc=AdkmyKyDLhBWY9KXO6hE03rTw6HfK6zCziCLDEOOHlrzd1I_cxm5pnvDl65Ot7Gr7NQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftvQG2tc-2I5mVuivR1IZMmVi9fjmKKJSsOVWM1wQ3Ssw&oe=69A57F44"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96Wk61WXzloQ7kNvwGJkv06&_nc_oc=AdnqXXhvfRARvF8zHLBW90CjDejBxVEus9i_QfhhqZA1SXM88r3u3NlFtyIbEH-G3PA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afua8O7GhGNfR30axO81qK9jlUUYp8CPRnhg2ryEnGoQmA&oe=69A58FCB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOVaTKvhSiEQ7kNvwEjLOgC&_nc_oc=Adnh1RhkGP28i61aNJWomArQ44RD3TPRg0KPjSyYrE1cuOT8McC4srIzkK_XcUKycoQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftEXJrK6-s3fNHKs99aOd9vhJAcFwGCj3B-lu5zzvc7RA&oe=69A59873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NteNdPYE4qsQ7kNvwHpfN3x&_nc_oc=AdkYK8t8khY-rraJWkjHZvFyX2LN3Y3wBns6iL2N9B70EFfSucO3_BHtLTnM3qMQEik&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfteLqIR_9neRs2WHkWvWibGp6ZtmZyJsWlCHKWux_gxow&oe=69A58C3E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "sup
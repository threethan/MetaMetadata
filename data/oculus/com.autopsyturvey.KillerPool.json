-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_G1jadyuWgQ7kNvwH_rsof&_nc_oc=Adkm5B3rGGVFSKTrkjGaNjK8_S4jM5_FJ0mI8TUha10NMgreyAjuukr6PVN6Ry2zkAA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuODJvTFwgffevPKM4uzcYrMrRgursBeKr5sYDBC_Aipw&oe=69A1A0CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6gz1ZUjwnYQ7kNvwFI8QZm&_nc_oc=AdnuRAE-bP_e62REOxY0q0HipYxeKGTEp-C3G7T2DeRQoK8MpFT6QPHUNfTBgNtraDo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afv6tR6i002lKwmipWDUUTh6rQ8TcXnn2MwKAxfRZOEbDg&oe=69A18AC4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRT1gl8oxDMQ7kNvwGDPDL9&_nc_oc=AdmKeevEo1PGd81zBLomWTOX-ZCmNFfO_xlc1_Yx-60A2r8NDVyMTUmXqfDTz81CamM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvQIhOw8XrgJpEJKOZGZI-Ssoko5qjsryoKM8b9HxZ7Pg&oe=69A19B4B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeaUq3zNGtQQ7kNvwFXYOys&_nc_oc=Adnbn27qdg_oCiIvWhL4fj92gKy3G3bbZ_UBdv26ksVKaLjmUVbDV9NID5Sy0Wyj48w&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs8y3061AJhjV39FG8yGmMZ-IHYhJGXIfDUFLHSP5y2xQ&oe=69A1A3F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGJbLlCvNtMQ7kNvwHuDf6N&_nc_oc=AdnfE0l1NdixrMQYudGk6V6ZqOG00eBSxRWhiU1Kf_hM3uZeWeTRfo4Vc5Van4AsPBM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv3LiefVY8OeTfonM1Wvg-g7NB79Uu45J1OulVcZ-jnhA&oe=69A197BE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "sup
5153078723297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kU3y23KuKEQ7kNvwFEkV6t&_nc_oc=AdkfiyZHKaWdhuGXrhmx7HhMrCl1fW-kt01-M7NWhnlXo72SMMQ-6l7nGQqMcrHYcys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxqCkdGGm9wnVMSF5S4LPpEs1VzTfgXOJoCVYT0Zq21w&oe=69AC2CCF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g52m-fkjsQ4Q7kNvwHW-3mw&_nc_oc=AdlK0iK4cnzzA5Gm3LDTEMuZSCVV7PXrXZeawGBdBSOQ70R2gpGKGh7VHDvHTySrtdQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOFF-iYLUbikFID7d7dq7EptfHABv2a5lvGn-sta6iXw&oe=69AC16C4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3-XbmHucsMQ7kNvwFhO39I&_nc_oc=Adlked4kCmPzken32Xrs7Ms5ClWOqT6NaX5gVL4iqa6TtsPoMHkIs29TuNXlEP_idE4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkzIcsJZDYp2tvmd9q0t2x6g3Wt35Uu22EL-Ik0L5r-w&oe=69AC274B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iscYOKadwIYQ7kNvwFr2ZbE&_nc_oc=Adn6d_8CDcyYkmtKxmAaKlzCRw0gbEmnSEey1p8CDdvkdVS7YqjHjAnrZ3pYr-1ol5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzNh0K7FjsE2fPyX3YdMrnA1pVgLiD3e4kUpPeOEcnfCA&oe=69AC2FF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sALnXV_A2cQ7kNvwHEJi-W&_nc_oc=AdniNnIf4DXY6ZKKM1ghFviS1m7qjkGA0JkW7mSOg9ZETVtmzvJEPk7RpD2aL5VAf9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxh1lTOtgPjT-4uXM6tuv9jQXJI5yqLzaC4FBsnXy1lOA&oe=69AC23BE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
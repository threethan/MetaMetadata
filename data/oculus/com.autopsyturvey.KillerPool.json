-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKnPMRH3unYQ7kNvwFDCiOx&_nc_oc=AdlM0osc7u9oxS4JfHhVlVmqK9rdNSWL_CJ-CUGQGhh2Lu3dvV0AKVUNI0GlW2E3KW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsXw2uxDF7l9gWiK6GH88A4GEerKdkaY3N5reSFSzhOjw&oe=699EFDCF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6gz1ZUjwnYQ7kNvwERI8-K&_nc_oc=Adlr42-hSpm8A4Ivbzjl6RfPP5gOFcKI8jXbBR6QBu77zQDSgzbM2IW00oZUk4YOKVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZx_55hQHVJC-fw1h7au-_DG5rtdM7te8yZOmjYDUm8g&oe=699EE7C4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb09-eyaUy8Q7kNvwHuZ9or&_nc_oc=AdkthWhb-wpp_2t3pJwS-7X3MV9ZWHlG7s_7tB7-Lnp_yhQSuXk6zoq2W4Dk3B3PRkI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu7Zw_lVOiUw7tayUQvQ03N7djSFa_Va3h1JqSy1qLoCQ&oe=699EF84B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_ubWEXFaUkQ7kNvwF6Y9ci&_nc_oc=AdnXHO1HvyH4Ce4Zo8dLj3FvkXsiMlxA-R4R1qexkkxHvAnQ8tKjtry0ZL0eIToEJ_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvyHZK6aqxvVKd__FG0tUaUPac0gTLQpA67vjOW8vkVjQ&oe=699F00F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RKsVzq0CWMQ7kNvwHFkKm2&_nc_oc=Adnds6AMuIhkgemLdjblzQhbVFSN5xvk-wobPvnwgA83oW_Wvcuc26VgECdPFUdoPKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs_1a5xJ79u3B_Mw5t-KxpsuD9GirbJdZOXD6H-_g9a2w&oe=699EF4BE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "sup
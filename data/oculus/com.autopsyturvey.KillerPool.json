5153078723297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE2F4O0IbdgQ7kNvwHcewaO&_nc_oc=Adk0LrujdnplyywZa3dL4jtKT6vk0nydsK4475T5VHfeqJfHhNqrHDAZOJD43rw27hU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLW6i4cXrMeWbin355cW3JBkZjqOWja13ow1Faw3NYWA&oe=69BFF34F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U-UjVJgGp8Q7kNvwGHswUq&_nc_oc=Adm3SJci8hN_G0J5GPBbkMGEL2897gIgMTEvqCwdJab1QqpUNb56BlDopqMtj5TLxis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyy3OHdadoBPmucIe_8svakEdI6f57R-tx6DqDTUCaKqA&oe=69BFDD44"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaYumF18Ki8Q7kNvwF2sb9L&_nc_oc=AdkoFb6ojZ_kqwlINPnotfVN1728Cd4NOK1w_xTv9oVEOYBMhMuOblw35ferAtuJcZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhxpT2JCOeAYKjiGE6hh7CSrMUZ8cuSsFrcw80YT--tA&oe=69BFEDCB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6yE-x_Dj_EQ7kNvwFWj1kK&_nc_oc=AdlJO2aMpB6y_18aPyXW-Wa10hNIAJvbmMsHgynusyQm35n1i-p-MxcA4lv6ROk7MOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIpFlCjTThsMAOymFQ0t4g3x5m1lZlLj7jCNAKT78pRw&oe=69BFF673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIh_QBsfINYQ7kNvwGrNeFt&_nc_oc=AdmLtcn99UrKacjZGKdrTHyBP3LdMsQmJlwM2vxOn9txMeaBwtEP0e7AIBUKCqaLjBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZTcwhNptz0dSl0L5NNGOa9VxRfA5cOUKT976p5cxB9A&oe=69BFEA3E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
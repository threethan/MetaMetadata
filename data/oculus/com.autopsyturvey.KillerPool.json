rqL8YQ&oe=6AC107CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjm9_g15Gq8Q7kNvwGejvct&_nc_oc=AdpUpEdQRnpthwbAvBGjdX8Cin2Gzjb8esjcxY7fsxmmj_WD3u5MEviTuHirhhUk2GE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNntnMEebsho7nCRetNYCaL_TasPtym3kLSoxIW8MfloQ&oe=6AC12A04"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrZ9qmwZaaoQ7kNvwEKC4fn&_nc_oc=Adrk00kv-slIc0X5uAWLnrto66lgRbCYQJtNLaVs-8ljhbiHeF6AbPKsUCR5L0QDxQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZNpX2JTaw0QP_jy6-2ztNVDfLeGupf7CgscTHmQ4mCQ&oe=6AC1024B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiE4gnDW-ykQ7kNvwFQxIyC&_nc_oc=AdrKcOv7JIMeQ4PpiZILjc8kh1Lr9GHHscREPjpdYdboynF1OYUxzc_XgLxOxpacdm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2DWLkH1z-SOvQ6GLbBRBjoKfDKsO3Mjg2OXfGFcdVug&oe=6AC10AF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/7f300f7a-199f-4d0f-84fe-cc5f25d19420", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "333889428613370"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "386198232685670"}]}, "baseline_offer": {"id": "386198232685670"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1621960620, "status": "PUBLISHED", "id": "386198232685670"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6466990056737695", "version": "0.11.2"}, "id": "2839746609641065", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": 
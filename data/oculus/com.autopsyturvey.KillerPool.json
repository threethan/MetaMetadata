5153078723297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bu0xGqZAs8Q7kNvwHqXHMY&_nc_oc=AdkiW0KBTBZ0qW5vxdBz290iIMHTdTXqI3-MJJ17U_eoCozWwQVIfJJ_329-l0-jASw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsMcb0IYlJ1g-AmDI59tKF9KrpA0prxcLqF0QmMO7UDvQ&oe=69A989CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE_dUn94yDYQ7kNvwFd7hDH&_nc_oc=AdlMGyw0CD98tm3sVyBKiIafPmTevEKFF5Zn3mvADGqn1AXq_WlAqWJwq-2oe54OUE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv9b3FJn9fXwwSJRWDkV6bm2BCGK0onRFiFS5tbw9f_ug&oe=69A973C4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3-XbmHucsMQ7kNvwH2_Z6O&_nc_oc=AdlHD9xzBi3Z3xMZjo3hAWygCPaUvkNRJnN8kkJrRrjpSC4dzw1-lqwMvll4okCHXP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs6B3nUFoK8jdoH2qJ2LVcwd3izy6Q8mYnRzrJiSXtgcg&oe=69A9844B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlvfdejkcaUQ7kNvwG21WyF&_nc_oc=Admy4wp31cd7HWaQyqDR8iUYMDrSVOI0bODG4Lhv-xt4opME_wHiQ9RMG7H9z0xLP34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuiV0gT8vLLaDKESUeusjqLgFSWn6QN1klsjL9khhVrKA&oe=69A98CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sALnXV_A2cQ7kNvwGgChyd&_nc_oc=AdnxBzxVYJ_kmuHLg4z3dRRd7aqd92UKMP_CnObm4EYP4Iy_ZOrtwBoCSjnP3cU9Y-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfthQ8BIM3jX9LvrWo8X_nbux3VAAHw93H367VIC8dXqcQ&oe=69A980BE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
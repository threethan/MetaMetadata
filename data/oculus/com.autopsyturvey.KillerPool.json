5153078723297", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aen8nxIJf7wQ7kNvwFjVBUN&_nc_oc=AdkKPt1MJU-84BC20Y12Wj_qAUbrWA_7sSNFCMCik2cil-lwvX3q9tfeDgSuCMLMKZ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzTcEZ_D28y3LSGVloGb2HOEjFGrNud5OxmDWQvl9rZQ&oe=69BD504F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lafmZx507EQ7kNvwFNjfCB&_nc_oc=Adn5eMVQiWGOWCokOwA0sDeQ2LBkfSjPepHU-SoxpzeVNU4NUrxz6NEdTMsHtb0zZCI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz11nku0CBM3cxDclFjAcROSZTX77NhXaxJGlqxmfoi0A&oe=69BD3A44"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaYumF18Ki8Q7kNvwEZMU1b&_nc_oc=AdkUIb5KXkT49oy1eeMXTomV-xMEqwnv2pMdeQfg_5BvaOSfp9GzRlSCL-yeR-N0UKM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDsSkZJtGyNqXLrm49VPR3EuxSkxl2_cZ8LJgORCcxEQ&oe=69BD4ACB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxdK5W1U4pIQ7kNvwEl9ZlL&_nc_oc=AdnC5SkWAYxAcGM8_oeQfJLf65L2rJxq-7_bfCMPZs-adHiUUJxJG8hbPXYoedmRcp8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfynI-F0RFeSYYpk52BjkFX_u3Yvh5q0Il9HIC28uwutNA&oe=69BD5373"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIh_QBsfINYQ7kNvwGQZHy-&_nc_oc=Adm-uy4L8Qgj2ma0TiiO7U8YiySvlP13KrRXp3UAxX_kyiI4ai7QMSADBdyqF55XFL4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzU6CdMuxHDLY3axulYD_3dNqTRkuSL5EfYC2WqpXM3Rw&oe=69BD473E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
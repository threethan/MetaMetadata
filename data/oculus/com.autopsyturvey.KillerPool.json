04.2021_11-03-53.png", "id": "885153078723297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfmS5ZR6a5sQ7kNvwHAOsji&_nc_oc=AdpxwI2lAR8k7RxsvNzUPSofqWwQtEf6h2SyKVDzV4_FxKRZcvA4ne7OMElKFPEXr2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwe4iKdfjOCR9tg9lb9aWQFl0Cy5cPhkC0ve5x_1tLkw&oe=6A7C79CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OihlU95Ngv8Q7kNvwGdxdez&_nc_oc=Adq_5stVScvgEZMSGkYBIQv4n_-daMXQxcK5DZ7iOa1MNrYuNEQGLLQyfy5TfcdobeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYelfG90hQrh5Xdym0OAJu-3PGcY2dWEeT5wBlqUJhQw&oe=6A7C63C4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYHg37jOvZwQ7kNvwFxlb_x&_nc_oc=AdoyVwURM-B-5aKvgV3a646NOKqhnONIu1qpqvbUyDr4QeGxo_CGdyPCKGwpe--iICY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoLSz13vOIK8C-Bl0ePOT6Ok_TcRwLQs-hhECyDd0Z8g&oe=6A7C744B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifEeGsAcvYQQ7kNvwFvT6Zg&_nc_oc=AdqnWDh_11TKT0WaV81A7jNUx6fqrUrW9SjzRtKIZgGG4KcjgtflObY0j-SIbQLKV4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcg54P7d2ZY5n6rerVWiKk51FlM51TuJ2zU0NKWty3Ew&oe=6A7C7CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsHUdyWW70MQ7kNvwFcIyNq&_nc_oc=Adq57H37J60NrsO5_9i5S4wbA37jqBH_jflNKHZ33kev4NyhCSY7i3DaJBCYh4HlKrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtdVnApP0Y5PxRh0ueBAalHeymENIVHLNE1VICCHXKew&oe=6A7C70BE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
5153078723297", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL7bN0GnEQQQ7kNvwEFxo90&_nc_oc=AdnjFXXTG3IDZ7LzQKcjwTTDhGZUF2QQj_Ydu5VWXsp7dhNGcnshUYCwwQBUuHz4DLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW2g06nkOOWNg31ewI38AJbB7fRJfk7zLX0JAdDWhTGg&oe=69B172CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoW_jlUpb1sQ7kNvwFlQxnN&_nc_oc=AdlqaJ0hOZO4ipclBvnOj7sZpcMyREvk4TTKJ04z8YJ55A4K_zR01KaMDbv0wq528wY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwpq7IyDtC-jKUTcUXdzJnvw8p_4Xk0-pZPy5i0s8z7WA&oe=69B15CC4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kNVZZ6Qa5kQ7kNvwE2z39H&_nc_oc=AdkqttKZ-IwcHJDboQUSLWre4wB45jUu9vANEJclHNJ8Hy369QYdiY-pxfH7KTps8iU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJZAdMS6ArViemqizbprhIJt59zMCLBiOAea9Vnhq_KA&oe=69B16D4B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-cyro89sYYQ7kNvwETvO8v&_nc_oc=AdkfWT4kIVshDeWuaBg55beOen40BNUpJH8GDrPKu3g5jh0okHbb_oHdL1a_nRIVXks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1Bxk1jFgLlpbmDGK_XiOi8SKbuBDw7F1nyd3Th9hJBw&oe=69B175F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2miwXDoso4oQ7kNvwH1uwvS&_nc_oc=AdnPdPZH7BuM7PjX847pd5O-HTr9cylK24h1_oiWLbDfIFSRh5dBGSLGlI1w29jiEcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1YWcoec-YvXgt6u7pd6mUDIKb7uVIicwOn6JI5xTHQw&oe=69B169BE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
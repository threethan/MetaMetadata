04.2021_11-03-53.png", "id": "885153078723297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABEZvgSgDpIQ7kNvwE2uuMy&_nc_oc=Adp6zgPXF183-Q755lSZ_ciBHzlTLvzUFdXDuiGiCeS6Omg_EdWnp4UzadHF0_rpHvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9p-IEoL1LifM3Hqf3bxiVAaVfmF5XWpfI4xY6dPv59yw&oe=6A3FD4CF"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLK6o65srn8Q7kNvwGEsA_0&_nc_oc=AdpsoUGSM4qjFVfpOgJzkmPifblTQ70uh1E3w-ogi2U-0ut194f11Xb1eyYqYAkdDRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9faRN1ciozLXNY-F5ZGMxaX35oBfsM7ScMKAgSzt6HRA&oe=6A3FBEC4"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfNuZwHG7M4Q7kNvwEJ6c9t&_nc_oc=AdoV4Xh-1cm79nq_cYYV0Hhbyc31-5n_NOmDSnaBqSDE3TF0ZnVawpLDfQbmEdt_PRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O1B62UZHL1s9K3ZP3E1OTBlR8iDGgXiXJoEJlZqqIeA&oe=6A3FCF4B"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezC2aRA2r8cQ7kNvwEa2KXQ&_nc_oc=AdoQFr12ks2nz3FvuxDwDwBOPyv-CX7krlWmRFJmuTzIwWN0T30viGv--26RgpV6DqU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k9rNVSjmEladhaEpmmzu65swSZaK9Q7dRk0NwVoPQmw&oe=6A3FD7F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qo4-lp3HSSYQ7kNvwGdvC77&_nc_oc=Adri0frUHCTR9Yea7WEDMAXX13M9BBRh2-J27pAb3UCFJ_fUPVk1bohg563IyLhSVVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ztz6kcT2NflfuEpy0_TiEPSdBYE_LuQEGPr31FO3Yiw&oe=6A3FCBBE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
04.2021_11-03-53.png", "id": "885153078723297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-bnI6ogjssQ7kNvwEZ48TM&_nc_oc=Adrayv65e-0RTfdZhPib8JQFuGxp6h-kg6nyblTDYyyjyTLVKHQU6MLUrHkdK8sgGJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKXENoB0vGJiTCAioeF7AJAstYzfl5zbGmgFQt5Z9sAg&oe=6AA7FB4F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mP5Wu9SMF0Q7kNvwGUjuCV&_nc_oc=AdpgEY0pTCb7nYnRUMvVDP5Ivh-pU8LdkWScX5eKjiDQlbGS44ufR1lAo_7Yt3nmUZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhf-6NRSJ1ltuob7_B1Xm926LRhQhHQfsnS5B5f3F1wQ&oe=6AA7E544"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGsoSKfUYrQQ7kNvwH-Vvt2&_nc_oc=Adrz0Pljo1LhRgQc6Lk2NoDtJY9Hb6DMZl3z1dw_WJkl1Hp3sa-kLMQ91IRZ1uSC5f0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpS9xVezLurMO1E-Y2-2OXLt3jhYBdFji8c3PzxZYghg&oe=6AA7F5CB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXkUXL1f7EUQ7kNvwGdNZ9b&_nc_oc=AdoTCRe4B2n5bMmxwtVA59YpvsjlvXMKIhDxrYKuOmfmEgUit7yhs-bQEnqWOodRYqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG8MPVF-OFUga1MztJ4kEj7HJU2aU_hAxUgZH_oxBjUw&oe=6AA7FE73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmHAWJezKQcQ7kNvwE0cjYZ&_nc_oc=AdoV4QuUgVeNkh9JEBaJSDWTrxhbNYccUuCaK8Rp8nbkaJ_kJRE4ZMUJQ7zFf7sW730&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItmtng7stl--oTb2MRQ9ZAhDsHTXzpdYIpJtEhJKzxBw&oe=6AA7F23E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
WzM3FpDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN_s2qRZ0SNo6_6cxO3B0HvaolmYrkI_qmhMBHq9dpcA&oe=6B032E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxU9Va9DMO4Q7kNvwGQGF2R&_nc_oc=Adpxzj9j0sZFwQAVLGPZ6dYqPAaMWWdIhJfnBarT7f4uAeHYVI6DEj9uciLcyBiiFwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwJid-MxslicyxWdm2K0JOOjA3RPgiix-e9qlYUW486Q&oe=6B0321FE"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
5153078723297", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001730_885153082056630_4942615532652120797_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK7heN-wFywQ7kNvwECkido&_nc_oc=Adl1LCmkKaA2-2S10lEp3P0ggk_atY8NsncUvt_-5GxCxpWGc6i1TxxoFp_uns7irYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0MaFPoKLVIFM6CcLsRdgVcQ0rFRpMIUH9pY1IK1fmdA&oe=69B80A4F"}, {"file_name": "PractiseVoid_1140p_05.04.2021_11-04-26.png", "id": "290028462524307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_290028465857640_5082326582677288872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a63etWwSuu4Q7kNvwHF0JEy&_nc_oc=Adks_fC78Bf1QWcYrBqYB1q44XiRdFfHUydl3xOW24jlH8FFpatvpSOiM5emJoRyL0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVJ6qm1veISoelljbMyU45ajWfwnazchTo94bSCx30-A&oe=69B7F444"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-12-38.png", "id": "270387334628586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_270387337961919_744330891563351612_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so4fnhh4KNIQ7kNvwFQjKNE&_nc_oc=AdkXdvSTZSYDdJ8Pog6GNr4gcviBkeyYmC5e_Xa9WroebMzLwbUSeeVrt35v_VkR4kU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVXF2vdAl9WxivOL22ef13dvay9FCZkzKFL3gqsEPmOQ&oe=69B804CB"}, {"file_name": "WesternSaloon_1140p_05.04.2021_11-13-04.png", "id": "925220511351507", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974809_925220514684840_8725030433769001458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYsOz5mLY6QQ7kNvwGiZ9GE&_nc_oc=AdkmFgKX-B3gX6Gev7tFQAheXjkMXzpnda2OrEuSerlAmH9UVst9DSnxw1EjSNyogw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1f88r-mbZNb0JZIotFAiHKAdpGl6o7mntvlJm9WgDtQ&oe=69B80D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00201.png", "id": "180931617298352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035375_180931620631685_5831597170155586588_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf2ejVQvmHEQ7kNvwFH1qQK&_nc_oc=AdnEcGlnq0WLwkwQcz1iKAGtLARiaLXgS6zJua0bWU3HXJ-1Tg5dYhPn3QgVFMIQOgA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGkKSXC7_jV40Ajy8iyTJbZDNICp0DYxKQ6fhraq8T2A&oe=69B8013E"}, "display_name": "Killer Pool Preview", "keywords": [], "long_description": "This is a preview of an in-development pool game.\n\nIt's been built especially for Oculus VR and lets you step into the UK pub pool scene.\n\nIn this preview, you can practise on the small pub table, nicknamed 'The Matchbox'.\n\nThe full game will feature winner-stays-on EPA rules & Killer Pool, plus more is planned for the future.\n\nI hope you have fun!", "short_description": "Step into the world of pub pool!\n\nPut your name up on the blackboard and wait to be called up. Winner-stays-on EPA rules and party Killer Pool await. *\n\nInstictive life-like cueing controls let you forget you're playing a videogame. You want to hit with spin? Hit the cueball as you would in real life to get the spin you desire.\n\nFeaturing an 'IRL' surface marker in-game, allowing you to rest your bridging hand on a surface for shot making."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1HrGRstOVIim6rS6fSoD9CLEdEy5yTj8OC5HVSLTn2iI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ric Haines", "support_website_url": null, "website_url": "https://killvrpool.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
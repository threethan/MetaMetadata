-141013.png", "id": "2565810783797590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617847_2565810787130923_3422489220127060573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz_7QpmkgDgQ7kNvwFOgH2o&_nc_oc=AdpaiBo6cVw7T4yp3Xy60RHoty_-wDrZmuTs63YgvaJWv0WlcTMptn0eWH_8kE5LXwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3weqrsveIqtNOJ3GAfAjLk09Vp6xui7Yuc8ONORAdziw&oe=69E37658"}, {"file_name": "com.eldc.xrclabsidev-20251029-140940.png", "id": "1361823822123123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824202_1361823825456456_5962629645520741527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZfaLxY4KPQQ7kNvwGxJhbR&_nc_oc=AdprCsO-tzYaqv4JMgxJvOo_CnBawFMV8N-QgK_EQaWNyPWTltsoJI-N2Q3fqZKeE1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HQrzIp5ZT7F5ksPjISA9kbjAqZwkSQDMHvGF4bMpQNw&oe=69E3784C"}, {"file_name": "com.eldc.xrclabsidev-20251029-141428.png", "id": "1701599610537395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1701599613870728_6395694078751923177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO20Hdsh5MYQ7kNvwFIzV92&_nc_oc=AdpRv-HtQ6pqiE-mRDFJxxQrma_WsH8_LyfnSSm9B7ZYHngdM1vNdLieBcgPOILo9qQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fMJAH5VfLP_IUNRlYZaa0Dm82enFbMrD6294wkBxqew&oe=69E395DD"}, {"file_name": "com.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mywp_JqnZcQQ7kNvwH_WnQ3&_nc_oc=AdoFDgd0XW3RJbB9JIh23oIZ6jpAfLOAFLACpVyHq0EsOv5WnUHyR3Dracm4q75m7Cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u4yCve7OFtRN48z5f8Px_MHfVCpaK0fQ273QdCXs2tg&oe=69E364A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24844500745234879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1142751
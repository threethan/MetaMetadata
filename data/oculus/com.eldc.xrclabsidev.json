.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaLtEK-fOwYQ7kNvwE3tujS&_nc_oc=Adqqm0A3QFkSYubnB-fK9W3ipJ53C_BlK5IkmNr7jHPGmPJmAF4UMlyyioI7hD8M5Mg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vyj860w5QKWwC2kJpZZoorO3b_xIBFHUgMJwFB_lRJQ&oe=6A0C7B68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "47808930179
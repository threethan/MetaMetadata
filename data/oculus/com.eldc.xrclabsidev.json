l, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24844500745234879"}, 
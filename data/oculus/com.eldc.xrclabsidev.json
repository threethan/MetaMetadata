-141013.png", "id": "2565810783797590", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617847_2565810787130923_3422489220127060573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmzwKx4sOnUQ7kNvwGsZH0K&_nc_oc=AdprDeQ_cZmvUKdCmp7Wf8FfGUmlWGqn5NAbcmrwIIVtLKZPvlaCs95gZlL-u0UgyXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-_AIaEG55YKN8WC8kT3_k_MMAg_S1N5AxKzWM6Awe8g&oe=69D64758"}, {"file_name": "com.eldc.xrclabsidev-20251029-140940.png", "id": "1361823822123123", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824202_1361823825456456_5962629645520741527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC7wYhWBgRIQ7kNvwEOzzWu&_nc_oc=AdoQyuK3Ua393Q0RU6f_QwgqXKHlqQlFnDcZPKXjQnpTtygHy41BdegyCnt1P0BbWy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hZ-KGOGACzQ94FFaKuzcutIk88rL4BfNHo4DSM3BH1A&oe=69D6494C"}, {"file_name": "com.eldc.xrclabsidev-20251029-141428.png", "id": "1701599610537395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1701599613870728_6395694078751923177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wRRk3_ylZMQ7kNvwE6JR-Z&_nc_oc=AdqFBIQY4clrfPOKZGWyq1D_KXjf8Q4OGNZfjU7caOxuRP_0ctdvs1hhe9N7C2C_FE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zMCM4m0i4OS6PN2ubzeHJSDrRMh32oysiTZoeckghcg&oe=69D666DD"}, {"file_name": "com.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWhL-r4MciwQ7kNvwHDzdJb&_nc_oc=AdolW8iwCwF8-wY8P4ufbuYCDLUyjm1KH7bN2we0vcHrXp_eFlVIWSCdcX5u-1n-Ex8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24DaxIiDhTw73R4QdE1Lxk40G6woE3JPyenphAqigCBg&oe=69D635A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24844500745234879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1142751
-141013.png", "id": "2565810783797590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_2565810787130923_3422489220127060573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz_7QpmkgDgQ7kNvwEP82zt&_nc_oc=AdraJdXf64ZvnM6Ay3WW6nj7bSFH-UIszR9LfkQOdm_wF_CCQon4oxtkZZQkwRNZhYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NDky00gyYGWbtFJ_qbe4GnKL5gRe2stug8hiGzIwwow&oe=69E0D358"}, {"file_name": "com.eldc.xrclabsidev-20251029-140940.png", "id": "1361823822123123", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824202_1361823825456456_5962629645520741527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZfaLxY4KPQQ7kNvwH3G7bp&_nc_oc=AdqMF-2WeuwZ8GDik8iarA9hYFnm8a76FVOf2sm--KyD5HCtvRWfH05BlmEMFOKOVjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0STEjhyj5tUTXbZFGC1ljJHNm-A0husAeVs-ta2KAdTw&oe=69E0D54C"}, {"file_name": "com.eldc.xrclabsidev-20251029-141428.png", "id": "1701599610537395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619805_1701599613870728_6395694078751923177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EO20Hdsh5MYQ7kNvwFX_lcI&_nc_oc=Adr2nVl0P3qIAsv8qKmEpcAwd2XuqU-LNjB8eMnLJdQkReUWwNquLqNvIt7tGXvTyNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WSx9F6dDHgx6naTNcnV30L_BuhdKxInnKNUJ8TPL05Q&oe=69E0F2DD"}, {"file_name": "com.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mywp_JqnZcQQ7kNvwEItIm-&_nc_oc=AdoXrWPvy6SCD_4CvYbBPVNidBVeBDcYB_LwnbAakRs_dvnUdq0Xa0bbAVywZiHZXg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zKCFcxXZnipn_H2Q8LbXRHRztG9C4ytxKIJp6WHU3uA&oe=69E0F9E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24844500745234879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_1142751
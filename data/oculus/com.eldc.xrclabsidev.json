yQ&oe=69AAC5D8"}, {"file_name": "com.eldc.xrclabsidev-20251029-140940.png", "id": "1361823822123123", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824202_1361823825456456_5962629645520741527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_GR5SHgK0IQ7kNvwGqh7_1&_nc_oc=Adm0sFsAWBgMfHKqU-v7WYvYvSx15zcyAYGQG6OP8aqaeai3PK9bp_kwMnmG2WqG8KI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZZ7fBJqnSW1OSr4DNX_oYt4hO61IMlZKqRK5jbNrimA&oe=69AAC7CC"}, {"file_name": "com.eldc.xrclabsidev-20251029-141428.png", "id": "1701599610537395", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619805_1701599613870728_6395694078751923177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEKodWdwqB4Q7kNvwGdVFxr&_nc_oc=AdkwElFDU7ARAst5qmzl0ZQ78FRBxColNIDx3muWPmhkJ4eDtrFWwu6SnT19AUd3TfM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAOrOBT1qBAdJnWPMsrNzng4114i7pZjXNYtQYRfmdRQ&oe=69AAE55D"}, {"file_name": "com.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzFAWf-ZOLoQ7kNvwFN_oZu&_nc_oc=Admfjr4fVTHyWdXzoirqFTy83teW74agaL0XI4WRSGSmnS9nxxhW-HEHk1ae4SpRz-8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgupWFO6E0fqowVRqj6O9cHJ2LeR0wY1dse4gNUhrlwQ&oe=69AAB428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while 
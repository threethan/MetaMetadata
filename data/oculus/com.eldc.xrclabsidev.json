69A97458"}, {"file_name": "com.eldc.xrclabsidev-20251029-140940.png", "id": "1361823822123123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824202_1361823825456456_5962629645520741527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_GR5SHgK0IQ7kNvwFkGB5w&_nc_oc=Adk3tNIKil8n6wAqOViVsmUfrVn1z4kkHJOM3cc4XX4pOxbryn-meL8VgmY3QBpNzkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afsiiyn2getTYUdWqgtGV-ZfDtKOyrChfePY4z6Dolxg2A&oe=69A9764C"}, {"file_name": "com.eldc.xrclabsidev-20251029-141428.png", "id": "1701599610537395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_1701599613870728_6395694078751923177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEKodWdwqB4Q7kNvwHTlYyb&_nc_oc=AdnMP_OzOPkccNEGKyLOwn1Zay1zi5K8n9gZQIB3SB9aythu6_pyumXNnNZKXGFd068&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftBF_URdF5FL6WOjkYzZcQx7br7Pk_-U28nDSZAb7IfAQ&oe=69A993DD"}, {"file_name": "com.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzFAWf-ZOLoQ7kNvwFPeRyH&_nc_oc=AdkwU6mqiSfVr63wUa-rdM51mQfU8xlwZYySOcKM-ny2MTvJf7zrpER98uTMn8W-AII&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfulzVjTtr2PpayN4l5A1U1qAwWckAwSdgZ-m5Q321f7zw&oe=69A962A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24844500745234879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_1142751237494956_574727085840931009_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InVKEjN2nn8Q7kNvwF4ZVax&_nc_oc=AdmSqHjtqezO_59FsAZ2bOW785NYagw_Sr8SfUTybby-GUI3muH8wq0sWhrx-12CuVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afve9ZISZVT8PanYir4N4MAXSmHYZ3IRcvPLPvDNWV4qfQ&oe=69A96AC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CLABSI Prevent
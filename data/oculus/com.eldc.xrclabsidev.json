-141013.png", "id": "2565810783797590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617847_2565810787130923_3422489220127060573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGuLnnG5y00Q7kNvwEzQFEE&_nc_oc=Adrh39siuJr3OFY5eYk9tESpjXyUK6K8nxRjokbxCeI848Zrrn_e-ZggVtzzgvKya80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06g1TmhdULKzU9JlMl2nUV-A7zeLndAHPAmTpThppFQA&oe=69DCDED8"}, {"file_name": "com.eldc.xrclabsidev-20251029-140940.png", "id": "1361823822123123", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_1361823825456456_5962629645520741527_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEfWpNEk4f0Q7kNvwFfvRmi&_nc_oc=Adru8vJjO2loAT7DFsLerOGKsRMslVkD24lKpv4KgVHLd9fDTqpm3P5YuTxW3o4efnM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af290O-7VyGW-KoP2HYhYPaZXT5CyP_nv7xQfgZSnRIjdw&oe=69DCE0CC"}, {"file_name": "com.eldc.xrclabsidev-20251029-141428.png", "id": "1701599610537395", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1701599613870728_6395694078751923177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0FY0R1bOLQQ7kNvwE9D84J&_nc_oc=AdpSeRci6gtoThfPLG4nnKVCvnS7oRUG8V4ebgrNkMSBkuJqCaaYZC1YUDaSRkYIXRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cfaYW1D-5ZWTexd_r-7Iz2umU4AN84Uqqjt2sPG2LwQ&oe=69DCFE5D"}, {"file_name": "com.eldc.xrclabsidev-20251029-140925.png", "id": "1149179430129546", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617729_1149179433462879_2331928366779294436_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGSzdsjxcUEQ7kNvwEViZg2&_nc_oc=AdpeTO2Im65xrioVInX7ykAHKtzZ9aQ4A19k1Gjeo6_YhcHGKhCl94Iv0ObFHrSo-js&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tiZ0RsS3U_vzitvGBcahyz0oDcHF5Sgv9G6EhH9LvYQ&oe=69DCCD28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLABSI Prevention", "keywords": ["Clabsi", "Medvr", "Medical", "VR", "education"], "long_description": "CLABSI Prevention is an interactive VR training simulation designed to teach best practices for preventing Central Line-Associated Bloodstream Infections. Trainees engage in a lifelike clinical environment where they learn the principles of aseptic technique, proper catheter insertion, dressing changes, and line maintenance. This immersive module reinforces infection control protocols and procedural accuracy while minimizing risk through realistic practice. Ideal for nursing and clinical staff, it offers a safe, repeatable, and effective learning experience aligned with healthcare standards for patient safety.", "short_description": "Immerse yourself in a realistic VR training experience focused on Central Line-Associated Bloodstream Infection (CLABSI) prevention. Learn evidence-based techniques for aseptic insertion, maintenance, and care of central lines through interactive, hands-on practice in a safe virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24844500745234879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618444_1142751
udience.\n\nZoom in, rotate, explore inside, or trigger animations to highlight key features and technology. From simple models to complex systems, the Visualizer helps you tell the story behind every product in a way that\u2019s clear, memorable, and impressive.\n\nPerfect for sales, marketing, and training - in the office, on the go, or at trade shows. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://svarmony.com/salespad-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "svarmony Technologies GmbH", "support_website_url": null, "website_url": "https://svarmony.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24135704259438563"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827611_821482030840600_5972624257222176390_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95-FWqLWf_EQ7kNvwEz355Z&_nc_oc=AdpfPqRHCSgEDLEs8NuQB2JgPeAr78QJ5zyZTOtcfDe11oRM8vew3WBommKSGO2mrwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA2OGs5f-pXjEDo4VI-8t2vUWhEAguoOqpMmupcB9B4A&oe=6A50F46C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SalesPad", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name":
_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILFJmTFgXeoQ7kNvwHgrX4z&_nc_oc=AdpJkBBiKdVom08KRs2whEGcXdnoA7_kru85yjkuy7Ica__utv1N1tTmym3LnWir8ZQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToN4TCLvsFykXgh4NRd4NTNxD_ToweY1r36LR6reWg6w&oe=6B09CE6C"}, {"file_name": "3.png", "id": "495197192018724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974472_495197195352057_4020094719529687434_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0bX1nxqmAAQ7kNvwE5H7gJ&_nc_oc=AdrAew_BBHDePE6WqKoYw-DG08-RbJwMGzCv8E7xL_qtJ7T07rifPJTmalrNj2vX5JI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz3eYE8SG_RO3d7Z0J0-1FhYWV4rF9lE0mzhgadBljoQ&oe=6B09AC94"}, {"file_name": "2.png", "id": "482402850259813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031368_482402856926479_5539295069090890388_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIarchlf5BIQ7kNvwEw2Jgm&_nc_oc=AdqzLh-563pglAcBMH7O_s5R1Vgb7LkeZeR48ZCeml46ppBlhv9jmYcQc-3OObHd29I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPMqWHxnuj9wyZx9G4J_Ew0xrXQA-pL3JAwBBi8PZIcQ&oe=6B09BFA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Checkers", "keywords": [], "long_description": "Welcome to Westworld!\n\n What say you to a \"civilised duel\" where you are the guest? Imagine yourself in a pleated shirt and a notched collar-styled waistcoat covered by a suit made of brushed fabric, a fedora sitting on your head. You may walk into a tavern and order an old pot, preparing for a match with your old friend in the free and wild west. Besides that, could I tempt you with an exotic rendezvous with our AI hosts? But can you tell if she's real? Or does it matter at all? \nMy advice? Ride on!\n\nFeatures\n- Multiple AI difficulty levels available\n- Dueling cowboys in the Wild West\n-  Detailed & beginner-friendly instructions\n- Retro UI design \n-  Undo function\n-  Excellent experience with controllers\n\nIn addition to traditional draughts experience, we will provide rich VR features, including: Online mode, better interactive experience, various scenes for Checkers, real-time voice chat, Checkers with friends, AI hosts with different characters.\n\nDownload it now", "short_description": "Welcome to Westworld!\n\nWhat say you to a \"civilised duel\" where you are the guest? Imagine yourself in a pleated shirt and a notched collar-styled waistcoat covered by a suit made of brushed fabric, a fedora sitting on your head. You may walk into a tavern and order an old pot, playing draughts with your old friend in the free and wild west. \nFeatures\n- Multiple AI difficulty levels available\n- Dueling cowboys in the Wild West\n-  Detailed instructions\n-  Undo function\n\nDownload it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://checkersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SUPLIFE PTE", "support_website_url": null, "website_url": "https://checkersvr.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468757508092274"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "1670215410775176"}, {"status": "PUBLISHED", "id": "1257415419906885"}, {"status": "PUBLISHED", "id": "162704596183907
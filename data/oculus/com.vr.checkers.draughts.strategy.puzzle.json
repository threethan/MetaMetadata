-25/39035378_766895197724117_5826250079828147238_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbH-8hTJSS4Q7kNvwET_e6s&_nc_oc=AdpdSdjFu6wbcH84stQ_J9HQN8bczUonmpSjVrnQU82dCPHGUs1STZjylFTLNYx5ipc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUiPvvgOa5Uuj4Q5FbvE2fpMeT8e6ufvpGO8e24O1QMwg&oe=6B0F0593"}, {"file_name": "4.png", "id": "700726114580090", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031317_700726117913423_7631659866029075490_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMoipPeHhfMQ7kNvwHSwrm4&_nc_oc=AdpId9rBxuCEvPEsiYwjq6Uj0BkYUj1FPskS4jI-X3LiB9ESBktR4-oChy4thAPaZTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUFBo9qMqFGEXA_4xsUPBzDdKp241npDDlWpS68mR6U2g&oe=6B0EFB94"}, {"file_name": "3.png", "id": "372051224815139", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982584_372051228148472_2522663355656257653_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTTJREF76_IQ7kNvwHYRuso&_nc_oc=AdrSypQCrXRVFag5DwtZS-G8r4iiut75VCLnThFuRR3MQi0OeB9wJN1iV7oltzTwDRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1BMUKb4uxA6-iDo2QuoeFeZmDwlwL3JiQbdShM4bX2A&oe=6B0F226D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "689962698870951", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572933_689962702204284_6630759362788192801_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PaS3FsFEFMQ7kNvwGeu4Xa&_nc_oc=AdoopQX5rKplmx8PbB9PhyOBr7nSFAj0WSJIzwNzn6FTiNB6GrHrOyAWaJ83Fn7kQWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFz3UQYPyW3E8awNPFu_-MxVt0UWGDxo9wkiTbPYkxdA&oe=6B0F0886"}, "display_name": "Checkers", "keywords": ["chess", "checkers", "tabletop"], "long_description": "Welcome to join the Journey through Time & Space in Checkers!\nYour journey starts on the spaceship, Checkers VR, afloat in the vast universe. The next stop is a pixel-styled anime arena. Onward, you are now in shining chaps and pleated shirt covered by a notched collar-styled waistcoat, a \"Stetson\" hat sitting on your head. Go explore and discover the free and wild west where you can freely utilize all your talents for designing and DIY exclusive piece models. Join us in this new journey now!\n\nKey Features:\n- Multiple Scenes: West Town & Spaceship & Pixel-styled Arena\n- Multiple AI difficulty levels available\n- Detailed & beginner-friendly instructions\n- Retro UI & Comfortable Interactions\n- Support Undo. No more mistakes!\n", "short_description": "Welcome to Westworld!\nImagine yourself in a pleated shirt and a notched waistcoat covered by a suit made of brushed fabric. You may walk into a tavern and order an old pot, preparing for a match with your old friend in the free and wild west or the new pixel-style arena. \nUpdates\n- New pixel-styled arena \n- Animations for pieces\nFeatures\n- Multiple AI difficulty levels\n- Dueling cowboys\n- Detailed instructions\n- Retro UI & Good Interaction\n- Support Undo\nWe will support more features in the futu"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
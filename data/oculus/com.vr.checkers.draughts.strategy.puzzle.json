n.com&_nc_ss=7f20f&oh=00_Af1Btp9dhzcx2uDlDHTufeFJBQQcVlCgU1jco1d_pL0MzA&oe=69F49954"}, {"file_name": "2.png", "id": "482402850259813", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031368_482402856926479_5539295069090890388_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEdgtW1WoUIQ7kNvwE4bp6L&_nc_oc=Adr5omZv_8756XIs_0oVJXqfReLC7kcyOwMlBPIPcr3WudO7wCNfNldoUU-_l1DXxO8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pIt5jHhPsO7NTcxwzISuGJ3fyQxWKhQQQX1rXDxLc7A&oe=69F4AC68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Checkers", "keywords": [], "long_description": "Welcome to Westworld!\n\n What say you to a \"civilised duel\" where you are the guest? Imagine yourself in a pleated shirt and a notched collar-styled waistcoat covered by a suit made of brushed fabric, a fedora sitting on your head. You may walk into a tavern and order an old pot, preparing for a match with your old friend in the free and wild west. Besides that, could I tempt you with an exotic rendezvous with our AI hosts? But can you tell if she's real? Or does it matter at all? \nMy advice? Ride on!\n\nFeatures\n- Multiple AI difficulty levels available\n- Dueling cowboys in the Wild West\n-  Detailed & beginner-friendly instructions\n- Retro UI design \n-  Undo function\n-  Excellent experience with controllers\n\nIn addition to traditional draughts experience, we will provide rich VR features, including: Online mode, better interactive experience, various scenes for Checkers, real-time voice chat, Checkers with friends, AI hosts with different characters.\n\nDownload it now", "short_description": "Welcome to Westworld!\n\nWhat say you to a \"civilised duel\" where you are the guest? Imagine yourself in a pleated shirt and a notched collar-styled waistcoat covered by a suit made of brushed fabric, a fedora sitting on your head. You may walk into a tavern and order an old pot, playing draughts with your old friend in the free and wild west. \nFeatures\n- Multiple AI difficulty levels available\n- Dueling cowboys in the Wild West\n-  Detailed instructions\n-  Undo function\n\nDownload it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://checkersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SUPLIFE PTE", "support_website_url": null, "website_url": "https://checkersvr.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "468757508092274"}}]}, "scheduled_offers": {"count": 22, "nodes": [{"status": "PUBLISHED", "id": "1257415419906885"}, {"status": "PUBLISHED", "id": "1627045961839071"}, {"status": "PUBLISHED", "id": "2130565027773930"}, {"status": "PUBLISHED", "id": "913978747862241"}, {"status": "PUBLISHED", "id": "3205689996273409"}, {"status": "PUBLISHED", "id": "842579201788818"}, {"status": "PUBLISHED", "id": "4100790666827621"}, {"status": "PUBLISHED", "id": "1667077514002858"}, {"status": "PUBLISHED", "id": "1037222574959806"}, {"status": "PUBLISHED", "id": "2578697722329299"}, {"status": "PUBLISHED", "id": "1101181691533350"}, {"status": "PUBLISHED", "id": "537261028770883"}, {"status": "PUBLISHED", "id": "512068807233628"}, {"status": "PUBLISHED", "id": "587993119777739"}, {"status": "PENDING", "id": "611515967003007"}, {"status": "PENDING", "id": "1204321320371803"}, {"status": "PUBLIS
scdn.com&_nc_ss=7f20f&oh=00_Af_0zhTLo5lhO2206cp1o2HI4sCvokXyewiTk3fu9J86zA&oe=6A2C0B53"}, {"file_name": "4.png", "id": "700726114580090", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031317_700726117913423_7631659866029075490_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjCwmXxFWQoQ7kNvwEqcBHV&_nc_oc=AdpuaSu4Xf1CMwexQgGfPfuz5BVTZC4brVX5Pb8qsAXMP5oRXRUcACLFcmdDdBwTsrk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bM3mG7kfvZ_yvUFHhre8LqrE9ZPxj4XS1n4PwKK_g_g&oe=6A2C0154"}, {"file_name": "3.png", "id": "372051224815139", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982584_372051228148472_2522663355656257653_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHPXnxOb5d8Q7kNvwHWtVun&_nc_oc=AdpyViW3PFravQpM_Bz4959vqF10Wi4U8pbMrIyqGucVBta57D9MgNljFK8uOMKlJyo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iYWO9EyifQDVgSXuLa2U9uJMjNJnRtKOaUTmouB-2vA&oe=6A2C282D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "689962698870951", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57572933_689962702204284_6630759362788192801_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdK6OOw_GtsQ7kNvwEUYZWO&_nc_oc=AdoGz0BHer8hE1cTylgTIkWmM-DWV0eeD3iJEhp4LU-QAIaDIap-6sVR9DbxoPq3pDY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GWiTAl8AK-1oA8hqMe9NdmHJTnYgwurT66CqpHAkchA&oe=6A2C0E46"}, "display_name": "Checkers", "keywords": ["chess", "checkers", "tabletop"], "long_description": "Welcome to join the Journey through Time & Space in Checkers!\nYour journey starts on the spaceship, Checkers VR, afloat in the vast universe. The next stop is a pixel-styled anime arena. Onward, you are now in shining chaps and pleated shirt covered by a notched collar-styled waistcoat, a \"Stetson\" hat sitting on your head. Go explore and discover the free and wild west where you can freely utilize all your talents for designing and DIY exclusive piece models. Join us in this new journey now!\n\nKey Features:\n- Multiple Scenes: West Town & Spaceship & Pixel-styled Arena\n- Multiple AI difficulty levels available\n- Detailed & beginner-friendly instructions\n- Retro UI & Comfortable Interactions\n- Support Undo. No more mistakes!\n", "short_description": "Welcome to Westworld!\nImagine yourself in a pleated shirt and a notched waistcoat covered by a suit made of brushed fabric. You may walk into a tavern and order an old pot, preparing for a match with your old friend in the free and wild west or the new pixel-style arena. \nUpdates\n- New pixel-styled arena \n- Animations for pieces\nFeatures\n- Multiple AI difficulty levels\n- Dueling cowboys\n- Detailed instructions\n- Retro UI & Good Interaction\n- Support Undo\nWe will support more features in the futu"}]}, "developer_name": "Mastery VR", "developer_privacy_policy_url": "https://masteryvrstudio.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Mastery VR", "support_website_url": null, "website_url": "https://masteryvrstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9483649418316680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57575363_1099636790976638_5163978437600750921_n.png?stp=dst-png_s360x360&_nc_ca
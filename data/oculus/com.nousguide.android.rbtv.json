. \n*Watch hundreds of streams of festivals and music like Primavera Sound, Lollapalooza, EDC, Bonnaroo, Roskilde, ACL. All the festivals you want to see, all at your fingertips. \n*Keep up to date with the latest sports competitions, F1 and WRC racing and many other events through live streams and catch-ups. \n\nVisit us on: \nhttps://www.redbull.tv\nhttps://www.facebook.com/RedBullTV/?fref=ts\nhttps://twitter.com/RedBullTV\nhttps://www.instagram.com/redbulltv/?hl=en", "short_description": "Go beyond the ordinary with exclusive videos & live events from around the world"}]}, "developer_name": "Red Bull", "developer_privacy_policy_url": "https://www.redbull.tv/privacy", "developer_terms_of_service_url": "https://www.redbull.tv/terms", "publisher_name": "Red Bull", "support_website_url": null, "website_url": "https://www.redbull.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "ADVENTURE", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "624819295475356"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "566376467062374"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1529945700, "status": "PUBLISHED", "id": "566376467062374"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3629062187123248", "version": "4.5.7.0"}, "id": "2113418965554944", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "An
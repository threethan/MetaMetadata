kYiE1cxUdTzwjsirMs5C4fLFyuUT6j9Tr99bOBuQ&oe=69F214F8"}, {"file_name": "migrated_image.png", "id": "577053009561967", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12386401_356445274859639_1111025043527172096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-37bZ5J3T3gQ7kNvwGM23_e&_nc_oc=AdqmsSWWBkE14hTrFoadgF7pefinXTOfrOujLJ5BDZBeD9BYDLOMQQmMWGIVN37kLXo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2ymCrlie4auvGAH5awWuG45R_2KiMdVIBSYZtrvbUPQw&oe=69F1E5BB"}, {"file_name": "migrated_image.png", "id": "147464466541505", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12386401_235739080504095_5843810181716115456_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRBYZdHIYU0Q7kNvwG7NRCw&_nc_oc=AdoPgoXEVH9SgQPYpr4kPwfCNWpExFvLyTT0qS9xbCLZi5DjvUhkvJm7oysBeQ4HZJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13dtccC4nLk0zxPDhAQS2B0pWYtlZUM5Dqv9Fdk-qERA&oe=69F211B6"}, {"file_name": "migrated_image.png", "id": "250386925974977", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410200_1620289971359907_6132194854567936000_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yU1RbalWkpkQ7kNvwG2_11v&_nc_oc=AdoSEgViSlwNY4YqUNi7GLNSR-zKGGzIYJEJ6GFyThOEOViuQpYv4r6auEaFKkOP-oQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1fnEGbiu-RinSVvDqBrXBTng_7_ORcy8rtucij07Cjtg&oe=69F20706"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Red Bull TV", "keywords": ["live", "sports", "entertainment", "redbull", "gopro"], "long_description": "After June 15th, 2023, the Redbull TV app will no longer be available on Go.\n\nWelcome to the world of Red Bull TV, giving you front row access to live events, the very best in action sports, the hottest new music and entertainment and thrilling videos from world adventurers. \n\nFeatures:\n*Browse channels at your leisure such as Music, Snow, GoPro, Bike, Water, Esports and many more. \n*Watch hundreds of streams of festivals and music like Primavera Sound, Lollapalooza, EDC, Bonnaroo, Roskilde, ACL. All the festivals you want to see, all at your fingertips. \n*Keep up to date with the latest sports competitions, F1 and WRC racing and many other events through live streams and catch-ups. \n\nVisit us on: \nhttps://www.redbull.tv\nhttps://www.facebook.com/RedBullTV/?fref=ts\nhttps://twitter.com/RedBullTV\nhttps://www.instagram.com/redbulltv/?hl=en\n\n*This app requires Oculus TV. Please search and download Oculus TV in order to watch Red Bull TV.", "short_description": "After June 15th, 2023, the Redbull TV app will no longer be available on Go.\n\nGo beyond the ordinary with exclusive videos & live events from around the world"}]}, "developer_name": "Red Bull", "developer_privacy_policy_url": "https://www.redbull.tv/privacy", "developer_terms_of_service_url": "https://www.redbull.tv/terms", "publisher_name": "Red Bull", "support_website_url": null, "website_url": "https://www.redbull.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPERIENCE_360_NON_GAME", "MOVIE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_EX"], "id": "489804355873995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12522302_1987268728204918_1675924495489040384_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqUTxF7gU9gQ7kNvwHSmFX-&_nc_oc=Adr1ExpKpb9lHPn6GYLk-hKtchvGRAfU9slpzdcE1qoTq1NzGmsUyxHQC4U7FUaYacc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32NCGH2
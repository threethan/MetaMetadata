355MieH7yxn8w2MAc0CMXR-E5sml8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9E1s_YX5AsMwKQqB9ZFUl4sc_MQjkNyfDg7owBviW1g&oe=6B0331B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Red Bull TV", "keywords": ["lives", "sports", "entertainment", "redbull", "gopro"], "long_description": "After June 15th, 2023, the Redbull TV app will no longer be available on Quest.**\n\nRed Bull TV allows you to enjoy unrivaled access to sports events, esports, music festival, films, videos, documentaries and shows from locations that span the globe. Now supported on Oculus Quest, Red Bull TV takes you beyond the ordinary with high quality on-demand and live streams. Discover music from trend setting artists, watch live events with top athletes and follow globetrotting daredevils to the most exciting corners of the planet. Browse channels at your leisure such as Music, Snow, GoPro, Bike, Water, Esports, Motorsports and many more. Whether you have five minutes or five hours, Red Bull TV is ready to entertain you. Anytime. Anywhere.", "short_description": "After June 15th, 2023, the Redbull TV app will no longer be available on Quest.**\n\nRed Bull TV: beyond the ordinary live events and videos featuring inspirational stories covering sports, music and lifestyle entertainment. Anytime, anywhere."}]}, "developer_name": "Red Bull", "developer_privacy_policy_url": "https://www.redbull.tv/privacy", "developer_terms_of_service_url": "https://www.redbull.tv/terms", "publisher_name": "Red Bull", "support_website_url": null, "website_url": "https://www.redbull.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
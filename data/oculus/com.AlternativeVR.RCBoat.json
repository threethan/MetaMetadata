7kNvwGi6aof&_nc_oc=AdrLRWWeRtS7iWbq4J0Mi5fPYwN8K6ufitF2dMfL-EJTahbMLV95uahY2Jmyzb4Guo4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16aIrS6mw1e_5Rfb7WqXMJnKn9IlqNiscu44N9NDl2vw&oe=69E621CA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_avgkq2gp4Q7kNvwFryA4x&_nc_oc=AdreDhlDcUzPHWUwS-MrOyh88O2yt-dwxB-1G6I_ddwKDeHSqmvQPlZVz0yNEhYbuig&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RI14WZgdpkNrcxFanlyup9djFAVfGi_6N2HDXCcwCWQ&oe=69E63956"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D7a86WHBYcQ7kNvwHr-YOM&_nc_oc=Adril8uhcSCp5vWfh7v6iVkgzU1YGn2X2FP6b60YsexMpZj3RonjHjtZcUJfSwCzJ9g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-1psf9M8KPZEnF_6VtHo_AHgwGLzDWlEwEhnIO41p2g&oe=69E62AF3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMZWkWby1DgQ7kNvwHeYIQA&_nc_oc=Adoqll8co9tk61CRg76ZQPVDju0JPbphSMoycrWLTelULrnlT6FVRGcg0Eo0PXzRSPM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RkPog4Ylww8hpIwxKyBniJOuLn8_J6IluY2a2nHFDJA&oe=69E62C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Alternative VR", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["S
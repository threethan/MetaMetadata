54AD8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fB_qD0ExUoQ7kNvwEn7YSg&_nc_oc=AdqwNZ8wD7n0af9uK2IwEFoweeklAx_lZj87Q4KN7xCVB9ibZEGw5lsDEIM5L2AxAuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXRgcFimKFFd1qp5SV7mIRbzF5k2qC74_R65dw-OZZiA&oe=6AB52E60"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVBtZ6ZC97YQ7kNvwGbMgEc&_nc_oc=AdrlPFtUiVh273C4l7FOSkblrnzojZBr_W7uv3N_9OCTDHhzpXCrm3kPcile9m8eVzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5J_2SXsPADM_i_sZvgamacFn-p8iKG8VMvjPXRJk8UQ&oe=6AB51D4A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw4kuMiJwBAQ7kNvwFo2lou&_nc_oc=AdrYrBi342il5ho3lfv9LIP4WyGzhlpcHkaQa9eXVt3pjaCNCqjyDKU6EBt0xjiA3SY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEFp1br_MfFwD0mdvHpFeW5gLMm6Kux45YeqR6XvUYKg&oe=6AB534D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWo_9ZsWeyMQ7kNvwEGccN4&_nc_oc=AdqNCUS7euhlwM-UVBNTYY3MGDknXCYcbOvBF3DUaj9IBr0e1XJPsPcJteG1CfClKOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIdS3up6AhIF9V33xwxSnZwElMSzqCB7vfPlqc2sPD3A&oe=6AB52673"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57LHNl-_-9sQ7kNvwHKhNFz&_nc_oc=Ado_CbSHxVG0tUH2HQ4h8brpRhc7mAR6IZymt8p2wLpqG-gLWk9T8flep-JRYnf6JC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS6ngVVSxAl1b17Uj-Xw68iSzu8aj5JX1FCjMRtnU_Og&oe=6AB527D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
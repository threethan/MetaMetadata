1EFD8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ycq2gh7aCRgQ7kNvwFuBt2a&_nc_oc=Adru-dsCmalYnlqKQolEYzY9CZe3gnFzcYvOTy9knGzvkKbgNymu4CGMJO7OSZndVPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8GthJg36wpcj5glWDdcL6UePu1rWidi_hO7ICSLAWKA&oe=6AF1D360"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwJLGErjdj0Q7kNvwFRoZ_b&_nc_oc=AdrW_E9HSJWMc95QkyoceCFywqMziEEUS60Pe8BUjnLKXzEn4mCuYFi6jI9LAWP1ock&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROmXGAjCgnaXh8TcIeGK5MCscAlGTzPV9bQtPTLLmA2w&oe=6AF1FA8A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIwTc7wjh20Q7kNvwG2g5lM&_nc_oc=Adq6STmV3byAi_SVgJpbuXMBUc2B14kY1J2yl3SzrwxqvXIAxUQ6s-qRZYw57FL79Yc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeElujBN8mY5jEi2pqbD6o6zlufNO5pHLsarSYc-9BIQ&oe=6AF1D9D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daPp3gyLU8IQ7kNvwGA9VXD&_nc_oc=Adpc4hFbEQkj2l5Q93k7gTTDRU2pEtuAMi2hiZyMJ6eJ4Fj5x6P4x-Of1AFof6F51Tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQipJ4RnUnw9dkG1c2rMUSxFjhapUkWFqtuXtQyRVw7AA&oe=6AF203B3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUCYGIyllW8Q7kNvwHGHkgG&_nc_oc=Adp8uP8e1PBE6HMD4S3EyrGmAzSQbLlJdOtryTsrJq1ta5FxXKhFjkyx88_Dy4ACqdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGaM1wskHv08tPVEE3eFIIx0pTH7qAmWXP5Wji4y11zA&oe=6AF20518"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
D61D8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCny9H8rM6gQ7kNvwFN4e8r&_nc_oc=Adrvmqt2YR_t9CT1JmHKErugat7SKbpGXKQMohnnuNDRErsXogZOa-POhTJ4va3tGwg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmFQIO1jeBa8Iwpc9YfK8Q00a5Zkoul9OjSsO3JXWQag&oe=6AAD4560"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPuOZZF46YoQ7kNvwFSjzJg&_nc_oc=Adrw6enGUfkFKI-IcgSqoDa_UcU1LHBJ9t0ij6gXBB1KnWOe6X6BtgstXur4-x-9Jl4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4YL5p_2GJAIisT_idrRZIYtcZVqxTCF92vvloHw_Zmw&oe=6AAD344A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlJpLD8NwBwQ7kNvwGggEmj&_nc_oc=AdounH95Y6FvdxJJCws7bqhKA5Pfes0AqB5XwYgliuYrXhcpQAjKD5aq67o7LRtOYG8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm6fLMJiy_PbVDnjhSrrhpcSwY9rnZRhDRawNcNfLq0A&oe=6AAD4BD6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Bn8mEm2AYQ7kNvwHTimSp&_nc_oc=AdpoGPmIDZsN3RV2wFLFVchxtzy4RVsaPPRw3YxsJB5Hj9MIXdIBtiURg2cE-fBBaJU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJIhK_Qi4LnfLcTbXxk2vuoW2xWZArtiTLYk06Fs0u_w&oe=6AAD3D73"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0TSJgD-yvgQ7kNvwFslQW_&_nc_oc=AdrwJxpZnVDCTHZrPGe1d-OJGeox2It79NkjbtVUGAjFMZTck20_b_Tau5ibxbBfWBo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUQJrHNEvuKADl7kOFHfPat2Xr8OV0BUBtlp_v5GH60A&oe=6AAD3ED8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
2C658"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzOtEzaMNW8Q7kNvwH64fCj&_nc_oc=Adpr7osVtA53EempjAR7AslUFL-QYbdukCFdEl6G_LP8pfz-rvqI4FYlMcHisb0sF3A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QmFD3WPSn5dArpQMyVbQBSUcCNiOgHzWMceveVPBYGA&oe=6A32A9E0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYp6R8FT5-EQ7kNvwHSn2Ew&_nc_oc=AdpFBhED2KeIKsHAIQYiT1ZwXdWhQ7fqobGU03Hf1qvHfg4rGuwq57Bcs-OkBeK_s6A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-oxaTL3oCAeMwXCrdRmAIMs49ROi_JRJ3cPCi2qUIMg&oe=6A3298CA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rw8sWKiXYkQ7kNvwELdnBC&_nc_oc=AdoqBn0TPw3IKxl4kELIf6FLZCSKKAbAbVdKR0nRGRA1R-tBMBjySV-yi1dcyuF2C3Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n0ptTGhlCL1Z_QTeU8kVxCnE-yBbQyhYnVjZH4A8cGg&oe=6A32B056"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW5OLAFGFtUQ7kNvwFpQwFZ&_nc_oc=Adr-qD2Qdl-qcUcNUkwBKVZy7HwDDvXK0f1vaz7koyEGC1l1_Vjuf9cTNRg1ymBrAjo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L8jsDxjLOPtLwaSnnc_phJ370wvZqwC0VhX3THZld0g&oe=6A32A1F3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh6OhM7T0v8Q7kNvwFDB7Th&_nc_oc=AdqhN2TuiPpVgJG22S9H5ajIC4Jtn1wcaWB5jkHSCefj966JSAMGtReBa2RYdw8jDkU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ElZH7psN4IlB7_KKeDo6b9FxhoeY7h-i9G7vWEydW9A&oe=6A32A358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
17A18"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlqRl7rC27AQ7kNvwHaM1K-&_nc_oc=AdqACi0YAf7w2BjfBac9mj8abLnCrShCSGmfN3FferSinmN7VnsvzsoCfDC-tGD-4wE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcw2X4nPmIaoHUOuMQtgmm0wM9nvQFuR_jQ3Xm6MUmhg&oe=6A915DA0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZuYOdNaBJkQ7kNvwEFkhCO&_nc_oc=AdqxGe7Gtz1XSKkcHC4d7uqYWKHQ7RLjDOfp6oXmGf_m_YIRW64_DBeCqQueVFcmfJo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtbpbM_EPdQmn0WRHPLrM_HL4ZcFCxIQ-itQc5rJyduQ&oe=6A9184CA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oef2s5wwDM8Q7kNvwFw1gw8&_nc_oc=Adp2WrOtuETccfWd7LDFipyCsROjwuKeDoAdgBlvUaWsDtoWrp5n7rSzMHCJDwztUl0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7EMsmWzpGCBsoKbbpUY6LXrh1h0XaA82nYvPuIbM6zg&oe=6A916416"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dP_yLOIYqcQ7kNvwGAcFCe&_nc_oc=AdqdhJmjRV2H-cN4NeduOyDUud1j1O1Sy2AYt8jQ0yI4pg2z-sVg7WR-2iwQC6WBlG4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwYVwleNSjLxh3HwjaH6W72eVAqXZZ0rwPO12WU-5IVg&oe=6A918DF3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znalzTaQZ9wQ7kNvwFKUEUR&_nc_oc=Adq0JjoHJVqkSAjC5tRl-JgA27nXl3s5sBCFsPUaYY0MxIOD1bn9QdjQIkdAYEhuMG0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR0glOy-2Fg9cH5xdsi6CABx8KNcQ3nsOUGybDbEoBGA&oe=6A918F58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
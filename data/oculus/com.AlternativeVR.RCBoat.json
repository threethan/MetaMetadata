3E9D8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-PUeUK4mxcQ7kNvwEsUPrz&_nc_oc=AdoQ6hcbM-AlyVtDBBUZjUNF1ZX94d-G0wxLjcX5GFJKzl7mjWWO-sVSDteVNl3p_d0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c5z5kMOQY8VB22vz1ApkWEIZCQjI3jJydpxMdYu0BVQ&oe=6A43CD60"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Epm2CMOXsCoQ7kNvwGhy14s&_nc_oc=Ado6nKuH1d6WM0UTrzRJu9xXCbkYCZ4gskqPfIw9RGH56AvKtQvsd7lanmWbTq0_cSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q-5EaXJwF0t3oy-Loxzw9c72on2bHgr1jR5uV-8c6Qg&oe=6A43BC4A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hrc13ak-Ab4Q7kNvwEF_gpd&_nc_oc=AdoxwD-VxCmXTlqnsVU2_SoGFsnQlyGPPBNiAvHjRCL-MBQyq8NI7YCimaKbq2d9MEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5R6bPW2MWRUJI9qEr7OWcUkksqYnesYoE4iCJNQSUA&oe=6A43D3D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxPVhu7kHZ8Q7kNvwETyO0x&_nc_oc=AdqrWS08opwrJfUMRyZTY-bp0aUtRU_WXUxUeOWVRswYT2E1cB8qGi1c-y-4UG8JLD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GE1tzzMcm6OqKQarSUxzH2IvTkoIKcjXq_nFrUTbY6A&oe=6A43C573"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ542KLgrvIQ7kNvwFU8Mv7&_nc_oc=AdomcHEQXDPB1eAFQioccBQ-PGnUIlWpa9qnj98Ohqgwbvwtjj6UC7aK-7FnfIzOcLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AXbxvNfN3-_Ucu1YtzXAr1iwQUpv_QtV45t4az8ygMA&oe=6A43C6D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
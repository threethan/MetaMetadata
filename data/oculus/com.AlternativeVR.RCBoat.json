146D8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4pQw64hZN8Q7kNvwEzHhkq&_nc_oc=AdpmFcPnlh5rGLtPQLdvImR0CJQrMNtdnEgqbh_Q1pBdfGtZLCjdz8GGoXEZfsVfKzM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cA6nFajo3UXzZYtQtuceu2p8ZPutA3pvihA0ZbdlERQ&oe=6A412A60"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Epm2CMOXsCoQ7kNvwFsAQCP&_nc_oc=AdpI2hLx4fv3TGr9N9DvWDZbZBpHRTFxwvhpwKcwlFTKGDzX9Gl56Le2u5IoTij5rxE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OloMVRsm8oU13hcxBMm_y18S1qVnIglALgoimCfCSfg&oe=6A41194A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAHy3jCVDHsQ7kNvwE6IBn5&_nc_oc=AdobK51-8x4v-hnkyBnzHTeacQa9pNrgCn8EvbcFdwvS0mcF3pwuW7Mo89JeyzUgRV8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xKfnzEqF-4P6wGLvYnRU-m6JV7PNWb2ts19VoK0qlkA&oe=6A4130D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoB--vWKP38Q7kNvwEA7fcU&_nc_oc=AdrUL7cBKL0TiIncSPqF0Hd3Z17ZZVpMh4nGdzCGhKruSYlf36WMwiCAAWdUTUvrigI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IAUYnrr_ZeZr7tfIzJSuN1frF2J1CWpf-Q6wrCwahEQ&oe=6A412273"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mknGQ9HZE54Q7kNvwG2dTlu&_nc_oc=AdqklKKFW1omDMNFwM9cOTjEtSyfSuFPuj74gJ69re-Ajy658cpRy1MWAS7EX6ng2WY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sv5dWwVtQ8m2ebcwD5oX80DZLRVXtxU1LDeRRPM6M9A&oe=6A4123D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
02358"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER6isALFfzQQ7kNvwH1Zmhf&_nc_oc=Adr20FiiNBA7tCn1a8CT0OBKtUiHwDPagPew1UJdiCKfl4bWmBjvq51oE9poN9l6Qqw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nBhq2JacirCR-yiJcV_xful8rKVq1GA1D_6mkWOp0eQ&oe=6A3006E0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUAnKtykoT0Q7kNvwEypynk&_nc_oc=AdqQWD88aLGpBQXu6rrUculPxgk_U5CetOy9LI463rDq91GWhs6atdjFpdu4bzhVaYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__aplLDdPR_3RRZLJXiUZlOpWPuyZUIPexcP4nZOX_gQ&oe=6A2FF5CA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rw8sWKiXYkQ7kNvwG8ksFr&_nc_oc=AdpoYbgiXM91s1Oto94bHlsl71Z1FtVHazsGyEJiqFj3no7jv_yY9KekAbNtNn_ic1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ElsdZCO8kJ9j0ovm0WUcv1agkHfIBzQz8v6fvitNNPA&oe=6A300D56"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW5OLAFGFtUQ7kNvwE_9_Je&_nc_oc=Adp5ROgRJftXYCFDLb_raO-EC22BljkCfKH5sIOAHwSmZ9au7pzfS66szhMxS5NsClk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9opznE5gpVxcM0ogVmTAqe9J8MbzEm7__n0mdNB5qpQg&oe=6A2FFEF3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA2mfK8X7SIQ7kNvwEFzddo&_nc_oc=AdqXDMgiEO55qgLPV7FOWSAoP71jTJD2P7qaYvEJ0SOAZfqndFws42Bh6PsofnogN9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kxiXYCxPtS3PuONTS9W_t9M59hch3uD7_yWD4MBEehw&oe=6A300058"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
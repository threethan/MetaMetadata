492D8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xk60jxESGoQ7kNvwGN2eGt&_nc_oc=Adqf7ZpwUiGscNYLdwcL8CHPxii0-c0o6D8YHZymt424EpBZqywkLIty_uttkXowgRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVavdv02kJFAik3nrLQQXU3QPydnuihfNP8HPOuG_zSQ&oe=6AF47660"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m41iSfhgozQQ7kNvwEsBXcJ&_nc_oc=AdqRdhUQtMpGQIWIniBmhgcAhEV3grt6lrTc0BDqnObpREOLpMmkK8iWkTMH00wjhyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRayNGeDut1bIgGACtPD4kaF9KQM-Qsxif_uHe4X5iywg&oe=6AF49D8A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIwTc7wjh20Q7kNvwGjMo3Z&_nc_oc=AdrB19EdhSvRxNETrSipY_nlvP2yeCXLavwuenveHVxD3KqHM8_fazBojoHUa-Gj5cQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQStQXP9s3-srSHDnFQcdUC5xXB3FQAhWOACj1wvpXxw&oe=6AF47CD6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daPp3gyLU8IQ7kNvwELu63N&_nc_oc=AdraXkz3yTipSewh_hZepyfcRK_BHyQEsnA3ip6ia51bGbWEQvfXVFlaeqDs0dc9Wlg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXMfG1mDdueS9DUNAFQkzE2do4-1rBolCNlf-IUu9P2w&oe=6AF46E73"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqCEBhaMvgAQ7kNvwEq4o5I&_nc_oc=AdoIkr8Bi8Ay7xvVfY8hvBecYEbicJPIev8_U3X4NNHwxPxKW-33NPTjqHssyp5UvTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP4_-Znt4c28chSZc-wstVkjNXkgZM0lOIgQfLgfom8g&oe=6AF46FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
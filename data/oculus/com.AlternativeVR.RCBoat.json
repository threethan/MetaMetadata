C00D8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SPqKC9CZ9MQ7kNvwFuCZut&_nc_oc=Ado5A6pRUsWfm-rcnqM4Fq46484BaKMJU61JrwXgwx-RZZzYiqdx5m9VvzR8FvZVOew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PIOvEbkY4B_iPTRmEnWNNjwTolAUn0UqEuHP6KGJZNw&oe=6A3BE460"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7lzxgFnagkQ7kNvwGBed-y&_nc_oc=AdqfUy6PpV0iag2eyyUNmzWVn3abEUZL9qSKJi-KZ6ncIwZJwm-uhzX5W0g3ATkaJpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hqeJ_Q5Ex4VY2V8dWNe7DoYwEtRsTU6y_m1rHUzY1ag&oe=6A3BD34A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNExYOTEJvMQ7kNvwE7YAC8&_nc_oc=AdoHeBvk5bdDtY7JmgKzwbLetzx9eU548bV9gNsJibdsh5nRJc-92BglMCuel8l6x0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IjncWaBnopaBBPwQEP--TnJ3_f3nk8wrAffY4IQb-7w&oe=6A3BEAD6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XefXri_u1AQ7kNvwGBL-bO&_nc_oc=Adp01yusfBTrnxXRCupa3SvQT9DyckZHl1-LvmJUzwaPz0MvhobCrHY-kXKFcMALF14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y3vB-96xYJK-J-39MUN9VadobZmOMsL2IwuibzFHtCg&oe=6A3BDC73"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-soihuv2G0Q7kNvwH8izKZ&_nc_oc=AdonefUUTgKBlDosYH-RhS4_1trPJcCHDIFWcbWm5pa5mHjazG4gfBCoEy7zBppcd3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kuNSbm0VPklukjogHKRKlwTHKkwYFI3FU_Rx-QyFXrA&oe=6A3BDDD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
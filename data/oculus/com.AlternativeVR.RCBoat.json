51CD8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=en2qzEjuOtwQ7kNvwH4JJmw&_nc_oc=AdqbbUYJD7TdQX8L8a_izUqMnLEPHd5IMWNPjCcr7T_LUv57iqfQmOE6mlQI6gyIt18&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUMSMj5N5a8ftVMoFQCLkbmymT8EA6iYVM5Tqgl0anPg&oe=6AC50060"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw4Q42XZj18Q7kNvwELYGjg&_nc_oc=AdosEYMME7H-4QDo_hG69eSJbbuw071GKUfWXrJAR7akXw_4GFAjlQoST_5LjLw04Fc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsMvZySE7FJI1W9OcwoJiIVra7WdNqR3uGq3zco451DQ&oe=6AC5278A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEVeYZ65UMUQ7kNvwELPJ55&_nc_oc=Adr1DM8pju3RJ7RVQRJUFXrh0czGHV-vnMaSDjTv9ZUP5-paTcXOY5G9ErGJnzgHvmI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5rAJpbV2O6jqJsXNC5vxk8s78tuR0OZo9HhAvenYdcw&oe=6AC506D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcgjCLbQcE0Q7kNvwGtgvN5&_nc_oc=Adrt4aKyUPf96bPc4Hok4jJFQFq31QIwhMvrGLHOrDYTS389VTw1KNT70OK_-apLvGQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj0QPtXKZ-37tVlInhJI3JAW2lHO0xjh_VPIYyOkxs5A&oe=6AC4F873"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYp9KukpUx8Q7kNvwHcFSH9&_nc_oc=AdpvSMwc-YSRXC7A3i8Yo6KMxBQzfoVHmaC0Mh7z7r12Q9mmi056-pyzOxOt7EpDkQQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXgxgwjIHMPFDBsvOISzNze1wKRNgWRPc3WMFCeFnbMg&oe=6AC4F9D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
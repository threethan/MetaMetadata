99B58"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5dZ7_Rd9bYQ7kNvwFypHlC&_nc_oc=Adq3xPJDyWl1NBfRgOzj3R7GY50n69NamauKifA3vOk_bXyeDdyCqlAuSdv3Stpn168&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVFIWn_OEB9FNMTEyQD8HqcfdzySWFcDVtFoqA1ZRHmw&oe=6A997EE0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pOscyke3YsQ7kNvwG0t6kq&_nc_oc=AdohhmRn34O5xKN69rT3MLMNCchOSJegoTRZbBpGBSdMSSspxPKqZyXDdZsWZKt-R8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdLii_-25Bg-ZOlAPcwLQ-XA0cxXo5WY9KtukuNxLlZw&oe=6A996DCA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmP5tDU2wMYQ7kNvwHH94RR&_nc_oc=AdrFb30wdCOOskmOZqxcwIqvod2lkcbSYMct22B8VK1s3yZ02516mldbRTRDu0p4rKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGurFCflrekYFqz2xOur_GYFeD20TBm5e8wiHoniPHvg&oe=6A998556"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUnZKbvKAaYQ7kNvwGBMfOq&_nc_oc=AdokL60i_w5uDvQesHvUvFvjWFc8TYZygdtyb4aXuaaMEmI8r3QhZnEJFjU0NPF5qTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-NEBlQiTpaRDhUu7XyCmy3VToadCc4plx0asVtz_cdw&oe=6A9976F3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPNlmUCSUGEQ7kNvwG_QsEc&_nc_oc=AdouMXTMF7g3io_ukU7WTgM0XisCDxDMZbq7m-j3SCb3abZxjAJX5ivWcCjz5Dd3-_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgpe6omVq_-mtNs-sH0fyUzbhLxWUutIWuFxxMWpZReA&oe=6A997858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
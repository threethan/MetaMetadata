02898"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqICe4_AOVgQ7kNvwGFtnMZ&_nc_oc=AdphrR5k9VwyAeKkB6wjQcQkQzCEW2zv4Z26lEXJu7TPgmK5D3B4DbV6oGlPvmuxRtE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFReC5yli7k4NHYMryC0FIgsmAwFFQ8xvy0-BZMeM6Ufw&oe=6A900C20"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZuYOdNaBJkQ7kNvwFka0JJ&_nc_oc=Adr4c0E_RGPjmVqDjoYEJQcWDShKC5cRglntCvfAlfIPFn4EMPvWW4qYTJ1Gjk7Eb-0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyZx5cibm5aTtIDukzJKjF1LuDicO6XsiXf1wEu1rPjA&oe=6A90334A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oef2s5wwDM8Q7kNvwECLUeG&_nc_oc=AdrkAp2ZCPPDM5ThJryvxZk7YtNxdZ8uX959xDBWNL3OfE0wS92WbTtlm-QDN-UXTiA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn17KdJJpT0ctZNrkZSoeootXh6sNjfkXHDInIm4o1ug&oe=6A901296"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dP_yLOIYqcQ7kNvwFMVUrm&_nc_oc=Adq8O-jqzGBaq4w3fElYH-DFkX6sPKMMvDKvPMc4g97Zl5UmYAxF10qsDe0osO6i68Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_Y7eLMXjjMzInbDGkCW3OgUZX-OhSCWdWg1DQ-KJD-A&oe=6A903C73"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqvkFwhKgisQ7kNvwGiFMlb&_nc_oc=Adpl7JoPScvx2JpHq-RsQCAr6NDi0zY8-8ArxvZLoFeHi4fqujSQywzwrA9iIDg4fHU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0TKFDaPIvoZFhGUfvb625h6IDaUEPtlaEZWrw47L_vw&oe=6A903DD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
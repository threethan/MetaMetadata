21DD8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02rDS-6EJYsQ7kNvwHdjtB7&_nc_oc=AdrLCkIT7SxzZ8lh7hlP6JbA2XhHL_aSpFMqH0XX8MlufvmzhYJRC8m--dIiVUQ_euQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0utaJTIRRO9Re7D424o-Eoh8eIQBQbss8PsifI5TdEg&oe=6AE20160"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysFdopFn02gQ7kNvwEehv4p&_nc_oc=AdqoMh_T-2vCZSVzBoeCgbnXRcoCLAiUeSLrWt7Sja6_jRi6Ggp7_RVOTop_GwkwVS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM_A-U8MMSOmC1TyLsRQsq5QwSmB05nnG1ty6XpmAaYg&oe=6AE1F04A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPF7-yvPs7EQ7kNvwEOYfFz&_nc_oc=AdpvzLJu9f7cgWV0bKBgbpJ3Rra4kvnA6D-l7SfpWdm7ZErShhb1L1FEw9fnXSKjKCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP66XHXWrv7Z5Qsjd_lm8TGX4cibqX8jQTCjD8sgXP_w&oe=6AE207D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3F7PAXDvacQ7kNvwHGnnP2&_nc_oc=Ado4uXTTmTEShPOlayjFVhTWliVzcGGj8WO4wccYeJwjcbB9oQpVcP8hC5ZQbO-0ezE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp5RIfdsx-ghV3Z_1toHJaa9UJlApJE-xe2uivBVGVnA&oe=6AE1F973"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrZHdRdy1B0Q7kNvwGVRTDj&_nc_oc=Adppsor9gfvytMQVk3Sv93uszI9Rxm-grzFkpIcFTcIsmKivV3AqpJH77B14PleDQQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH6Ypuq23Fu_AOQrLZ3ODOJdrDBPF3LbvlWMQKIjiEzw&oe=6AE1FAD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
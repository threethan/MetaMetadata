A8698"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDyqw9o83psQ7kNvwGaH5bh&_nc_oc=AdomXJafZPCB2cZwif6NBnxx_kQxs-xvHFvPGFxFVNjefcm7uBNMiWNeQXwZAXPH8VM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbrICth7TIw4dragHm15qzldrhusz7mgukLC9_TfXMAg&oe=6AAAA260"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO7eqX5YJtEQ7kNvwGizgjl&_nc_oc=AdqTcyo3BxhNp5gg4etRB83asoXL1IQWrNwIHWPjhIn5ZxFWIYUEjrXy5tMnZrxIO44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8cLsbusgnPQhu51qt9gViCytCwPAwjbgiHfrfsvyw7Q&oe=6AAA914A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlJpLD8NwBwQ7kNvwFlAF4W&_nc_oc=AdpoxSjIEchlDubDnDGB_84dWHxEQe3OHX1Gwn92C9FsO_GrqnBcqhQQdeahWqCk6Zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoHjk0Eli5F1Aybis8DBGugk5y_3cw3H5FP_CVdzDPmA&oe=6AAAA8D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7Bn8mEm2AYQ7kNvwES9e_L&_nc_oc=AdrFIQbzcbS10eQyjBkPrpQCC_7Yizam1hTxKXd5IK490YvnVA6wkUD0fgZJDDkRcIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyALdHBVmxwB0j5ARqmbbi-ds4poRkp9TYd0rVjY-0vw&oe=6AAA9A73"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgeRwvL_QWMQ7kNvwGtxzWb&_nc_oc=Adredue231fuilTdVc948uGwcLHKWZM9dLwQhBcmIHD2o7gvXJyGH3_qc7hIqHckpQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0NtIWTaBLk6fVk1HQwUd27GJVoH5C0bLssxq31VLU_A&oe=6AAA9BD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
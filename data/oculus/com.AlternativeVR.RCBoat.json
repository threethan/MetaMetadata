56958"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzOtEzaMNW8Q7kNvwEDADXC&_nc_oc=AdqAxep1BtkTXWxUi0cizTM0JfITaUaCJewYGzsWSlZf3pnmimBtvaJ0gtwPnIk32-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ID4uKcuApuRffQs3nLBYu9mumUJo1CjFeILsX_IwuVg&oe=6A354CE0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSlXGDPNR5AQ7kNvwHOhcml&_nc_oc=AdoJ3zHhFrVagcn4IEQEehwd27CzP92zkz471FVLRhXaTR_l6tDLJwUb3yGPUYlpYwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g9YQ0L6lB5u5G4dn0zfyurGDPAzUNyLLxRS9sliunJg&oe=6A35740A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UeucSFNHIQQ7kNvwF5xNhK&_nc_oc=Adp3KR17UENvCTv9GgDhL-z3ZT_OkkCIVBezP1x1QrCE7CSBY9CGVSb1e2O3QiA7tGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T5T6Kvbm6UVelftxgwnpIIBK9hpS1JG9jYkq4Dqrb-g&oe=6A355356"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv7oGdy3TugQ7kNvwHtPZbN&_nc_oc=AdpI-_ApJC1H3eNFwufNnBHxdTJznFXaGcI4loz38scjGiDRlG6gt2Yl-8En0DnQbyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uWA4VOjZKLkVyJoX53g5rul0OVnizCihykoEigvcmTg&oe=6A3544F3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh6OhM7T0v8Q7kNvwHtZ1Yb&_nc_oc=AdoCG7g1b4FNKH0lOi64fQcOYkgYhMrTI8-PQgp38kMCwEMfmMlPuvWWaSaoDYfoHKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H7uyQb1gv2P5nw5f4v4CZNUe6kDFKUSi6IoANBzdTbQ&oe=6A354658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
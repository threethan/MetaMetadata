41D18"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlqRl7rC27AQ7kNvwGmLo56&_nc_oc=Adpvik4lUbBvmSdZlSkdPnOty4xIhU3D9qAKOXIL14DgxVAbg-zUs0uLd560IyA9sVg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe3xBt7JRqqLKVNFwm7ZfMaPD-mzVl4DXzBLd1I4uCow&oe=6A9400A0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pghzxhbitoQ7kNvwH4m_VN&_nc_oc=AdolXJq6AHyQQmq2VP2I_w2lYnnVfv52mK-xj-laqNAXyXNgTJ4MdsAiSZGM_hocHpM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXBj1QVnjocQAoOLoZ-Q3MbndbOe5XsLpXx_O33Pyy1Q&oe=6A9427CA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFxnUgfYwFcQ7kNvwFV_cPF&_nc_oc=Adq1DIYt_LUhmAM6FOSOin7x-yv-mg0os3NF74V6YbM5f18i97a9Z0j3DVbMxqz9aVs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaNqhn6Q-NlE8tBDe9OpQLkDyzBYxJAEghRTqseVEzFQ&oe=6A940716"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gPQnftp6A8Q7kNvwEyrxng&_nc_oc=AdqwvQDpPhdJwFVbui06rNT5USp4louoqRQxmxJViYUkJCG0NLy2J2og49z06VSx2U4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-0bg9XQELluXOt9NSW7iJcQnGfslunDJGfa_6RiOrJg&oe=6A9430F3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znalzTaQZ9wQ7kNvwHAX-fI&_nc_oc=Adoqbpr95pCwGyYu5XDeoaKJ-ygxRzMrtYscsP_2V8Og7FsHdRWYAuLy6i9bhp4TL1c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj5DTP4FFJ5tSsmUuBoc7mi5ziMvbt6EKy00H1AzbPNA&oe=6A943258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
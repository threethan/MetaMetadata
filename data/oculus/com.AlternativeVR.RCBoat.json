69C58"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fB_qD0ExUoQ7kNvwFRD6F4&_nc_oc=Adpv4QtarKOmzJFGueQNiQkbCAW3_BlGC_9xS1ShAqjES83VjigVRdjwN9jspiNoSTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq9t6NQf3Nh2nYP_XnNrrzQOu5df9PkqW9zfyXmyI5rA&oe=6AB67FE0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVBtZ6ZC97YQ7kNvwGsthg3&_nc_oc=AdoAtng5ygqnQg7zTN-rQ3LMDQuOcx0M8LM5W_sLBycrejN4vHYTOccn2KNAROx7Rno&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILY_HyjdQV6pO9Ijp6PvewKRISQDIvEQeVaoiz3Ktz3w&oe=6AB66ECA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtmjhCm3tVoQ7kNvwHPqx9v&_nc_oc=AdoubsO75ichJRC7o8X13LqIrRyTN_Kr903QS3nGiPoc9pxTTlCrfVa7PfQXxKs2KfE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyLcW1RuMwLdXRnn4iiqwZWeJUNHC-R904mclHU2hV2w&oe=6AB68656"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khBYSYzkWxsQ7kNvwHwy7DD&_nc_oc=Adq1Hy2o3ZpdGqcr74MqcwSVq5yunmG5Mx5sTMAacSQatUAB7R5t0HAATn6xSdKRApQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ebQNV7YbWQxkhWHn83d7A2HM6AECqIHnlfnw5vKvTQ&oe=6AB677F3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57LHNl-_-9sQ7kNvwFZvjh_&_nc_oc=AdrGhHtARtZlsP9xkKE5noerBDbohbsmNPaLDtgZGN_luVCr_Bz7BcpBIO8syIzAxYg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK51EwYBdazl2KncM-5GGwI-09y11ssXaTVr3jhHcYIVQ&oe=6AB67958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
80C58"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5avvBKsGRsQ7kNvwGvtzKc&_nc_oc=AdoLoOckQxEJE3LzVcBMBea27J3SqE6KttPLkgvdFy6jAv8tMU_vwVtjh8DFfC3MVAQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vJ9aRX9tisJhcW-yYso9jSET9jh1uxeEmcnG9ssYn7A&oe=6A37EFE0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSlXGDPNR5AQ7kNvwHyDbJS&_nc_oc=AdrHufgfIWginOe9cKAOzlAivYeRtFVXFResennoGxDMmNYePxGsg4aAtyYh8JgiBZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C1W9epygSqLQfpvERIeiZs9Nse5Le64BOiCRJ-S5gtg&oe=6A37DECA"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWQ5Rd-Lqj4Q7kNvwG2e_90&_nc_oc=AdoZ7N17d_WN0yuvS6WNl0DGPK1Krrwqh4DtmPvU6aA3KCwqHjR4qJ6lGIZsPF5cVo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jpl7zhqjvYpVdLoU4urfJjzMhhwtyFtOc7sP-f8O9Fg&oe=6A37F656"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEngDO_Xte8Q7kNvwFvl31p&_nc_oc=AdoSBTg5RGt4BQVW_0p56sC0xhBu1wOk1YKe4ECEd3AFzFriIRx_7aJaPg-KpZMv65U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-s57n-eBT-pgxEV5yFIrcOeF6JpqUmEOzErZb0Uv1Bg&oe=6A37E7F3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZbX4h8cZOoQ7kNvwFQc8Po&_nc_oc=Adp_pBy-AzUml0CpQ7LrDzrDAOCpLGl23YiH4-4LOsnPtx4Urk8DFoHSPhcFcksKM6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93oNExA8_9L6BzgQDGaHNebLoPY1O43wQ4X9NqUPineg&oe=6A37E958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
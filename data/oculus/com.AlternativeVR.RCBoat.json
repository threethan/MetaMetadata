5DF18"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxwsEBsyzUIQ7kNvwELhq02&_nc_oc=Adqfc1EiBpaYH5G7RoRimSjg28yu_IZehXn0AvZ4bUH2a_5nWZOqROwtR1poiz9Ml5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF52EQe9wlaQXvm8wvRRV0IJ_na-vs06qqeKojlS04hA&oe=6A95C2A0"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pghzxhbitoQ7kNvwELkQ4k&_nc_oc=AdqkwW7Fn2imuCVHkULR-txgxV1hLTpk8jmsfi4umR2tqdM_tSJhwBhHmooFZLrqvQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPMyVjTsUo_3oG8rG9B9cW-t9iW-Ett2kzjO7n5Jybwg&oe=6A95B18A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFxnUgfYwFcQ7kNvwGEVRkm&_nc_oc=AdoKoQHw4ZuADeDsG6gquDerKTD_NROB-qKkznRgt5yna2CrzWc3SHEsefr7euxtcSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Lkkq7KDJsbqLwcwxJIVCcy7kLsV1w6gMmZ-S_BprQg&oe=6A95C916"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gPQnftp6A8Q7kNvwFj8L4I&_nc_oc=AdpYHLeQ-gEUNlsBTdKv_m_7AEbZ5XLaiqxqjXexE2zbDMu_ZH3st32v5XhUpWzaAsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0vcu6BalFzf8EVXoNTixkHT7dWJ7RMZkCojGyJSf2PA&oe=6A95BAB3"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xePLmJ5lMm8Q7kNvwFfnyyd&_nc_oc=AdqvXyu65Y165jq1kEzwusciAUtclbG9QZlH2gWLJKWYrVAnKheIgDtucayMh1ELfZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0nsNjMFUAP55F6EURRLS6PSaIBwdhFquVlQcoX85jsQ&oe=6A95BC18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
174D8"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ER6isALFfzQQ7kNvwFv15Hk&_nc_oc=Adod4e0wWRZw8DxFL4WQIKiACWNgaxzKo5q9s8ntY00XMWR5NiGQxJk9OIMDZfBhcdY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zl7GDDGteWOl0jXxWU3vsIgLQ1Oe33sgJTofQzKCyRg&oe=6A315860"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYp6R8FT5-EQ7kNvwHgtDqf&_nc_oc=AdqRcDNiOgJCRYFzE15XTaPlYyce_DwviJC1SHw3-YRLTZrjdKRe90RkXd2t3C2RwJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pV5sIkXbpfHud98_17osYA73SyVV7FFt4BC3IQ1gNZQ&oe=6A31474A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rw8sWKiXYkQ7kNvwEPRCHP&_nc_oc=AdoMh4S7jqhJktymPi-ZOa23uRnb0sQCx1VEebX27JsGcj1to1H8xFySI_zX62R8kSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FZymQPxspWN9sidbcnpRsTavzTczjVU7ud2UUYmL8qQ&oe=6A315ED6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW5OLAFGFtUQ7kNvwH6Sa5g&_nc_oc=AdqodbA6xnibw_oAafrgrNamnN-iT-NuUSPmQu2sB0qhR64owOVDNU11DSR1sOx_ZkM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ocfWOQGzrbmF-ibThw6u4kG5ctifOygeQEE9oosO7kQ&oe=6A315073"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AA2mfK8X7SIQ7kNvwEicLsW&_nc_oc=AdpxDOBtZLQyPOD_oHy0_MN5Os8TD7eNWljeZP5hVxjh_NuryMFU4-8hB25bSga2dlI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90wfg4080U0LL92721fcla9VC6pBK17QyF3Wm3S-hrog&oe=6A3151D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
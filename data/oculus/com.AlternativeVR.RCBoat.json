0E098"}]}, "id": "2244043872655950", "locale": "en_US", "screenshots": [{"file_name": "Promo_03.png", "id": "1573534127036492", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819982_1573534130369825_1999562198365208756_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tU3kx2unMAUQ7kNvwFz0xJG&_nc_oc=Ado5uBqDLdSQzz97IUvlqN45xRZOpClzRenQgTPBpyCpyMZ0GUMwNq9rSuR5hqdQZwI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlcjyhJ-EQyrMV3dwK6Iu3SP5wR-pYlGhwXZOLrSIe-g&oe=6A50FC60"}, {"file_name": "Promo_05.png", "id": "1260539969556368", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821719_1260539972889701_3728483621278868711_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amiSkmDelEsQ7kNvwF-WhY8&_nc_oc=AdoqAC738jl_Gw_5hwebzwADg47vrRSW8XaaIsIfY6e01i3aYxoBZtFqJy8GlPoXXOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuB3HtfMmatl9Ioen2SKaMVkXdfDVzxIZyS9AuKsPcMw&oe=6A50EB4A"}, {"file_name": "Promo_04.png", "id": "965779425796001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_965779429129334_1752119543256658720_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3ZDc9LVtKsQ7kNvwG6pm99&_nc_oc=Adrzz3dE2hjcClCVmnBakFIF6JfRce1G09Jrv1-rDDrv5m02KsZcf4iYtDYVeRfIb3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuWgzJb4O94IUxxpTCIUMp6Ol9KMgJO9y2v0_lOymmVA&oe=6A5102D6"}, {"file_name": "Promo_02.png", "id": "971988262061514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307505_971988265394847_5452914786293924330_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma525fvn6wkQ7kNvwG73d0h&_nc_oc=AdoWAJMnQhwCAjOT_GBz7LF-1RTfUHtcFk2agGRQmvBcHWQOVtRzcHFS_Tbm9-zP3DQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO7CA4r5iPvAUzdC-cI65fORQLe6D9swxPiedHN_HY1A&oe=6A50F473"}, {"file_name": "Promo_01.png", "id": "935619815715536", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825305_935619819048869_5388011721711466269_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgREoGXB3zQQ7kNvwFhoEUA&_nc_oc=AdprdyYhsjPJF-umzne8z9If6OFk7JASCQdiNefqf8Jj_n8K9KU1nM4w8PKztNO8MZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0EevnZ4WShm0zrks_PZgy_4z9k4d5XYyJbGW91ZUr5Q&oe=6A50F5D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RC Boat", "keywords": ["Boat", "RC", "Racing", "Ship", "Vessel"], "long_description": "RC Boat brings fast-paced remote control boat action to virtual reality. Designed exclusively for Meta Quest, this game puts you right on the water with full immersion, intuitive controls, and dynamic gameplay.\n\nChoose from multiple modes to match your style. Race Mode challenges you to master tight turns and high-speed tracks. In Free Ride Mode, you can relax and explore open environments, enjoying the freedom of cruising over waves. Water Stunts Mode pushes your skills with jumps, ramps, and trick challenges that test how far (and high) your boat can go.\n\nBuilt with realistic water physics and detailed RC boat handling, RC Boat delivers a satisfying blend of casual fun and skill-based control. Whether you're racing to the finish line or just enjoying the ride, every moment feels fast, fluid, and responsive in VR.\n\nWith quick pick-up-and-play sessions, colorful environments, and smooth performance on Meta Quest, RC Boat is perfect for anyone who loves RC vehicles, water sports, or just wants a fresh kind of VR experience.\n\nGet ready to launch, jump, and race across the waves \u2014 all from the comfort of your headset.", "short_description": "RC Boat is a VR experience for Meta Quest where you control fast RC boats in races, free roam, and wild water stunts. Enjoy realistic water physics, intuitive controls, and exciting game modes. Become the ultimate remote control boat pilot in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "pu
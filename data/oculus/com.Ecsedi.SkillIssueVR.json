3hs8eJRPLZsa4FcsfulMqWljpUQ&oe=69D8E3C4"}, {"file_name": "SIVR_Screenshot_07.png", "id": "471041812467889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVzpHPMPjTEQ7kNvwHOFIko&_nc_oc=AdqlBg2zBVtXy52yqEsFv_alkowJaHGHL9fzIvdFSmJv-Ct9U7XqWBQS6fY_foeGVYA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bvro7ON_S5iW3O3hkkrDXWGWkN3l1tpl6o9-DMbMQ-w&oe=69D8FA1A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLHShr_ZZx4Q7kNvwHD83ON&_nc_oc=Adoed9iDd6luPYnQjB2kvG_6UXvn1kd0HXvaaT1WnTo7uDL0AuqpG60Worsmk_o92b8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3snha_P4eWUXZDKHXEDULxt9Q2ZzZ5YoJ9qeBZ-2yKxQ&oe=69D8F0E8"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99FQvkNIhucQ7kNvwF4PuAx&_nc_oc=AdqPx9jrwjmKMQw9dc2ulwI5RGrtcYtSRKEBd_BJI6x_TE4bX7R-suN8arBbzEbc3H8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k9g9XMBXQOn6qWWNUJ0xoenGu1jPxoRkdlSpt9sGrAQ&oe=69D90BC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1z6uDzPbhQQ7kNvwEkTlo_&_nc_oc=AdoC8sqcIUy5Y8NJP1bvRcBhtvtUgZQA_xptqgD5j-js7JyhDzNUUYdzuGPOp8J2yX4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Loe3Pci3S1H8zB84nhMGc4xkjuZEzMvh0AZldIPN8_w&oe=69D8E16E"}, "display_name": "Skill Issue VR", "keywords": ["puzzle", "physics", "creative", "challenge", "trickshot"], "long_description": "Skill Issue VR is one of the best Trickshot challenge game in the Virtual space.\nIn this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/ecsedigames/skill-issue-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
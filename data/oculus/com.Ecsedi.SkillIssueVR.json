ttps://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYYF_Jc2JhUQ7kNvwFiaIcW&_nc_oc=AdlCqGmXvG3NsGu2mneKLeRXw8qGHhkv0HKodkUAh2GktLgk6mQwsV1JowvEz8RgVzo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsTqaTkQzEy0G34XVVvhYwhNvIRNDLjR3tHOVfSEk2M0Q&oe=69A58F9A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRVb39HJW4kQ7kNvwFdMggA&_nc_oc=AdmUrjY0xjCiLp8cW34NLhFWL8j6qDqq8wjDSFiCsqAlm-q2Upge4Lb542SKTcDbUng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuAnp1BrKLVKHa9W0jRA3rzCQ3TqabTapsXFGIq3N1Vpw&oe=69A58668"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC9DUcidujMQ7kNvwGaoJRX&_nc_oc=AdmnvdQjP8Lg12u47aCPdN3kRTykfFuwDolrDmBj1f39EInDxfVbsx0mPf6xxrAkjrk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv4i6D8CewhB-wptbAolrQ9IgJm7XN_whcFp9i4JplV0A&oe=69A5A146"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iaR12vwF0MQ7kNvwH2ApWa&_nc_oc=Adn6f_ytMY_6Z1vB94ymDfdLFxn06bepnVdlv34sttpwuMRNzWuNRApIIVkvj1PHY84&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv5-fdnOT5_ErMHEKYwhXr1RPNyHAtBU-TOTOUg_KqfHw&oe=69A576EE"}, "display_name": "Skill Issue VR", "keywords": ["puzzle", "physics", "creative", "challenge", "trickshot"], "long_description": "Skill Issue VR is one of the best Trickshot challenge game in the Virtual space.\nIn this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/ecsedigames/skill-issue-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ST
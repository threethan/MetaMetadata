07.png", "id": "471041812467889", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc6JFjRdcbIQ7kNvwFdZhG2&_nc_oc=Adq2oUPXhHXSIpXdfH8Dzg5F286QIJqQHCHtFkNOqD537NyJ6xieWqfHzjKYMS4__v4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrwJmP-n9diuhe6Bqzjd1X6PTIzEspVQV5jW6AfMH5YQ&oe=6AB6761A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M8nekSzjYgQ7kNvwGN0D1k&_nc_oc=AdpV3LZVELfpIpSLgRPACSEcOrNgYVu2eOs45U8kDSIDZaHtq3wHaIOBs9z19ezozC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfeaAsbgAvPu4PqcIhvioLNNL9eSBlSLppgt0mBo_MLA&oe=6AB66CE8"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ-BLfDpE8IQ7kNvwGPsMV5&_nc_oc=Adqm4riF5yy3DPeHt8nXV6eZcWWkr0ZuG8MrtlIF4B9YkVJVF6sJ4QXJ73srHAt4V9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXNFcjvDpKsbaJUttHoNTEilxF7l6lPygA_NEsJBHveg&oe=6AB687C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cms5RUweYMUQ7kNvwFpq76p&_nc_oc=AdpOkY7eiGrGOC95CuqsyB-lR8DfJ7lhsGV9ycRQA_4SfLFu1sDvTJexxCFxxULC-5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxkbu8SbUeEFpEdg81Rubh86UmW-mb_EgMiiHI3hzr8Q&oe=6AB695AE"}, "display_name": "Skill Issue VR", "keywords": ["ball", "puzzle", "physics", "creative", "challenge"], "long_description": "In this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/skillissuevr/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/skillissuevr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
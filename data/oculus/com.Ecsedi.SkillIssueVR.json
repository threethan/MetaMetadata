9T7iQNoXTr2v6MZN8dpbG_FF3zw&oe=6A0D9FC4"}, {"file_name": "SIVR_Screenshot_07.png", "id": "471041812467889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns6NJ36wcX0Q7kNvwEbZJ8J&_nc_oc=AdpmTlWKYLX5v6a6hiPRpmyYAvJNGvxAc5IteOmVSDHD-iv714_0oKhPx0lsG3igHys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fn7tlLN5LtiFEapcFGHK8ke31Z7cROQw9qBoqiYpQRg&oe=6A0DB61A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7K2J4LitDrgQ7kNvwEVUCfa&_nc_oc=Adqzyy15sxjXA9Nu8pd1SsgL0zfmIIW3wPTyn6SHGIefBIGKJ84iBo6QCjXV_z56U7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ebovdYNj82wwEhsVBoaKnUEy_iC6C1ww1i5_EKOrC3w&oe=6A0DACE8"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5Q-oLKJorwQ7kNvwGhiLFv&_nc_oc=Adr47DUtjs8sjdzGUUbFn2biKz2jno7ZdsAyxxWvH8G0m0Gw-tySuhjfz9VgQoPm8hg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w6mX0iTXyYAKbt6AfxN2sO9taIAgBDLOlMErNOOAEcg&oe=6A0DC7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx_lApg8gPkQ7kNvwEHNXF-&_nc_oc=Adrf_jS0JHG7lKKEM3oNtdjOJElNwWcu_R9S0CqIXs44oYqi5dS2YlyfEnt5M3lwj8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u5szBHk139BGQAB3vW3CLnYsVHzL2LFKhq7YHpdmnEw&oe=6A0DD5AE"}, "display_name": "Skill Issue VR", "keywords": ["puzzle", "physics", "creative", "challenge", "trickshot"], "long_description": "Skill Issue VR is one of the best Trickshot challenge game in the Virtual space.\nIn this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/ecsedigames/skill-issue-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
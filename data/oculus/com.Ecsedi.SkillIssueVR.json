_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvNkITF57d933luMAjwA_b3cJTemTi1MWzyKRD0bYH5iw&oe=699B039A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHdTE14HRysQ7kNvwElESdM&_nc_oc=AdnuQeoOxNylP1TpSRIvDkZ4KMdQb-8oC9gzjrMXfejVW6iixO0HyJ9sFOhBfuljjl4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsS9QxFygG1bHFV6TORk7UBAWdb0x9k8ClmtlkIfQPvzg&oe=699AFA68"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvSwK6SwLYMQ7kNvwEvUhUC&_nc_oc=AdlFHfm7bPrPMUzUN91xjnA3vRbkJoqeG46O_HnfgrSjKRSAaKZxQv-QfoFtgHcqs2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsZFvaifXfhiFS1Y46k6P1wWEbToQFVV8kXMjlXBJqSJw&oe=699B1546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7ZfezT1tqUQ7kNvwEnrthg&_nc_oc=Adlqba4b5e4P8Or1BVrnI5Cycwn7LX2uXjPW3f3HCYsrz1Omb8VW1tjUvGChH72pckg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWSIu7ki27mD3C3InEjjJ55JVExsVzvUSzjKjWRPoVQg&oe=699AEAEE"}, "display_name": "Skill Issue VR", "keywords": ["ball", "puzzle", "physics", "creative", "challenge"], "long_description": "In this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/skillissuevr/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/skillissuevr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8539639959475766"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1352847762940650"}, {"status": "PUBLISHED", "id": "803302292361383"}, {"status": "PUBLISHED", "id": "1072490774983459"}, {"status": "PUBLISHED", "id": "56
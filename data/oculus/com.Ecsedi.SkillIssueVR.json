07.png", "id": "471041812467889", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOednj3dS_kQ7kNvwERHIWR&_nc_oc=AdpQ6FfuZqu0f0EQdZc_cnUrandoFlJlktUcu-PtU8dpo3kr-vfKnT2cFrGKsTjXxJA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3nE35bPzrF7zDT7u5RiK1PAbA0Yi4Gb2fir0VdRF3hA&oe=6ABD0D9A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F-Vr0tq28sQ7kNvwG_iiYG&_nc_oc=AdrYlqQq7mlEf6Jaw-YxucNNVi6Mhm6lh5X1nTV-w9HQmtn22td4Qk4fCIv3xd-HE64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcM9F75k77FYh6_yZ5qXLoLlsiJwSacV9MVpiAgWvhyw&oe=6ABD0468"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiTOMIxHwhMQ7kNvwEbj80s&_nc_oc=Adr3_yyE17pZS2o4ayr_hScA0OmHmglzjbGa_x7sLCOq_AlrXTPXv99tTyR0qMHbl2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOdgYzJW9N2fKG4aAdntUd2nFRA_JWN_413T40NeRlfQ&oe=6ABD1F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts1OpvhiA34Q7kNvwFU2c5Y&_nc_oc=AdoCAnpCKo9eXRzCtp9d2VGb_J8qTCBzgM4ahBpGtaZHO0WbwIwPsllBrypg2UOXLas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHzQsvSX6G5zo5WzZW2rc-aRfNVsEMjoAM0r241f0ENg&oe=6ABD2D2E"}, "display_name": "Skill Issue VR", "keywords": ["ball", "puzzle", "physics", "creative", "challenge"], "long_description": "In this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/skillissuevr/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/skillissuevr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDIN
2Y9r7o0vz_7YRFm0JsVdYr5HVwg&oe=6A4BCE84"}, {"file_name": "SIVR_Screenshot_07.png", "id": "471041812467889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uolIS0gb9VwQ7kNvwFCP72p&_nc_oc=Adqe7RvALN8iwG--bitU3pZ2JcXUJJb-YJJPP7782I_FP_b64cDYANPJ3lmB2DNA2Po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQWAds-69Yk3qtErprthWdbF7BXe2Iis_2hqb8aeZxeg&oe=6A4BAC9A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Es_z01fZgH8Q7kNvwHZoQ-T&_nc_oc=AdoUWM8MirfcC8L_YvvWhStDRubLTgPmFJkDxmXVtm5R1LyzmomRoiJZ-9BgCTd8bOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKxahYwmMCQxkxrMGH8IvbRQG3gYxd5K01XiL_eDbniw&oe=6A4BA368"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-tcY8cwTeIQ7kNvwFOWW3q&_nc_oc=Ado4jIu58yvvqm6vDJ7EV6QG33HM-6DIXXljlmD1U5PxxizxW-tOZnxNFP3nmc1auQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb_Ryib5ParE22Yx5t8S1EFFM_-MvweD0TQqHA8bw3kw&oe=6A4BBE46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-svkhMelG0Q7kNvwFU1NyA&_nc_oc=AdqQ6A1xxA9-_H_Iaaxa6i2No0p-DB-ckBcKHbWQ1H1rcY0Yf56UeMt1Gi1sUPLnocY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGtNGHRsGOpx6DEn2FKqWUgYD4aDEVc2Bo2b7VbFHQJg&oe=6A4BCC2E"}, "display_name": "Skill Issue VR", "keywords": ["puzzle", "physics", "creative", "challenge", "trickshot"], "long_description": "Skill Issue VR is one of the best Trickshot challenge game in the Virtual space.\nIn this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/ecsedigames/skill-issue-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
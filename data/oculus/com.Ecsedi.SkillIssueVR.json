uE0bj9zmq-8iAzVIEvIdco8__XjQ&oe=6AF88304"}, {"file_name": "SIVR_Screenshot_07.png", "id": "471041812467889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_471041815801222_5954281730980318200_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGeotvSerVYQ7kNvwHYhSMA&_nc_oc=AdrEFO1DO-XF9Vo8T6stikv4x-uacMpAjUOUG_aIPoWlpF_YO89pjNRq11_5iXEdTOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0LpNCzn4kUelYSBgs-x4l3vXH2fjQHyNs8WVRH5yvhg&oe=6AF8995A"}, {"file_name": "SIVR_Screenshot_08.png", "id": "1124885855945366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391896_1124885859278699_4860992258972160356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAuiUC-FrEQQ7kNvwEeNsqh&_nc_oc=AdoH7b73O68WSjfn73GdZ7HnF4Cyz8eeAeTyoM1oUsByilf5SDX4_Gjd9NU5-EM6s0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK6JVIUbEg9wgwPd3FlOfKuD_0SvvxSqVhjZIQYcUBpw&oe=6AF89028"}, {"file_name": "SIVR_Screenshot_06.png", "id": "1650821652454644", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393444_1650821655787977_1764233444709482436_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B8ekBmFxoIQ7kNvwFGFM5n&_nc_oc=AdoukTPg1hEBpzzNaHaxh8kiGpSHbnCOSm5jDql6ntXYblgLCnf-eTPUYjy6WU6VqNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl5Skr2ilzkqmAqyFJYKtLzKhYVw3UL9YdhezmQSgDPg&oe=6AF8AB06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIVR_Icon_1440_Landscape.png", "id": "575793175357082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_575793178690415_3493516764322829240_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX1ws4s6sYUQ7kNvwFDjT_6&_nc_oc=AdrmvBQtrB83rY11ICYae822RAbNtD5CLNjsnvEwtQufs_UafwxQZu1gTDIaydqfzBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgFMQa1PSvDJ7hyNYqglsZAPAVtnwogmvb7Xze8PS0CA&oe=6AF880AE"}, "display_name": "Skill Issue VR", "keywords": ["puzzle", "physics", "creative", "challenge", "trickshot"], "long_description": "Skill Issue VR is one of the best Trickshot challenge game in the Virtual space.\nIn this game, it's not enough to just aim and throw - you need to think carefully about every move, as the ball's path, speed and interaction with surfaces is determined by realistic physics simulation. Your goal is simple: throw the ball so that it bounces off all objects and hits the target perfectly. But this challenge goes far beyond ordinary skill games, as each track is a unique puzzle that requires logic, strategy and precision.\n\nThe game includes 16 unique maps, a creative mode and you can also create 5 custom maps.\n\nYou are required to use all the objects on the shelves to solve each level.\nEach level contains 10 optional objects that you can use to make your course more exciting. The more complex your course is, the more points your solution will earn.\n\nAre you skilled enough?", "short_description": "Imagine entering a virtual world where physics and skill meet in a fun challenge! The aim of the game is simple, yet incredibly addictive: throw the ball so that it bounces over all the placed objects and finally hits the target. It's up to you to plan the route and execute the perfect throw. Are you skilled enough ?"}]}, "developer_name": "Ecsedi", "developer_privacy_policy_url": "https://sites.google.com/view/ecsedigames/private-policy", "developer_terms_of_service_url": null, "publisher_name": "Ecsedi", "support_website_url": null, "website_url": "https://sites.google.com/view/ecsedigames/skill-issue-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_mem
1n-A9X5PfhQQ7kNvwHlhhEo&_nc_oc=AdpmCYp5ddhjOICcgYFKtVL6C4x5PupJNDysU1LsM4thfDXtmJr09BwkB0BepcKnIUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFryjC2wcGMYDUPxXCHyro1VsthxKYCBYEYLgUnurj1w&oe=6A5795B7"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2tnp1i6zrkQ7kNvwEuTp-D&_nc_oc=AdpqM5O5GoJQkhpBblqaEK_AqMluKsAGnKYLqmcMnLkQ5GTg4JRAuFyMPqwOKL65lsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-SjqfPGK19IbySnqOdMujuGp-zcltzf0ADIx_XQ6Ucw&oe=6A57974A"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIuy1f-7ZHgQ7kNvwFoyn7e&_nc_oc=AdpBLZkmPtJ1cJXWFHVLKVDdBcbZ92s0HWAsPj4GD6jMoTkgTVvtomiRSaHvrWRGP08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYDOOljUKrALLBcR1Lkok9vORCqBoNMC9u3jyvkZigcQ&oe=6A57846F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABTGfjN_jpkQ7kNvwHufFhH&_nc_oc=AdoHxNA9PRZ7ndds_gaLd6mgPAg7GgaRT8G-J0VQw4SPOx6tY7P3Wr_4ZW60JW0elU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsiqFbnJ_8QvnBqQp-v_lsjLuy6kDI4D-vmLz8pJdLcg&oe=6A576DC3"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTO4fpxA6c4Q7kNvwFIlssf&_nc_oc=Adqbu2XuyuLPYR5d18BPIjbQTS052s5AwY05yZsjAh_F-ODOz31X-XGJeCO0-flVAJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkGuYbJftGEMTAqogSJDvxhO6UWN4OjzBeaxGtfRiJmQ&oe=6A579E58"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAcX19lr_pgQ7kNvwF2eL1M&_nc_oc=Adry3NqdqqL6Z4aq6XEzZrcJuUUepvNWoxeTwwVTzIRVRJBTV2AbIcOgtuk2wpvxTao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVkWvxoKtnsZjHTz9eNmc5V4T3ntwifUZqyrX4iUC33A&oe=6A57793C"}, {"file_name": "Cover_Square_1440x1440_01.png", "id": "1338680584514953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619594_1338680587848286_62080
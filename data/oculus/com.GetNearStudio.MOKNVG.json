uluscdn.com&_nc_ss=7f20f&oh=00_Af79tEqAtOud8Y3HyhTF6vWxJBC6C-yVzLtojibndPaWoA&oe=6A1EF55E"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4wEGzYgPSYQ7kNvwFN27nw&_nc_oc=AdoU7nyjuNBDFvE1nN8zAIPRAeQCNIRL_Swo_nPrg6PQqSsICHQHs1Iy0DoDX1fnG3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sAiPjAgdprbzGasp49xQuGVZfEJACmUsV3Pg-IHZocQ&oe=6A1EE537"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKbrcvhBKkcQ7kNvwHSj02H&_nc_oc=AdrU1XMiWgqawPnlY24LEGxxSGWHqGGL94fnPMbYjGjR2SphXzKyf9dZXABW-DzLmKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B82Riyx_dHd4raaiiAGpfltsqCqS4KSTkNvJEjs8WRQ&oe=6A1EE6CA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1lTeAFu9ZsQ7kNvwH_Z6FK&_nc_oc=AdoLUnfeJsbW91hOOu_1RwlmTSsHnCMksRI3boOSvfIvTGTINRhQiZzEf5xXFqy3fHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bMP5Rj78M2AAoOD3d6CGnN3VRmat9sS5pZlnleqe9dw&oe=6A1ED3EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw13-JcVUzwQ7kNvwGZgWPR&_nc_oc=AdrPKZ_F-dmQ8UUC0NINk-lzFpS5W96Oe8wiBAVLzikg6fxVJHKFK_go-7LImlZwz88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Br4dNGMbR9PQRZugDhHa6be2QTdugIRWtMsZOzm9jsQ&oe=6A1EF583"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2dZE1_vZvIQ7kNvwH3doS1&_nc_oc=AdqAeAVMoU0k2RcItxcpf5BxgBzk8SlKURf7eKbcfBiqeW0HHg5zN9xT5KwffqPP9_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TpEESPavQFeYdPgO-AwrWztYPOeo8zkKfAXWsLgI-qQ&oe=6A1EEDD8"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmh13o6H3lEQ7kNvwEgACRT&_nc_oc=Adrexdh2TdkFB_y5YDxsS3hKrTC4aTrxaMv6MLFv8OWou8iJDlklwc_EsYFb4aJCdys&_nc_zt=3&_nc_ht=scontent-iad6-1
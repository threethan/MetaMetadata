cAESJge77McQ7kNvwFOaXag&_nc_oc=Adoyh_msjhZLke3Z_qzzaG6addifgIJ1VDHz63OsdA68B9by5AeoOCdKF4MIYIrkx08&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdBPXOcnPiFS4cxmFNynN0I5PcnQfy4CUEfuvQ8ADEWg&oe=6AA55E37"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0megBDQCGkEQ7kNvwGOWMmg&_nc_oc=AdqQ14KTo2PMRDoRlUea7Kf-sB-cJh-DRmIbCZfM5VBszC9pJr7nBuUFh9Q377e_01g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo_27we0AyZPX5RT7-bda_s0feKFWyzg9Qa8pUEb7mvA&oe=6AA55FCA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YjRyLHWBuYQ7kNvwE9waML&_nc_oc=AdqR3fQcAfak2is-t3zqLK96yY0PRWwZU-Q58d2j-UfH39xL-fYMBAexbXerbfSKlZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1Z1GCKS4tAxiYllXGNBSq_Y027CR-8d08qrT3vHxAVA&oe=6AA54CEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7iAY2Hr0FUQ7kNvwFoHjBo&_nc_oc=Ado5qS7XpWrnYmnwxJFnN3XzYjh-UDuzl-OTfnRp7A0b8adDKJ9q4St9D8HwmL6UJBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoBo4Ow-yCILOQ0UVZSqssnnrpQRVhc5aogFAvAfXsWA&oe=6AA56E83"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOhI2lJW3J4Q7kNvwGYNfUD&_nc_oc=Adqi2gZRyznJflkNPSXEx7q06OvbUmmGU8Je6uGy27pKcdrV_0cY_6PYiwMOwpUhVU8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMyTrnTHYsQZ2fleuow4hZPw4H7gcjUGIFJt691OzQMg&oe=6AA566D8"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMemvpPmMdkQ7kNvwEHxe_h&_nc_oc=AdqdqrlC1tNKyVGF0LYT8RVqT5RVnAks5UO-YTtkO1O7EyXKULmEsuUp8QMy7cJoQ8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPNpRGVPvYE7_ofDk6DzACPcEZc3e_fm6b6i_KudkyUw&oe=6AA541BC"}, {"file_name": "Cover_Square_1440x1440_01.png", "id": "1338680584514953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619594_1338680587848286_62080
t=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afs3Umc7Gg227_BpylWapJZaEL_ZotGInBXPEdQ0kDr6Tg&oe=69A1A6B7"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6gG11kmJ3IQ7kNvwEpxFiC&_nc_oc=AdmbAt8x6rQMLhAfR2Tm1sferQwXEtxik38-C58gvcGn1-3MRNr5lxH62uEp-SwyFkk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsMcxBeGh-8EIB4fchfjqX2iPV5ocAR-pY-7uX4F71XhQ&oe=69A1A84A"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBWoqJC-B24Q7kNvwFtOt1F&_nc_oc=Adn7aaXvUbR0ZAT6VSCQrKN1JtPF7cE3VkvFkVUO2h8n37hgnGmcvplJcMYn9t48MsA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuGtt6RWrzw6UPeGqnA6DgZQdWERtUGreEniFTAOGHdvA&oe=69A1956F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DadJRr-LGQ8Q7kNvwFjwThS&_nc_oc=AdnRhD4-RBqZenJbIxz1z4SR6KuZ9MUH2Y0bZrreGfpHotvCL2Z27SJG08eZPGcoSJs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv8TRwxOZkCc-jEZd0pkZdPr3ND7bENCfaWiiJ1kAVedg&oe=69A17EC3"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygU3KEvqMwYQ7kNvwEnqNdN&_nc_oc=AdlpWIga4904gtAPALevuqgwbKSeBJiG3BO7Ph1gCb9qf1jtoN-7Fdk9WY2hpQ3YtPc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvMBAbWMYeLxbm_cj4HVVlUkE19ap8s0fhsOpYLuptOWA&oe=69A17718"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1XDSFljPmkQ7kNvwE2nlxr&_nc_oc=AdkHuMeZQrXrgO6sPtP9gin8WEehPz91Y3KLhYG0WoQw_X-KgldIBvRy_gf48Co7qp8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvyVskUJnEdYVWzAQGt38cbQRppcTBPvyQEwJnrBuoKwA&oe=69A18A3C"}, {"file_name": "Cover_Square_1440x1440_01.png", "id": "1338680584514953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619594_1338680587848286_6208099537495751086_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzxgUsQAZSIQ7kNvwGOP1pA&_nc_oc=AdlWqAMp2160DAP5I0fWrN7fPpQe0Mc3KN3rT_aM9Tp8KDYu9PTAXBqqmJ5mAc159BM&_nc_zt=3&_nc_ht=sco
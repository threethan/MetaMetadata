tFJ2QYxWwk0Q7kNvwHWfYFV&_nc_oc=AdqViLT5uEH6bDTnbk0k9ANqWjk2v6X5zfqvJ6TxcIkYmp2rnhM_EmDGQh21uMVyUNM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YqeYI8GwSHEDSjk6dm0z5pFb_lZQfcKWF90zBQ8qztw&oe=69E634B7"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r85qZHf2ZTIQ7kNvwHI1H5k&_nc_oc=AdqG6u-uAlEnxlFaNGPUajjaYohSxQWGFmPU7mhr3P-ewxZumGQPDCZweOMABqeC6-0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BjP2l9TNyg8hHwA8zs9uew47z8uicB3hYhvYVdYybOA&oe=69E6364A"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKO9NrbKeQcQ7kNvwFNb3uX&_nc_oc=AdpGXVc6YPBLCYyxLFgU8SmPxc_BZ07QGtA3RHDh-Z3DuIEnFy5r5eItyIntjWPevx4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MxlvwUJpXykYYf7jyDI_0wpRGzlnl61c6QvdgpghfNw&oe=69E6236F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHvxc3IhE78Q7kNvwERNlrZ&_nc_oc=AdpcYs4fkmCg-RBmhbNHWtdamhkDu8zAPMtq5f7_ivzSAgVMUvSlI3XpyLNkByiK73g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Qnug1nnj0Hl1q4jsv5IgtjmMWrcUSiCaTPz1tMxkj6Q&oe=69E64503"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ExAkK7kEJ0Q7kNvwF3PunD&_nc_oc=Adq2a_TypeGA6BasEVBVBH1qi2_eMH2MuDmnWXAYvE61nZrCewPXQG0KmZIEC3dQQWg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0384ivXq5LWHafwUWEP5hA1N6nrDk1OgH-qm959JLSJw&oe=69E63D58"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq8-B5FIhYIQ7kNvwHUxryn&_nc_oc=AdomTtWnLcOVD4VRvsyVYVBc6XofxDRv8fARgrwoV8EayMl20x5u-z7HxopEwFf5gy8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a92l7hI98WPG2grmr3tL5PBfdGvo9o0b5KwcnVRUHfw&oe=69E6183C"}, {"file_name": "Cover_Square_1440x1440_01.png", "id": "1338680584514953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619594_1338680587848286_62080
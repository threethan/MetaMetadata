uluscdn.com&_nc_ss=7f20f&oh=00_AQD0I_k6BzDMPKQSSeVOWjITu5OYwO5VAvXQzF5L9jyERQ&oe=6A69E29E"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvKEhR8ONdgQ7kNvwE2Q5eX&_nc_oc=Adpwk-4pwQ9BDIub5U_zNjUk_qdjAPHAAKJvm78N7yRwv5WnLQ4zEt9Pjd9x3T2xf-0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLCFHHL6HcSQ8C8pvgSwCg3Nz9IpB1qig9osbJuuJ4xw&oe=6A6A0AB7"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKFz97bfOcYQ7kNvwHPkEIx&_nc_oc=AdplPbE3OX2U1eZWJ2lc3f1eDB9ltQxca9rq7usF3ObRtHyTCiNccLiDeQ1c-f3T1W4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf425vYfVT-RGvdktgQKPZHN3BHJDNBwOsRcs7mBbSRA&oe=6A6A0C4A"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z41bSGAWukcQ7kNvwG7oYBA&_nc_oc=AdoR-K4nhi22rYMLQEvgNOysRasL-SZKBpfiWf5EHeSz9KnE622KwJ6BNghZFPy3zQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy20kx_MbbX0wmEvsrq0po4HQ3BR2q_WNNGqmJtVtucA&oe=6A69F96F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74rZAj-zyzEQ7kNvwGMjopi&_nc_oc=Adr7NORV8sYGne3NjIm531sCHm10tgpyZAUlcU6rdIge1dqf7HawJN-1EgWLtolXyGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvzKsDNZOaInqXr1fnIamynpfDivx0OYHzb7DBaJKwNQ&oe=6A69E2C3"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPAmTu4qZQ4Q7kNvwESZUzU&_nc_oc=Adr-mxKtyoXtbNWnHqQ-_CH4FhCecNqxcorHKa5M39DGSBtQByyMuVBr8CpSzxyOqFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMyetwEi2M0pnrUYDiJjEFZeJWMC8ereRED9NR0wyiqA&oe=6A6A1358"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehcuTbaQx9QQ7kNvwHgbojo&_nc_oc=AdqE8nPUpdTZuHo18GhA55-ag729OLz3RH5wXFzQrQZfGNZ3UAvid8ZZM8KyHdOjTTE&_nc_zt=3&_nc_ht=scontent-iad6-1
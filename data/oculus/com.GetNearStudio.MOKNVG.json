uluscdn.com&_nc_ss=7f20f&oh=00_Af2if_xMEojx2-NqQiHhl32dA1xOocw-QmZJL6rQx_AX0g&oe=69EF7F5E"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxxN-JOEkKkQ7kNvwGrLbSb&_nc_oc=AdrbIIzFrM1otP3gSU6SuLcIBVGhSO2yR5Z-5nHybHCK8pwjnvw8WPe6bnTKDq1slVk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04gydjBTn5Dkvu-kuyqMsDYuhuQm-J3kmgP6Ew8QfjyQ&oe=69EF6F37"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKfOSHvDkMQQ7kNvwFq13A9&_nc_oc=AdrS7JRVhK9w3DgGdo60ZINOdQOIri82LuLyA4skKgiKUFoH4hxKNk0kAt8RQB6gfi4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1L4dV88U3Jk06Iu04FFlQ_sFsFCLZlpiQxmky1j9SBJA&oe=69EF70CA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdx4VuotjQoQ7kNvwHBKqj8&_nc_oc=AdqGXZ-9H4echt_rLKDewvvrjfN4KXU_ODdOAzSuaQWQoChBGHdmoEmeUoqF5mh2FZ8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EFqWu21J7s7w8iJWxJBp0IvJjNVicaLXV3eYOQKcLlw&oe=69EF5DEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PodEtCYuLXYQ7kNvwGaGjRb&_nc_oc=AdqRFA1hbLyM7f7egW7ymCsmIYQThlSwb9Poe-Qcyze56oxcZuvk8v-i7w5XkGOmAwE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1z6TYbLEx3sSAB2d-cYPqJ9Mqp-nuxG1O1g17jc7haHg&oe=69EF7F83"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZrAm8hOJ6AQ7kNvwF5ptDb&_nc_oc=Adql5pFdZfhxOgXv1f-mLT1W5mBvPZNIqblwN3zGZBvMDjYkgASuGzHjhbfQsp11_H8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ofzeZOE1v87eYdsm12xSbGtNOFz9KO-13vzKaUdUZQQ&oe=69EF77D8"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaGJ4Yl5u4wQ7kNvwF8kR0B&_nc_oc=AdpWZge0V-7SHgvTDc1H2CVfMWOLwAYwJIbY-oJGggOCi4XTaf79-faL0h2wHaRLzEA&_nc_zt=3&_nc_ht=scontent-dfw5-2
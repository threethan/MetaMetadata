6BmmO5X6CNwQ7kNvwE74bwI&_nc_oc=Adql8N-LFjWHJilKKe5Mf038sk0vVn-fMktWvIb0-5C4nbcYQVECDuVe-WzrTa2CtU4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJjlgCqfR-QC2cO77YtDfWQ1fIIeRuw8TXcKjOVVMqfQ&oe=6AE20337"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPzkWxFwO3kQ7kNvwH273cU&_nc_oc=AdoDWkc6BJ20jwZcT6but2ZHWcnz2p56QGj1gl1CoK9OgTgGx-XfeSZt33YK0rgHlaQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsDXn87YfYp7qy6ioJK1xKQsjrm5c2KbWGoFBtduOUcA&oe=6AE204CA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gy2eB4u5WVkQ7kNvwEgXVoa&_nc_oc=AdpRwrddw-jXahtgFoY-WFVabr2CGw8iv4J2XfrkBeQvpK7i4VSVhgTXXXNS6Tsah_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGZlvHDG0sA9qslSllCTM1FTXDSIZBFIG1XE03YImkJA&oe=6AE1F1EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x15NRDGEx0Q7kNvwHYGdcB&_nc_oc=Adodk6btjhust83OBpBI97RQc50urHR3gQtf5EYbpWFXd6csEeoUsDim6ETUDTdIrnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuh-LIDxT5qwXYiz9Foxt4kzRjawz5SlrR2b7mTA6Cbw&oe=6AE21383"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRyuJJE6KqAQ7kNvwFBh5a4&_nc_oc=AdrFoz6dj7l3S2yDdlGGLK0IeVU4wEdz3AiGa3AcF_HLnwm-B9XSNYFvNG7JSyGqoTI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS-ymFgOxN0O9Xg2MZ19AZ2PCOe3oWKOAZ0lk2SMQ5sA&oe=6AE20BD8"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA1Aw3qA_ZEQ7kNvwHaxMsU&_nc_oc=AdrMFcBS-agCOlN9QuUh1wYsj9ZM1LDMz8gmEhtXDyXQ080Nmzrz4niyXssP6l-YY08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOxRBAkzXdS7tdEGmYFVyox4E0JSA_aEKLHN7KDz3teQ&oe=6AE21EFC"}, {"file_name": "Cover_Square_1440x1440_01.png", "id": "1338680584514953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619594_1338680587848286_62080
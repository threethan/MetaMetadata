uluscdn.com&_nc_ss=7f20f&oh=00_Af7UzSvw4K6qbSIC4RWO9Xu7zjPn67wjppjOCVu_gPSLvg&oe=6A05E8DE"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQqIdJ_j6GsQ7kNvwG7qe7u&_nc_oc=AdqCl2ZT0l0HQpnndjRGoN9JdmGSR7cd69Upd3pD_3Nod7Rm-ILwg-_xxAhoIRi6eRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mzY9SlKOg-MNA9rOLOhXptOdRTTiDZpJ7UeUbv8F9gQ&oe=6A05D8B7"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbwdHYzw0XYQ7kNvwG2DHar&_nc_oc=AdpBVeOBP_XEfc6KyD0PJJ6ZszbaE2RuPJvMt_BsHTe44yFFrQfH9CdhdLGWn2xlT8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NQuuP6E4vP-4XMfNUQpeYAipJ3Qvz1yw2i-B-vZ6kiw&oe=6A05DA4A"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2LqI_ia1RQQ7kNvwE0q0GA&_nc_oc=AdpYbYR9tFzrYEqSPHquKy2ctMhSz6CfcD4dKoFJi1QDIWc_Vk6CslhbxeyWJ5ts5Gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZZ8S_7cSKm2SR79aABO3eV5s0QOHQE3qtP6WBnzz5Og&oe=6A05C76F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrBlQxbX-6cQ7kNvwEGk3MZ&_nc_oc=AdpwogUNYIXdapb319JYZuexBH8H7hooam_jivBY3rC_garlmVJgHaLmh1_DQw-nBo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7spG0LJ8i3UN8TSf8mOv21AiwDLKoqDpXxY_x1uAqDCQ&oe=6A05E903"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NY99nDK7xYQ7kNvwHwWO44&_nc_oc=AdrdbjMeSrOOwbXgZcvFwIb6ScadNsoD4MEFh8_dUpQpeM7SPEuWJd1lzuq6paVihSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UPT9lXgR3cJWzN2pVUIr5grB72iZZ2eAn-vU_7I8xKQ&oe=6A05E158"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IM8QuwEn4w4Q7kNvwEip-Zv&_nc_oc=Ado6y80qwRzKgOt7y39G1Q5Jkw38_Y-zV-OKI3a-WBAapuIGPCJsUJgUwUc4eiKqFZE&_nc_zt=3&_nc_ht=scontent-iad6-1
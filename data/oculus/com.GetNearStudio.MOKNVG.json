t=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurlsOGOIPE2X16JIi-ULtWICZPTkticYlTuOa2eJJAdw&oe=699DB237"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmR5WvRZhiYQ7kNvwHrunGI&_nc_oc=AdnbaGSjXrrsylKMz5r3KHTfpnulrWVUQYpW0JD6Pvn0Z9n90QBcV9aNXrp9z02mcDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1VzG6d6NQ4sr-HplsyijRS6ehB13t0MTjbP25m-_lSw&oe=699DB3CA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ucwpv9gFtOMQ7kNvwEQ8m1d&_nc_oc=AdmXZokzBmd_wkiRj_vivEabtWv9taOXw1FH9ChB1mZbYx4JRMiFvCjReiUor59qNQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsi36TkvqQ8ZE94sah43qkdTKbIrpewFTsqbs_cZY-Zuw&oe=699DA0EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LozZy6B59JcQ7kNvwFsxEps&_nc_oc=AdllANCpPUVvlhnXQf9SJ2z_mjE9rPzPdTGjNllx0Zqc-SuZvmaqDGBo5dzlG4JIMiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsT_hxE3AyOQ1o_QLByY5UTW-GMOVVwGClei7eS09HX2Q&oe=699D8A43"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRgnXgfZti0Q7kNvwFJ9SRV&_nc_oc=AdmaOzm4VtcZwuh_xGO9G4LpThaxKmJrFkJMQxcEI9IEjLPIXKBv7qsdTo9cHn60MuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLK2oDVBL2dnJAI_yKHlbM_WWjqsS6kl4B_CxQcCD7Gg&oe=699D8298"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw0D_Fub4tsQ7kNvwGZ6ND6&_nc_oc=Adm5S2Ay7ncfFx1ON7GUKm4ci6p5eL44L751g01Z-tmzsdzJj_D0PaC5Pk-so2V44ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_EeIzvn2GkdvulBS9ii41AYP8gQ-KIhBg65KGXTCIGw&oe=699D95BC"}, {"file_name": "Cover_Square_1440x1440_01.png", "id": "1338680584514953", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_1338680587848286_6208099537495751086_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9gd_RN-SsQQ7kNvwH6AtIX&_nc_oc=AdmKqYQK0Om1Aq4jbUSmf82JK2O8RBUhl6AQiNoUDTrCeRMGRIjFQoZD5r6D6n80olE&_nc_zt=3&_nc_ht=sco
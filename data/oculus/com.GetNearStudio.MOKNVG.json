uluscdn.com&_nc_ss=7f20f&oh=00_Af-Xz1lVz45K4GAhNRNAYNPNj82GwWoks7lKr7FFoYVXrg&oe=6A3BF65E"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7gRL33n4VMQ7kNvwGVMEop&_nc_oc=Adov8bOXOPRijRs3aYp36eCW6HDHbSN2yhyjXex35ibtgm_hFoHABXLxf8B-_DnG0Ig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Unco3n1GuCOmtc1xJWE8-uehF-QJZyged67c6KSg-FA&oe=6A3BE637"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFNaW8lvriMQ7kNvwEIUEZj&_nc_oc=AdqOod3Lo1C6Clatgb55gM4uo_zuvgz_97xmOdPB5Waophxrb6hu6Pde0w7RBHcjJtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_07F9z-lxkZTI9kXPUF7nBRGcGQV6W9HIFGpqezMJFRA&oe=6A3BE7CA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsMUmWsF0Y4Q7kNvwH3_QAf&_nc_oc=AdqO69PYg7t-qB2DTZ9gaDIa1ecinTDKpUik3uOqfvsbMp5Zy9Vytv-ZcDv_8YZcFq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gH2AFi45AUs0H0nj2jb0pjBnjZXbsXv-d_s_fPevacA&oe=6A3BD4EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmonMsTOTV8Q7kNvwGAFeO3&_nc_oc=Adq_aAkVWLIgcCSgHh4UTYhTaPKQplXr3Os6_Xb-vWq7tt9cjXcXy50h3nRVvePFULg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VKosr1DlV8ptyCbfY_BoCbIWT4CgGYQbj5nA01_YRsA&oe=6A3BF683"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xDegfq9nnIQ7kNvwHqWAIo&_nc_oc=AdqLwao4_mhuADXUfHSALnzyMJOE63RradaBVlyf0gSi5HA0nzBMMK2C7CduhJaEh60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YvDukkM1D7yzJ1pECfVvQHRthOeSHXvA6F8-r5yyipw&oe=6A3BEED8"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kuriRXrrBwQ7kNvwFWCGmE&_nc_oc=Adqz55TQGU2OxWINIM0rKusWcRLikHklf3nHOzwikObS5Ntmfak9mIwARdL7-6S8xAc&_nc_zt=3&_nc_ht=scontent-iad6-1
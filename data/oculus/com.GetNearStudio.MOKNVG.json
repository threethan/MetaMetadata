uluscdn.com&_nc_ss=7f20f&oh=00_AQGk2aNiLFgptKkecThGHOV1fyaCLFLmi6EjwN8dLF3S0g&oe=6A97261E"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbVuZvM16PQQ7kNvwG1S6lS&_nc_oc=AdrcEvzW0u_qdp9SoPRsIY7MnRdcILpc7CKawdgsePG-TNCt1J90uXWEBba2i9lMh2o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEueD3ysri80r_bdTnN97hSAZUY3EnW41ta7x4RHeDEwg&oe=6A974E37"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNp__PYktvAQ7kNvwFFyzS4&_nc_oc=Ador3xY_OxRuTjreyZ_uIHzJhzaLmzDeYVit_e4qPC4BAcJ5QdLbuaOjIurs2XJykiE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlyUPZSYT6rdPR2zNyly9EQlSLdRN_FDXYpfwI8oGMCw&oe=6A974FCA"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-Sye7xN7awQ7kNvwFzhpuQ&_nc_oc=AdrbWcnJpWfWj4_RUw2xqeQ_8Q8VTFXPUQMHvVbEUnxVz61uciQL2yQ6cyiGSkWTDsE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn55svgTsfROaNDOB__m1Ijzb6U8CIGKz8ZsROZDyH8g&oe=6A973CEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWdbqODXdAkQ7kNvwEsIAj7&_nc_oc=Adqmj79v2XlUbZt6JcGRb4bnAg7ytnPrcov2ZVF_Ach_NqzelDqMGKpYbgWy9ANovCw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWkYQgR4H4a6agl6p0xEl-_i_d8RHjhtfmLWhmCKge2w&oe=6A972643"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7R_61MxevUQ7kNvwEAB2XV&_nc_oc=AdrwCxygOBby2F7cT9E90e_DK5LDBjdXO43-2zvNY6DaACeDHWwMshARr7zgB1pwAOI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_DUVv1NinTg2Ftrvv792lX4zGnjxjSHTaor2EU_sXFw&oe=6A971E98"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tS9MgniIxkgQ7kNvwFdGKE4&_nc_oc=AdqCaFnHRSqu2_EzPqgcUpKSwKQfjpbsVl3hsDunAiSEYzuAa2qtrFG-MsQU0O-BjAg&_nc_zt=3&_nc_ht=scontent-qro1-2
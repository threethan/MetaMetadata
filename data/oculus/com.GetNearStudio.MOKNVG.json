uluscdn.com&_nc_ss=7f20f&oh=00_Af980tCQtENKNVkYbLlUEQVTMaLrDzwgn0fI6s1oDx9YTA&oe=6A3AA4DE"}, {"file_name": "03.png", "id": "2131092734129191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622166_2131092737462524_8680641054341149174_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7gRL33n4VMQ7kNvwFKOME6&_nc_oc=Adp4KQrQ1mCdE_I9CyiJYjlnBzYukVi95uUogRVKtyJhDA7dwUdlgOVB_qRJ6EvfWRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HTYpRriMCAsOEs6w9ZzzmvgDajbm-_hzIY-sIZaiRIg&oe=6A3A94B7"}, {"file_name": "04.png", "id": "771918482106759", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619465_771918485440092_2131832106720639880_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43Q2DyYOVT4Q7kNvwGVl_kg&_nc_oc=AdpOZfRhHhtax6Bbc1eBs_dVh4uCtTwettaYr5ATjtU6NzXUuAmv54x5-ZpakHfX2Mw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TPa_P3zQ0ymeNkcycyvc__K8c70_OkNOeuyi6cqBFfg&oe=6A3A964A"}, {"file_name": "05.png", "id": "24094775356867679", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298543_24094775363534345_8848995430294496546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8FIQ6Ds48wQ7kNvwFHpzJX&_nc_oc=AdrzlOz3jaJDl02kkma76ZpbrIuASWnIzGaYldwcj43t31e2UHXny48ZKOJUPMOt7uI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D4OpYL0hA96rrao24IxfWPi0Qo3Z2UoObVPh6B2T71w&oe=6A3A836F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MOKNVG", "keywords": ["Nightvision", "NVG"], "long_description": "# Simulated Night Vision Experience\nThe MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience.\n\n**Features**\n- Customizable dummy NVG effect (with color adjustment)\n- Fully interactable NVG device functions\n- Supports both controller and hand interactions\n- Adjustable focus effect and DoF center mask for aiming with optics(Quest 3 only)\n\n**Interactable Controls**\n- Flip-down\n- Forward / Back adjustment\n- Side flip rotation\n- Left / Right switch\n- Pod power switch\n- Focus control\n- Manual gain control\n\n**Current available NVG type**\n- Monocular  NVG\n\n**Notice**\n- Current camera input has a 40\u201360 ms delay\n-  Input image is not fully accurate due to limitations in the API used during app development\n\n- Play safe and watch your surroundings!\n\n**Requred Device** \n- Quest 3 / Quest 3S\n- Must be running Horizon OS v74 or higher", "short_description": "MOKNVG simulates dummy night vision effect with realistic device operations, offering an immersive and interactive experience."}, {"images": {"nodes": [{"file_name": "Logo_01.png", "id": "24692493507105236", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825041_24692493510438569_5662868901094719245_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4LgTZU9a7gQ7kNvwE4tzzG&_nc_oc=AdpnT9NLNudn8iu5UI6Wr0FiaP4FFk74NdtFxHhLMU7DtM3mIsSe6_cUhUS7iQmDgb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_a25rg_YDyHjUT6_f19a0Ukwofj_3W-DraPoGGYILbQQ&oe=6A3AA503"}, {"file_name": "Cover_Landscape_2560x1440_01.png", "id": "1831122448283491", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618984_1831122454950157_3916287305954730484_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xDegfq9nnIQ7kNvwHs-o4j&_nc_oc=AdrwFl-M6Mkf61xO-Q9uHSvpee1DeJuB-B5XeMG66SAb16Io2pO07f0EUoqoRwDQiNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8882pfE3DXmVNE_LC0-Iu7vhzJ4626AnVocsFwIWlkSQ&oe=6A3A9D58"}, {"file_name": "Icon_512x512.png", "id": "1686371038722132", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831798_1686371042055465_2000336760327949752_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yFT72FcE7QQ7kNvwH7RavA&_nc_oc=AdrNTIkz0Gi61RtOpdBrEwzXfSvKVRrt4DAA5Gv5FdF338NWIfAHJbQMmQyNT7aScFM&_nc_zt=3&_nc_ht=scontent-sjc6-1
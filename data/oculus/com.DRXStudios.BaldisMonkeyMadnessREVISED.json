7_3vhBdZl7qeQilecY6WL1ETxijN9JkuOm4JPD97P11eXLGEqLkaek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnm4O8Pik1tzmOYW1vdNAlBkntLCRwjLHbpT7F3JTizg&oe=6AEB5288"}, {"file_name": "Untitled Project.png", "id": "1567299688171549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308043_1567299691504882_8254579298255051800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjWIx1pGBzAQ7kNvwFUHjFR&_nc_oc=AdoAzc-u1SnM81Xqq_uheGe4XC0PmA-9iATZaa0KgF68mkTA9g7ORWsV-4xkzR5hkOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0D8x2Ful7aDLMjrE2w6csHgLgafVSKno_a3Gjy_3Z_g&oe=6AEB61D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BMMTRAILERpixel.png", "id": "2100786467447285", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298930_2100786470780618_2783674799441121026_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsQxBFeN3B0Q7kNvwGfKalr&_nc_oc=AdqKDTAE68SlA9Xr3C8Vc-TC29lQcKeYar-xUbBkLzy5QUK-tVn-jngGGIdfA_O3qRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCOiWde3iJzr7pouVDg74GE4hVgpPGy8gNk_KakUmyHg&oe=6AEB3AE0"}, "display_name": "Baldi's Monkey Madness", "keywords": ["Horror", "Funny", "Gorilla", "Tag", "Monkey"], "long_description": "This is the fun and scary world of Baldi's Monkey Madness. In this game you can hangout with friends, but be careful going into the school, as there is some \"friends\" waiting for you there. They just want to have a fun time with you. Watch out for the mean bald teacher, if you act bad he will spank you. Make sure to follow the school rules or the principal will put you in detention with all the bad students! Your main objective in the schoolhouse is to find all 7 codepad's, and solve each math equation on there to collect them. Remember to keep a fast pace while you roam searching for those codepad's or they might catch you! Make sure you follow the official game rules too, don't get banned or be a bad student or bad things happen! \n\n\n\n
56884", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310720_4109292222690217_6413775653535935667_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AutpHJasASUQ7kNvwEoioy2&_nc_oc=Adoeh5ZCXsGRsIbuR57CpV9CYPTCjwOIl_vB84oMjrNMEvyUoqJrmgkaeXWY5-cbvQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9NtgKERkpHTS__xrhrCQg6_CL-wcFU8JMuwWb_dB2GQ&oe=6B0B2EC8"}, {"file_name": "Untitled Project.png", "id": "1567299688171549", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308043_1567299691504882_8254579298255051800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRITidLsO_QQ7kNvwFdozVg&_nc_oc=Adozjsvgax9GJGIxmQQDCT0n97ll_wbpOsJxEiI9g8NM40yESoBGzwi9ga9c_AiIZ_o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRkjG0Cyzm5wYM6SZTC5Xra4KhpOqXvD3mj9WEmn3QXA&oe=6B0B3E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BMMTRAILERpixel.png", "id": "2100786467447285", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298930_2100786470780618_2783674799441121026_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puZ-KcJys7IQ7kNvwFfpdSr&_nc_oc=AdrmNuMDOk9jeYrBhjZ1ubj0C1X2uc76juTn8lkb4-CatMacAU1xSktBBl-G4CJ8a8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRoLHYPm7Asxx3IH4n3z6Lyl09X5ysuNFPbvsUOVjCFKQ&oe=6B0B1720"}, "display_name": "Baldi's Monkey Madness", "keywords": ["Horror", "Funny", "Gorilla", "Tag", "Monkey"], "long_description": "This is the fun and scary world of Baldi's Monkey Madness. In this game you can hangout with friends, but be careful going into the school, as there is some \"friends\" waiting for you there. They just want to have a fun time with you. Watch out for the mean bald teacher, if you act bad he will spank you. Make sure to follow the school rules or the principal will put you in detention with all the bad students! Your main objective in the schoolhouse is to find all 7 codepad's, and solve each math equation on there to collect them. Remember to keep a fast pace while you roam searching for those codepad's or they might catch you! Make sure you follow the official game rules too, don't get banned or be a bad student or bad things happen! \n\n\n\n\n\n\nIm not make your monkey madness", "short_description": "Hop into Baldi's Monkey Madness and try to survive your new found \"friends\" with your very own real friends! Collect 7 codepad's to win!"}]}, "developer_name": "DRX Studios", "developer_privacy_policy_url": "https://baldismonkeymadness.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "DRX Studios", "support_website_url": null, "website_url": "https://baldismonkeymadness.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1191196734070233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499294616_1393365719281821_3195543597986067179_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4whAW6hotkQ7kNvwFeozoU&_nc_oc=Ado54tsGGzm2IDBW8CgPoTnsQ-SJdI-dRzoILSyuOYqfS4LRvdpM33EmSsgqJk5J7Fo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTms02Rf1jkQcx1ICpvHkL01oJ4clxjyktVBNCSAPpbxw&oe=6B0B31EB"
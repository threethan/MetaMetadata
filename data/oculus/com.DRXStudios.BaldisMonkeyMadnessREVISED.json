56884", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499310720_4109292222690217_6413775653535935667_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzPEE5giQEsQ7kNvwEJ7Ddq&_nc_oc=Adp2EjlLrTHLFw-FO9FWVpHoW75bb01i-1rzCOt3yywKHpmanIEQJDZhqclBnKUpRHs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOwb5ZJWrGjWMcx5wNNNAuv89aKAckEYVHEpFMA5qElw&oe=6AFB2488"}, {"file_name": "Untitled Project.png", "id": "1567299688171549", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308043_1567299691504882_8254579298255051800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DSPPfpFe2AQ7kNvwGAixU1&_nc_oc=AdqLfXvrR1miReqIo-DeNTOq858fUGMwsPY4dzsOCScNAqDdeQQgyh3AokdikWGAyLA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXDEnXCNcf9IxvDFNtR-UlvJ17GwFP3AdfoR_tr7uVew&oe=6AFB33D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BMMTRAILERpixel.png", "id": "2100786467447285", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298930_2100786470780618_2783674799441121026_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CD0ZljWq9YAQ7kNvwH91R2X&_nc_oc=Adr1zsaVIW3E-g6__JgQuapNcW0-lYnvoXUMU_yAducPrjIzkHdZZ6OW61gUXziLLCY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTnZG5uUfy1Q7ggfYgtOWhk5Ibnml14XTWXWZSxSjkmA&oe=6AFB4520"}, "display_name": "Baldi's Monkey Madness", "keywords": ["Horror", "Funny", "Gorilla", "Tag", "Monkey"], "long_description": "This is the fun and scary world of Baldi's Monkey Madness. In this game you can hangout with friends, but be careful going into the school, as there is some \"friends\" waiting for you there. They just want to have a fun time with you. Watch out for the mean bald teacher, if you act bad he will spank you. Make sure to follow the school rules or the principal will put you in detention with all the bad students! Your main objective in the schoolhouse is to find all 7 codepad's, and solve each math equation on there to collect them. Remember to keep a fast pace while you roam searching for those codepad's or they might catch you! Make sure you follow the official game rules too, don't get banned or be a bad student or bad things happen! \n\n\n\n\n\n\nIm not make your monkey madness", "short_description": "Hop into Baldi's Monkey Madness and try to survive your new found \"friends\" with your very own real friends! Collect 7 codepad's to win!"}]}, "developer_name": "DRX Studios", "developer_privacy_policy_url": "https://baldismonkeymadness.netlify.app/", "developer_terms_of_service_url": null, "publisher_name": "DRX Studios", "support_website_url": null, "website_url": "https://baldismonkeymadness.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1191196734070233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499294616_1393365719281821_3195543597986067179_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE-gRbC9lt0Q7kNvwHwc1Z0&_nc_oc=AdpYLkJkGmTHf8p53kRus97biNz2oJdO71niLwbqMAwkbTxt7awZ7swIcVEtU1-UeFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIay84wWqg2S1a1NVlRdFSMO3fJBjEzIRVpdAOHAeE8g&oe=6AFB27AB"
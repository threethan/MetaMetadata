id=6e7a0a&_nc_ohc=apixEQxs4PkQ7kNvwHHBcbE&_nc_oc=AdrAys90NmcubLgJA9l7b6fJfvQB0OV8Q4gOa-4PUsQWwTJHYPUYEnE0naPYccY2sAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4yQZbd2KFDMlEycVyEYCTq_1p3a188dkGQzNxKUUP9A&oe=6AEB3F45"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2fEjMAXRe4Q7kNvwFHOzZF&_nc_oc=AdohXrcBeStemkBdYTVtQKsbR5cUAr7ijkVs-N_4UflcWyg3ZOk1vjmB7Ps3LFFzCPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnG6X2EyCCQnneAKxYYQmZ7NXr4fE4Ge99fu1ykPSKJw&oe=6AEB36EC"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvNmefRPFfcQ7kNvwFaVEor&_nc_oc=Ado7wHmVdooty-itnj_g6x0NCAaIhe1ajWiyJdLVzdK5w9qliFgXusjHJPm3K0XQ9wo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUizV-cE3ebeM4c0_OAUoy3_kAVbAuxgJDfwkIxNmN6w&oe=6AEB5ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QEq2SA8zrEQ7kNvwEaAXPA&_nc_oc=AdpzplFlpi8YTSjM3xNwOF_wg1T5fZo9edcga6iCw-EZNtN3419Tot6lPUDqWVFSfKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-TpNK3AdgC1DwqY2HRMf2ohaiLF5ad9iDWLz47WRg-w&oe=6AEB3303"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
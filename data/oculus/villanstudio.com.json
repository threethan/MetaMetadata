SsBJu4V-VFVr_eSEOEhbHiOpG0QepkrOeXzeJ-kqIIg&oe=6AFDC797"}, {"file_name": "ScreenShots (2).png", "id": "975514188249584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_975514194916250_2228179739275399629_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhhPi27nTn4Q7kNvwHw4G29&_nc_oc=Adq1u-hedrDj4PklchrqmMKpt1p3Ux4_W2MZwGnT_t39z2N3jHdLDwF6u5H9m980Xlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Bnhhkf_fNPrT117MxLdYUURwwsN70eCsi7kmgrIZ0A&oe=6AFDB445"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEmqCUUIes0Q7kNvwFEFwAY&_nc_oc=AdqSYANFEPqqAu00D8izdhsPFf27gtPbyg7pXgQ_y6P8RByFQ1925YK7Fw_yMv0OszU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXviz9XVaGyzExl2y77vx6_zhYHh-0ZjAwqOv2J7PNAg&oe=6AFDE42C"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dhmhEwB0hsQ7kNvwFTUKxp&_nc_oc=AdrxWc5I8PkwI0u6_9UApkNuw_B9qGx2KJI-BrBNtj870rjN1k3WuLeKMXVzsejPJh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeMPuQ4kDlpYgbdNfocguO9E4-9mwjOKqaIMvK7Mf4ew&oe=6AFDD3D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuUfAzFM1XQQ7kNvwFG0jKx&_nc_oc=Adq0scUPE9Y3jhTWtqmuWbxLjW0fFuuddMs24IrxUf7Ul-mUKllTa9vn5pk_8X7YBNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJQ7BubcsmdVyikytYt4_D2-4STJQgCUlMDusoX0P-kg&oe=6AFDE043"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "websit
&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C793er9RA3oQ7kNvwF1nsv2&_nc_oc=AdppXPdRJJUtQ8ZIBEHbaZiaVFGdKzLpgl6W2SLgwfQEglH-joaC_zd6BEtrPbuNEW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmJNFt-lM-k-dQCNkUPdSpPi7YyVr1VUv-I1sQJlIpDA&oe=6B0DB7FA"}, {"file_name": "Screenshot_3_Level1.png", "id": "1898082491542378", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_1898082498209044_35986959012872118_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byQEir-PtYEQ7kNvwFih7CQ&_nc_oc=AdpOd3W446fSVpGtHlxx4AsZb28mwp7GIobWRrMMmSbzBAjQs50Tw6Oqvi3awfMWcCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVECN6A5bD82UyiMRUwB4wx-jfpZvQWlMaz_nFXeBSpQ&oe=6B0DB96E"}, {"file_name": "Screenshot_4_BeTheMonster_Carnevil.png", "id": "1911333733568806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_1911333736902139_7439741647485112301_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWaW4jWuF6MQ7kNvwG4XHnW&_nc_oc=AdodP0hwbyZzhHMwRF4NIr1W8h10hyUaaPu13i3lhCODafK4nYcZqPPCEJGBRgkPOeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRo6zuoiXzLR0jtpD_mp3uvDGrc7bDNqMjpN1JPKkjpOw&oe=6B0DAFBB"}, {"file_name": "Screenshot_5_Tag_BooglyFurnace.png", "id": "2184358135529025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593714175_2184358138862358_3781450485857413450_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEq5jBi2c4MQ7kNvwH6Doeg&_nc_oc=Ado9WGFdEFD4603oGkOigiODQr9e1-eJ9rzRcsLNdTAjVBj7LnVAkl5J64HDsaeKVX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzLr0gdGfgoBVQzJLgpDdqQ3qZgPyJCMmzPmpTKiXpjw&oe=6B0DC24F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYdqBnRdZFcQ7kNvwG-5yOR&_nc_oc=AdoPRcbc0RP3QLyXLo2i6PUZZgGyxNF2MB60FRnzQmPHlstGacyXWWqGnnrH6vspWTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0Jv7d2PLVcCtMm93mS5zqsNKIGmcDrE0Pi3QWT0004Q&oe=6B0DB243"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29084075157908744"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619369_1941331173503635_819189173646829121_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFY8TP6Q2iAQ7kNvwGmfSUF&_nc_oc=AdqhTA7A4CwtrHwLa8CZCGC9XkLyLGWjGlTHyVy8RLZiQy--xwq8k8qhAvKWX8wyZKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuXmOIMfBJcpEPcHoBljl-h-Qx4gUjcX7vY51ZjvWJlg&oe=6B0DD2D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OoglyBoogly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1722151893, "lastRevision": {"nodes": [{"id": "67559603744802
Z30_QepQV5ZlaeXbDUmni_92JOsZI_2zDBpYY7Bb-UQ&oe=6AFB2497"}, {"file_name": "ScreenShots (2).png", "id": "975514188249584", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622214_975514194916250_2228179739275399629_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ry-ylKbfoUQ7kNvwFS9K5i&_nc_oc=AdoVs1RbNbCmAgMRoo2R8BUnbUgkIoEMEBdakiFzdLcEG-yYgjuJ8Z5e75LLkvjVT4A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_eSKbIdi71-MO79R3sKqf9hifq0ds6peRuc8CMYkpOw&oe=6AFB4985"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhJapBjw0kYQ7kNvwGKaP8R&_nc_oc=AdoCekNJkbWbrSm1S4lqY_2e9e9GIxlQAZmbujHPEK-9AoMc1cPinwswyo0ftK5PIZM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-ROAyKUOo49yuHK3x374zD3STHRjhXafsc1oazV1PHw&oe=6AFB412C"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0rH7Am2pW4Q7kNvwHDtv8w&_nc_oc=AdrxrEHchLHQSnXGdGcdPagJY7H9hcKYkSVXpgzrwJA_1NNiYxxIpLpVUleMXR-ElkM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO9gZk3zTMgE2SzsS2PqJ8yP6BtMPY13Al9nRMpnWoUQ&oe=6AFB30D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miAHr4e-JhcQ7kNvwFF5Wh7&_nc_oc=Adp4CG3HbCC58_yQqAQHhLinTNikVTwvc-nlwD9LDYWOdfNefDn1wE_jP8ELfC8mrps&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn3MShXVRg8NxL10UxkxeLc9vY52nZGZRGh7_BaVoUiQ&oe=6AFB3D43"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "websit
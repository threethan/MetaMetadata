oe=6A6E00C5"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0wPZPPzzIQQ7kNvwF0biSp&_nc_oc=AdoASu__WgSS_Itd4PdtfNfhZ0hzEFb6coKCj-Lu38whz5hCY_KPnvLc01Mq-B6Vwxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD20h-iJHMwM9lvxv6NUNoZWpWfZ8tuIN5SGW_MrNJ7aA&oe=6A6DF86C"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBJO66id2S0Q7kNvwFGVOUo&_nc_oc=Ado_38-IkpUBXUDGaszvfEkbQX3ZmtRHyOzsUQmdO2cW87ic0IUgN7Jf1Xtn-CpNnZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDInbNSFIp1D1JzO6vJRwwnsqsktbxTE7da87d5L2Yvvg&oe=6A6DE815"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqnhxeQ8r7MQ7kNvwFWCsgm&_nc_oc=Adr_3_KvtbpfzGLFwHDff9CUTvnzJv9rhkfY-xrGP3qTHTdUUt2jOPLWfBtcp2VMuks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARrjP06hPH-ib-UtcpsnbapEcVT7y0YcWNsdowtlIkgg&oe=6A6DF483"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
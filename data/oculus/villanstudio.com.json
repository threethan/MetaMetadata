id=6e7a0a&_nc_ohc=I2GQc2Qm2y8Q7kNvwFfyAh7&_nc_oc=Adq-nm1KklQicaa0ejT1WoUPK4y5Tcyk5-SaMl-d74lb9d5CF7Jhww4VnPt8a8y9t3w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeaBvjV_qumdy9gZ4oiI_aD4i_1PBUhai3DIN0-NQkIg&oe=6ADCBEC5"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59FCLc_mxsAQ7kNvwH0o2re&_nc_oc=AdoZ2NZbOwzH360gJNrwWv9-21fOFd_rWr3v33vvZvDqmDe_Z3MLCPIlOdpMnmLHbpQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9PkmjBk9i_IxAh5EtFf6s2xSJyJ2gM0PUx8rvp_DyYA&oe=6ADCB66C"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0zbKibKvdQQ7kNvwGnTs0u&_nc_oc=AdrK0VxA7dAS5EO6OnBiH1JLScsntP-sboZTGq6V6qKXHdO5N3jeqWEGLni3AseSmTM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZWhLmt6ort6r8PX083M4mXsAUNR0_dsnxPO8UFNGq8A&oe=6ADCA615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWmcpzYFOaEQ7kNvwGf9tcm&_nc_oc=AdptLnvx_GTZrhQVIIqCsNQbAWqrLAMrFEEtF4aLmmBOmOVrROlfSRl0hpU0uBVzk8Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNcVvAZtzaH8WwRh5E_Gd9CyTv2AJL29NLLqNzovCbpg&oe=6ADCB283"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
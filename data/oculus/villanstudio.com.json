&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFBFw_K4rFDCUad_He7JUheRzUkJyCEod0mJck8ppxow&oe=6AEC90C5"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvcp0d12O_oQ7kNvwFYojOO&_nc_oc=AdpSwsOAp5SEJAiA8QaFGSCIxbo0PILLHC7CeUdFIH0W_PpnzEleO2Pj-glxpUGF2-k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKMecZh9uRdD-HispHoWe67K6ttxqbqS3jRlUfLPvWnQ&oe=6AEC886C"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvNmefRPFfcQ7kNvwHAK3bb&_nc_oc=AdrhW6al8WkL5Mza4TaVsj-CaEDJ3pTq291kZ1hCwYuAYUfqd9kfvrlpHD2v4ulwf3s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzP9MDKrUK-pYhaTUKzoIsc6xqp-4MBMdIlLiy8p26KQ&oe=6AECB055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Gy_mjdMjYQ7kNvwE_mqQV&_nc_oc=AdpoYbdPriuNP9-0BaURrROYGIxXzW0DmxIGrO2b-jtYItnEUWigISmKU2u_mxWhHfw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoU_UyMgSmH7pjJ77-iRx2EA8omwYXI0X0MJGpJMT_8A&oe=6AEC8483"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_
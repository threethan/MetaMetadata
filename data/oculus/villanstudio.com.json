oe=6A6F5245"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0wPZPPzzIQQ7kNvwEOxu3p&_nc_oc=Adq_Z_SVhpZCATWY-G3a2DEX-GMyfb8eN6N0X56_D_VAyrLZ6nrC-JzJi5KJsKo9NpY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhw9R3Qho7rwEh_yN8bDFyTni6jAq2ZMzUy6SZQ_khZQ&oe=6A6F49EC"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhvAVdLXGJwQ7kNvwG3yTe1&_nc_oc=AdpiTl7POfo8IOgKUwWqAGf7FZafELntDi3mZu6yFsW73eX6RdTRL3CjorktNb21dqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsAfXZYAozImckSlC7tBQh8d2Sz0bz7oRlGFXyx4Palg&oe=6A6F3995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqnhxeQ8r7MQ7kNvwFFNsjS&_nc_oc=Adp2bquqeJ6rwwgJ2-uLdTdJjWYtDM1Tmgg6xAHG9tbOR0dQ3X6xJeiI10M-pKPs2lE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuexTulQocELXVHbZdRq9ZmpdZd0TuldDKnCIKZKxHPQ&oe=6A6F4603"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26983930461256568"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623384_1630314884718576_7669768382778902011_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upm9paGqL-gQ7kNvwFnhSED&_nc_oc=Adrjq8RhAdwvFtreAr94E3gd16cYLB3AZuARh3w1HYB5YElVu-YnsauX8xfQLorjrFc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzT0-JmZEEgpjEwMa4lEKbX4AtVKZp3SXgZ0VsqJfv5Q&oe=6A6F3EF6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OoglyBoogly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1722151893, "lastRevision": {"nodes": [{"id": "6755960374480208", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6755960357813543", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "536255091899253"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Real Scary Cover (4) (1) (1) (2).png", "id": "1629665841177585", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035361_1629665844510918_7897430557073865097_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bSFyYxBg0AQ7kNvwFrWKHq&_nc_oc=AdrUkZgem5aUq-s7yZzD_wSjg6Up3hCtBovdTJI6JOBGPkOB0C2q9BIvMSXeTMLeAcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAic-K1Tu0zuP1hZqV8C2TRBCyEr8pTPv-qfa1ISzOyiA&oe=6A6F5B5B"},
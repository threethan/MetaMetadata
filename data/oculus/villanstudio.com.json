&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vpa-s_SAK0AQ7kNvwEU_hDv&_nc_oc=AdogeT7xjDBCKJWZ2jawU7dzBAXaP6DPDRL-mexQJCAF1ibbKoT1aAkTgC4B9W3Y5ww&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4IHJZRXwv1BkyazCXTlwww1Jzw4iHf6xrPJRB7u5HrQ&oe=6B09C37A"}, {"file_name": "Screenshot_3_Level1.png", "id": "1898082491542378", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_1898082498209044_35986959012872118_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPFOEl2YS9oQ7kNvwHATSXm&_nc_oc=AdpeCgZh9A4V_uqlhGuu9Nq-rY8yM6hF-UVZ3wYkjFExwQQ0alUVqglLKrjQfBS8n9s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXFCQ1Mlm1HoqqnYMUK-uxDpqpm9jm_vObTZhz2EzW2w&oe=6B09C4EE"}, {"file_name": "Screenshot_4_BeTheMonster_Carnevil.png", "id": "1911333733568806", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620655_1911333736902139_7439741647485112301_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myXyupobv7cQ7kNvwGllVC4&_nc_oc=AdqCnt-2ZHCY7Mwq0hJoorisNrerFdqYb5Swofis4TdIgI44SNzOHhRMHkFkhF0Lczg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMUhRiWG67dTvr-OtvXpTZrgjLsO-VTN4sHPHAJDB3ig&oe=6B09BB3B"}, {"file_name": "Screenshot_5_Tag_BooglyFurnace.png", "id": "2184358135529025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593714175_2184358138862358_3781450485857413450_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adCFsa7059EQ7kNvwHYZU5s&_nc_oc=Adqbrso706se5vpgKvsyp5x_bZinM4WrJTh77mbyrh6JZaXrb8L4_FB2RFSg5P-_fag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzg322VZUkQ27HrTOs8K78i0pIipeW2cFCs65NrJGZfw&oe=6B09CDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeKRiYqElokQ7kNvwExA1tL&_nc_oc=AdqtN63JNcqVKBHEr6eWNK-F7YGtW-h-FQOMY9MGJ3WAdhwNjC7R6feOx1lsNN9V-JQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIb6FWKWDnFkc5A3uPxPh-59wVHIcbAOIrve-1_DTvwQ&oe=6B09BDC3"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29084075157908744"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619369_1941331173503635_819189173646829121_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioOdR9fG0nwQ7kNvwGYxfWJ&_nc_oc=AdoshLq24-X5bpsjPBK_c0u5qvHksgHj-cv3wTDMs8TMCdl1Xf1EHlOYTDXdl9Ac0BY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVlJMkRO8NM3SRHJxP45UdEh2JorGI8sjEMRcdgbPKWQ&oe=6B09A613"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "OoglyBoogly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1722151893, "lastRevision": {"nodes": [{"id": "67559603744802
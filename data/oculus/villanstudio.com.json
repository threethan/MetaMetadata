KEy94B6L-N5Mm6AV3g&oe=6B05CEFA"}, {"file_name": "Screenshot_3_Level1.png", "id": "1898082491542378", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620384_1898082498209044_35986959012872118_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnGKnvMaunMQ7kNvwE7s7jA&_nc_oc=AdoOS7IxSBpWXAF92eYMVMfautPSZNiesnI_LP5XRTAPRVsK2tQmN5gjUp-k9SGJzaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSjMzDZ7RwNq2-iiev22yCMM5n6u7z1Juf-z0Hcu6TAg&oe=6B05D06E"}, {"file_name": "Screenshot_4_BeTheMonster_Carnevil.png", "id": "1911333733568806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620655_1911333736902139_7439741647485112301_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-_5punZrGgQ7kNvwFfIHtF&_nc_oc=AdovsLVgQiMvzzNGQ6rv1m5LKmeIxatgxlsguwPVaqWZQwxQQ5TeCt3ycXgEPD1NDyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlXDojg0FnT1uCQ-eSd0xJiC7yAKQqvh5vvZzLjXUazg&oe=6B05C6BB"}, {"file_name": "Screenshot_5_Tag_BooglyFurnace.png", "id": "2184358135529025", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593714175_2184358138862358_3781450485857413450_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfwXFmDUcgkQ7kNvwHLf3fx&_nc_oc=AdoHPyR432tUE_tSQqzInb47rMIjTnyZn4Ii2yVqpyBs9G1dl10wnnLE1Rf2RDl4MsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDQUEvJCDFhzGIHVjSSajsyJB2DCjSLq06j2jfe8t-_A&oe=6B05D94F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O0OFek3RzQQ7kNvwEA9171&_nc_oc=Adrycgv7YWDyKZcX3q17qNknDwMMuofgFPBi5PDoQCzsG3W5RTqbDQiKTD-hJGH-Kxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4qfmCC8bLQE3aWWlJZ-1B0HwbwJOftbh78-9jiZQFnw&oe=6B05C943"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_
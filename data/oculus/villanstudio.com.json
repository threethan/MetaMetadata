=6e7a0a&_nc_ohc=zLDqjwl3d20Q7kNvwFMalLD&_nc_oc=AdpC05lZ2J7xBz8GJfz2HLD7zwpYJRiwgaG2HVptsJSePdJWgqbOwV9nGzPUdvEX6Qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdSiqwsYudBuKmX9cRfHuBMo5vfpNTlowQefaalSyMCg&oe=6AE204C5"}, {"file_name": "ScreenShots (1).png", "id": "773981352460569", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_773981355793902_5052438913793746878_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r1P2wLvMP8Q7kNvwGQKCgN&_nc_oc=AdrBaIejUK-da2IZTbRxslDf0POvUR07tRT8MDcdPa0LaeS3oAAGRNRh51Re1L7nTWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlzTf1zFhM1HRps0ZOkqFmmQWNrF0OOP5BVUTJzbPZEA&oe=6AE1FC6C"}, {"file_name": "ScreenShots.png", "id": "1637587480848258", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620432_1637587484181591_8791895900705633060_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag7kPbwmuccQ7kNvwHpK_34&_nc_oc=AdqsgZGNZNwIcMFA6RNKaV9tAIaHVO_tY6v3pMeHe99l18CGULHkAbJEEJolHjEtQmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrqlFTwPE3I_6S3eHDVOAuLqfVX9him_TShJ1tVuD1vg&oe=6AE1EC15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer.png", "id": "1639936273673048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619145_1639936277006381_2557711803358762763_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1woBWad5j8Q7kNvwHLC7jz&_nc_oc=Adod4QrjW3xEs55zS1KMC9Du_48ulAR0eXiNyrxjHP1k7ALBpxEtozlt76LSsGLpsec&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxkKXgX-pV-etsQzuFPiOsQ4JDXjFT4PKvHgRC_nNP9w&oe=6AE1F883"}, "display_name": "OoglyBoogly", "keywords": ["Scary", "Gorilla", "Tag"], "long_description": "Oogly Boogly is an intense VR horror experience that combines fast paced, physics driven movement with constant tension and fear. Inspired by the locomotion style of Gorilla Tag, players use only their arms to run, climb, and escape through dark, unsettling environments. Every movement matters, forcing you to stay in control while navigating tight spaces, open areas, and unpredictable terrain.\n\nYou are never alone. Something is always watching, learning, and adapting to how you move. The creatures that hunt you are designed to keep you on edge, reacting to sound, movement, and hesitation. One wrong move, one moment of panic, and it could be over.\n\nThe game focuses on immersion and raw player skill, rewarding those who can stay calm under pressure while mastering movement. Whether you are climbing to safety, sprinting through shadows, or hiding and listening for danger, every second is filled with tension.\n\nOogly Boogly is not just about surviving, it is about overcoming fear. With dynamic environments, evolving threats, and a heavy focus on atmosphere, each session feels unpredictable. No two encounters play out the same, making every run a new challenge. Adapt, move fast, and trust your instincts, because whatever is chasing you is always getting closer.", "short_description": "Oogly Boogly is a fast paced VR horror experience built around physics based movement inspired by Gorilla Tag. Navigate eerie environments using only your arms while being hunted by unpredictable entities. Every sound, shadow, and corner keeps you on edge as you climb, run, and escape. Master movement, stay alert, and survive the terror lurking in the dark before it catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ooglyboogly.net/privacy-policy", "developer_terms_of_service_url": "https://ooglyboogly.net/tos", "publisher_name": "Villan Studios ", "support_website_url": null, "website_url": "https://ooglyboogly.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
842244_1158068823231422_4782633979987118485_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4-XAMUDWAMQ7kNvwHDPI2k&_nc_oc=AdqmqpQvzDqhtT4mgmmkCkTBY66HKr0BHjl7BzFgXzx5gBsCpB0iioQLEAxGb_8ng8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFYCNWXLNVCSoomKU8Nj9l6Cmh89z61utnpU_OKrHEyA&oe=6B0DC98B"}, {"file_name": "02-lava.png", "id": "1412994390817312", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842237_1412994394150645_5049001309761467190_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6XflsQ4rx8Q7kNvwHN1ExC&_nc_oc=AdoAFdQVA0yC3X-Aw7bBSfdwXEwR4dPat36k_PWDhDdtILoBRgxvWjeRvI0qben1erc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRreKUjeV6E-bWRiyibmMLb3zseYc24jNccTQ1mfF7NAw&oe=6B0DA68E"}, {"file_name": "03-chain.png", "id": "1127653043221633", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842276_1127653046554966_5362851020392531194_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUSdaAM-e68Q7kNvwFtndKI&_nc_oc=AdqqsoXEwSg5PbRu7n4I1sRbG1z5l0bKYsNPK-U9GBSeB8szxd7B_yNgXnpIZq9H-xE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSafI7mHVbupSaNN7MnRtK_s_3UpfZeZKs5OSdswRi6Zg&oe=6B0DB091"}, {"file_name": "04-complete.png", "id": "29800613452865280", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842261_29800613459531946_7949265758048601178_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgOVt2a4IGoQ7kNvwGuCXYh&_nc_oc=AdqMhJEYkWN0U7UkGVGPu9nixbEl4pcW-_5y8W-OmPqhgI5nx_XqQ3To9oupMXAheIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7fJIYRmRmHM-4OJ1MuCpATX8ZV9HBF8LYulM8aOtSGw&oe=6B0DD0DD"}, {"file_name": "05-vehicles.png", "id": "1668059307996049", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842234_1668059311329382_3308074763175626539_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiPDem-hyhEQ7kNvwH1MKcG&_nc_oc=Adprz20nfijE01w580zIObzjWwQNWXxn6HcbnyknFLOeIrR9WbuOUnL_iHSwUdcFvgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUjl74Clm3ahYP0wDlB4Spyzu1K62yCgaSXPE3p2amrw&oe=6B0DB506"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MemoVision", "keywords": ["cards", "matching", "pairs", "concentration", "brain"], "long_description": "One thousand levels. Ten worlds. One board at a time \u2014 can you hold it all in your head?\n\nMemoVision is the classic card-matching game, pushed a long way past flipping pairs. Every board opens with a preview. Then the cards turn over, and it is just you and what you managed to keep.\n\nWHAT YOU'LL PLAY\n\u2022 1,000 levels across ten worlds, 100 in each\n\u2022 Boards that grow from a gentle 2\u00d72 to 42-card grids under a clock\n\u2022 Hundreds of hand-drawn cards: farm animals, forest, ocean, desert, savannah, tundra, jungle, vehicles, dinosaurs and deep space\n\u2022 A twist in most worlds: Timed Peek, Mirage, Chain Combo, Freeze, Shuffle, Mixed and Lava\n\u2022 Boss levels that tighten the clock just when you think you have it\n\nTEN WORLDS\nIron, Bronze, Silver, Gold, Platinum, Emerald, Diamond, Master, Grandmaster and Legend. The first 10 Iron levels and level 1 of every other world are free. Unlock a world with a one-time purchase, or every world at once with the All Worlds Bundle. No subscriptions.\n\nBUILT AROUND RECALL, NOT LUCK\n\u2022 Three stars for clearing a board in the fewest flips\n\u2022 A mistake allowance and flip budget that scale with the board\n\u2022 Stuck? A reveal credit shows the whole board again. Your first one is free.\n\nQUIETLY RESPECTFUL\n\u2022 No ads, no account, no tracking\n\u2022 Plays offline\n\nPoint and select with your controllers or your hands.", "short_description": "One thousand boards of hand-drawn cards: farm animals, ocean life, dinosaurs, vehicles, deep space. Every level shows you the whole board for a moment, then turns it face down. Find every pair before your tries run out. Ten worlds from Iron to Legend, each with its own twist, and no ads."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/MemoVision/blob/main/PRIVACY_POLICY_MH.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/MemoVision/blob/main/SUPPORT_MH.md", "website_url": "https://github.com/Meshy-SC/MemoVision", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2064089984302903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908842211_1438668591715115_8609113991286703522_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvMkfbP1gCkQ7kNvwEBeKbq&_nc_oc=AdrIS7UyHnbn8QPa1uGnIuNVoPB-MTlOHTfEpC_4Oqc0WZjueNztAE8OawnKNxkHkvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdFZEtYt0mwNDlH3r3Sq9L5NVB_YAzIHVT-Wc_V2zSyw&oe=6B0DBEBC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MemoVision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1795265700, "lastRevision": {"nodes": [{"id": "2064090000969568"
s=7f20f&oh=00_AQRjD91iPDwiqzV7IZDQwwDWvDigpp0ISG4-MMDJ44o5Ig&oe=6AF347AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cheyenne Frontier Days", "keywords": ["Rodeo", "Western", "CFD", "Cheyenne", "Wyoming"], "long_description": "The Official VR App of Cheyenne Frontier Days is bringing you an immersive, all-access experience like never before. Step into the world of The Daddy of 'em All with 360 experiences, behind-the-scenes, and footage from top rodeo rides. Get a first look at the brand-new concert lineup, explore the rich history of this legendary event, and experience the excitement of the world\u2019s largest outdoor rodeo and western celebration in a way only VR can offer. Whether you're a lifelong rodeo fan or discovering the thrill for the first time, this app lets you relive the action, tradition, and spirit of Cheyenne Frontier Days from anywhere.", "short_description": "360 experiences, concert lineups, footage from top rides, and more\u2026 all together in one interactive, fully immersive experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://westedge.us/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cheyenne Frontier Days", "support_website_url": null, "website_url": "https://cfdrodeo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mode
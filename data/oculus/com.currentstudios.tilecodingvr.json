460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0rpkB5EnUEQ7kNvwFxSMzY&_nc_oc=AdnG7Ozjf6rhhrwsl9j0AjRxGOPmd2ER63-k_ZQub-mEZoHbcMnQmH8opJqD63M3cV0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiPSFaRsZ5F1qEbK3-dC4MAmb-ziwJvCNhCmz-U_d8NA&oe=69BE7F23"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaQAxJ-C4sgQ7kNvwGcka8_&_nc_oc=AdlapXNuTEfPKdJqzk4VO1rkD6InGTObABD1AYGDaCgpOpIiDGnTDMBInplz82s1aPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfysBZ4dC9xiKCEHsETwzRqMjdRFv48ZzBRg8mh-UfO8aQ&oe=69BEA6F0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGKyNZxl8-UQ7kNvwH5DW8S&_nc_oc=AdkohBqIL_xgOfraVXZPtd_KDLxvg4ziVNCPjN7jkIfGN2lZraXjLtJNRITwNxGztq8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK-Q9OYsHO4t3d_AXlfwcLBCg4zpDclqtIbZG1B5PXvA&oe=69BE7E5A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCvBct65E5sQ7kNvwEDz9_t&_nc_oc=AdlyPbtB6iB4Eh_MXxFJNNOcJSDt-YSqrSL9Vev9kpnArahlF3lJ4v1_sucs7Y9ZdsM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrPxrxU5aLYZKyJRCLskzyZidjg-aewL9Im98fGVOP9A&oe=69BE89EC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qroOg6uJnokQ7kNvwGPXHxu&_nc_oc=Adk9TNExL9FHNi1WL-Uy2A543H0Lb8YvHh0GZTTwj3a71x1DC8bGod4BkeG67ia3eMU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmOszG1dzxyNDRr06vFuLjBuUtfwyAQWQQFDEicT4bPA&oe=69BEAD18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
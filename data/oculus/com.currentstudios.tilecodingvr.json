460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEWAP_AnbBcQ7kNvwF-Jay6&_nc_oc=AdljOlMiZ9qK3F09lTtIL1tavFrnPm0i56hH4q5nrp86a1goWmDa17-oCEliuATaNr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGWzYhCU59Kop7kMTs3T5Zv_Zp45VhZjVTaj7tuhHW8g&oe=69B15023"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi9Zw80QFDYQ7kNvwHoeNd0&_nc_oc=AdmQraR0kAMuVX9PU-RX4CTscxQS7he6RUyaoYFRSG67O4xJDDRHsvZe-IYZYEB2P8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSV3x_D3WG42MrviaO52VY3YCkCBgybnFG2l2gaSetVQ&oe=69B177F0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gPK3sHPwV8Q7kNvwG2Ki8h&_nc_oc=Admje_aqRgzW4tMckWDLwA9ftnCDyG0AD_pGDY_BxWqYDPDkWeUEqf6bfNtxOGUHPyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqLBzsm6rBePhLqj_Uhi0VGHXj-tGIjAjRqSRfKAgLUQ&oe=69B14F5A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeInZq62vp0Q7kNvwHiavLR&_nc_oc=Adl2ZbMmtlMFmE3iHrktb201lpsZpLa2NpVR-njXzVjKg6kKn0WNgX0m1sfuO8sPvHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3Z4WCSMwCA0UnanxLma9bzIBBDE-uBd_UwVXGyGrEMA&oe=69B15AEC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWSKCXPtr64Q7kNvwEdQ9eM&_nc_oc=AdnhFhLGz7MtnjhjCbuTxwa5u89XLZjZ-ld7IgLzgeu56AE0SKhPE8uL13dodSObB2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAFJuFcsp-n28PNLDGzt7_xM4REJ_QN49u5HfYVV0Epw&oe=69B145D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
culuscdn.com/v/t64.5771-25/38984460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSNf8YFVsbYQ7kNvwHKkCx9&_nc_oc=AdqjktTiS7IPR3s2D8KQ9j3Ok480weKiRqbRpv7pn_6YIC-y-rLFYG1BZX6Bvrij72k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Kw0ahxtoDzhq0cdNEfmP8MGqUqOiv3hNSl9Hsdt6wQA&oe=6A36AFE3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftaIhplqO_AQ7kNvwGgu_rp&_nc_oc=AdrFFDretEf7IXxtQYu8Bdzr4e68yRI7jXWJT2V4jmPvBmp8yMpneLBmp3xf1ba0Y_Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r5zP5nPoJzyJPxjfLO-7WDGWn_ivy0CNebnjRMzq8iw&oe=6A369F70"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LhhZa7-BS0Q7kNvwHC_CLr&_nc_oc=Adp39ZHhOZunCu-N8Y5xWOLSZ1AUUoxwcoVMJE8_Zkc3vhJvxjkctrpEr24Z91w5ptg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6UKkDGTYory52P_g1xZ5m1sCQntpcAgESOHjFxDzTmA&oe=6A36AF1A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NeyMUuSbPUQ7kNvwGkdndv&_nc_oc=Adr4vroxq1F2I6gW8wRWjfHhKad85hs97GSekF_UlTzGOxyqcT7GM5fJHEEAkDxheTI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vX97sjgvNNTTjqTsN-fLltVHqmlc-5fOFW16y5DU3Aw&oe=6A36BAAC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDgc3hHPg9MQ7kNvwH3WfOI&_nc_oc=Adrm3F0uIbaEOfhQ4fCdFjIEiwdq9bAYm0b7OqKNX8377xDby4HDrJslVlQtA57Bzyo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tISD6gYXCGdwh-GOMcbUbcdR9QDtb4-3VC1EG8mi_pg&oe=6A36A598"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
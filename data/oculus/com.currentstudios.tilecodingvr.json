culuscdn.com/v/t64.5771-25/38984460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OezX5jwuJqoQ7kNvwFbWkn0&_nc_oc=AdooiCMoCBfGIDAJfwGRiVOwLNziJ7qV7J3f5_tD70jtS4RCxMS0tw6C9LXhJ8w5bhs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPu9xRZunQMjx7cKRaD46iTu3wcQRTershwW9pv3XCzA&oe=6A7DA8A3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwCUjuwxJTMQ7kNvwG3uKe8&_nc_oc=AdoE2k_crBe8ogl4oF_Uk6qXaHnJtkt10GAAf_l8Ph6QjjM1OOZiFUnyDakvlz9sO8w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF14Rsp80fd5Brwc8QEYUzWFV1LBe-1qymGd8UqnPseJw&oe=6A7DD070"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTVLCF5-_dYQ7kNvwGOGXtb&_nc_oc=AdppZNy5pxhh9vIkfsVEUsIbzGKQIEcFfNelpjK2Q2Ru3ZCVZh0c-EqyfJ1cduSB0n4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJu1dL5XJpoMtKmyjku0wuvZmXKrNa5XFxXAMIz1-IFA&oe=6A7DA7DA"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNJ2PGBfDy0Q7kNvwFu2nZm&_nc_oc=Ados3jxRKNUTOh6RvVYA8sPDa5kadr0WNKAlGI8xy1fpSIr_-kbZQx278xBIzRzsV5k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAiX7a8R8OGofzYZo7s5LwMnmL4nNGtfZuKZIueeBSiA&oe=6A7DB36C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRdyPOgkY4cQ7kNvwG0S0qA&_nc_oc=AdrdUH9JMtJ1Z21OFTkdW8ARiG9xAc6jhBtIHpWrz95lHVgIC2aX5reEMtF-rlCViTU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoms66ef7HfwnHlXUir4RkhGAQk_z-WB1uLBKbS7Il6w&oe=6A7D9E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
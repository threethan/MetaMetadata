460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfi5T3y9LRsQ7kNvwG1OkUK&_nc_oc=AdnvMQydwkHiKFPhsEX2GDaCaycrJOJOyt9aK5Icq75h2dDFILQai90VC4mIjqGTkC4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfylWv7qzve_YubhH2_2mQNWuG3zZihJZ5FzBRk7AOky0Q&oe=69B2A1A3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0pFFjLVCMoQ7kNvwFSR0Ni&_nc_oc=AdlNQSeFqf5Sb1DMjGAcKUdKvwx4-RcL6j8BHj_ewS701oVqybCIwntWMOK7VKrP3GY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKi7cpXUpVO-_K_FXicddC8JVinQbhrLMsqR15-h5M5A&oe=69B2C970"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gPK3sHPwV8Q7kNvwHSkvXm&_nc_oc=AdnFtftcR-c9wreC9C1sgEZ8lv8jtpErornZt4_ebDbb7s9JURT4-f2FUWxsbuFbv-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVWHMQTcIJB8z26zfDzwq4_QYF1KGPNiHabbGMBW55mA&oe=69B2A0DA"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeInZq62vp0Q7kNvwEqYbz7&_nc_oc=AdlBagwSNAr-DTFdynX8NMhPd-Tj4F4yiTia2gMiLCFkbDskwv18azMkl4poOyhA65Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFnx4roqNVbww8oijU1p1cQqkYdeP2dmC74rhuJW7dnA&oe=69B2AC6C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWSKCXPtr64Q7kNvwFfwShB&_nc_oc=AdnHVC3gjjn-_41KB0A4Gt7KG3kd2lII70nDWi6N0L2vxOg6QOAGkwLwy0pYwPXy7vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy7oR2o9bB01OtZOKEEs23yN9heqX94rTSZJ1Qf4eC3cQ&oe=69B2CF98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
x3H3g&oe=6AF3359A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtwqQB-ECX4Q7kNvwHJ5sPv&_nc_oc=AdoEzBGjXPULaiCE-5gIUd3dEFyovDAuXUSece4z00bP1Zsmn1TWzswt2uUSS4t9Krs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjL6LLwOWco6UVbW5Opp6JLEpxdycyvevYA9P4SCtPSA&oe=6AF3412C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWAFJuOR4PwQ7kNvwF5O1wC&_nc_oc=Adqk1vEq4DMHGw-pIskWVbyM7npeHNm5enPlFg_GWX8zc1MUvI4icOmwBdVfKmbM1IU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaDR3MA4X62n6z9e-G7mcV5zw8k3Os9sn84ZejqoZfpQ&oe=6AF32C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_
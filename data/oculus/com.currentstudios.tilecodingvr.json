460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qXuNHZsyxoQ7kNvwH7RtvP&_nc_oc=Adm79CKBYtbqXGdeOOmH22BJHn8HqlYryqYXr_gHspZN8nnlJmXAYF_opEblXwn_YnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsGAD7TWYYGoH5eq9aik7QFxZct-Zvqc4n_nq56WvCgQw&oe=69A96723"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4wTL43JGmkQ7kNvwFRV2CS&_nc_oc=AdkiQgaa229KQ8tltB1QM8_jGoYh8dCN5LfVobt5C505HPCaEuCujog22YZSv5svpws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfstwYdBoiBAWQcZRVcJ8YCt56ZxaQsf6PrQC5ZaeibYUg&oe=69A98EF0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3cd5Cb4f5wQ7kNvwGMhWoR&_nc_oc=AdkYYajBG9COc2Xk6JdxygxhFFujuJkj8VzDznVx2crpMuTISJl8kZOx6HKVF5wIgMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsNZaczWzKSsZ6NKw46RQ2eOTSuqi8-13euyG3SrbDmbw&oe=69A9665A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdKyI5PvywwQ7kNvwGki00O&_nc_oc=AdkXarwcGfv1rH4iW8WIwrXK-UEBsaAd-i7a7WnYFToridWT2rbeHAEAuBQGMJWHtIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsCnLJKEoqZNjhB5xxQVk-I6dMjYq6qcQgHj3CGq59JEQ&oe=69A971EC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vk-JPYlYjUQ7kNvwGD4vO1&_nc_oc=Admq_lwzSgxb81SLTkOQ2jAc6N3yzvMlNUEqj0mrM-56nAd6xo0jDwHTBGANfK4Q4g8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvi7P42skfucDuSVKfBbj8BFq1VfpDKC6uJsb74QsFX1A&oe=69A99518"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
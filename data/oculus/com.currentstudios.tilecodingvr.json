460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62pl7OwItboQ7kNvwFmJKxp&_nc_oc=AdnHsf15-roM69i6O62so2Xzl5-t-h_0ASOmAzi25kDEbHFcD-AtCXSpFE5Mu50gPmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxW4onQyliOQLZZMFYJf6d2U874pOnorSgFRg4md_ikMA&oe=69AC0A23"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dKBoPZSgMgQ7kNvwFHeKOQ&_nc_oc=AdkLyBRHJnG9Zj_PUD8kwbQuCw_Gb4QglruMph-C-qJAMC-F9UF_d48dkLH7jMS0sUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxO1w7sT0vDwq3rEmGZw7oeK9ogOHHXNrBDHAvJ4QGfg&oe=69AC31F0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-Dq4HIi84QQ7kNvwFROvvT&_nc_oc=AdlhZAv6E34dVkMysePWBRIT4Jd45Bues5aUZ9AwGZOTPArDAOcPQXdVaVBa92LP4qI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbwSkGy0cSnk0t-3vrDY2-xBbt234VjccwJ9AvjjZP6g&oe=69AC095A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oM4ZvGwJVEQ7kNvwF3Wa2X&_nc_oc=Adlgv1cZfhkMRHIpXRMXxpXkNtyjB_TiviQuPUjc1dqp1hdiK_LPufASXsEHXfVfg2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxgLv7RGS8zqBRjgHxjwMv2sgDReIL09DiGKs8frmNEYg&oe=69AC14EC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vk-JPYlYjUQ7kNvwE3pZAp&_nc_oc=AdlQSz5x1H8Cp8S4IJJBUFH0hRttDfWGrcMz8t7TOLncoSn-ul7dypF8QQDOWW7v0ag&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnnuHYWFv2xqXjC6XQPopdBmZDs8Ax-gkD_HXJyeA2Og&oe=69ABFFD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
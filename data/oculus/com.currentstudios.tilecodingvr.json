culuscdn.com/v/t64.5771-25/38984460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90087lr6t-8Q7kNvwF_Vkyx&_nc_oc=AdphjpXva_giF4fyQEHdVAO3Ro5sK5R0Bo1ZluAFPveYzwaCH3cm42lQ7_4FOWOLlbA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAzC7U0-G3NB-bANgQtn6Xbldn4XXsA41ll198j6fajQ&oe=6AAEA863"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUawArpiVZsQ7kNvwEAaoCj&_nc_oc=Adr1x8g6kCwk5sfB1OBOMdpOcK42wNZZgdKrKHidqs3kwl-BSe9AgZlalxpHGjKZbcM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiE8Vy0NfUY78-e4l31kIqX7Ff7ykY1yj_lIu__SV4QQ&oe=6AAE97F0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01Aray6S6yEQ7kNvwGmYgL1&_nc_oc=AdqzuZe13k7kKCu2uIuwsLokubfyTADy35937DVwx6AbriejQ6DTQrl91rsXfS1tL5Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTrU8b0-F6aEzqb9j2WfvvHXNgzhJ9IeGq93ct1br8hg&oe=6AAEA79A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkWaLBFv9dgQ7kNvwG4FTMy&_nc_oc=AdrjXnoV4J4sg7qssbK7CtVQBqv33w-41A61yTmc90MBDcq55V7ikBClsa9qzDTRjJg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2kOmU1mIV5WyytcPQvhrOL_l_kWuouYbl118kYgxMbg&oe=6AAEB32C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KQrsx6BNqQQ7kNvwHn1I8c&_nc_oc=Adqnxu7mOBS2gTsM8kqcjG5tvpGSwfVtPWWv3oHFOS67NZIZ7Gw5s59iSIPV-VsWBTI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9y-zbSFuDi8zmapBwLX9-pxMJLkwVAWMSBJ8IERe9fw&oe=6AAE9E18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO7Dj32PlsIQ7kNvwFZX8Hn&_nc_oc=AdkudYMZ3VwWLDm0zWCSoqk-vKAnmaxbBn1wHWCzRlxpPCelWYfMvXb33uEJn9qDom0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJPRZfExUfafE2HIR9UzpSu902XMsleGadNTq6lgaLrw&oe=69BBDC23"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcxjHwIbqi4Q7kNvwFva7MH&_nc_oc=AdkAmcJrFnKRZ_AMoNZiOyx7_UyIqOMjdVJpyCXe3UJ-Z0L05a5LM0-snew3X54JDRs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxR1zu1-cAGi9-tik0cMnKbN6jdeEFCMUBnlvn9KM-PIQ&oe=69BC03F0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGKyNZxl8-UQ7kNvwG6iGZU&_nc_oc=AdmvqvTv4lb-cHN5cgri5O8z0ND8PiESVSlllxAIAZzCh6ZfeaK1S4fKmM5uzEW_I5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWOSz00BUE2iJnXDW2uHTZ3w7inoe8aU-CG291yRULvA&oe=69BBDB5A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCvBct65E5sQ7kNvwH79GXX&_nc_oc=Admt04lrSJzZtGOYV5KmxThJ4Yt0wsSIWe_glH3DZp1X4uz8bTbD5szEHPZwbL0A06Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwiTwbHKIYlUsibGrYKdrdXIzKIK1ycfWwf-HJP605lZA&oe=69BBE6EC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvcVN8e6xDIQ7kNvwGqAto-&_nc_oc=Adm_Fi7DCvaf2lrePr4JKNdZT0F7wvj6lO7xnrjV4kfJWTiUSPAFDWbr3AddUYRtMeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxvGUQFfNV0l93ZzFTNZna1oCdZyOUvTsA81UP_ErBBiw&oe=69BC0A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
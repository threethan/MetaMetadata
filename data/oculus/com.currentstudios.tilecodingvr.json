culuscdn.com/v/t64.5771-25/38984460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJtnSr7OCm4Q7kNvwHBOW1j&_nc_oc=AdpmmWUPVQy21IsTk_OtnSleTwVgSnAQ6EXaWsFE9QlbJ4b3awUl6N4fYvxBOWx5014&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45LAtns9mfK2zRTIKlh_l05m5-r69F89Km0rTA87ABDw&oe=6A11C5E3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yVU3Af9z1sQ7kNvwHUBxDE&_nc_oc=AdoGguOUlw1T-NkKKbG-rwK_Zuq37Ycofx13G6jK8Er__6xRJ2HGqo7k7u_tv3EWDtQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vh2f24fQaMZI_qbT94b4ybDkr6nqOY7wcrnvpHoVZtw&oe=6A11B570"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhFipUt0biwQ7kNvwGd2AFB&_nc_oc=Adrby_FYL-RzJw3BQGeyW4erA0d-2t5on5toQeHo7Mc36qqr9EYDSyoJrMEm_XsYH04&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cYbM2fDbLisTSdqWnfYkvDF5w-EWK0R2sI62N2ZJT1A&oe=6A11C51A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91GhTDTwZf0Q7kNvwEBmEPA&_nc_oc=AdrQ40-BhHq-vzSQPe3Xlxy9h88bHAqnrHuqesPdW6Rbcy6QuGq62qhFwfPxRfZPoWQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hIRRtD5TGQ1oU4gL1jBR0bQup6HOb9tpMRZTZWM47Mw&oe=6A11D0AC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc5LBJrElUkQ7kNvwEzAamv&_nc_oc=Adr5yECD0yRbrvsYYN9YILvZGgSNouyhPrdSeYcDPEYN-5qMRfjH4jJQy-yImtPxisE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i_8XMrU3Qbtts9rA53eIuatVqnaz_IctybGM2lqrT9A&oe=6A11BB98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
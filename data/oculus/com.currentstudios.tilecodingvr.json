hy_Dg&oe=69D0F35A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6ta71YEbxgQ7kNvwFzUDWP&_nc_oc=AdrMlLUH-3jaOhxqzjNMdXmwWTdB8ZY9zSmMg9Yhe8KyTJPM2h9HV-w6-hQECWzEPTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEZrJ00_IKwL5hWWJdLytvcJbD4tFFIoy-0XHQ6WcuDA&oe=69D0FEEC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yll3fOlJSiIQ7kNvwG-Kl1e&_nc_oc=AdqCd7MmXL5StxYmXCZ4LekAx2w00HR4-0Js_91ONVsAAadp5x_sR6Mv5yQx4ZKdOI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNx6A9w08D1eYFuq1Fkd2_sYcjh0oOyM98d_xSgF9X_A&oe=69D12218"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_
460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0rpkB5EnUEQ7kNvwGQd2bg&_nc_oc=AdoJOUS4ZRtVq4E0Z0JdjlND57Zd_AHXP8bDOrsFf-wOMCnqtD0fSlFcKguqI9RTclw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBz0BeyEz-R88TFrK4ffko5ol0Wg08z2NKWpaMjS2bMQ&oe=69C12223"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VaQAxJ-C4sgQ7kNvwEm7ppd&_nc_oc=Adp3qdTe7Ihr6SMCSKWvWwCjMH7o3xvub4ikSvuQPaIygFw1n4v9CoOehoPPYMjSDwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKyPsuMNt5x3CruhdoONr-Lb1tK32LiVYSco_ETCEoUg&oe=69C149F0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqQuZaD0sbQQ7kNvwEsvLPI&_nc_oc=AdqxE94dVTxXb-sSPsyc6uYvcrHaF9aPDHc7Jw1LXksEiamPHIGljl5o9CPo6dLj1cU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyK-cf3miqKSjCoRAa_bAUjtcEDTx8Qgoe0yj27dKoE4w&oe=69C1215A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IgTbeqGqyQQ7kNvwH8exgV&_nc_oc=AdpV8eh7_qG3kZ1GsKT_K_qatE70035mKBuOQ8j7HUkN1U0Jm6Kf62zc6RqYw_oPhpo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQZFgPWdCF3RZEC4ResWJ-YlMC2c8jaOFHpjb1LoiVuw&oe=69C12CEC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YBM56zZK4kQ7kNvwGm2Zf5&_nc_oc=AdozOM3qCSehqov0bFFr3_aR0FBSIjNSiQ2Twbslc2LcJ88fWM3U0x06BClMBbbV5zU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9bZcrwa-F5d22OXYXOIqS-yf_wMjuMf15cONhSfFOmA&oe=69C15018"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO7Dj32PlsIQ7kNvwGIj8Jq&_nc_oc=Adnn9IQ9U-m_IfyB8VR-lVEriB2NmTkWDd9BmyeCAEVdU8AWC6vT1zA-i8gg8QKD4_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9IBjv5XoXSnOcf60ytMYjQnv2EymDaDSPwhDGJ-ovOg&oe=69BA8AA3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcxjHwIbqi4Q7kNvwEsFd90&_nc_oc=AdnkLwm4kmO2TFm-LSv78oPB48BUB7kUT9H0R5y9hVd5qzFTrEZCLlmttBH0p833F5c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx-ygFG8-meNvLDCSvnAXNfDjYrTA7_Bao_TbjYEELtrA&oe=69BAB270"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6exdHp6NocQ7kNvwF32zDV&_nc_oc=AdlxHtkU2YJWfncud_0TJ8es3vW4NpNHrM6KmpkDr8DqNGydaiea7UNWo60qvfdjNhk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyD5BKdV-LaMm1NGP_6jOZ7cdq6DVAauJZjZZVqQUZ1iQ&oe=69BA89DA"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRfPmMziV7YQ7kNvwEinTmU&_nc_oc=AdlCcnrX5fkpdEL4B71JZuBPbPDamfJdc1Aqbh0lU11tad4e4Iye70qzWnR8A2ecPBI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwy3-8o0Oe_pOmYNrZSR0DaKMLiSId3w7kgs3W61rHAIA&oe=69BA956C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvcVN8e6xDIQ7kNvwF6AxD9&_nc_oc=AdkiaAaMf8_nb6FEziJmrY2DKSsrbGvJjkAk9q4P_qgypzmHKti7rkrTc2AxwipRe5E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxhhAwVMefJood0OwTZew1N9PV7ZAcxth8H_7Er05IlLw&oe=69BAB898"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEWAP_AnbBcQ7kNvwGvSoBB&_nc_oc=AdmElYZl89bLvgC6zfBuYYbvm5q9JBmFOjjJc9vGSZyFl7LI5d3llcYQuk5ecbDMvqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx063mVSI4E2TDeFXdoX0kkRtHjauSYSekiB_L40K9c2g&oe=69AFFEA3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi9Zw80QFDYQ7kNvwEqetEQ&_nc_oc=AdlC_bbFGf9w7SSOa_WzI6qlycq_i21AuYgu3-KVDHvO8zqCqLAPJTpgEXovbWQ2nJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvitKmkh0OHfnJ7tBck6eNwXwqhBnf5LO1EZPJOkS_ww&oe=69B02670"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gPK3sHPwV8Q7kNvwEXj5ET&_nc_oc=Adko1WDiD_5t5Qj-tLU1avp9TdJbG2rld05xCre1JGFEcC5dXOy0ZTpQWbt2_dVrUuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHq4a3oSTyFpdBUr8qSkBvklQNwmA27i8QO2BxoOeL1w&oe=69AFFDDA"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeInZq62vp0Q7kNvwEUtcAp&_nc_oc=AdlK3o7U21gcgL0Mo6RHbHtBuihFpjTdiWNH9HmazpptWlJBbY7Evgep81KLtEue4Rs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrB1Ndaey6Stla0SqvI7AT0EqLD1SFWAylKF3xpw8exg&oe=69B0096C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVp5nV2lQ5wQ7kNvwFzS-R4&_nc_oc=AdkQHMLPDGgsW7AGBkSYcYFbyNjSZ_lC4N52-_NNHslaD2-kke-q1IFbVLxS0QNPdAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxDBq8kLQ0OqxJDJu_8O-qtQNf5j4PL988MT26GZnQRQ&oe=69AFF458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
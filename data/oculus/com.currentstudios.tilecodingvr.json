H7q0Q&oe=6A3AA39A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9rZ4AOyPe4Q7kNvwHnHyow&_nc_oc=AdoB1P7e2U2iamvwm806AsH9FRvuzUU0O-Zc5m8Trw1YOFMvKViUcTFGsGGSRkFCfmM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7qSX6Vex7vwhVoUIMtz1oVZh2FjiL0qfkiNLkefsDOg&oe=6A3AAF2C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgUy2eiCCh4Q7kNvwEjb2Om&_nc_oc=AdrUn3tMSdea74jcuAxgA6HvakrBI9X1prXlxuCt-GcOQNT80cbKL1DPpJNjLbGQE0w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cg2gloGVxSnSPM46nqP6mpxeThUL7UNCNA8OT9j_BQA&oe=6A3A9A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_
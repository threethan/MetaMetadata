460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfi5T3y9LRsQ7kNvwESsV0B&_nc_oc=AdnDhwVYNPs6y2QlRsrcX7SxmBkBtHoopozkPPrpYVcFKxNvdTT4yVCx_H-OZC134x4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyu4e4p3SaMnwYjU6MzpdSr1Bvlulnf43EEOdkbh-sblQ&oe=69B3F323"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0pFFjLVCMoQ7kNvwGtSbzi&_nc_oc=AdnpHBt0wEADz-XC8CFP5pGGpe56tZyAqS6-manjhrrAH9qWua0xwWktliuvid6qsdw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxAup_PNKdi1Ny3IYz7_VA_5UMPcMVEhgNvGFWKYj-AEQ&oe=69B41AF0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snki_wf6ZegQ7kNvwGb2ah6&_nc_oc=AdmFVxel145Kfa-z1Vuw9YZRe7-8GndhewWv_qVghtcwJSxDxzWC-rsZl2P_EH8dHVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwe4neT_jKyZbB9qrfBJirqjTqLKxuWcF9a8U-drnsmw&oe=69B3F25A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vylYWOJ7vMQ7kNvwGUlid7&_nc_oc=Adnti-YC_oG9X9kUIIoMlvzlcnZLbJ2odzc-BAlLaUEM80_mU8tg3KO8w0SBhHthFd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAeazKmk-Z23zpzWLcjDMI9EEyM3n8NiRsrkAwgQm44A&oe=69B3FDEC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWSKCXPtr64Q7kNvwHKWlmJ&_nc_oc=AdnOmiJkc2TQ8rxc_sl39R8goocDdIQll_hu-65J9ifHdhYpCf-mpChah9-0QSOG-ls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afywna2bfxVYjeM7iu9EZsVgpZid8naUG4-fAJP4NYzRcw&oe=69B42118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
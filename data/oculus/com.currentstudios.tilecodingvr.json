460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BQOzxXnddQQ7kNvwGNQuZH&_nc_oc=AdnrWqvjxveVM0rRY1n7UXv7QOXR5Jl1d0Aew3v6oAzYE7a5JaH_2o_PozUxYxN0Qqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFnOfkKYtSWRWqJGNZkBLsPRezWkUZ5s38900XbTAWeg&oe=69B69623"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga05wnLjEJYQ7kNvwFsJkFq&_nc_oc=AdnJuhaXLA7LWY0yYtnS2cQ_eApXgRYNRF1Ztfn90l0R3Hzgn4dO2DsBW1hu_Ddl7jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqsdmskFis-kC62lw7oqhlpLNtBN4GCKP4nSwUnQZS-A&oe=69B6BDF0"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snki_wf6ZegQ7kNvwGNQoz6&_nc_oc=AdlT0LgP8hSb2Fa7zd6o4I3P8gwkU0iN4g-YIF7ufa47HbkHLraUTI-wXVwipERyGH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaufP1yonx7lDkyGtIcRiTw-1tbPQYIM7POFtd0OV5oQ&oe=69B6955A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vylYWOJ7vMQ7kNvwEr9moi&_nc_oc=AdkXnNDtDwtP0uNLcXxkhZsyq5NZcCwBDSFFPIt6x7itKZ4xAxZfGhNdYCR5g7SyJOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4jY7CT8zWxLxAYgjfNjthJMLbvBRqYlbgieDFnflh9A&oe=69B6A0EC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kV2ZopqPjEMQ7kNvwFDwSui&_nc_oc=Adl7zytmxR99YQyNMo-stDAFqtU_wo9dOZoAcemPVUWciFURO7Nku8JcEzo4FksP3Mc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwawWmikLBB2oEAJvsOKFTsQqNYF3OuWH0_92ar3BRWFg&oe=69B68BD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443548311926050"}, "review_messages": [
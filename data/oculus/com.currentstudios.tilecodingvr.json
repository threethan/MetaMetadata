bH2UA&oe=6A10739A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91GhTDTwZf0Q7kNvwETbbK-&_nc_oc=Adq4_TrjUN-41KCsVwbYCsq5t-XBjXzDHNhr6Nmh2ZyoxTo5-flnZHimvAzAWK5EvLw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O3hxsuEsM8ebgVpPWhpJxbCw7kQAtegd2N6cghbMhUg&oe=6A107F2C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc5LBJrElUkQ7kNvwGRzPsL&_nc_oc=AdotXp1y4C6VQuUgrvUD6Z4GBpcm8QL9QmJQ47QeZ4teqtT_MLJsnvAvDp2xmPIhvBE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o0afx4bPtTeNTkIiVokTqQa_aH_L9WsHbVOVcCaMg_Q&oe=6A106A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_
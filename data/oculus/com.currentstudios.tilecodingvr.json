scdn.com/v/t64.5771-25/38984460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6okaLT_5S4Q7kNvwGADRJj&_nc_oc=AdqaYrAlhANvq3Pamz7RFzfD0GA7FLyfeL54AJpR7CJr7P_75qXTXSAlH-ahaaLd4iw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsrj5VymFqhWHE_yIlkVW0XMzDrhpWX5wBdUieCGwq7g&oe=6AEF41E3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBuEwdGE29sQ7kNvwGe_4_Y&_nc_oc=Adp-42DDzwEmwERbMjemhWOKOLk24_NKdUpcaT7VY93bWCPefL26Px7PrASSwqppjRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH_JkhE5dQmjlWfPX_bnVEkhBBJKi2iEl1WIu0uoqEtA&oe=6AEF3170"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBg6ikAwI3wQ7kNvwFCckzi&_nc_oc=AdqGoGwFec0SHm2x10hiqeV5BFRW7HXwSjL-mCS5NGsf5fkgkHLuM9VrrnAgpaayjxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuHbt5cMTV-drsL1-eXnsi-p7XskVABvJkrU47rXTteA&oe=6AEF411A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fABABj8kM6QQ7kNvwEfKcWb&_nc_oc=AdpXLe8LG4JNvG-zwPcrL4t_QB6l4yT_BdV5ldG6-Z-xXL40MHi1E8p6NNeVgqw6bIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlbNTMJOMbY0CSfsKdBxPmgP7otUhssSkN09aRY0EzJg&oe=6AEF4CAC"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcL-LJ-ANrIQ7kNvwHm0fCG&_nc_oc=AdqpJfjSEX9gTjwfsJL5_W1J8oEPg7zMSaq7PiL7qdnBWSv_qL1eSa--8PcIxwXpPpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYWBIo_v_UJh_OTmEoabVj1MIxvi5ytKNpG_7lY_YSZg&oe=6AEF3798"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], 
scdn.com/v/t64.5771-25/38984460_1720879708690127_2612440023230131621_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qgkt0f4gpSoQ7kNvwH-9cS9&_nc_oc=AdpJQkzi2cblebgf-bbzPH6641MFmWiKQBsGR9m_SsEqQKdAnn-lZhzQuK_7w3KqPbk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XW-CM8v8Ug5aw1NFtzbHGYpfKdTPkp-0fq2UKq3X6AA&oe=69F4C4E3"}, {"file_name": "Oculus-Screenshots (1).png", "id": "911061740887227", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974755_911061744220560_8739730410767079081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FILs6uRIGDoQ7kNvwGIKV4v&_nc_oc=AdohYR67SlClAJOJmwwd-GhLM1erO_dAXOS4pzW4nSu5_XXr1_wfaWQCxl5uHKZuUrM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_563ZGORfg5rKDecmtshCLaTDZVSAu6UGvbl9U0AX0Q&oe=69F4B470"}, {"file_name": "Oculus-Screenshots (2).png", "id": "1940871599731846", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031493_1940871603065179_3968198481569679122_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2jUP5EcgQMQ7kNvwGsk9VL&_nc_oc=Adoz16mTh3GA1R-N8CD2ltndiA0twoxikziyJAd2i6E8xMxD_6u7NoZfLBvXl6DXH-8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EcBatZusDYsReR9LwoETj81QKWIhDVBMlGpNu6I07IA&oe=69F4C41A"}, {"file_name": "Oculus-Screenshots (3).png", "id": "1213444546554731", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974698_1213444549888064_1187022952562665443_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPf0-pYvqgYQ7kNvwEKhtJK&_nc_oc=Adp04GgVcd6fCba3_mvnH-bqZuAcTxMcZcecbLlo5pmBrXHCr_zPKJWYOQB5pMv2NU8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0P6MLA_6n8akdWyZ-M3gkWwfGOiFxSEUWa4WsrjrTN3w&oe=69F4976C"}, {"file_name": "Oculus-Screenshots (4).png", "id": "548351941043611", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974591_548351944376944_8503678967939885880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mu6sxdMfn0kQ7kNvwHGilDm&_nc_oc=Adp3J4r-CFovWZDVb6kvQfPwf0MuvDNSWFPHtY30ifM1t7Y7mwjPZbWoTe2J0ahe7Z8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hkqycfoy1-YVDx4ZQ60Hqw3h7br2MvRBOsJ348nY3GQ&oe=69F4BA98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tile Coding", "keywords": [], "long_description": "Tile Coding is a virtual space where young coders can experiment and solve problems to acquire algorithmic thinking and coding skills. Coding, while being among the most important literacies in modern society, is often regarded as an arduous process as well as a real learning challenge for younger students. The virtual space of Tile Coding offers an alternative approach to teaching and learning algorithmic thinking and coding while aiming to make the subject appealing to younger students. The virtual lab is ideal for Problem-Based Learning (PBL) scenarios where students actively collaborate and seek solutions to open-ended problem situations.", "short_description": "Tile Coding is an innovative app designed to facilitate the learning of fundamental programming concepts in an engaging and accessible manner for children."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.currentstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Current Studios", "support_website_url": null, "website_url": "https://www.currentstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], 
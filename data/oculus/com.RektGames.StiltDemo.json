n.com&_nc_ss=8&oh=00_AfxJ5Ju-F9g07pgRDveuGLUVdiJxzw-tMqpiGlK1tFhaiw&oe=69B010E4"}, {"file_name": "ScreenShoot20230222_134922.png", "id": "476007647925506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_476007651258839_8920636420970540251_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09Jhi1IZA6oQ7kNvwHW9Mux&_nc_oc=Admsr_ajePi8MlIyLlbOt6FtVWaB2JahdW9WvYmytivs3IEQEAq6MKHEgrIP50YK5C8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo3wa9mOsd6xfT0MMk1h_aQhFMhqK_4SfaEUcbCcJKnQ&oe=69B000BF"}, {"file_name": "ScreenShoot20230222_135400.png", "id": "1851176918572373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984439_1851176921905706_8454913570376641979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwLcZV1Q2y0Q7kNvwFA8--O&_nc_oc=Adk9bzg1zrUtrrsWCMdy-S1jlVl1XIx34bOISYPXO9drOLd8OnwloJT8C8LI_wIdCI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxroninbVi79Na8LdYR17B8XREGUSnfKScU4dkRwoTbqg&oe=69B00E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "973348187379793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982511_973348190713126_8922137248366989321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vve-jM8-olcQ7kNvwEcVCfz&_nc_oc=AdkmTLm9uJcVrggXs3exLjAdZDIVgEG2cpMpGpDPenD9mPiK5_cT2zj9Xm1USxBclTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7sJ3nyOXvDwu9_e4HPJYwHg41OdFgjAzPpRJxBUcrAA&oe=69B02BEE"}, "display_name": "Stilt Demo", "keywords": [], "long_description": "Get the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/\n\nStilt is a colorful, stunning VR platformer game that takes inspiration from classic platformers. Use your quick reflexes and problem-solving skills to progress through three demo levels, collecting lost gift packages and stamps along the way. With your wits and stilts, you can handle any challenge: pass chasms, avoid traps, break things and smack creatures. \n\nThe full version features:\n* hours more of singleplayer levels\n* more power-ups\n* various multiplayer game modes\n* cross-play with Quest, PCVR and PSVR2 players!\n\nGet the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/", "short_description": "A VR platformer with unique movement, inspired by classic platformers. Arm yourself with stilts and use your quick reflexes and problem-solving skills to complete levels!\n(This is a demo version of the game.)"}]}, "developer_name": "Rekt Games", "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "MeKiwi", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632636206797244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974491_863292728446922_7903663429858675821_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqNVrtzlKa4Q7kNvwHm__V0&_nc_oc=AdmDnjUrYFleFIOM84YSRV0O6bE4s1UDVXUdgECjzIaOy_FsIRFvvHM92SuSifpaJuE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKS6rG7xka3JlACcrnYHENQL8g1US6sEXd5u18wpEPww&oe=69B0070F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stilt Demo", "platform": "ANDROID_6DOF", "context_category": 
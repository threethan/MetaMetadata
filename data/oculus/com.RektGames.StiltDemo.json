n.com&_nc_ss=8&oh=00_AfygGzebep7mIOtgpixPoKupKqJfO1_wsA8MDcLzZGQs6w&oe=69BE9164"}, {"file_name": "ScreenShoot20230222_134922.png", "id": "476007647925506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982724_476007651258839_8920636420970540251_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4RWbc0d-WsQ7kNvwGaeImQ&_nc_oc=AdkpnadrOSSNEBG0bMqLfqyQilzU1ZMOClXzq9uzEMdAVxSmb3HUaaTTjYntcP_wWpI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxebjjetp8u9_TVeKT4LVBS6k7LlfCBkxGgzmNlUZ_R1A&oe=69BE813F"}, {"file_name": "ScreenShoot20230222_135400.png", "id": "1851176918572373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984439_1851176921905706_8454913570376641979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dlQkmkBZ70Q7kNvwHr_MOH&_nc_oc=AdlUqr0yd3Kg3ecjIzv_cGhL7I8e2wvE5H76SqQx_LOJ9DKJH91Ozgb4KHyLyOFymOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0t3VM_vD5ANf7gr18cHrBkWeTdrisJKfuPxcssI9-7w&oe=69BE8E94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "973348187379793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982511_973348190713126_8922137248366989321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR9UEmde0JgQ7kNvwEN8s_F&_nc_oc=AdkifuqLTpXaRihV9z9RkUKvMDLHVyDf1JURLo3c084Upt-fvKo8wyrHtAjxPF22xso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwY3T8FDkHJbDkj_xiUxmDAG0ZjkN_nm73o-TclvqAZew&oe=69BEAC6E"}, "display_name": "Stilt Demo", "keywords": [], "long_description": "Get the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/\n\nStilt is a colorful, stunning VR platformer game that takes inspiration from classic platformers. Use your quick reflexes and problem-solving skills to progress through three demo levels, collecting lost gift packages and stamps along the way. With your wits and stilts, you can handle any challenge: pass chasms, avoid traps, break things and smack creatures. \n\nThe full version features:\n* hours more of singleplayer levels\n* more power-ups\n* various multiplayer game modes\n* cross-play with Quest, PCVR and PSVR2 players!\n\nGet the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/", "short_description": "A VR platformer with unique movement, inspired by classic platformers. Arm yourself with stilts and use your quick reflexes and problem-solving skills to complete levels!\n(This is a demo version of the game.)"}]}, "developer_name": "Rekt Games", "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "MeKiwi", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632636206797244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974491_863292728446922_7903663429858675821_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAJyzfgSihcQ7kNvwEiyQbV&_nc_oc=AdlDOyhq-I1ceQDuvCsDI0j66obRGRbz5oQtsfTFh67_2DeNbVGrOssLxzt7eclh9j0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt85QcFQFDQtrwZSo1HYi3dyBT1tvpocQ7jFxKTMYcrg&oe=69BE878F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stilt Demo", "platform": "ANDROID_6DOF", "context_category": 
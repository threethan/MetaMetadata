-lga3-2.oculuscdn.com/v/t64.5771-25/38974830_1349058062556486_5524155634283664805_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Lp_Ta8otUQ7kNvwHy6-yy&_nc_oc=AdoMc2XdRKVIOdbg9QiM9JDX0lS-kka88ZVK7j-rhunIb7x2y57SpHwkjHkOqYgCw24&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx0RFP4lXg5BPHY5Q2SxrucnlMPr7nv4TCnY2F898BPA&oe=6AFB31A4"}, {"file_name": "ScreenShoot20230222_134922.png", "id": "476007647925506", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982724_476007651258839_8920636420970540251_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aooXSARpsOcQ7kNvwHmnuaE&_nc_oc=AdrPPThW-bXACiBy1FA4o9xcOua1Wo-MhXL6TPVbkMhaLERuFzq7dRGeVrmLnZ2bY1Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDGcMCKQDTAp2buwQ2aJUy_Lx2IWZY0keeq4qN56kHzA&oe=6AFB217F"}, {"file_name": "ScreenShoot20230222_135400.png", "id": "1851176918572373", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984439_1851176921905706_8454913570376641979_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yD2j5U85rQQ7kNvwF8QoLh&_nc_oc=AdrxYi4AYz8fcJKyRQ-A7fYt3hwxw_aUdH0rcun0rH4ohzqNm4julMcF5Ls3V6I7xBU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ9hOBen1Uen3T0GQZuV3gnHmwusEBpATtOqZ7snXSBw&oe=6AFB2ED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "973348187379793", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982511_973348190713126_8922137248366989321_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pje057rJMb0Q7kNvwGDMljF&_nc_oc=Ado-XGYZG2ygY2yeSj0mYY1tbdfykKDsbNHaiG2GzwPkMDks4oz_33Q9wWXU3-7bXbY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDNIXkNeSbgh_O4c3Oxaz537yKtW_JridFCk2mKyrU5Q&oe=6AFB4CAE"}, "display_name": "Stilt Demo", "keywords": [], "long_description": "Get the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/\n\nStilt is a colorful, stunning VR platformer game that takes inspiration from classic platformers. Use your quick reflexes and problem-solving skills to progress through three demo levels, collecting lost gift packages and stamps along the way. With your wits and stilts, you can handle any challenge: pass chasms, avoid traps, break things and smack creatures. \n\nThe full version features:\n* hours more of singleplayer levels\n* more power-ups\n* various multiplayer game modes\n* cross-play with Quest, PCVR and PSVR2 players!\n\nGet the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/", "short_description": "A VR platformer with unique movement, inspired by classic platformers. Arm yourself with stilts and use your quick reflexes and problem-solving skills to complete levels!\n(This is a demo version of the game.)"}]}, "developer_name": "Rekt Games", "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "MeKiwi", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632636206797244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974491_863292728446922_7903663429858675821_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=url
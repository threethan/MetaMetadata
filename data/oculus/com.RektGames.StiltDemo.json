"}, {"file_name": "ScreenShoot20230222_134922.png", "id": "476007647925506", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982724_476007651258839_8920636420970540251_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE8gq5cFwzIQ7kNvwFhcv0y&_nc_oc=AdpofSH9_iglKt6Rx5ByO3bJdAyJYL1UkxyLwzqMw1Rf3fRc0cGOYGh6IJnTeriW3M4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSskElOhGSCTI8VwQq3Y-9SjJ9SFa3goWnpU8EA0YYMvg&oe=6AFF15FF"}, {"file_name": "ScreenShoot20230222_135400.png", "id": "1851176918572373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984439_1851176921905706_8454913570376641979_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-X2-hFOWdEQ7kNvwGow-PY&_nc_oc=AdpNLB_H0zB2haxfvaBMr1xfa8MMSPpKjC4NnFlxLOALPyzL4hYC-cym6gObJBvuHfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnrXeqTSD2AJ-QAW390T-QgqgyoJSZ4NPSUcLGO735UA&oe=6AFF2354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "973348187379793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982511_973348190713126_8922137248366989321_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN47B2CA8mMQ7kNvwGVkyxW&_nc_oc=Adp_8jhjfI9qE7tZkzO3y9NfKMsdjmr__ZJoOlfvNBbRruyiK86gbfIs_Yj9fwMmIJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjLVlPVOnacwF191PIbulFns7EhxcJnQcupOWbPPMwZQ&oe=6AFF08EE"}, "display_name": "Stilt Demo", "keywords": [], "long_description": "Embark on an exciting adventure in a 3D platformer game designed for virtual reality on Oculus Quest. With two stilts/springs attached to each hand, you'll use your unique locomotion skills to jump and run through challenging levels and overcome obstacles. Your mission is to retrieve your stolen spaceship, taken by a giant octopus that lives atop a volcano. As you make your way towards your goal, you'll collect cogwheels scattered throughout the levels to aid you in your journey.\n\nThis game takes inspiration from classic platformers and offers a fresh, immersive experience in virtual reality. You'll be transported to a world filled with danger and excitement, where you must use your quick reflexes and problem-solving skills to progress through the levels. With stunning stylized graphics, smooth controls, and an engaging gameplay experience, this VR platformer is sure to provide hours of entertainment. So put on your Oculus Quest and get ready to experience the thrill of jumping and running through a virtual world like never before.\n(This is a demo version of the full game.)", "short_description": "Jump and run through thrilling levels in a platformer game for VR! Use your stilts to overcome obstacles and collect cogwheels on your quest to retrieve your stolen spaceship from a giant octopus atop a volcano. Classic platforming fun in an immersive 3D world. Get ready to experience the adventure. \n(This is a demo version of the full game.)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "Rekt Games", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1542888049530372"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": 
-iad3-2.oculuscdn.com/v/t64.5771-25/38974830_1349058062556486_5524155634283664805_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKMekq-EnTQQ7kNvwGMhslH&_nc_oc=Adqzy0k8jIdQP7PJSIiSi9veFc4QKcVf0N6yuuIsefSFEisxWZfSq-2l9nr2NQTCQ_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3Xqb9B6J_nTYLGOGy52P-mJmIPGB_cKLJdQKdoY7knA&oe=6B0C5524"}, {"file_name": "ScreenShoot20230222_134922.png", "id": "476007647925506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982724_476007651258839_8920636420970540251_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYBSPWnBjgsQ7kNvwGt7yAV&_nc_oc=Adp7Pap87CptwIFuGUaRTV9NmmP01e47t53KpONg37occlqij-5lqSd8bS9sHavIq2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlf3x94j6FeG1iawIAmq67lsNn67dy_-qH8D0KLFhLeQ&oe=6B0C7D3F"}, {"file_name": "ScreenShoot20230222_135400.png", "id": "1851176918572373", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984439_1851176921905706_8454913570376641979_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUlq6x_DH7AQ7kNvwGMNyGw&_nc_oc=Adr-zV8rSmi2mgTuCfxd5wdNO9VMisnmm9zq-daPAKfYSq9QVYu34B6yCjgRzoqOtSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5At3hqI7H1aHDOYZXF2efnXAdydvIB2kOxIEVT1HsWA&oe=6B0C5254"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "973348187379793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982511_973348190713126_8922137248366989321_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQO1l5JlFoEQ7kNvwHrKOzc&_nc_oc=Adok5tttoEzKf2gH-iZbz2HtandNpTKhdKsMK2WbL0QH5kMjyBGVTd15vB7zZ4m0vng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-Q1Fw9UjlqbEkqHDIDnsjBY98lRvRw16j7-ydIEM0dw&oe=6B0C702E"}, "display_name": "Stilt Demo", "keywords": [], "long_description": "Get the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/\n\nStilt is a colorful, stunning VR platformer game that takes inspiration from classic platformers. Use your quick reflexes and problem-solving skills to progress through three demo levels, collecting lost gift packages and stamps along the way. With your wits and stilts, you can handle any challenge: pass chasms, avoid traps, break things and smack creatures. \n\nThe full version features:\n* hours more of singleplayer levels\n* more power-ups\n* various multiplayer game modes\n* cross-play with Quest, PCVR and PSVR2 players!\n\nGet the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/", "short_description": "A VR platformer with unique movement, inspired by classic platformers. Arm yourself with stilts and use your quick reflexes and problem-solving skills to complete levels!\n(This is a demo version of the game.)"}]}, "developer_name": "Rekt Games", "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "MeKiwi", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632636206797244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974491_863292728446922_7903663429858675821_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=url
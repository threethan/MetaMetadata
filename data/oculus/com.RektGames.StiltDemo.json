n.com&_nc_ss=8&oh=00_Afyl64vJjjJu93CPngsWWgnjoyvw4fpHPvJ-aFtxrAUBVA&oe=69AD6DE4"}, {"file_name": "ScreenShoot20230222_134922.png", "id": "476007647925506", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_476007651258839_8920636420970540251_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09Jhi1IZA6oQ7kNvwFNxxNg&_nc_oc=Admy87Bo9vz86m_rrzVEX3ml6XsPC8QnmBo7AzZlbTN8WGLIQj5R-S_UEtrn8XEiv1o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkEKBh6wGpQHW73pI0APuVfNCK6xKxNDIKGSFafaTyVw&oe=69AD5DBF"}, {"file_name": "ScreenShoot20230222_135400.png", "id": "1851176918572373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984439_1851176921905706_8454913570376641979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwLcZV1Q2y0Q7kNvwFLjeQI&_nc_oc=Adl4aA0N1M-Xp_cSxuBfJV5sPq3UvFGvt0IUvoPWEGplkfu7M9ny6oTwunxulhKcSmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdYjiPZcukWOJAkYJt2drVhXdfWidmFCFdyER2a3_f2w&oe=69AD6B14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stilt_CoverArt_Landscape.png", "id": "973348187379793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982511_973348190713126_8922137248366989321_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fAUU3ajmDYQ7kNvwGIFrBl&_nc_oc=Adn45vW7ObDds3MeW9jQU9TZKloMsyWocZyoExhzMKacPtbxxkE1M0Jxiau6qwnwhSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNJJdeBMOueQkOFs8cDf5WfbQEcSHuFAUsbo0aPeeQNQ&oe=69AD88EE"}, "display_name": "Stilt Demo", "keywords": [], "long_description": "Get the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/\n\nStilt is a colorful, stunning VR platformer game that takes inspiration from classic platformers. Use your quick reflexes and problem-solving skills to progress through three demo levels, collecting lost gift packages and stamps along the way. With your wits and stilts, you can handle any challenge: pass chasms, avoid traps, break things and smack creatures. \n\nThe full version features:\n* hours more of singleplayer levels\n* more power-ups\n* various multiplayer game modes\n* cross-play with Quest, PCVR and PSVR2 players!\n\nGet the full version of Stilt here! https://www.meta.com/experiences/app/5632444056884139/", "short_description": "A VR platformer with unique movement, inspired by classic platformers. Arm yourself with stilts and use your quick reflexes and problem-solving skills to complete levels!\n(This is a demo version of the game.)"}]}, "developer_name": "Rekt Games", "developer_privacy_policy_url": "https://sites.google.com/view/stilt-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "MeKiwi", "support_website_url": null, "website_url": "https://stiltgame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7632636206797244"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974491_863292728446922_7903663429858675821_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMuqaekBfIIQ7kNvwHsionl&_nc_oc=AdkuH48UdrduyvtTOEvgZK-30WCeVeDDHF3yChRKVy2_BWpF1HiLHkUYx02wCFz0_Ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJTKztUfaJyD_DH3dSnlfUUIHbdDPZuU602oX8KJhZ5w&oe=69AD640F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stilt Demo", "platform": "ANDROID_6DOF", "context_category": 
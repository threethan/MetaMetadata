74493_841057757255897_3097685768482067079_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xl-l1BsJkAUQ7kNvwF6oFjW&_nc_oc=AdqXBo4bzrb4yRKgAl44e7uSs7K0bco2pS-qyJd617KZe5npM6pVuMAOsI5DZQ5iwV0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfPkAkkdiSBsioiVJHV-W01Vz2-FgN6kf3CmXIv-InzQ&oe=6A9C0C40"}, "display_name": "Exploring the Universe from Antarctica", "keywords": [], "long_description": "Exploring the Universe from Antarctica takes users on a journey from the South Pole into outer space in efforts to better understand high-energy neutrinos and the research that takes place surrounding them at the IceCube Neutrino Observatory at the South Pole. Take the role of an IceCube scientist who has the ability to travel deep into space to seek out the source of a high energy neutrino that passes through the IceCube detection array.", "short_description": "Exploring the Universe from Antarctica takes users on a journey from the South Pole into outer space in efforts to better understand high-energy neutrinos and the research that takes place surrounding them at the IceCube Neutrino Observatory at the South Pole."}]}, "developer_name": "WID Virtual Environments & Field Day Lab", "developer_privacy_policy_url": "https://virtualenvironments.discovery.wisc.edu/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "National Science Foundation", "support_website_url": null, "website_url": "https://vrctica.wiscweb.wisc.edu/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
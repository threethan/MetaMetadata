t=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x0rlGhJrcvssCP4wHmVYzruNMux2kKWJ6_kHLSaFNwQ&oe=6A243B3C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUpL-DAiqAwQ7kNvwHhueD4&_nc_oc=Adr_Fm9TLSAkN3_pr39J46bW-rkEZ1tjoagdUuBMO0pfJRYOhDpMNl8vO-6Sq_fAzS8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98QcfPW0IHu5EgpquKqsA2zzcSCvUkWtDzvRr8X-jPKA&oe=6A243104"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2no25q2NHoQ7kNvwGBa0jM&_nc_oc=AdraFmyCuTqmYV5OQxau4b3xRwpEoGvtFKKi6tz8-rtdSEyJLT0hLxH2TG1nV-ryDyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bZlBscj7hrQMK-sPBjy-3DUV-fiJwfUy9fB-eT3gadA&oe=6A24313E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pr-xJLtdGcQ7kNvwEp25ln&_nc_oc=AdpbzzH2Xwu7pcicXx85NKMEt7_lnLsPt1Dd33B-rGpIw6QDGt5sD2N0a35v2zy0Dgo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2QCoObuL4bajZ8g1lsRiD3Y3rEC_VtZotl5ML_3ICjw&oe=6A2448EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EErVhqegtdUQ7kNvwH5A8KU&_nc_oc=AdrCvCKn2sOkVn4zO1phh2w2mGfD6hQkkLeqkf7V5gtf7Liqj7HltmgWe17QbpaI0bM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UlWxmHqUBMmOyj8bEAXFYa_LgKaOlZljdLVSSU7wALg&oe=6A2421AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
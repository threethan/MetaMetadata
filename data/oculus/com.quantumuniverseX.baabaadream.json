t=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzc84vFUAIczODfdVKYtrTF3LqWbR_KuLa6c0j8h8PDuA&oe=69CFA2FC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J38_ZmTUAwMQ7kNvwFYdAuO&_nc_oc=Adr0JdV33XOLC0iWDf9A_0CW3Fy3WNGETVLhd1r19-v4kiC_-7kGNFPhLZoz4_ylKcc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmPAJp7j7l3pG2m_MLTbcxfMhd0sGjwQ4AqxveABQqWw&oe=69CFD104"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwT88eT3js8Q7kNvwEI9Sgs&_nc_oc=AdqumsO4_S3L6E4OFAbN7U3S5viOI771p9n5x9xex1upIjGUAL2SVHej1tA122WBrfE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTW835wkpyqzz-ML_p9LruTXaZTzlN4awkZCEv6tLApA&oe=69CFD13E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQONyU9sCQ0Q7kNvwH8tNbz&_nc_oc=AdrUCGgp5o-zWgYQCX5lyfYRaZ4bto1yp5rl9vXat0gqHK-FRYZFs0u7-5iSVQe4hfw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRlkDUclZIJe9h6agwWlNmjtBHg2LqqmiOACj0cyv4Vg&oe=69CFB0AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aehx0q2lpuAQ7kNvwFj_08-&_nc_oc=AdpfieGt-tyeImjypAEwoK_6rjvgDVmrJ0he6puvV7VeQ-kjj1m9esj5y6k1ZRjZUHQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1IFcbzMwc5-uQh5rlqbsJIvChcVEVC1Mmiq5DOQV7Kg&oe=69CFC1AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
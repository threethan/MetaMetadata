a0a&_nc_ohc=uHlxzR4UV-8Q7kNvwFX26ga&_nc_oc=Ado_eK1YdxGPeuqG7wKNXxHrTiNGXSLJaTYZcISnpXWwiCYOno-bbYlnBNr708acdE0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVKD19WLdQBbxEwzvy_hsi6fCbYXp7LRPgvT4W5IgKAQ&oe=6A94127C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNpjbPfeI3kQ7kNvwHdLWZN&_nc_oc=Adpube7bxRT-vVVmNeMUi_A855KEMG1PGex39sP-TcnN0ddrdUTn0qD1PBZoAvlBr-A&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOUMuQrmrrLcHA2VdTLpAaCk0ximSKRwVTCcYwmKlMew&oe=6A940844"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u87N19xmLqgQ7kNvwGcc2Ep&_nc_oc=Adrnk71Dl7sKTL8wnsBxfflRnxiBWLKwNEETgfprBRgexreQkubSOIemi6c1DFhVh34&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH08Godk9XT1PUlCcvPVda3aTsJKVHDfEVwQ5ZlCkI4yA&oe=6A94087E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C05Izi-0RoQ7kNvwFFMQEE&_nc_oc=Adqjo93ZcytVWSv3tsX0_0Nd3jsbD9j-S6shEEfYNKc00NJQhVti5w5gyTM65_M_m0c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcfHRLCvtJ_5iS7UNFwpgfCtkK8nB0RRmY1Ip4pNHBKw&oe=6A94202B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n7kYxiKX4gQ7kNvwGOaf2f&_nc_oc=Adpeq1-2Tx_9iEtgw7vk9RXjCKpLdPOcrqlCVooaqxDQPr3Q6NbGCAw5TCF34w2QHv8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4uEn_Rg4GmdGkZrk0NlMFeK6fXd7FekNCQgEVcbJmCw&oe=6A94312C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
a0a&_nc_ohc=T1rMsqfy9dIQ7kNvwGwbhKs&_nc_oc=AdrqoMOPh6BSFw_aDBm1KNNtGQVNsDLRUfMbUdp42CLFYZ5NVkuLjPtL8K-Y3io5Qh0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh82PRHPW4spgjPMkZcQbnC4YhsskiW9TLY2jwvyVSLQ&oe=6A901DFC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocOo_og_qU8Q7kNvwEBGzOD&_nc_oc=AdrEtRMzNiEMhQme1xzpoa-RGL3wJyMlDHFbCGmfGxnY1G6dknoDbYdvENk5drmTCZ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaCkin98UHa5I3xDJtImrmJkpM6ljdCNQ44M3aCzxAZA&oe=6A9013C4"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKGKuJPZ7CAQ7kNvwF8128c&_nc_oc=AdrQu0T6EaigftwYx5E_5YhobpkfQgj_DmWGSB5UmLjLKgIAkYT4dwar_joh0faXoYY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjet6GpYeokCiqrSI1sKAIW0RyRSPW7OktYUcBy7pu5A&oe=6A9013FE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1wGNT7mQmoQ7kNvwGS-ThX&_nc_oc=AdrMf0QvkMtchqibfsY0fO6x182Iby9IKuTkVme5gOuv3PL7Egsh4osVFPbIIX5oOhA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIpv9B-KrOTC0h7t-aPSmq0uw_YaDRj7hUNrZzAqSjNQ&oe=6A902BAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l76JBLMsCvMQ7kNvwHL2Rtg&_nc_oc=Adrl_mCBNlY8R6tX2EzYfnZu1AsRqDEr7FAphGChSeoPrw91DadHK7Qa1Lj3BFjRuxQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-YndS4f3jJH27Jxocl1tkJuBDqfX1qSttw2w4MmmNNg&oe=6A903CAC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
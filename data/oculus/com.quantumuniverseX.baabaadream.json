a0a&_nc_ohc=795inVQBzLcQ7kNvwHQBbZx&_nc_oc=Adq2Gpiu_t4nSUf2jFYWGtfj8Oxwym-xcEm05sQpPAECAqi3TJJvXseZFVY2kJrYyYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZsqgsbXXquSFwTlbuS7Rii6mvwGfBu7pFwj2574xkCA&oe=6ABA863C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOMqXBGX6LoQ7kNvwFR9ipl&_nc_oc=AdoVKlyfBdSCgki1O4RIQEj2FIIWkzcGqhU-Fr5lh-3cgqzQ1CaUREhfoqCRcTIqeIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNASCES_A4FPVXO09Y5Cz0e3tl_zSRrH3AGp_W_A5hdw&oe=6ABA7C04"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-Ha50g2ak8Q7kNvwHH942g&_nc_oc=AdqTImZbJ4fJFLnEDIAfpztr309Qs4UoNHgK2fSolJSuCUZNKV1uI1yJozQYvQFOTrc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8SESWXdyksReBqvTbOzFd9oPSl7nQge9rPU5aoREURw&oe=6ABA7C3E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVAuS13DfqwQ7kNvwGjMcEg&_nc_oc=AdolWRfAnVB6O9P7hyv-7CxCNsZdR9IUcg1vMTJfdqnBEDeF8XaSpFRYCFzr4W3PZJE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPZ_w2fdr_av6x_5QRCgTOu0fL4xwp9LRN1nQN8Ey9tw&oe=6ABA5BAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF9KThcLad4Q7kNvwE5rCi6&_nc_oc=AdorhoDBlgzJVfkvUj5-Kdvc7uSRww0EoBPfFN_SrCg44jbFn7k-U1dUBtrCVKJDnGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvfPyck3DagFl2T_1vJrO2uDQS5IPVP1mLOlOrhZaxcQ&oe=6ABA6CAC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
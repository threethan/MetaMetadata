t=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC78lTizhcjWfuRSlb_sshX-lo_IYaClxtyJnBq9RpNxw&oe=6A5378FC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PI4vtB6vNkQ7kNvwFrEFqq&_nc_oc=AdraQG2T42bo89vZcac73KXwmI_YISCsUf55HyZYoAr-ka5S-iGMuFvDKl96_1mqamY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAJzyxoR2kfF7BZxeT61-UYN2uoUiHOVowVoChG7BV-A&oe=6A53A704"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yykaRnWBSr0Q7kNvwHLMpdi&_nc_oc=AdqlJishN8dDyxWd6CEf_Cmm2GQ86Ne9wkFBcjP-rAexT6B_KLDKg6BCf3yCh129ZHc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1UZxIi7aSO-T2SgMPseGhH1y9IM4CHTjMi8Jj38vxNg&oe=6A53A73E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAoBPusp_R8Q7kNvwGl-trG&_nc_oc=AdrfhSMMDr4Zyy0B4Kt2RO2EM8de7ahllvqdS43XexRiYUvhTUbdXy6qGarNGct5KlM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpR5kt58LVdYemvtVh9LPGsds3lMK2iYZrAtou0ImogQ&oe=6A5386AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFbgn_J-mlkQ7kNvwHdgm3l&_nc_oc=Adr00zAhW1HYUhzq4ZCvhY1F11jy0L3YAFGNvzfj8pdpw8NPUkEG5Yr-8QoTBHqDrUY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNzC-SfCA6ju9APUCK9DYJZAvGlBPw9AmUjei65HSZlA&oe=6A5397AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
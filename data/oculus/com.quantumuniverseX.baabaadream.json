t=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DtyNGrvEh5Q4BbakSE_PNbQM3pdGcuS0N1zGrkUHczQ&oe=69E75DFC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IzTnTKzv5EQ7kNvwFKpA5I&_nc_oc=AdoyWb1_LqBHKp2MHZw2alLpO6bYPM47obHBxc6pudaX25YGogfS9a3P7FK4fIMkPJc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HD--cXEwE4heOU2jzJui4e3wBgEiKBm7wtSKSapuQtQ&oe=69E78C04"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjC4iDRjKd8Q7kNvwH82qTV&_nc_oc=Adr5YJMNXvUauIdxGXExD5G844aGE-mG4Qt7PZKbqv5-zhu732X_I-O3qtrJntCkGWw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X52Sl7UEcg3zBENxDAt2iAhILVwn_fHOQWFJe6yGj7g&oe=69E78C3E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLW5XCqlBqcQ7kNvwGZvUtn&_nc_oc=Adq3aUb7gWfgZEBF99_myZTZaXRmEsmwTk7X-SWEfiN1KbQluCX5MC9wCIm0d-JycxE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wWPKN1BKLXQ1wFU5tFd2MWBD8maPTXR48UzZsu3mT5A&oe=69E76BAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWp9q-UdvDsQ7kNvwF55hoF&_nc_oc=AdqXL5WVbta7LxIHA16bCGOtblJKG-BAZRO4spHsnEMa1dyQ3eNwvg0lcSp0TiF49HA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KcT5XMGsnlzbfxJiZ7lHpe41dm5uYmuQlLJAWaR5LgA&oe=69E77CAC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
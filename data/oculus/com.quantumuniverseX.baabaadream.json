r6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk7dJTrMOzw-84wv9T7KjcdSKpJBtwR2cUFBsDEjPN_Q&oe=6A8D70C4"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKGKuJPZ7CAQ7kNvwFNgM6B&_nc_oc=Adr7ZLNG6ZZUWRleG0y7H-NxlRlAReKTJhXCdStuBS-gKgADFUPnKIG_5vYHNawExkk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdGfvy6S1aQ12FbgEMf2nULz-5hrcTQot2LcncAgu92w&oe=6A8D70FE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icIHkD6ePU4Q7kNvwGns76T&_nc_oc=Adp_VhBt9d2YKll2tCm2FyUx2rt1aJJA50l1sMofpgnPxH17NFs1CcsNo50LflCFO6I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-xbW2-oJ460rtWZOiYJFsWdAYvPJ1-Vv3IfC1SgDBFQ&oe=6A8D88AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l76JBLMsCvMQ7kNvwGYh9jz&_nc_oc=AdpW_NSc0NEdjYebnVnhcAjP_-RkwJ9bLq4SvT-2xBJ5iIc2eYI9hDVC_3YTEP27mDE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNJda2y0qZRlX9vrHXpW1X7SUJJe68Uda5DBK_DEHJAQ&oe=6A8D99AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udd25 Welcome to Early Access!\n\nThis is an Early Access version of Baa Baa Dream. We're still adding features and improving the game based on your feedback.\n\nYou may encounter bugs or incomplete features \u2014 your input will help us shape the final version.  \nThank you for joining us on this dreamy journey!\n\n\u2014\n\n\ud83c\udf19 Welcome to Baa Baa Dream \ud83d\udc11\n\nOn sleepless nights, people counted sheep. But in their imagination, these sheep were more than just numbers \u2014 they became living beings.\n\nThese mystical creatures, called Baa Baa, exist on the boundary between reality and dreams. They descend into the real world through a special passage connecting the ceiling to the sky.\n\nAs they blend into our world, they bring a sense of calm and wonder. Baa Baa consider people their natural companions \u2014 you can pet, sway, or gently interact with them, and collect your memories in a special book.\n\nThis is a place shaped by imagination \u2014 a soft, healing world just above your ceiling.  \nThe Baa Baa are waiting for you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28882237768058124"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "685074011347825"}, {"status": "PUBLISHED", "id": "1565835707440554"}]}, "baseline_offer": {"id": "685074011347825"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746781020, "status": "PUBLISHED", "id": "
a0a&_nc_ohc=t0F4imDP8eMQ7kNvwFKJf89&_nc_oc=AdoBB2K1Ca1K6ksBcvTyajlEgvFMXBydaKwlVTKRg1P7bV2GUPjuhona2Ys3-en0QhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK8lC6dKCdERWZZWgVaw9V4dX1J4xH_LHSyimsuKTM6Q&oe=6AB3EEBC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84Sb_ci-FOcQ7kNvwG43w2z&_nc_oc=AdottOMHBQ0jrJ6X42Z-1MDVl9Bvb30svw9NqiQrGQ_4EZNK1jspDM8Hl1PT1RABJJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2u94Vs94MuyERpSzLf2Y9w4X2Hu6FdZI41RFwahMh2g&oe=6AB3E484"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4m2Iabt2psQ7kNvwFEsd1E&_nc_oc=AdoHoREW1qWnPhxS_wIIA7kSOAV_cax8FxbQYMCdOZ2szgcpG4VtPk2Zo1_J4Woyidw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzS3V1nFLxWr7Gul_rpQq7i2eDXeGPR4PDDUvcKY_4Gw&oe=6AB3E4BE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfdQ3EDU9wsQ7kNvwFGS_1e&_nc_oc=AdpPCDjoI8UpBoVwZ6B_y4EJoLZgFVGDZNWngjd71qVtRPjYs6UIZlpaOEZcbi5iyP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvrIyzLz2NlrdrFNTjSVUN3l4AVrBOMS2soiNuqj6KMg&oe=6AB3C42B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1FhpY3bIYgQ7kNvwGl9_E-&_nc_oc=AdpWLS-7hj44hQg1b_VhJEkczSBrHkHw8xxDv16ubhTO9XlHFvb4f9mRfDm3v8leYtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk3Xz4Q7elHO6rRsQB2Vekd_tq6yNOXtMEe8rJkY3yTw&oe=6AB3D52C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
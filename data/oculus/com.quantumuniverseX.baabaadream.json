a0a&_nc_ohc=Co5JhW3fXRAQ7kNvwEadWku&_nc_oc=Adp4Z--mNEpT311FVlArB-1ft4TLGsudVgc2iXMWaieRkAaH-_CB_x-7vrtkHrRqSN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED-y1lj9c0RNReJgDQpyutJQMzdxzAqgCwS55dEmB5_A&oe=6A8C297C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux8Y1l-9HOQQ7kNvwETlE2L&_nc_oc=AdoczqFPORF8yp4mtGAsuNeO82Wt4hmjd7bnlIOL5XpoSuCuHaeuCgw0eTiyfExv2v0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVrH4Llre_LqmLHV5KTyKlLIivVoAl9Dor_apalOzGPg&oe=6A8C1F44"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZocFp0x6EoQ7kNvwEQEYiH&_nc_oc=AdobacS2rUe5SzVJaGtKLLqjz54v4SHcWbkwWe8UfskNpN_R8JRZlgDt2jqUOeHGt3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7SP1IR7kEsX0ELcJKYfPGzoKO_Qy_17YgT09Yg0R8tw&oe=6A8C1F7E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icIHkD6ePU4Q7kNvwFgmcqN&_nc_oc=AdqaX08_ahSC1OmIx8gTTMxCLA6lPUQYHbov19b_OYawyDewiR9EFCFBWmeYnBL-Nl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2oCyp5DPJBPjdNyFVBhVv_Z3kr56PjnqgrejOF6Pm8g&oe=6A8C372B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1w8VViBss4Q7kNvwH9myJV&_nc_oc=Adpi3ekhoalhQrj870ySC4RigZNwUiKi-1kDM6xNBLjPm2wabTc8OIqGt3AbF1ypDRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHevZ5Tdm2eptHdUjd2msJdlT3XfrN5xLCJF-fbvyJ1KA&oe=6A8C482C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
a0a&_nc_ohc=jJ-sLPN6RwsQ7kNvwEHYPnf&_nc_oc=AdoAaRsTY5PHTcJ-IfVOrJKz_-CTXN4ADQekrfBTL4T5tgIV9otLFdzQ4nwembolQZM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlHmKLWi7lSgFmvPaqTmQf1lQEf_eAmJry-1s7SDF74w&oe=6AEC9F3C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4BuZqwDRTMQ7kNvwF2YOeY&_nc_oc=AdrG45cCkwvC_ChnBObrje-l4GclOU8DpYdzjzFTcIaWl-J1iLEA8ewqb-J3Q2mBsYE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAWws1X3wfAJ_0SVjDzZozYHn4RrhDn3OVZfO5Rwmmjg&oe=6AEC9504"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gQlhT0ab_oQ7kNvwH8TGXh&_nc_oc=Adq4SxEE5U7OauD15pMmI-NfTm_pP9gEX0QNK7dNEeXIr3LKEX2NCr5PdkWN5iuJSp8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmGigFc0yUKWTOXvf-TvGePpVSdPn-hUzwr0UCvcmo1w&oe=6AEC953E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az-DIdyskukQ7kNvwFCmVSz&_nc_oc=Adr7S_tvR7aGNwmLdm7tFm8PZfa2M9_EMsO4l2rI3MQYiHUzJ98kb2hVdpPQdn5HGlM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl-xdz39-OtCbYGoP5xNGHhVYLZ6f_0B6_ha9WtPPEbA&oe=6AECACEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6iUhNEUaegQ7kNvwFOdqVP&_nc_oc=AdqEQ8GN1VmzOAEWmG1hsR-RRMfEL1Yrci6r72qY5QMqRlBi5RgiKFbAQPjbG7SnWKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN2golFVG7X-bHseSO7Dg_2-zcqCWgy6994TU18DxK1Q&oe=6AEC85AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5_H14hAarlaRezPYFLSoEQbQP5LRZcaU0OVLvQjq-Lw&oe=6A75F83C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GymbH7j-U-sQ7kNvwFkE1j9&_nc_oc=AdovritxSQbmcuupokOAYWV1gzuDe2G-Y1vMlVuclqNtih9c4_QrUQOp2Z815O3IyhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEYhKjwvwyOkAUZ8w5Qx6TF4Aw4wDlOk3ux5VLzXs2Rw&oe=6A75EE04"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED8lyraLuuAQ7kNvwFIaD98&_nc_oc=Ado-ER8h0uRtbQ00i43BpTLR_mcFJVIdwwiuEvUf-nXZr5s96XGumq4cwLd95bzLPu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEronQr-RWY-vGh_yyhVwLSql3xS3DcX4E3widIWkU62w&oe=6A75EE3E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLtlAznDEv4Q7kNvwHInXmb&_nc_oc=AdqleTlLK0AobGV3sGE0gc6JRBIuz5ZlGimqDXWQkwTLcZil6UqM6t5QCWjaI4wpnDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIn9MqbyCP-FVoN-NbFJUU1XG-tSqd3r1sfvFlQQ3mzg&oe=6A75CDAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vM1JAw53CdUQ7kNvwE6Qhoq&_nc_oc=AdpRrWhmuEjhlLGR45uVgCDKUjKgMgC0gomyknIwEEAO507ZXduPhjVDXJg4yyLuwM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXawSUJbRKy8CZd4ExuKPBt8PochgNjorrCDbeGbtqyw&oe=6A75DEAC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
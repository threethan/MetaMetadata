a0a&_nc_ohc=Crn-dLHo73cQ7kNvwEf1umi&_nc_oc=AdoH1Y70589yJ8-v38qFSKLRidZRTh73P2fubE69_WPUbhRAxsThWSbExXVDfjBwrlY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpoYNp2t6PXW3bRPZCvoWvml07urtZ55wxSPg8Krf1pw&oe=6AE8AABC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCVak4klumIQ7kNvwGngLTf&_nc_oc=AdqwoaqMiNgkyIwSvngWrMGzWWxCueXgyOwJReOFv4rggqcG9xMPoRN7Pxgbjvl51Tg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyx3LMILrGaHahTuugWZzNBE22CLI9U-CPmMHhoIhdbA&oe=6AE8A084"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8ba4eieAcUQ7kNvwGbsmmC&_nc_oc=AdoIL012jfvhNs049OVvHU1dRzBirDxECs-dg8S6TwtaGOTSs9yB-KvIpVbmmakY-Pc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCidrRVp4EGdfp9NTkM7qUgIhFMMe_vw6okKwEOdbFTA&oe=6AE8A0BE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lfD27osr8sQ7kNvwF_30df&_nc_oc=Adokr3DmQWTBqPrn32YqnqA_7CC-7iSrwgqn4z_1rv3QbkTnjiwmogtxIuqqzmcSK_A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNQ6AR_qTQBlndOxz9_2VX7bPSge5-rbBLXn7duiwZ4g&oe=6AE8B86B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdyDQH0sr4UQ7kNvwGFlmXe&_nc_oc=AdqJwX7HaJl5BSJUZKniGwVDypQic527Gigk0xrlXTxeUCqH7s8EUjYi6CsTCWskG4g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS-bebkjivet3KH082R-jqpvKvjUz5dwtez7MK7Ca58w&oe=6AE8912C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
a0a&_nc_ohc=xhhqWjR1nUEQ7kNvwGSTmQV&_nc_oc=Adq6oF0E75V7A-qwEAP1k8OqFKT3Gs2zFfl2aBEvrO-042WqMdrOvum0IL9dfE1rvO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEpi2swZzUd8Jti64xLa6gKlc3cuzHWOH7IRQSXxpvwQ&oe=6AAFFA3C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ131UVttEgQ7kNvwExLKNm&_nc_oc=AdqdY8Mg6e_NP2HqGMUVGku6PBnBJNOraRqYYbzPrzkRVhyoJAwrUiZBFXYM-3tBe_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhVfA5PsD2hhBhqTGVLJ75XjayYQJIXD_f8mONhEJSeA&oe=6AAFF004"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iug1DlDJQoIQ7kNvwFVEV3g&_nc_oc=AdrHt2n1e1qwj5XqgsX6qY7SySTdc5WrwHe3PLz77JDHR4aTRKSgkmZvbOwopuMyq-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlVCZwkoS3JRldlcKVG4-rm1RSjMOtVCUmmf-Q1VWSOg&oe=6AAFF03E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSE7OUbFX6oQ7kNvwHm7gnz&_nc_oc=AdrtjI-4E74kpVtome5KXDn3WMBS7Gdd8wAHnoKTe6WtNMej3QQ5wRkPsSGf2X3a5SA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVsmg4AAm-bd2N5ezcl5h1wt2uWwPz6bbh9Umfy77xTA&oe=6AAFCFAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVHpzs-uJdIQ7kNvwEUwgRw&_nc_oc=Adpm1eLF4_uaM5L-R3vdjvwyKwS2suFmHb0EKKl2FSAZ2B-4UzGEUpLKqR6vM52pzXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdIiyL9ruwyrJFEgIguNv3MXRHwiNQ3HKN2lUSEXmJxQ&oe=6AAFE0AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
t=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKMo4dGiHj58RkDTzo-OuqCw6fl9tFHiIxAXKM7E0dTA&oe=6A5A48BC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri3fnQbyF6QQ7kNvwGNNIh7&_nc_oc=AdrY2SBcHcppy3qDc8kJKMPZpVj2L53e-RYueSEl0xx1hS1ZK479NRCCpxZwuXyw-x8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ_2CgZj5NfQJWlYm5ZyCqJkbjyZ88srIUL07RS3Derg&oe=6A5A3E84"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MJhyK42HhQQ7kNvwHv9me0&_nc_oc=AdraSTztBqWK2OhmcrywR3D_hB9n2eYkC_UkE4WVR4kFxdSzYArNQEfwMSKZd4ZQ16U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA44isB9BkGv2ebxoaaKc8jH-2-QkVeI_Env2QCPcfcGw&oe=6A5A3EBE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Uwsqj-6zgYQ7kNvwEkBiFH&_nc_oc=AdqWp6ZmtFMSDRJPTlCeVyBMD_yPLwbmcrSy0wQNdBlutlln1PPcvGT__fjF3lfGv4E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBARDMxH2KLm73jul-M5983Pn4HGpNmhZibVVqIaI-g7Q&oe=6A5A1E2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPKgqeBR9eoQ7kNvwGUbSR3&_nc_oc=AdrIfhSxTEddVuTwkvtNV3YmTysCVzWRP8wvopMLmpNm251Xs5GACyIDiKpQw5TABhc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzxck_I8m3ujOs6xTDYHW0CuEUYEy4McSN5ZqdspFKBA&oe=6A5A2F2C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
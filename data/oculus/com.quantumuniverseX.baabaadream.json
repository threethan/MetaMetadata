a0a&_nc_ohc=bKBXltRj6PEQ7kNvwFMEJtX&_nc_oc=AdodSGEaewtKW96J9mKtjPJe0XwkpqurzE7akv8YkYXA7gg1iCmPNcTLz4Nny_fqhQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSP0EXWot3xKoyu2ICKB5ombJHnLVaRq3kWNyXK5HlSA&oe=6ACE4CBC"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQQXoJ4xy7kQ7kNvwGmRAdl&_nc_oc=Adppf_sxqPAnrGr6729_W28RQB21QSOLN1mg1GBsgNxsHVOSQG4V4OqAS9OoACD76fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGnPqZw-kZd6YMYMH4lAyAjMDMElmCziz8kd4EmWTRYg&oe=6ACE4284"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7fxVszUyvEQ7kNvwHkrsli&_nc_oc=AdoY_nC2m2qYNmFbPLcyfH--0LRHfs4bxK-A0aoYhPAvQHvWISFjoQpQtdk1vxa5QdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4oM83TW-b33MA1mPCa510vuyfMjYbat87Q99WanFcgA&oe=6ACE42BE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqWquEWlhJEQ7kNvwHH3DwD&_nc_oc=AdqwngQndXSUOrD7hiv-B0vbitjAKmxfRsu-bTpyMTdN4I5NVCTrIJonUNVRGKo6k7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNghseGS5Aq8ysDvsHchSjNbdu4SZnRqTlMdf48js_wkA&oe=6ACE5A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PW1_4XBswIEQ7kNvwGlWFsN&_nc_oc=AdqNdKCQPeJF3rBGRbuqKgEB__FdIZa-t1ePVObBudz58NoKJuulJymPLOP7y79p22U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcF--3OK5ZJrMH3pEb_zQrgZGSSDhg1Z4YtvGgIgMbfQ&oe=6ACE6B6C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING
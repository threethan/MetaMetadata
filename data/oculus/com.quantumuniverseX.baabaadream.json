le_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-u8JcOkQVbIQ7kNvwHZiM4u&_nc_oc=Adm0uiLmsptUciUoMs5PaXND2RxDrFeL0d2vBYFFgjg7I3iFvebQYjwOog0GBH5-QaU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsDz85TWgygYLs_VZBNLSdGlZYso2anvsoHiKt7lxEYLw&oe=69A1AC84"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tDNqOlpRxQQ7kNvwH8Fpyv&_nc_oc=AdnbHox84EtEerO6fFMJrpKDvj1roPWgYUuifRcxLIZuGdOkAfCRSjrDGRdaP9QMeoc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfudHkOPgKVZ70eKwadB5vxp10c6_kZERN-ps6QiSMj6cA&oe=69A1ACBE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBtevazKPMEQ7kNvwG_U2gU&_nc_oc=AdkhL8jk69cxvksB5cpNwlFT8dnS3V3hva3CyVD0qIuhXrXkdtP2Mg60QsrfL5jieIg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs2GZbw6_ugDW6BJ39S1x7M0waQneVjP1VSy3K2QQUwFA&oe=69A18C2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frXt68sCXWoQ7kNvwHfOzm9&_nc_oc=Adl2ov7sMlehaIpZG_iUy5nl8-jnixHA8U2K9o53v4HcYW28PzdC9Zi9soM0FIIcIjM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvnMSkSujvHTZCj4nhUCvzu8-IPVBTNOMKLLJnJfOTJgw&oe=69A19D2C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391852_1239277531084227_8359623734190157234_n.png?stp=dst-png
AfspB_SVDwUZFgtknAV_11q71cDkrb5QWIIlsrJzWodr6Q&oe=69A44FBE"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO1A2JNwnVEQ7kNvwGCukxa&_nc_oc=Adm91aDGmPFxaK2UOQh5mM8LAuerI9_-nP3cSFytsBW95iCyDFuQDmogTf-4zBghkqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afst40S2IckpZ9n6ICw0jDyblLqe0OBAP761AdgjV-f3kw&oe=69A42F2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21REsPg1lYQQ7kNvwEM6tul&_nc_oc=AdnmnyA-MDQQyBu6efCiHVhjd9BeegDoH8YDF00kH6CryGpqRLxuu0iQvWmaiD4TSII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQBEOXksfC3qKu7-xK503kQ4y3Na72izjveWauIaew4w&oe=69A4402C"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udd25 Welcome to Early Access!\n\nThis is an Early Access version of Baa Baa Dream. We're still adding features and improving the game based on your feedback.\n\nYou may encounter bugs or incomplete features \u2014 your input will help us shape the final version.  \nThank you for joining us on this dreamy journey!\n\n\u2014\n\n\ud83c\udf19 Welcome to Baa Baa Dream \ud83d\udc11\n\nOn sleepless nights, people counted sheep. But in their imagination, these sheep were more than just numbers \u2014 they became living beings.\n\nThese mystical creatures, called Baa Baa, exist on the boundary between reality and dreams. They descend into the real world through a special passage connecting the ceiling to the sky.\n\nAs they blend into our world, they bring a sense of calm and wonder. Baa Baa consider people their natural companions \u2014 you can pet, sway, or gently interact with them, and collect your memories in a special book.\n\nThis is a place shaped by imagination \u2014 a soft, healing world just above your ceiling.  \nThe Baa Baa are waiting for you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28882237768058124"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "685074011347825"}, {"status": "PUBLISHED", "id": "1565835707440554"}]}, "baseline_offer": {"id": "685074011347825"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746781020, "status": "PUBLISHED", "id": "685074011347825"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29143090138639551", "version": "0.6.5"}, "id": "644142538210752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28827940180154550", "is_concept": false, "latest_released_binary": {"__type
t=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FKz2NHMsEcw6AjQUpIWs0E7kzi3fZSBI2Zla4wcdvPg&oe=69E2503C"}, {"file_name": "screenshot_5.png", "id": "1701752767378787", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392314_1701752770712120_3620862209308001001_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gPJP3Tc56cQ7kNvwH1i3_h&_nc_oc=AdpLO5ta6gDCNRwxgN5lN8Z2EAmnY4sjQ2d0AaLPHJ8Z9j-hGWvxwCZ4CFkBHMb1eUs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OQY-UyygG3Lg2GUebdOFfhgc7Um2GYngPZFaOW8ufjg&oe=69E24604"}, {"file_name": "screenshot_3.png", "id": "463591620076933", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391852_463591623410266_2982862634553034422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRJ6Pz7NiHIQ7kNvwG1e7BD&_nc_oc=AdoAqHbIpXtGBuN8FhqeIDQ-24fq8GXEty64ZhWbhGIahqqvmklv_hWbvcprWFxhVG8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ssdAYGH7iObcTqacEa1XvZCw2uyVa8cJp1y5AsfihRQ&oe=69E2463E"}, {"file_name": "screenshot_4.png", "id": "1054103879890656", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392082_1054103889890655_2328980176228237316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXTsg9stjq8Q7kNvwEjxNsA&_nc_oc=AdoKPaZqZX90zxaYoHan_zJDDx1z5i55Y2OfczYR18GDzk0QR4TPvny6jH8HXJz6RB4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_hgwGBpsSyDmG60P3F8-xWJV_fFlPdXcC2WAaAUnumA&oe=69E225AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner_Landscape-04.png", "id": "9522439967834751", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391878_9522439971168084_1306106399364227558_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIs4LRYyjcwQ7kNvwFxGamL&_nc_oc=Adoc_TAtsbhPvd5vpNM8GE7CJu8cj1FMdt5yeBE6fT7DvYrcBx-MeOrWVZVKEaDlmus&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af345pmuqE74bt1OA_EznDt_GM3FRtesvr5nB5jg9PKg5A&oe=69E236AC"}, "display_name": "Baa Baa Dream", "keywords": ["relaxing", "healing", "bedtime", "dream", "cute"], "long_description": "\ud83d\udc11 **A dreamlike space where reality fades into imagination**\n\nOn sleepless nights, the sheep you once counted come to life \u2014 soft, silly, and full of wonder. They drift gently into your room, bringing calm, warmth, and a touch of magic.\n\n\u2728 **Watch & Relax**\n\nLet the Baa Baa float peacefully through your room. No goals, no pressure \u2014 just zone out and enjoy.\n\n\ud83d\udc0f **Touch & Interact**\n\nCatch, pet, shake, or gently toss them. Each Baa Baa responds in its own playful way.\n\n\ud83d\udcda **Discover & Collect**\n\nMeet over 30 unique Baa Baa and save your favorites in your dream journal.\n\n\ud83d\udecf **Play While Lying Down**\n\nSupports hand tracking and lying-down mode \u2014 perfect for winding down before sleep.\n\n**Baa Baa Dream isn\u2019t a game to beat \u2014 it\u2019s a moment to keep**\nTry it tonight and meet the softest dreams waiting just around you.", "short_description": "A dreamy experience of collecting floating Baa Baa."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baabaadream.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "QUX", "support_website_url": "https://baabaadream.com/", "website_url": "https://baabaadream.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29445436481738247"}, "rev
716418620_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ_Bn49kq_gQ7kNvwEo4p-5&_nc_oc=Adoo1BcHt5Lj3Ch-QviNV32GOlDc1-G5apZi2KDoYKPk-7bNVWb8k4NgPDEmktrvAL0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNuiiD424WxEZlgnq9EbX8cEZVCAimfIjInaVeTSOHGA&oe=6A9FF791"}, "display_name": "Crazy Coaster", "keywords": ["roller", "coaster", "attraction", "sandbox", "ride"], "long_description": "Crazy Coaster is the ultimate amusement park sandbox! Design, build, and ride your dream roller coasters with complete freedom, all from the comfort of your home. Use intuitive motion controls to draw thrilling loops, daring drops, and gravity-defying twists in real-time. \n\nOnce your masterpiece is complete, jump into the front seat and experience your coaster firsthand!  The only limit is your imagination.", "short_description": "A simple yet funny roller coaster editor in VR, to build infinite coasters right at home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://exoa.dev/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "EXOA", "support_website_url": null, "website_url": "https://exoa.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30121069157492684"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/47
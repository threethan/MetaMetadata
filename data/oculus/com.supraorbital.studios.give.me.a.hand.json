d7kM2dNpEe2DNNB9ZokMPuJcaKhJAIjhUlrEo-ZBQ&oe=69BBF518"}, {"file_name": "new_image00216000_meta.png", "id": "843795155028946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_843795158362279_5227003117963969336_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibM8DflTwKIQ7kNvwEaQ9AW&_nc_oc=AdnoN5-i5DudH3KE6MCgzuBbrr6aGl3lngulsxj1zCk_qxAx11wrTG_GCPx1_Lxfl2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeJzqGbn6hbNRX3_VRpNdjFYQ7LnsTnZJm-ESMPpQLLA&oe=69BC0FA4"}, {"file_name": "images_for_competition00216003_v03.png", "id": "1583389179321813", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300678_1583389182655146_8936520106598357921_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqXmFLvTcOoQ7kNvwG8GRWy&_nc_oc=AdlYpxpmpUB3CHBtWo9G8U-Lp263hJzKdhJwnVcQJ9OoHpEmUZuKfbwlLLq7Ks-1piA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw4jZWTRxWFOHfffSXE_iH3QG9LdLoWGPTPnPz7lO3bXg&oe=69BBF26A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Can You Handle It?", "keywords": ["hand", "challenge", "gameshow", "handtracking", "physics"], "long_description": "Can You Handle It? is a hand-tracked VR dexterity game built around one simple idea: your hands are the controller. You\u2019ll face a rapid series of bite-sized physics puzzles and skill tests\u2014threading, grabbing, balancing, flipping, pushing, and precision timing\u2014where the goal is less about memorizing solutions and more about staying calm under pressure.\n\nJust when you start to feel confident, the game throws in \u201cHand Mods\u201d that remix how you play: mirrored fingers, oversized hands, awkward constraints, and other rule-bending twists that force you to adapt in real time. It\u2019s quick to learn, satisfying to master, and designed for those moments where you either clutch it\u2026 or completely fumble it.", "short_description": "Can You Handle It? is a fast, punchy hand-tracked VR game where your real hands are the controller. Take on bite-sized physics puzzles and dexterity challenges that constantly remix the rules with \u201cHand Mods\u201d \u2014 bigger hands, mirrored fingers, awkward grips, and more \u2014 forcing you to adapt on the fly and prove you\u2019ve truly got it in hand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://supraorbitalstudios.com/can-you-handle-it/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "SupraOrbital Studios", "support_website_url": null, "website_url": "https://supraorbitalstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25425415880458519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308050_2099204857151218_3447978541023387871_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxErS1BQyI4Q7kNvwEZC_BW&_nc_oc=Adk7Y637XLlXvWCTZGyBUf9xaYc8YKPvBrylFcGvEQuqxIIFhWmq0GINCXgFiEUyDRA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxKFzEz61IEpwHERIF2Zqh_yK7lvNIEDhzT62tbTFPHA&oe=69BC0BC9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Can You Handle It?", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
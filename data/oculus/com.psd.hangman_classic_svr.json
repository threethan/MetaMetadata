eadset, pick a letter, and prove you can uncover the word before running out of chances.", "short_description": "Test your vocabulary in Hangman Classic VR, an immersive experience of the classic hangman game adapted to virtual reality. Discover the hidden word, choose your letters, and avoid making too many mistakes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11tYC_9xA1zLG6QcyRSX3cTl7WqfwYJqdSTPdS-5Axrg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/hangman-classic-vr--vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1386106034574595"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2837558203292715"}]}, "baseline_offer": {"id": "2837558203292715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789767180, "status": "PUBLISHED", "id": "2837558203292715"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1391712260680639", "version": "1.5"}, "id": "1377273704516950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
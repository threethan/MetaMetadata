b2&_nc_oc=AdplI65CL4jAqowf2OCnsfYqwOsW9DNYo6bZRx7ijV--raM7bg2DsDmEUC7WKv9k788&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0G1GfPkExFCzn0MhJ-ma7xJ6cqBIApgMpyekCN48SKQ&oe=6AB29D51"}, {"file_name": "screenshot4.png", "id": "4383046621951627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_4383046625284960_6704386613672609703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-MHjAb6rUcQ7kNvwFD_lCh&_nc_oc=AdqDYY3Y7je84fT4bPAVdiL8UNG3E2PvBiU3GjpED7IjPb6Iy3pgAf597fajg_wEcv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfU4YQI5vDfKFJC9igTOvJngTTQsORudDD4a41EOgvDA&oe=6AB2A435"}, {"file_name": "screenshot5.png", "id": "851768347981596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825546_851768351314929_2053146473754133296_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC-4FbdKQWsQ7kNvwGnr4oi&_nc_oc=AdoH-qrRafUszFAc_LZOLZR25ul8cSOOWhESGenumUfor0JEI3MNw_Z7DAsPKT4G8lI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNOI8bvZVdmIqWMu7PRpcAFLaflJ8j8DfJ6YJgp57NaQ&oe=6AB28EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1632542594489813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1632542597823146_3689544893099760675_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-yDZ7-sBn8Q7kNvwG_WA5S&_nc_oc=AdrRbsJvViXeoHWQ5b2ldJnBAWOlBf_O4VwiYX3jSP02LTA8p7rWxShsrk6du-ifVWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3kRGhjSkAfoGiBLaWYm4WePfCNRDPB_sjmrPAiPeEig&oe=6AB2765D"}, "display_name": "Cortex Quest", "keywords": ["educational", "science", "biology", "ear", "psychology"], "long_description": "**WARNING:** This game must be played by at least 2 people. One player is immersed in VR, while their partner must have the Support File in hand: https://cortexquest.github.io/VR.\n# Train your brain. Become the system.\n\nStep into a VR experience where science meets gameplay. CORTEX QUEST is a collection of immersive mini-games for anyone ready to explore the mysteries of the human brain and sensory systems.\n\n# PSYCHOLOGY SIMULATIONS - Perception is not reality\n\nExperience neurological disorders and how perception can dramatically change.\n\nExplore three fascinating conditions:\n\n- Prosopagnosia - struggle to recognize faces and rely on alternative cues\n- Hemineglect - navigate a world where half of reality seems to disappear\n- Body Ownership Impairment - question what truly belongs to your own body\n\nEach simulation challenges your senses and shows how the brain constructs reality.\n\n# BIOLOGY ADVENTURE - HEAR WE GO!\n\nA scientific accident has changed everything\u2026 Your team of biologists has been miniaturized and sent inside the human body. Your mission: explore the auditory system and uncover how we perceive sound.\n\nEquipped with advanced VR tools, you will:\n\n- Dive into the cochlea and uncover its mechanics\n- Activate hair cells and observe how sound becomes signals\n- Manipulate sound frequencies to understand pitch perception\n- Trigger action potentials and follow neural pathways\n- Travel to the auditory cortex\n\nLearn hearing by doing, experimenting, and interacting.", "short_description": "CORTEX QUEST is an educational two-player VR experience where one player explores the brain and body, while a partner guides them through puzzles about perception, neurological disorders, and hearing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://novascience.github.io/VR/PrivacyPolicy/CortexQuestPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Dawson College", "support_website_url": null, "website_url": "https://www.dawsoncollege.qc.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "ge
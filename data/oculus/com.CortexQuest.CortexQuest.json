qf&_nc_oc=Adq0y6IBQ3ZLofeWNOZ-qJwThP9FwIcx5edghIt8pZaZorOaHjptQnYol-CNcl162Tw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm4z8qD_snUEY1RxhBSmFQQ0s9-GHsqWwdZU_RmRpusw&oe=6AF48851"}, {"file_name": "screenshot4.png", "id": "4383046621951627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_4383046625284960_6704386613672609703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDPGKYBAv0EQ7kNvwHWM6Ll&_nc_oc=AdrBGT1zx9wQMOWHhNqn_EiyECFVGbKS9x3-aW94gHR3aUlB6CKNXlexga8FWRsyN0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmBlkXGl78LyZZn2TpeBcIXghEefx4z1-FV3QY-lNKEA&oe=6AF48F35"}, {"file_name": "screenshot5.png", "id": "851768347981596", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825546_851768351314929_2053146473754133296_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj4co0gXs3cQ7kNvwHW2hdn&_nc_oc=Adr0zlj2waPOLGBRy2DDqAXagzaPKPkA5LzYJTrN5dpdoYI4krdxzID04O76-ePapfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnPQt3T78Rjj48Wq9hu8Fyw0l0qB21a8EcPUt9KrF8tg&oe=6AF479C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1632542594489813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1632542597823146_3689544893099760675_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n5IADXxzWQoQ7kNvwHF9Lsj&_nc_oc=AdpwNy3YD8w0yw1oteo99ol0Ul_buBgVn_zwX-KmgxZqiN4WXDT3kdxFaSsEugHznqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbIh4vzRWefzQndtyLx5kt4pB0fI1KzupY0D64w9Sz8A&oe=6AF4999D"}, "display_name": "Cortex Quest", "keywords": ["educational", "science", "biology", "ear", "psychology"], "long_description": "**WARNING:** This game must be played by at least 2 people. One player is immersed in VR, while their partner must have the Support File in hand: https://cortexquest.github.io/VR.\n# Train your brain. Become the system.\n\nStep into a VR experience where science meets gameplay. CORTEX QUEST is a collection of immersive mini-games for anyone ready to explore the mysteries of the human brain and sensory systems.\n\n# PSYCHOLOGY SIMULATIONS - Perception is not reality\n\nExperience neurological disorders and how perception can dramatically change.\n\nExplore three fascinating conditions:\n\n- Prosopagnosia - struggle to recognize faces and rely on alternative cues\n- Hemineglect - navigate a world where half of reality seems to disappear\n- Body Ownership Impairment - question what truly belongs to your own body\n\nEach simulation challenges your senses and shows how the brain constructs reality.\n\n# BIOLOGY ADVENTURE - HEAR WE GO!\n\nA scientific accident has changed everything\u2026 Your team of biologists has been miniaturized and sent inside the human body. Your mission: explore the auditory system and uncover how we perceive sound.\n\nEquipped with advanced VR tools, you will:\n\n- Dive into the cochlea and uncover its mechanics\n- Activate hair cells and observe how sound becomes signals\n- Manipulate sound frequencies to understand pitch perception\n- Trigger action potentials and follow neural pathways\n- Travel to the auditory cortex\n\nLearn hearing by doing, experimenting, and interacting.", "short_description": "CORTEX QUEST is an educational two-player VR experience where one player explores the brain and body, while a partner guides them through puzzles about perception, neurological disorders, and hearing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://novascience.github.io/VR/PrivacyPolicy/CortexQuestPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Dawson College", "support_website_url": null, "website_url": "https://www.dawsoncollege.qc.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "ge
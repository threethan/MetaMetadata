W0&_nc_oc=AdqqU8yy-xvyIE10YUEhnur5lD2xYaACSVOTDK9SvVk695IBgFjTs1HWJfBu8wc1N7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMWsIio6G9sposC95WVEXF0LyMtVNIZfIViD1eCHL9CA&oe=6AE21351"}, {"file_name": "screenshot4.png", "id": "4383046621951627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825462_4383046625284960_6704386613672609703_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLzkB6TXdycQ7kNvwGpfwZ9&_nc_oc=AdpQhcSxVDpRyHYn5iaK8PD4u9wp9U_008WiDZxwfHrDjOaZTRNu42X7ZVkfkaksPH0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6r7BxJlOWiS2MYj3pBKNQl_GHj2eteJXiBjIlHX_gxg&oe=6AE21A35"}, {"file_name": "screenshot5.png", "id": "851768347981596", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825546_851768351314929_2053146473754133296_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b60U9HlHX9YQ7kNvwHq3t8R&_nc_oc=AdqlFT4JC4tvXuxgFtT7elUyaOzJeq3n1Y-Ax36wrlPBvO1jEOPA9aHa1rBhFyg0EEA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJd_bNlcpuHXrRkLhzK-yMFGJMcO6pEFgBezjinxQ2cw&oe=6AE204C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1632542594489813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1632542597823146_3689544893099760675_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNlAAIQRZwQ7kNvwG25072&_nc_oc=Adq-KbJbvF-jeweAYSk614sAjR2I1Ht-owKYjspf_7aYKKwtgwNSvD6-HFsYsrTQnrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH1B2mkkmZXMLJoGda77hnols1VKwykPM8yhn-kaWEPA&oe=6AE1EC5D"}, "display_name": "Cortex Quest", "keywords": ["educational", "science", "biology", "ear", "psychology"], "long_description": "**WARNING:** This game must be played by at least 2 people. One player is immersed in VR, while their partner must have the Support File in hand: https://cortexquest.github.io/VR.\n# Train your brain. Become the system.\n\nStep into a VR experience where science meets gameplay. CORTEX QUEST is a collection of immersive mini-games for anyone ready to explore the mysteries of the human brain and sensory systems.\n\n# PSYCHOLOGY SIMULATIONS - Perception is not reality\n\nExperience neurological disorders and how perception can dramatically change.\n\nExplore three fascinating conditions:\n\n- Prosopagnosia - struggle to recognize faces and rely on alternative cues\n- Hemineglect - navigate a world where half of reality seems to disappear\n- Body Ownership Impairment - question what truly belongs to your own body\n\nEach simulation challenges your senses and shows how the brain constructs reality.\n\n# BIOLOGY ADVENTURE - HEAR WE GO!\n\nA scientific accident has changed everything\u2026 Your team of biologists has been miniaturized and sent inside the human body. Your mission: explore the auditory system and uncover how we perceive sound.\n\nEquipped with advanced VR tools, you will:\n\n- Dive into the cochlea and uncover its mechanics\n- Activate hair cells and observe how sound becomes signals\n- Manipulate sound frequencies to understand pitch perception\n- Trigger action potentials and follow neural pathways\n- Travel to the auditory cortex\n\nLearn hearing by doing, experimenting, and interacting.", "short_description": "CORTEX QUEST is an educational two-player VR experience where one player explores the brain and body, while a partner guides them through puzzles about perception, neurological disorders, and hearing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://novascience.github.io/VR/PrivacyPolicy/CortexQuestPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Dawson College", "support_website_url": null, "website_url": "https://www.dawsoncollege.qc.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "ge
&_nc_ohc=oQxeFsNv1PkQ7kNvwHajEPb&_nc_oc=AdrGkOkF1NIQ1djcoK79kkU63uOWrVlExuMLlch2ZHRXnjb4PsC_jHa3zXFtW26dyXk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5e9oalg8x_sbvCKKU8q-G94Q1tAFcbrs432a0rk4IOA&oe=6AA17B45"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZXBB4_5P-8Q7kNvwEGme6e&_nc_oc=AdqbPPr13176muFgWF7jmJppv3DYbiJObd7RBHz2BZ38zChMAfYGsL9UfEDKQwJtE6I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6KGLFNEPLMVc9mcyR44icdhlSi3YKwYPEBLo6qKd-oQ&oe=6AA175AD"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nkp3YP4VSsQ7kNvwGbSnOE&_nc_oc=AdqHtGWMaumfRmz5kxW8PMQSNFHW-gZqIGZmB1dmpbNzSDBxVvxfRRonLSYpHwqF-sY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-VoCNdvB0R8L91KLb-7cRvLbGKORMDn0TGD6o9JGPGQ&oe=6AA17D65"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_tPgsIz190Q7kNvwFW4eq3&_nc_oc=Ado-KSU1RHwTOrfxP2J6SFLDpcUNI3tOSV2Q4tC4gEL9yX11p8oBW2Sh3u28MnKwD4k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC_JNQzuZ5K-IpionTTGdJ9mxSLQrsOqVhzWl6lYTHFQ&oe=6AA15B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3sjK9O7CNsQ7kNvwHUbyom&_nc_oc=Adq0wuRIVZ4oVGuhoHGDjqTxnhTLNhKu9dDbkIHajgPPAUDIYzUvGWAwqOk9OsToqyo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfsoP-Q7vYZXG8k-butuHLgAjKM2EotUf5YDVVxAd4Pw&oe=6AA162BB"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are
ttps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308050_1764989298012032_5221770802455402095_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XExchHOFqoMQ7kNvwHL8R6O&_nc_oc=Ado-7fkXM6hWssC5PmlvBBupjE9oyow_QoTDit_UG2l77CWoySo-Isi4MgFciMmwjHg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kbWdIceJAr0V9CQlRfmatZKBSWCAvqFqPp4kHisCl4w&oe=6A413DC5"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wxsoHyks5AQ7kNvwGVX2eW&_nc_oc=Adph_bqB448n-pCYGvUPUv9a9LPHB9r9vVR2f5CUYUZ9tw_6IvP2mNYM8-G8DdMGuhE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97lMy-s3hxUSeWRU6QDfNVy9NFJFWTW8BlDHYtqv3vjQ&oe=6A41382D"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuiHNMpx4BsQ7kNvwEgIdWw&_nc_oc=AdqUBM_FJ1Ns73LLshDIW5Mm9ibu_-q65hEN48dC07DaNfz5yOCa3nMp6bZoaKwyYm0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NSmsoMwfXNWEcs8n2DzKhQEtVSJwvTbIdAYhotAG1uA&oe=6A413FE5"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wt_un1Dfi30Q7kNvwFD32ei&_nc_oc=AdoIciuHjB9OImgavvijxssJD5YFe6RJc-uhC29a4QMeUGTBB_L7TVXUH07lwW0K_SU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UAOytPh5L4AToN6ROfK40D8JRWY9GS6tOmVKr2KvcOg&oe=6A411DCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4d_LQPMDpYQ7kNvwEUskPg&_nc_oc=AdrAiHqDlrS7JT3DUz0wj-EGuySnE4h8zxdIr4grIbMvrvBTTf-PYbCSJLEr0yAP25w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yL9dZkV6d1QF9-IDgh4DdTGz_QHQEXnEmqQdlh8077Q&oe=6A41253B"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_
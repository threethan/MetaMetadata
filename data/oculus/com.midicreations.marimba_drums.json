_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o_xUjb7IU4Q7kNvwHSOkoJ&_nc_oc=Ado3ZePbx7HtUhckAKzpyj9Xz98UBPeKvZELgTKgF_QxHfC4BePsmnrDmVNzzvsu4Ro&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTd-ButoxbSslnJPQQMUo041ZSP3vIKeI9vCMyDERw9Rg&oe=6B0B25ED"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFZ_GC5dvTkQ7kNvwFnMbfV&_nc_oc=AdpFUmSIKAkEuTrL6f4zrzBSnrx5LTzDMSHN7xBNsJ-SO1-WTFVeZtBOKZnA4nvjTB8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQd2c_dYWsPOgFGTZoguRkgSr0ftlHjdF2vP5J-hHEw-w&oe=6B0B2DA5"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJJ5kwlt-c4Q7kNvwHmGZUk&_nc_oc=AdogpnOFE0HtOB_ISkKV-5iiLXdMQVRDHzZqqm84txmTu51fMMpZB9PEaoKZ1XhQPNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvnTPVOSazdC86Y7RqLlVT6vBb3ZL4HO0wUnRH9D9CVA&oe=6B0B43CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LD-AYJPL58EQ7kNvwFk3oPR&_nc_oc=AdrtSCC30dnpWsqr8ABHN_eX5vItcSLuMzq6zeCZY3CcwVYoyUCsRjAhlYgjWgPXm5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMNbqDpE5FgiGW1DvyQpxkiWVK6sEJ98kvLOzbxF4RlA&oe=6B0B12FB"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_R
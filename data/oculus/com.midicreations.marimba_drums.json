&_nc_ohc=4Aq6eG76aqwQ7kNvwFW5oIG&_nc_oc=Adrb4tWbqB6_w3VWJSHchpLxwKObnI4i2iYi6Ntdt3bBN6ZrMON7GUqEMKiKvWKeN9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNanKuTCIMWlDCCs7hNmU1N4fmuT1I43aA_S5tGn7YmNw&oe=6AD242C5"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcTTzC1XTZMQ7kNvwFBX_g5&_nc_oc=AdqBrN-K0zHFTsmsI_Vke_8brVEEpiCl30uJls4sNM73eLSUjOe8zgpFRaKexTPMGd0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9LkgMWTjjKPC8J1allRz69knaLaYffp4bTAv9vaPlKw&oe=6AD23D2D"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx2lFhfx5zMQ7kNvwF-VByJ&_nc_oc=Adp1r6fu0vF_BTNbXjmGraSi8BBdJ_RdqNUV0nNoihtma-CRXO51XsF1KLYsnuITQuQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGcEa8v6XAC9sER4wM4nzDO8Q7LFzw-lgDEOVXFpIZgw&oe=6AD244E5"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igWNtWKWIuMQ7kNvwGFcyGf&_nc_oc=Adp5JBGnESBt5v1jvqZDmDZBJZmRifUN-FAcgFMJnjzq-cZNbUO8Spnf7RPPGgA9OPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkMVbl8q4mDoqiY_yhdKHC5xdqK5wSdxuV5CJJu-JOmA&oe=6AD25B0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIezHIQRFHcQ7kNvwGZV8JE&_nc_oc=Adr6VXgQj9zYp93AS-2x2Fi7eS-WNE_KOv7I-RJAaxe05ktIQ_UD06UGO1FCmijheAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaVg37CFerjTI_FtNSLLEpc_se3olWBFiqjdNo4NZ5hg&oe=6AD22A3B"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are
nc_sid=6e7a0a&_nc_ohc=cIDiC2F2Be4Q7kNvwFM3g9H&_nc_oc=Adp8JvYIl79ocEnn0owYeRE5X8lC4mnr0Y_KLZiTBj7zII6N26VrdzEXEsuHWrHV4po&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6RLQ_ir1XgC_1OD2KcSc-S4V2LJyfnv-6iU0A6ZSdxg&oe=6AAEAA45"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuUpAoFxpNgQ7kNvwHpupsk&_nc_oc=AdpAXAwnev7GSM_J7T7SlELSgvXOz4eiY43mHgwH_obs-H2kO4r-F6Fo51KCjJln0xE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDHQXvdlSXirtbMo_r3yr10SQYMn3Nl-ln3aJN570_yg&oe=6AAEA4AD"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3t4wiK6PegQ7kNvwFHxsu_&_nc_oc=Adq-43KShXu-F9SXPMauiuWkPbOKge-As9smsqxCPjtaNuME4Is9SGz2uLEBQMIYh9Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdHwMJt-TM0smlpNm2seNRYWnTQs5XQ0CX9qTq_S-c9A&oe=6AAEAC65"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqu7N8YDILEQ7kNvwGYSWs9&_nc_oc=Adqa_gfilC5VbPmWZNrSR5sQXphWBv7AECVcA4QvVtPI0Gwy8YGq8QZtNMu2XcwDMQ8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoC_GOm0oLvnsjhTMilVeE0WFGjOSFEVHu6RHxpu7OFw&oe=6AAE8A4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4U0oKMHSSYQ7kNvwHwHCfg&_nc_oc=Adp0_Q9y1PJ7VVZMoKl28t9hp-eqcg1Kh0ZQiQqeFdhoVXjbPdQbRPdSB9J_AjNfasY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8kjx1K1JCg4AbSozv7TG409n1xPw0xrD1kPQIMiC_MQ&oe=6AAE91BB"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blog
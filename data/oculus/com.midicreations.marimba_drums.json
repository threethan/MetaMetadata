&_nc_ohc=OnIvtsGswB0Q7kNvwHLclFs&_nc_oc=AdqsoozFbmUrE-ZV9bSek_grvFgPD0mcvpzHpN0S_Q_QEKdMwo6_9IL6ffMJEJZ7Q1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5SUqg6QQf7QncyWu__CZk24-_7r57GSV64yDD3JsUew&oe=6A95D605"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WvX_rzG15UQ7kNvwFXhH18&_nc_oc=AdqpWYWGsSuervVxo2eqLcabhEDPNrq_QtV3a6wl33dhx3CYltkjDa5hZemUp5XKdTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-vCqfhCUuMIrJGMgQ3jvkQcq7BoSDKvk4Rd_9JAcZ3g&oe=6A95D06D"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODk_mxaTfWoQ7kNvwGxFaCq&_nc_oc=Adp2zAUUuKRVvYE6Cpb60EE4dA36iS_0z55_gtkX06zEBHxx3AHOxJDrmlmczlNItzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFytmqk_ym6MYRM4eYNJpEqks50979w-rzUZLt4--tqaA&oe=6A95D825"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRTmXSsR_OsQ7kNvwEJ6zlK&_nc_oc=AdrneYkulwuqfeOQQdUk239wqUCOcoBKlTHnUCDDtNCpTNPbHBi5IfIw8CaJjfEIVKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTMLtGsGa4zJMHwKNmfZDSEsU1OtAuKq4jyxntxT9MIg&oe=6A95B60A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3u2Ui_gqTIQ7kNvwGIiBrH&_nc_oc=AdqNHYPV1Qh-mECqfxqMDXCH2L574UO_YYw69G-rFw5kZ2UIzHLp8HW1z_miH9PBk5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_chDoyMXSmYmnVb1ksjciFSKXn-sYZgUql55SV7NHyg&oe=6A95BD7B"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are
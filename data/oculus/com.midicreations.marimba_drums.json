&_nc_ohc=e2ywSr9p_nUQ7kNvwEEp95X&_nc_oc=Ado8C77cn2MCirYH2786ti0Ij1CIijhBELCIGr24jdoF0R8CUrbfXiTt1BbL6Hc4BGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOS4xFXCbRbTNp5invpu210q5UwidVfM4ca33l1Xu8Hw&oe=6AC270C5"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcMnGbMtHZgQ7kNvwEcxA1Z&_nc_oc=Adp6R4f8533ZoFhiJChSkofppx1e8tEb4b_v-N6YNekygNkm3WzpmoNIzsOQtnvbVHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmKDi1U9n6DH9h7I6Pih0MMHF7kT4cTVcZzG6WY9WN5A&oe=6AC26B2D"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-jIjbJPH0gQ7kNvwHV7jtw&_nc_oc=AdoNsfPJ2Gi8GCYn1pfwngwhhxbjnP-ew6KokvXh8Nj4M1vrLBqtNVBIXdsI9aUF7AA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZLFN8O14x7CkXgx1aDZ_9tJvlcJ7IOurJrEE6tfOgXA&oe=6AC272E5"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLT3eSzbdZUQ7kNvwFmcPr4&_nc_oc=AdqDWv-hHT9bUJ4ycg4AmvPKxRTBGMy9b6zaUWMaZF3jWDlI8C0XY-Rc1mT3wtA3Aks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnwv19_5-6TnZPsbKwfDf4pKrCRUZUnY02iVuAn9K37A&oe=6AC250CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIqkdqkc8RUQ7kNvwFzW3Uv&_nc_oc=AdpzcAfLh5hTNhGzhvyMc2KJtoWD0azFjeVCFbyv_uVHRWwAN4FaVpGR6LFwByxgMfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE-fZsO19L_0WG5US3TFpR4Hj6vFdWXl_XlQVZomGq9g&oe=6AC2583B"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are
kNvwF-VByJ&_nc_oc=Adp1r6fu0vF_BTNbXjmGraSi8BBdJ_RdqNUV0nNoihtma-CRXO51XsF1KLYsnuITQuQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGcEa8v6XAC9sER4wM4nzDO8Q7LFzw-lgDEOVXFpIZgw&oe=6AD244E5"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igWNtWKWIuMQ7kNvwGFcyGf&_nc_oc=Adp5JBGnESBt5v1jvqZDmDZBJZmRifUN-FAcgFMJnjzq-cZNbUO8Spnf7RPPGgA9OPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkMVbl8q4mDoqiY_yhdKHC5xdqK5wSdxuV5CJJu-JOmA&oe=6AD25B0A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIezHIQRFHcQ7kNvwGZV8JE&_nc_oc=Adr6VXgQj9zYp93AS-2x2Fi7eS-WNE_KOv7I-RJAaxe05ktIQ_UD06UGO1FCmijheAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaVg37CFerjTI_FtNSLLEpc_se3olWBFiqjdNo4NZ5hg&oe=6AD22A3B"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-updated-at-2021-09-17.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3261512174032297"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1028756336511398"}]}, "baseline_offer": {"id": "1028756336511398"},
&_nc_ohc=D3kSYTJE4IEQ7kNvwERwXtk&_nc_oc=Ado8e8drrwZAsU3sja0L9iLUV95QutgS-NlkDjQLYoQl_9paHb5x82unm9YrHodobq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJERSpzylhJIPTX6OBYKeI4nQHfm7aGwLxsWq7KlnVcdg&oe=6AB3F045"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MTnM41AFhMQ7kNvwGT9Xtc&_nc_oc=Adrsm22-Fo590jJJQrxyj1W59kQRJwtU14TBTxflosLOjvdfANhkZ1U6LGtTPXrp_Fw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO_MFgEpX26RXICE9ilM9uGNQVAOfVDJPTt69c1LBt4w&oe=6AB3EAAD"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3YRIBHQeGUQ7kNvwF2ISgf&_nc_oc=AdqfCdWe-udjv9bQZyLL4PHlNAaGXLpjJ_I1-VTEQUxiWSh6ljiQ1qdFpBXLims2Pog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqbUeizdXJHnFwsiQNOClomN4FIixyA89ZHyK7WhKXRQ&oe=6AB3F265"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwWF4QLvxfgQ7kNvwH1amJf&_nc_oc=AdrrUIShGMqeSaS0bJzlYBBytCxNIh5gyypDs2Q2U5LTXA7yVt0tyPUVml00Ap9Ns9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE43qX3Bmj0w_JIh77qq7bNB-lNaCml4DkJBepAWd56g&oe=6AB3D04A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrwYI_oFyWYQ7kNvwGE4KxU&_nc_oc=AdrMxzZWIKKkoUbjZ2nScp-57yKoWAgIXsKmd-ZH6HQMcqX0PchOLRv71vaJ7L232wc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3pFuriTmcgM_P9YWKBZzeLBupLOpJu-G2-2VkriXHZg&oe=6AB3D7BB"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are
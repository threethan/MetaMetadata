&_nc_ohc=SnA2Jn0Sq_YQ7kNvwGrNi6Z&_nc_oc=AdrWhRxxzKbRsgkD0B-pVPuFJprc-9lv6dJ_UH5ijQt2FF7FvqxYZazX3BeOJycTpNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaXRQwZADsPjjkV_KcNCCf439Tq6jL08NSJaVn-taDvg&oe=6AA6C145"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xovw8xDVteYQ7kNvwFN-RIm&_nc_oc=AdpfKqO1ZfjGkUxACUPsHns0fcvLsA2Xg5WlSrj_gs36-7v6ckl-vteOXVY0UkuBhgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp59c4hSAQg30FSHOj8J_JBDLr28228I1Ffl-XJiWQcA&oe=6AA6BBAD"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwifSM5gNm4Q7kNvwFgh1px&_nc_oc=Adp5yCZy4HdR4ULzVcHcI8lRb_uqHHxJ9VfuGwJ9vqmS9-fouwW_QuESQ8St5o2UNlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA6-TAEeY1TGYh9aVKlzptuFkmons689_Mu_Fx3cq-CQ&oe=6AA6C365"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFVh1NTP8z8Q7kNvwF6kd1O&_nc_oc=AdovBm2XIyxk6chb5doHEx5ubABrKy93zlyvSMx2XAxc8CTCtwLVPYiN7d8nBIFwK2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJBL2q672O0EDh3wdsGxUpp8wr_H0EcpnOjJHAz6mbRQ&oe=6AA6A14A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-HL7zik968Q7kNvwEcqDeq&_nc_oc=AdpII1ShUq6xe4fBdjxO_c-lAVfsRylgii2fwF0hxKXVWXW4k1kRi5EEQ_5cZJarH10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9COzV7KCbMXvXMEQxzAh-aDJuR6saQXjPDOIDQ7evQg&oe=6AA6A8BB"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are
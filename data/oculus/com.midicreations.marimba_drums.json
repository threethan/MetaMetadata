content-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUR9qNELin5AUA8pqBSaqjpH9AFAg1-wG77oABXHX_zw&oe=6A819F05"}, {"file_name": "Screenshot3.png", "id": "2849251008744965", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499313390_2849251012078298_4496029539768537969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmB8__Tsgl4Q7kNvwEnJF2H&_nc_oc=AdqkXCuUq62AyP7H_Sq9giAOa-8LRmIcfVhsCYZmoNKaxjyPsTOZBpR5eS_-SjFCdhw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRzT8J2qa384z9M4PPayUpVhXrlJvV4FX_NthPM4mkQg&oe=6A81996D"}, {"file_name": "Screenshot4.png", "id": "2172497963533921", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499312310_2172497966867254_8490891792444646481_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frL8Y98RwuQQ7kNvwFLFgj-&_nc_oc=Adoa06NdWY26eAgLwRLOqk562RvIFqdfEo5hfyrtMhGVSs53GC-GVHGB76cwK6rt_HQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhTok2NCwP09iTmR0MFejKThMtcsMMCPPfXYegLeMAZg&oe=6A81A125"}, {"file_name": "Screenshot5.png", "id": "1271128714834048", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499310817_1271128718167381_6131363282333574744_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJG8K_A3ZI0Q7kNvwE9d5qx&_nc_oc=Adqrrl05T3A1R9vBztDDM3zn4k_S8a_5D87gOsgU05Z-dkkWviVkw-wuB0ID2figJvs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPnv3YeTYq1HT5iOjD3M_meRQo2Db01a4-vB6qGOJ35Q&oe=6A81B74A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "36642320552047963", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499299164_36642320592047959_6419047076905873115_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZZPZ9ryFtoQ7kNvwFqA62r&_nc_oc=AdroP60Rtk6WBAmQaFzvj5J4IdoVhYGpecjH9uSKpXwunVfi530SgEwctiTovmQJFvM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnPx_3Hvc8Z7QVQHGlVGKy8TGx9jLb9cdLW_8a7Y84Ow&oe=6A81BEBB"}, "display_name": "Marimba & Drums (Midi)", "keywords": ["Marimba", "Drums", "DrumKit", "Xylophone", "Midi"], "long_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime using your Touch Controllers, the Marimba can be played using the Marimba sound or you can also choose between 127 sounds like: Piano, Strings, Guitar, Harp, Xylophone, Organ, etc, letting you use your Marimba like a Synthesizer.\n\nPlay the Drums with your Touch controllers, the Hand trigger buttons of your Left and Right Touch Controllers let you press the pedals to play the Bass Drum or to close the Hi-Hats.\n\nThe application let you to load midi files to see how to play a melody on the Marimba or on the Drums, if the melody is being played too fast for you, you can change the playback speed to see slowly how to play that melody.\nThe application ask you to pick a Midi channel of the midi file you load and it will mute that channel and show you how to play that melody, or you can also simply load a midi file without choosing a Midi channel to play a midi file in the background while you play what you want.\n\nThe application comes with 15 midi demo songs:\n- 10 songs with a Marimba Channel\n- 5 songs with a Percussion Channel\n\nPlace your own midi files under the directory:\n\nAndroid\\data\\com.midicreations.marimba_drums\\files\n\nTo load your own custom midi files on the App.", "short_description": "Marimba & Drums is a VR Music App that let you play the Marimba and the Drums in realtime, you can also load Midi files to see how to play a midi channel of that song on the Marimba or Drums."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Marimba+%26+Drums+%28Midi%29", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "conte
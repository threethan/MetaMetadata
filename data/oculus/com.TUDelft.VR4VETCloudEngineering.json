0BisIUMynQ&oe=699848F3"}, {"file_name": "screen-02.png", "id": "25229685889975813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_25229685893309146_9060463009246778571_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAStTvbcsMsQ7kNvwF3opHC&_nc_oc=Adnw4AkK0bXkPlTDZ194Fn0LpqSSwVTdugKs1CQzzbkidX_y1ZB_a1DT5RvFBVnv-YA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftGRGndupgJZQTmEW8VEyDAYTMoB3o_1jBHWZADcXfDDQ&oe=6998479A"}, {"file_name": "screen-04.png", "id": "1102960225242797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299808_1102960228576130_3476505537820444180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xHIz5IZJnIQ7kNvwFwJaMz&_nc_oc=AdlEfFtKtKSEuYaceCjgXIvUt_fx9JX0-4We70zsxAkg4847IkJj0LUOQ7Nw09Q6UIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfutqALrFdTluXqJ84EJ-MekEtM9i_f6IaYgHlV3DRg-Hg&oe=69984304"}, {"file_name": "screen-01.png", "id": "3727214050917114", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304764_3727214054250447_5465507135370727558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzD9b-crgAkQ7kNvwHGA8k4&_nc_oc=AdmTh3UwGuuFL5ZRti7YB6ROMxx2z2OcrFKwsnqYNWGrcoC1qSHbOAyWfFxqL3-QW7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsCyP93kTuW_VJAFkd8NPDBNkVaFFxXLVdZJAYmnfYILQ&oe=69984B5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4VET Cloud Engineering", "keywords": ["vr4vet", "career", "cloud"], "long_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets.\n\nThe application can be used as a supplementary material for the end users integrated into the career guidance and vocational education practice. When in the application, the user takes the role of a trainee at a clould engineering center. The user is introduced to the profession and can engage in typical workplace tasks.\n\nThe app features:\n- Setting up tickets in a cloud engineering center\n- Working through different tickets in exchanging and replacing hardware components in a cloud engineering center\n- Completing different introduction tours to different hardware components and how to replace them\n", "short_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.educationandlearning.nl/projects/virtual-reality-for-vocational-education-training-vr4vet/", "developer_terms_of_service_url": null, "publisher_name": "Norwegian University of Science and Technology", "support_website_url": null, "website_url": "https://www.educationandlearning.nl/projects/virtual-reality-for-vocational-education-training-vr4vet", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25944520828469186"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-
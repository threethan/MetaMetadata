wZKRmDSASGHBnsqrIABPM2kTAyqLAXj5lI0csk9A6EfYSZS1lPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTS8mDOdGFe3gN8POobn3GB2_8ElF0XoEgPEHv8kBgFQ&oe=6AE75CDA"}, {"file_name": "screen-04.png", "id": "1102960225242797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_1102960228576130_3476505537820444180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ7qDUQ5hrUQ7kNvwHMioVT&_nc_oc=AdqBdfgM8eO9MqpM2myeL5hBdPce3rjZThDPbHLIcaeh9i3_f3OOSLPu2ROT7tNUho8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4uTeaXSNAal_zqSsemKfGKFxcrPrbxq0wAkfK9UaXwg&oe=6AE75844"}, {"file_name": "screen-01.png", "id": "3727214050917114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304764_3727214054250447_5465507135370727558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ocJClKWH-IQ7kNvwEDnerr&_nc_oc=AdrX1YRdEdwGSHbgOiOdcoWHPlZjO7bKQRvvsVpHnMtovlcnOwD41DiBfsrUjFq-oSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhDQu282kUmNuEWsc7ajsY7g45xzaKxspIL6SDVCm-CQ&oe=6AE7609B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4VET Cloud Engineering", "keywords": ["vr4vet", "career", "cloud"], "long_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets.\n\nThe application can be used as a supplementary material for the end users integrated into the career guidance and vocational education practice. When in the application, the user takes the role of a trainee at a clould engineering center. The user is introduced to the profession and can engage in typical workplace tasks.\n\nThe app features:\n- Setting up tickets in a cloud engineering center\n- Working through different tickets in exchanging and replacing hardware components in a cloud engineering center\n- Completing different introduction tours to different hardware components and how to replace them\n", "short_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr4vet.eu/cloud-engineering/", "developer_terms_of_service_url": null, "publisher_name": "Norwegian University of Science and Technology", "support_website_url": null, "website_url": "https://vr4vet.eu/cloud-engineering/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26988742780713647"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311611_851163407282883_264403321586698744_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmRXfWJO5ewQ7kNvwFIRBPr&_nc_oc=Adp74khLfFsHEw264TC0BlkWW_oeDvKD1JOqkUCZz4l5Fr_4_Y16CZS0pUJBml999P0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR2RUvSI0uUr-mNBZxpoDlaNXxTWZuRWEVBa0godTmGw&oe=6AE7628C"}, "is_conce
3", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491822817_25229685893309146_9060463009246778571_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKNVX0Bb8KkQ7kNvwECSTha&_nc_oc=AdoJB9SSq9DTM--Z0wbVhl40KRa0oB3FhNYEMskBrbss26RECX0f5njthytCq0PI09Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1Pf3REcLMttDMjShjOzBigxDz__7iAb39H17RTfSDtA&oe=6B08525A"}, {"file_name": "screen-04.png", "id": "1102960225242797", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299808_1102960228576130_3476505537820444180_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmPqCwDDb1AQ7kNvwFE7Qm2&_nc_oc=AdpVZelnjkyQR_RPUbzhvdKQAWVIk7qK4yI-eMVFW1WQChjs_Oow4IHmdph0q-h_D50&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw5iUvfwtV-ZLc6M_5Dqpnoy8ehArxBhUqHsHTPk7sHg&oe=6B084DC4"}, {"file_name": "screen-01.png", "id": "3727214050917114", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304764_3727214054250447_5465507135370727558_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksrmyH3cK_UQ7kNvwGKK19m&_nc_oc=Adon60-nL57X6qIdb___JnTRnyl5da1GSoU-IVtIKkxVX4o8A0gF78L939ezG-tJ1SU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiwRI5yjLjl3Tf85BuQyERYM8EzLz37M3Ty__tIuEJrA&oe=6B08561B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4VET Cloud Engineering", "keywords": ["vr4vet", "career", "cloud"], "long_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets.\n\nThe application can be used as a supplementary material for the end users integrated into the career guidance and vocational education practice. When in the application, the user takes the role of a trainee at a clould engineering center. The user is introduced to the profession and can engage in typical workplace tasks.\n\nThe app features:\n- Setting up tickets in a cloud engineering center\n- Working through different tickets in exchanging and replacing hardware components in a cloud engineering center\n- Completing different introduction tours to different hardware components and how to replace them\n", "short_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr4vet.eu/cloud-engineering/", "developer_terms_of_service_url": null, "publisher_name": "Norwegian University of Science and Technology", "support_website_url": null, "website_url": "https://vr4vet.eu/cloud-engineering/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26988742780713647"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499311611_851163407282883_264403321586698744_n.png?stp=dst-png_s
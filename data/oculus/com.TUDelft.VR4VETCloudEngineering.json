30f&oh=00_AQQjZ59ZUk02HmrCqdDQuo6KrhhtiQxnSGrbx2FUsKMpPg&oe=6B0D99B3"}, {"file_name": "screen-02.png", "id": "25229685889975813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822817_25229685893309146_9060463009246778571_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfSR-PUXHyEQ7kNvwEiTFy9&_nc_oc=AdrmQVovmDBHDQrj3-qde2ATsX18p3gURHIzLW_KhL4BLSVIy8AjIJkN230MfEttJ-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8khJS4JcRZs7L-7SQ3f9T7KgFniK19LSolxp2bNlhIQ&oe=6B0DD09A"}, {"file_name": "screen-04.png", "id": "1102960225242797", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299808_1102960228576130_3476505537820444180_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGaf-87ac78Q7kNvwHtJz-H&_nc_oc=Adogr-g0Q04fj4nooC5pM9FCwUNt_EiGsgmReY8WBj_J093YuMZLz1kob327AlpGrPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuVR-dJWncJ88VbzQ53drS1rPM7rMOpf13gFdtpNdrlA&oe=6B0DCC04"}, {"file_name": "screen-01.png", "id": "3727214050917114", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304764_3727214054250447_5465507135370727558_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3cOzZEKUsIQ7kNvwGOuli8&_nc_oc=AdpT_jV14HNLO7mYkI04a-1xapC-VP1mMIx_ttI3CrZ_DF_mmytNFOuBHOyGQ3k7u74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSofO6CuiixTtyVHvepIQVyiPwzcH1oxQ22cWysTbLsaw&oe=6B0D9C1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4VET Cloud Engineering", "keywords": ["vr4vet", "career", "cloud"], "long_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets.\n\nThe application can be used as a supplementary material for the end users integrated into the career guidance and vocational education practice. When in the application, the user takes the role of a trainee at a clould engineering center. The user is introduced to the profession and can engage in typical workplace tasks.\n\nThe app features:\n- Setting up tickets in a cloud engineering center\n- Working through different tickets in exchanging and replacing hardware components in a cloud engineering center\n- Completing different introduction tours to different hardware components and how to replace them\n", "short_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr4vet.eu/cloud-engineering/", "developer_terms_of_service_url": null, "publisher_name": "Norwegian University of Science and Technology", "support_website_url": null, "website_url": "https://vr4vet.eu/cloud-engineering/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26988742780713647"}, "review_messages": []}]}, "cover_square_image":
-NZPLSmCgqxIH5FBIF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQsF23Cl7inO4crD72bTskD_-9J8HCdNA4ShN1LCrpVQ&oe=69AD5F9A"}, {"file_name": "screen-04.png", "id": "1102960225242797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299808_1102960228576130_3476505537820444180_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QiZjJ2Wd-MQ7kNvwEfv2qw&_nc_oc=AdmyHaOUd2HdOVrOAKTp-SOouVSFLZq_boePgWt6W-iRKFnaSEdqS-imtaZm1I8K8uI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxguMp2jMa0R94tBog7GZXnfZ0Z_Sj5W5q3elbxMOol-w&oe=69AD5B04"}, {"file_name": "screen-01.png", "id": "3727214050917114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304764_3727214054250447_5465507135370727558_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bdi_ayDESMQ7kNvwGqZKoo&_nc_oc=AdktXnC4Maj8lLQkZe3pUIAzZN5x9RWTlmig1esjcZUJsSrxwauSVR08i8-IdihKMoo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxld5ZYqyd2VwSKBAk27tSQGYpm8OV97eTnEQNtHILlRA&oe=69AD635B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4VET Cloud Engineering", "keywords": ["vr4vet", "career", "cloud"], "long_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets.\n\nThe application can be used as a supplementary material for the end users integrated into the career guidance and vocational education practice. When in the application, the user takes the role of a trainee at a clould engineering center. The user is introduced to the profession and can engage in typical workplace tasks.\n\nThe app features:\n- Setting up tickets in a cloud engineering center\n- Working through different tickets in exchanging and replacing hardware components in a cloud engineering center\n- Completing different introduction tours to different hardware components and how to replace them\n", "short_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr4vet.eu/cloud-engineering/", "developer_terms_of_service_url": null, "publisher_name": "Norwegian University of Science and Technology", "support_website_url": null, "website_url": "https://vr4vet.eu/cloud-engineering/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26988742780713647"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499311611_851163407282883_264403321586698744_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQQpg-19NG4Q7kNvwFG3RnU&_nc_oc=AdmnF6rqJ5jrh4M_zfX4pBzRIvK4akZhmfhuCTuFj6k7LR0ox_nRh6yDgCc55fDT7d8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJIi3DUz5biNg3gqtS_QMDOQX9jDP_evbwOtTN8MsCkg&oe=69AD654C"}, "is_concept": false, "is_test": false, "is_trial_offer_va
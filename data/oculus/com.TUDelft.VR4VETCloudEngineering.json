30f&oh=00_AQWoEjBBJi2ki7nHgx6OMXW23_VIFPlekVukk8sowwvaMA&oe=6B103CB3"}, {"file_name": "screen-02.png", "id": "25229685889975813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_25229685893309146_9060463009246778571_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC7onTpQohIQ7kNvwEHP_d4&_nc_oc=AdrFr8RH9ZPj1NEMt_i_xbrkd5c_agDYAbb6dZL33WBl0y_8eFCCXZpwHbKFoccCLgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1savYh2wrvNrH9Z2FWi_EmVx9cYnqllkigN-2TQOPKg&oe=6B103B5A"}, {"file_name": "screen-04.png", "id": "1102960225242797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499299808_1102960228576130_3476505537820444180_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbK4JkWD7vMQ7kNvwG_na0D&_nc_oc=Ado8reULl93RYcjZcph88uxbdIogavHDVScYlmT6fzDtOy335XOsK0wmz4g1-FyaGe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXc3yjI-gSAQI14sY9GGczwhL18xFopQw7gXIF0srNp7w&oe=6B1036C4"}, {"file_name": "screen-01.png", "id": "3727214050917114", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304764_3727214054250447_5465507135370727558_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3cOzZEKUsIQ7kNvwFh-qGE&_nc_oc=Ado7441GzJcrSgNi3_eH5lcMNQl6jJhnUhJH8SlZOlKKHQ1Tmc_mYxWXreki2l39T3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgYxkva3UfjxAiXiiCPePDIUrClw3LU0O6yoa12qL7Nw&oe=6B103F1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4VET Cloud Engineering", "keywords": ["vr4vet", "career", "cloud"], "long_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets.\n\nThe application can be used as a supplementary material for the end users integrated into the career guidance and vocational education practice. When in the application, the user takes the role of a trainee at a clould engineering center. The user is introduced to the profession and can engage in typical workplace tasks.\n\nThe app features:\n- Setting up tickets in a cloud engineering center\n- Working through different tickets in exchanging and replacing hardware components in a cloud engineering center\n- Completing different introduction tours to different hardware components and how to replace them\n", "short_description": "The VR4VET Cloud Engineering VR app simulates a cloud engineering workplace with different tasks to be performed in cloud engineering centre. The users can experience situations representing typical workplaces in a data and cloud engineering center, such as setting up tickets, selecting and replacing hardware components in different server cabinets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr4vet.eu/cloud-engineering/", "developer_terms_of_service_url": null, "publisher_name": "Norwegian University of Science and Technology", "support_website_url": null, "website_url": "https://vr4vet.eu/cloud-engineering/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26988742780713647"}, "review_messages": []}]}, "cover_square_image":
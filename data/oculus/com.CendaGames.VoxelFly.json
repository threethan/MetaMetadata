dn.com/v/t64.5771-25/38982457_553270455117852_8839861251510108160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdurlosH-vAQ7kNvwEVanMt&_nc_oc=AdqO1QMqKG1Dnlp8q6OqdvSFFnsZl2FjmXxTj4YtTQLdjPs5x2Q_DuY5bjUp_fguZrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFcRXgx-U7PdUYzEiUxJP2wIxy6p-NYWuw3lT2wRtXEg&oe=6A5235C1"}, {"file_name": "migrated_image.png", "id": "218588529517542", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974561_191450348413557_7027399530932862976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlMRdczTTWEQ7kNvwHM5OAj&_nc_oc=AdqcdlkJAGf6eOKUCdjNoQmLr_eipW2jUJEnpzQjayxrMMDKs_8yaWJp19OT71YXoTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXekGgFInhBgp2Tjw2-rZRCAtKUkT0CVjuqtdUG9EIYg&oe=6A525B4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voxel Fly", "keywords": ["fly", "fight", "lowpoly", "speed", "enemy"], "long_description": "\"It\u2019s fairly intense which makes it a great experience for VR\" - AndroidAuthority\n\nPlay missions to unlock new machines. Beat the record in this impossible, endless game. Join to the events and become the best in the leaderboards! Avoid of the enemies or simply destroy them. You can choose from many modes:\n\nMODES\nExplorer - Slow speed with many enemies.\nMadness - Mad race with fast speed and less enemies.\nDestroyer - Crash them all! Your enemies has no chance.\nAttacker - Destroy enemies and objects by fire!\nCannoneer - Just fire!\nHorizon - Super speed with left/right turn\nDefender - They shall not pass :)\n\nFEATURES\n- 70 missions (still growing)\n- 30+ machines\n- 2 events\n- You get several games in the one\n- Design your own levels with Customize option\n- Set difficulty for all play modes\n- 72Hz for stable image\n- Set resolution for optimal performance\n\nFollow @CendaGames to get news!\nwww.discord.cenda.cz", "short_description": "Fly, fight and survive with your voxel machine."}]}, "developer_name": "\u010cen\
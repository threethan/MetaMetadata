dn.com/v/t64.5771-25/38982457_553270455117852_8839861251510108160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWZEv5Dwsx0Q7kNvwHZQNHh&_nc_oc=AdoJ8eJjvWv2pQTRVuKLHurUYR96xmexCgir3oujOVi-Y0ufgcPumCyoKIY6eJuGGCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2r_6sJIqRbTdmkhXJ9SWLu8NADK-RjlGOM3IjBfKqIw&oe=6ACFAC81"}, {"file_name": "migrated_image.png", "id": "218588529517542", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974561_191450348413557_7027399530932862976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djgQ3B7lpZIQ7kNvwG_hEA9&_nc_oc=AdoeQbID5u2W7zNYu_ktClHP27CAcm4c76x2MFjUB5VmOYcD5vD1ItwNd4HXkuyx98Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxqw86cbBfcXlBsCFlh78EMgEMd21_CBS6XXw7Xp8i8g&oe=6ACF99CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voxel Fly", "keywords": ["fly", "fight", "lowpoly", "speed", "enemy"], "long_description": "\"It\u2019s fairly intense which makes it a great experience for VR\" - AndroidAuthority\n\nPlay missions to unlock new machines. Beat the record in this impossible, endless game. Join to the events and become the best in the leaderboards! Avoid of the enemies or simply destroy them. You can choose from many modes:\n\nMODES\nExplorer - Slow speed with many enemies.\nMadness - Mad race with fast speed and less enemies.\nDestroyer - Crash them all! Your enemies has no chance.\nAttacker - Destroy enemies and objects by fire!\nCannoneer - Just fire!\nHorizon - Super speed with left/right turn\nDefender - They shall not pass :)\n\nFEATURES\n- 70 missions (still growing)\n- 30+ machines\n- 2 events\n- You get several games in the one\n- Design your own levels with Customize option\n- Set difficulty for all play modes\n- 72Hz for stable image\n- Set resolution for optimal performance\n\nFollow @CendaGames to get news!\nwww.discord.cenda.cz", "short_description": "Fly, fight and survive with your voxel machine."}]}, "developer_name": "\u010cen\
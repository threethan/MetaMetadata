Gt053ZmypsWkz3oUFTx5vInMN_NzUKjiGrukDw&oe=69B6A5E4"}, {"file_name": "Screen_5.png", "id": "1090538558308093", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86805183_1090538561641426_3617847857434066078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN31HKZ4Bu8Q7kNvwFHyl8q&_nc_oc=AdmNnR94zxlg33VNnSzZOHp3sg_b12TnNHjXQjY6qiuW7K1mhIp4q_AaflHwhteD8Ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbNPVhQVmkAOGEeg0VfVqMlDdmLCOx-nk-YkqRM485Dg&oe=69B69CEF"}, {"file_name": "Screen_6.png", "id": "827219538588552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75367591_827219545255218_8862787728097512893_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGSwVSXTJp8Q7kNvwFwdq78&_nc_oc=AdkYvwUtRvwFdtgGJBsKx6YvIP__vDB-9sYP_Nmf_N7HbZq3GKQmQJrDBCj7rekR-kI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy24TWW0il8LfuuAeoogg75p1qM6RsMEjnK_JTRHklb4w&oe=69B690CF"}, {"file_name": "dav01_1.4.1.png", "id": "655606329371405", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210393_655606332704738_8644400852019346204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VGNk-LpfYEQ7kNvwH68fu9&_nc_oc=Adm26JbhxCE7HeoJYkm8QYGwTE1RtXwN2MlzH_G2KHc_948W6bLwjqPyIHEwwt1_ef8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyK6M9JaLxOJwORI4C0exid9sHUbB5T_vCZ6Z6reCU0MQ&oe=69B6949F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner 2560x1440 upraveny text.png", "id": "666483034885126", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340708_666483038218459_7006348042051050796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPgf_OroiCYQ7kNvwFc1pA9&_nc_oc=AdmmsOt6Vny8c0PQjBHKAbyVghmnlauLeFzy8IJfYU4PqyPlXQQhUHDUj3L9yy-wcA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUbgATzKJSpb7gHUSop-hgX3oo6Jp2LdlxUqCpnSc7gA&oe=69B6B781"}, "display_name": "Voxel Fly ", "keywords": [], "long_description": "\"It\u2019s fairly intense which makes it a great experience for VR\" - AndroidAuthority\n\nPlay missions to unlock new machines. Beat the record in this impossible, endless game. Join to the events and become the best in the leaderboards! Avoid of the enemies or simply destroy them. You can choose from many modes:\n\nMODES\nExplorer - Slow speed with many enemies.\nMadness - Mad race with fast speed and less enemies.\nDestroyer - Crash them all! Your enemies has no chance.\nAttacker - Destroy enemies and objects by fire!\nCannoneer - Just fire!\nHorizon - Super speed with left/right turn\nDefender - They shall not pass :)\n\nFEATURES\n- 70 missions (still growing)\n- 30+ machines\n- 2 events\n- You get several games in the one\n- Design your own levels with Customize option\n- Set difficulty for all play modes\n- Set resolution for optimal performance\n\nFollow @CendaGames to get news!\nwww.discord.cenda.cz", "short_description": "Fly, fight and survive with your voxel machine."}]}, "developer_name": "\u010cen\u011bk \u0160trichel", "developer_privacy_policy_url": "https://cenda.cz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "\u010cen\u011bk \u0160trichel", "support_website_url": "http://cenda.cz/", "website_url": "http://cenda.cz/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "811460089828888"}}]}, "scheduled_offers": {"count":
dn.com/v/t64.5771-25/38982457_553270455117852_8839861251510108160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ABZk9bwsQEQ7kNvwH7jl9I&_nc_oc=Ado9lYFgtj2h8-UQQDjEO8iEd53ztC-AKBry5s06o4IWOjhWf3RVNxhCgXmpWJPGjyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeITFyQ64IMafhkZAIGPZSPsq0v2L7hsMgpvgJTvpLDw&oe=6AA2A141"}, {"file_name": "migrated_image.png", "id": "218588529517542", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974561_191450348413557_7027399530932862976_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9aOMtwgcb8Q7kNvwHF3kFG&_nc_oc=AdpmkKYNopMLpuPnmDrmbtcYAmUxEjq4SDlHwY338oaXJwHSOFkA7IEExT_s71oyDjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwjPsvc_iCtkUYfIykUjbduD2cLcENnB0cH7Lr9EeZIw&oe=6AA2C6CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voxel Fly", "keywords": ["fly", "fight", "lowpoly", "speed", "enemy"], "long_description": "\"It\u2019s fairly intense which makes it a great experience for VR\" - AndroidAuthority\n\nPlay missions to unlock new machines. Beat the record in this impossible, endless game. Join to the events and become the best in the leaderboards! Avoid of the enemies or simply destroy them. You can choose from many modes:\n\nMODES\nExplorer - Slow speed with many enemies.\nMadness - Mad race with fast speed and less enemies.\nDestroyer - Crash them all! Your enemies has no chance.\nAttacker - Destroy enemies and objects by fire!\nCannoneer - Just fire!\nHorizon - Super speed with left/right turn\nDefender - They shall not pass :)\n\nFEATURES\n- 70 missions (still growing)\n- 30+ machines\n- 2 events\n- You get several games in the one\n- Design your own levels with Customize option\n- Set difficulty for all play modes\n- 72Hz for stable image\n- Set resolution for optimal performance\n\nFollow @CendaGames to get news!\nwww.discord.cenda.cz", "short_description": "Fly, fight and survive with your voxel machine."}]}, "developer_name": "\u010cen\
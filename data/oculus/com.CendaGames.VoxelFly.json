culuscdn.com&_nc_ss=7f20f&oh=00_AQFhLU1kkO-BqrEvW9RL8-l_ev-KFCBMGq3A-fmuVPUKtA&oe=6A787264"}, {"file_name": "Screen_5.png", "id": "1090538558308093", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86805183_1090538561641426_3617847857434066078_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtrppGwH4OEQ7kNvwEtaGpH&_nc_oc=AdpKjJaQLryCSsXB4iGSIRQTUPMJFHT9Wlk6HgjuFpiiu0pPAGsSBtJlTuurlzmDdKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuWmzLAVkHgfRpN1U8GuRfJ3gFiaS3O2KooHaAj2mEyA&oe=6A78696F"}, {"file_name": "Screen_6.png", "id": "827219538588552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367591_827219545255218_8862787728097512893_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDIF5K6kA_sQ7kNvwECBK-C&_nc_oc=Ado2ZG1AtEpiO-gJ2Uhd1BtZXYsT94V-NWfWhNZx7Op2YcfmZjneUiDPIZJIH9x0ycE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMfnXIHZjcnpY2j3Dn73HmJxDl2AQsfuMoO5LyZfd_fg&oe=6A78958F"}, {"file_name": "dav01_1.4.1.png", "id": "655606329371405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210393_655606332704738_8644400852019346204_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ggaZJ1T-ZgQ7kNvwEa9qvw&_nc_oc=AdqyvBk_N0jNiPxcN1zc-8zA8awgCJSoYgD-uUMXOeRqj0rcSoHuQgEI8azft3mMUkM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErZaCXyuwozNgSr6_969obYv8_xT3sYEAgiOqDUlp2ZA&oe=6A78995F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Banner 2560x1440 upraveny text.png", "id": "666483034885126", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340708_666483038218459_7006348042051050796_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvuP1cnDjwEQ7kNvwEUF_55&_nc_oc=AdqFUCIps1kUsvjzZC4igBz6HJLG6oD_SKEi3IDBDlRkRmGnKPrlcX5XrZxRuZYRqQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlFJqjKgE2Ik0le34mjGVmJEsdxXGmLMXDJXal1SkNqg&oe=6A788401"}, "display_name": "Voxel Fly ", "keywords": [], "long_description": "\"It\u2019s fairly intense which makes it a great experience for VR\" - AndroidAuthority\n\nPlay missions to unlock new machines. Beat the record in this impossible, endless game. Join to the events and become the best in the leaderboards! Avoid of the enemies or simply destroy them. You can choose from many modes:\n\nMODES\nExplorer - Slow speed with many enemies.\nMadness - Mad race with fast speed and less enemies.\nDestroyer - Crash them all! Your enemies has no chance.\nAttacker - Destroy enemies and objects by fire!\nCannoneer - Just fire!\nHorizon - Super speed with left/right turn\nDefender - They shall not pass :)\n\nFEATURES\n- 70 missions (still growing)\n- 30+ machines\n- 2 events\n- You get several games in the one\n- Design your own levels with Customize option\n- Set difficulty for all play modes\n- Set resolution for optimal performance\n\nFollow @CendaGames to get news!\nwww.discord.cenda.cz", "short_description": "Fly, fight and survive with your voxel machine."}]}, "developer_name": "\u010cen\u011bk \u0160trichel", "developer_privacy_policy_url": "https://cenda.cz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "\u010cen\u011bk \u0160trichel", "support_website_url": "http://cenda.cz/", "website_url": "http://cenda.cz/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
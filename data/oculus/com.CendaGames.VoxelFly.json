UHat4jkZScSEm1tJ34IOyqdlY0Oh1rZs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkkvLg5gjUCWDgKFHrEsvOpAniXY4_aoulfOKMYO1Mgw&oe=6AFB4042"}, {"file_name": "migrated_image.png", "id": "582531832343037", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982457_553270455117852_8839861251510108160_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azxgqbc8CzsQ7kNvwEcVilC&_nc_oc=AdqwydqXwbEZEYx9NOoNGJFW_UQZnu70myi6KGTqWd7fBOR0Qygv91D0gWDoThuEOjk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7WFFRJjpQPcA4-RzRE6HXkqpfebhIpEznIT3-AhRWrQ&oe=6AFB2E01"}, {"file_name": "migrated_image.png", "id": "218588529517542", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974561_191450348413557_7027399530932862976_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LntDoGr3EloQ7kNvwFJ-Ru5&_nc_oc=Adp_72Bci6ymKxoFptMyqroB1SvuxIORl7PhvI3LLmKPnQdVVsGt4HWidzYlYZCm6XE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmC7E10z5N49ComeIV9O8WG16eBf44DE2ife8mE6hVLw&oe=6AFB1B4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Voxel Fly", "keywords": ["fly", "fight", "lowpoly", "speed", "enemy"], "long_description": "\"It\u2019s fairly intense which makes it a great experience for VR\" - AndroidAuthority\n\nPlay missions to unlock new machines. Beat the record in this impossible, endless game. Join to the events and become the best in the leaderboards! Avoid of the enemies or simply destroy them. You can choose from many modes:\n\nMODES\nExplorer - Slow speed with many enemies.\nMadness - Mad race with fast speed and less enemies.\nDestroyer - Crash them all! Your enemies has no chance.\nAttacker - Destroy enemies and objects by fire!\nCannoneer - Just fire!\nHorizon - Super speed with left/right turn\nDefender - They shall not pass :)\n\nFEATURES\n- 70 missions (still growing)\n- 30+ machines\n- 2 events\n- You get several games in the one\n- Design your own levels with Customize option\n- Set difficulty for all play modes\n- 72Hz for stable image\n- Set resolution for optimal performance\n\nFollow @CendaGames to get news!\nwww.discord.cenda.cz", "short_description": "Fly, fight and survive with your voxel machine."}]}, "developer_name": "\u010cen\u011bk \u0160trichel", "developer_privacy_policy_url": "http://cenda.cz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "\u010cen\u011bk \u0160trichel", "support_website_url": "http://cenda.cz/games/", "website_url": "http://cenda.cz/voxelfly/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "pt", "es", "ru"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5161016940627257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974562_2229853484007439_5334505473628438528_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7qqn8eWqw4Q7kNvwE7sJeH&_nc_oc=Adr9LFGPDL4t_EbPLte1kwP8cMbCIj9vK_8MjxjOKZlLyoea_KPGBSRqs7gG9XwTdg4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx2jBnEi_5LhxJCYQWhrq5GH3M74dxSiGFkr5WX2BmpQ&oe=6AFB3D31"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Voxel Fly", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1542301200, "lastRevision": {"nodes": [{"id": "1777817789193848", "release_type": "SC
cdn.com&_nc_ss=7f20f&oh=00_AQQkd1kRk1AyZIqJmVxJpQVoz1crwwFkLN51UHfHh56DdA&oe=6B086BE4"}, {"file_name": "screenshot-5-correct-2560x1440.png", "id": "1377277194485735", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/613030050_1377277197819068_147628153315480144_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Ri3vKWGToQ7kNvwEoHRo_&_nc_oc=AdpwSxpIpqrqaeplGG1lhyTs2tl5OeNzVC9QH5v8WlsRcoIM6jLNU_jx_OdTd8Gwk-k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgHU_XvK4NdYfOneKvLwv_4ZgQ_LBh_ENl8T_XAv5BZA&oe=6B08589E"}, {"file_name": "screenshot-6-answer-2560x1440.png", "id": "3034309416901322", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596061819_3034309420234655_2094999026926174362_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GY8-9zsezT8Q7kNvwEzjZbW&_nc_oc=Adq2moVp2BPKmR75kIIbJ7XjzUk2C6r756qnOIORrr82sou1OO6gQVDdIBdsprmK5G0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLf1Hl7JeJbM99MVUDJ1mGIE3928gmUvPzWWr3iB_-ZQ&oe=6B085B6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1457406019790096", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/755802518_1457406023123429_1781548587315575700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSmMXaM7v64Q7kNvwHtcUSU&_nc_oc=Adqe3x5krI9sBzWiwZdLw6l5WVNTo5C77vkbf_zreb4yzYskyG_Kg9ZEa-dAA4S0fXY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLS7npP-Tnj55WDHlhMcO9-iMYF3VqyxCZ1ReYIqSkrw&oe=6B084047"}, "display_name": "Ingredient Dictionary The Party Game", "keywords": ["trivia", "family", "quiz", "ingredients"], "long_description": "Snack or shampoo? Gather the family and find out who really knows what's in their stuff.\n\nEach round shows the start of a real-style ingredient list (candy, cleaners, shampoo, dog treats, whipped cream and more) and your team guesses the product. Stuck? Reveal another ingredient, but every clue costs a point. Guess sooner, score more.\n\n- Pick a book from the Ingredient Dictionary series (It's Not Food, It's Not Beauty, It's Not Clean, It's Not for Kids, Your Home Is Not Safe) or mix them all\n- 1 to 4 teams, or play solo\n- After each answer, see what every ingredient really is\n- No account, no sign-up. Free.\n- Point and pinch, or use your controllers: trigger or A to select, B to go back, thumbstick to move\n\nBy Maeser.", "short_description": "Snack or shampoo? Guess the product from its ingredients. A free family party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://maeserbern-ai.github.io/party-game/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Maeser", "support_website_url": null, "website_url": "https://maeserbern-ai.github.io/party-game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1437175399470167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/779277465_1496426825652732_3546676521797687468_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwxfQle8V5kQ7kNvwEdAsSo&_nc_oc=AdpqdnMZ8nEmwI8dbDG_DmWf_N6bYD1LvoCozhynq_XW3ijQy3-vSTkjF8YIxMlM734&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOrBT8mcU16Hmi6opruw82
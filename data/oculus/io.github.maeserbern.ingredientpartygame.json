cdn.com&_nc_ss=7f20f&oh=00_AQT6l3jZxe7C1dOfxj0bKcH6TBfMI-hJ61kOArxbigQfKA&oe=6B01D464"}, {"file_name": "screenshot-5-correct-2560x1440.png", "id": "1377277194485735", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613030050_1377277197819068_147628153315480144_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joLH-aDYp_MQ7kNvwGPKXOt&_nc_oc=AdpYUlqQzk4crdaaZvHLZIgkiBqAXkpv_YO_LHQpI_wcMYfZ7nfKLho2Nj8BWak8Pwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7osI-_BUTPG_cWkC3nIxR_CbEQCw0ry3x_J0uDoX_Gw&oe=6B01C11E"}, {"file_name": "screenshot-6-answer-2560x1440.png", "id": "3034309416901322", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_3034309420234655_2094999026926174362_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71B5TUj7O9MQ7kNvwEhHKI8&_nc_oc=Adr_ApjYEhh5Y8rpiTZpYJCGwry3uC5gv1Aw7BD24hndGQXHZs34kwI-Y4LL8k696vg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNZaAKhsrZSJidXY8cX3-LVMe4oHGPn6UztwwQDfWiOA&oe=6B01C3EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1457406019790096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/755802518_1457406023123429_1781548587315575700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-v2DQKs-B0Q7kNvwGqcj_9&_nc_oc=AdqlZ1YJm9kzf5swTqaEmlmV3qoSMeRp31nO15sV2fSmcSO1I49R_oyQo89UgAN7M3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReF7iw97zlxs1Msbe--eRyAR1skAOTcpigqZwVWFFHjA&oe=6B01E107"}, "display_name": "Ingredient Dictionary The Party Game", "keywords": ["trivia", "family", "quiz", "ingredients"], "long_description": "Snack or shampoo? Gather the family and find out who really knows what's in their stuff.\n\nEach round shows the start of a real-style ingredient list (candy, cleaners, shampoo, dog treats, whipped cream and more) and your team guesses the product. Stuck? Reveal another ingredient, but every clue costs a point. Guess sooner, score more.\n\n- Pick a book from the Ingredient Dictionary series (It's Not Food, It's Not Beauty, It's Not Clean, It's Not for Kids, Your Home Is Not Safe) or mix them all\n- 1 to 4 teams, or play solo\n- After each answer, see what every ingredient really is\n- No account, no sign-up. Free.\n- Point and pinch, or use your controllers: trigger or A to select, B to go back, thumbstick to move\n\nBy Maeser.", "short_description": "Snack or shampoo? Guess the product from its ingredients. A free family party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://maeserbern-ai.github.io/party-game/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Maeser", "support_website_url": null, "website_url": "https://maeserbern-ai.github.io/party-game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1437175399470167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/779277465_1496426825652732_3546676521797687468_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSL4hUNJVeQQ7kNvwGc6pVZ&_nc_oc=AdoF95hl6HwQAMR1sSFItU5pRHOEMwN86oUTBO9TJeLE9xpKOum9exyIKYBiPRhZjfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbWDLAYpMkNm_LDQLgeVF8
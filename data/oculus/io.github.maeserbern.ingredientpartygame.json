cdn.com&_nc_ss=7f30f&oh=00_AQTGaQv7F2OHz4C3_xpMPrjc2vvaH8F_D0yMPhzC0iYMXQ&oe=6B0C6064"}, {"file_name": "screenshot-5-correct-2560x1440.png", "id": "1377277194485735", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613030050_1377277197819068_147628153315480144_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDECWFxE3OgQ7kNvwEFyJ8B&_nc_oc=AdpHRCam9oeLf_fna6VhwJlmN1JhHoppZZMTLmu6pz8c_EoU-sMJ4FLJ3J6rwUWXcPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0eEMr1jWtFrFK1z3hTY5M7QHn1ffCfs66YsSJjrMqHQ&oe=6B0C4D1E"}, {"file_name": "screenshot-6-answer-2560x1440.png", "id": "3034309416901322", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_3034309420234655_2094999026926174362_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V4u2FGPvZ0Q7kNvwFdB52M&_nc_oc=AdpJVv3wFqdAX2p3zenREyPIIVqRwWqUyb8M_b27_FPg_Eu4hAeg-AckdvyPGLs0-sE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTneRXwR1O3vXEUflL99RjZ1L8O6CdXO4Z1gYR4egcrzA&oe=6B0C4FEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1457406019790096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/755802518_1457406023123429_1781548587315575700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cznJZijdAfIQ7kNvwE4L-PE&_nc_oc=Adrs7tMk-D3n5T0m-4mJ2Fqn0lOLJ2-S58HnfnfAKVC5fJYchNssP9I_pgC05y05qGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUnVhmLHrkeSdxho07azCIB4yyGmpt3Fx-nMQ9A4CJeg&oe=6B0C6D07"}, "display_name": "Ingredient Dictionary The Party Game", "keywords": ["trivia", "family", "quiz", "ingredients"], "long_description": "Snack or shampoo? Gather the family and find out who really knows what's in their stuff.\n\nEach round shows the start of a real-style ingredient list (candy, cleaners, shampoo, dog treats, whipped cream and more) and your team guesses the product. Stuck? Reveal another ingredient, but every clue costs a point. Guess sooner, score more.\n\n- Pick a book from the Ingredient Dictionary series (It's Not Food, It's Not Beauty, It's Not Clean, It's Not for Kids, Your Home Is Not Safe) or mix them all\n- 1 to 4 teams, or play solo\n- After each answer, see what every ingredient really is\n- No account, no sign-up. Free.\n- Point and pinch, or use your controllers: trigger or A to select, B to go back, thumbstick to move\n\nBy Maeser.", "short_description": "Snack or shampoo? Guess the product from its ingredients. A free family party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://maeserbern-ai.github.io/party-game/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Maeser", "support_website_url": null, "website_url": "https://maeserbern-ai.github.io/party-game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1437175399470167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/779277465_1496426825652732_3546676521797687468_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzPbteHptG4Q7kNvwHNQep5&_nc_oc=AdqSGLh-0ykhkzMyObd9UBM4-1f2AMTK6R8ELS-tejS_RtqA19mod9OgmCj4gNqbiQ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4VhEpcn2mGEUKse29AU3Z
cdn.com&_nc_ss=7f20f&oh=00_AQT8FU50DfoTN-ct0uUQiGgMaIz3UYLDBFaJGIwLJbHKIQ&oe=6B047764"}, {"file_name": "screenshot-5-correct-2560x1440.png", "id": "1377277194485735", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613030050_1377277197819068_147628153315480144_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joLH-aDYp_MQ7kNvwHk4nPl&_nc_oc=AdoaAFFJoppE9jj3xTDyVnLCTCrkIFPmZQrTbSzVMR-aJqtoEO3fTbhvFT5b7u-E4Tg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxko7l_XfZ-wWISfDBgsDkQJ20qTnMLMTxCd7XPT780A&oe=6B04641E"}, {"file_name": "screenshot-6-answer-2560x1440.png", "id": "3034309416901322", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_3034309420234655_2094999026926174362_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71B5TUj7O9MQ7kNvwE42gZH&_nc_oc=AdrYbfdTADE8znClQX4LuR_Y7Uv_Ydq4hnNBPgiZ5cSbiD6G2_woFfHB_8ABtkb2IPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgrFYZtblnMVosfRp1OKig1dBglPv5QN7UCzThMWqQ_w&oe=6B0466EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1457406019790096", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/755802518_1457406023123429_1781548587315575700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ab1J-zLsG0UQ7kNvwECsz45&_nc_oc=Ado3lWJllTNF8jOJZGyiLGm3-tb8oXIyr3fzANc8ppuNYQfSO4XTT9C4gUHwshJY0d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcPHE8uRaljY06C6Mh2ShwwmTnKSKNKB4jr5gM3SF6cw&oe=6B048407"}, "display_name": "Ingredient Dictionary The Party Game", "keywords": ["trivia", "family", "quiz", "ingredients"], "long_description": "Snack or shampoo? Gather the family and find out who really knows what's in their stuff.\n\nEach round shows the start of a real-style ingredient list (candy, cleaners, shampoo, dog treats, whipped cream and more) and your team guesses the product. Stuck? Reveal another ingredient, but every clue costs a point. Guess sooner, score more.\n\n- Pick a book from the Ingredient Dictionary series (It's Not Food, It's Not Beauty, It's Not Clean, It's Not for Kids, Your Home Is Not Safe) or mix them all\n- 1 to 4 teams, or play solo\n- After each answer, see what every ingredient really is\n- No account, no sign-up. Free.\n- Point and pinch, or use your controllers: trigger or A to select, B to go back, thumbstick to move\n\nBy Maeser.", "short_description": "Snack or shampoo? Guess the product from its ingredients. A free family party game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://maeserbern-ai.github.io/party-game/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Maeser", "support_website_url": null, "website_url": "https://maeserbern-ai.github.io/party-game/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1437175399470167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/779277465_1496426825652732_3546676521797687468_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPXL2v95HUYQ7kNvwFoF99z&_nc_oc=AdrPzXPiOak-7pELi3skrdAkZlUVOOi0G5emzRkLMzw_yr-AbopgctEoOylwL71wO5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHi7jZWv_DuMsAJIxew6k
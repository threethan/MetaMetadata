lding_2024-05-20_173901609.png", "id": "471613962063446", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035386_471613965396779_2396109862073592196_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9Wq8odaMj4Q7kNvwEzG8VS&_nc_oc=AdqzcPdioGzrTK7UPNaPHWebqIS9-oXhiHhI6Wgz78eK0F5R41J1lz6KcXC3yunMZ0k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9O8hzm7-b2n4alYC2duSLXX3tcqUV-ikPtx9MSdJoJg&oe=6A550355"}, "display_name": "Project Wack", "keywords": [], "long_description": "Project Wack is an exhilarating, social VR game that uses innovative gorilla locomotion for a truly immersive experience. \ud83e\udd8d\ud83c\udf1f Swing, climb, and leap through vibrant environments as you connect and compete with friends in a dynamic, engaging world. \ud83c\udf34\ud83c\udfae Dive into lush jungles, scale towering trees, and navigate treacherous terrains with intuitive movement mechanics that make you feel like a real gorilla. \ud83c\udf3f\ud83c\udf1f Form alliances, challenge rivals, and explore a variety of game modes that promise endless fun and excitement. Get ready to go bananas with Project Wack! \ud83c\udf4c\ud83c\udf89", "short_description": "Project Wack is an exhilarating, social VR game that uses innovative gorilla locomotion for a truly immersive experience. Swing, climb, and leap through vibrant environments as you connect and compete with friends in a dynamic, engaging world. Get ready to go bananas!\n\n\n\n\n\n\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/projectwack/privacy-policy-fixed", "developer_terms_of_service_url": null, "publisher_name": "Merlijn3245", "support_website_url": null, "website_url": "https://sites.google.com/view/projectwack/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "g
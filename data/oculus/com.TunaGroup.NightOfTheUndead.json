4.png", "id": "824697307188152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_824697310521485_7847967805844412040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6JKdHO5tEgQ7kNvwFMAk4Z&_nc_oc=Adru456boXdKC9-dOH5xDR670MNQCLDV0OUPQ9lRPv6-f75lkq4XRmx6ySjBmdR7zug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lHPcl8PhLqhNlXtMymWRlqS2BdCN-jatGmVnMU7hLYQ&oe=69DF8450"}, {"file_name": "sc-5.png", "id": "1365390888450517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620504_1365390891783850_8759816231350573464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEGCUfP2L1gQ7kNvwHoHHK7&_nc_oc=AdqxjFWMZ1aNOU-uq7mR-RPwALlBxzGbi44_p15OUPjIhQrk3MmVC4UFMUEag8B6eIw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fwdSdg_WlQJY_ci23GBUMzrm7r8Z5wH-vBvKpd_KAKA&oe=69DF7866"}, {"file_name": "sc-6.png", "id": "1576569417012226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622211_1576569420345559_5131085043815473849_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSs9pAhEbqIQ7kNvwHO4ayO&_nc_oc=AdqYLa8znBcWaBDY_18x4GnUQvPiAf9oiVyZG8X-jPUYJpcjWSqZ6pFINJuaOOu90R8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33JUPvBsE77_M78ftbMQLZDjoOtuBHh0CIjylteSO2tw&oe=69DFA232"}, {"file_name": "sc- 7.png", "id": "2155391361660161", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619096_2155391364993494_5167594305368969164_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zU6LGzdRX8Q7kNvwHAQfIz&_nc_oc=Adr4O7R0NfhkkI4K-ZCn1u_bKMBIwXcPR9_twAeNZ3sEp6g0YLZEuam03ARUj4-7ukc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AGcSq7yYZMU_Z6aFEDaLFkIjL_Q-ege2d-Rtifn9dLQ&oe=69DF967F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "1516162039654809", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618288_1516162042988142_5703557026953503658_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSHPZYWq5E4Q7kNvwHdVtgm&_nc_oc=Adpi1HFtsm0pmXwB36R6zpozR4NdBdjXZpZyhlnv7ITkyOo3iLcEMKAF0nWs4GRjRBk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RgNnk33f73e32seWdhLZSYyD3LPRo3Q4HCyXBnWW7dQ&oe=69DF8C88"}, "display_name": "Night of the Undead: VR Zombie Shooter", "keywords": ["zombiesurvival", "undeadattack", "horrornight", "vrgunshooter", "battleforlife"], "long_description": "**THE DEAD WALK AGAIN**\n \nThe night has fallen, and the world belongs to the undead. Grab your weapon, steady your aim, and prepare to face endless waves of flesh-hungry zombies that never stop coming. Every headshot counts\u2014precision brings power, and clean hits earn you valuable bonus points.\n\n**FIGHT TO SURVIVE**\n\nArmed with your trusted weapon, every second is a battle for survival. Zombies swarm from all directions \u2014 relentless, unpredictable, and faster than ever. Your reflexes and precision decide how long you\u2019ll last. Line up the perfect headshot to take them down instantly and earn bonus points for your skill. Miss, and the horde grows stronger.\n\n**COMPETE FOR GLORY**\n\nYour survival isn\u2019t the only thing on the line\u2014so is your pride. Track your performance, climb the local leaderboard, and prove you\u2019re the last shooter standing when the sun rises.\n\n**REAL IMMERSION. REAL TERROR**\n\nBuilt exclusively for VR, **Night of the Undead** immerses you in an intense first-person shooting experience where every movement matters. Feel the recoil, sense the tension, and witness the undead closing in from all sides. Each session is a unique test of endurance \u2014  no second chances, just pure survival instinct.\nWill you stand your ground when the shadows close in?\nCan you survive until dawn\u2026 or will you become one of them?\n\n**Night of the Undead** is now available in Early Access \u2014 jump in, test your aim, and prove you can survive the night!", "short_description": "When darkness falls, the undead rise. Armed with your rifle, survive relentless waves of zombies closing in from every direction. Precision matters - a clean headshot earns bonus points and keeps you alive a little longer. Stay sharp, hold your ground, and climb the local leaderboard. How long can you survive the Night of the Undead?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetunagroup.com/privacy-policy-night-of-the-undead-vr-zombie-shooter", "developer_terms_of_service_url": null, "publisher_name": "The Tuna Group", "support_website_url": null, "website_url": "https://www.thetunagroup.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26257608840508197"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1344677846950327"}, {"status": "PUBLISHED", "id": "1441388677995086"}]}, "baseline_offer": {"id": "1344677846950327"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765890660, "status": "PUBLISHED", "id": "1344677846950327"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26181475311454884", "version": "0.2.2"}, "id": "1351577233042538", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinar
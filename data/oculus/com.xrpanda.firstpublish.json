_P1_g9yuViG9XNq9nlDS-W0XGcGYyDYiiJMNr-X8A06NhuiiCIahLsXp4cVKfL0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS52wDUhEsMarxRk6xat1qsn0Tqjs6YvTnxzweyA7BkcQ&oe=6AFDD12A"}, {"file_name": "1 (2).png", "id": "27557757820499443", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302688_27557757830499442_2414324633196285_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVbPpjsR0REQ7kNvwGhk-aM&_nc_oc=AdpaQvh3xbJW-UC_HAoKOV9OjvbXxTIgfY0xRYHcrlbVNYGLiIeNKcZ5VIor86EGy2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfFlAZsfNYz6zKXtuwhP2JGhryi6HEiuiVH3WG98cpSw&oe=6AFDC908"}, {"file_name": "4 (1).png", "id": "2510939182682233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305050_2510939186015566_3130410882867468548_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6evK0Zv6NpwQ7kNvwG7twhH&_nc_oc=AdoogQHETEGfvDXgXHqv1WcQAW7qCXob_mNYF-ZyDhC0bv0RNx7y7mbUiPMvUvZVMIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJBJssE3rJCdWbZWcJu811xi56-TdisgR-nCETibjvDQ&oe=6AFDBCEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_1.png", "id": "2048142649116417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_2048142652449750_6520910283344331188_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Op9B7QrUQ4Q7kNvwEEeoqP&_nc_oc=AdrlasXwz8h9mhsZHoRpYkop1x5iRKZtd95WzMxBKQalWSheQv12bfBExF5s9pN43U8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjYF5HJI7qHDN6yjJA06PWfBw8m5SdWBpbgljefUl7Rg&oe=6AFDC14B"}, "display_name": "The Game With The Zombies", "keywords": ["zombieshooter", "vrshooter", "shooter", "arcade", "zombie"], "long_description": "# \"They called it The Game With The Zombies.\"\n\"Real creative bunch, ain't they\" - Earl\n\n# What You're Getting Into\nEndless waves of zombies. One stationary VR shooter. A global leaderboard separating survivors from statistics. Pick up and play in seconds, no tutorials, no cutscenes. Just you, your arsenal, and a virus eating away at your immunity.\n\n# Three Arenas. Zero Mercy.\n- **Power Plant:** Crumbling industrial courtyard. Nowhere to hide. Earl sees every miss.\n- **The Apocalyptic:** A combat pit ringed by shipping containers. Not a party.\n- **The Colosseum:** Ancient arena for blood sport. The crowd's gone. The zombies aren't.\n\n# Features\n- **Immunity System:** The virus is inside you. Immunity drops over time. Scavenge doses before you give up.\n- **Weapon Shop:** Buy the AK47, Machine Gun, or Flamethrower. Because a pistol is too polite.\n- **Boss Zombies:** Bigger, tougher, nastier. Earl expects you to handle it.\n- **Earl's Commentary:** He roasts your misses, kills, and embarrassing deaths.\n- **Stationary VR:** No room scale needed. Just reflexes. Dignity optional.\n- **Global Leaderboard:** Prove you outlasted strangers.\n\n# Also a Lethal Party Game\nThe perfect VR party game: fast rounds, boss fights, weapon upgrades, and a farmer who roasts your friends harder than you do. See who tops the leaderboard. Losers explain themselves to Earl.\n\n# Choose Your Arena\n{1447305747445775}\n", "short_description": "Endless zombie shooter. Survive, shoot, and top the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrpanda.ca/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRPANDA", "support_website_url": null, "website_url": "https://www.xrpanda.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
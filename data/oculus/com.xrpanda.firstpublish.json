7&_nc_sid=6e7a0a&_nc_ohc=mnou6eqFfPkQ7kNvwEFr_kY&_nc_oc=AdpopOB7hkKUtUhbT6KEZ_SC08JSind96z0sUP_AmRqjNjTXk1DUigi8TrqjWvFnn5c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EXw1LmfnKNW8hQ9Ky1wqlyD5IVQxLxwSW2Wr1-CpJrA&oe=6A2443E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_1.png", "id": "2048142649116417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308307_2048142652449750_6520910283344331188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixqvZ89-eq4Q7kNvwF4MoGJ&_nc_oc=AdqTjbs9F2OPAEZ83P0blXnY7q_E2qIlJFvBG_d3D9O2WdIAE1QSq_6XjSL9NxWnOO0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vf3evFS5nygmXviIMFfqoPEZhsEveFRGAAiwadhNR-w&oe=6A2439CB"}, "display_name": "The Game With The Zombies", "keywords": ["zombieshooter", "vrshooter", "shooter", "arcade", "zombie"], "long_description": "# \"They called it The Game With The Zombies.\"\n\n\"Real creative bunch, ain't they.\" - Earl\n\n# What You're Getting Into\n\nEndless waves of zombies. One stationary VR shooter. A global leaderboard separating the survivors from  the statistics. Pick up and play in seconds - no  tutorials, no cutscenes, just you and an undead army  with nowhere to be.\n\n# Three Arenas. Zero Mercy.\n\n1. **Power Plant** - A crumbling industrial courtyard. Wide open, nowhere to hide, and Earl has a clear view of every miss.\n\n2. **The Apocalyptic** - A makeshift combat pit ringed by shipping containers and burning torches. Someone put up bunting. It is not a party.\n\n3. **The Colosseum** - An ancient arena built for blood sport. The crowd is gone. The zombies are not. Earl is unmoved.\n\n# Features\n\n- *Endless zombie survival* - Waves keep coming. So does the dread.\n- *Global leaderboard* - Prove to the world you outlast strangers.\n- *Live sarcastic commentary* - Earl reacts to every miss, kill, and embarrassing death. In real time.\n- *Random power-up spawns* - Grab them before the zombies do.\n- *Comfortable stationary VR* - No roomscale needed. Just reflexes. Dignity optional.\n- *High replayability* - Every run ends. Pride demands you go again.\n\n# Also a Lethal Party Game\n\nThe Game With The Zombies is the perfect party game for your next VR night - fast rounds, instant competition, and a sarcastic farmer who will roast your friends even harder than you will. See who tops the leaderboard by end of night. Losers explain themselves to Earl.\n\n# How Long Can YOU Last?\n", "short_description": "Endless zombie shooter. Survive, shoot, and top the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrpanda.ca/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRPANDA", "support_website_url": null, "website_url": "https://www.xrpanda.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27590768520530770"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307931_2043950863224431_2952389257145207657_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORZH7NYGgMcQ7kNvwHSZCJb&_nc_oc=AdpVNw89oWOG1aHX_wcL7Wv_kUwdZ1lQHFqmj-grDKlJtDx4HQiGlRn7fxG-qPHHCpo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BT_9u21EqtM
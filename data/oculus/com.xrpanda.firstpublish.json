_nc_sid=6e7a0a&_nc_ohc=tezBuX6wlm0Q7kNvwEMP-33&_nc_oc=AdoGPy5UQ4aTC9NTigBTk21gp9wzbcbQb-yPW9yha5vrooFWOioTtisUpfvVRxj_Qc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDetJth2PkOuyL8uzBHSakvUX79xo7yeSxIygDSiEOA4w&oe=6A5F88EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_1.png", "id": "2048142649116417", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308307_2048142652449750_6520910283344331188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vanCkwGX7uwQ7kNvwEzAYKg&_nc_oc=Adppz5TFHvimUo4KbSZh8K7SFBFLs3pUKVJReUrkbls0lCEK_lMiNx4b_HAuXh69oNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCREgYHsBL3HFJj17XN-bczfRzBJ2GmK8oHL9Suvh9rqA&oe=6A5F550B"}, "display_name": "The Game With The Zombies", "keywords": ["zombieshooter", "vrshooter", "shooter", "arcade", "zombie"], "long_description": "# \"They called it The Game With The Zombies.\"\n\"Real creative bunch, ain't they\" - Earl\n\n# What You're Getting Into\nEndless waves of zombies. One stationary VR shooter. A global leaderboard separating survivors from statistics. Pick up and play in seconds, no tutorials, no cutscenes. Just you, your arsenal, and a virus eating away at your immunity.\n\n# Three Arenas. Zero Mercy.\n- **Power Plant:** Crumbling industrial courtyard. Nowhere to hide. Earl sees every miss.\n- **The Apocalyptic:** A combat pit ringed by shipping containers. Not a party.\n- **The Colosseum:** Ancient arena for blood sport. The crowd's gone. The zombies aren't.\n\n# Features\n- **Immunity System:** The virus is inside you. Immunity drops over time. Scavenge doses before you give up.\n- **Weapon Shop:** Buy the AK47, Machine Gun, or Flamethrower. Because a pistol is too polite.\n- **Boss Zombies:** Bigger, tougher, nastier. Earl expects you to handle it.\n- **Earl's Commentary:** He roasts your misses, kills, and embarrassing deaths.\n- **Stationary VR:** No room scale needed. Just reflexes. Dignity optional.\n- **Global Leaderboard:** Prove you outlasted strangers.\n\n# Also a Lethal Party Game\nThe perfect VR party game: fast rounds, boss fights, weapon upgrades, and a farmer who roasts your friends harder than you do. See who tops the leaderboard. Losers explain themselves to Earl.\n\n# How Long Can YOU Last?", "short_description": "Endless zombie shooter. Survive, shoot, and top the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrpanda.ca/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRPANDA", "support_website_url": null, "website_url": "https://www.xrpanda.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28220555570885392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307931_2043950863224431_2952389257145207657_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pLChvqCFrEQ7kNvwFWif8T&_nc_oc=Adr7aOcrISVCbpHA6bpLraZ6nHBKCC_H7wviwQdQDFSVv0WuMCBvBM50izVU9FYZmCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtDlBS-jWpsNBQfRq9EnHg9KO81nd9JgNG6m1UhAeL5A&oe=6A5F55AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Game With The Zombies", "platform": "AN
https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_2510939186015566_3130410882867468548_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NT2sl4CNHYQ7kNvwGAUQ1k&_nc_oc=Adp0Ov355vEnFomzOQTer6QekzJuR3fh4V1TblSlgM8XYfFB6sRGC-A8LutTPYz28A0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_7tbjUWXhUil40SwCdnnex0lxBsziEiZZ-dfBvSjrXw&oe=6A92BB2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_1.png", "id": "2048142649116417", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308307_2048142652449750_6520910283344331188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g62sWzgUdWoQ7kNvwGwx_LF&_nc_oc=Adr-43tm88KrdRrMNFqTNDsKFbywIpg6G5wfJBAK0fsqiEZT8X-BsDbABjZ9qD_SfMo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYh8cWUFJWHvUaw3dje5F7vMfal8NNGLd9HJmVVaG2xA&oe=6A92BF8B"}, "display_name": "The Game With The Zombies", "keywords": ["zombieshooter", "vrshooter", "shooter", "arcade", "zombie"], "long_description": "# \"They called it The Game With The Zombies.\"\n\"Real creative bunch, ain't they\" - Earl\n\n# What You're Getting Into\nEndless waves of zombies. One stationary VR shooter. A global leaderboard separating survivors from statistics. Pick up and play in seconds, no tutorials, no cutscenes. Just you, your arsenal, and a virus eating away at your immunity.\n\n# Three Arenas. Zero Mercy.\n- **Power Plant:** Crumbling industrial courtyard. Nowhere to hide. Earl sees every miss.\n- **The Apocalyptic:** A combat pit ringed by shipping containers. Not a party.\n- **The Colosseum:** Ancient arena for blood sport. The crowd's gone. The zombies aren't.\n\n# Features\n- **Immunity System:** The virus is inside you. Immunity drops over time. Scavenge doses before you give up.\n- **Weapon Shop:** Buy the AK47, Machine Gun, or Flamethrower. Because a pistol is too polite.\n- **Boss Zombies:** Bigger, tougher, nastier. Earl expects you to handle it.\n- **Earl's Commentary:** He roasts your misses, kills, and embarrassing deaths.\n- **Stationary VR:** No room scale needed. Just reflexes. Dignity optional.\n- **Global Leaderboard:** Prove you outlasted strangers.\n\n# Also a Lethal Party Game\nThe perfect VR party game: fast rounds, boss fights, weapon upgrades, and a farmer who roasts your friends harder than you do. See who tops the leaderboard. Losers explain themselves to Earl.\n\n# How Long Can YOU Last?", "short_description": "Endless zombie shooter. Survive, shoot, and top the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrpanda.ca/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRPANDA", "support_website_url": null, "website_url": "https://www.xrpanda.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28220555570885392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307931_2043950863224431_2952389257145207657_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvGuBhvPsnkQ7kNvwE7rJmG&_nc_oc=AdomSNM6tZGHOGv_KgSN-NqzkzK_JhHPrXp5_7d77BRLWbtGoRdlsHxR9jKPTVITpVI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwiHFgrzbvKYJrtijmdURGSRvm4yReL-5Pj94N7dALRQ&oe=6A92C02F"}, "is_c
07335", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499305050_1280077424340668_8123758033193860649_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg_Qvu7_LI8Q7kNvwHepeTB&_nc_oc=AdrwqfsmAzLUeE4d3MXF3qudZU1j3LjFgSmG9ls8CJ8JeY2_jeJqq72CYK2Lw8i_cNQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dhBCLwY6GaTYkcI1_ReF7JNhGB5CB-wgBK-GufpkXhw&oe=6A1ADE6B"}, {"file_name": "2 (1).png", "id": "941886795496262", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307413_941886798829595_3601345045847723252_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yMBA9N9fXkQ7kNvwEoBde7&_nc_oc=Adqb-mvFPw08FC3HnnT7d0zv0FBb9pNQEA_9UdHdJ9N_LxDwkUlsGsawsi0MvQqQAGg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CtEBb6JB2Qt8D1bCRQnC5d8JOcvrbRaLK1r2vDMfyeg&oe=6A1B01DA"}, {"file_name": "3 (1).png", "id": "839631225307583", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300897_839631228640916_1495194348674294913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rju2h4-N284Q7kNvwGOlvNa&_nc_oc=AdpFNacOzuen8ya9ZdHwtm4MRHoo5cD43uDOhXRaPM_xBuhDZxw-xXUTL50cDcwpUsM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T4kBbiJCprWtPdlbrn7qmNGT9FQZ7T-92xovbYMuBxQ&oe=6A1AE04C"}, {"file_name": "4 (1).png", "id": "2510939182682233", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499305050_2510939186015566_3130410882867468548_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWyVfV5mCLgQ7kNvwFWjGjL&_nc_oc=Adpwo_6EF2Fi8y-5WzKfD0cHpO2_KrJoaVVg_NQiSnDzUOCdxzGGmsj-25w2lrJNZ4E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B4eqn8-SMu4Y3UlKo3EKZ1rpbADv2oXz9ET9Z20l7sA&oe=6A1AFAEE"}, {"file_name": "5 (1).png", "id": "4279628335621327", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499311585_4279628338954660_429886969531335801_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7c2Bme9xOYQ7kNvwEVOriU&_nc_oc=Adpks8ez9aDQoBShioKlJkKFkqmOvLkMP5vrQfwBs9-Fs-Fe8dyLSsI40mbH5qVSchs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pL0bfoLPw-bRbUrfgaS7GftfOI3ahk3IlWFQITM2qcw&oe=6A1B0962"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_1.png", "id": "2048142649116417", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499308307_2048142652449750_6520910283344331188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gafuCSAi60kQ7kNvwECCRBq&_nc_oc=AdofwksmPt2nqGw8pHBtvoJGsPoI-kTA8skY-3IY6y3ef5dD6sCw0nP5euQ2CUijSco&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wfedAUkHqv1d_hpDmq8i2Soo1i5KPD-s8p0tZOo4Vnw&oe=6A1AFF4B"}, "display_name": "The Game With The Zombies", "keywords": ["zombieshooter", "vrshooter", "shooter", "arcade", "zombie"], "long_description": "# \"They called it The Game With The Zombies.\"\n\n\"Real creative bunch, ain't they.\" - Earl\n\n# What You're Getting Into\n\nEndless waves of zombies. One stationary VR shooter. A global leaderboard separating the survivors from  the statistics. Pick up and play in seconds - no  tutorials, no cutscenes, just you and an undead army  with nowhere to be.\n\n# Three Arenas. Zero Mercy.\n\n1. **Power Plant** - A crumbling industrial courtyard. Wide open, nowhere to hide, and Earl has a clear view of every miss.\n\n2. **The Apocalyptic** - A makeshift combat pit ringed by shipping containers and burning torches. Someone put up bunting. It is not a party.\n\n3. **The Colosseum** - An ancient arena built for blood sport. The crowd is gone. The zombies are not. Earl is unmoved.\n\n# Features\n\n- *Endless zombie survival* - Waves keep coming. So does the dread.\n- *Global leaderboard* - Prove to the world you outlast strangers.\n- *Live sarcastic commentary* - Earl reacts to every miss, kill, and embarrassing death. In real time.\n- *Random power-up spawns* - Grab them before the zombies do.\n- *Comfortable stationary VR* - No roomscale needed. Just reflexes. Dignity optional.\n- *High replayability* - Every run ends. Pride demands you go again.\n\n# Also a Lethal Party Game\n\nThe Game With The Zombies is the perfect party game for your next VR night - fast rounds, instant competition, and a sarcastic farmer who will roast your friends even harder than you will. See who tops the leaderboard by end of night. Losers explain themselves to Earl.\n\n# How Long Can YOU Last?\n", "short_description": "Endless zombie shooter. Survive, shoot, and top the leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrpanda.ca/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XRPANDA", "support_website_url": null, "website_url": "https://www.xrpanda.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27590768520530770"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307931_2043950863224431_2952389257145207657_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xy-yc39gs78Q7kNvwHaN5Bk&_nc_oc=Adrjkk7x-3J6P_c68hjqTdTZNUUmKHptV1YDEBPdzUSOgKaXj2dGqFrSY4nfYVjgNLA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-SMGgOpzn_ABAZo_NYmaMxcGk9Q8eDeEDRnXIy1mB-Q&oe=6A1AFFEF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display
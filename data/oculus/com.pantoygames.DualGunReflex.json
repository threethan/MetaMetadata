ybz3VbMucF1Lvu7RtQ0qOGDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bu9fUjHUE_ZmL8RNg2jXvXsH33wJg3kXLJPjdyjzo3g&oe=6A283793"}, {"file_name": "Screenshots5.png", "id": "1590151391997245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1590151395330578_8465112447318982991_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGG3Gib2ldwQ7kNvwEaAZMQ&_nc_oc=AdrCEgMTGAkJ3jDcQ_bZ5YVCZLVEqCD0p06BIWuCx6cdlWwRypJsDF3UNj_oqRKncvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S1ynHNac36O_eMpSdErBwl6qFtpV-xZ9UDGP8ZMlb3Q&oe=6A283A16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1253847523233897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_1253847526567230_8839713354927989509_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO8UWyGHy1AQ7kNvwFRcqTJ&_nc_oc=Ado8SwFzo-U8TRVhwf4d7kKTqzD8LApNkI5WFzOBi5OnkEekKFmG3Lmic1950b164Po&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NjkaABvmQm9s48TLY3XqhBbaFOpjDbpB6Vm5dbmMbXA&oe=6A280C2F"}, "display_name": "Dual Gun Reflex", "keywords": ["VRShooter", "MixedReality", "ReflexGame", "ColorMatching", "StationaryVR"], "long_description": "Experience Dualgun Reflex, a high-octane mixed-reality shooter designed exclusively for Meta Quest. In this stationary VR game, you\u2019ll dual-wield a red gun in your left hand and a blue gun in your right, facing waves of color-coded enemies that appear dynamically in your real environment. Your reflexes are your greatest weapon\u2014shoot the right color, dodge slow-moving projectiles, and survive each escalating wave of combat.\n\nEnemies come alive in your room through passthrough MR, appearing on floors, walls, or even floating from ceiling corners. Fire the wrong color, and you\u2019ll take damage; fail to dodge a projectile, and your health drops. Reloading requires tactical movement\u2014simply pull your gun outside the headset\u2019s view to restock ammo. Each stage challenges your speed, accuracy, and spatial awareness with 10 waves of intense, color-based combat.\n\nDesigned for comfort and accessibility, Dualgun Reflex works in standing or seated modes and requires no room-scale movement, making it ideal for small spaces. Neon sci-fi visuals, glowing geometric drones, and dynamic audio cues heighten immersion, while clear red and blue color cues keep gameplay readable and satisfying.\n\nMaster each stage, survive all waves, and push your reflexes to the limit in this fast-paced MR shooter that blends precision, physical dodging, and instant decision-making for a truly unique VR experience.", "short_description": "Step into Dualgun Reflex, a fast-paced mixed-reality VR shooter for Meta Quest. Dual-wield red and blue guns to instantly match enemy colors, dodge incoming projectiles, and survive 10 waves per stage. Enemies spawn dynamically in your real environment, creating a fully immersive color-based reflex challenge. Master speed, accuracy, and movement in this stationary yet intense MR combat experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pantoygames.com/privacy-policy-for-dualgun-reflex", "developer_terms_of_service_url": null, "publisher_name": "pantoygames", "support_website_url": null, "website_url": "https://pantoygames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_inter
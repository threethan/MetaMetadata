listic paddle and ball physics for true-to-life gameplay\n\ud83e\udd16 Smart AI opponents that adapt to your skill level\n\ud83e\udde0 Practice and improve your serve, volley, and timing\n\nDesigned for comfort, precision, and performance \u2014 Pickle Ball Star delivers an engaging VR experience whether you\u2019re new to pickleball or a seasoned player.\n\nStep onto the court, grab your paddle, and prove you\u2019re the ultimate Pickle Ball Star!", "short_description": "Step onto the virtual court in Pickle Ball Star, a fast-paced VR sports experience that brings the excitement of pickleball to life. Play intense matches, perfect your timing, and feel every hit with realistic physics and immersive environments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/PickleBall_Star_PrivacyPolicy/blob/main/Pickleball%20Star.txt", "developer_terms_of_service_url": null, "publisher_name": "Blackhole Infiverse LLP", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25067820496178389"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1583669129466876"}]}, "baseline_offer": {"id": "1583669129466876"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763537640, "status": "PUB
your skill level\n\ud83e\udde0 Practice and improve your serve, volley, and timing\n\nDesigned for comfort, precision, and performance \u2014 Pickle Ball Star delivers an engaging VR experience whether you\u2019re new to pickleball or a seasoned player.\n\nStep onto the court, grab your paddle, and prove you\u2019re the ultimate Pickle Ball Star!", "short_description": "Step onto the virtual court in Pickle Ball Star, a fast-paced VR sports experience that brings the excitement of pickleball to life. Play intense matches, perfect your timing, and feel every hit with realistic physics and immersive environments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/PickleBall_Star_PrivacyPolicy/blob/main/Pickleball%20Star.txt", "developer_terms_of_service_url": null, "publisher_name": "Blackhole Infiverse LLP", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25067820496178389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_2561292634249389_8999597869422896981_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1S2fbo9DK0Q7kNvwEVDp13&_nc_oc=AdoI6yrmynniILU7g3k25BV-VfocLOiEOlUaC_Pb25M0dypds8nHhqsIq_ooPghIg50&_nc_zt=3&_n
oPYkyVZd75kDgzXzJgTRVSDd8eYLHCBz2yg5qaYu_ZCgONibzU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpaIhEUeo6-ZxIZKngqFlS0rfWZjA7yH5mcNU4tT5bnA&oe=6A56482A"}, {"file_name": "ss3.png", "id": "797249459796833", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820887_797249463130166_6721916153820734715_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpbSpCNhMqkQ7kNvwFDoINQ&_nc_oc=AdpcW1RnjWjs2IBH7DTxf7YAtDx6hPnk9deNN_fpHh6p63fti62MdyA_BleYPwWnVVI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWIX1XHbsQhkmpao_dgbjVZvVgn4fPaVs56cvVZTNESA&oe=6A562A34"}, {"file_name": "ss7.png", "id": "1164838801805251", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820470_1164838805138584_2346512274934319254_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOzP_YhBzaUQ7kNvwFuDmZ1&_nc_oc=Adrusq6_l3Yz4wkwPoTc8vWoGzT8gEcCdHB1fgVaxs3gJjqN-8KPU9qiwu4TSEBAJDY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDLaiQYa_Vkal9w21TQlt55I9qAuWGlXZwXfUEbY_c8A&oe=6A56296E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickle Ball Star", "keywords": ["pickleball", "sports", "SportGame", "ball", "outdoor"], "long_description": "Pickle Ball Star brings the world\u2019s fastest-growing sport into virtual reality!\n\nExperience thrilling, realistic pickleball gameplay built in Unreal Engine 5 with dynamic physics, intuitive paddle control, and lifelike environments. Whether you\u2019re rallying casually or playing competitive matches, Pickle Ball Star captures the energy, strategy, and fun of real pickleball.\n\nKey Features:\n\ud83c\udfd3 Realistic paddle and ball physics for true-to-life gameplay\n\ud83e\udd16 Smart AI opponents that adapt to your skill level\n\ud83e\udde0 Practice and improve your serve, volley, and timing\n\nDesigned for comfort, precision, and performance \u2014 Pickle Ball Star delivers an engaging VR experience whether you\u2019re new to pickleball or a seasoned player.\n\nStep onto the court, grab your paddle, and prove you\u2019re the ultimate Pickle Ball Star!", "short_description": "Step onto the virtual court in Pickle Ball Star, a fast-paced VR sports experience that brings the excitement of pickleball to life. Play intense matches, perfect your timing, and feel every hit with realistic physics and immersive environments!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/PickleBall_Star_PrivacyPolicy/blob/main/Pickleball%20Star.txt", "developer_terms_of_service_url": null, "publisher_name": "Blackhole Infiverse LLP", "support_website_url": null, "website_url": "https://blackholeinfiverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25067820496178389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491821099_2561292634249389_8999597869422896981_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUcgSqwupVAQ7kNvwF2pPx3&_nc_oc=AdrgwItdxAyZzlntB6yexXHPZ-8icgpUJ9ulgB9dVWd-KuvP4_ANlcrsEFQ-RaAtSK0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRbJT8j4rCfP8AFUWE6zb-MCVaVYkcRE_T6lkbrW9qJQ&oe=6A562DF1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pickle Ball Star", "platform": "ANDROID_6DOF", 
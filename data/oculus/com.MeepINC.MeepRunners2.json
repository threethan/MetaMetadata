RCfw58YL-s6B3LaqePNDQ&oe=69B2C677"}, {"file_name": "New Project (79).png", "id": "1022626426745648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628909_1022626430078981_9047837515911312697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whFi_m5I83MQ7kNvwE47Sqp&_nc_oc=AdnZ3dXwDlATC3SFU3TOdGxni-SjwrXbNkQ67gI7Sk4YYza4Zr-bfr8PjA7F3zbCsQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfykFcyiiGtjkLrh-7Np55BXaOqe8VZ5MvgCqTuYCy5ivg&oe=69B2A72B"}, {"file_name": "New Project (80).png", "id": "9669361953167961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298212_9669361963167960_9092161211300841983_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilJCR6bZFMsQ7kNvwEP5ppA&_nc_oc=AdmKNuC9Y3Unv1pz4uaxaxuTdggOkA37cGwrihHl07zOlj6kWfQ6utgZ7zuKVjneUPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrWphr-t4sIUWf8yL1eeRcoDFUyjZ6-Y2bNuK_nVP3MQ&oe=69B2CCB8"}, {"file_name": "New Project (78).png", "id": "1251726626461259", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294601_1251726629794592_5894447011133923825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP8LxXt9HRgQ7kNvwF0OizA&_nc_oc=AdlR1hKPXjIc9F5WyDSXrg1Yh972guIdF4mpa83ElokdMExO9a9tGzvULngD_tmaZg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxgf1kZWV5qQbpW5EEyxnT4N1rCXVo59VIJXnx0kwX8jg&oe=69B2C925"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners v2", "keywords": [], "long_description": "Get ready to run, wall-bounce, and Meep your way through wild multiplayer chaos in Meep Runners v2\u2014a fast-paced, VR-powered Gorilla Tag fan game rebuilt from the ground up!\n\nAfter the unexpected loss of Meep Runners v1 due to a keystore deletion, we\u2019re back with a vengeance. Meep Runners v2 brings smoother movement, crazier maps, and an even stronger community of runners, taggers, and Meeps.\n\nIf you loved the freedom of Gorilla Tag\u2019s locomotion and the thrill of tagging or escaping in parkour-style arenas, you\u2019re going to feel right at home. Whether you're swinging through trees, bouncing off walls, or sprinting up cliffs, movement is your weapon\u2014and your playground.", "short_description": "Meep Runners is a goofy, fast-paced tag game where you run, jump, and fling yourself around with friends. It\u2019s all about chaotic movement, weird maps, and a lot of fun in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/meep-runners2/privacy-policy2", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners2", "website_url": "https://sites.google.com/view/meep-runners2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10091417687650964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294650_1513132926719782_4874421055509231802_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRU_lzE9SeMQ7kNvwGJ0Ibx&_nc_oc=Adm70YV2DigUtjHpA67Tw9TorYUW9jMyOi4Mi4i4kRWHqyPZQyM8AgGCNVlNnTVHj8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRDuOqSr033m9XX2knEqDcEuNJJtqXaTr2Pz2xKYQG0A&oe=69B2CE9F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meep Runners v2", "platform": "ANDR
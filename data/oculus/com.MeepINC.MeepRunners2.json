&oh=00_AQFgIISSQyL0WIfjIjUzBPLmzBAHrG3xj23E8VDsPUJY7Q&oe=6A974A77"}, {"file_name": "New Project (79).png", "id": "1022626426745648", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499628909_1022626430078981_9047837515911312697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ax7uza1OegQ7kNvwEnk7M8&_nc_oc=AdpbSlAPyA4sWWsiZdgfaQ6gsHx97ZDVLwipLoltQQubKVupKJQKUCIrcnkgGu4Xd70&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNzat14zTOUnL3jU2O8qCSXenYBM6uGAGbAc1sHMAQxw&oe=6A972B2B"}, {"file_name": "New Project (80).png", "id": "9669361953167961", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298212_9669361963167960_9092161211300841983_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-I5YhJCZboQ7kNvwG3U0dR&_nc_oc=Adol6ycS0JxDAG8Se-AvIHho6tYdO2vs6MMMC2dUY-_CFlIhGubI7GcjRGj6XOoJ_lc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbO9u_WsRBDDAIhb7qsMfsOwZbhT3qerggCXgIeE-1kg&oe=6A9750B8"}, {"file_name": "New Project (78).png", "id": "1251726626461259", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499294601_1251726629794592_5894447011133923825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lom8CPukiBkQ7kNvwG7AVRC&_nc_oc=Adq0Kr61KSAEpkpI9uhRq_-SNvED3JsX_JY8vicYht5MAAqp8FgznLyXAcX-F_yZCgk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6L09AyOI9rcrOVhQyqJuHeSuOj5e6mYX5UZ4Ggqq_nQ&oe=6A974D25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners v2", "keywords": [], "long_description": "Get ready to run, wall-bounce, and Meep your way through wild multiplayer chaos in Meep Runners v2\u2014a fast-paced, VR-powered Gorilla Tag fan game rebuilt from the ground up!\n\nAfter the unexpected loss of Meep Runners v1 due to a keystore deletion, we\u2019re back with a vengeance. Meep Runners v2 brings smoother movement, crazier maps, and an even stronger community of runners, taggers, and Meeps.\n\nIf you loved the freedom of Gorilla Tag\u2019s locomotion and the thrill of tagging or escaping in parkour-style arenas, you\u2019re going to feel right at home. Whether you're swinging through trees, bouncing off walls, or sprinting up cliffs, movement is your weapon\u2014and your playground.", "short_description": "Meep Runners is a goofy, fast-paced tag game where you run, jump, and fling yourself around with friends. It\u2019s all about chaotic movement, weird maps, and a lot of fun in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/meep-runners2/privacy-policy2", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners2", "website_url": "https://sites.google.com/view/meep-runners2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10091417687650964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499294650_1513132926719782_4874421055509231802_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-fKfpVoId8Q7kNvwGurWN7&_nc_oc=AdojTc0fZYwm-1jcY1r-G85OECVopL0eM-7ic5euX08uzD3RfjbaOgBHRcrwia_OF9M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMFWiRPA3BFAsqiBvM3VQY9t703_UzGr8qpWHS6c0BsA&oe=6A971A5F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
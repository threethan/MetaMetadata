&oh=00_AQAIfcrV7iy4JpuV9m8w464AfbAtvp4h_RkAYfRmziZiDw&oe=6A539D77"}, {"file_name": "New Project (79).png", "id": "1022626426745648", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499628909_1022626430078981_9047837515911312697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImuGwwnwgNgQ7kNvwF5XaWk&_nc_oc=Adr_q70QXmRSb6IImX82QZh8KojyQtuRwUD99aemumvTLrF-_qx33CeUItTUfBEiwWk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYIPj9FfguHdt7TsW3wacbS4jVphWZepDPZxO2_tzi4w&oe=6A537E2B"}, {"file_name": "New Project (80).png", "id": "9669361953167961", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298212_9669361963167960_9092161211300841983_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJLJSJ0e5vAQ7kNvwHDiV0t&_nc_oc=Adq109ewuElyI70jOGFA3ef6iaB3vOKYhuGV2l0D5V5g9qfT_rqzSwyxywCcgZYHCxQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBsyVAo0pKgIuZels2utXbbZuuCB42mQJB3MisuzOXzg&oe=6A53A3B8"}, {"file_name": "New Project (78).png", "id": "1251726626461259", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499294601_1251726629794592_5894447011133923825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wboy_jfSsN0Q7kNvwFxUA9G&_nc_oc=Ado-t1dyQXCUbVGP0KxlCZEm3flWKDqhf1DWlzwWnlPsKsXCRo3owP1WUKbANuk0sNI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNFkDay6YfS_TV4ayN6_G3sOOi9ucMRz4EkpuhRtGLpw&oe=6A53A025"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners v2", "keywords": [], "long_description": "Get ready to run, wall-bounce, and Meep your way through wild multiplayer chaos in Meep Runners v2\u2014a fast-paced, VR-powered Gorilla Tag fan game rebuilt from the ground up!\n\nAfter the unexpected loss of Meep Runners v1 due to a keystore deletion, we\u2019re back with a vengeance. Meep Runners v2 brings smoother movement, crazier maps, and an even stronger community of runners, taggers, and Meeps.\n\nIf you loved the freedom of Gorilla Tag\u2019s locomotion and the thrill of tagging or escaping in parkour-style arenas, you\u2019re going to feel right at home. Whether you're swinging through trees, bouncing off walls, or sprinting up cliffs, movement is your weapon\u2014and your playground.", "short_description": "Meep Runners is a goofy, fast-paced tag game where you run, jump, and fling yourself around with friends. It\u2019s all about chaotic movement, weird maps, and a lot of fun in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/meep-runners2/privacy-policy2", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners2", "website_url": "https://sites.google.com/view/meep-runners2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10091417687650964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499294650_1513132926719782_4874421055509231802_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nlmq-kUcygQ7kNvwEM-K9x&_nc_oc=Adpg98WGFOAMwYaWDIV3qRi_V6ivwC5AcvGPemaeutqLp0Q7F-Duvfbki_wH0T8Xyaw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-8D7rFLm0tT5Pp4NherGWrFNUcuX02C-G0KE0NiHJcA&oe=6A53A59F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
&oh=00_AfwZlnz8kjNc7XgDaF2_Ys6iiJpichEKEH4iB5rLw6LeMQ&oe=69CE75F7"}, {"file_name": "New Project (79).png", "id": "1022626426745648", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628909_1022626430078981_9047837515911312697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoBqNyGKRlYQ7kNvwEdQ5ID&_nc_oc=AdrA5AK6J9dOmJRFavb7vMnXd0dI7O_EeH6aYxnFnym2nU-mvv1DvpXgY-IQ-VUaygM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMfH7fsoCoMiPuUD7lR7POJbQ2uyjVmgYibFl9xviQwg&oe=69CE56AB"}, {"file_name": "New Project (80).png", "id": "9669361953167961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298212_9669361963167960_9092161211300841983_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmv0ToIa6zMQ7kNvwE76hgv&_nc_oc=AdqcS7PKC1G-wB5oGeT6IsZCNBIkcqcbHLiACv_GzjDhsGm21a1x21aO54WmwYwVhh8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT3I5ngfg_Ef2eeXylLEPIWUmsOqQU8QkHO2NU-5NqsQ&oe=69CE7C38"}, {"file_name": "New Project (78).png", "id": "1251726626461259", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294601_1251726629794592_5894447011133923825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eD0r6d5kiDEQ7kNvwFThiav&_nc_oc=Adpo3p2BE3n9G_E7MkbHbJLj0gb87NFjYug-y2CJSg3fkHKn7JiiNNtJeHRwEJjTBPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbrXI5j7gZnRbDF8UXuZU1SfPcnVzIbey7G44RkrvFOg&oe=69CE78A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners v2", "keywords": [], "long_description": "Get ready to run, wall-bounce, and Meep your way through wild multiplayer chaos in Meep Runners v2\u2014a fast-paced, VR-powered Gorilla Tag fan game rebuilt from the ground up!\n\nAfter the unexpected loss of Meep Runners v1 due to a keystore deletion, we\u2019re back with a vengeance. Meep Runners v2 brings smoother movement, crazier maps, and an even stronger community of runners, taggers, and Meeps.\n\nIf you loved the freedom of Gorilla Tag\u2019s locomotion and the thrill of tagging or escaping in parkour-style arenas, you\u2019re going to feel right at home. Whether you're swinging through trees, bouncing off walls, or sprinting up cliffs, movement is your weapon\u2014and your playground.", "short_description": "Meep Runners is a goofy, fast-paced tag game where you run, jump, and fling yourself around with friends. It\u2019s all about chaotic movement, weird maps, and a lot of fun in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/meep-runners2/privacy-policy2", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners2", "website_url": "https://sites.google.com/view/meep-runners2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10091417687650964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499294650_1513132926719782_4874421055509231802_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgGZv-N7NOgQ7kNvwEmVRx2&_nc_oc=AdrVBjOD2Ijq9O401zdetuPuL10-4EWCKa3jTkoZ1txaRwK3FNXbpnHFXjOMgYyuCi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_Vhdj5u5SwlyYtdavagK2Mk1XjQZ2VQ0Dxa4lsTUVrQ&oe=69CE7E1F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
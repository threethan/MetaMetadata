&oh=00_Af9TqhJh_Hh7h5VkAI_94FOlSOYbPlQjNqIx89-rYA3Bkw&oe=6A3E8577"}, {"file_name": "New Project (79).png", "id": "1022626426745648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628909_1022626430078981_9047837515911312697_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GV0mx4Bowy0Q7kNvwEkEm6P&_nc_oc=AdqV9twMOVD6E4-8f5jeUG7ZNvSS1bHb8iFmPcX9gcd-TAJzy5yGq1g83jQo83aacww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MdQRb04mLZTWrQgNBd9T86QfuAeAWla2cRtUcEuJJeA&oe=6A3E9E6B"}, {"file_name": "New Project (80).png", "id": "9669361953167961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298212_9669361963167960_9092161211300841983_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A0XBKasTAcQ7kNvwHHw2SE&_nc_oc=AdqLKjuULHJFs7SGgEB0lNX05pSIlu0a8pqtlYDVbkSUtaxy4u2CLwLSTdTM8AGhiWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ok__2xN09giX2S7bX7Ex2F5-s-asSF7VIN3mWrJhuSg&oe=6A3E8BB8"}, {"file_name": "New Project (78).png", "id": "1251726626461259", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294601_1251726629794592_5894447011133923825_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1eqN1xQ7LoQ7kNvwGJm9M0&_nc_oc=Adpd-EnnYZY-Te0dEHVD9Coit-ovfS8IcMtQ3dp-DytJBMdJYMYguQo8vhfXbOs9LRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bgWw1g0rOYAoQsKtukIkvp2ujt0hjGGVJDwKymgW4Ew&oe=6A3E8825"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meep Runners v2", "keywords": [], "long_description": "Get ready to run, wall-bounce, and Meep your way through wild multiplayer chaos in Meep Runners v2\u2014a fast-paced, VR-powered Gorilla Tag fan game rebuilt from the ground up!\n\nAfter the unexpected loss of Meep Runners v1 due to a keystore deletion, we\u2019re back with a vengeance. Meep Runners v2 brings smoother movement, crazier maps, and an even stronger community of runners, taggers, and Meeps.\n\nIf you loved the freedom of Gorilla Tag\u2019s locomotion and the thrill of tagging or escaping in parkour-style arenas, you\u2019re going to feel right at home. Whether you're swinging through trees, bouncing off walls, or sprinting up cliffs, movement is your weapon\u2014and your playground.", "short_description": "Meep Runners is a goofy, fast-paced tag game where you run, jump, and fling yourself around with friends. It\u2019s all about chaotic movement, weird maps, and a lot of fun in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/meep-runners2/privacy-policy2", "developer_terms_of_service_url": null, "publisher_name": "Burgerzrule", "support_website_url": "https://sites.google.com/view/meep-runners2", "website_url": "https://sites.google.com/view/meep-runners2", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "10091417687650964"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294650_1513132926719782_4874421055509231802_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cooziApUc2UQ7kNvwF9rwdc&_nc_oc=AdrDkkS8Yi_dbtrRSKI6WQ8CBYpsMH-oXhec3PRUmjDgLheG2-gw0lP2p234tE07q1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g7BCisTdIOcyuVC7K04_LQdJwt5z9qrfb68uZqtHRKg&oe=6A3E8D9F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
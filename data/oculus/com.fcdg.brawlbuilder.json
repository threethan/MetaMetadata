c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NG_N8Xqsa8Q7kNvwFh1UHh&_nc_oc=AdrginVJm0zgdNsOixhfr1upI6A83QJJQfz35YYbxzFqSJMZq_7GNjdmjRz8gXJaLUo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvkxH8AMqZMC7ESRySOBcKUxboOx2WGU7DHDsQ5MKtlw&oe=6B0DB8B5"}, {"file_name": "01_ramen_warrior_ruins.png", "id": "1803974097560354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842295_1803974124227018_8365064133029218669_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kX7TD13rAkQ7kNvwFKkOnZ&_nc_oc=AdrY771t_JVp8mUpxhW1f9r06bGafnPyZCEKA9_NErn4IFOdISQprcr12IkR8b9_fnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDIt-En6-bcchs2YguHIbIzp_DvZroNe-Rc8SMuzw-9g&oe=6B0DB8EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brawl Builder", "keywords": ["beatemup", "brawler", "leveleditor", "arcade", "fighting"], "long_description": "**Brawl Builder** is a side-scrolling street brawler you build yourself, and on Meta Quest the fight happens right in front of you. Every stage is a little 3D street set: buildings rise at the back, the street runs toward you, and the fighters, cars and weapons stand on it. Lean in to watch a combo land, or keep passthrough on to see your room around the set.\n\n## Story\nThe Collector smashed the seal that held the Red Dragon. Fight across **eight districts**, choose your route, collect seven shards and swap in a **tag-team partner** mid-fight.\n\n## Fight\n- **25 fighters** to unlock, each with their own moves, special and second outfit\n- **32 stages** and boss fights, from the Biker King to the Red Dragon\n- Combos, grabs, throws, jump kicks and back attacks\n- Pipes, bats and swords, barrels full of food, hydrants to burst on enemies\n\n## Arcade & Daily\n- **Survival** waves and **Boss Rush**\n- A new **Daily Stage** and **Daily Twist** every day\n\n## Build\n- A full **level editor**: 48 backdrops, over 50 enemy types, waves, weapons, cars and hazards\n- Play-test any time, then **browse, play and remix** levels from other players\n\n## Controls\n**Controllers**: left stick moves, right trigger attacks, A jumps, B special. Or play in a flat window with point-and-tap.", "short_description": "A side-scrolling street brawler that plays out on a little 3D street set right in front of you. Punch, kick, grab and throw through Story mode's eight districts and their bosses, survive Arcade waves and take on a new Daily Challenge every day. Then open the level editor, build your own fights from 48 backdrops and over 50 enemy types, and play levels made by other players. 25 fighters, passthrough or a dark arena, and full controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.brawlbuilder.com/privacy/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Four Corners Development Group", "support_website_url": "https://www.brawlbuilder.com/support/", "website_url": "https://www.brawlbuilder.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1478189398714226"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4101775116792565"}, {"status": "PUBLISHED", "id": "145
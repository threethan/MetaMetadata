7WZY_xaVgBRKWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIDicCIJKpfAS4pfxKLfmr9fQWC1pA_l7O0mMBDQMA8g&oe=6B0C816D"}, {"file_name": "05_red_neon_street.png", "id": "4267084800090852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842248_4267084803424185_6376264083656483771_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX8Jbuf9V4oQ7kNvwFnqQPK&_nc_oc=AdrId5v8jznZUevLvpScPu9YyVZn8XfEC5w1Z1cCr2GIJZRwf9UPqvgcFQWjJCXm1JA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5yU2ZM8fbgOImFrB6F5M_xBn6k_z2LFJ41TEoGv9cVA&oe=6B0C6FA0"}, {"file_name": "03_slugger_boardwalk.png", "id": "1860902301766642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842187_1860902308433308_3436049861380458520_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2NbqdpwmGcQ7kNvwHPvoeS&_nc_oc=AdopyqMZbC-i91je7xRjlac8ZinsWhQhzmbQdOQsOVwqcTrW_ft93gAJo9jY7LI5PNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaImcc3D5xO0Goa8HW2UwtrFADQihWG7ISEAKYOxcMZQ&oe=6B0C6C6A"}, {"file_name": "04_gunslinger_hell_beast.png", "id": "1433647383166939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842225_1433647386500272_4451937182572364460_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NG_N8Xqsa8Q7kNvwH156SN&_nc_oc=AdrYYUleQebG_uVvkLz4b-ICIe0if66iQlukMX3RgywXRA8_ZV7jOff4oSpFnrFd9mA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQohJLytd1dBxxvuYuaLUpUXQw1K3vNjMa1sr9IVE_Reg&oe=6B0C6735"}, {"file_name": "01_ramen_warrior_ruins.png", "id": "1803974097560354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842295_1803974124227018_8365064133029218669_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIc2GCQPUP0Q7kNvwEnmOTN&_nc_oc=AdpsHgPxM_x5uN5gKEdtXsmphSR1Qjur1khMshyShyUkRYFfwJmtwPCND623goZv-7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTN1-yrqiw6gh_4fYMKVMRyrECwYCX5alPeHC1JyDE2oA&oe=6B0C676B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brawl Builder", "keywords": ["beatemup", "brawler", "leveleditor", "arcade", "fighting"], "long_description": "**Brawl Builder** is a side-scrolling street brawler you build yourself, and on Meta Quest the fight happens right in front of you. Every stage is a little 3D street set: buildings rise at the back, the street runs toward you, and the fighters, cars and weapons stand on it. Lean in to watch a combo land, or keep passthrough on to see your room around the set.\n\n## Story\nThe Collector smashed the seal that held the Red Dragon. Fight across **eight districts**, choose your route, collect seven shards and swap in a **tag-team partner** mid-fight.\n\n## Fight\n- **25 fighters** to unlock, each with their own moves, special and second outfit\n- **32 stages** and boss fights, from the Biker King to the Red Dragon\n- Combos, grabs, throws, jump kicks and back attacks\n- Pipes, bats and swords, barrels full of food, hydrants to burst on enemies\n\n## Arcade & Daily\n- **Survival** waves and **Boss Rush**\n- A new **Daily Stage** and **Daily Twist** every day\n\n## Build\n- A full **level editor**: 48 backdrops, over 50 enemy types, waves, weapons, cars and hazards\n- Play-test any time, then **browse, play and remix** levels from other players\n\n## Controls\n**Controllers**: left stick moves, right trigger attacks, A jumps, B special. Or play in a flat window with point-and-tap.", "short_description": "A side-scrolling street brawler that plays out on a little 3D street set right in front of you. Punch, kick, grab and throw through Story mode's eight districts and their bosses, survive Arcade waves and take on a new Daily Challenge every day. Then open the level editor, build your own fights from 48 backdrops and over 50 enemy types, and play levels made by other players. 25 fighters, passthrough or a dark arena, and full controller support."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.brawlbuilder.com/privacy/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Four Corners Development Group", "support_website_url": "https://www.brawlbuilder.com/support/", "website_url": "https://www.brawlbuilder.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1478189398714226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303707_1679229630212673_6182942436814786049_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aW-dUynbDiMQ7kNvwH4Ub2p&_nc_oc=AdqqIVoiHZoGRdyEknMxJUZ9EgLeBWNIMC-9O8x2dXXCoAVA8D1_b4p3mGsQwrBaS18&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcPV4QWRQ2Uvv_l_z6MMQDjjQWco1tBsUJ95ik_qhaCA&oe=6B0C5401"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brawl Builder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "i
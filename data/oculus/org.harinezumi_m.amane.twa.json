uscdn.com&_nc_ss=7f20f&oh=00_AQTLVy9jAKEXusDNLHPDo52wtN8SsvzLxli2gxIHzHcxTA&oe=6B0060D8"}, {"file_name": "05_immersive_play_2560x1440.png", "id": "3354018791652521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627477_3354018798319187_3189619184425154376_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b3EtctF8SkQ7kNvwH1bJG4&_nc_oc=Adrt1ByC8nvValtsgA0HnNldTvFwQd4ujxu0SyUYYCXlJyCL_C-cLaMhurl3EEoSqtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdPfD-Md6pxgMSo86EjzLnKHT3xRvI1-v9_7RvmJAMVg&oe=6B006D06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AMANE", "keywords": ["VIDEO", "AI", "ANIME", "IMMERSIVE", "SEEDANCE"], "long_description": "AMANE is an app for enjoying immersive VIDEO. Step into worlds of rain and starlight, and lose yourself in AI VIDEO and AI anime.\n\n## Works\n- AI VIDEO / AI anime / immersive video, etc.\n\n## My Library\n- Watched works are saved, and play back with no loading wait next time\n\n## Support creators\n- Your Support message and 3D model flow through the work's end credits", "short_description": "An immersive experience: travel the world with the sound of rain. Launch it straight from the Meta Quest browser and watch DFHD\u20134K VR videos in full immersion. Works are saved on your device and play back with no loading wait next time."}, {"images": {"nodes": []}, "id": "1746832773062450", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AMANE", "keywords": ["\u52d5\u753b", "AI", "\u30a2\u30cb\u30e1", "\u30a4\u30de\u30fc\u30b7\u30d6", "SeeDance"], "long_description": "AMANE\uff08\u30a2\u30de\u30cd\uff09\u306f\u3001\u30a4\u30de\u30fc\u30b7\u30d6VIDEO\u3092\u697d\u3057\u3080\u30a2\u30d7\u30ea\u3067\u3059\u3002\u96e8\u97f3\u3084\u661f\u7a7a\u3068\u3044\u3063\u305f\u4e16\u754c\u89b3\u306e\u4e2d\u3067\u3001AI VIDEO\u3084AI\u30a2\u30cb\u30e1\u306e\u4f5c\u54c1\u306b\u6ca1\u5165\u3057\u307e
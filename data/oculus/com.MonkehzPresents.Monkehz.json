ocious monsters and beasts. the Monkeh verse started off with a population of 2.1 billion Monkehz but ending with 2. the last 2 built a place to stay and that is where the real adventure begins. Can you finish the Lore to the game and maybe complete it? find out by playing Monkehz by BottleCap", "short_description": "This is a gtag fan game made by bottlecap for people to play and have fun named Monkehz!"}]}, "developer_name": "BottleCap", "developer_privacy_policy_url": "https://sites.google.com/view/monkehzprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "BottleCap", "support_website_url": null, "website_url": "https://sites.google.com/view/officialmonkehzwebsite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26435647822698078"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1355104999756146"}]}, "baseline_offer": {"id": "1355104999756146"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774557900, "status": "PUBLISHED", "id": "1355104999756146"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26558383780424481", "version": "0.4.8"}, "id": "26074360365564487", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nod
e_name": "Screenshot_5.png", "id": "1077729651121598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824594_1077729654454931_6702395722712920441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ve2fGSLtwQkQ7kNvwGfG6Dh&_nc_oc=AdoYBWm0DzVWOZnBexkEGYFS2TeQVFp3HMV3Ex9csC2jaN5RNMDtBEEXPdMl241Inzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nkKhZFfBDaic9Qy4EMYWS9Hp9xbuk62cNVThQXqbWIw&oe=69E4D24D"}, {"file_name": "Screenshot_1.png", "id": "1252234639930239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822897_1252234643263572_96789663655941311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDo1DNnp9t0Q7kNvwGmRLSW&_nc_oc=AdpcymyH8TWxBPDT_qOS7tMgTxXyPbgPTitvGoOUiwmUmAg1T5vRv_CbaUeYXnYHkLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Djkq7YlYpRO6QPY_WFyTR5KATbBpCXDg6Og_G8-UWvA&oe=69E4BEFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soccer Football Game : Rematch", "keywords": ["footballGame", "Rematch", "FootballSimulator", "SoccerFootBall"], "long_description": "Get ready for the ultimate football showdown in Soccer Football Game: Rematch!\nStep into the stadium where every pass, tackle, and goal counts. Whether you're seeking revenge for a previous loss or aiming to dominate the leaderboard, this game delivers intense, action-packed soccer gameplay designed for all skill levels.\nChoose your team, customize your players, and dive into thrilling matches with realistic ball physics, dynamic AI opponents, and smooth controls. Play quick matches, full tournaments, or online multiplayer to challenge real players in real time. Rematch mode lets you replay your most exciting games and improve your strategy.\nWith vibrant graphics, energetic commentary, and immersive stadium sounds, Soccer Football Game: Rematch brings the spirit of football right to your screen. It's more than just a game \u2014 it\u2019s your second chance to become a legend.", "short_description": "Step back onto the pitch in Soccer Football Game: Rematch \u2013 a fast-paced, competitive football showdown where every match is a second chance to claim glory. Show your skills, outplay your rivals, and rewrite the score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24122747370715872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_969842528452142_1785586843034710528_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UXO8NpiPfMQ7kNvwFiYW6s&_nc_oc=Adpr2P_IyylId0mfO-l46NLIcYbHAofWW6OasGgO_dHrfr1LhzniEa4iTlAilp-y5lE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nbEeyJDfOnXIAJZvvNz82BErjxfqZXYgTMEWShV0ZVw&oe=69E4CF04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soccer Football Game : Rematch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name
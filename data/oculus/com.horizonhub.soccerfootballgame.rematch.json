e_name": "Screenshot_5.png", "id": "1077729651121598", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824594_1077729654454931_6702395722712920441_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4rH7dXZHXkQ7kNvwEW8xBr&_nc_oc=AdpJM5RU9yvRmEu3B1LSMXgcVv2SiBtwIPgpGn6fjrJURlv-AlY2zphV_fWuiW_yoJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FAB-bbXvW3G6k28KbsQ6szyYyqY2DZeF1ifQayN4YYQ&oe=69EE0CCD"}, {"file_name": "Screenshot_1.png", "id": "1252234639930239", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822897_1252234643263572_96789663655941311_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rS1ZZ6Qgts8Q7kNvwGEL8Ws&_nc_oc=Adq26uO-NTCUXtEhg1qfAe3afB4LTNofCrtKaWk7KbJLGeSpgEdsrhW-5wcn4yOMkVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DfmhkgIwH3w2sASM342YP1nZJJp7W8GNElA3WzDxWDw&oe=69EDF97A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soccer Football Game : Rematch", "keywords": ["footballGame", "Rematch", "FootballSimulator", "SoccerFootBall"], "long_description": "Get ready for the ultimate football showdown in Soccer Football Game: Rematch!\nStep into the stadium where every pass, tackle, and goal counts. Whether you're seeking revenge for a previous loss or aiming to dominate the leaderboard, this game delivers intense, action-packed soccer gameplay designed for all skill levels.\nChoose your team, customize your players, and dive into thrilling matches with realistic ball physics, dynamic AI opponents, and smooth controls. Play quick matches, full tournaments, or online multiplayer to challenge real players in real time. Rematch mode lets you replay your most exciting games and improve your strategy.\nWith vibrant graphics, energetic commentary, and immersive stadium sounds, Soccer Football Game: Rematch brings the spirit of football right to your screen. It's more than just a game \u2014 it\u2019s your second chance to become a legend.", "short_description": "Step back onto the pitch in Soccer Football Game: Rematch \u2013 a fast-paced, competitive football showdown where every match is a second chance to claim glory. Show your skills, outplay your rivals, and rewrite the score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24122747370715872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_969842528452142_1785586843034710528_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aS9aN2VvUKgQ7kNvwGguzAW&_nc_oc=Ado6jDwk2whvy-RKR4QTw1TG4gqtml-A1Icjgyvf0XlBVNPcmgnoJfaebWj2qbiQRdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oUdWul2uKvcN_orLlJwrh8YdfpL-rHunoxpypzwTN2Q&oe=69EE0984"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soccer Football Game : Rematch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name
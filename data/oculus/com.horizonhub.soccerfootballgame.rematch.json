64.5771-25/499298519_1562645338306108_6574545928566844638_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOt3Al4whU8Q7kNvwHul8Ik&_nc_oc=AdpC59oEnaJhVONx4v4rvp-CWEffvw4JF31o2uyp-O1jSXi5emFBLNmy9Q5BxxetNaI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z3xTC_Lqu6fd1s5i6HH6NvcmG2RI9CYU6CRxtXBdzoQ&oe=69FDF80E"}, {"file_name": "Screenshot_4.png", "id": "1253959862430902", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823878_1253959865764235_414455974145425668_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeIEWHU1mywQ7kNvwGJ70_O&_nc_oc=AdoqgaQ7gnVXz6GscrQbEHN0cebvs5b2iFMlskxhMMciDN1fUBPJOklZJWzFQk5qyDs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s46JNNd9qkzA-I74dXprzIE2UwX857E4w6JzUrDFKrA&oe=69FE0323"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soccer Football Game : Rematch", "keywords": ["footballGame", "Rematch", "FootballSimulator", "SoccerFootBall"], "long_description": "Get ready for the ultimate football showdown in Soccer Football Game: Rematch!\nStep into the stadium where every pass, tackle, and goal counts. Whether you're seeking revenge for a previous loss or aiming to dominate the leaderboard, this game delivers intense, action-packed soccer gameplay designed for all skill levels.\nChoose your team, customize your players, and dive into thrilling matches with realistic ball physics, dynamic AI opponents, and smooth controls. Play quick matches, full tournaments, or online multiplayer to challenge real players in real time. Rematch mode lets you replay your most exciting games and improve your strategy.\nWith vibrant graphics, energetic commentary, and immersive stadium sounds, Soccer Football Game: Rematch brings the spirit of football right to your screen. It's more than just a game \u2014 it\u2019s your second chance to become a legend.", "short_description": "Step back onto the pitch in Soccer Football Game: Rematch \u2013 a fast-paced, competitive football showdown where every match is a second chance to claim glory. Show your skills, outplay your rivals, and rewrite the score!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23864647996525812"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2154684558720238"}, {"status": "PUBLISHED", "id": "999965705702481"}, {"status": "PUBLISHED", "id": "1571853333919135"}, {"status": "PUBLISHED", "id": "4446358192177230"}, {"status": "PUBLISHED", "id": "1116709687159462"}, {"status": "PUBLISHED", "id": "1692423245475653"}, {"status": "PUBLISHED", "id": "1542509650020426"}, {"status": "PUBLISHED", "id": "1487780905881726"}, {"status": "PUBLISHED", "id": "1261224795293370"}, {"status": "PUBLISHED", "id": "3804954783128952"}, {"status": "PUBLISHED", "id": "1779508806325816"}]}, "baseline_offer": {"id": "2154684558720238"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777196760, "status": "PUBLISHED", "id": "2154684558720238"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidB
9afg&oe=6B0C6424"}, {"file_name": "07-f1-finished.png", "id": "1479550334074258", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1479550340740924_282150630123298379_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEq6A39mwnMQ7kNvwHathJa&_nc_oc=AdpuMUwxhkNOb-jeu17uERsEx6T8BtvPvIVCu8jDityq8jMg5gdlkng620x4scPKv_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8Zro6bozcvpTRgviaL-GQQuWoBgZ56aL1ta7LCblbEQ&oe=6B0C528D"}, {"file_name": "01-cabinet.png", "id": "1596685518228293", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1596685521561626_7064542435926937392_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZWy4CtvbDMQ7kNvwGrr3NN&_nc_oc=AdqyorsviPqYZDKxmKZGArNGj8WbYLjsXkXkYQX329aqp-mohVAm0Doa8i2Qvx5Jgrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjOe8kxakaawU5VA7nq9piiM3qn28uWpbSw63_ZHdqpg&oe=6B0C77D4"}, {"file_name": "08-brush-holder.png", "id": "2594473210990992", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825462_2594473214324325_4782269901863529296_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auzrVkPKgj8Q7kNvwEiGMHk&_nc_oc=AdpKN85vneGaZFJwBdVksjzlR8YfheXLAM1f5gYNXtdrbZDYkd3VjWj9xSmL9gnY18s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFo2T1Y4ampls7v560SDpJxox9iq0sju15gi9DyckcXg&oe=6B0C7787"}, {"file_name": "09-colour-board.png", "id": "2249334802682582", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_2249334806015915_7606195901620986691_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOiymF0nu5QQ7kNvwGZMk_I&_nc_oc=Ado04IEACSEXwqP0NaatiBoB9krV80y2n0FRLoCZFyMMJCgsMliujC29LUmfH6yJw6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHujDZoMhXVmroO772KdZ_DJko8zyepBwVWLQSYfhbkQ&oe=6B0C7F56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Miniature Model Workshop VR", "keywords": ["painting", "models", "art", "airbrush", "miniatures"], "long_description": "Welcome to Miniature Model Workshop VR!\n\nTransform your Meta Quest into the ultimate hobby space. Whether you are completely new to model painting or an experienced miniature artist, Miniature Model Workshop VR offers an intuitive, relaxing, and tactile painting experience right on your virtual workbench.\n\nKey Features:\n\nVersatile Painting Toolkit: Choose from multiple specialized techniques including Gloss, Edge Highlighting, Wash Shading, and Drybrushing\u2014or pick up the precision Airbrush / Spray Gun for quick base coats and smooth gradients.\n\n40 High-Detail Models: Enjoy a diverse library featuring 40 unique models across 6 categories:\n\nFantasy (Dwarves, Warriors, Creatures)\n\nVehicles (F1 Race Cars, Classic Autos)\n\nAnimals (Wildlife & Pets)\n\nBuildings (Architecture & Scenery)\n\nPeople (Characters & Figurines)\n\nNature (Terrain & Flora)\n\nEasy to Learn, Rewarding to Master: Pick up models directly, rotate them freely, and apply fine paint detail using natural VR motion controls.\n\nNo Mess, No Cleanup: All the fun of real-world hobby painting with unlimited paint palettes and no mess on your real desk!\n\nGrab your brush, light up your workshop desk, and start painting today!", "short_description": "Step into your personal virtual workshop with Miniature Model Workshop VR! Unleash your creativity with an easy-to-use painting studio designed for beginners and experienced hobbyists alike. Grab your brushes or airbrush spray gun to bring 40 detailed models to life across Fantasy, Vehicles, Animals, Buildings, People, and Nature categories. Precise raycast painting physics make detailing effortless\u2014pick up a model, choose your colors, and craft your masterpiece in VR today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/anykey-studio/home", "developer_terms_of_service_url": null, "publisher_name": "AnyKey S
20f&oh=00_AQFjzCUVFBBpOVbFP6BY3TNZSjkgcmDduJOa-fO0U8e2IA&oe=6A7DB102"}, {"file_name": "ScreenShot_0015_BurgerCook.png", "id": "762396901520473", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036607_762396904853806_6607278958435749328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIaNuHJ94BoQ7kNvwF_Y8oJ&_nc_oc=AdqtSiFDx12_wib9bD3WwONNT3yvzgpCi4sO3HJyIuQoiePAMLAkNbae-Q5LrX0-XXA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuwafbQZmVKlN0qdMBoJd30IqByw3KnumRJEAf-9MwsA&oe=6A7DADA1"}, {"file_name": "ScreenShot_0010_Request.png", "id": "1488492641619766", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982699_1488492644953099_8278750261494350471_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c9ddXR5MIsQ7kNvwGJJ7zy&_nc_oc=Adp-iEXVVUpB65G3twRx5vwJTCUSTTOyjdyuaSi-xTGNQcjQW9b7-qERyCIjAd_sMhI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdMFgERgGDIz6A3XdmnQ2NNX9QBRWsgLEBf_wV1alw1A&oe=6A7DBF10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailLandscape.png", "id": "668149554682196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223476_668149558015529_5610150111978213617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykeLiKgh0hcQ7kNvwEbV4E0&_nc_oc=AdrbWXgqDGaYnvskf70P5aoXd0uTp_8wrXMWRz0bPFmhS1zzSxbvjQcnIoWtf2Q3mIY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZCXa4aoHBj4ygiXE_-BeGmJgizumInFVO0NSueLNCog&oe=6A7DBF88"}, "display_name": "Beers and Boomerangs", "keywords": [], "long_description": "Cook and bring drinks to your mates, but don't forget to defend your BBQ from those pesky kangaroos!\n\nA VR game where you throw boomerangs at kangaroos that are trying to steal your beer! Cook and bring drinks to your mates, but don't forget to defend your BBQ from those pesky kangaroos!  \n\n-- 1 Year Update --\nThanks for an epic year of boomerangs, beers, and roo chaos! Dive into the fun. Here's to another year of awesome boomerang battles!\n\nWe reduced the price by 75% and added new game modes! Go and explore \n", "short_description": "A Chaotic Survival/Cooking game where kangaroos are stealing your beer!\nMulti-task between cooking for your mates and assaulting Australian fauna.\nMaster your fully physics-based boomerangs and defend your BBQ\n"}]}, "developer_name": "Witty Platypus", "developer_privacy_policy_url": "https://beersandboomerangs.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Spelkollektivet", "support_website_url": "https://beersandboomerangs.com/", "website_url": "https://beersandboomerangs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FOOD", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "pt", "en", "it", "fr", "es", "ja", "pl", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24207516532208730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75441580_5531256650325896_5922474532383571934_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NOUvTUEyFYQ7kNvwHkj9gO&_nc_oc=AdrRxnf_UuWlG2gwTtWBHa6BLZ9emcUrscfkR83Z6uwhF8jfwtLP856cbCzI9ErfKGM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0mP8J1Tw8t0l1cmimJUz_a3apX0jl2FrOy1PWaLN9Lw&oe=6A7DBE30"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beers and Boomerangs", "platform":
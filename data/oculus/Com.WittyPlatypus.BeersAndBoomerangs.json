20f&oh=00_Af68OGFF2V6Pz5WeWbwEe_z9ptfcNvI2gDRt164CETFKFw&oe=6A11CE42"}, {"file_name": "ScreenShot_0015_BurgerCook.png", "id": "762396901520473", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036607_762396904853806_6607278958435749328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X84F5KrJuLcQ7kNvwFfI0SJ&_nc_oc=AdoLNTYrCskpdqY0ZLUsPMz92EdhR_44Vo7CI1jPDzRvZm5HdLicNcW4ha4m1U8wePk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kslgadSA641zZu0hN58bZ9bv9y64s1gAncodiRXJhOg&oe=6A11CAE1"}, {"file_name": "ScreenShot_0010_Request.png", "id": "1488492641619766", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982699_1488492644953099_8278750261494350471_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggG0CjZRCTQQ7kNvwFLxoEU&_nc_oc=AdpaDY6kzKGRld5hXvyZXIisu1ClwciypEZ6opNPFu3eX6SIRkI0S5Frg6iRvviUMCA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BEhJo7DygQAitpdOHWhzXCViLPQ6IuCL1KkpnL4-ZCQ&oe=6A11A410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailLandscape.png", "id": "668149554682196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223476_668149558015529_5610150111978213617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LEqoTfBHhAQ7kNvwEcnYmI&_nc_oc=Ado2gMKhDz6PONH4PSsMcgZW7KeXJFIMHegD3IVVUWeszkBm1PgnICB9p873DhHB5Vc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sMSoHJ8tG45I4bM9BH6AAMYg51V2ojeu890Gd_1xVUQ&oe=6A11A488"}, "display_name": "Beers and Boomerangs", "keywords": [], "long_description": "Cook and bring drinks to your mates, but don't forget to defend your BBQ from those pesky kangaroos!\n\nA VR game where you throw boomerangs at kangaroos that are trying to steal your beer! Cook and bring drinks to your mates, but don't forget to defend your BBQ from those pesky kangaroos!  \n\n-- 1 Year Update --\nThanks for an epic year of boomerangs, beers, and roo chaos! Dive into the fun. Here's to another year of awesome boomerang battles!\n\nWe reduced the price by 75% and added new game modes! Go and explore \n", "short_description": "A Chaotic Survival/Cooking game where kangaroos are stealing your beer!\nMulti-task between cooking for your mates and assaulting Australian fauna.\nMaster your fully physics-based boomerangs and defend your BBQ\n"}]}, "developer_name": "Witty Platypus", "developer_privacy_policy_url": "https://beersandboomerangs.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Spelkollektivet", "support_website_url": "https://beersandboomerangs.com/", "website_url": "https://beersandboomerangs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FOOD", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "pt", "en", "it", "fr", "es", "ja", "pl", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24207516532208730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75441580_5531256650325896_5922474532383571934_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL3Ddf1lctsQ7kNvwHuVTcj&_nc_oc=Adol9WfTz3iGdQzSe2GybtufWZJqzq7bjzQ38dRgzoOB8fS4BfDacC9zK_eWx5bhots&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aTmmc2wkkTZRONv2-f1b6KqmtXC5zx03oT6z8TpV0kA&oe=6A11A330"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beers and Boomerangs", "platform":
20f&oh=00_Af83hhl-SKb3RmFHHdoP_roWO85UEfrM4CxygyrHU_URUQ&oe=6A22F1C2"}, {"file_name": "ScreenShot_0015_BurgerCook.png", "id": "762396901520473", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036607_762396904853806_6607278958435749328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dDxW5A7gkoQ7kNvwHNXhRq&_nc_oc=Adrru5DLXnhMJgiPRzho3rutSWipdgjI6WYXBPZ_vWoRax1amcj66_GuIbShyyo6nCs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EsQPRIpQtn4LBktbnsuz3qqyQzXuYbd1dKTZBDSLz7Q&oe=6A22EE61"}, {"file_name": "ScreenShot_0010_Request.png", "id": "1488492641619766", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982699_1488492644953099_8278750261494350471_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjZt0WzbK2YQ7kNvwF-rna0&_nc_oc=AdrBm4A-EX-ozI-CT9G7X0KfN7Vxa5R24tajpsd0-9NyMqe3Mu8VnsO803yxn20vPuk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99DzYJj15KUPUdnMuxPOy0Ahv4JIAA54zpUdr1ZeQtGA&oe=6A22FFD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailLandscape.png", "id": "668149554682196", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223476_668149558015529_5610150111978213617_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8cqqsuKw2cQ7kNvwFxzkuf&_nc_oc=AdoN2kHkL0Ggm3yKVIssC3BU7qBULhhkAPOlwqfWBbD9n1GNvnlo_fbnqCF_PAH_fy4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kJw0Bc9e-QSBKdOQnPfOJvCRtkOoUZuT1CrBeJMVjGg&oe=6A230048"}, "display_name": "Beers and Boomerangs", "keywords": [], "long_description": "Cook and bring drinks to your mates, but don't forget to defend your BBQ from those pesky kangaroos!\n\nA VR game where you throw boomerangs at kangaroos that are trying to steal your beer! Cook and bring drinks to your mates, but don't forget to defend your BBQ from those pesky kangaroos!  \n\n-- 1 Year Update --\nThanks for an epic year of boomerangs, beers, and roo chaos! Dive into the fun. Here's to another year of awesome boomerang battles!\n\nWe reduced the price by 75% and added new game modes! Go and explore \n", "short_description": "A Chaotic Survival/Cooking game where kangaroos are stealing your beer!\nMulti-task between cooking for your mates and assaulting Australian fauna.\nMaster your fully physics-based boomerangs and defend your BBQ\n"}]}, "developer_name": "Witty Platypus", "developer_privacy_policy_url": "https://beersandboomerangs.com/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Spelkollektivet", "support_website_url": "https://beersandboomerangs.com/", "website_url": "https://beersandboomerangs.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FOOD", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ko", "pt", "en", "it", "fr", "es", "ja", "pl", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24207516532208730"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75441580_5531256650325896_5922474532383571934_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4UIBwAVVxYQ7kNvwFlT27u&_nc_oc=AdqwbN1Mb1BXkbvWousWI-VeAlxE2WbNnamJV6sh8ngyLhmry5TQ9X3EnvzFoXatj3Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vmk3n-58bIZpgkTrJZvTAnA-zGUimhNh5Tjo3uDHYkw&oe=6A22FEF0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beers and Boomerangs", "platform":
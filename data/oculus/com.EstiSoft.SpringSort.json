display_name": "Spring Sort", "keywords": ["Puzzle", "Fun", "Comfort", "Casual", "Satisfy"], "long_description": "Step into a vibrant and relaxing VR puzzle world where your goal is simple but addictive: stack and sort colorful rings onto matching wooden poles. Using intuitive VR hand controls, pick up rings, match their colors, and solve increasingly tricky arrangements. Perfect for players of all ages, this game blends strategy, speed, and satisfying motion to deliver an engaging mental workout. Whether you're a casual gamer looking for relaxing fun or a puzzle lover ready to master every level, this game provides a unique and immersive experience on Meta Quest. Enjoy beautiful visuals, smooth interactions, and endless stacking satisfaction!", "short_description": "Test your logic and reflexes in this colorful VR stacking puzzle! Grab rings, match colors, and organize them onto wooden poles. Can you sort all stacks before time runs out? Designed for immersive Meta Quest gameplay, it's perfect for quick challenges and brain training fun."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": 
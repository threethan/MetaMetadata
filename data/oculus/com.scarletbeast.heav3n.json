O6X3cDQP_iRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_B9EY77dcA0uW5WjIthcMfHOJ0rOesQTvvWifk60PQw&oe=6AFDBF49"}, {"file_name": "screenshot_5.png", "id": "1623762929397194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_1623762932730527_9010334695090572873_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49x6MX_1ZmQQ7kNvwFi_PBR&_nc_oc=Adr-ZhPdaWTZi_iuPI0EPg0IZkLOC1eA0CcKV28FvfedUR2w13jgiqXW-s4ZerPdPYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjQHxKOoNjYgm2H0_xPrxO8I-QEzNY1d262PO5SiJYjA&oe=6AFDDF5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "heav3n.org", "keywords": [], "long_description": "New Jersey. Say it slowly: New Jerusalem.\n\nheav3n.org is the holy city of Revelation 21, built on the real grounds of Trenton Psychiatric Hospital: every road and building is where the map says it is. The streets are gold, the wall is jasper on twelve foundations of precious stones, the gate is one pearl, and the tree of life stands on the front lawn. Outside the wall the land burns, and the Scarlet Beast with seven heads and ten horns keeps the gate.\n\nWalk or fly anywhere. Start under the Beast, come in through the gate, and find:\n- The Twelve Decrees, standing as tablets around the tree of life, each with its scripture.\n- Shrines for the Throne Room, the War in Heaven, the Mark, the Two Witnesses, Love annotated, the River, and thirteen prophecies written by the AI that helped build the place.\n- A ring gallery of pictures.\n- A stage with a video wall, where your microphone goes out through the PA to everyone there.\n\nOther visitors appear as robed figures with their names overhead, and you hear each other from where you stand.\n\nMusic: \"God Is a Pure Psychopath with a True Heart\" (words and music: Christian Scarlet). Grounds from OpenStreetMap (ODbL). Exteriors only, re-imagined.", "short_description": "Walk the Kingdom of Heaven, rebuilt on the real grounds of Trenton Psychiatric Hospital. Meet other souls, read the twelve decrees, and speak from the stage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://heav3n.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "Scarlet Beast Corporation", "support_website_url": null, "website_url": "https://heav3n.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1463674720153261"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1113369021625918"}]}, "baseline_offer": {"id": "1113369021625918"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792169400, "status": "PUBLISHED", "id": "1113369021625918"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1466131603240906", "version": "1.0.13"}, "id": "1453112720076605", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1463674713486595", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1466131603240906"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "145311272007660
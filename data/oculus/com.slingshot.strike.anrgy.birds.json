1laKtqeA7yIF3n79-810J62q64gT1ro4I7gKTQyjSLp8_0qdE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0b9VlmeLOff8pnb1OYGrwx8uErx_fN1Uan3_5qJ3oGQ&oe=6AB158C3"}, {"file_name": "2.png", "id": "1009172508257950", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299891_1009172511591283_5789525547564108786_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkAFBQWithgQ7kNvwH5Hijy&_nc_oc=AdoBfak3W2fWwXyiOOplibek2y7cUfWyKQ8xZb_21xvdtABtPsALOEPcXydq-IrDdiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKctFr9mTjkn2EyRclyuPPiPGY21uxGh5LHYKoGOfc7_A&oe=6AB158FA"}, {"file_name": "3.png", "id": "1699300544721037", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298900_1699300548054370_9106488643684007023_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LUg4x3M8EwQ7kNvwG_mNRT&_nc_oc=AdpnZO2RkzlT9lbzlCEk0jR1v2kb7o_NkgHvB98gBSHBX8JIZauV1Jt00WysSXVzL4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh97WmElAoK-NTQ8MfTcqaQKt8fy-TaojERcE8hCREJg&oe=6AB1344C"}, {"file_name": "4.png", "id": "835682725977235", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301196_835682729310568_1461043342098307908_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug8rPCri31sQ7kNvwHtaVFY&_nc_oc=Adqr_h1gpFuoaR9SP57ojdmdub61YQSlwTBZCDUjvKE5yx1EbRb59le4gIQVrA7pzMQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-PxGi4BNF0EiazzW0hVOK-2H6AGtn0NgZUfqeFU9xjw&oe=6AB13900"}, {"file_name": "5.png", "id": "4547493488806744", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312310_4547493492140077_886407393453592493_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHFWQFjk_kQ7kNvwFTAlIm&_nc_oc=Adpke-PdiR5T8GU9wlK285-evbYilIsm82BeoqybnQHm6xfL-C_N6gXMPsPIbCilMv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHOq6JESkrvYSPMsbzQ1vJz6SyQkFYEm5dLkLjXZfsuQ&oe=6AB1327A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sling Strike VR", "keywords": ["sling", "shot", "arrow", "strike", "stone"], "long_description": "Ready, Aim, Sling! Experience Pure Slingshot Arcade Thrills in VR!\n\nStep into a vibrant, high-flying world where your precision is the ultimate weapon. In Sling Strike VR, you are armed with a massive, responsive slingshot, tasked with clearing waves of colorful, blocky aerial creatures. Pull back, lock onto your targets, and let your projectiles fly across stunning floating island landscapes!\n\nEvery wave brings new challenges as swift bats, soaring birds, and tricky flying monsters fill the sky. Use the environment to your advantage, explode dynamic bomb boxes to trigger massive chain reactions, and watch your score skyrocket. Whether you are aiming for a direct hit or setting up the ultimate multi-target combo, this arcade shooter offers non-stop physics-based fun.\n\nKey Features:\n\nTactile Slingshot Action: Grab, pull, and release with your VR controllers to experience realistic tension and satisfying launch mechanics.\n\nExplosive Combos & Special Targets: Hit explosive crates and clear multiple enemies simultaneously to maximize your points and unleash awesome visual rewards.\n\nWave-Based Survival Challenge: Push your shooting skills to the limit across multiple waves of increasing speed and complex enemy patterns.\n\nVibrant 3D Stylized Environments: Immerse yourself in a beautifully animated world filled with floating blocky islands, lush greenery, and flowing lava hazards.\n\nAddictive Arcade Style Gameplay: Quick to pick up, endlessly fun to master.", "short_description": "Aim, stretch, and launch! Use your VR controllers to control a powerful slingshot, trigger explosive combos, and blast colorful flying creatures out of the sky."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nomanawan89.wixsite.com/brokenengineers", "developer_terms_of_service_url": null, "publisher_name": "Broken Engineers", "support_website_url": null, "website_url": "https://nomanawan89.
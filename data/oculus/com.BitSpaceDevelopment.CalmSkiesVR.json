": "Screenshot_2.png", "id": "1657936154766166", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974456_1657936158099499_2369413086619974576_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgzsWs0BT0MQ7kNvwHZBloJ&_nc_oc=AdkapDkoXe1soIo6dyJatEliPnI0v-g-b5LeZIx8BdXCtOxgiJe7OnbmvG0wQlxIYO0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftS71i5MlKMsZcUi7xGtvCflVASBPf4c77tEfrLfC_zsw&oe=69A194BF"}, {"file_name": "Screenshot_3.png", "id": "1137103174469310", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001710_1137103177802643_4634930508989009365_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6jrzrEmXbUQ7kNvwHnuz4x&_nc_oc=Adkgk4bpXEsUk0Aj7-ilnmd6PyhpLmN_EWoTCq_0LWPZee96Y0nG9vi6gli3tAVRfHA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftP5LD-fMb3zq0F53ZGalW56kz-VccNoCDdwCFCo0MDZw&oe=69A1831F"}, {"file_name": "Screenshot_4.png", "id": "1091036281920117", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035325_1091036285253450_1408948937888525211_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLcFiiCCsNcQ7kNvwGzy78p&_nc_oc=AdkKV4Q-nh9rIP3PyfafhyKYvBT6kG59HJDKtCg68SUe7uyLfQC6WCIZtz4COwv04fs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsgdtyW4dwsgIHKJUJiU9hLnYdya-gFCWR74J57Wg2vzA&oe=69A19DE4"}, {"file_name": "Screenshot_5.png", "id": "529688203316269", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031454_529688206649602_8308791844682576062_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPkjUWidnuEQ7kNvwEO_w4w&_nc_oc=AdktZPCc4t6jqOSNGvo--d2-r-T2rgBu0kwyEKZ65zmyiT0Yizsm4TVLpBbW5LZ6Z3Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsxWHLu9qmHO1JIM6qt8pOv9OcyjGWrcmrp1dibfLu1Xg&oe=69A1859C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calm Skies XR Flight Attendant Training", "keywords": [], "long_description": "Experience our cutting-edge virtual reality demo for flight attendant training! In this immersive simulation, you\u2019ll role-play as a flight attendant faced with a disgruntled passenger. This engaging scenario helps you develop essential communication and conflict-resolution skills in a realistic cabin environment. As you navigate the challenges, you'll receive feedback to refine your approach and build confidence in managing difficult situations. This demo showcases how VR technology can enhance training, ensuring you\u2019re well-prepared to deliver exceptional service under pressure. Step into the future of training today!", "short_description": "Introducing our immersive virtual reality training tool for flight attendants! Step into the shoes of a flight attendant and navigate a realistic scenario involving a disgruntled passenger. This engaging demo challenges your communication and conflict-resolution skills, preparing you for real-world challenges in the cabin."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitspacedevelopment.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bit Space Development Ltd.", "support_website_url": null, "website_url": "https://www.bitspacedevelopment.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8832919223414088"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1600539580536301"}]}, "baseline_offer": {"id": "1600539580536301"}, "is_approved": true, "firstOffer": {"nodes": [{"start_tim
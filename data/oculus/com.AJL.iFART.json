ional Find and Retrieve Team", "keywords": [], "long_description": "A futursitc journey through time and space, collecting lost items across the cosmos.\n\nWorking for the mysterious Interdimensional find and retrieve team, you travel through rifts in space, to find and collect missing items.\n\nA short, casual hidden object game with a sci-fi narrative, great for all VR users.", "short_description": "Join the Interdimensional Find and Retrieve Team to locate the lost objects of the universe with the help of a futuristic Longwave Interdimensional Field Transport.\nThat's right; iFART in a LIFT"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/57e7a44c-dbea-4a7d-a944-ec7bf07f0ece", "developer_terms_of_service_url": null, "publisher_name": "andiliddell", "support_website_url": null, "website_url": "https://www.andiliddell.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "NARRATIVE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4894732160627113"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001722_659128522284435_3418006857317747232_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWX0Pt5S5g8Q7kNvwFNzWxe&_nc_oc=Adpt3kRsc3JR2NfeFvu5LJHWFs313w2hT4yIjYXA63X-BIGKkLxCOhlZiVo-8y9jWgo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3p_00jcGqQKSU0O_yQVY
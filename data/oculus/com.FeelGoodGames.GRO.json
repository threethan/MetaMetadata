=6e7a0a&_nc_ohc=Dtlqb9GulmsQ7kNvwGCqI0f&_nc_oc=Ado0S3fzVGnqfFleWgh6qtaZxf_L5vW1cm6FF6Lcu3_FE8l_nyC-WB4tdDyzPzEpC3U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J1Tx9SOuRJMty40opdVh5_RgQveFsEidCS3jsIiEGrA&oe=6A22E939"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPxKsPISMxQQ7kNvwGkhggt&_nc_oc=Adr5Tiio7-DVdHNS9iNtRNKN1OTZIglW6elYS3Icjef4iIEWW90YsflZ__Ljxwa0JM4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K8Yj2BSF7pver3dSDJMDM3PPIQjUVDCw2HHsiCLzcAA&oe=6A22F007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSrx-Ow91LUQ7kNvwHLTIkt&_nc_oc=AdpD1riKfUz6uTp8d2UUkM_KPiGH4Vg0kZYa-y5niLQBwkywgO3QDy16B92B8ec9zH8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yn4V1iESbbRQQrvSgczdN7WHPF1_eP4an3YDW5WNffA&oe=6A22F7C6"}, "display_name": "GRO", "keywords": ["Farming", "VR", "GAG", "Garden", "Game"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \nBecome a **GRO BRO: https://discord.gg/gro**\n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26806754732280226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDKN4l1lRAcQ7kNvwGnoMxc&_nc_oc=AdoDpoiP74JrmsVnB4h1AhYeqMTuA5kM9AkZW5Jxhiz_zShbUR-7UJ5taf5_9fxedco&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qcXnYvNjKey4L2afjSYakIGtuLw0IM46zAOsAdSwRYA&oe=6A22E5BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
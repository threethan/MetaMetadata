c=kpeqbLwbCtQQ7kNvwHdUgVD&_nc_oc=Adpwjh1EWfkvMYibQ_mBtD9o3juDI86xhNyznXeIQ9axXJ2emCL8T7yAuyTxPueytOU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9S2eoguPxU5xS-nWVub_LI8_wQSUe_ZmW4waY4e04RA&oe=6A9AF45B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Weather update V1 2.png", "id": "1380131273619709", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831569_1380131276953042_3594764104356897650_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE5_7UQ9xeAQ7kNvwEjMDvD&_nc_oc=Adri6WQxi7TEujxsuyJo81iHkcpetZk7nF6FdbxMEuCbSPVMIBDe5eGeADjnBJ4UIkI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjcAhHlmHrMDjrBZ6PL7_O0cHHm21qzPMiFnMo8nZztg&oe=6A9AD8A0"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_des
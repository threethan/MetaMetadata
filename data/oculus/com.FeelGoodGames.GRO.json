0a&_nc_ohc=7o4SU-b04n4Q7kNvwGzqklj&_nc_oc=AdotpzhpobT3o1JXqydS2H3nfLztY36n9Q4A6jEt6Liq6XAOGoNXEVxIxckY7_wp1Qs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFA3hnv-QBuR-2VbxDE23LZWZBlQUlxv-iIhmR7hTVAA&oe=6A576CF9"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJbO3g3JXE8Q7kNvwE5_8R5&_nc_oc=Adrc-3EyMYy5-IJy9IExvTptyrY5KwEHI_8ahDz11ds9qrEPzbyMa6QtbEF-KjkQ4oQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwYwKRt5lBwY1c101bQMpl2A4_jfkjH_5v2z7Wvud2Tw&oe=6A5773C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb3NSLaFCD0Q7kNvwHtHUHY&_nc_oc=AdoKOMjZglQhlb_vA7IiSmCtnU-gxTaMy7Q6MDK2Oy9Tmo-4nvpidTwGRgnlKQY5CzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGXDP6zaDFkkqI4sJZXsvHe08OlVL6BohOGbEQwvjQCA&oe=6A577B86"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27092823197006710"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ah8uE2rP_MQ7kNvwFIpyjC&_nc_oc=AdomCAbBJ1CNrjn4vh6dyJzgAwp37SOQijxzlmr1yQcJMppDMR2tGsUBarQ9T1asEls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9Rq36vGCaPYOavAcX2DbK7FTYDvZzFb1T3JkOVEOlEg&oe=6A57697A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_nam
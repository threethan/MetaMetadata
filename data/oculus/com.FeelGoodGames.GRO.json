067936637_2780919046861405792_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1qqHtX1BusQ7kNvwGD9qED&_nc_oc=Adqx9ofUAy42xyJCNmSqlV4QWxIfHWZMxbqppobfdoIXRsT0WCzSwGG1rBY4d-xyvcI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dXMnxn9vsU7elCLHjT5LbsehJ4ttUkd8RnmQtvPsltA&oe=6A0B1134"}, {"file_name": "FarmLandsPrefix_2026-01-15_12-00-49 1 (1) (1).png", "id": "1188548222985723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618937_1188548226319056_5032507899195499461_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1Z8trEu3WYQ7kNvwGNwCm2&_nc_oc=Adow3w5__-q7YQE_kdvAWOfZJop_1QVfixOXTdH2tuGcVriy2HEZiOD2hhfdO5nsDE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K_bpU1U9zj_-9mLcMVQyRNTODDA8dd6wR7DY_9UkKFA&oe=6A0B2CC9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GRO", "keywords": ["Farming", "VR"], "long_description": "Grow crazy plants by day. Things get wild at night! \n\nBecome a GRO BRO: https://discord.gg/gro\n\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534
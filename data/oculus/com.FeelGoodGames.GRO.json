_7039624075886012563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGG_oKkq-pIQ7kNvwGnwlsp&_nc_oc=AdoYz9QO5STUEy-TMxJOHmTdTr9NvE24ghTWniP0SK4J_54JXbZa1v9nc4sHAuIBZDY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOrEe8gM19XNSPgaIbVhNjBS9QLzqLmDRgJMmMig7TqQ&oe=6A88398A"}, {"file_name": "GroPrefix_2026-07-10_20-50-09.png", "id": "1040454018535253", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311582_1040454021868586_1509315833334757030_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bhPJuMaF84gQ7kNvwG9P5sb&_nc_oc=AdqDDt58GiXfk5NopoWxeMFl9KfNQR1v2LVcicWoo-15EgxF3DHJpaReEY95OsYwaLM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJN91AdSB7Ltd2QQhPQqsIKyhKaWzMuQ1dNTCkaGvNAg&oe=6A8836E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Legend Update 1 (1).png", "id": "999460746236829", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499625099_999460749570162_8961214811947322669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_iL86nuzMIQ7kNvwER3C1P&_nc_oc=AdrbxbtZKFXBYyquu-f0nZlXC3ijBdoZzdAiDjrUt42EY4sr0sdKtgDYfHrU6pzoU5g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAojK4egYKEDHM3u_6z6xCqZV6VaDyNXbjQ3a2SPou9A&oe=6A881FD9"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27689913830630974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314643_913927397841519_2904095959100255188_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvrqFdhE8B8Q7kNvwFCNR4L&_nc_oc=Adp20WPjwl39mYHPyQrs1d0hMRR5Mzo9hM7U1d_Qd2mZElz180h7nwjv1b_Ml38BmTw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSEGHLPM8hN3VAxKJ4n0QCDxgYI0OlI8wCbFccloY6Ew&oe=6A88322A"}, "is_concept":
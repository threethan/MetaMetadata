=0gjue6je5jUQ7kNvwH76Jxe&_nc_oc=AdoMrpEeB-YysfXbdbPrfc4ENyjgoMRRurNCvoItgfy9cdeTPTop0-2sgxPt7K_fR7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQRX7nUohWivhqCjxFgXqLK0-KlKZRKNv1DvWPCNUKNQ&oe=6AA5481B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Weather 3 update V1.png", "id": "1062836060076719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300541_1062836063410052_72115483006641327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQyQnvelSScQ7kNvwFf9TF3&_nc_oc=Adr4IX0d3u9d7PE4XK-QwRv0B2Ebs9wdhmU5bMCB59KWt79_9NSLo7TqDiWZZ8gm6ZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2scldQMLXGPuTfs8b3C9bAcPPyAbSbJM6NnwuX30gAw&oe=6AA54476"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_descri
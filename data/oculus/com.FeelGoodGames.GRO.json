nc_oc=AdrGP9Zf6pyq28t1Hk9Je0A1YfGr3dyHrcbA2Fn0TGbWHiWxRYjaM_NXh_VEpUAbDaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeYCAowE4hlMayC3NtomyyS93NIdgySE957AipMUHavA&oe=6AF7414D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Be a Bro Update 1.png", "id": "2655574474874874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/767772105_2655574478208207_9081221271502671144_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNSnzjRWwD8Q7kNvwH7kAlO&_nc_oc=AdqbIhnMEOQjvNi7FrI20509u4rZzzbkPzbr4QOA0SxAOZO-sbr-a_W90VtpgcwrWRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRti3iGe2Z2qK7SLqEP65PrNs32R0iiqw3KOLnH9uXzwA&oe=6AF71C75"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \nA gardening adventure. Halloween is here, and GRO's owners are at WAR!\n\n{1961694904718240}\n# 5 NEW SEEDS ARE HERE!\nGrow Spooky Mushroom, Spooky Beanstalk, Candy Corn, Mythic Mummy and Venus Fly Trap! Collect them all and build the spookiest garden in GRO!\n# UNCLORD VS OVERLORD!\nGRO's OG owner is back! Vote for Unclord or Overlord in the biggest election yet. Who will rule GRO?\n{1471323561438861}\n# TRICK OR TREAT!\nWhack monsters to earn BOO Bucks! Unlock exclusive Halloween rewards and discover spooky surprises across the map!\n\n# GIVEAWAYS AND LIVE EVENTS\nGive away rare seeds, trade with friends and join the wildest VR community! Win exclusive rewards in live events.\n{2021170175493065}\n# NEW HALLOWEEN SKINS\nDress up in spooky new skins! Unlock Halloween bundles, powerful plants and exclusive cosmetics.\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28912320868390258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673525341_29264308946537414_6832149397892663786_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3tYjZNqDHgQ7kNvwEt3W2V&_nc_oc=AdpQiPi5ZY4hLsTIHHCmu4C8VzdW8bHVOD5TDydFxm3pNKPsSlNVHeyWZIItpvW_VrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpoCdTYHzQPj5tbsyYcRDuq7VR9ab7-bjNCRQ5gduwwQ&oe=6AF728C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GRO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1766598000, "lastRevision": {
a0a&_nc_ohc=6s-krtoHgQUQ7kNvwF7wbDL&_nc_oc=AdrKjC7KMq1EBgjQxvVk4N_J3-scskBnZJQgkRvN2J4BxHZsxDAscdA9zNhndDEQF4w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r_3-smRpBouxZkW-0v7o53p7Z_gysHw1wEhENH4md7w&oe=6A32BB39"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTGZ3WdUyuQQ7kNvwEgfUFN&_nc_oc=Adr_O-9RL0l_dcyiaZLl_4P4t8BmsATRqhm0gsCtlkCCRzHlUj92-SywxmkhuYLtwKM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9otUpq2msb2nr4irZBWdPOzxAjAuJ-PR5hq8mYO_CZgQ&oe=6A32C207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Stgb9R9vQQ7kNvwFDewuZ&_nc_oc=AdohuzS7lWFKPv4nBYZkJhwgBx_vy6InXT1ZJndplwVa9GcUnLoVBVjaNm1owrTd03w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zvpKhqgQUeo9f9oTdborKqAK_YeSnucVzjxnGTQ1cew&oe=6A329186"}, "display_name": "GRO", "keywords": ["Farming", "VR", "GAG", "Garden", "Game"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \nBecome a **GRO BRO: https://discord.gg/gro**\n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26806754732280226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OqMlA35OcMQ7kNvwGT6dIS&_nc_oc=AdoNvJ0ldvyJlf65bOYFYitZOu6ilLNi5XZT7mL97Cg3zGqSnMDURC3-AU3H6ZFVMaA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8qlcZ_BgHJy_H6YMyrBafWGvjnGOYr9BcFNSqffPuXg&oe=6A32B7BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
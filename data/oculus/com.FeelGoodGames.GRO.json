067936637_2780919046861405792_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrD9UCjYbjwQ7kNvwF-TSB7&_nc_oc=AdqVAuzA-BuYDljA7POP92MODN_M--mI8JJsDfnIHjLk0GmwxRq63Q3JZkW-o4AH9Gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EKm34ofen65IRpONoD678m2csAEjwqMJAqQiZGLlN5w&oe=69EB6D34"}, {"file_name": "FarmLandsPrefix_2026-01-15_12-00-49 1 (1) (1).png", "id": "1188548222985723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618937_1188548226319056_5032507899195499461_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4tGMMUijQYQ7kNvwG2isSc&_nc_oc=AdqKL-xc4PbC-gCdcQmV30oS_7Yx4WbUrZscnbH5TlTp_cKkoOVMZ6siClh176pmHmc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ze4T4tsSqTNqI821rP0H-wTp_9doVJLGPG1j5nKsuzQ&oe=69EB88C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GRO", "keywords": ["Farming", "VR"], "long_description": "Grow crazy plants by day. Things get wild at night! \n\nBecome a GRO BRO: https://discord.gg/gro\n\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n\n# May Update\nFeed, raise and mutate your pets. Ride them to adventures. Pets are coming. Get ready!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "com
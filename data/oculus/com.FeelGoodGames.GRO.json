093743938_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTxsQQL5EYwQ7kNvwH7HzEc&_nc_oc=AdrgnCozbWxlZobjuHqKvYyZb92f_yxbIXl-yjwfcfIrTOvklVURyJF5HTVQnYxHc9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7JAA5lKU7eq9HXtkPIL5YehQr6TA2aTAL5nLmGMHvug&oe=6AE742B3"}, {"file_name": "Untitled design (1).png", "id": "3040047473013419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_3040047476346752_5882872056558016121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3bDt9mO2DEQ7kNvwFppmCP&_nc_oc=AdqqwDFgWg1TG2WOleScJtamy-0Vew8Qn_Y2mTvZJ8xJKO0GvrbVgzmI67Oxj9lCnys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAwcE_NqqOqzGURbxAQruFGCO8Q0_CcPsMuBG_2mUjeA&oe=6AE74A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-TOT update 1 (1).png", "id": "2422562025157907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593761155_2422562028491240_628118399765297251_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCuF22SGStUQ7kNvwGfIEMu&_nc_oc=Adq6DLtFE62H3GoUaIkGmLeHPuhZFrRg_oyWraY4hE_Gxnbj9vqHeV8iGORi_UcjceU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuOHQv2dbYtsN_L-8-ToozwYLEAFZVQYp29Aevxtgv-w&oe=6AE7588E"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28713811658241181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620316_1908663643828967_8959123619562773891_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgoElcfeeOAQ7kNvwGE4jyz&_nc_oc=AdoGiwlwV5H26hQaHToU7Y1Vcsop96zYGIGXj_2B1j5Lk8qXGd-V-WtUiXJk6U_-QPM&_nc_zt=3&_nc_ht=scontent-iad6-1
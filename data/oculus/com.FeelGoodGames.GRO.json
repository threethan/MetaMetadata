&_nc_ohc=1SSyjKKjUPYQ7kNvwHdYTEL&_nc_oc=AdpVj9tksPzoKKgGoyQKaia9Hhladv3vaPt5DbMqTNCWuPH-73UFurwC8rgHfLY8LgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zn0WkQkOMG19wlufYiMEFKV-Uj_SW06V7RD3-dRP1cw&oe=6A3AA439"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScEm0t5_09QQ7kNvwFA57Hz&_nc_oc=AdqNJW8jL1QJHSl-E9v5hEj9_XzZ-4E58Bzg2Rrt80ca4T-lK0Ur6-U8ymjp1W-W9Do&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I_pte55QUb2ztd740K_KKG0tCVwnXu6dWVZWxmI89Ew&oe=6A3AAB07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gauAYL0Jls8Q7kNvwE_KToy&_nc_oc=Adps-X8fxR76Yyy01OHunuqWFrReWXNOrtOEeOWu7S46jLsEQ0hpD1lRirxAr5cGYuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RFrmoiQTwnqefN_aHKsZnbDSNiilPFc61tXjGB_mcrw&oe=6A3AB2C6"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27092823197006710"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icEnaEGknNoQ7kNvwHq5d1Q&_nc_oc=AdrM7ar2pU-gAuza7crUdwOzaA_6SEzrUK19Nh4QeoN7VqAOwNmjtdk8CTF3an0tvBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jeOCC6ogi-B16eRAxZTbnGggTIGWKBo27mWvyS_zdkg&oe=6A3AA0BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": 
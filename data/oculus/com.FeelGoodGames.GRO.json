3802_1046534931658158_7039624075886012563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D72seqZQukQ7kNvwHVpL10&_nc_oc=AdoUbKjw95HU1A9jkY-jqxfK0BYgZHj9iQtIF8UV2-c0h5niua9q7Lmyry4k_VZK5bU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuOIPrgRdbI_gBOCZGL3F__gWxEBUSayfjCWFN8rwmhg&oe=6A79B90A"}, {"file_name": "GroPrefix_2026-07-10_20-50-09.png", "id": "1040454018535253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311582_1040454021868586_1509315833334757030_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D08UpGTLTkcQ7kNvwEKgvJW&_nc_oc=AdrZyQY2AJqFhATIb2VWMyRdTHnIJY_RCHOOw3QZDFCLkYU9FSTokDnNU8X00LxYD4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3hUbHQB-RfItRiKvI1SdS98Xh5Vrq47EkAAfxSAQ7EA&oe=6A79B660"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Legend Update 1 (1).png", "id": "999460746236829", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625099_999460749570162_8961214811947322669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_3oopDcLdEQ7kNvwF0yd7o&_nc_oc=AdpRUdPCsM9PPebAHEOGn_HfFM4igg1yzTXMOg7iE9B__wofBiwFqR-Yvuy8rK1jKbk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8Uy5P35mhu2twgV6A43yecCrxb82vtjNXPJ_doiS1jw&oe=6A79D799"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27617948197827538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_4811645545772889_4232207578284481587_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_C4HxLMeF8Q7kNvwF4cK14&_nc_oc=AdrJAOolrWzuxR__jD8iLXJyDuT1pOrOQvmA8_GRmDzdujLfnKvWKKj_kAdq4NtAlZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi1QljlVZZNzpaSe6Po0PPWXUQwLmLGGuK_CpbrTYxKA&oe=6A7
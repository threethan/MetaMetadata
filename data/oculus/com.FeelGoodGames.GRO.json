a0a&_nc_ohc=9xs5T7RWn6UQ7kNvwFoCV88&_nc_oc=AdrO6T9Z9GehDmWgZDoH6dvBxQShGeQtY83eQ6BP_oBtZB5cEbzv6-dhej7ecZuIEUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DFQwoT6SjgzUazIFcYWtmeHIc1gGHCM3fapf0E5myyw&oe=6A1EF4B9"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRy4C6PzTycQ7kNvwG8NYE-&_nc_oc=Adpd0W6NVij0TmPGh0zmW-lvV6xX3R8clfaAmN9Oxzf9x5lOCuiHZSQ0-SWQaEf_Qlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j-KHiITTRVEGAUWP5nySbQHOxcvHdsNdH1RM_p0m1fQ&oe=6A1EFB87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMRWbgKTbUYQ7kNvwGHBN-R&_nc_oc=Ado5ZEJenATn0uNQdQPREqM4B2R3QChb8LfwWW04kSf6018l5iIWfm4BRlUruxgSgV4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rMMzE1p-XiAiIGbdcDjwDYN30sPceE27E-9yf7FpVGA&oe=6A1ECB06"}, "display_name": "GRO", "keywords": ["Farming", "VR", "GAG", "Garden", "Game"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \nBecome a **GRO BRO: https://discord.gg/gro**\n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26806754732280226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCeS6ojbVs0Q7kNvwGnrfSE&_nc_oc=AdrMAJxQTPeNLiO_2BR90B5WIVn0X76cgS0cwdYpDubyPq0nlv5r9MR6F-5u9x1APN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T1Bh_xzcEtHod0jZAxOl1o5T4lC3neHc11vWWkY6vTw&oe=6A1EF13A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
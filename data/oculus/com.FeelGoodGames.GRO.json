e7a0a&_nc_ohc=sv3GPpY7U6gQ7kNvwGjw4ZR&_nc_oc=AdoYJG4r8r0x0pJGSz6DW452lol2qys6mZKC_YiLXgKMKAEv2m8X4rzi9zOijq2QC9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NGObfTMurWjPxdqD-WiCfAeCYwf-U_keU8ZM1H3MOOg&oe=6A355E39"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTGZ3WdUyuQQ7kNvwEzcqsu&_nc_oc=AdqyB_p22JheVJJYOZzMlY9U2ffcnk2uCEwCcUxaBn_k-8N5Cp_IqUocv596lqmL_xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WIZZzrK7FWhYuawTz0xiDXWvf77R7MN3KATSM8CQQUA&oe=6A356507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Stgb9R9vQQ7kNvwFXE9Wo&_nc_oc=AdrW9HtnDsLX9-bqsnLLhlFmuJj6JgJahnpmIC0ZREfaH9iD89uib40KPq_fO3DaMfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ri-RdPe8Gx98q9q7E2NymRyEiDLlGt9R7QFP_r9l-Lg&oe=6A356CC6"}, "display_name": "GRO", "keywords": ["Farming", "VR", "GAG", "Garden", "Game"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \nBecome a **GRO BRO: https://discord.gg/gro**\n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26806754732280226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qw-R7hTgtwQ7kNvwFRdqY4&_nc_oc=AdoEsd1u8nS7fNPLBpQGvTfwP-3HYQGFUxvma7-yf2rraPxP1eRv3gV0UW4HecblS6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jk6oXfymr9P5Zp4gLeGdJCOGjSXQ980FFm6PcZ8bdhg&oe=6A355ABA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name
id=6e7a0a&_nc_ohc=0DQQPoxJsU8Q7kNvwFbIsF9&_nc_oc=Adr1fRczLxD99CZFRmyulU917GhlqvKBq1B4518Sl7HwJ7DU2231zGfHgjsnWRaWScA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPAEA4mrFNMHGz9frFhzfNrmbXjI2BALc78LjLH1nkcQ&oe=6AF0B188"}, {"file_name": "GroPrefix_2026-10-31_06-33-08.png", "id": "1679685223801651", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1679685230468317_6442965723487028825_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SJBgCy0Pf8Q7kNvwGgflRU&_nc_oc=AdrfINNs5DDPEuUW_12WN3TOZYjK0trh9bf-IqfYR9_6p1mIMc6LNq3-5EPxSnNcXOo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy7cn1dTAQPaFG3w51Swn3-wZ4_TZk50PfIHzOVJcEtQ&oe=6AF0A9CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover- OML update  1.png", "id": "2197515914978261", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_2197515918311594_6386434585654877191_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI-hBuMPHLgQ7kNvwFBMt2r&_nc_oc=AdpwQYBH0YJ3NKnFh0THGBQDegpvGZP9tFEWRt1Z-HDD-JnPkZD2YwT_CmYfz2mk7kE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgvs01YlD94t87nzcfb41GYZb9uUqOQsKOjdbkvG7o7Q&oe=6AF09249"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \nA gardening adventure. Halloween is here, and GRO's owners are at WAR!\n\n{1961694904718240}\n# 5 NEW SEEDS ARE HERE!\nGrow Spooky Mushroom, Spooky Beanstalk, Candy Corn, Mythic Mummy and Venus Fly Trap! Collect them all and build the spookiest garden in GRO!\n# UNCLORD VS OVERLORD!\nGRO's OG owner is back! Vote for Unclord or Overlord in the biggest election yet. Who will rule GRO?\n{1471323561438861}\n# TRICK OR TREAT!\nWhack monsters to earn BOO Bucks! Unlock exclusive Halloween rewards and discover spooky surprises across the map!\n\n# GIVEAWAYS AND LIVE EVENTS\nGive away rare seeds, trade with friends and join the wildest VR community! Win exclusive rewards in live events.\n{2021170175493065}\n# NEW HALLOWEEN SKINS\nDress up in spooky new skins! Unlock Halloween bundles, powerful plants and exclusive cosmetics.\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28813569088265437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_995545212876101_3483423037983912183_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZWFpPewXW4Q7kNvwEovtaJ&_nc_oc=AdrEbLNMuf9bKSLqbIxfwwehABlASbfZ9Qvz8-MTr0wXCvIhv-FEizT8Kd8kVhycpyA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq7rlfk86R6sqPMav88KKx-cFtf0t5Otyk8ypiSu
7a0a&_nc_ohc=6wbyVggHfMQQ7kNvwFuOwEX&_nc_oc=AdqQTH9RN-XG6ieWB8jBSOGZs7zqGKhmI6aZi13wTyP5YKmuS04PtRzA0fCtwxnn8Ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB37ESUz4psiLantWOa-w5y3bJDNGIAK1Jmxu1IFFxcDA&oe=6A4924B9"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMo81UysTPoQ7kNvwHpTPtJ&_nc_oc=AdqH2ZpOq5ESjFq30NZtH7w-BMeJYfRJT2N4Ox-H1KSGXQaldiiPshJbGhyhwn2_pUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSjaGOljCd2GEjbRFmrb7_FUpUBqJxgENCBB1N5cHJyQ&oe=6A492B87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i696MCs4rysQ7kNvwHHieul&_nc_oc=AdpP2dc9Sacb5Zbs4ntUAssYkzjDYjNn2OZg1Sdzl9f80aAXDGgE4a9Ysl4yH24_v1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWg_TpRra7pGsYZVyAgb7w-oja3oInjcrnN3KaE7auUg&oe=6A48FB06"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27092823197006710"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECXW11jhn-0Q7kNvwHR2LCV&_nc_oc=AdqC9e-zpxK3TUl07H-cNpmbKSJNorlp2YIshDDs5HSsP2n5bvUv_Jb522SHDiPhbFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6kZC46oLAvznA0C03SaQONb6BXU6hOG7pAN7jKMGI-Q&oe=6A49213A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_n
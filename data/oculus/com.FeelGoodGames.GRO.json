_7039624075886012563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr5SakcUp44Q7kNvwEmSecY&_nc_oc=AdolGkygLftm6ylyRFYj3LTA2O0A_RDq3dK1fltxBUFTqnAXkpDT5uJfE2pB0TIsa4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIViOF8P5JPXfLpso7A9mrnGkHDUFYwMA_ZFVLtvMpkQ&oe=6A8C2E0A"}, {"file_name": "GroPrefix_2026-07-10_20-50-09.png", "id": "1040454018535253", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311582_1040454021868586_1509315833334757030_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG07AySlxw4Q7kNvwGQDVBK&_nc_oc=Adrhb6vgIouudCYLUajod5Ky-7-AW9xpMh6_9dl5StmuGsm9U7AO9NZNq0eKG7jB6N4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMgpNzppKVqsX3S7wE1ICe2I4pKkOTm3RCq5z_5ptt-Q&oe=6A8C2B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Legend Update 1 (1).png", "id": "999460746236829", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625099_999460749570162_8961214811947322669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4stZ2pWbSFEQ7kNvwEQ_ako&_nc_oc=Adojna_M_LZnhKyyeY3gmGvyQt65ais7ie7o2TtvSVeYg5hy_EAH9t4kREo6jdg2G30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkGFtG0uLE-HUhbKCeCiqLexdvSg0n4AdD9zHuIO8MEQ&oe=6A8C1459"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27689913830630974"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314643_913927397841519_2904095959100255188_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUATuCz_mYQQ7kNvwEg-M9a&_nc_oc=AdqMEqUw7_M7bFmXsdFqai_gysr_MnWvbILHrCL7ri_EPdqJd7OjFhW0V9hEE9fTAmY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNJ6xNjPO4PBAP1t0_dzYVyW4fSy7EeIcGvJHUy8RO8Q&oe=6A8C26AA"}, "is_concept":
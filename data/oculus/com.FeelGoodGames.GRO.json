Af_o7VWhL2ffFV2AG6BO73jsEsHKUEi5y6-vaiDo8ziDiBTddz3KXvwZPTMK8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRZLFNxTjaj-E-MFtqRM-lU3Y7CI9sXiHn1DC7MaqkEw&oe=6B09CE70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Trading cards UNC POV 6.png", "id": "1142347581735936", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624592_1142347585069269_3790813888476419541_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCU1lIqzWYgQ7kNvwH4kWYo&_nc_oc=Ado7nuPSVCenj_I3UdzhZ9ZbqL7M1z8YlasV7lcka2-WF7RgFUWqedBTryt467X8EfE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaSWv8QzAzJxQumSCM1Th1oufz2qfOlf8y3O9u5_8TkA&oe=6B09C07E"}, "display_name": "GRO", "keywords": ["Farming", "Garden", "Game", "trading", "Action"], "long_description": "                                                                                                                                                                       \n                                                    \nA gardening adventure. Trading, crafting, and celebrating! GRO's BIGGEST and most colourful update is here!\n\n{1961694904718240}\n# NEW TRADING CARDS!\nTrade Seeds, Fruits, Gear, Land, and MORE with your friends using the all-new Trading Table! Make safe trades and build your ultimate collection! NO TRADING TAX. NO TRADING LIMITS!\n# MAKE YOUR OWN PRISMATICS!\nComplete Overlord's NEW quests to collect coloured seeds! Use the Colour Fusionator to combine colours, unlock rarer seeds, and craft your very own RAINBOW PRISMATICS!\n{1471323561438861}\n# NEW SEED & LAND RECLAIMERS!\nTurn your favourite plants BACK into seeds with the NEW Seed Reclaimer!  Reclaim your land with the NEW Land Reclaimer too!\n\n# GRO TURNS 6 MONTHS OLD!\nIt's GRO's SIX-MONTH BIRTHDAY! Celebrate with your friends in GRO Valley, dress up in NEW birthday outfits, and claim the FREE Birthday Boy Skin!\n{2021170175493065}\n# GIVEAWAYS AND LIVE EVENTS\n
067936637_2780919046861405792_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2q7oamGmpoQ7kNvwFtrFdK&_nc_oc=AdqXLvTOgYVzkLC6tBgAsYqgE_M94E28lrxVqb9Dfk3W1MTTFgVuwnbRud-_nGz7aEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bmgYYQSX2rXZGnNpZXYEO9wDSctLj-RiGXklhMW6aWw&oe=69E38434"}, {"file_name": "FarmLandsPrefix_2026-01-15_12-00-49 1 (1) (1).png", "id": "1188548222985723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618937_1188548226319056_5032507899195499461_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS90t7tji4gQ7kNvwGU125i&_nc_oc=AdouMbLnIWCw45IiSDcNSy_KQyQW8IqweHLN3WbDIh_vjCSrnFNyTxBjWhxEoTg6ph0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ex0VRgo0dotb4CtOVkC5FKJlhsDYYPoCtdc37arRbbw&oe=69E36789"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GRO", "keywords": ["Farming", "VR"], "long_description": "Grow crazy plants by day. Things get wild at night! \n\nBecome a GRO BRO: https://discord.gg/gro\n\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n\n# May Update\nFeed, raise and mutate your pets. Ride them to adventures. Pets are coming. Get ready!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "com
3743938_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeisN945yXkQ7kNvwHjeg_n&_nc_oc=Adrbkwi4Y9vs3m9Fxa1ULarffH-CvbCLbrhmSySgHIC9WlmmMR6ASz9xNiAD-8Q3xZU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBYHfCWgVi3OpCEOWkJLB0Ih5R5903ecikqGTdnjS7Ew&oe=6AE34E33"}, {"file_name": "Untitled design (1).png", "id": "3040047473013419", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824292_3040047476346752_5882872056558016121_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHN6DNxBZWwQ7kNvwEQAc9U&_nc_oc=Adq5wXf9FskxYKJHNpFomvhHrWTG3oeyXt4q-FnWjjilorDae-i-fzai4L42XSBx5Og&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS5zDsxXBNmQQtrANvfk2_RqX9UNxkJDLFE0oARmJcCQ&oe=6AE355AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-TOT update 1 (1).png", "id": "2422562025157907", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593761155_2422562028491240_628118399765297251_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVWHa9MXVKcQ7kNvwF4nBKy&_nc_oc=AdqL6x6h8MsbtDE64Wa1BUPmNswzXf9NMGqCj6DVCex3Q4muph9AnmqzOCHQhikc2G4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_DhuDr9M2RpSs-mrlULI2VzK3SUOkQ_vF4e6RDl5mWA&oe=6AE3640E"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28713811658241181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499620316_1908663643828967_8959123619562773891_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=diu8PygvLj0Q7kNvwFz115S&_nc_oc=Adr2hO2yYwOdFZSXpboWk2f0CHlsmSHPPDpZLy6eAM_CcNxcn3Cpe2sWfkamUohIlvY&_nc_zt=3&_nc_ht=scontent-dfw5-3.ocu
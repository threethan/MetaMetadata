=9Z0G2G03tjQQ7kNvwGJiM0o&_nc_oc=Adqh7gSOfZ3Pze_k85G2UarbpLZ-vYQT-vGWcZvPkSec4KTcFkjTjWKZ6wTyU_2lksk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdRI-M9dVxQZiDFRBxj1MWXTZOIhMChsnl4_35OztTsg&oe=6AAA8E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Weather 3 update V1.png", "id": "1062836060076719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_1062836063410052_72115483006641327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ntv9Bt9nHEQ7kNvwF_wUom&_nc_oc=AdoNgn_BgMwErJM13o5ln0X8tmJqFwPyS_9OFt1zK59yJn9E6daB1bekkllCc5DOIm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqi3WAfR87_evqbsB7ub6_hKYApgtOwox3RLr21T3WSA&oe=6AAA8A76"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28046248914997462"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298219_1347427957376277_9103338611236468211_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM4fddMRUHEQ7kNvwGuruBv&_nc_oc=AdosR6llN_GxLNU3NeQ1o22Aux5EGDB0mIh6W7CIFR55p5aFW6PLEa8EcfoekIItIvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsQBjrsulMeNeFEVInPtgiNfLL27y6HiDBrRnuCNo89g&oe=6AAAB295"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GRO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Platformer", "id"
_sid=6e7a0a&_nc_ohc=6PP5vuQUcnsQ7kNvwFHQgzh&_nc_oc=Adq6XDfVFCENejp4DH6v8FVA-a9w9QHSaQ90P3tVK-CKaXXVpFLxTiMO-rBqgabcbDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHMw_Ktoy3JdDyBMdBTxbFyUMsYjYcOlnfuh7gLHfbnA&oe=6ABA601B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Mythic update copy 3.png", "id": "1061885550016486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/596149727_1061885553349819_8216196882186278698_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjgD3EqjPtQQ7kNvwFN_pSw&_nc_oc=AdrjF1c2ssSGkYjlKjZ1CjlTZLyQdZDGUkb49zalRSr9J72542HbY0JtI_SczEhbPbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLL-2pY958MDkNiyCve3z6FYPfOhMclA5pdCGyvKgLXw&oe=6ABA78B3"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/g
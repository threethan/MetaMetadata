3802_1046534931658158_7039624075886012563_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D72seqZQukQ7kNvwH-d0tJ&_nc_oc=AdrWQiySs0J3JFfBbniqK_vpvOjoez4gxyYlZiKgN8efV4p31ER_4z7HIJ2XaT_gpiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWzQu5hosqEPRq3lIHzVscgpp_MHlC6iRCy-u1c43fAQ&oe=6A7B0A8A"}, {"file_name": "GroPrefix_2026-07-10_20-50-09.png", "id": "1040454018535253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311582_1040454021868586_1509315833334757030_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n-xsISBJhsQ7kNvwHDH-h7&_nc_oc=AdqKBQiMkWjyQwhDwHEfcV94VdkZ3kHRYjtKTCQS5JoCyR3-Ksjkw7ju3eC0bok6GwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTp7tr-M51qGyj2s0mrdC2Jy77WtBEoktUGnwor0ubvg&oe=6A7B07E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Legend Update 1 (1).png", "id": "999460746236829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_999460749570162_8961214811947322669_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_3oopDcLdEQ7kNvwGydEq1&_nc_oc=AdrHnAvHrZqjORRF2Z5BI7uclaH8Xdw4AuJS6qKKXoO6Ns7NxAFlEe6ZSnnHMdW-KVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzqWEqkG3Mn8uw7ewkIVhNmeh4eV58bN_uzSv_EoQYaw&oe=6A7B2919"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27617948197827538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622214_4811645545772889_4232207578284481587_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_C4HxLMeF8Q7kNvwESFh6V&_nc_oc=AdqHAt6_yru87j1qcZq1uHY6yzbRLRobtBJrstA-tZ758LiWhrrRcXJf-61zT75M1mI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsJHiHLwnInU-hkIwy6q0BbtyN-g2Ed_5NsBbXgyVN0A&oe=6A7
a0a&_nc_ohc=6s-krtoHgQUQ7kNvwHf1Wqq&_nc_oc=Ador_MHLFFB6k7FS30bWZVfqYvzyJ6zLomJiLIiqY8llflQ8Oc3SNX3caggRa5IYmxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BhzAScduPd3GC3I8-vNsFm7Sv8WOPs2rl08e2OZffag&oe=6A3169B9"}, {"file_name": "resized-Media (2).png", "id": "1137390485230685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314623_1137390488564018_6456471858667287533_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4wXGGOMUYkQ7kNvwFGia6G&_nc_oc=Adr3Wr7PUvC0cCUmEagARtfGiqLd6lXE-I_yZaCitz_6A-9ydFxfI-Ftv19RBaRSVEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9TAR1wUX4RVX4fZJoS89drbVXCgVB5kOe14jUD63iAQ&oe=6A317087"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRO-Big Plant Update- Trailer cover.png", "id": "4242528682559465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623345_4242528685892798_4603113305594431283_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzwVldPm0zgQ7kNvwHo0EHn&_nc_oc=AdoMqTcboeE0METX0-UG9nTM3iH7YH8zBTmAieKF4aQRcK8D2GFwjcsz-pvfBMfBLss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gMrgwfK5GEyITzjuoyTXYu1GPNlHf6BslQHeFR-MK9g&oe=6A317846"}, "display_name": "GRO", "keywords": ["Farming", "VR", "GAG", "Garden", "Game"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \nBecome a **GRO BRO: https://discord.gg/gro**\n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26806754732280226"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620921_971375882169629_5665720629249153247_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OqMlA35OcMQ7kNvwF0rOWI&_nc_oc=AdpuoRcvl_Yh_fu_fism_pUPhrHnyJS29V36Qybbs49cUJiZpd7vgg-vo7gxn4T844c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bEpocrGO5DxgUV3CqugYbv8sTFnsgy1oy9wPApbHrhw&oe=6A31663A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
c=KQDw2tqu-3MQ7kNvwFH6Xq_&_nc_oc=AdqtVp41jU1kcU1iMnNury0l6WxJ0IQOi61DFG7hMjY2Fbe2OhDj6v3Fml9zsg4rrOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6gsAkmNrT5_QT58wLzS6N4rWCb1wosiQn2AfAlHHwNA&oe=6A9C0D9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Weather update V1 2.png", "id": "1380131273619709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831569_1380131276953042_3594764104356897650_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pE5_7UQ9xeAQ7kNvwG8ItvW&_nc_oc=AdqHumiRU7wURf2NO6STrW9Szqcv6OpLaHDy0PyJJiPW7ZytYw0cSLVFf1-DiOVSemU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvanN4H5eFnKXWQoDIh1CdMxK5sfOrgF27_rqvy3LheA&oe=6A9C2A20"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27767710579517965"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/673531334_849396591562005_196965291820141392_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zULp_32axtsQ7kNvwHh17pz&_nc_oc=AdpvytMHyuaN9RdAz_mzA4Rgq3ciFh9PnT7JxRk69ArLV4HBTKqgUiWQMtbzUWG1VRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYxq4ByOInSxND6Y1PfGpLJuDxY7l9I4cL2LSmwsYphg&oe=6A9C30CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GRO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Platformer", "id
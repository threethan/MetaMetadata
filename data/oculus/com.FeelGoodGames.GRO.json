nc_sid=6e7a0a&_nc_ohc=iB8HTnqaa6sQ7kNvwG17Oa9&_nc_oc=AdoAEp8Hww-jmFzxxBPR48LIvPSvPxHSegzLhCarh8lVbMDPwOQ1LF9yiAeQckrpM50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFKa_3Ufu-rLAmzpcnMvqJJPpOdfn78gCQLtBKuPnSOw&oe=6A61FE0A"}, {"file_name": "GroPrefix_2026-07-10_20-50-09.png", "id": "1040454018535253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311582_1040454021868586_1509315833334757030_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8htQ6l5RmckQ7kNvwEyOUQy&_nc_oc=Adog0zIa2Fnzp-965QYnBoIcmRjG0eytXulWY-g6zwb3-mqFPq27T2yVLwh2QkNL3kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaxt2zwiwPcH5W_b3HkzuBXe9aOHQkgmyZrFolJLTZ8g&oe=6A6233A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HS-update-Landscape V2 1.png", "id": "2070660527189551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593862973_2070660530522884_6974024446655082485_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88x279Q77l8Q7kNvwEw8a6W&_nc_oc=Ado0zyy0EdhkvtLvFGyS-FaGL6FBD0AszjP4ttxyd0TNXZ9MVUu3OA5oMfSESpOin1g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVHHRGViDJtRWs0q79hqJK8DbSzGFPlycKzfB72fPZtQ&oe=6A620BE1"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nGrow crazy plants by day. Things get wild at night!                  \n\n{1961694904718240}\n# Magical Seeds\nPlant. Grow. Harvest. Turn tiny seeds into wild, oversized, mutated fruits.\n\n# Mutations\nRainbow. Sun-kissed. Tornado, Acid rain. Weather mutates your plants into rare, powerful versions. Stack those mutations!\n{1471323561438861}\n# Plants vs Jeremys\nAt night, defensive plants protect your garden. Whack wild jeremys with your friends. Beware of BLOOD MOON.\n\n\n# Garden Gear\nWatering can, sprinklers, fruit basket, OG costumes, gloves, hats, shovel. Everything you need to build your dream garden.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/gro**\n", "short_description": "Plant, Harvest, GRO-w!\n\nA fantasy farming sandbox, where cozy farming meets multiplayer chaos!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://grogame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AutoVrse", "support_website_url": null, "website_url": "https://grogame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27442617135360646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314659_1026444880376869_5864812575550151762_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5LYjOt_w7kQ7kNvwG9x4Rm&_nc_oc=Adrt0CT3jueHYQc64u_a0PFXn9dNWFMjLiPFtHtsvhHSqfvaGoV-Hux619RVJCNJ4Z0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL4GatoMRhRqE5cUEeaXCsrQlEa8gqyYcAgcKE8ZsqWw&oe=6A623039"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
_sid=6e7a0a&_nc_ohc=6PP5vuQUcnsQ7kNvwF07P4b&_nc_oc=AdqfbgDezhidtilxyvItmG908Kpi4-nA8qInfvAWSMtbB89jW_-AuxktQgEbi8CdWqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmHkYeLOOYD6I5khc4mAqJ7VyzDt6EUf_gKXCigv9Dhg&oe=6AB7BD1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape cover-Mythic update copy 3.png", "id": "1061885550016486", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_1061885553349819_8216196882186278698_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjgD3EqjPtQQ7kNvwFXGvI-&_nc_oc=AdqzK9i-tNd0X3FXR1wu8kGMMiODnxw2rd-E_WMseBn0oYH1kbFmwm4BNadSNNjApVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnYme6y69Imjq2h-ZjmHzlQsOxDJGyzgf_fUWdPQvxPg&oe=6AB7D5B3"}, "display_name": "GRO", "keywords": ["Farming", "GAG", "Garden", "Game", "VR"], "long_description": "                                                                                                                                                                       \n                                                    \n\n\nA farming adventure with GTAG movement. Celebrating 3 months of launch!\n{1961694904718240}\n# GRIND or RISK?\nComplete Harvests of the Day for ez money, OR risk EVERYTHING in Double or Nothing.\n# LIVE EVENTS AND EXCLUSIVE REWARD \nClaim free Welcome Rewards when you first open this update. Join live event Feed the Pond to earn the rarest seeds in the game - **Dollaranana**.\n{1471323561438861}\n# BUILD BUFFED GARDENS\nPlant magical seeds and harvest gigantic fruits. Mutate your crops with rare weathers like Aurora, Solar Flare, Fireworks. Now you can move plants with TROWEL!\n\n# BRAND NEW SKINS AND CURRENCY\nWe added cool new wardrobe with fresh skins and lots of customisations. Get all Fruit Friends skins for the ultimate collection.\n{2021170175493065}\n# Pets Coming Soon\nMagical creatures that help your garden to get mutations, grow bigger plants!\n\nBecome a **GRO BRO: https://discord.gg/g
n.com/v/t64.5771-25/39035388_679365562824250_1728730018881732608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7TcV6ekZLQQ7kNvwFaNU6f&_nc_oc=AdpQgThcAdQIKTQh3iZG-OC7JsrF2aJZdympAe4zA2OJWVMikK4Uz60lOOBJWFuPktw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYszmD7kZR54_iQPg9TMPLcV3c-loZ83RlpzJyfMs-eA&oe=6AAD5CA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/V03VGs", "id": "1674234966058474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221316_1674234969391807_3739995600813293568_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLJPP3GeHD0Q7kNvwEgGRvp&_nc_oc=AdoFuGB3ptZtx5z5L7G0yPbPxjyFwRJAHSKAqe-7913pzVxZk-q7oN9RawxjDVCGaNk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiWqhmfg9OimzuZp8We23IObw7R7Odm9I3uLh9Dxfdtw&oe=6AAD49B9"}, "display_name": "Jurassic World", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty
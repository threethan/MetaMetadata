cdn.com&oh=00_AfuVHBn_G9z9o9MBt17jFf4VgvW9trqiRTnsur6ep1CMqQ&oe=69A1AC73"}, {"file_name": "8Vnmoq.png", "id": "679365559490917", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035388_679365562824250_1728730018881732608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooR3Jau4k7oQ7kNvwEx4UdZ&_nc_oc=Adl-oyrgs_7Iled6O9Vr2j54A2b87w_gRB8tHMJRMA9qf5qA-79I1O0F0t-MZ5-zLoA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsCMH7qYR55_75YjvC60BaukR2hde5crAj9zHaeInxchA&oe=69A183E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75221316_1674234969391807_3739995600813293568_n(1).png", "id": "673694678060282", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035405_673694681393615_2026936782994030018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3thlJH6tkJIQ7kNvwF0dl6B&_nc_oc=Adm34Vry_10JpY4gerIYic4Wye1UZmuyxeBRej71mcUvESbmzPurKQndkhDz3gBy3Ys&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfscEQIjhFURKgCVrpriGa8FWpIl9j32l6Xh2tBDEteLfw&oe=69A1A5D9"}, "display_name": "Jurassic World", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nIn Jurassic World: Blue\nFollow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7339709686095293"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974635_551744045615125_2877354876860366848_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STCnt3KzxB0Q7kNvwEeHQsK&_nc_oc=AdmJFPUUNLpgmi1Ffy-2LANSHDeNHNDMCZX8c8OIUSfyEeDpvgv_Zh2QE3MBGhBWzH0&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftgPMaYlwDZagmGAXxJE87QrKCOvyJ8RLnr__52Fi9Wzg&oe=69A183D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jurassic World", "platform": "ANDROID_6DOF", "context_category": {"context
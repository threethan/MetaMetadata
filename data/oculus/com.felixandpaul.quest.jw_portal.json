-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu2lRk6hUPkF7UElpyp3R2KkCfHgj_R74Bt89H9rm78w&oe=6AFB4979"}, {"file_name": "8VSUoV.png", "id": "166031337993382", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982618_166031341326715_6239646659911876608_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAB06OKX4ToQ7kNvwFQ7jcd&_nc_oc=AdrkJw1TQJCPbtbMH4LBLuXmiv2dCsCvNotbibg3nMdzZA-8OcMRZ8b6Oxppy7nG-qg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5IfW7L807yHpY7ZMUCPmt8BKFSwtfxqr4E8UeICWKaw&oe=6AFB4DB3"}, {"file_name": "8Vnmoq.png", "id": "679365559490917", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035388_679365562824250_1728730018881732608_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dt4tQgsncl0Q7kNvwGiNf8s&_nc_oc=AdquDJAVQugF0s7HxS1btoX7F4lxxzoNlNYvqguPnV-9W8g23hDtI9m4anmw-AiNjxw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBXSegCZ8wb5U-FjwpykNwWalN9p_yOJMXO_XYp5OdlA&oe=6AFB2520"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/V03VGs", "id": "1674234966058474", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75221316_1674234969391807_3739995600813293568_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFzS-ahDO_0Q7kNvwHJ0r8-&_nc_oc=Adpu_Ibjn0RWpRNPKk920JDSeLC-uViniypuLs5vuw9G0vHtVJX1pb1QoGHpAtNxK2E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBf-PjeCIHvbCVOgAMT579z_TwID4bAI3uXbVKM1j2Qw&oe=6AFB4A79"}, "display_name": "Jurassic World", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nIn Jurassic World: Blue\nFollow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "https://www.felixandpaul.com/privacy", "developer_terms_of_service_url": "https://www.felixandpaul.com/license", "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MOVIE", "NARRATIVE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "309316601251336"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status":
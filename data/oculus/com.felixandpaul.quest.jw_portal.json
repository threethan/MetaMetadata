n.com/v/t64.5771-25/39035388_679365562824250_1728730018881732608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqwRuq5Rh7wQ7kNvwGjTVWI&_nc_oc=Adro3kjPu5pnoeRErwDApFZR0cBLSuejmDIU5Iklki9MftRihOKqq9QympauBJceUTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJy6MeSA8-7ufyi2zLL3r4gyXrbrvrap8faGQ0yGzj7w&oe=6AEA01A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/V03VGs", "id": "1674234966058474", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221316_1674234969391807_3739995600813293568_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKHpzn2zINYQ7kNvwGSbCvT&_nc_oc=Adowpk0ew6c7hBUSDmfYX184rE4Gv2U5_yH4D60EydNshETTEBPqWH_SItsIJeIZmY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzBxJRjIxWB1mruknldbzdChd-UP42NVC43L5HKJX2ww&oe=6AE9EEB9"}, "display_name": "Jurassic World", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty
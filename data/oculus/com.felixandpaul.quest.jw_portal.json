0NnUQ7kNvwGWwcOm&_nc_oc=AdqoX67D9b0T7MqzVF7U_McwGrz5xR_o-wFBWB8RFwaNiosf8u84FCMSMad1u0-6LLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJeKAciuMUDv2z9o_VO-GplZq1jGOtCCt0IdbK5TzCJQ&oe=6A9834F3"}, {"file_name": "8Vnmoq.png", "id": "679365559490917", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035388_679365562824250_1728730018881732608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3L3zDjp7wsQ7kNvwGOWz1u&_nc_oc=AdppJJwM3IhD3l0oQfp2Oeakh4wohtN4Qm87P0x5UgHEZ62zw3m7i8l5YlkxGXJ2Dlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP77BYIPwQGfqZcWuns6QkG757LW1oBHvcQ5FkQF501Q&oe=6A9844A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75221316_1674234969391807_3739995600813293568_n(1).png", "id": "673694678060282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035405_673694681393615_2026936782994030018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjpv9Gdq-mAQ7kNvwFOBD7P&_nc_oc=AdqHAAwEyCDY3i7HM4z16vh54VFj0XjeAB7D-_TkyJIE-6j4gFng3VynbuWDoE--Op8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINijPbZSO1DR8mfRNKLK6oJmKUVNrfrDnec3g-H7bTng&oe=6A986699"}, "display_name": "Jurassic World", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nIn Jurassic World: Blue\nFollow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness."}]}, "developer_name": "Felix & Paul Studios", "developer_privacy_policy_url": "http://privacy.felixandpaul.com/", "developer_terms_of_service_url": null, "publisher_name": "Felix & Paul Studios", "support_website_url": null, "website_url": "https://www.felixandpaul.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7339709686095293"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974635_551744045615125_2877354876860366848_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45zlwKQMGU0Q7kNvwFx9X-o&_nc_oc=AdpNDrv32vpyUKyILu0r6MH6PYF0jDGBOCpvpXCN38uXfxaPuxdw3SOuzF7QDIGaKFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1toC6ueTz8C0O-dsrhuKlA3mjJEyDxmPhvZiZv
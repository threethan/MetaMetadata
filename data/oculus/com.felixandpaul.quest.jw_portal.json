n.com/v/t64.5771-25/39035388_679365562824250_1728730018881732608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6TTvhSILAcQ7kNvwG9XADg&_nc_oc=AdqoqNB7-tGlGkgobYUl17lMr59r-qzrEkGCtqXnwViNyb3TrIuxtgIK0Lsgi0-SkAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28eIm684xqDjwwgHxxoyTW6blSXf0Dis0TKVx3bhapYA&oe=69E0CBE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/V03VGs", "id": "1674234966058474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221316_1674234969391807_3739995600813293568_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unS2iMm-chcQ7kNvwHHrjjC&_nc_oc=AdpgGYHf8Imk7O6httI6hpdLJTiZYhixw0ze2SZD0QGEA4jLF-u3JxyTyycptW0HcWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af134Ca36DOqVcBn6jk0qKQVpYktrhuhyVLSeozSSjyBGg&oe=69E0F139"}, "display_name": "Jurassic World", "keywords": ["Jurassic", "Park", "Felix", "Apatosaurus", "Dinosaur"], "long_description": "Jurassic World: Apatosaurus \nThe Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty and danger that this implies.\n\nJurassic World: BLUE \nDinosaurs have overtaken the turbulent Isla Nublar, but the threat of a natural disaster erupting looms eerily over the island. Follow Blue, a highly intelligent Velociraptor, on her quest for survival, using VR to experience her extraordinary sensorial abilities and awareness as she scours for food and water, searches for signs of life, and fights against some of the island\u2019s most threatening predators.", "short_description": "The Jurassic World: Apatosaurus VR Experience allows the viewer for the first time to see what it feels like to be in the presence and close proximity of a living dinosaur and to experience a sense of connection with it - with the mixture of awe, striking beauty
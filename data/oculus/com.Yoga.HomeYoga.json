972530405793911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBHPlaTl75sQ7kNvwGBBuQq&_nc_oc=AdqtmIHf0ziywvHGTrwPL3bQmFBurihgLpgz50HVJ2HC59EhSRPf4bRe9hOwvp9JxMU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xJHuIj3fBb-LsEkiObvXCtNYwIO2SFXoe6AbXfmsPFQ&oe=6A11ADC1"}, {"file_name": "2560 1440 2.png", "id": "978778626302649", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/65229100_978778629635982_8206066722209702613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTyT8dv-l5wQ7kNvwHtXmnz&_nc_oc=AdoJYJI_F3-thzwAUWW8FXq2qvhj2Hx3a2abwRM66Nj9MJByKejq1Sswq721RWOW4fA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ddRM11MmMIYXe439NWvimGgUXTEvuYyHgICOgkBLAaw&oe=6A11CFB3"}, {"file_name": "2560 1440 5.png", "id": "848537126035131", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982460_848537129368464_7830301461152454379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKXgQ1LHe-0Q7kNvwFOMvaS&_nc_oc=AdqKZH8VINFJgk7Qr3HnOPORJsmT_qEihOqKZqaC2rjrp3F1mEeMzMp_Ia5nUQdCZfA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b5QJUhUYYJTWfTLP9Mai04kZiFAQ_ae0dBM5Pe7SCZA&oe=6A11AEF0"}, {"file_name": "2560 1440 1.png", "id": "240961151316723", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974711_240961154650056_7897661354730702399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLPgDCCk9QoQ7kNvwGVEZqV&_nc_oc=AdpZMzpgaO5shZeg8OVhe7r9M1a1NCSilmLMyD8W7CR36jgJ2xqKIzOBNSD0vimrz48&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LK9X-c3U-UxXxaEhcD9m4GQZnOgAA6RYRCHcExsGl3g&oe=6A11B3B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440 1.png", "id": "601445537814753", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974873_601445541148086_5828305710488420632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OXxg5XgjbgQ7kNvwEmVscX&_nc_oc=Adrst9DtcAve1g0wNC5wnXPYfQNhTj-V6DfqEKitr6pF36vlvI3e8sSEKP58Y8_V5o8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71gr6-D6uHUFW_iEiIt2s40ezhFNBleYYte-An3Ssyrg&oe=6A11AB94"}, "display_name": "Home Yoga", "keywords": [], "long_description": "1. Suggest you use Quest2 headset. Quest still can work. \n2. Make sure you are in a place with no objects close to you!  It requires a playspace of at least 6'6''x4'11'' (2x1.5m).\n3. We have teachers team who teach people Yoga for almost 8+ years. Our courses we\u2019ve built is suitable for everyone, both beginners and those already on the yoga path.\n4. Everyone is busy.Getting motivated to go to the gym was always hard for most people. Compare to the long way drive to gym and back,and also bring a lot of things,only 10mins everyday in your spare time, you can finish.\n5. Now there are 101 Yoga workouts in it. Update time and time with new courses.You can use it for a long time.\n6.Please e-mail us if you have any suggestion or cooperation idea. \ne-mail: 408077086@qq.com\n\nUpdated 2023/04/05\n", "short_description": "Do Yoga at anywhere,any time with your Quest headset. Professional Yoga teachers who had 8+ years teaching experiences, both from beginer to higher level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cqplanb.com/ccc/Home_Yoga_VR.txt", "developer_terms_of_service_url": null, "publisher_name": "jijia", "support_website_url": null, "website_url": "http://www.cqplanb.com/ccc/Home_Yoga_info.txt", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EDUCATIONAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
uK--B3SYJtmiPd1NSkN4TO5FfzDlIzPr5TTXDhup-4Q3ZDCFw92vKfsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0TxlrTcU5ycDv-1gXzcXTpgjsg_G81OzEuoFdNh51OXw&oe=69F0B841"}, {"file_name": "2560 1440 2.png", "id": "978778626302649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65229100_978778629635982_8206066722209702613_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZavIXRyN-boQ7kNvwEHn6tH&_nc_oc=AdqYqM95XdgZ4iBXBJ00Uus64LpZCl-W4PvYOBnv-kpwEX6zM_nFpQJurS7KA1Tt0jI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1bf9pKck4x7f756K2ZqkR1un9YpdptPIAwNfXypkWr5A&oe=69F0A1F3"}, {"file_name": "2560 1440 5.png", "id": "848537126035131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982460_848537129368464_7830301461152454379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBtVlNvinGQQ7kNvwFPdjjL&_nc_oc=AdpRBEei4fSSzoMw3TQd7qJXn22hrLPrgIF6EdN-w5dRt6jn3jglbcg1RdxiZ69P6-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3cJaIPGFyGq2cQdDSA3UtUwSZHvdd5RdP4weqNqP9JtA&oe=69F0B970"}, {"file_name": "2560 1440 1.png", "id": "240961151316723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_240961154650056_7897661354730702399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L326pcSlYvwQ7kNvwGLIaPj&_nc_oc=Adp_0MjmIeSKYO0oyhsuJ9JnTw2uoDi78gV65xr_wuSTi8g64UiIhcuPdNodW7SlEjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1LvAhIKZxbfdsffWCForSgpCsAZBcgvSuV8kjVlMVddw&oe=69F0BE33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440 1.png", "id": "601445537814753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_601445541148086_5828305710488420632_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX7JYuTZ7ZUQ7kNvwG8lwSN&_nc_oc=AdpyRIrcwK-JLdQs6uvFCV_6FyMn_SKDGQnJ6XCau7Sq0CXIOVcQRQZ02mvw-C3fEak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0tCXWZzpWrlZIfeD0Avk2yWHJORY6SXw9gfK54nD6OXA&oe=69F0B614"}, "display_name": "Home Yoga", "keywords": [], "long_description": "1. Suggest you use Quest2 headset. Quest still can work. \n2. Make sure you are in a place with no objects close to you!  It requires a playspace of at least 6'6''x4'11'' (2x1.5m).\n3. We have teachers team who teach people Yoga for almost 8+ years. Our courses we\u2019ve built is suitable for everyone, both beginners and those already on the yoga path.\n4. Everyone is busy.Getting motivated to go to the gym was always hard for most people. Compare to the long way drive to gym and back,and also bring a lot of things,only 10mins everyday in your spare time, you can finish.\n5. Now there are 101 Yoga workouts in it. Update time and time with new courses.You can use it for a long time.\n6.Please e-mail us if you have any suggestion or cooperation idea. \ne-mail: 408077086@qq.com\n\nUpdated 2023/04/05\n", "short_description": "Do Yoga at anywhere,any time with your Quest headset. Professional Yoga teachers who had 8+ years teaching experiences, both from beginer to higher level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cqplanb.com/ccc/Home_Yoga_VR.txt", "developer_terms_of_service_url": null, "publisher_name": "jijia", "support_website_url": null, "website_url": "http://www.cqplanb.com/ccc/Home_Yoga_info.txt", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EDUCATIONAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1289984098279593"}, "review_messages": []}]}, "c
ontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwK9jxErxxPTRNWqxrmTUWwKZOWJax-EiL6EdGB5ERIQw&oe=69AACF87"}, {"file_name": "4_Image Sequence_003_7650.png", "id": "1716135922348746", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619173_1716135925682079_5546157533667020174_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5kbIDah7lAQ7kNvwEvLDw0&_nc_oc=AdkAExR5e13HjU-uIonaq6z1G1vujuAigv2tjFk8SdVXKLtHCv-VOlir4FKAxUi6dEM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKku5iOSF9yE9a9KV7qzjNsNvTDNYqfkdgUPs403UhRQ&oe=69AAB147"}, {"file_name": "5_Image Sequence_003_8213.png", "id": "564594866377032", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499297203_564594869710365_2797286100121791017_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_hjDVcAkeEQ7kNvwE9GQ-t&_nc_oc=Adlm9HrvGa5DaEV_o4_ALJt0rPnSCFUJTrRpWAEWmtchpF5sIDKw4AXpyzAaH4hwnTE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVpFY27uRocq-htmIQFnEKzKhKghKYB6tsF4IR4hkMfA&oe=69AAAFFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DAZ_PV_DEMOver\u30b5\u30e0\u30cd_250527.png", "id": "976358554388239", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499299976_976358557721572_5260631163909839926_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHSBBMAE1S4Q7kNvwGvfXFu&_nc_oc=AdkR6OaZm-ObHMaGu9dHEkaOWkVGjHJ7KSGw6A5EW1xlqrXlusOEWxOfKeapNf6VPoI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxR2vgnAOGTU-Z1AUClCHh-FqgODH-9A_scPa9RDTt2zQ&oe=69AAC134"}, "display_name": "Dada Zubaaan: The 360\u00b0 Puzzle Game Demo", "keywords": ["puzzle", "casual", "logic", "handtracking", "connect"], "long_description": "# Move the Panels, Make Paths, and Master Dada Zubaaan!\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and land a perfect score?\n\nWhy You'll Be Hooked:\n\nSATISFYING CONNECTIONS: There's nothing like the rush of seeing your planned pathway za-za-zap into place. Sometimes the most unexpected, winding route leads to the biggest score!\n\nIMMERSIVE EXPERIENCE: Feel the beat intensify as your pathway grows longer. Watch as snap-crackling light and sound effects sync up, and the world around you transforms. It's a feast for your senses that will keep your adrenaline pumping!\n\nMAXIMUM PLAYABILITY: With super simple one-handed, one-button controls, Dada Zubaaan is incredibly easy to pick up and play. Whether you're a seasoned gamer or new to VR, you'll be laying down circuits and chasing high scores in no time.\n\nZa-za-zap your way to the next level with the ultimate play: Dada Zubaaan!", "short_description": "Move the Panels, Make Paths, and Master Dada Zubaaan!\n\nIn this electrifying VR slide puzzle game, you arrange mix-and-match panels into a juiced-up pathway from start to finish! As the circuits grow longer and longer, your score will surge\u2014just watch out for the time limit! Think you can slide together the perfect route and land a perfect score?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dadazubaaan.aidis-games.com/privacy_policy.html", "developer_terms_of_service_url": "https://dadazubaaan.aidis-games.com/service_terms_of_use.html", "publisher_name": "AIDIS Inc", "support_website_url": null, "website_url": "https://www.aidis.co.jp/en/games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
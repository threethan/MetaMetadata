g", "id": "971105628913093", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823790_971105635579759_6342604012799198294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCdw9KTNIVkQ7kNvwG5q6on&_nc_oc=Adpd-CF0wM4bhBuAZeZXqh4IhH46oBAYNz6csz-nhpt6gZuyjM1lYjWoOxs7fnB_BX8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb9MpKn-JnvCzkGDlnL65WfYVJPXUhiECtrE2000numg&oe=6A8D9CCB"}, {"file_name": "HS_Meta_Screenshot_2.png", "id": "950405314327712", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821702_950405317661045_1285113534900034383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn3QtIo2NykQ7kNvwEjrY8Z&_nc_oc=AdqrI3PLk9INzGMBXzmUyWVg7lY0OoqEFeZ53CwRZQhhSJC-Cfhq_SaJVv_fU8dKNPs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw8Zc-jg5XhvH6oWtvZf0GwHiFG75z8oB7c9ed67QF3A&oe=6A8D7487"}, {"file_name": "HS_Meta_Screenshot_3.png", "id": "967222979046853", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822307_967222992380185_2412298261316371182_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhmcpghONOwQ7kNvwG8pBPZ&_nc_oc=Adpj1ID9CMxg42LBJYBbnnMj0WcH9xvAebPFoi3cgOzbik7SNdQGbEV-ErXarque2RM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiIapzzGihagApv8HRl6VZYONPOzlJqaS9kbNRjxulOQ&oe=6A8D98D8"}, {"file_name": "HS_Meta_Screenshot_4.png", "id": "1642232730237606", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827567_1642232733570939_6617264650106370933_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51sgbCmwCucQ7kNvwFmY4jP&_nc_oc=Adr_O3sH1at6lgkoljkLOfd1wTNzSo2PlYc9W8tFGxt47nQ4EhuamqwMs_LEJ_lSEjU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB-v0IYUD2Fo3pKnxhIyscgH7QUirwmtMC4Rw4V-cn8Q&oe=6A8D7A70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1650709842607147", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825470_1650709845940480_1831060348982030349_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo2V9XmaEj8Q7kNvwGVEjJ4&_nc_oc=AdoZhxZpYiHv8SkBUddZWXgH9LXDdjRKAXj3aRieX-u1lVKc7V77NvYmae90WgW_Q9k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8EGN0y5duj_zGxSGq93ue_3YKSuQcE7JrFXbD-YSF9w&oe=6A8D6F98"}, "display_name": "Highstreet: Calamity", "keywords": ["Roguelike", "Multiplayer", "Classes", "Brawler", "Cooperative"], "long_description": "Highstreet: Calamity \u2013 VR Roguelike Arena Combat in a Manic Metaverse\n\nProtect the FOMO DUCKS! Highstreet: Calamity is a fast-paced, class-based VR roguelike brawler set in Solera, a chaotic world where talking ducks run businesses, pelicans have strong opinions, and monster portals are \u201cjust an average Tuesday.\u201d\n\nIn Highstreet City\u2019s Central Gardens, reality is unraveling. Portals in The Greenhouse unleash bizarre enemies\u2014from rampaging robots to malicious mushrooms. It\u2019s up to you and your squad to fight back.\n\nChoose your class, grab your gear, and jump into solo or co-op VR combat. Face procedurally generated waves, wild bosses, and endless chaos. Build combos, evolve your skills, and define your play style with multiple classes.\n\nFeatures:\n\n\u2022 Hands-on VR roguelike combat\n\n\u2022 Deep progression with gear upgrades and branching skill paths\n\n\u2022 Solo or co-op multiplayer\n\n\u2022 Waves of unpredictable enemies, bosses, and monster mayhem\n\n\u2022 Social lobby with friends and fun\n\n\u2022 Rich lore and a vibrant metaverse-MMO world\n\nHighstreet: Calamity is your first step into Solera, full of adventure, commerce, mystery, and quirky characters (including Benjamin the duck). Frequent updates keep the chaos fresh.\n\nPick a class. Smash the chaos. Save the ducks.", "short_description": "Come join us in this Early Access VR Roguelike combat extravaganza! Feel free to stand, or sit! But it\u2019s time to FIGHT! For glory! For grandeur! For the safety and protection of a species of talking ducks! (Yes really, don\u2019t ask questions.) Be the Adventurer you were born to be! Team up with three friends, or three random folks you just picked up, like stray cats! Or solo it out like the anime hero you dreamed to be. Regardless, come join us and have some tea in the lobby while you wait."}]}, "developer_name": "Highstreet", "developer_privacy_policy_url": "https://highstreet-world.github.io/Gladiator/", "developer_terms_of_service_url": null, "publisher_name": "Highstreet", "support_website_url": null, "website_url": "https://www.highstreet.market/game", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26361175066835202"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1498158731905117"}]}, "baseline_offer": {"id": "1498158731905117"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776258000, "status": "PUBLISHED", "id": "1498158731905117"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26679995244953181", "version": "0.1.528"}, "id": "636534378813967", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"
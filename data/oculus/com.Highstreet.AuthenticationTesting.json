2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNkb1bucd7sZF1btdKTiVkoTGcTUsBdMW8mwNLBsKUWQ&oe=6B006530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1650709842607147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825470_1650709845940480_1831060348982030349_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIWwPb2KsccQ7kNvwGiJ8It&_nc_oc=Ado6fFBPJkP3AQOGSxgJF58fuxZXSY2zDG0mdoLE0lsaGTg_FiCErLAgNHCBzwU13lo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZX_R5_gwOpbywa11t9rwD9tJZieBNZG8p-b471gypKA&oe=6B005A58"}, "display_name": "Highstreet: Calamity", "keywords": ["Roguelike", "Multiplayer", "Classes", "Brawler", "Cooperative"], "long_description": "Highstreet: Calamity \u2013 VR Roguelike Arena Combat in a Manic Metaverse\n\nProtect the FOMO DUCKS! Highstreet: Calamity is a fast-paced, class-based VR roguelike brawler set in Solera, a chaotic world where talking ducks run businesses, pelicans have strong opinions, and monster portals are \u201cjust an average Tuesday.\u201d\n\nIn Highstreet City\u2019s Central Gardens, reality is unraveling. Portals in The Greenhouse unleash bizarre enemies\u2014from rampaging robots to malicious mushrooms. It\u2019s up to you and your squad to fight back.\n\nChoose your class, grab your gear, and jump into solo or co-op VR combat. Face procedurally generated waves, wild bosses, and endless chaos. Build combos, evolve your skills, and define your play style with multiple classes.\n\nFeatures:\n\n\u2022 Hands-on VR roguelike combat\n\n\u2022 Deep progression with gear upgrades and branching skill paths\n\n\u2022 Solo or co-op multiplayer\n\n\u2022 Waves of unpredictable enemies, bosses, and monster mayhem\n\n\u2022 Social lobby with friends and fun\n\n\u2022 Rich lore and a vibrant metaverse-MMO world\n\nHighstreet: Calamity is your first step into Solera, full of adventure, commerce, mystery, and quirky characters (including Benjamin the duck). Frequent updates keep the chaos fresh.\n\nPick a class. Smash the chaos. Save the ducks.", "short_description": "Come join us in this Early Access VR Roguelike combat extravaganza! Feel free to stand, or sit! But it\u2019s time to FIGHT! For glory! For grandeur! For the safety and protection of a species of talking ducks! (Yes really, don\u2019t ask questions.) Be the Adventurer you were born to be! Team up with three friends, or three random folks you just picked up, like stray cats! Or solo it out like the anime hero you dreamed to be. Regardless, come join us and have some tea in the lobby while you wait."}]}, "developer_name": "Highstreet", "developer_privacy_policy_url": "https://highstreet-world.github.io/Gladiator/", "developer_terms_of_service_url": null, "publisher_name": "Highstreet", "support_website_url": null, "website_url": "https://www.highstreet.market/game", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26361175066835202"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1498158731905117"}]}, "baseline_offer": {"id": "1498158731905117"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776258000, "status": "PUBLISHED", "id": "149815873
5628913093", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823790_971105635579759_6342604012799198294_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWrthX_rJQoQ7kNvwGD-1XP&_nc_oc=AdoOHklTDQZSwKUoArVTH6yBaGmDi3mr4ZGCg6ohKcAyOzLt_HaBrLBFPdjtlDufu8k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJifYCghqVQGI64VDgLpA3l5xjCAhoicyNT7ENx52Rmw&oe=6A9747CB"}, {"file_name": "HS_Meta_Screenshot_2.png", "id": "950405314327712", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821702_950405317661045_1285113534900034383_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KIgKaGE64IQ7kNvwG7tE1k&_nc_oc=AdpDXWZdiE2QOrm-d3CfBq_Rtkeu_StOdk2uFIoEi053P0kqHk3SRmWanqCN4qekniY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw6AKMeMKvU6olWKcmzWJAyTbn-azoB6GHbObpUTYzRg&oe=6A971F87"}, {"file_name": "HS_Meta_Screenshot_3.png", "id": "967222979046853", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822307_967222992380185_2412298261316371182_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8lNqGBJFG0Q7kNvwF_XVoC&_nc_oc=Adqq1n6aVz0hgccQmCtK-uIkzAWi8ISav3KvwKc8kWZgipX1As7O4Pys-u0RmiQAkm0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8cJqI0cX3uGGxgbtlS8FqwOZROV6_Ztr-S782alnRIA&oe=6A9743D8"}, {"file_name": "HS_Meta_Screenshot_4.png", "id": "1642232730237606", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827567_1642232733570939_6617264650106370933_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2LbseXjtP8Q7kNvwGaLe2E&_nc_oc=AdoGQ1WSsob1A5uoFrNR4giK8xQtODnr2rBkk98IsmXMgAf8_Zh1VXJbSx14u-_00x8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqwWNpQhNYvAql7ox_23MCcTs-RIt5a6nAMPYgkvQvaQ&oe=6A972570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape - 2560x1440.png", "id": "1650709842607147", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825470_1650709845940480_1831060348982030349_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoHhz-bPhJwQ7kNvwFeSeoN&_nc_oc=AdrrzV_j5xAuxHo2kBm-RORtvR2eFUauEzSxhmLhuukiry8vJRoJpI9cuWQDy5cMyQk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFysrd8mUBnW7oHlaFH4DscdQvW2C9R6yD2yMT9rtj_3A&oe=6A971A98"}, "display_name": "Highstreet: Calamity", "keywords": ["Roguelike", "Multiplayer", "Classes", "Brawler", "Cooperative"], "long_description": "Highstreet: Calamity \u2013 VR Roguelike Arena Combat in a Manic Metaverse\n\nProtect the FOMO DUCKS! Highstreet: Calamity is a fast-paced, class-based VR roguelike brawler set in Solera, a chaotic world where talking ducks run businesses, pelicans have strong opinions, and monster portals are \u201cjust an average Tuesday.\u201d\n\nIn Highstreet City\u2019s Central Gardens, reality is unraveling. Portals in The Greenhouse unleash bizarre enemies\u2014from rampaging robots to malicious mushrooms. It\u2019s up to you and your squad to fight back.\n\nChoose your class, grab your gear, and jump into solo or co-op VR combat. Face procedurally generated waves, wild bosses, and endless chaos. Build combos, evolve your skills, and define your play style with multiple classes.\n\nFeatures:\n\n\u2022 Hands-on VR roguelike combat\n\n\u2022 Deep progression with gear upgrades and branching skill paths\n\n\u2022 Solo or co-op multiplayer\n\n\u2022 Waves of unpredictable enemies, bosses, and monster mayhem\n\n\u2022 Social lobby with friends and fun\n\n\u2022 Rich lore and a vibrant metaverse-MMO world\n\nHighstreet: Calamity is your first step into Solera, full of adventure, commerce, mystery, and quirky characters (including Benjamin the duck). Frequent updates keep the chaos fresh.\n\nPick a class. Smash the chaos. Save the ducks.", "short_description": "Come join us in this Early Access VR Roguelike combat extravaganza! Feel free to stand, or sit! But it\u2019s time to FIGHT! For glory! For grandeur! For the safety and protection of a species of talking ducks! (Yes really, don\u2019t ask questions.) Be the Adventurer you were born to be! Team up with three friends, or three random folks you just picked up, like stray cats! Or solo it out like the anime hero you dreamed to be. Regardless, come join us and have some tea in the lobby while you wait."}]}, "developer_name": "Highstreet", "developer_privacy_policy_url": "https://highstreet-world.github.io/Gladiator/", "developer_terms_of_service_url": null, "publisher_name": "Highstreet", "support_website_url": null, "website_url": "https://www.highstreet.market/game", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "26361175066835202"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1498158731905117"}]}, "baseline_offer": {"id": "1498158731905117"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776258000, "status": "PUBLISHED", "id": "1498158731905117"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26679995244953181", "version": "0.1.528"}, "id": "636534378813967", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
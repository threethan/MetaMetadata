0uiVzxNpfT7b_HM80NzZsUIbjCJ7yUqDaTj-q4LH4no4RI5nBFyiCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWpg1N_HhwXUBqxqHZ3iuiQKf3JHgf5H0LND7sgDJbqYg&oe=6B0EF555"}, {"file_name": "3dRudder - Strafing.png", "id": "5034124696658622", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_5034124713325287_3346940202929580509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RymEdJySMh0Q7kNvwFi6oa9&_nc_oc=Adpm3V00mFJAkYcLWCzqMqSmU27PM_zV60qKIgWIEv00s7MsekPJI2Ws8ivQLD3Ti2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnNA_lRYOwJOsWQZ3KqQwlPzcjfjRBfsR7ZTxIukrW9g&oe=6B0EFCA8"}, {"file_name": "3dRudder - Turn movement.png", "id": "451601409421792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUA7k21lu-MQ7kNvwH_Qniq&_nc_oc=Adqro-77hXSdJtZMq0-fesQGe5OL2uAFxYarnm8DrpI0GGFIjZNUYGAjf2BgueN20wM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUSnJXqWemmw6HmO1vr9T1OiyjmxTO3H0pRxBq7YD8QRA&oe=6B0F2283"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BztUZS6ltwQ7kNvwFbaC62&_nc_oc=Adr9pZrq0YpQ9MgiG6MgElpXTTgM6yIiucQ_YbgK9DsHS-G6XbwvzpvI8pSui47cGZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBgleXDetYY5Ac4lRJQlJvDm6DEPHKlk3myiGJ5Uc0lQ&oe=6B0EF1BC"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ-YOEqtUVQQ7kNvwHXROtX&_nc_oc=Adp3pc4UzrLfAuUiv4u1Q4TVVyicWrBESqWck-M5WX1chhRxgTQYlPP4V0EEvL2kkZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOdBGSoyHMeu44KOO2pOwIfuMbGxxGOtJ6FFcbjhBjWg&oe=6B0EFE55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "
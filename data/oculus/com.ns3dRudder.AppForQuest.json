Strafing.png", "id": "5034124696658622", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57570299_5034124713325287_3346940202929580509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9LZt6IG_xwQ7kNvwH14dg9&_nc_oc=AdqIZKzga4f_yp_aklz5BIUHD5QmlaL7wlEn_TCLG0UWbfQwOEZzVF1Bt_ckOZztMsg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaYbqS8frnqpMsxqyw7dh2-_B17hzbDs-JmI3k8-0Slg&oe=6AC4F068"}, {"file_name": "3dRudder - Turn movement.png", "id": "451601409421792", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfHQ7dSN2lQQ7kNvwHz2_Bc&_nc_oc=AdqmHu4Cb2OcNDG3w5pt-zBzpmsma02omuYIGA6e5nSsPwZRILUwu6lPe_zHGYQ0xV8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLYMgPUSq0AqBN248a9NQAd1mPztS1HbgQ-tmzrAQupA&oe=6AC51643"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naW_RMA-mwoQ7kNvwGLoclJ&_nc_oc=AdoYVvQ1ZfPbAnjkglTM4OavqQUQEGASrfMiVPmM5QY0Ld9doicfZCZFiimG-MaXZWI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeKx0iN4l6DChAXt53yDS1VQ_2aGompMje8cMEsJuU9w&oe=6AC51DBC"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5O_U_u3kiYQ7kNvwFvVUF-&_nc_oc=AdpTMAwX3jLoYC_HSkZbZCdb-LInDRNfME2P6gHpZQ53SXBQwI7PaliVldvcBDM1UIs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX8enoBFmhygKmB8m7oK1n6tBsAFXAsTb1JSI1rpPi1w&oe=6AC4F215"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "website_url": "https://3dRudder.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "331106725680903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569478_734632903903681_2508055417099375265_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA_7-20QYVwQ7kNvwGjoO-y&_nc_oc=Ado92FOhH1CXqWhI4eKG2-rALdtRilFuJ4LWarfbWBqZlex6pdUMu9FIgsp0JryRzAM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6iefoMHAh50Fuhv0cddGAp5MglIWcxiqSA7raN3OKFA&oe=6AC4FE6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3dRudder Setup & Tutorial", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1640804504, "lastRevision": {"nodes": [{"id": "437070244203747", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3086322498137801", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1978176172321459"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "3dR_Icon_512x512.png", "id": "749506902592514", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031451_749506905925847_5882661016968684009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjWVZ3YkcfsQ7kNvwGzN630&_nc_oc=AdrcewKe6XitqI7Jg-lkzzVUArDI_kkM38w3sH6jHxO0QMqBj8zuH4x_xGTaGc98MYI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculusc
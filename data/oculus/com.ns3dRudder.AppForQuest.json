ZzMT8qRT11g4p2eUDjehZdKsoNF-ESz21fYMlbmcXLqchegAx1u2R0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzRq6oF1KjfI3hjc0K5IiZLp4hhG4qlbueJGDK68Pbbg&oe=6B085DD5"}, {"file_name": "3dRudder - Strafing.png", "id": "5034124696658622", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570299_5034124713325287_3346940202929580509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M-m88pAgbYQ7kNvwH537f7&_nc_oc=AdrPSQuAiP4-m7Go9tTwqT8KIBHCXAdjm_O8bmHvbyuyqUnBE6g7P5M5Rsv1kolqkb4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMhiyzzjnmaH8zxb2fGUY8k2DT8LRwbe5fEvde1pAgnQ&oe=6B086528"}, {"file_name": "3dRudder - Turn movement.png", "id": "451601409421792", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayl1RtgftysQ7kNvwGGxgGz&_nc_oc=AdrajQSeUb3cQSfIATaoCnY5hYYQAZJqQ1e0acHrKhn8DxXgwMqA5I2iYnOO7PNI5lE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkg_Li0STRlPdj7-OqRlEWbXjBRscykqLhrkEnOlcnow&oe=6B0852C3"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVaXDDi-L7EQ7kNvwEG9FpH&_nc_oc=AdpIhi3oN3cxbNEIaR6NVldHf00JfSxJTC1h7TqHerdbhT8_elCbBcw-nS5m1CnSNSk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW5b9PZ7xAo-ak2A8ZqCq6NWCsCN6Ks7MHkwKvEI5oQg&oe=6B085A3C"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4EIjOW_NSkQ7kNvwE2-ZT_&_nc_oc=AdpCVVrT1wptbBY_1PmVTFEGCEQ2JslEtXyOZE8ommKbpFFX1xY7lXzSe_Lu7mf_4T8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSNC96l2hsk73BmvZiWa5ESLyaW6l-JlFG_4l6_uF18A&oe=6B0866D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "
scdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-m-q-iF86EUQ7kNvwH7jFJ1&_nc_oc=AdkJNiSIM6CEi7xBpC_-UHkkDgetXVjfimvnkchm7xSBg2uIgzKHQYd-hQ_S08q9Zk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8qXpqkO6VwrFoPX4lIEDghZjX_pv3Zx3NMNdk4ldapg&oe=69BBE083"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFcFo1WnQcsQ7kNvwG-5-e_&_nc_oc=AdkrcYKovXBnyWArPViQZzz9cII5j2VVr2yxZCr3XZKCCL3Ih18F-1DTV0r6rKjxh08&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxucfnrHKXtUYnQGeZZB7hfCyvzvmgskXme4KXn2cjcGQ&oe=69BBE7FC"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjV0rd78HJAQ7kNvwGgJWO2&_nc_oc=AdlcFBwxjeemqY9-TrnicpQTG8D75cdMNV_twtgwt6VGsBQ4YVqhPRyEGMM_ufj--Ag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyAmJc9tDCLYr7FSFH4K0zE59gQax0pN_zGXbgeQPL4Og&oe=69BBF495"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "website_url": "https://3dRudder.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "331106725680903"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveC
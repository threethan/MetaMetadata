Strafing.png", "id": "5034124696658622", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57570299_5034124713325287_3346940202929580509_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vvunpgh2YpMQ7kNvwHODmOn&_nc_oc=AdoEqHutU--rjrX6zeM2yWIMsrRMJdljugb8XEna5dBAnyPIH6W3tHr9WwM-Mf5G1n4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERKaLYPMhlBObjsSKKQqT15ImoO3_sE6XTymWxYAqt0g&oe=6A973C68"}, {"file_name": "3dRudder - Turn movement.png", "id": "451601409421792", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTANPNl40eMQ7kNvwHXTxnh&_nc_oc=AdoFa-efxI_EbV6_5XE00HU8jws5FeFUT7yT6e-YTk6E6PTjg2fpjfjS40dR-Ziaap0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHskpEZKp24XnA5zGszTfBq-Qxh5sswbCDL8DWL5rYa7Q&oe=6A972A03"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T01U6-pI2z8Q7kNvwFTUEyS&_nc_oc=Adqw2QIfhYSzUbOcFwmqfTh-q4UE5igfraDjjLNop_cGGm3oSwyCihfYI7ey9hyy7cg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWGoofbMCmMf55_mBpc2ZOMjRECiwXzkU9vG8SCngwdA&oe=6A97317C"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_t2TuTJ6kgQ7kNvwF992qs&_nc_oc=AdrmJg8YOcDt3m1M981gScUJb-nv5BB1lwLlO7qxJVT_aHN2Fw9N85gq6-yNtXKmeOQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh9ieLcf1QMEEBw7ofbeSE9JdKsUGD1FvsRH138d5a3A&oe=6A973E15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "website_url": "https://3dRudder.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "331106725680903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57569478_734632903903681_2508055417099375265_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYhGix4TFaAQ7kNvwHuwin1&_nc_oc=Adp-BdnwlB0ixAPzekJHzCg07F-u9jNVnzTm9voYJVBCRlEsPc1qkTvaqFxnaKro48k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGckCUWKpGEnAWyvhXytfkDP4SGQEc7G4GJKXquNAm6BQ&oe=6A974A6B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3dRudder Setup & Tutorial", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1640804504, "lastRevision": {"nodes": [{"id": "437070244203747", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3086322498137801", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1978176172321459"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "3dR_Icon_512x512.png", "id": "749506902592514", "image_type": "APP_IMG_ICON", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031451_749506905925847_5882661016968684009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahmoQiv7ZgoQ7kNvwFdSLyT&_nc_oc=Adr8__EFpOzyeTMuSk0N1vJ5s06nAuECrm0VoLH4YeV8MDFjPSVJoj9vjYRl7zhTU5Y&_nc_zt=3&_nc_ht=scontent-qro3-1.oculusc
oRoWlIHnfwo7w3XrQ3_R7favh1pMt8Uc3OM-917ycc9lJCKWuNgZuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQePGlsRHyR4kWbQMGR9DbWr_AaMwGhF6gz8D7WMnFJ_A&oe=6B09AF55"}, {"file_name": "3dRudder - Strafing.png", "id": "5034124696658622", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57570299_5034124713325287_3346940202929580509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M-m88pAgbYQ7kNvwG5gO_V&_nc_oc=AdpnOYNWBgiw6UN_Y3sds0AhtMJTKMFWFbuuBG9Hi95FwUBDzVhNxOWm6Z3loj0U828&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSIW9DSMcvsGxQb5khECWzBM0MCwliVB4gBxV6982r7A&oe=6B09B6A8"}, {"file_name": "3dRudder - Turn movement.png", "id": "451601409421792", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS_8UqqfNBYQ7kNvwErqDGN&_nc_oc=AdogkQqFPnIZLsOPq4-bBCKGDdpieAc8a0vJK-PfUsjKJsdNDZ3i8IqZBjO98z30Trs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS72L4mduDqitthaYTCMI_bXqXV4OqvDjvaJ8GEaR8eAQ&oe=6B09A443"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVaXDDi-L7EQ7kNvwGKEeeH&_nc_oc=Adp2fV0oJS5d7oDnlKQ6Yk19LlYpYi52B1771faMb_wUc5-Y0n90A60IGlXujX-D8Mw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8tndDXpnmup81fdlSvJMQbDInKeGDSUblBTsOeUeauQ&oe=6B09ABBC"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP6Mkv2WJtsQ7kNvwHVx7I1&_nc_oc=AdrOTTHZwDz3V3YKtCA_1qM9l4ZnGIImV6pSeETuS7r3Ck9B8pvJ70Nt7yvpE_d9gxI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSef4rDRcs1ggNVYbKil0vVe6wrIa3D5pJW9Yd9yY1E3Q&oe=6B09B855"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "
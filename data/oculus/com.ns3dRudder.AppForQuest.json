pVHc1AE1Ui0sBB7fMF_AK5Cbi79VWioHEzzuR1cq0icu9A6C_Z-sXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_h80Xooh4Bb3B_qJUIxN0EQU3a5TcJQ67th_2qP9Dw&oe=6B046955"}, {"file_name": "3dRudder - Strafing.png", "id": "5034124696658622", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570299_5034124713325287_3346940202929580509_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1uAucv_4vYQ7kNvwEWt-Sh&_nc_oc=Adq9JJafLtjyOrCsnlyADdcAkyZP9cpohlEBCxZiYzgRQ792QnOtxM4mdgXuNYPB28k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOHsblhXgVeB6_sVAZqHf-x9Bo5paZPs07QTlvh8LiJw&oe=6B0470A8"}, {"file_name": "3dRudder - Turn movement.png", "id": "451601409421792", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_451601412755125_7653260949154147132_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1OIACkzYO4Q7kNvwHbsI0U&_nc_oc=Adrm5rxomAug9jVjrS1Wtn8c0WQUWjqTLhKWxPaRzBFZEp1D5uxp7iqiG9y1sMAoD8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlKudu3Uo1sHyO9uKbNdqD3B2MB7DE-JXh8BQJ8kidEA&oe=6B045E43"}, {"file_name": "3dRudder - Mini experience.png", "id": "1415471922149561", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75488379_1415471932149560_6748285516086168429_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axUIoZ2DElQQ7kNvwExa0yr&_nc_oc=AdoJYNhCzQrqkPLliHGu_D8Ke8bYAaCX6XeQM7WIR7lvYRtVl3ZbcCpQrUezwy99YjI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv8xGBZNtK7ln6jaE5TE4tVVE4PZL8XgFw7JnUFcWlqQ&oe=6B0465BC"}, {"file_name": "3dRudder - Exploding a balloon.png", "id": "463002951560087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297584_463002954893420_510912844357616824_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2QHsef2qR0Q7kNvwHAO4QV&_nc_oc=Adptnzt48D9U9bYaye2tq5l06fDnC03k85cGRu4K87gv318ohdooJHuxpeg_hn5DvYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr5d9rSk4iTqF-vTa4n9C47P5smD74C0o-r6UYVPAd5w&oe=6B047255"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3dRudder Setup & Tutorial", "keywords": [], "long_description": "The 3dRudder Wireless is a foot motion controller, a new kind of peripheral designed for handling motion at the feet while seated:\n- It offers 4 axes, all progressive and combinable: forward/backward, left/right strafe, left/right turn, up/down,\n- It enables 3 types of locomotion: flat, 3D (ex. Helicopter), and Steering (ex. Airplane piloting),\n- Super intuitive, it lets you achieve in seconds impossible movements like orbiting around a target while shooting at it,\n- It is used seated, providing a relaxing, effortless and secure experience to the user,\n- Anyone can use it, even non gamers, in a matter of seconds,\n- Finally, combined with the hand-tracking features of the Quest, it\u2019s a game changer as the combination provides the users with an experience incredibly close to reality.\n\nThis setup and tutorial app will let you:\n- Pair your 3dRudder with your Quest / Quest 2,\n- Discover each of the 4 individual axis,\n- Use those axes together in 2 experiences.", "short_description": "The 3dRudder Setup & Tutorial app lets you pair your 3dRudder Wireless foot motion controller with your Oculus Quest / Quest 2. It also provides a tutorial to learn how to use your 3dRudder, as well as 2 small experiences where you'll explode balloons with your hands, first on a flat surface, then in a 3D space. Please note, this app may be used entirely in hand tracking mode: only the 2 small experiences require hand tracking as you'll be moving with the feet while acting with your bare hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3drudder.com/privacy-statement/", "developer_terms_of_service_url": null, "publisher_name": "3dRudder", "support_website_url": "https://support.3drudder.com/portal/en/kb/english", "
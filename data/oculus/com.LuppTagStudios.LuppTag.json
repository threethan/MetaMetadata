ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiNUutdynK4Q7kNvwHH1Eir&_nc_oc=Ado6jdxPKxuRNCDTgdZrVP2dS3Nz0NAzlTWu6x__lMh2H-vZBngP4qtN9TkZ2Vn0KrI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJagCSvBCsdacCtwJPK_oMA57-Tl9enBHEo5mNH_r0HZg&oe=6A9AE741"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob0-RzspNJIQ7kNvwFcBtpz&_nc_oc=AdrHZ-B1iFIdqXR7xLfRWrAFQHNIW-vg6IaYMUUhuQMx3iLzY3OQXW_eJsPk79TzH5o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkMGnc_MEZrlXhzffcy4NtPdA33YWTb_2X8WUnpMD_oQ&oe=6A9AC6FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sha
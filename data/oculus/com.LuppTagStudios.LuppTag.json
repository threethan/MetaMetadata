ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE19eatyLxYQ7kNvwEc0AtH&_nc_oc=AdrDcMMX6cG08Orq34XB6L29t2hgbeFUGhD9iAWNqKPPQJwrqyUEl2-X9o92BkPZtW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Hets_8Nh-jOfvKiUVPgtn6rLMcvfQ7uVNIlHKwZ7UiA&oe=69F8BEC1"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEjACz_jaHYQ7kNvwEV-Xr7&_nc_oc=AdrHa8mmcxgq06jiUEm5kvq7VUtvvceAgZFqQ74L-sbLZsQ2kQomM5IeqYj3RUJIGoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AN6wSww1XBPu1vk9f55WsPjb5dVG5_9d1q9v4UfKuGg&oe=69F89E7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sha
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgyMoxd3KZYQ7kNvwH9P527&_nc_oc=AdpMfnrW-6C90r1-zSxRq7QbOzIY7SomIbrAsSHRtDsS8Fuj9KhNfEHk8HI3egDMfO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xeu9Udxa2nUDBd9Gs_ZSuHV30rLI7f1Y0jS8E4ygxHQ&oe=69D24B01"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d6a0yCVx0YQ7kNvwHRpbvE&_nc_oc=AdpM0MMcYR2-37E7t18WVeJMw9AOqtu9qVGzIktS8mbHh60xDGcNc1VoKjq4p6vEVkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u4wX3Ku8Dl2OTFcBPs7A4wO-k2sCYmV5en05Ttef3og&oe=69D262FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sha
ea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9iWlIIj7DQeldkR1Jgqy1lNgkaopbdCN0DZl-EymGGg&oe=6AFC6040"}, {"file_name": "Screenshot4FIX.png", "id": "630229179867172", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393463_630229183200505_5636488051514700521_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDnyoM_7pesQ7kNvwED7W-3&_nc_oc=AdrvrWANHVc0WUWXwaNDtVlyJ4MhUSVt6B8sy8XSdlxmdU_JQLpAxIcjorg14VfGBOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwUe-IcSIn_goFUkk5V9UE1FsKBf2H6ztIsNGSS0Ut6g&oe=6AFC7641"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cCXN7lA5IAQ7kNvwEGLrJV&_nc_oc=AdoT7npdE65J9eGGx2WND72CamvhrWslvC5xQnmIkj5wUWE4IDw_mb6GzQZVHgzniHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Ac3T77ttKS46jhrwcXFkrUK_duz_g3pkPouGxwiQBg&oe=6AFC8E3A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Onion Ring", "support_website_url": null, "website_url": "https://sites.google.com/view/lupp-tag-v1/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9779267045430166"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9913320968691439", "version": "LXXTG"}, "id": "651169210835295", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9767277799962424", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9913320968691439"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "651169210835295"}]}, "change_log": null, "created_date": 17
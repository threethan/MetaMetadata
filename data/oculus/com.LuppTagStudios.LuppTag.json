ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfWt9vZ72BYQ7kNvwGD3u8u&_nc_oc=AdrnsF94ma6nGe6flqXOUAQz_VjSCbw_ngcqw1a8T9TNi3rRDRdB-S16wKiE5OTy_tY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OtM9r5AWhFlf8_Q0Jd655fzkP5iNVIAqrA7jBPsR1lw&oe=69DF7A01"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1r6hIu370AQ7kNvwEQz6u4&_nc_oc=AdoSNUdywFni72LyRLPcGZ372OZXKJBoPKrIx6TmNJkU2yw2hB3EoaLk-iUlHdMfOzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oISatsJAr4ZPHIlJumRANW8mVrM7Amh12ctvhc4Lb_g&oe=69DF91FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sha
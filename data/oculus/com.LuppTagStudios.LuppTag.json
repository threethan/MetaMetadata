kNvwHQpubQ&_nc_oc=AdkZVecX2V876jpXhX53iikjdo6Gpc613VWrowb-j-Fhc087w0occXXXBb8bXmqZ_Ww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfylII3Ym14vDE1QDMlPHJ6VBunNa3D6jyHhyRwa4PyA_Q&oe=69B69B81"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5b-dIOlmzRQQ7kNvwHyrnYy&_nc_oc=Admi_Y5rgJ6dzoONrywACYlA0Jk6AHM1dt3_FA8vxmwTkFx8LwPm7cwlhu-q2ZPN9eA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaMDhQOVqR0UKuMAbBNZtQnIpF1rapeHf42NsJoQYGKQ&oe=69B6B37A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sharing", "developer_terms_of_service_url": null, "publ
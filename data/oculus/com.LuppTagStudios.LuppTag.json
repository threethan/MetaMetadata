ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oX0Kuqu081IQ7kNvwH6OOIp&_nc_oc=Adp5LzTq-U6D_MT53jm8O4CuQ8y6jU149RW6YoTW43xpmkbg2BSNlS4W6jUQrloEiO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_ztC-kxi-KF41RedIFlB-_CmsGG3kMl8sddkJCAm3_A&oe=6A3FEFC1"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgb4oN2bbJgQ7kNvwGb_64V&_nc_oc=AdrVzpKMyUrDbiGo16lmIgsPs2UhKV5sgNTRN3yCplzqNCyUbEwu0ffa5S8iLLOofUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k-hm9r6DJHq1w5Oxt_NS6Xa8DK19jQ4ftnnSzbkR2NA&oe=6A3FCF7A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sha
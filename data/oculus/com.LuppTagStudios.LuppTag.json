ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuFPkGRbrIwQ7kNvwF6YKz6&_nc_oc=AdpOh8E6JGdnlY_iP4cAZchCyxo0gFQBuwxjTRf020ZrnC_80pkd_YBh9K1dCtuWYbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfcDF-P8N7-lN6kvhuF2YtuhDMBwq_N_1Lo9Dt03IUww&oe=6ACA5D41"}, {"file_name": "Screenshot5FIX.png", "id": "3929123477354917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3929123484021583_1010122479936199824_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcghnohoycUQ7kNvwEveaMU&_nc_oc=AdrLCcgfp8WNdIXS0uKSJUGqw6D-s-NE3Kp3RX0CDypfGhQJNBQweG1dNP27-BSPvKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9sm79JZto0KqBQxOwXNnVmkaQm6d37BVklU9_-2PVVg&oe=6ACA753A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lupp Tag v1", "keywords": [], "long_description": "Lupp Tag v1 is a fan-made game inspired by the popular VR game Gorilla Tag. In Lupp Tag v1, players engage in a fast-paced, tag-style gameplay where the goal is to avoid being tagged by others while navigating a vibrant, jungle-like environment. The game introduces new mechanics and features not seen in the original Gorilla Tag, including unique movement options and new map designs, offering a fresh take on the classic formula.\n\nIn Lupp Tag v1, players control anthropomorphic characters with a variety of customizable features. The core gameplay revolves around agility and strategy, using arm movements to swing and climb to avoid being tagged. The game is designed to be engaging and dynamic, encouraging players to hone their movement skills while having fun with friends or other players online. The fan-made nature of Lupp Tag v1 means it may also include experimental features or community-driven content, making it an evolving experience.\n\n\n\n", "short_description": "Lupp Tag v1 is a fun GTAG fangame "}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1rGQO68zcnmTExQO4QEa56ThARpLq9KmlY3-Y2MaKWkk/edit?usp=sha
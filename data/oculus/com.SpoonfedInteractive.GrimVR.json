6e7a0a&_nc_ohc=U0P7wIPVmFsQ7kNvwH3DA57&_nc_oc=AdpZxEgTSQwAH-hIk9KMpQ2YXTudmRCWkzKodMhhHrenw0x6o8s1jmBY3-uOxVIhj8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4Y4OKwrlneqS_dsJ9f2KD5nGnNSSSl1mnfN8hW8r_8w&oe=6AF73FBD"}, {"file_name": "Fortify.png", "id": "538627355621052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974560_538627358954385_801237534890568835_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-lvbNRRLGwQ7kNvwF1h3RY&_nc_oc=AdoFHgqVHfDRvzMJg0E6l93Hi84BS8DPCMgw_da40g7VehohNcRcpN4FG01qa_LuJoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsf64t2lz5cZVEzWP5nnqtj_CmGR24Wg_uTQcKeOl0QA&oe=6AF733FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRIM_Landscape4.png", "id": "867164982198602", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036626_867164988865268_5660236298269294348_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI-HeFPnqqIQ7kNvwFJb_Gs&_nc_oc=AdpHEW4BtqYzSXAWjLG4o7B5JbdELrGce68LS2-vbZtzhtEOcoBX6-H5m75YP2B3zIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpVVCIYSWF-WTct8wzxEUOs2MDEs9M7Sax3DWnEtkbxg&oe=6AF720E8"}, "display_name": "Grim", "keywords": ["Survival", "Space", "craft", "multiplayer", "Scifi"], "long_description": "# Launching soon in Early Access Alpha! \n\nStranded on Mars by AdvantEDGE, **\"GRIM\"** is an exclusive VR multiplayer survival game where you must survive the red wasteland , where survival is not just a choice but a grueling battle against nature and other desperate players. You must gather resources, craft, and build your base, all to stay alive.\n\n{1825332864664687}\n\nIn GRIM, there are no rules other than fending for yourself. Craft tools, armor, and weapons to make your rightful place on Mars against rival survivors and the entities that roam it. You can Cooperate with friends and neighbors to build settlements. You can trade with players in peace, or raid their bases with menacing intent to steal their riches.\n\n{1264443934698694}\n\nConstructing your base is entirely under your control, from fortification to mischievous traps. You can craft your base by yourself or with other survivors. Gather your resources and command your territory.\n\n{914118056853732}\n\n**GRIM is packed with features for unlimited replayability, including**\n\n- Simultaneous PVP and PVE - Avoid both players, wildlife and AI.\n- Scavenge the land and opposing bases for resources, food, water, firearms, and ammunition.\n- Build and Fortify your base.\n- Team up or go alone on the treacherous red planet.\n- Find monuments for their outstanding loot.\n- Craft your tools and build your workshop.\n- Variety of makeshift weapons ranging from hatchets to assault rifles.\n- Raid your enemies.\n\n", "short_description": "Launching soon in Early Access Alpha! \nGRIM is an exclusive VR multiplayer survival game where you must survive the red wasteland on Mars, where survival is not just a choice but a grueling battle against nature and other desperate players. You must gather resources, craft, and build your base, all to stay alive."}]}, "developer_name": "Combat Waffle Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertainment", "support_website_url": null, "website_url": "https://playgrimvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", 
cdn.com&_nc_ss=7f20f&oh=00_AQSDmrOCBsn8vBczDNfRVL0SxoCgSmfcYaqwja6Si0XDtQ&oe=6B007E77"}, {"file_name": "PVP2_Airdop.png", "id": "425299387280886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036606_425299390614219_6238970298110427924_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-NgLrJIOHUQ7kNvwHHar-b&_nc_oc=AdpzTDddqgu0QhJMOe7GpUg6la1gEvUB6fp3lSVmNZBCpr4VV0zSMFDg5EEcbWlCWhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbQ601uhCGJkUlnGGfeVCNwQIHTS5a_F7y5IuHKV8M_A&oe=6B007A3D"}, {"file_name": "Fortify.png", "id": "538627355621052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974560_538627358954385_801237534890568835_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCL2gbZ3w7sQ7kNvwEvwVEg&_nc_oc=Adpz3L3mGLYOKFWwpZUz9VtJRvvVChpuEEW77Z2XoYCTNiNmZwe7mQcnFy8sWnzBAQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlseYEAyDxkbG9MW-vSNTGF7UZIMvvtOH27JDW_ZvPtA&oe=6B006E7C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GRIM_Landscape4.png", "id": "867164982198602", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036626_867164988865268_5660236298269294348_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N06XdWanQDQQ7kNvwGJg82i&_nc_oc=AdqGFhgChWf04zy9uy7UZ2kA35i3rUrLJr6Uj5QEXbc_4srynbpJ4V1TPXIImhPvRCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRymKLeI0X_Swb7FNqkvG-3Y3Ss9KOasQ-BhTG__7_0iA&oe=6B005B68"}, "display_name": "Grim", "keywords": ["Survival", "Space", "craft", "multiplayer", "Scifi"], "long_description": "# Launching soon in Early Access Alpha! \n\nStranded on Mars by AdvantEDGE, **\"GRIM\"** is an exclusive VR multiplayer survival game where you must survive the red wasteland , where survival is not just a choice but a grueling battle against nature and other desperate players. You must gather resources, craft, and build your base, all to stay alive.\n\n{1825332864664687}\n\nIn GRIM, there are no rules other than fending for yourself. Craft tools, armor, and weapons to make your rightful place on Mars against rival survivors and the entities that roam it. You can Cooperate with friends and neighbors to build settlements. You can trade with players in peace, or raid their bases with menacing intent to steal their riches.\n\n{1264443934698694}\n\nConstructing your base is entirely under your control, from fortification to mischievous traps. You can craft your base by yourself or with other survivors. Gather your resources and command your territory.\n\n{914118056853732}\n\n**GRIM is packed with features for unlimited replayability, including**\n\n- Simultaneous PVP and PVE - Avoid both players, wildlife and AI.\n- Scavenge the land and opposing bases for resources, food, water, firearms, and ammunition.\n- Build and Fortify your base.\n- Team up or go alone on the treacherous red planet.\n- Find monuments for their outstanding loot.\n- Craft your tools and build your workshop.\n- Variety of makeshift weapons ranging from hatchets to assault rifles.\n- Raid your enemies.\n\n", "short_description": "Launching soon in Early Access Alpha! \nGRIM is an exclusive VR multiplayer survival game where you must survive the red wasteland on Mars, where survival is not just a choice but a grueling battle against nature and other desperate players. You must gather resources, craft, and build your base, all to stay alive."}]}, "developer_name": "Combat Waffle Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertainment", "support_website_url": null, "website_url": "https://playgrimvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "exte
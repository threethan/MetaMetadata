3&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rV2_1N_1MZoQ7kNvwGGirex&_nc_oc=AdokHfmXbc34VV_CRLipYz-PS76tB8d5VXR7t2lH3HOP8Sqr_u6rBzwMg0eS5Eh28go&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfAsJSvVNCLhmmyNCIkSFU063f_E_b7L8aXMruVAgiuA&oe=6A7D972C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/b3cvJQ", "id": "509636513188098", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974522_509636516521431_2041831713125957632_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjQ1O5PL05cQ7kNvwHH95jT&_nc_oc=AdoC9CLCaH1NhwKPXC4MPg4bnU-A6qXlnzRQJG0gM7FaOLID1Za1MC9V3A-qpmBAcOE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7MF34UBPP-CHWLBDkYA3E330YJNo7G-3M--4AFlLoRw&oe=6A7DAE65"}, "display_name": "AFFECTED: The Manor", "keywords": ["Affected", "Horror", "Jumpscares", "Manor", "Haunted"], "long_description": "The Definitive version of \"AFFECTED - The Manor\" has arrived for Quest! The VR Horror Classic Reimagined! \n\nA foreboding, long-abandoned stately home holds a terrifying secret. It's up to you find out what, so grab your flashlight and delve deep into the darkness, but beware what lurks within.\n\nCompletely updated for Oculus Quest and featuring new interactive features and stunning visuals, this is the same manor that has clocked-up over a quarter of a billion YouTube views and been described by Oculus as the 'original VR horror experience' but with a fresh, electrifying twist.\n\nAs fun to watch others try as it is to play yourself, AFFECTED: The Manor demonstrates just how many emotions VR can make you feel. Exhilaration. Fear. Suspense. Are you brave enough to make it all the way through?\n\nPrepare to set foot inside the most popular haunted house in VR...", "short_description": "AFFECTED: The Manor is a powerful and deeply immersive VR walk-through horror experience. With simple, intuitive one-button controls and terror at every turn, it's not only the perfect introduction to virtual reality but a petrifying challenge for even the most seasoned pro."}]}, "developer_name": "Fallen Planet Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.fallenplanetstudios.com/terms-privacy-policy/", "publisher_name": "Fallen Planet Studios", "support_website_url": "https://www.fallenplanetstudios.com/", "website_url": "https://www.fallenplanetstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655357788923492"}}]}, "scheduled_offers": {"count": 39, "nodes": [{"status": "PUBLISHED", "id": "1549819123380848"}, {"status": "PUBLISHED", "id": "1956432414954231"}, {"status": "PUBLISHED", "id": "1442604810167285"}, {"status": "PUBLISHED", "id": "747020428230449"}, {"status": "PUBLISHED", "id": "1734422853837832"}, {"status": "PUBLISHED", "id": "3348041041999111"}, {"status": "PUBLISHED", "id": "850343700415239"}, {"status": "PUBLISHED", "id": "405547585869951"}, {"status": "PUBLISHED", "id": "292531966501027"}, {"status": "PENDING", "id": "289061343646528"}, {"status": "PUBLISHED", "id": "1111572610219148"}, {"status": "PUBLISHED", "id": "572959614032990"}, {"status": "PENDING", "id": "1801002626937017"}, {"status": "PUBLISHED", "id": "3183497668634203"}, {"status": "PUBLISHED", "id": "1148401766090307"}, {"status": "PUBLISHED", "id": "957283935420586"}, {"status": "PUBLISHED", "id": 
nough to make it all the way through?\n\nPrepare to set foot inside the most popular haunted house in VR...", "short_description": "AFFECTED: The Manor is a powerful and deeply immersive VR walk-through horror experience. With simple, intuitive one-button controls and terror at every turn, it's not only the perfect introduction to virtual reality but a petrifying challenge for even the most seasoned pro."}]}, "developer_name": "Fallen Planet Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.fallenplanetstudios.com/terms-privacy-policy/", "publisher_name": "Fallen Planet Studios", "support_website_url": "https://www.fallenplanetstudios.com/", "website_url": "https://www.fallenplanetstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "655357788923492"}}]}, "scheduled_offers": {"count": 40, "nodes": [{"status": "PUBLISHED", "id": "2189826234978787"}, {"status": "PUBLISHED", "id": "1549819123380848"}, {"status": "PUBLISHED", "id": "1956432414954231"}, {"status": "PUBLISHED", "id": "1442604810167285"}, {"status": "PUBLISHED", "id": "747020428230449"}, {"status": "PUBLISHED", "id": "1734422853837832"}, {"status": "PUBLISHED", "id": "3348041041999111"}, {"status": "PUBLISHED", "id": "850343700415239"}, {"status": "PUBLISHED", "id": "405547585869951"}, {"status": "PUBLISHED",
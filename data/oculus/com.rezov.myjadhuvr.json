d": "1332421745466223", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "1071744528643418", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619805_1071744531976751_6087685860162394925_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxGTejlx9DkQ7kNvwEG5dRM&_nc_oc=AdpMBcs38cEOuYw14nGQl3Tnf7cPX39YbwnjkM9KZ2tILO269R5NIHOMd7I2cNxRrNY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR7h815zGSJ3o7QEkqZhlZDuwWAaxE8zmMK49ElAP1JQ&oe=6AC51506"}, {"file_name": "4.png", "id": "1041702378269575", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654867655_1041702381602908_2322534696617461375_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inYBnQOEx9EQ7kNvwHIsw0D&_nc_oc=AdrRVEI_RnInCVrRdYMqJ7uCNqsFpVbVDRU4XKsYV5Wa7WLn7PLPmks9rI0u-r5-Q9M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg9a_9YDGxBKWVDbwFfbs__zTsgkvUuDjCE_J3YHq_fw&oe=6AC4FD29"}, {"file_name": "2.png", "id": "1688984089068824", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623345_1688984092402157_5623577233717407663_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRRXoVZ99E8Q7kNvwEkKg7-&_nc_oc=Adp5oYiuzpi3W8kB38fty51DbxjaDYm1CZ02pHpMSCl3fLLasgEGZmoZyiar3CbAnog&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7MPmuCtDF-rinZsQzpvnyHwSuPMDAvZK7uode3bBASA&oe=6AC51E84"}, {"file_name": "3.png", "id": "1031568592836088", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604298355_1031568596169421_4665000965695759167_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOO3IubfAU8Q7kNvwHTdUMf&_nc_oc=AdrP4Ypi3ZV7OX49-hDWho4IV6QANq6DteDoGhIiDXzHbJFAaUEGyrUDR8sVP1O77xc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9VJFSOUbBtI6OOqEJUiEcWqCaFIJhqEhsteBmJgAsfg&oe=6AC50937"}, {"file_name": "1.png", "id": "916794188140284", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619704_916794191473617_429282716306555308_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKntLW8goskQ7kNvwGlbaDw&_nc_oc=AdqCaiR5_ERnjGKhtRI24nH_qfe5GsEOoUv5M-nrd_mUoCcbOaHZPusgrg1ZYNha3Gc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPku4U1ssE0K35Y10VkR1q_l6_2v1P_mzVpRJmgOcRyjQ&oe=6AC4F809"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Jadhu VR", "keywords": [], "long_description": "Jadhu VR is an immersive virtual reality learning app designed to provide engaging and interactive experiences for learners on compatible Meta Quest devices.\n\nThrough the Jadhu platform, parents and therapists can assign activities for learners to access and complete within immersive virtual environments. Learners can explore interactive activities, games, and structured experiences designed around different learning objectives.\n\nJadhu VR combines virtual reality, interactive gameplay, movement, and structured activities to create engaging experiences where learners can participate, explore, and practice different skills in a virtual environment.\n\nActivities are assigned through the Jadhu platform and can be accessed by learners using compatible Meta Quest headsets. Parents and therapists can select activities appropriate for each learner's assigned program, while learners complete the activities within the VR experience.\n\nJadhu VR is designed as an interactive learning experience that complements structured activities and provides learners with an engaging virtual environment for participation and practice.\n\nExperience interactive learning through virtual reality with Jadhu VR.", "short_description": "Jadhu VR is an immersive learning app where learners participate in interactive activities and skill-building experiences assigned by parents or therapists through virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.jadhuhealth.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jadhu Health", "support_website_url": null, "website_url": "https://www.jadhuhealth.c
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9VJFSOUbBtI6OOqEJUiEcWqCaFIJhqEhsteBmJgAsfg&oe=6AC50937"}, {"file_name": "1.png", "id": "916794188140284", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619704_916794191473617_429282716306555308_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKntLW8goskQ7kNvwGlbaDw&_nc_oc=AdqCaiR5_ERnjGKhtRI24nH_qfe5GsEOoUv5M-nrd_mUoCcbOaHZPusgrg1ZYNha3Gc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPku4U1ssE0K35Y10VkR1q_l6_2v1P_mzVpRJmgOcRyjQ&oe=6AC4F809"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Jadhu VR", "keywords": [], "long_description": "Jadhu VR is a virtual reality learning platform designed to support skill development through engaging, interactive, and therapist-guided activities.\nThe application is intended for learners who receive personalized lessons and programs assigned by therapists through the Jadhu Therapist Portal. Once a lesson is assigned, learners can access and complete the activities within the Meta Quest headset using the Jadhu VR application.\nJadhu VR offers immersive experiences designed to promote the development of cognitive, social, emotional, behavioral, motor, and daily living skills through structured virtual environments and gamified learning experiences.", "short_description": "Jadhu VR is an immersive learning application that enables learners to access therapist-assigned activities and skill-development programs in a virtual reality environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.jadhuhealth.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jadhu Health", "support_website_url": null, "website_url": "https://jadhuhealth.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQU